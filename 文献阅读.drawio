          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_23_code" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;10_基准测试与数据集\&lt;br&gt;LIBERO-RECOVER - Beyond Task Succ&lt;br&gt;ess Towards Failure Recovery in Robo&lt;br&gt;tic Manipulation Models.md&lt;br&gt;&lt;br&gt;开源信息：本地 PDF：LIBERO-RECOVER.pdf" vertex="1">
          <mxGeometry height="569" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_23_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_23_bottomnav_1" label="返回分类" link="data:page/id,literature-page-04" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_23_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-10" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_23_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-30" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_23_1_field_1" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_1_branch_1" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_1_field_2" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：常规操作成功率不说明策略在抓空、错放或场景被改变后能否继续完成原任务。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：从实际策略产生的失败状态出发，独立量化不同模型的原任务恢复能力。（第 1 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：只评估初始状态任务成功，或者人为注入单一扰动，难覆盖策略真实造成的不同难度失败。（第 2 节）" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_1_branch_2" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="902.5" as="sourcePoint"/><mxPoint x="562" y="902.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_1_field_3" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：专门衡量机器人失败后能否完成原任务的数据集和测试方法；论文自身不是在线恢复算法&lt;br&gt;核心问题：模型从正常开局能做对，但抓错或碰乱现场后，能否从这个中间状态继续完成目标？&lt;br&gt;之前的问题：普通 LIBERO 多从初始状态测试；高开局成功率不能说明模型会收拾失败现场" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_1_branch_3" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1499.5" as="sourcePoint"/><mxPoint x="562" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_2_field_1" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;与已有工作的关系：可用于衡量 Recova 和 FailBank 这类恢复/学习机制是否真正处理失败状态" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_2_branch_1" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_2_field_2" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：常规 LIBERO 测模型从正常初始状态到目标完成，较少测失败后的继续能力&lt;br&gt;相关方向 2：保存失败状态和补救示范，可让策略学习从异常中间状态继续做原任务&lt;br&gt;代表策略：OpenVLA-OFT 等；同一类策略在普通任务和恢复场景的完成率可直接对比&lt;br&gt;区别：从策略实际做错后留下的仿真现场开局，并按需要改动多少现场分成四级" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_2_branch_2" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="916.5" as="sourcePoint"/><mxPoint x="1252" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_3_field_1" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;让六类策略在 LIBERO 子任务运行，自然收集失败，再按恢复所需动作划分四级难度并由遥操作员示范恢复。（第 3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_3_branch_1" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_3_field_2" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;最新版论文报告 2,178 个失败情景、130 个 LIBERO 子任务；L1 重试，L2 适配动作，L3 恢复目标物体，L4 恢复环境。Qwen3.5 视频辅助标注时间性失败，四名遥操作员在 413 个情景中收集 3,184 条恢复轨迹。此工作是评测/数据资源，不是一套新恢复策略。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_3_branch_2" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="745.0" as="sourcePoint"/><mxPoint x="1942" y="745.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_3_field_3" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：失败后的机器人与场景观测、原始任务指令及可选时间上下文；不提供真实失败原因标签给每个基线作完美决策。（第 3–4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：被测策略输出原生机器人动作；主要评价从失败状态恢复到原任务完成的成功率 RSR。（第 4 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：视频辅助失败定位与分级，训练/测试按情景排除重合；混合恢复数据及时间上下文用于基线分析。（第 3–4 节）&lt;br&gt;&lt;br&gt;训练方式：基准本身不训练统一恢复算法；实验对部分基线加入恢复数据进行微调，以衡量数据能否弥补退化。（第 4 节）" vertex="1">
          <mxGeometry height="744" width="628" x="1942" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_3_branch_3" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1342.0" as="sourcePoint"/><mxPoint x="1942" y="1342.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_3_field_4" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：让策略在 LIBERO 仿真里自然执行并收集失败，共建 2178 个场景、130 个子任务&lt;br&gt;贡献 2：按补救难度分四级：再试一次、改动作、修复目标物体、清除环境障碍&lt;br&gt;贡献 3：4 人在 413 个场景中录下 3184 条补救轨迹，可用来训练或评估恢复策略&lt;br&gt;流程：先运行策略并截取失败现场→离线标注级别→给模型原指令→从现场继续→看能否完成" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_3_branch_4" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1991.5" as="sourcePoint"/><mxPoint x="1942" y="1991.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_4_field_1" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：六种策略在模拟器中自然产生失败，不在 rollout 过程中人为植入；人类恢复示范来自四名操作者。（第 3 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：比较 π0、π0-fast、OpenVLA-OFT、GR00T 与视频世界模型等；指标包括 RSR、原基准性能退化和一致性。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：论文未报告真实机器人恢复试验；所有 2,178 个情景来自模拟基准。（第 3–4 节）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_4_branch_1" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_4_field_2" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenVLA-OFT 的 LIBERO-100 常规成功率 94.5%，恢复基准仅 19.3%；部分 L4 情景成功率为 0。加入恢复数据后，恢复平均 20.8%→25.4%，普通 LIBERO 97.1%→96.6%；时间初始帧上下文 20.8%→26.8%。（第 4 节、结果表）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_4_branch_2" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="934.0" as="sourcePoint"/><mxPoint x="2632" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_4_field_3" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融实验：恢复训练数据和额外时间上下文各有小幅收益；较短动作片段更利于恢复反应。不能据此认为已有策略完整解决故障归因。（第 4 节）&lt;br&gt;&lt;br&gt;Failure Case：从简单重试到必须复原被移动物体/场景的 L1–L4 均被收录；高级别失败对策略尤其困难。（第 3–4 节）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_4_branch_3" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_4_field_4" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：场景来自 LIBERO 单臂仿真中的策略执行失败；不是人为造故障，也不是真机故障&lt;br&gt;指标：恢复成功率 RSR 指“从失败现场出发，最后仍完成原目标”的比例，不是只把手臂退回原位&lt;br&gt;结果：OpenVLA-OFT 普通 LIBERO-100 成功率 94.5%，到恢复场景仅 19.3%；部分最难 L4 为 0&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真机：用恢复轨迹微调后 20.8%→25.4%；给原始画面作上下文后 20.8%→26.8%" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_4_branch_4" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1918.0" as="sourcePoint"/><mxPoint x="2632" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_5_field_1" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；失败后物体和场景状态改变，非独立持续运动目标评测&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：基准离线识别并分级失败，不自带部署时检测器或根因诊断器；恢复动作由被测策略生成，以原任务恢复成功率验证，也可用恢复数据微调；没有内建跨任务 Failure Memory&lt;br&gt;&lt;br&gt;主要局限：作者的评测主要限于 LIBERO 风格模拟场景。按本库分析，它识别并分层失败，但没有部署时诊断器、恢复选择器、结果验证器或持久 Failure Memory；真机转移待验证" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_5_branch_1" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_5_field_2" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;适合作为 Failure Memory + Recovery 的分级基准及失败数据来源：从 L2–L4 分析命令、实际场景、原因与恢复轨迹。其失败标签和示范本身不是可直接部署的共享双臂记忆" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_5_branch_2" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="997.0" as="sourcePoint"/><mxPoint x="3322" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_23_5_field_3" parent="paper_23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文给数据、标注和评测，不提供运行中自动发现异常、诊断原因并选择恢复动作的整套系统&lt;br&gt;我的理解 / 不足（据实验推断）：没有真机测试；对训练时没见过的失败和不同机器人仍需另验&lt;br&gt;未来展望：另建在线检测与诊断，再让恢复策略处理 L3/L4 的现场变化，而非只重复原动作&lt;br&gt;对我们项目的启发：可用本基准检验补救策略；我们还需自建失败检测，并把真实结果反馈到记忆" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_23_5_branch_3" edge="1" parent="paper_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1464.5" as="sourcePoint"/><mxPoint x="3322" y="1464.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
