" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1690" background="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="paper_35_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="120" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_35_topnav_1" label="返回分类" link="data:page/id,literature-page-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="739" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_35_topnav_2" label="上一篇" link="data:page/id,literature-paper-25" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="1359" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_35_topnav_3" label="下一篇" link="data:page/id,literature-paper-36" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="1978" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><mxCell id="detail_35_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#35 DexCap"><mxGeometry x="120" y="126" width="2460" height="90" as="geometry"/></mxCell><mxCell id="detail_35_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="01 数据生成与数据质量  ·  本类第 6 / 8 篇  ·  问题：人直接捏、拿、转动物体很快，机器人遥操作却慢。怎样同时记录手指、手腕和物体，再把这些人手动作变成机器人手的训练示范？&lt;br&gt;方法流程：人自然操作 → 同步记录手指/手腕/三维场景 → 映射为机械手动作 → 训练策略 → 真机执行 → 必要时人纠正 → 加入新示范继续训练&lt;br&gt;结果：前三项完整成功率：擦海绵85%、移球60%、递盘子70%；论文报告平均72%，点云基线63%。说明这组条件下可用人手数据训练机械手操作"><mxGeometry x="120" y="228" width="2460" height="130" as="geometry"/></mxCell><mxCell id="paper_35" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="1100" width="2399" x="140" y="375" as="geometry"/>
        </mxCell>
