            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_30_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-23" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_30_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-31" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_30_1_field_1" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / IROS 2026&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_1_branch_1" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_1_field_2" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：VLA 可在常规任务成功，却在接触或身体运动中产生危险；失败发生后重试不一定能恢复到安全状态。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：在冻结基础 VLA 的条件下，预测临近身体或物体危险并选择继续或安全回滚。（第 1 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_1_branch_2" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_1_field_3" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：仅重采样动作不能保证离开危险轨迹；仅用成功率也会掩盖碰撞、倾倒等安全事件。（第 2 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：执行风险预测与回退&lt;br&gt;危险还没发生时就尝试避开&lt;br&gt;核心问题：机器人快撞到物体/人时，&lt;br&gt;应继续、等待还是退回安全点？&lt;br&gt;普通 VLA（看图读指令并生成动作）&lt;br&gt;主要预测动作，不一定估计即时危险" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_1_branch_3" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1464.5" as="sourcePoint"/><mxPoint x="562" y="1464.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_2_field_1" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;与已有工作的关系：相较 Taming VLAs 处理命令与执行残差，SafeLoop 强调危险预测和显式安全路点回滚&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：安全屏蔽，&lt;br&gt;检测高风险动作并阻止执行&lt;br&gt;相关方向 2：失败恢复，&lt;br&gt;出错后重试或重规划&lt;br&gt;代表对照：未加保护的 OpenVLA-OFT 等；&lt;br&gt;比较危险事件与任务完成&lt;br&gt;区别：预测危险出现的概率和时间，&lt;br&gt;必要时沿关节路径退回安全位置" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_2_branch_1" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="547.0" as="sourcePoint"/><mxPoint x="1252" y="547.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_2_field_2" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="982" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_2_branch_2" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1172.0" as="sourcePoint"/><mxPoint x="1252" y="1172.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_3_field_1" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：风险头依据视觉、状态和候选动作估计身体与物体危险概率及时间；元决策器在继续原 VLA 与回滚至最近安全关节路点间选择。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：基础策略保持冻结，风险预测器和 PPO 训练的元决策器外接在执行环；系统记录安全路点并以碰撞检查的关节轨迹回滚，然后重新询问基础策略。论文中的 noop 代表元决策层“继续名义策略”，并非让机器人原地等待。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_3_branch_1" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_3_field_2" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：当前图像、本体状态、VLA 拟执行动作和安全路点；没有长期场景记忆或物体波动率估计。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：风险预测器输出危险概率及时间；元决策器输出继续或回滚，底层仍使用 VLA 动作与关节路径。回滚机器人姿态不能逆转已造成的环境变化。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：根据执行轨迹标注临近危险及到危险时间，维护可返回的安全路点；论文未给出独立数据增强贡献。（第 3–4 节）&lt;br&gt;&lt;br&gt;训练方式：以冻结视觉语言模型特征训练风险头，PPO 训练低频元决策器；基础 VLA 约 20 Hz，元决策约 1 Hz。（第 3–4 节）" vertex="1">
          <mxGeometry height="709" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_3_branch_2" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1056.5" as="sourcePoint"/><mxPoint x="1942" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_3_field_3" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：风险网络看图像、机器人状态和拟执行动作，&lt;br&gt;预报机身/物体危险&lt;br&gt;贡献 2：低频决策器选继续、记录安全点、&lt;br&gt;或 rollback（退回先前安全姿态）&lt;br&gt;贡献 3：基座 VLA 保持冻结；&lt;br&gt;回退由独立关节控制器执行&lt;br&gt;流程：VLA 提动作→预测危险/时间&lt;br&gt;→继续或回退→重新观察并续做" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_3_branch_3" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1688.5" as="sourcePoint"/><mxPoint x="1942" y="1688.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_4_field_1" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：仿真使用 24 项 LIBERO 任务和多随机种子，并做三项真机任务；风险监督来自机器人/物体危险事件。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：在 π0、OpenVLA-OFT、π0.5 等冻结策略上比较危险率、每千步危险事件与任务成功率；LIBERO 24 任务、16 个种子。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：两台 Piper 构成实验平台，三项任务各 25 次 rollout，危险事件总量约降 78%；论文未将其论证为双臂协同失败互助。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_4_branch_1" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_4_field_2" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：π0 的身体危险率 20.8%→5.2%，物体危险率 30.2%→6.8%，每千步事件 1.21→0.22，任务成功率 59.4%→59.6%。（第 4 节、主结果表）&lt;br&gt;&lt;br&gt;消融实验：单纯重采样身体危险率 16.6%，完整方法 5.2%；教师式策略为 7.3%。结果支持回滚路径与学习式选择的组合效果。（第 4 节、消融表）&lt;br&gt;&lt;br&gt;Failure Case：发生不可逆物体位移时，机械臂回到旧关节位置不等于场景恢复；风险预测误判也会漏掉短时危险。（第 4–5 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_4_branch_2" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_4_field_3" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：LIBERO 24 个任务及 3 类真机任务；&lt;br&gt;测危险事件和任务成功&lt;br&gt;对照：原始 VLA 与其他安全处理；&lt;br&gt;区分机身碰撞和物体危险&lt;br&gt;结果：仿真危险事件约降 70%；&lt;br&gt;论文称任务成功率基本保持&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真机：危险事件约降 78%；&lt;br&gt;回退并不保证之后一定换成功路线" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_4_branch_3" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1671.0" as="sourcePoint"/><mxPoint x="2632" y="1671.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_5_field_1" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；执行过程产生危险和状态变化，但未评测独立运动目标&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：在动作前预测身体/物体危险，并选择继续或安全路点回滚；回滚后重新询问原 VLA。只诊断危险类别，不追溯细粒度故障原因；部署期间没有持续积累失败结果或在线更新基础策略&lt;br&gt;&lt;br&gt;主要局限：论文关注身体/物体安全危险，不是所有任务失败的原因诊断。按本库分析，未保存“命令—实际执行—失败原因—恢复结果”的持久 Failure Memory，也未验证外部持续运动目标" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_5_branch_1" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_30_5_field_2" parent="paper_30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对当前研究方向的价值：适合作为 Risk-Aware Action Gating 与安全回滚基线。要形成完整 Failure Memory，需要另记失败前观测、命令、真实执行、原因和回滚后的任务结果；这是研究扩展，非本文已实现机制&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者边界：要有危险标注训练预测器；&lt;br&gt;不能撤销已经改变的物体状态&lt;br&gt;我的理解：回到安全关节姿态，&lt;br&gt;仍可能重复造成危险的原动作&lt;br&gt;未来可记住危险原因与失败路线，&lt;br&gt;回退后修改策略而非盲目再试&lt;br&gt;项目启发：DH116 接触任务可加风险门控；&lt;br&gt;与记忆/恢复模块记录危险前兆" vertex="1">
          <mxGeometry height="709" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_30_5_branch_2" edge="1" parent="paper_30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
