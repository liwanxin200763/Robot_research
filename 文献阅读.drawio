          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_40_pdf" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;01_VLA\&lt;br&gt;4D-VLA.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_40_code" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;4D-VLA - Spatiotemporal Vision-Lang&lt;br&gt;uage-Action Pretraining with Cross-S&lt;br&gt;cene Calibration.md&lt;br&gt;&lt;br&gt;开源信息：官方 GitHub" vertex="1">
          <mxGeometry height="534" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_40_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_40_bottomnav_1" label="返回分类" link="data:page/id,literature-page-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_40_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-39" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_40_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-57" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_40_1_field_1" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / NeurIPS 2025（论文 PDF 首页）&lt;br&gt;引用量：60（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_1_branch_1" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_1_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：异构机器人数据中，单张 RGB 可能看不见机器人基座、无法确定动作坐标系，也看不出物体的先前状态，导致相同画面对应不同动作。（论文第 1 节，图 1）&lt;br&gt;&lt;br&gt;论文要解决的问题：通过时序和 3D 坐标线索缓解跨场景动作分布歧义，使预训练表征适合跨视角机器人操作。（第 1、3 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_1_branch_2" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_1_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;单帧缺少基座／相机几何信息形成“coordinate system chaos”；同一当前视觉状态因历史不同需要不同动作，形成“state chaos”。简单全帧拼接又有冗余。（第 1–2 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_1_branch_3" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1440.0" as="sourcePoint"/><mxPoint x="562" y="1440.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_1_field_4" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：三维空间加时间的 VLA（视觉—语言—动作模型：用图像与指令生成动作） 预训练。Pretraining（预训练）是在大规模数据上先学通用能力；4D 在此指三维空间和时间，不是四维物理空间&lt;br&gt;核心研究问题：同一物体换视角后图像位置会变；同一画面也看不出历史。能否把跨场景图像映射到有意义的三维位置，并保留重要历史来生成动作？&lt;br&gt;之前方法的问题：普通二维特征缺少准确距离与位置对应；均匀选历史帧可能连续抽到几张几乎相同的图。时间线索浪费计算，空间也容易随相机变化混乱" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1658" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_1_branch_4" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1942.5" as="sourcePoint"/><mxPoint x="562" y="1942.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_2_field_1" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：区别于仅压缩 RGB 历史的 ContextVLA 和 HAMLET，4D-VLA 重点消除坐标系与状态歧义，使用 3D 几何和关键帧共同约束动作。（第 2–3 节）" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_2_branch_1" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_2_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_2_branch_2" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_2_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：三维视觉方法用深度恢复位置，比纯图像更明确，但需要传感器和标定。跨场景统一坐标，才能让不同相机的观察更可比较&lt;br&gt;相关方向 2：历史模型用多帧或记忆库保存过去；记忆库需要去掉相似帧，并保留时间标签，不能只把所有图像压成一堆无顺序特征&lt;br&gt;代表工作：#52 OpenVLA 主要用单张图像；#38 TraceVLA 用二维轨迹提示运动。本篇结合三维位置编码、历史采样与时间编码，信息更丰富但硬件要求也更高&lt;br&gt;与已有方法的区别：空间标定与时间建模一起进入视觉语言模型。不是单独添加世界模型：它使用历史帮助控制，并未显式滚动预测所有物体未来" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_2_branch_3" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1429.5" as="sourcePoint"/><mxPoint x="1252" y="1429.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_3_field_1" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：输入连续 RGB-D，将深度与相机几何转为 3D 坐标嵌入，再从历史中用 Memory Bank Sampling（MBS）挑选信息丰富的帧，以显式时空线索校准场景。（第 3 节，图 2）&lt;br&gt;&lt;br&gt;方法与系统结构：InternVL-4B 骨干接收图像空间 token 与语言 token；RGB-D 经空间位置编码后进入 Transformer，时序位置编码保留采样帧的相对顺序。MBS 在滑动历史窗口里更新关键帧，去除冗余；动作头输出控制量。（第 3 节）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_3_branch_1" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_3_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：当前与历史 RGB-D 图像、相机／深度推得的空间坐标以及任务语言；下游微调采用 5 帧、窗口 20。论文不是以历史关节状态或触觉为主要创新。（第 3、4.3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：末端控制由三维平移增量 Δx、三维旋转增量 Δθ 和夹爪开合 g 构成，按低层闭环策略执行。（第 3.1 节）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_3_branch_2" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="986.5" as="sourcePoint"/><mxPoint x="1942" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_3_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前帧 448×448、历史帧 224×224；MBS 按历史信息差异筛选帧；动作标签按第 1／99 百分位归一化。附录 7.1 说明 RLBench 对比采用 OpenVLA 的随机裁剪增强；随机背景、位置和相机角度主要是评测设置，不能一概写成训练增强。（第 3、4.3–4.6、7.1 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_3_branch_3" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1461.0" as="sourcePoint"/><mxPoint x="1942" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_3_field_4" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;先在多样数据上做时空 VLA 预训练，再下游微调；LIBERO 微调 20 epoch、batch 128，除视觉编码器外更新模型参数。（第 4.3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_3_branch_4" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1876.0" as="sourcePoint"/><mxPoint x="1942" y="1876.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_3_field_5" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：输入彩色与深度图及相机标定，把像素还原到机器人/世界坐标中的三维位置。给视觉特征加位置编码，使模型区分近远和实际布局&lt;br&gt;贡献 2：记忆库采样检查历史图像的相似性，减少重复帧，选更有信息的关键帧。这样有限输入可覆盖较长时间，而非只保存最近几张&lt;br&gt;贡献 3：给非均匀选出的帧补相对时间编码，说明每帧离现在多久。三维信息与时间信息共同送入模型，输出机器人控制动作&lt;br&gt;方法流程：彩色图+深度+标定 → 三维位置特征 → 历史记忆去冗余 → 补时间标签 → 结合指令 → VLA 预测动作 → 执行后刷新记忆" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="2094" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_3_branch_5" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2413.5" as="sourcePoint"/><mxPoint x="1942" y="2413.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_1" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：使用 DROID 等真实机器人数据预训练；LIBERO、MV-Bench 仿真以及 Franka 真机微调评测。真机四任务每项 50 条演示，多视角补充实验每任务每相机 50 条。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：LIBERO 四套任务、论文构建的 MV-Bench 跨视角仿真、Franka 四类真机任务及补充多视角真机评测；主要对比 OpenVLA 和基础 VLA 等。（第 4 节，表 1–4）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_1" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Franka 测未见位置、干扰物、精确堆叠和颜色顺序指令；另以四相机收集数据，评估未见视角与背景／位置变化。（第 4.5–4.6 节，图 4–5）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_2" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="892.0" as="sourcePoint"/><mxPoint x="2632" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机四任务平均得分完整模型 85.63、OpenVLA 27.70；仅预训练为 47.00，仅加坐标 63.67，仅加历史 65.88（表 3）。MV-Bench in-view 81.0% 对 OpenVLA 52.2%，cross-view 73.8% 对 50.5%（表 2）；真机多视角均值 55% 对 18%（表 4）。注意表 3 某些任务用累计评分归一化，不可全部解释为逐次任务成功率" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_3" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1324.5" as="sourcePoint"/><mxPoint x="2632" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_4" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;预训练、坐标与历史组合优于各单独组件（表 3）；MBS 在相同采样数下优于均匀采样，时间编码缺失成功率 63.0%，最佳设置 75.6%（第 5.1 节，表 5、图 6）。附录表 8 在 LIBERO-Spatial 报告 MBS 成功率 0.866、160.0 ms，单帧 0.738、76.5 ms，明确体现精度与延迟权衡；附录表 7 指 Proprioception token 在该设置反而可能过拟合" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_4" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1799.0" as="sourcePoint"/><mxPoint x="2632" y="1799.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_5" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文描述长程真机任务无历史时第一步成功、第二步因状态歧义失败；跨视角偏移增大时表现下滑。未单列系统性失败案例或失败后的恢复策略。（第 4.5–4.6 节）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2059" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_5" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2249.0" as="sourcePoint"/><mxPoint x="2632" y="2249.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_5_field_1" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：依赖深度和相机几何线索；更大视角变化仍有性能下降。论文没有实验证明显式执行误差检测、接触力反馈或故障恢复；后两项为文献库分析。（第 3–5 节）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：为“错误究竟来自坐标系、视觉状态还是实际执行”提供分析维度；其历史帧选择可用于构建更清晰的误差检测基线。（第 1、5 节；文献库分析）" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_5_branch_1" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_40_5_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者在结论明确指出依赖彩色—深度输入，带来硬件限制。深度缺失、反光物体以及相机标定问题，会影响三维空间信息的可靠性&lt;br&gt;我的理解 / 不足：我的判断：历史记忆把旧位置带入当前，物体快速移动时可能变成过时证据。本文并未为记忆设计显式过期检测或风险等待机制&lt;br&gt;未来展望：可用物体变化速度与深度置信度控制记忆更新；比较动态场景中“保留旧帧”与“及时刷新”的收益，连接 #02 LT-Mem 的变化程度建模&lt;br&gt;对我们项目的启发：可作 DH116 操作中的空间记忆基线。先保证腕部/外部相机标定，再测手遮挡和物体移动；不能把三维坐标准确直接等同于接触稳定" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_5_branch_2" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
