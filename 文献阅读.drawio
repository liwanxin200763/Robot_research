ct="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1690" background="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="paper_51_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="120" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_51_topnav_1" label="返回分类" link="data:page/id,literature-page-06" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="739" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_51_topnav_2" label="上一篇" link="data:page/id,literature-paper-50" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="1359" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><mxCell id="paper_51_topnav_3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EFF3F6;strokeColor=#C4D0D8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#8093A1;align=center;verticalAlign=middle;spacing=8;shadow=0;" value="下一篇"><mxGeometry x="1978" y="42" width="601" height="62" as="geometry"/></mxCell><mxCell id="detail_51_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#51 DexHandDiff"><mxGeometry x="120" y="126" width="2460" height="90" as="geometry"/></mxCell><mxCell id="detail_51_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="06 动作建模与控制  ·  本类第 6 / 6 篇  ·  问题：训练示范只开门到90度，测试要开30度并停住。能否在不重新采所有目标数据的情况下修改目标，同时保证手真的推动物体而非物体凭空动？&lt;br&gt;方法流程：手/物体当前状态+新目标 → 联合生成状态与动作 → 接触前对齐 → 接触后目标控制 → 动力学约束纠偏 → 执行短轨迹 → 重新规划&lt;br&gt;结果：只在开90度数据训练，测试开30度：DexHandDiff70%，条件扩散16.7%。表示完成指定新角度并满足任务判据，而非仅门角度预测准确"><mxGeometry x="120" y="228" width="2460" height="130" as="geometry"/></mxCell><mxCell id="paper_51" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
