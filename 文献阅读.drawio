        <UserObject id="paper_139_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_139_bottomnav_1" label="返回分类" link="data:page/id,literature-page-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_139_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-138" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_139_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-140" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_139_1_field_1" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与资料来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整题名 You Only Teach Once: Learn One-Shot Bimanual Robotic Manipulation from Video Demonstrations，简称YOTO。首页为RSS2025，会议在2025年6月21–25日举行，不能把会议日当作预印本首次上传日。作者及机构来自首页。当前PDF没有文本层，22页按本地图像逐页核对，主体1–11页、附录17–22页；原卡引用59仅为旧快照，本次不报告实时引用数。论文所说的一次教学是每种任务先提供一段人类双手示范，再扩展生成大量训练数据，而非只用一条未经加工视频就直接获得策略。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_1_branch_1" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_1_field_2" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景与具体问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂长任务需要在高维动作空间协调谁先动、谁等待及何时共同移动。大规模遥操作昂贵，单目人手三维重建又可能在相邻帧产生坐标跳动。YOTO要把双目观察中的人手运动转成可检验的机器人关键姿态，保留动作先后，再通过真实机器人自动回放和点云几何增强扩充示范。最终训练专门的双臂扩散策略BiDP，应对抽屉、倾倒、旋盖、揭盖和开纸箱等真实任务。这是一条包含人工检查、真实数据采集和学习的完整流程。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_1_branch_2" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="951.5" as="sourcePoint"/><mxPoint x="562" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_2_field_1" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与本文取舍&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作如ALOHA通过主从臂采集连续机器人观察动作对，动作天然可执行，但采集人员、硬件与时间成本高。RSRD、OKAMI等从人类视频提取物体或手运动并重定向，可降低示范门槛，但单目重建噪声和连续轨迹抖动影响执行。ACT和Diffusion Policy用图像与本体状态预测连续动作；DP3改用点云；EquiBot进一步使用对旋转、平移、尺度变化有结构适应性的表示。YOTO承接这些能力，但先把视频动作简化成少量关键姿态，再训练物体点云条件下的关键动作分布。" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_2_branch_1" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_2_field_2" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;关键姿态、运动掩码与扩增的含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;关键姿态是能概括抓取开闭、速度极值或操作转折的稀疏末端目标；两姿态之间通过运动规划和插值连接。运动掩码记录某个关键时刻哪只臂应移动、哪只应保持，避免等待动作被重复学习。几何增强则同时变换物体点云和对应机器人目标，使输入与标签仍一致。增强数据不全是在真机上实际执行过的轨迹，所以其可达范围要由真实回放阶段估计，而不能无限改变物体位置。本文主要区分严格异步任务和同步任务，对两者混合的长任务尚不处理。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_2_branch_2" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="951.5" as="sourcePoint"/><mxPoint x="1252" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_3_field_1" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;双目感知：把人手特征转成稳定三维轨迹&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集单个第三视角双目相机的同步左右RGB流，主要在左图运行WiLoR检测左右手并估计MANO手形和关节；右图只在关键帧需要深度时参与立体匹配。作者不直接相信单目手模型的相机空间深度，而先把代表手中心的三维点投回二维，再用双目匹配深度抬升回统一三维坐标。手姿从腕、食指和无名指相关向量构造局部坐标轴，得到夹爪朝向；手物接触检测用于判断夹爪开闭，比仅看手势更可靠。Florence-2与SAM2分割目标物体，双目深度把初始掩码区域转为物体点云。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_3_branch_1" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_3_field_2" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;动作注入：先压缩再验证可执行性&lt;/b&gt;&lt;br&gt;&lt;br&gt;连续轨迹通常100–200帧，直接逐帧到真机验证既耗时又容易发生碰撞。本文按夹爪开闭改变和速度或加速度局部极值提取关键姿态，通常约10个，再经已测手眼变换从相机坐标转为机器人坐标。用逆运动学和采样规划器连接关键姿态，真实机器人回放检查不可达、互撞或不合理接触，并编辑修正，作者报告典型验证约3分钟。两臂关键时刻保留原时间顺序，形成二值运动掩码，0保持、1移动；严格异步任务按掩码拆分左右动作，同步任务则保留两臂同时执行。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_3_branch_2" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="969.0" as="sourcePoint"/><mxPoint x="1942" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_3_field_3" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;从一次教学增殖数据的两个途径&lt;/b&gt;&lt;br&gt;&lt;br&gt;第一途径是真机自动回放：改变物体六自由度位置或替换相似对象，只修改与该物体相关的关键姿态，再让机器人执行并记录完整观察和动作。例如物体沿x移动5厘米，就对相应取物关键点加5厘米偏移；不是把整条轨迹所有点都整体平移。第二途径在物体点云层进行受控旋转和平移，同时更新相关关键姿态标签，大批生成新的观察动作对。后一途径不再逐条真机验证，但限制在已测机械臂可达区间，且避免过大位移造成原始视觉投影不合理。两种方法分别增加真实接触经验和位置多样性，不能把合成增量全部计为新增真机示范。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_3_branch_3" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1548.5" as="sourcePoint"/><mxPoint x="1942" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_3_field_4" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;BiDP：物体条件、动作重排与等变去噪&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略观察主要是任务物体点云和初始机器人状态，而非整场景图像；去掉背景可减少无关干扰。BiDP在EquiBot式SIM(3)等变结构上，用4层PointNet++编码点云，再用FiLM调制和卷积U-Net预测动作噪声。等变表示使输入发生整体空间变换时，输出能对应变化。每臂本体表示13维，包含末端位置、6维旋转表示、重力方向和夹爪开度；动作7维，包括位置偏移、轴角角速度和夹爪动作。异步任务把两臂按时间排序成单臂动作流，删除等待冗余；同步任务左右动作交替组织。扩散训练学习去噪恢复专家关键动作，部署DDIM只用8步采样。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1861" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_3_branch_4" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2145.5" as="sourcePoint"/><mxPoint x="1942" y="2145.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_3_field_5" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;观察时序与执行反馈边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录明确观察跨度为1，策略在一次初始观察条件下预测后续整段关键动作；前三个异步任务预测长度为K，后两个同步任务为2K。虽然真实采集记录完整视频与连续动作，用于公平训练对照，BiDP本身主要使用初态物体点云和简化动作。因此不能把它描述为每一个关键姿态都根据新视觉重新闭环规划。关键姿态之间的控制和运动规划仍然需要保证可达与碰撞合理性；对执行中物体偏移、溢水或盖子回弹，初态条件策略可能不能及时修正。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2458" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_3_branch_5" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2707.5" as="sourcePoint"/><mxPoint x="1942" y="2707.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_4_field_1" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机硬件与数据规模&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂为相对布置的两台Aubo i5，每臂工作跨度约880毫米，末端为最大开口80毫米的DH-Robotics平行夹爪；视觉为DexSense工业双目相机，本文没有使用D435i的证据。5任务分别为拉抽屉并放物、倒水、拧瓶盖、揭盒盖、打开快递盒，关键姿态数为10、11、12、12、16。自动回放真实示范数量为243、162、54、45、36条，平均时长约42、53、51、27、35秒；之后几何扩展100倍达到每任务约5千–2.4万轨迹。原始教学每任务一段，但最终训练数据远多于一段。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_4_branch_1" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_4_field_2" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与数字核对&lt;/b&gt;&lt;br&gt;&lt;br&gt;同分布评估表IV中BiDP五任务最终成功分别43/54、28/36、23/30、20/25、14/20，即约79.6%、77.8%、76.7%、80%、70%；表V跨任务平均76.8%，ACT5.7%、DP15.8%、DP3 19.4%、EquiBot23.4%。第10页文字却称接近60%，与表V不一致，本笔记以表格和分子分母为准。新对象分布外评估仅抽屉与揭盖两任务，BiDP平均35%、EquiBot8.8%、其余0%；这显示明显泛化差距，不能把同分布76.8%延伸到任意新物体。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_4_branch_2" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_4_field_3" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融、成本与评价偏差&lt;/b&gt;&lt;br&gt;&lt;br&gt;抽屉243条基础示范消融中，无本文策略的基础模型13/54=24.1%；仅物体观察48.1%、仅关键姿态51.9%、两者57.4%、再加动作空间重排61.1%、改用几何增强77.8%、完整模型79.6%。这些结果表明最大增益来自数据多样性与任务表示组合。数据采集表I中三任务主从遥操作约205–248秒/条，自动回放约42–52秒/条，几何变换约1–1.5秒/条，但几何增强没有实际接触验证。附录特别说明推理时若目标分割失败，可人工修改掩码且不计入失败试验，可能让端到端成功率高于完全无人流程；应在复现评价时单独记录。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_4_branch_3" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1513.5" as="sourcePoint"/><mxPoint x="2632" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_4_field_4" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练条件与典型失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;点云采样1024点，模型可在24GB RTX3090Ti训练，批量64；完全扩增数据的前两任务训练500轮、后三任务1000轮，未充分扩增时训练轮数更多。附录失败包括物体摆在抽屉内导致关不上、转运碰撞抽屉、杯瓶未对准溢水、抓住瓶盖而非瓶身、夹爪偏心导致拧盖失败、双臂距离不对把整盒抬起，以及纸盒翼因按压不足回弹。它们分别暴露接触、路径、相对位姿和时序问题，不能只用视觉轨迹平滑来解释或修复。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_4_branch_4" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2075.5" as="sourcePoint"/><mxPoint x="2632" y="2075.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_5_field_1" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者承认视觉手轨迹有固有误差，必须人工检查并在真机验证；固定工作台限制灵活性；平行夹爪的功能有限，灵巧手或力触觉可能拓展任务；高速动态任务、复杂工具使用和人机协作尚未充分研究。方法还不考虑同步与异步混合的长任务。附录在分割失败时允许人工修正的处理，进一步说明系统当前不是完全无人自动化。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_5_branch_1" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_139_5_field_2" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对DH116与D435i项目的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;YOTO与双臂平行夹爪、人手视频到动作的目标高度相关。可先借鉴双目深度稳定手中心、关键姿态人工可审查、物体相关局部改姿和运动掩码四项，在DH116上构建小规模抽屉或交接样例。D435i可以给深度，但相机尺度、视角、遮挡和标定要重新验证；论文工业双目的精度不能直接继承。应将初态一次预测改为关键事件后的视觉重观察，检查物体是否被带起、抽屉是否真的打开、杯瓶口是否对齐；失败后停机重估再规划。评价应把人工掩码修正、轨迹编辑、碰撞恢复和合成数据全部计入成本，分别报告自主成功率与人工辅助成功率。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_139_5_branch_2" edge="1" parent="paper_139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="881.5" as="sourcePoint"/><mxPoint x="3322" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-140" name="05-16 PPI">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_140_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_140_topnav_1" label="返回分类" link="data:page/id,literature-page-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_140_topnav_2" label="上一篇" link="data:page/id,literature-paper-139" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
