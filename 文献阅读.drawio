        <mxCell id="paper_37_3_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 3：用目标任务数据和 DROID 成功示范联合训练策略，测试场景内外表现。质量与多样性都要检查，不能只把更多轨迹无差别塞进训练集" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_branch_4" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="940" as="sourcePoint"/>
            <mxPoint x="1199" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_field_4" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="方法流程：移动平台到不同地点 → 标定相机 → 人遥操作 → 保存图像/动作/说明/结果 → 检查数据 → 和目标任务示范混合训练 → 新场景测试" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_4_drop" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
