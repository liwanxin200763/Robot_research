            <mxGeometry x="3180" y="3986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_127_1_field_1" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;OWMM-Agent: Open World Mobile Manipulation With Multi-modal Agentic Data Synthesis，本地30页NeurIPS 2025版本与canonical题名一致。官方arXiv https://arxiv.org/abs/2506.04217 记载首次2025年6月4日、v2为6月21日；其页面仍称19页，故本笔记方法和结果以本地正式30页版本为准，不能将两个页数混为文件缺失。旧卡引用数7本次未核验，不作当前引用量。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_1_branch_1" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_1_field_2" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Junting Chen、Haotian Liang（共同一作）、Lingxiao Du、Weiyun Wang、Mengkang Hu、Yao Mu、Wenhai Wang、Jifeng Dai、Ping Luo、Wenqi Shao、Lin Shao；上海AI实验室、NUS、USTC、HKU、上海交大、清华。代码/项目核验：项目 https://hhyhrhy.github.io/owmm-agent-project；官方仓库 https://github.com/HHYHRHY/OWMM-Agent。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_1_branch_2" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="881.5" as="sourcePoint"/><mxPoint x="562" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_1_field_3" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与开放世界范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;移动操作同时需要理解“把某处的物体搬到另一处”、寻找目标所在房间、判断身体能否够到和输出低层可执行目标。通用VLM常在多图检索、可达区域定位和动作阶段判断上幻觉。本文以统一VLM处理多视图、当前画面与历史，再调用坐标规划器。作者明确开放世界指未见场景/物体的语义泛化，任务前仍有预建图，不能解读为无任何先验、从空白空间自主探索。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_1_branch_3" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1391.0" as="sourcePoint"/><mxPoint x="562" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_2_field_1" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与地图检索和VLA的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;CLIP语义地图常按文本与图像特征相似度找目标，面对组合指令受限，稠密三维重建也有成本。OWMM保留带位姿的少量RGB场景帧，让VLM直接推理相关视图。相对输出技能名和物体描述的LLM代理，本文输出动作类别及像素框，再反投影成控制目标。它也不是高频端到端VLA：大模型只做低频决策，路径规划、机械臂运动规划和夹爪控制执行连续速度。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_2_branch_1" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_2_field_2" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;长期与瞬时记忆&lt;/b&gt;&lt;br&gt;&lt;br&gt;长期环境记忆是预建图时保存的带相机位姿场景图像；瞬时机器人记忆是每轮模型生成的文字摘要，例如已拿起物体、准备去目标位置。可供性定位指找出“可走”“可抓”“可放”的像素区域；输出框中心再利用深度变成三维点。文字推理有助于追踪任务阶段，但不等于真实动作已被传感器验证成功。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_2_branch_2" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_1" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入与多层执行接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;每轮输入包括自然语言搬运指令、预建图位姿与图像、当前头部RGB和机器人历史。默认选8张场景图加1张当前图，图的边并不参与模型推理。深度和机器人状态主要在执行侧供规划器反投影、求轨迹，VLM负责输出JSON高层动作。高层动作跨越多个仿真步，底盘路径规划器和机械臂规划器根据机械约束、点云及状态产生低层控制。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_1" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_2" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：建立可用的场景记忆&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真使用Habitat可导航网格，预先采样起始容器、目标容器附近及随机位置的头部图像，保证关键区域被覆盖。真机用Fetch激光雷达和RobiButler/Gmapping建立二维占据图并定位，随后从ROS bag人工挑选任务相关帧。这样省掉稠密语义重建，但仍依赖预建图和关键视图选择；不是模型独立学会在哪些位置观察。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_2" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="811.5" as="sourcePoint"/><mxPoint x="1942" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_3" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：合成带执行接口的数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;PDDL利用仿真符号真值产生逻辑可执行的任务序列；Fetch在Habitat执行并记录机器人、目标、容器坐标和相机外参，先只记关键帧候选以节省图像渲染。导航选择目标可见且路点可走的帧，抓放要求目标可见、机械臂可达，再回仿真渲染。按规则把三维目标投影成框或场景帧ID，从而得到动作类别和位置监督，而不是让语言模型随意猜标签。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_3" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1286.0" as="sourcePoint"/><mxPoint x="1942" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_4" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：推理与历史监督&lt;/b&gt;&lt;br&gt;&lt;br&gt;模板串起四部分：任务解释、对当前/场景图的感知、带坐标的动作决策、供下一步使用的摘要。GPT-4o mini只改写推理和摘要的表述，保持动作标注与框不变，每模板生成若干语言变化。前一轮摘要系统性进入下一轮输入，因此模型学到任务阶段的连续性。该流程减少人工标注，但依赖人工制定PDDL、动作模板和过滤规则。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_4" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1760.5" as="sourcePoint"/><mxPoint x="1942" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_5" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：训练与推理&lt;/b&gt;&lt;br&gt;&lt;br&gt;在InternVL-2.5上训练8B和38B版本，冻结ViT视觉编码器，仅调整视觉投影MLP和语言模型，目标为自回归生成结构化推理、历史和动作。动作集合为检索场景帧、向点导航、抓取、放置。检索动作选已知位姿图引导远距离移动；临近后由当前图输出导航/抓放框，取中心经深度反投影，调用经典规划器执行，再将新观测与更新摘要交回模型。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_5" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2235.0" as="sourcePoint"/><mxPoint x="1942" y="2235.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_6" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;能力分解与关键设计作用&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一训练将“看哪张图”“该走还是抓”“图上哪个区域可执行”联系起来，避免专门定位模型在上层决策错误时仍给正确物体坐标却做错动作。框输出与视觉预训练常见定位格式接近，实验优于直接点坐标。结构化摘要帮助减少反复检索的死循环；但完整任务仍会因前面一次错误而无法到达后面的抓放阶段。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2495" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_6" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2709.5" as="sourcePoint"/><mxPoint x="1942" y="2709.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_3_field_7" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;定位分数和几何执行的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;定位评价先要求动作类别和框格式有效，再用框中心到真值点的图像对角线归一化距离评分。因此模型框中心视觉上靠近目标可以得高分，但还需深度反投影和规划器检查可走、可达、可抓。正文把单步分数与整任务分开评测，正是因为逐步错误会累积；单步97%以上动作分类不保证完整搬运接近同样成功率。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2952" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_3_branch_7" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3166.5" as="sourcePoint"/><mxPoint x="1942" y="3166.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_4_field_1" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据量与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;正文汇总143场景、157物体、1471容器，筛得21046有效episode、约572K标注，其中抓64.7K、放68.9K、导航59.6K、检索378.8K。附录又用113:30场景、137:20物体划分，给152K训练、4K测试条目；这是不同统计口径，论文未充分解释572K到152K的关系，不能合并为同一个训练总数。8B在8张A100训练约7小时，38B在24张A100约18小时，均1 epoch。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_4_branch_1" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_4_field_2" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真单步与整任务结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;单步38B动作判断97.85%、图像检索87.54%；物体/容器/导航定位分数0.97/0.94/0.88，该分数同时考虑格式有效与归一化距离，并非真机抓取率。308个仿真episode中，严格目标距离0.85m、抓取0.15m条件下38B全任务21.90%、8B 9.45%；放宽到目标1.7m、抓取0.8m等条件后38B为51.52%、8B38.59%。阈值非常影响结果，不能只引较高值。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_4_branch_2" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_4_field_3" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真实实验的准确解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;真实环境先人工导航建图并挑选视图，模型每次动作还需人确认后才执行。表4三类各10个单步样本：38B场景检索7/10、物体/容器定位10/10、导航定位10/10，总计27/30即90%；8B分别5/10、10/10、9/10，24/30即80%。这些由人评估动作是否正确、目标是否准确可达，不是30次自主长任务rollout。论文没有给真实完整搬运成功率。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_4_branch_3" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_4_field_4" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融、失败与推理负担&lt;/b&gt;&lt;br&gt;&lt;br&gt;8B直接输出点替代框，物体定位约0.93降至0.65、容器0.91降至0.65；去推理摘要，检索79.04%降至65.86%、动作判断96.72%降至90.49%。100条随机失败episode人工分类：动作决策36%、检索28%、物体/容器定位15%、导航定位21%。附录单A100-40G、8+1帧的8B为4.84秒/18.43GB；38B在4张A100下4.39秒/98.22GB，与正文表2另一计时口径不同，不混作25Hz控制延迟。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_4_branch_4" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1813.0" as="sourcePoint"/><mxPoint x="2632" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_4_field_5" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;距离阈值的实际含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;目标0.85m取自测试容器平均三维包围盒对角线1.7m的一半，宽松值取整条对角线，而非为每个容器按自身尺度设阈值。因此不同尺寸家具的“到达目标”精度不可直接等价。该评测更侧重高层搬运决策，无法替代精确放置或DH116接触质量测量；21.90%与51.52%必须伴随距离条件阅读。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_4_branch_5" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2287.5" as="sourcePoint"/><mxPoint x="2632" y="2287.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_5_field_1" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;预建图依赖仍在，真实关键帧人工选择；吸附式/简化末端抓取设置不足以处理灵巧手；换机器人后最大伸展距离等具身先验改变会导致失败。作者将跨形态适应、复杂操作和自动在线选帧留待未来。真实验证受人工确认约束，因此自主性和安全性不能从单步准确率推导。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_5_branch_1" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_5_field_2" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116与视觉系统分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;可借鉴“全局少量带位姿画面+局部实时画面+阶段摘要”的接口，帮助长任务避免遗忘目标，但DH116不应由VLM框中心直接完成多指接触。建议用独立局部抓取/接触控制器接收目标物体与预抓取区域，再由视觉、触觉判定真正拿稳后更新摘要。还应把框落在物体上与抓取几何可行分开测量。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_5_branch_2" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="776.5" as="sourcePoint"/><mxPoint x="3322" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_127_5_field_3" parent="paper_127" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Sim2Real与评测建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文模拟指令微调能迁移部分视觉判断，尚未证明低层接触动力学迁移。若复用其合成标注管线，建议保留仿真真值到像素框的几何链路，并增加不可达/遮挡负例；真实评测同时报告单步正确率、人工干预次数和整任务分母。自动选帧应作为单独研究变量，避免人工保证目标入镜掩盖感知检索难度。以上为本笔记建议，未声称已有实现。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_127_5_branch_3" edge="1" parent="paper_127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1233.5" as="sourcePoint"/><mxPoint x="3322" y="1233.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
