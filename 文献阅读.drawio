            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_66_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#66 VoxAct-B">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_66_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="05 双臂与 Multi-Agent 协作  ·  本类第 7 / 16 篇  ·  OWL-ViT 加 Segment Anything 定位目标并裁剪体素，双角色 PerAct 式策略输出两臂六自由度动作；仿真少样本优于对照，真机开抽屉 6/10、开罐 5/10">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
