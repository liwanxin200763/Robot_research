        </mxCell>
        <mxCell id="paper_96_5_header" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="E. 不足与未来" vertex="1">
          <mxGeometry height="78" width="650" x="3300" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_5_field_rail" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="108" as="sourcePoint"/><mxPoint x="3310" y="1271" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_fulltitle" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;ManiWAV: Learning Robot Manipulation from In-the-Wild Audio-Visual Data" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_96_authors" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Z Liu，C Chi，E Cousineau，N Kuppuswamy …" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_96_pdf" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;08_数据与遥操作\&lt;br&gt;ManiWAV.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_96_code" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;08_数据与遥操作\&lt;br&gt;ManiWAV - Learning Robot Manipula&lt;br&gt;tion from In-the-Wild Audio-Visual D&lt;br&gt;ata.md&lt;br&gt;&lt;br&gt;开源信息：—" vertex="1">
          <mxGeometry height="534" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_96_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_96_bottomnav_1" label="返回分类" link="data:page/id,literature-page-data-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_96_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-95" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_96_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-97" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_96_1_field_1" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL&lt;br&gt;引用量：94（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作&lt;br&gt;数据链条位置：同步音频与视觉的野外示范采集" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_1_branch_1" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_1_field_2" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_1_branch_2" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_1_field_3" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;为什么声音可能比画面更早说明接触&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人拿铲子伸到食物下面时，画面很难判断铲子是在锅底滑动，还是顶住食物侧面；擦白板时，也可能看起来贴着表面，实际上没有压住。ManiWAV 研究能否把接触产生的声音与视频一起记录，让人类在普通场景收集的数据也能教会机器人判断接触状态。这篇工作位于数据采集与多模态策略训练之间，不是把声音识别准确率直接当操作成功率" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_1_branch_3" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_2_field_1" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;与 UMI 和普通音频采集的关系：UMI 让人拿着便携夹爪示范，再把恢复出的末端轨迹用于机器人训练；ManiWAV 在这个接口上加入接触麦克风。普通环境麦克风听见房间里所有声音，接触麦克风更容易捕捉沿指爪传播的局部振动；但机器人电机的噪声也会沿结构传过来，因此换一个传感器并不能自动消除训练和部署差异" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_2_branch_1" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_2_field_2" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_2_branch_2" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="997.0" as="sourcePoint"/><mxPoint x="1252" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_2_field_3" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;接触麦克风得到的是沿指爪传播的振动，不是准确接触力。两次视觉相似的动作可能因为接触方式不同而声音不同，模型才能用声音补画面盲区；反过来，同一个摩擦声也可能来自无关位置，所以音频需要与当前画面、动作历史一起解释。把声音单独分类，再把类别当抓稳真值，会丢失这种语境" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_2_branch_3" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1429.5" as="sourcePoint"/><mxPoint x="1252" y="1429.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_3_field_1" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入与同步采集&lt;/b&gt;&lt;br&gt;&lt;br&gt;在手持夹爪指部嵌入压电接触麦克风，通过 GoPro 的麦克风输入与图像同步录制；相机记录观察，视觉惯性定位恢复夹爪运动，音频记录接触事件。部署端同样在指爪附近安装接触麦克风，并测量音频相对观察流的延迟，再补偿时间关系，避免把动作后发出的声音配给动作前的状态" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_3_branch_1" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_3_field_2" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;处理声音并生成动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;把音频变成对数梅尔频谱，也就是按时间展示不同频率声音强弱的图；音频编码器和视觉编码器分别提取信息，再用 Transformer 将两路信息关联。Diffusion Policy 根据融合表示逐步修正随机动作，预测未来 16 步末端轨迹。训练时混入环境声和机器人电机声，使模型学习任务相关接触而非记住房间噪声；它不是先用人工规则识别一个声音再固定执行动作" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_3_branch_2" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="794.0" as="sourcePoint"/><mxPoint x="1942" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_3_field_3" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：音频窗口要覆盖足够长的交互，而不是只截当前一瞬。倒杯前的摇动是主动获取信息：杯中物体发出振动，策略随后决定是否倒出。论文比较一秒与十秒音频历史，短窗口可能没有信息，长窗口又增加学习负担；因此传感器越快并不意味着把所有原始采样点直接送进策略就更好&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_3_branch_3" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1391.0" as="sourcePoint"/><mxPoint x="1942" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_4_field_1" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;平台、任务与数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文在 UR5 操作平台上测试翻贝果、擦白板、倒物体和区分魔术贴表面四项真机任务。翻转采 283 条实验室示范及 7 个环境中的 274 条野外示范；擦白板 119 条，倒物体 145 条，魔术贴 193 条。任务分别测试接触模式、接触保持、杯中状态和材料区别，不能把四种分母直接合并成统一成功率" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_4_branch_1" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_4_field_2" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;结果及消融怎样解读&lt;/b&gt;&lt;br&gt;&lt;br&gt;图 5 的实验室翻转为 90%，仅视觉对照 25%；图 6 擦白板为 85% 对仅视觉 40%，每策略 20 次；图 7 倒物体为 92% 对 27%，每策略 12 次；图 8 魔术贴为 80% 对 20%，每策略 10 次。噪声增强、音频编码、融合方式及音频历史长度均有对照。它支持接触音频有帮助，同时说明任务数据和噪声处理缺一不可，并不保证任意麦克风或任意接触任务都有同幅收益" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_4_branch_2" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="829.0" as="sourcePoint"/><mxPoint x="2632" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_4_field_3" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：实验还把模型结构与数据组成分开对照：翻转比较仅视觉、普通动作回归、不同音频编码器；擦拭比较融合方式及有无噪声增强；魔术贴比较接触麦克风与环境麦克风。这样才看得出改善来自接触信号、鲁棒处理还是额外模型容量。野外数据帮助新场景的结论，也应与只用实验室数据的同类模型比较&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_4_branch_3" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_5_field_1" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限与本项目可以借用的部分&lt;/b&gt;&lt;br&gt;&lt;br&gt;原文指出，衣物等安静或准静态交互未必产生明显声音，电机噪声也可能淹没目标信号；目前策略没有充分利用声音高于图像的时间分辨率。若给 DH116 研究接触判断，可先同步记录图像、动作、关节反馈和接触音频，离线比较抓空、碰到、滑动时的信号；要先测传感器安装和机械噪声，不能把普通房间录音直接当触觉替代品" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_5_branch_1" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_96_5_field_2" parent="paper_96" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：接到自己的系统时，先确保声音、图像和实际动作在同一时间轴；电机刚启动的噪声若总与某动作标签同时出现，模型可能靠电机声猜指令而没有理解接触。可保留相同动作下抓空、轻触、压住和滑动的片段，检查声音是否仍能区分物体交互，再决定是否投入更大规模训练&lt;br&gt;&lt;br&gt;对自己的实验怎样落地：可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_96_5_branch_2" edge="1" parent="paper_96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="934.0" as="sourcePoint"/><mxPoint x="3322" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
