          </mxCell>
        </UserObject><UserObject id="paper_142_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-141" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_142_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-143" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_142_1_field_1" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与时间口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整题名 FreqPolicy: Efficient Flow-based Visuomotor Policy via Frequency Consistency，意为通过频率一致性实现高效流视觉运动策略。首页标注NeurIPS2025，作者机构为北京人形机器人创新中心及中科院自动化研究所，本地29页含技术附录。会议年与首个预印本年月应区分，后者及后续更新尚未核验；当前引用量也未查询，不把旧卡19作为实时数。方法重点是把流动作头训练为一次网络前向即可生成动作块，未声称整个机器人系统或VLA只需一次廉价运算。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_1_branch_1" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_1_field_2" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与核心观察&lt;/b&gt;&lt;br&gt;&lt;br&gt;扩散和流策略能表示多种合理动作，但多步采样带来延迟。把图像生成的一步加速直接迁到机器人时，容易忽略动作块是时间序列：平移、转腕、夹爪开闭在不同阶段具有不同频率结构。本文用频域约束让同一噪声到专家动作路径上的预测更一致，减少一步生成的质量损失。这里的频率指动作块内部随物理时间变化的快慢；流时间是从噪声走向动作分布的生成进度，二者不是同一个时间轴。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_1_branch_2" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_2_field_1" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人加速方法的机制和成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;Consistency Policy先训练强扩散教师，再把教师多步轨迹蒸馏给少步学生；ManiCM把这种一致性蒸馏用于点云策略。OneDP、SDM用分布匹配让学生生成分布接近教师，同样往往需要额外教师。FlowPolicy直接约束流路径上速度一致，促使路径变直，无需预训练教师。部分去噪或历史轨迹热启动可减少重新采样，但仍可能保留多次网络调用。FreqPolicy承接无需教师的流一致性路线，进一步把动作序列当作时间信号，自适应强调难以对齐的频率分量。" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_2_branch_1" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_2_field_2" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;流匹配与DCT的通俗解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;流匹配学习一个速度场，把高斯噪声逐步推向专家动作序列；网络输出的速度是生成空间中的变化方向，不等于机械臂实体末端速度。离散余弦变换DCT把动作块沿时间拆成慢变和快变成分，能描述平稳搬运和突然开闭夹爪的差别。若把所有频率一视同仁，简单分量可能占据训练；只保留低频又可能抹掉关键接触变化。因此本文根据当前预测差异给频率分量加权，但这种加权本身不保证物理轨迹速度、加速度或碰撞约束合规。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_2_branch_2" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="951.5" as="sourcePoint"/><mxPoint x="1252" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_3_field_1" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基础动作生成：从噪声到动作块&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入可为两帧RGB与本体状态，也可为点云和本体状态，输出一段未来动作。RGB用ResNet18编码，点云用轻量MLP编码，动作头为一维CNN U-Net。训练取高斯噪声a0和专家动作a1，构造生成时间t的线性插值at=(1−t)a0+t·a1，用平方误差让网络速度v(t,at)接近a1−a0。这项基础流匹配损失保证终点朝专家分布，单独训练通常仍需要多步积分；本文再加一致性约束，使从任一生成进度出发都能沿近似直线到达同一终点。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_3_branch_1" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_3_field_2" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;频率一致性：两种约束分别控制方向和终点&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一对噪声与专家动作上采样两个生成时间r、s，得到ar、as。第一项直接比较两处预测速度，鼓励沿路径的方向与幅度一致；第二项把两处状态按各自预测速度推进到共同后续时刻u，再比较是否到同一位置，约束整条路径的几何一致性。差异比较前沿动作块的时间维做II型DCT，不把动作块仅看成静态向量。这样网络受到动作序列结构监督，既避免同一生成路径不同阶段预测互相矛盾，也鼓励一步积分得到接近多步采样的动作。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_3_branch_2" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="916.5" as="sourcePoint"/><mxPoint x="1942" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_3_field_3" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;自适应频率损失与训练代价&lt;/b&gt;&lt;br&gt;&lt;br&gt;对每个频率k，计算两个预测的DCT系数差异，再对差异做指数归一化形成权重wk，差异大的频段权重高；最终损失是按wk加权的系数差。权重随动作块和生成时间变化，能在平稳位移阶段关注低频，在夹爪开闭或技能切换时保留高频变化。总损失为基础流匹配加频率一致性，无需预训练教师。训练需要对两个随机生成状态前向计算，作者明确其计算量更大；因此一步推理省时不能写成训练也同样省时。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_3_branch_3" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1443.5" as="sourcePoint"/><mxPoint x="1942" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_3_field_4" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;VLA接入和动作执行边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;FreqPolicy可作为能预测动作向量场的VLA动作头。本文将OpenVLA噪声条件潜在特征经非线性映射产生速度场，保留图像、语言和本体条件，再进行频率一致性训练。它不消除视觉语言主干计算，所以VLA速度要单独测量。普通真机策略预测长度48、执行步数48，两个观察步作为条件；一次生成的48步都执行后再更新。因而更快采样可以降低每块开始的等待时间，但动作块之间的观测周期仍决定对突发物体变化的响应。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_3_branch_4" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1970.5" as="sourcePoint"/><mxPoint x="1942" y="1970.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_4_field_1" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真任务与评测口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;二维Robomimic包含Lift、Can、Square、Transport、ToolHang五任务，每任务200条熟练人类机器人示范，3种子、每种子50初态。三维评估是Adroit3任务加MetaWorld50任务，每任务10条专家示范，前者用VRL3强化学习生成、后者用脚本生成；每200训练轮评估20回合并取表现最好的5次汇总。LIBERO为4套各10任务、每套500条示范，测试每任务50回合。正文与图2的总任务数存在53/93口径不一致，5+53+40为98，本笔记按分项报告，不重复一个无法对齐的总数。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_4_branch_1" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_4_field_2" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;普通动作头主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;Robomimic一步FreqPolicy五任务成功率为100%、98±2%、92±2%、90±2%、85±3%。相同一步Consistency-FM在Transport84%、ToolHang80%，因此分别提高6和5个百分点。表2将Adroit3任务和MetaWorld难度分组放在一起，最后Average本文78.5±2.6%、SDM74.8±4.5%、FlowPolicy77.2±2.8%，分别高3.7和1.3个百分点；本文Adroit分组72.6%低于DP3 74.3%，不能说每个分组均领先。MetaWorld中等难度65.8%也低于DP3 72.7%，平均优势主要在部分困难任务。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_4_branch_2" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_4_field_3" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;VLA结果与基线训练限制&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenVLA-FreqPolicy在LIBERO四套成功率97%、98.6%、96%、87.6%，平均94.8%，推理6.05Hz；10步OpenVLA-FM平均93.7%、1.26Hz，速度约4.8倍。附录加入OpenVLA-OFT后为94.2%、6.15Hz，FreqPolicy只高0.6个百分点且略慢，不能笼统说它比所有高效VLA快5倍。所有VLA对照用相同150K梯度步、总批量16和4张A100，作者说明训练样本总量约2.4M，少于原OFT默认9.6M，因此OpenVLA-DP68.1%的数字是这一受限重实现，不是原论文最佳结果。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_4_branch_3" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_4_field_4" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机、训练与实际频率&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机三任务：Franka按序收纳三水果、打开抽屉放两玩具再关闭；UR打开垃圾桶、放两块食物垃圾并关盖。每任务300条真实示范，20个不同初态测试，输入前视或左视加腕部RGB及本体状态，图像480×480；相机具体型号未明确，不能写D435i。单张A100训练10万步，批量64、Adam学习率1e-4。RTX4090上水果任务成功70%、推理93.5Hz，对10步DP55%/19.8Hz、10步FM60%/20.2Hz。93.5Hz是普通策略推理，6.05Hz是VLA整体，两者不能互换，更不能据此声称机械臂以93.5Hz视觉闭环纠错。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_4_branch_4" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2093.0" as="sourcePoint"/><mxPoint x="2632" y="2093.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_4_field_5" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与失败判据&lt;/b&gt;&lt;br&gt;&lt;br&gt;Robomimic消融ToolHang从一步基础FM76%，普通一致性78%，全频约束82%，自适应频率88%；Transport基础84%、普通一致性90%、全频92%、自适应92%，高频与低频单独约束都不能稳定覆盖多阶段动作。此消融表与主表最终ToolHang85%来自不同实验汇总，不拼成同一结果。附录真机失败按任务定义，例如水果掉落、同一物体重复抓取超过规定次数、玩具未全部放入或抽屉未关、垃圾桶盖未开就拿垃圾等；环境固定容器位置、保留对象相对排列，仅局部随机初态，开放场景泛化仍有限。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="2388" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_4_branch_5" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2655.0" as="sourcePoint"/><mxPoint x="2632" y="2655.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_5_field_1" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确主要验证流匹配，是否同样有效扩展到扩散策略待未来系统研究；训练两次前向需要更多计算资源。频域约束改善时间结构不等于对真实动态和接触安全作了完整验证。任务中容器固定和相对排列保留也限制结果解释，不能把局部初态随机化说成任意环境泛化。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_5_branch_1" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_142_5_field_2" parent="paper_142" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向当前平台的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116双臂若已有扩散或流动作头，可以保持感知与数据一致，只替换频率一致性训练，测单步动作质量、两臂时序和整块生成延迟。当前人手视频还需先变为机器人动作标签，本文不解决重定向；D435i深度或RGB的选择应与现有策略一致，避免同时改输入导致无法归因。重点记录动作块内高频夹爪事件是否被平滑掉、双臂接触时是否同步，以及48步全执行期间能否发现滑落。建议将推理频率、动作指令频率、视觉更新频率分别计时，用抓取失败检测和短块重规划评估实际闭环收益。" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_142_5_branch_2" edge="1" parent="paper_142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="829.0" as="sourcePoint"/><mxPoint x="3322" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
