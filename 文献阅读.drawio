            <mxGeometry x="2160" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_120_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-123" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_120_1_field_1" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与首次公开&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：Towards Fast, Memory-based and Data-Efficient Vision-Language Policy。方法名LiteVLP，作者为Haoxuan Li、Sixu Yan、Yuhan Li、Xinggang Wang，华中科技大学，Wang为通讯作者。本地11页PDF首页为arXiv:2503.10322v1，与canonical卡相符。官方https://arxiv.org/abs/2503.10322确认首次公开2025年3月13日，仅列v1；更新时间不另猜。年份 / Venue：2025年arXiv预印本，未从没有出版标识的PDF推断会议。引用量未实时核验。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_1_branch_1" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_1_field_2" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、问题与目标能力&lt;/b&gt;&lt;br&gt;&lt;br&gt;大参数VLA推理贵，机器人训练数据与互联网图文格式又不一致；只看当前图像难以处理“按先前顺序”“参考最终布局”等依赖历史或目标的任务。本文希望用1B视觉语言基座、对话式少量机器人数据和多图输入，同时解决算力、格式对齐与长程记忆。具体目标是让模型读历史、当前与给定未来目标图，生成文字形式的平面末端位置/旋转，再压缩连续图像的静止内容降低开销。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_1_branch_2" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_2_field_1" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制：指令微调与动作接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;传统行为克隆拟合观察到动作，LLaRA式visuomotor instruction tuning把机器人示范改写成任务、图像描述、动作回答的对话，保持预训练语言接口。模型输出文本中的二维位置和角度，经解析、标定映射到机器人动作。LiteVLP沿用这个方向，并未学习完整关节控制器。它与利用大VLM隐状态再训练扩散/流动作专家不同，强调小模型直接文本动作以及输入格式兼容性。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_2_branch_1" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_2_field_2" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;记忆和MOC术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;记忆是把过往观察、已完成动作或未来目标图片显式放入当前上下文，未设计可随部署无限增长的独立记忆库。未来图像是任务给定的目标/参考，不是模型推理时自行预测未来。MOC为multi-observation compression，借鉴视频run-length token思想：连续图中同位置静止patch只保留首次出现内容，并附持续长度嵌入，避免多次重复背景。它压缩输入token，不是量化模型参数或蒸馏控制器。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_2_branch_2" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="881.5" as="sourcePoint"/><mxPoint x="1252" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_3_field_1" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入、主干与动作输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;基座为InternVL2-1B。多张RGB图片先做MOC，经视觉编码和MLP投影，与任务文本一起由LLM处理；答案包含未来末端二维坐标(x,y)和旋转θ，解析为一个或多个动作。坐标通过预定义映射转机器人动作空间，映射依赖视觉标定，不能把像素数值直接当成三维米制位姿。动作执行后采新图像继续预测。图2是总体示意，实际多图排列方式应以后文位置消融为准，而非默认所有图片都穿插进文字。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_3_branch_1" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_3_field_2" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;多图与单图两种设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;LiteVLP-m输入历史、当前和未来目标的完整图片及对应目标检测结果；LiteVLP-s只输入当前完整图片，其余参考图片信息以检测得到的对象位置文字描述提供。所谓-s不是完全没有历史/未来信息，而是信息经过文本检测描述压缩。历史动作还可在指令中用“You have finished ...”表达。这些条件使模型知道已做什么与要达到什么，区别于从单张当前观察自主推断隐藏历史。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_3_branch_2" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_3_field_3" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对话数据构造&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练采用LLaRA公开的Description-Instruct-BC-8k，即D-inBC-8k，只占VIMA原数据约1.2%。数据转换器把多模态任务指令改写为文字，目标检测器提取各参考图中对象位置，形成图像描述，再与图像及行为克隆动作合成对话。检测坐标是实质性辅助信息，评估模型必须保留这一输入条件；不能把结果描述为只靠端到端RGB完成所有定位。本文没有报告新增真实机器人遥操作采集。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_3_branch_3" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1356.0" as="sourcePoint"/><mxPoint x="1942" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_3_field_4" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;MOC压缩信息流&lt;/b&gt;&lt;br&gt;&lt;br&gt;对连续图像同一空间位置的patch比较差异，当小于阈值ε时标为静止。静止mask选择需要保留的patch，run-length mask记录它跨多少张图持续；压缩结果包含位置嵌入、首次patch内容和可学习长度嵌入。阈值设1e-5，训练与推理一致。该假设适合固定视角、背景变化小的桌面序列；若视角运动或光照漂移，同位置像素差不再等同物体运动，会减少压缩或保留不合适内容。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_3_branch_4" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1848.0" as="sourcePoint"/><mxPoint x="1942" y="1848.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_3_field_5" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;优化与闭环边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;冻结ViT，训练MLP投影器、LLM和新增长度嵌入；D-inBC-8k训练4个epoch，AdamW，学习率2e-5、weight decay0.01、warmup ratio0.03、余弦调度。该方法是监督指令微调。部署反馈仅指执行后新观察进入上下文，不会用任务回报在线改参数，也未报告自动生成新技能或失败恢复提示库。多图跨时间信息提高决策条件充分性，不能与持续学习或机器人自我进化混称。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2108" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_3_branch_5" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2340.0" as="sourcePoint"/><mxPoint x="1942" y="2340.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_4_field_1" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基准与评价覆盖&lt;/b&gt;&lt;br&gt;&lt;br&gt;VIMA-Bench为17类多模态指令桌面仿真任务，参考图片和文本共同指定操作；原基准有摆放L1、组合L2、新对象L3、新任务L4。本文只评L1–L3，因训练测试的spatula旋转数据不一致排除L4；图5也仅列部分具体任务，L3不含sweep without exceeding。必须注明排除范围，不能称完整四层VIMA泛化已验证。本地PDF未给统一测试episode数或跨随机种子置信区间。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_4_branch_1" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_4_field_2" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要成功率与数据条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;表2同1.2%数据，LiteVLP-s为L1 83.1%、L2 81.5%、L3 77.5%，平均约80.7%；-m为84.2%、78.1%、75.4%，平均79.2%。VIMA全数据为81.5/81.5/78.7%，10%数据76.3/75.8/73.2%；因此本文在小数据下有竞争力，但-m不在所有层都优于VIMA，也不总优于-s。LLaRA-7B-s为78.1/73.8/70.0%，同数据对比更支持小模型适配效率。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_4_branch_2" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_4_field_3" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;历史/目标任务与定位噪声&lt;/b&gt;&lt;br&gt;&lt;br&gt;三类长任务Rearrange、Reasoning、Constraints中-m为80.0/86.7/83.4%，平均83.4%；CoTDiffusion为59.0/51.7/83.1%，平均64.6%，绝对差18.8个百分点。这个结果与普通三层总体79.2%不是同一平均口径。定位噪声实验中，噪声0.2时-m/-s下降5.3/7.8个百分点，0.8时下降9.6/22.2；多图的视觉内容可以弥补文字坐标误差。但噪声幅度定义不能直接映射成现实厘米误差。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_4_branch_3" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_4_field_4" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;算力与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练4张RTX3090耗6.1小时，LLaRA同GPU数约21小时；VIMA为8张V100、24小时，跨硬件时间不应直接作算法效率公平因果结论。相同RTX3090推理比较，本文相对LLaRA约6.8倍加速，但未给绝对毫秒延迟。MOC约减少60%图像token，报告训练时间下降47.5%、推理速度提高34.1%；成功率表5为有MOC79.2%、无MOC79.6%，不能写成压缩毫无任何变化。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_4_branch_4" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1813.0" as="sourcePoint"/><mxPoint x="2632" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_4_field_5" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入布局与报告差异&lt;/b&gt;&lt;br&gt;&lt;br&gt;表6把所有图像token放在提示开头的Collection为79.2%，与文字穿插Interleaved为71.2%；相差8.0个百分点，文中10.1%是相对下降量级。表4训练时间对应平均80.7%，但其他-m设置平均79.2%，说明不能把最快模型、最强长任务和所有平均数字混成一个模型条件。论文未展示真机实验，也未报告接触力、触觉、真实机器人成功率、能耗或完整标定误差。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_4_branch_5" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2305.0" as="sourcePoint"/><mxPoint x="2632" y="2305.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_5_field_1" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确局限为2D RGB缺深度、依赖二维检测坐标，难以理解完整三维结构；输出位置和角度，缺少力/触觉反馈，无法可靠处理插装、柔性材料等接触丰富操作。未来融合深度、力矩/触觉、物理仿真强化学习和力感知控制属于研究方向，不能当作现有实现。标题的general-purpose也受限于已测试的桌面平面动作与排除L4条件。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_5_branch_1" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_120_5_field_2" parent="paper_120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：若模型效果依赖未来参考图的检测文字，“记忆收益”可能部分来自额外目标状态信息；小模型优势也与输出维度低、环境结构简单有关。研究启发：应以相同观测信息比较单图、历史图、仅历史动作、未来图和检测描述，分离记忆与额外监督贡献；对MOC测试相机运动、遮挡下小幅目标变化，记录压缩率与失败率。迁移3D前先验证标定误差及动作可达性，不直接从VIMA平面结果推断精密真机可用。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_120_5_branch_2" edge="1" parent="paper_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-123" name="02-16 Think Small, Act Big">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3500" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_123_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_123_topnav_1" label="返回分类" link="data:page/id,literature-page-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
