        <mxCell id="paper_76_1_field_2" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_1_branch_2" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="752.0" as="sourcePoint"/><mxPoint x="562" y="752.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_1_field_3" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;本篇要让低成本、绝对定位不够准确的双臂，通过人类示范学会开小杯盖、装电池等毫米级接触任务。答案由两部分构成：ALOHA 提供容易操控的主从示教硬件，ACT 用视觉、关节状态预测连续动作块，减少单步模仿的误差累积。论文中的遥操作能力展示与自主学习结果必须分别理解：能被人遥控完成穿扎带，并不意味着策略也学会该技能（§III–V）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_1_branch_3" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1202.0" as="sourcePoint"/><mxPoint x="562" y="1202.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_1_field_4" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：用低成本双臂收集精细示范并训练动作块策略&lt;br&gt;ALOHA 把双臂主从装置和 ACT 动作块模仿学习接起来，研究细小接触任务" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_1_branch_4" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1652.0" as="sourcePoint"/><mxPoint x="562" y="1652.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_2_field_1" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：普通 Behavior Cloning 每步独立预测，细小偏差会把状态推离示范分布；DAgger 用在线专家纠正补数据，但精细操作中反复纠正、注入噪声都不方便。ACT 改变预测单位，用一段动作表达短时协调关系，也容纳人类暂停等非单步 Markov 行为（§II、IV）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_2_branch_1" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_2_field_2" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;Behavior Cloning：行为克隆，学习示范中观察到动作的对应关系&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_2_branch_2" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_2_field_3" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：相对 VR 的末端位姿加 IK，ALOHA 让操作者拖动与从臂近似同构的小臂，直接映射关节；这一取舍降低奇异点附近求解困难，却绑定特定硬件。后续 GELLO 把主臂变成廉价编码器模型，UMI 则让示教脱离机器人；这些改进针对采集接口，不能替代 ACT 的时序学习贡献&lt;br&gt;&lt;br&gt;阅读要点与补充说明：动作块：策略一次预测未来多步动作，再在执行时持续更新&lt;br&gt;普通 Behavior Cloning 每步独立预测，细小偏差会把状态推离示范分布" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_2_branch_3" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1478.5" as="sourcePoint"/><mxPoint x="1252" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_3_field_1" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 主从同构与连续夹爪&lt;/b&gt;&lt;br&gt;&lt;br&gt;两台 WidowX 为主臂，两台 ViperX 6-DoF 为从臂，每臂另含一维夹爪。主臂关节读数直接成为从臂目标，操作者看到真实工作区并闭环纠正。手柄和剪刀机构降低反拖负担，橡皮筋部分补偿重力，主臂质量及电机阻力也提供被动阻尼。该阻力不代表从端接触力被传回操作者（p3，图3）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_3_branch_1" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_3_field_2" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 主从同构与连续夹爪&lt;/b&gt;&lt;br&gt;&lt;br&gt;透明结构的定制指爪改善可见性，表面抓握带增加摩擦。系统用四台 Logitech C922x RGB 相机，两个腕视角、一个前视角、一个俯视角，各 480×640；遥操作和记录为50 Hz。完整双臂系统预算低于20000美元，包含四台臂等设备，不能与仅控制器的报价直接比较。文中未给可复用的端到端毫秒延迟实测（§III）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_3_branch_2" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="811.5" as="sourcePoint"/><mxPoint x="1942" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_3_field_3" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 必须保存“想让机器人怎么动”&lt;/b&gt;&lt;br&gt;&lt;br&gt;观察是从臂当前14维关节状态与四路图像，动作监督是主臂14维目标关节位置。两者不能混用：主从位置差经低层 PID 形成实际作用，因此只保存从臂已达到的位置，会抹去操作者有意施加的指令偏差。新平台仍需核对关节符号、零位、限位和夹爪行程，同构结构并不自动消除装配误差（p4，§IV）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_3_branch_3" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1268.5" as="sourcePoint"/><mxPoint x="1942" y="1268.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_3_field_4" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. ACT 与时间集成&lt;/b&gt;&lt;br&gt;&lt;br&gt;每次输出未来 k 步绝对关节目标，而非下一步增量。四路图像经 ResNet18，和关节、潜变量一起送入 Transformer encoder；decoder 的位置查询生成 k×14 动作。训练用 CVAE：另一 encoder 从真实动作块与关节状态编码示范风格 z，部署删除该 encoder 并令 z=0。正文实现采用 L1 重建损失与 KL 正则；伪代码写MSE，复现应注意这处表述差异（p4–6，图4、算法1）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1511" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_3_branch_4" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1743.0" as="sourcePoint"/><mxPoint x="1942" y="1743.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_3_field_5" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. ACT 与时间集成&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. ACT 与时间集成：Action Chunk（动作块）降低有效决策长度；为避免每k步才更新造成突变，策略每步重算，并对“同一未来时刻”被多个历史动作块预测的值加权平均。它平均的是同一时刻的多个预测，不是把相邻时刻动作直接平滑。算法2和图5给出时间集成流程，附录表III默认k=100（p5、18）&lt;br&gt;&lt;br&gt;3. ACT 与时间集成：每任务单独训练，约8000万参数，作者报告单张11GB RTX2080Ti约5小时、推理约0.01秒。这是指定实现的计算耗时，不等于包含相机、通信、电机执行的总延迟（p6）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_3_branch_5" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2305.0" as="sourcePoint"/><mxPoint x="1942" y="2305.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_4_field_1" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、任务与主结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;两项 MuJoCo 任务为交接方块和双臂插接，分别用脚本与人类示范；六项真实任务为拉开密封袋、装电池、开杯盖、穿魔术贴、准备胶带、穿鞋。真实任务多数各50条示范，穿魔术贴100条；有效动作约10–20分钟，连同重置及失误的采集墙钟时间约30–60分钟。不能把“10分钟示范”写成整项实验只需10分钟（§V-B）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_4_branch_1" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_4_field_2" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、任务与主结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据、任务与主结果 / 表中逐项记录：真实任务最终成功率：Slide Ziploc；ACT：88%；主要对照：四种基线最终均0%&lt;br&gt;&lt;br&gt;数据、任务与主结果 / 表中逐项记录：真实任务最终成功率：Slot Battery；ACT：96%；主要对照：四种基线最终均0%&lt;br&gt;&lt;br&gt;数据、任务与主结果 / 表中逐项记录：真实任务最终成功率：Open Cup；ACT：84%；主要对照：BeT 0%&lt;br&gt;&lt;br&gt;数据、任务与主结果 / 表中逐项记录：真实任务最终成功率：Thread Velcro；ACT：20%；主要对照：BeT 0%&lt;br&gt;&lt;br&gt;数据、任务与主结果 / 表中逐项记录：真实任务最终成功率：Prep Tape；ACT：64%；主要对照：BeT 0%" vertex="1">
          <mxGeometry height="779" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_4_branch_2" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="986.5" as="sourcePoint"/><mxPoint x="2632" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_4_field_3" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、任务与主结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据、任务与主结果 / 表中逐项记录：真实任务最终成功率：Put On Shoe；ACT：92%；主要对照：BeT 0%&lt;br&gt;&lt;br&gt;数据、任务与主结果：真实结果每配置1个训练种子、25次评估；仿真为3种子、各50次。低至20%的穿魔术贴结果应和摘要80–90%的代表任务一起保留，避免把所有任务写成同一成功区间（p8，表I–II）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_4_branch_3" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1636.0" as="sourcePoint"/><mxPoint x="2632" y="1636.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_4_field_4" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与失败证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;四种仿真设置的动作块消融中，关闭时间集成时，k从1到100，聚合成功率约1%→44%；继续增大至接近整回合会损失反应能力。时间集成给ACT约3.3个百分点收益，VINN却下降，说明它不是所有策略均有效的通用滤波器。人类示范上去掉CVAE使仿真聚合成功率35.3%→2%，脚本数据几乎不变（p9–10，图8）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_4_branch_4" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2110.5" as="sourcePoint"/><mxPoint x="2632" y="2110.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_4_field_5" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与失败证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;六人用户实验比较50 Hz与5 Hz，低频完成时间平均慢62%。这支持本文精细示教需要高频反馈，不能推导所有平台都必须以50 Hz训练。穿魔术贴失败来自提前闭爪及插接偏差，细暗目标在图像中占比很小，视觉难度与动作误差耦合（§V-C、VI-C）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2353" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_4_branch_5" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2550.0" as="sourcePoint"/><mxPoint x="2632" y="2550.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_5_field_1" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：硬件负载、速度和夹爪形态限制能力；更复杂的拆糖纸、空中展开塑料袋尝试未学成，感知及数据不足是可能原因；本文没有解决任意物体、任意场景泛化（附录F）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_5_branch_1" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_5_field_2" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的理解：同构关节映射和时间集成值得先复用，但没有触觉时，视觉成功不等于接触力安全可控。当前DH116应先离线建立6主动轴、11总自由度的耦合模型与日志字段，重点检查拇指、食指、中指的映射；多轴运动尚未验收，不能直接输出ACT命令。D435i可作为外部RGB-D观测来源，但相机布局和训练分布改变后需重新实验" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_5_branch_2" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="762.5" as="sourcePoint"/><mxPoint x="3322" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_76_5_field_3" parent="paper_76" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：最小研究模块可先做同步数据结构、目标／实测状态区分和离线动作块回放；完整ALOHA需要四臂、夹爪、四相机、支架及计算设备，已有一只手不等于已经具备双臂系统。未来可比较动作块长度与接触阶段的关系，并为失败恢复收集明确示范&lt;br&gt;&lt;br&gt;阅读要点与补充说明：可先建立四路图像与主臂目标、从臂实测状态同时间戳的数据结构，再做离线动作块回放，检查动作预测是否连续。之后才有条件研究接触阶段的真实执行误差" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_76_5_branch_3" edge="1" parent="paper_76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1289.5" as="sourcePoint"/><mxPoint x="3322" y="1289.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
