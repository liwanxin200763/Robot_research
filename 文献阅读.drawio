        <mxCell id="paper_135_authors" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Wenbin Bai、Qiyu Chen、Xiangbo Lin、Jw L（PDF如此排印）、Quancheng Li、Hejiang Pan、Yi Sun；大连理工大学信息与通信工程学院、中国科学院沈阳自动化研究所" vertex="1">
