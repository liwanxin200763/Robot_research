            <mxGeometry x="2160" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_44_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-45" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_44_1_field_1" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本；未见正式会议或期刊接收信息&lt;br&gt;引用量：引用量来源：（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_1_branch_1" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_1_field_2" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究问题与先前不足：机器人策略在执行中遇到位置偏差、掉落或接触阻塞时，需要及时纠正。反复调用 VLM 或在线优化轨迹会增加延迟；额外训练基础策略又需要纠错数据。RESETTLE 研究的是不更新基础策略权重时，如何在动作执行接口检测异常并进行一次低延迟局部纠正。（第 1–2 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_1_branch_2" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_1_field_3" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：执行监控、参考检索与局部失败恢复。Failure Detection（失败检测）判断是否异常；Failure Recovery（失败恢复）从异常现场修正，再继续原任务&lt;br&gt;核心研究问题：策略跑偏后，高层语言诊断可能慢。能否利用模型自身动作的不一致触发干预，找一个成功参考状态，用短动作纠正后立即回到原策略？&lt;br&gt;之前方法的问题：固定间隔语言监控可能漏掉快速偏差，频繁监控又增加延迟。只重试原动作可能卡在同一位置；只回到参考关节位姿又忽略物体变化" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_1_branch_3" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1447.0" as="sourcePoint"/><mxPoint x="562" y="1447.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_2_field_1" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_2_branch_1" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_2_field_2" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_2_branch_2" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_2_field_3" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：#09 Recova/#31 FLARE 用诊断、重试或重置组织恢复。局部控制纠正计算更轻，但不能处理所有错误任务目标或需要重新规划的场景&lt;br&gt;相关方向 2：Retrieval（检索）是从成功示范中找与当前最接近的参考。相近视觉特征不等于可安全到达，仍需要校验局部纠正动作&lt;br&gt;代表工作：与多个 VLA（视觉—语言—动作模型：用图像与指令生成动作） 基础策略搭配，保持基础权重冻结。用两次独立采样的动作段差异作不稳定信号，而非训练一个明确输出“抓空”的分类器&lt;br&gt;与已有方法的区别：持续分歧触发 → 同任务示范检索 → 状态伺服加视觉残差。伺服是向参考状态移动；残差是额外小修正，用来补物体和现场差别" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_2_branch_3" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1293.0" as="sourcePoint"/><mxPoint x="1252" y="1293.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_3_field_1" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;对同一观测和任务条件，用独立随机种子生成两个动作块；若时序加权的动作差异连续两次超过训练数据推理分布的 P95 阈值，就触发恢复。适配后的 V-JEPA 2-AC 编码器从同任务成功示范中检索最近的视觉帧及对应机器人状态。当前与参考状态之差给出 state-servo 先验，再以当前／参考画面的 guarded visual residual 作有限修正。每次只执行一个原生控制动作，重新观测后把控制权交还冻结的基础策略；部署时不运行辅助动力学预测器，也不额外调用 VLM。（第 3–4 节、图 2）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_3_branch_1" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_3_field_2" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：对同一观察采样两个动作段，连续两次分歧超过训练分布95百分位才触发。分歧表示不稳定；一致地做错仍可能不触发，不能当作可靠失败标签&lt;br&gt;贡献 2：用适配的视觉编码器检索同任务成功示范。参考机器人状态提供基础纠正方向，当前与参考图像提供环境差异信息&lt;br&gt;贡献 3：视觉残差在约束范围内补充纠正，执行一个恢复动作，丢弃旧动作队列并重新观察。基础策略不改，恢复控制器另行训练，不能说整个系统免训练&lt;br&gt;方法流程：正常执行 → 检查持续动作分歧 → 检索成功参考 → 状态纠正+受限视觉残差 → 执行短纠正 → 清空旧动作 → 新观察后继续原任务" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_3_branch_2" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1021.5" as="sourcePoint"/><mxPoint x="1942" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_3_field_3" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_3_branch_3" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1583.5" as="sourcePoint"/><mxPoint x="1942" y="1583.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_4_field_1" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、训练与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;恢复模块离线使用专家示范训练，结合残差动作监督、原生动作对齐、潜在动力学预测及约束损失；同一评测环境的多种基础策略共享模块，但各基础策略阈值单独校准。仿真覆盖 LIBERO-Plus、Meta-World、RoboCasa Tabletop 与 LIBERO-Pro Swap；真机为单台 Franka Research 3 的四项单臂任务。基础策略包括 FastWAM、π0.5、QwenPI、SmolVLA、LDA、QwenGR00T；还测试与 Harness VLA 高层规划器组合。成对比较中基础策略权重不变。（第 5 节、图 3；附录 C、E）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_4_branch_1" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_4_field_2" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与基线&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO-Plus 上，FastWAM 由 49.3%→58.0%，π0.5 由 70.0%→73.7%，QwenPI 由 80.2%→84.6%（表 1）；Meta-World 四难度组的非加权均值，QwenPI 为 60.66%→65.99%，SmolVLA 为 59.20%→65.48%（表 2）；RoboCasa Tabletop 的 QwenGR00T 为 53.67%→60.50%（表 3）。Harness VLA 在 LIBERO-Pro Swap 由 42%→50%（表 4）。真机每任务／方法 20 次，QwenPI 的四任务混合指标均值由 66.67%→78.75%，VLAct 由 86.25%→92.92%；其中 Use Spoon 使用阶段完成率，其余三项用成功率，不能把混合均值直接称为总成功率（表 5）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_4_branch_2" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1004.0" as="sourcePoint"/><mxPoint x="2632" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_4_field_3" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与基线&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 QwenPI 实现上，监控加生成一次恢复动作的计算时间约 83.6 ms；与 VoLoAgent 的监控加规划 322–1300 ms 相比低 74.04%–93.57%。这一测量不包含基础策略推理、物理执行与端到端响应时间；两次连续超阈值也限制了触发速度。（第 6 节、表 6；附录 D.2）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_4_branch_3" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_5_field_1" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与失败案例&lt;/b&gt;&lt;br&gt;&lt;br&gt;仅用 state-servo 时，LIBERO-Plus 三种基础策略的均值分别到 55.9%、72.9%、83.1%；加入 guarded visual residual 后到 58.0%、73.7%、84.6%（表 1）。P85、P90、P95、P99 阈值下的 QwenPI 总成功率分别为 83.1%、83.9%、84.6%、83.6%；更敏感的阈值并非在噪声扰动上最优（附录表 12）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_5_branch_1" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_5_field_2" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与失败案例&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者展示的未触发失败：碗被碰离位置、物品放错、抽屉卡住、指令不符或抓错物体时，两个动作提议仍可能一致（附录 D.3、图 8）。触发后仍失败：掉落后介入过晚、双物体误抓、抽屉卡住、动作预算耗尽、目标语义不符等（附录 D.3、图 9）。动作一致性并不证明动作正确，局部伺服也不保证无碰撞或目标符合指令" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_5_branch_2" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="811.5" as="sourcePoint"/><mxPoint x="3322" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_5_field_3" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限与本项目关联&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者所述：稳定但错误的动作可能避开 disagreement 触发器；即使触发，局部纠正也未必能处理物体丢失、复杂接触或语义目标错误。加入进度、接触或规划信号有潜力，但需要额外计算。（第 6 节、附录 D.3）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_5_branch_3" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1244.0" as="sourcePoint"/><mxPoint x="3322" y="1244.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_5_field_4" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限与本项目关联&lt;/b&gt;&lt;br&gt;&lt;br&gt;文献库分析：当前真机只验证单臂，尚无普通夹爪双臂协同证据；检索同任务成功示范依赖训练数据覆盖。可与 Recova 的独立恢复策略、Taming VLAs 的机械残差补偿比较，并设计“动作分歧＋接触／进度证据”的检测器，在双臂技能交接时验证触发率、错误恢复率与延迟。这些是研究建议，非论文已验证结论" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_5_branch_4" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1676.5" as="sourcePoint"/><mxPoint x="3322" y="1676.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_44_5_field_5" parent="paper_44" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者说明一致的空间或指令错误可能漏检；干预后也可能因物理现场或目标不匹配失败。残差约束不构成碰撞避让保证&lt;br&gt;我的理解 / 不足：我的判断：DH116 抓空与滑落未必让动作分歧变大。相似视觉参考也可能接触状态不同，应加入触觉与持物验证&lt;br&gt;未来展望：融合进度、接触和分歧信号；局部纠正失败后再升级为重规划，避免反复检索同一个无法到达的参考&lt;br&gt;对我们项目的启发：可作机械臂+DH116 的轻量恢复基线：先检测动作不稳定，检索成功抓握片段，再受限纠正；必须重建手部状态和恢复动作接口" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="1919" as="geometry"/>
        </mxCell>
        <mxCell id="paper_44_5_branch_5" edge="1" parent="paper_44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="2221.0" as="sourcePoint"/><mxPoint x="3322" y="2221.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-45" name="04-10 UAOR">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_45_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
