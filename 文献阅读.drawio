        <mxCell id="paper_36_5_field_3" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="我的理解 / 不足：我的判断：空间约束能说明手该在哪里，却未必保证接触力稳定；生成成功轨迹还可能过于规整，缺少失败后重新抓握的状态" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_5_branch_4" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
