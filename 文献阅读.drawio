        <UserObject id="paper_130_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_130_bottomnav_1" label="返回分类" link="data:page/id,literature-page-03" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_130_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-62" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_130_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-131" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_130_1_field_1" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;VidMan: Exploiting Implicit Dynamics from Video Diffusion Model for Effective Robot Manipulation，本地25页正式NeurIPS 2024 PDF与canonical题名一致。官方 https://arxiv.org/abs/2411.09153 记录首次2024年11月14日，页面只列v1；正式发表届次与预印本首次月份分开记录。旧卡引用数74本次没有重新统计，不视作当前引用量。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_1_branch_1" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_1_field_2" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Youpeng Wen、Junfan Lin（共同一作）、Yi Zhu、Jianhua Han、Hang Xu、Shen Zhao、Xiaodan Liang；中山大学深圳校区、鹏城实验室、华为诺亚方舟实验室。代码/项目核验：PDF声明代码与模型将公开，本次未核验到可确认完整发布的专属仓库。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_1_branch_2" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="846.5" as="sourcePoint"/><mxPoint x="562" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_1_field_3" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人多源数据形态复杂、动作数据相对少；若直接把图像拟合为动作，可能没有充分利用动作前后状态变化。视频预测可学环境动态，但先生成完整未来视频再用逆动力学解动作会很慢，还会把无关像素误差传给控制。本文研究如何先从视频学未来状态知识，再把同一视频网络改造成直接动作预测器，推理时无需显式生成未来画面。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_1_branch_3" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1303.5" as="sourcePoint"/><mxPoint x="562" y="1303.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_2_field_1" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人路线与差别&lt;/b&gt;&lt;br&gt;&lt;br&gt;GR-1等GPT式策略自回归预测下一帧/动作，层级图像目标策略先想象子目标再让低层执行；三维扩散策略则依赖深度、相机外参或点云表示。VidMan使用二维RGB、多帧视频扩散主干和两阶段训练：第一阶段专注未来视频，第二阶段共享主干但只监督动作，避免同时优化图像和动作造成干扰。神经科学双过程只作为设计启发，论文没有证明网络实现了人脑认知过程。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_2_branch_1" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_2_field_2" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;隐式逆动力学的含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;正向动力学问“执行动作后状态怎样变”，逆动力学问“为了从当前到目标状态要做什么动作”。本文第二阶段不先恢复目标像素，而从主干中间特征读出含未来信息的动作嵌入，故称隐式。所谓动态知识是数据中学到的状态变化模式，不能等同于可计算任意新接触条件的精确物理仿真器。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_2_branch_2" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_1" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：整理跨机器人序列&lt;/b&gt;&lt;br&gt;&lt;br&gt;按Octo数据处理从OXE选25个子集，过滤没有图像、不是末端增量控制或过于重复低质的数据，对多样数据提高采样权重，统一夹爪语义，缺失相机用零填充。默认间隔3帧采4帧：2历史、2未来。第一阶段只用第三人称256×256 RGB，以便兼容没有腕相机的多数数据，减少移动视角带来的变化。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_1" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_2" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：视频动力学预训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;用预训练视频自编码器把历史和未来编码成潜在张量，给整段视觉潜变量加扩散噪声；将历史表示及未来位置的零填充拼接为条件，再与含噪序列沿通道拼接。语言由CLIP文字编码器处理；Open-Sora/STDiT主干根据历史、语言、噪声步预测所加噪声，训练损失为噪声预测平方差。主干取12层、16头、隐藏1152，初始来自互联网视频预训练权重，再适应机器人视频。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_2" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="829.0" as="sourcePoint"/><mxPoint x="1942" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_3" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：逐层读取动作信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;第二阶段在每个视频Transformer块后加入自注意力+前馈适配器，以门控控制信息注入；学习的动作查询与主干视觉特征、可用本体状态token一起交互，逐层融合为动作嵌入。多层读取不同于只拿最终图像特征喂给控制头，能接触不同深度的状态变化表示。CALVIN用第三人称和腕部图像224×224及机器人状态；OXE有缺失通道时沿用标准化处理。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_3" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_4" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：取消昂贵的未来视频采样&lt;/b&gt;&lt;br&gt;&lt;br&gt;视频主干的扩散步固定为最大值K，未来序列输入纯高斯噪声，保留历史条件，但不运行视频反复去噪、不输出最终未来像素。网络只做一次特征计算，再由小型扩散动作头把动作嵌入解码为末端位置/旋转与夹爪控制。动作头仍需去噪，因模型小而相对主干便宜，不能把“取消视频去噪”误写成全系统没有扩散采样。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_4" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1795.5" as="sourcePoint"/><mxPoint x="1942" y="1795.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_5" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：动作监督适应目标域&lt;/b&gt;&lt;br&gt;&lt;br&gt;OXE预测12步动作，CALVIN预测10步，动作扩散训练最大100步。第二阶段只保留动作损失，让视频知识适应控制目标；可冻结主干只训适配器以快收敛，也可同时更新主干追求更高成绩。纯噪声输入与预训练噪声分布一致，附录比较零向量、干净图像均较差，说明这种接口并非随意去掉未来分支。第二阶段没有把真实未来图像作为部署时必需输入，避免信息泄漏。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2038" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_5" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2270.0" as="sourcePoint"/><mxPoint x="1942" y="2270.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_6" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;为什么动作阶段不重建所有未来像素&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉预测要解释背景纹理、无关对象和外观细节，动作学习只需影响当前控制的状态变化。逐层动作查询可以选择与手臂和目标有关的内部信息，而不承担把每个未来像素生成正确的负担。取消视频采样也缩短“预测未来—推断动作”串行链路，但主干仍处理视觉token，动作头仍扩散去噪；没有本机实时测量时，不应把结构上的省计算直接换算成某个控制频率。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2530" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_6" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2762.0" as="sourcePoint"/><mxPoint x="1942" y="2762.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_3_field_7" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;动作头与主干的分工边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;主干适配器输出的是供动作头使用的隐特征，动作头再拟合控制量分布；因此逐层查询不是读取显式物体轨迹，也没有可直接检查的未来三维状态。若要将其解释为世界模型控制，应保留这种隐式性：实验验证的是这种预训练与动作接口带来的性能变化，而非可识别的物理参数或严格可解释动力学。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="3022" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_3_branch_7" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3236.5" as="sourcePoint"/><mxPoint x="1942" y="3236.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_4_field_1" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基准与统计口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;CALVIN为Franka Panda/PyBullet桌面仿真，训练A/B/C场景、测试D场景；每链5条语言任务，报告连续完成1–5项比例和平均完成长度。使用语言标注子集，CALVIN原数据有24小时play、约1%带语言。OXE的Bridge、Taco Play、Cable Routing、Autolab UR5只做离线动作准确与MSE测试，不能等同真实执行成功。CALVIN本地正文未给明确测试链总分母，固定seed且未给该主表误差条。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_4_branch_1" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_4_field_2" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与数字解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;CALVIN平均链长3.42，对GR-1的3.06提升0.36、相对约11.7%；连续完成5任务46.7%，GR-1 40.1%，这两个提升口径不能混淆。三维3D Diffuser Actor平均3.35，首任务93.8%高于VidMan91.5%，并非每个指标都被本文超越。OXE表7离线Avg xyz ang：Bridge55.4对Octo-base49.8，Cable Routing24.8对14.9，分别是5.6和9.9个百分点；分数是动作容差判定，不是真机成功率。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_4_branch_2" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_4_field_3" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心消融与预测质量边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;CALVIN第二阶段图像动作共训平均链长2.70，动作单训3.42；无视频预训练2.89、Ego4D预训练3.29、OXE3.42；无逐层适配器1.54、冻结主干2.98、全更新3.42。帧间隔1→3时，FVD从327变差到376，控制链长却2.24→3.42；这说明更好像素视频分数不必然对应更好控制。间隔4时链长降到3.03，未来跨度过远也不总有益。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_4_branch_3" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_4_field_4" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;补充任务、计算与未验证项&lt;/b&gt;&lt;br&gt;&lt;br&gt;RLBench补充使用18任务、每任务100示范，测试每任务25 episode，并报告5种子变化；平均成功67.4%，对Act3D65.1%、RVT62.9%。第一阶段OXE在16张V100 32GB上约42小时，第二阶段OXE同数量约32小时；CALVIN第二阶段8张V100、20 epoch，未给统一总小时。正文没有新真机rollout，只有真实来源OXE离线拟合和视频展示，不能声称已完成实机高频控制验证。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_4_branch_4" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1813.0" as="sourcePoint"/><mxPoint x="2632" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_4_field_5" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;补充消融的同条件解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录纯噪声/零向量/干净图像比较在Bridge离线验证、冻结主干、小批量192、10万步条件下进行；纯噪声MSE4.8，而零向量12.1、干净图像11.2。这组较小配置的误差高于主表完整训练，不能把4.8与主表0.8横向当作同一模型重复测量。它支持接口设计选择，未独立证明噪声本身能产生物理可解释的未来。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_4_branch_5" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2287.5" as="sourcePoint"/><mxPoint x="2632" y="2287.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_5_field_1" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录承认仅二维视觉、没有显式三维感知，精确空间任务可能受限；复杂语言理解不足，未来考虑更强语言模型；整图处理缺少细粒度对象级感知，建议加入框/掩码。该处关于缺乏CLIP语言编码器能力的措辞与实际使用CLIP文本编码器不同，应理解为语言能力有限，不推断成完全没用CLIP。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_5_branch_1" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_5_field_2" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116与视觉分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;可借鉴先学视觉状态变化、再学动作的训练分工，以利用DH116动作标注少、视频相对多的条件。但现有末端七维接口需改为多指关节及腕部控制，图像可能看不出接触力和滑移。建议把物体三维几何、手指关键点或触觉作为适配器额外token，先验证接触阶段收益，再扩大任务范围；这是设计建议，论文未实施。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_5_branch_2" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="811.5" as="sourcePoint"/><mxPoint x="3322" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_5_field_3" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Sim2Real与证据取舍分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文证明的是仿真跨场景和真实数据离线预测，Sim2Real尚需真实闭环验证。适配器轻量适应可能帮助保留视觉先验，但必须分别检查动作尺度、采样频率、延迟和传感噪声。建议同时报告视频预测质量、离线动作误差与真实rollout，避免用9.9个百分点离线提升预估实机抓取收益；用同一示范与算力预算比较两阶段和共训，才能判断新增视频训练是否值得。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_130_5_branch_3" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1286.0" as="sourcePoint"/><mxPoint x="3322" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
