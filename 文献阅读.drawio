          <mxGeometry height="220" width="368" x="783" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_2_branch_4" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="940" as="sourcePoint"/>
            <mxPoint x="783" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_54_2_field_4" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="与已有方法的区别：上层预测可供性链，下层执行对应动作；双臂执行模块参数分开但联合训练。它有双臂结构，却没有语言模型多代理辩论机制" vertex="1">
