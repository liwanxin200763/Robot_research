        </mxCell>
        <mxCell id="paper_46_5_field_5" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对我们项目的启发：适合作为 DH116 的残差控制参考：基础抓握负责主要动作，小模块补指尖或腕部偏差。必须设计接触安全限制与成功判据，不能直接照搬仿真探索" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_fulltitle" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：Policy Decorator: Model-Agnostic Online Refinement for Large Policy Model" vertex="1">
