s="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1690" background="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="paper_43_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="120" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_43_topnav_1" label="返回分类" link="data:page/id,literature-page-03" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="739" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_43_topnav_2" label="上一篇" link="data:page/id,literature-paper-42" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="1359" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><mxCell id="paper_43_topnav_3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EFF3F6;strokeColor=#C4D0D8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#8093A1;align=center;verticalAlign=middle;spacing=8;shadow=0;" value="下一篇"><mxGeometry x="1978" y="42" width="601" height="62" as="geometry"/></mxCell><mxCell id="detail_43_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#43 Closed-Loop Visuomotor"><mxGeometry x="120" y="126" width="2460" height="90" as="geometry"/></mxCell><mxCell id="detail_43_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="03 动态环境与世界模型  ·  本类第 8 / 8 篇  ·  问题：模型生成了理想任务视频，现实物体却可能被碰动。怎样比较当前真实画面与期望画面，持续改变动作，避免一直照旧计划走？&lt;br&gt;方法流程：语言+当前观察 → 生成未来视觉子目标 → 比较当前与目标特征 → 反馈控制动作 → 再观察 → 根据误差纠正/重规划 → 逐步完成任务&lt;br&gt;结果：CALVIN 平均完成3.53条指令，对照3.27；五步全部完成45.4%，对照41.2%。前者表示进度，后者才是完整五步任务成功率"><mxGeometry x="120" y="228" width="2460" height="130" as="geometry"/></mxCell><mxCell id="paper_43" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="1100" width="2399" x="140" y="375" as="geometry"/>
        </mxCell>
