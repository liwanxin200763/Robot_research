            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_1_field_2" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_1_branch_2" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_1_field_3" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人世界模型若把未抓住物体的动作预测成成功举起，便会高估策略成功率并误导动作选择。现有跨机器人数据的相机标定不准，使渲染动作与视频目标错位；成功示范偏多，又使失败接触覆盖不足。DreamTrue 研究如何让多视角未来视频既服从给定动作，又保留抓空、滑落等物理失败结果。（第 1 节、图 1）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_1_branch_3" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1170.5" as="sourcePoint"/><mxPoint x="562" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_1_field_4" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：动作忠实的多视角世界模型。Counterfactual（反事实）指更换动作后询问“如果这样做会怎样”；它用来检查模型是否真跟随动作而非默认任务成功&lt;br&gt;核心研究问题：若世界模型把抓空也画成抓住，机器人会错误评估计划。怎样保证预测中的机械臂和物体运动符合输入动作，连失败也能生成？&lt;br&gt;之前方法的问题：成功示范偏多、相机与机器人几何不对齐时，生成器容易只画“好看且成功”的视频。视频逼真与动作因果一致，是两件需要分别验证的事" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_1_branch_4" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1680.0" as="sourcePoint"/><mxPoint x="562" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_2_field_1" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_2_branch_1" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_2_field_2" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_2_branch_2" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_2_field_3" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：视频世界模型可以预测视觉未来，但画面质量好不保证接触关系正确。规划若靠这种预测打分，可能挑中现实中做不到的动作&lt;br&gt;相关方向 2：后训练是在已有模型上继续改进特定行为；这里用对视频缺陷的反馈与 RL（强化学习：用奖励调整模型）改善动作跟随和交互&lt;br&gt;代表工作：#22 Mem-World 强调时空连续，#41 PLaW-VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 用未来特征控制。本篇着重预测可信度：不同动作必须造成不同结果，错误动作不应被“修成成功”&lt;br&gt;与已有方法的区别：几何标定、动作轨迹渲染与反事实反馈结合。输出是生成的未来视频，本文的主要定量数字并非机器人真实任务成功率" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_2_branch_3" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1293.0" as="sourcePoint"/><mxPoint x="1252" y="1293.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_3_field_1" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与输入输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入是初始多视角画面、任务指令和给定机器人动作序列；输出是相应的多视角未来视频，并非直接输出机器人控制动作。先利用机器人 URDF、记录的关节状态及图像匹配，联合优化相机内外参、畸变和部分机械臂安装偏移。再把不同本体的动作渲染为统一的图像空间条件：机器人 RGB、深度、amodal mask、夹爪开合及相机射线，以 VACE 条件分支驱动视频 DiT 生成未来画面。（第 3.1–3.3 节、图 2–3）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_3_branch_1" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_3_field_2" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与输入输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;第二阶段将记录动作的最终末端位姿作 SE(3) 扰动，通过逆运动学生成反事实动作；基于人工标注的机器人结构、物体一致性和交互合理性缺陷，训练视频奖励模型，并以该反馈对生成器做 RL 后训练。奖励模型评分视频，不拥有这些反事实动作对应的真实未来画面。（第 3.4 节；附录 B）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_3_branch_2" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_3_field_3" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：离线标定相机与机器人安装关系，把机器人动作渲染成彩色、深度和遮挡掩码等条件。输入不同动作时，生成器有明确的几何运动约束&lt;br&gt;贡献 2：更换动作制作反事实候选，包含能成功和会失败的执行。人标记物体异常运动、接触缺陷等，训练视频奖励模型，而非只奖励“任务看起来完成”&lt;br&gt;贡献 3：用奖励反馈后训练视频模型，减少手穿过物体、物体无接触移动等问题。它改善视觉交互一致性，但不能保证所有隐藏物理状态都正确&lt;br&gt;方法流程：记录场景与相机 → 几何标定 → 改变候选动作并渲染条件 → 生成未来视频 → 人标记交互缺陷 → 学奖励并后训练 → 再评估动作忠实性" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_3_branch_3" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1443.5" as="sourcePoint"/><mxPoint x="1942" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_4_field_1" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、基线与评测&lt;/b&gt;&lt;br&gt;&lt;br&gt;视频生成训练混合 AgiBotWorld-Beta、DROID、RoboMIND 2.0、RoboTwin 2.0，过滤后约 2,232 小时多视角轨迹，覆盖五类机械臂。奖励模型的原始标注语料覆盖约 44.9K 视频，训练／验证分别使用 31,600／4,893 条视频路径；Bridge 只参与奖励模型数据，不参与多视角生成器训练。AgiBot 反事实评测含 54 项任务的 160 组条件，每组生成结果由三位标注员判定。与 EnerVerse-AC、Genie Envisioner、DreamDojo、GE-Sim 2.0 比较，并用自身第一阶段模型做消融。（第 4.1 节、表 1；附录 B.1、C.1）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_4_branch_1" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_4_field_2" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 AgiBot 反事实测试中，自身模型从只做第一阶段到完整 RL 后训练，人工判定的物体缺陷率由 31.88% 降为 3.12%，交互缺陷率由 48.12% 降为 6.25%；完整模型的记录动作 nDTW 为 0.8772、反事实动作 nDTW 为 0.8831。48.12%→6.25% 是论文自身消融，不是相对所有外部基线的提升。（第 4.2 节、表 1）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_4_branch_2" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_4_field_3" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 RoboTwin 2.0 三项双臂任务、四个 VLA 策略、两种难度的 240 条动作轨迹上，用生成视频判断策略成败：与 Ctrl-World 相比，24 组条件的成功率 MAE 从 12.92 降至 7.08 个百分点，Spearman 排名相关从 0.850 到 0.937；假阳性从 26 条降至 12 条。这说明所测环境中减少了“失败被预测成成功”，不等于模型本身已控制双臂机器人。（第 4.4 节、图 8；附录 C.2、表 10–11）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_4_branch_3" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_4_field_4" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;校准消融中，AgiBot 的同步末端位置误差从 7.73 px 降至 4.60 px，DROID 从 11.78 px 降至 8.06 px，同时提升视频 PSNR／SSIM／nDTW；只在推理时用改进校准也带来提升，训练和推理都用时提升更大。（第 4.5 节、表 4）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_4_branch_4" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1883.0" as="sourcePoint"/><mxPoint x="2632" y="1883.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_5_field_1" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败案例与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;图 1、5–6 比较了抓空时物体错误地跟随夹爪、物体凭空消失或被复制、物体无支撑悬浮等不合理预测；完整模型在展示的样例中减少这类缺陷。RoboTwin 策略成败评估仍有 12 条失败轨迹被误判成功、11 条成功轨迹被误判失败，不能把较低平均误差理解为可靠的逐次安全验证。（第 4.2、4.4 节、图 5–6；附录表 11）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_5_branch_1" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_5_field_2" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败案例与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者所述：动作表示、生成器和 VLM 奖励模型都在图像空间工作；遮挡或视角不足时，仍可能生成或奖励视觉合理却物理错误的交互。（第 5 节）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_5_branch_2" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="787.0" as="sourcePoint"/><mxPoint x="3322" y="787.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_5_field_3" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败案例与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;文献库分析：论文提供未见过的 WidowX250 与 Piper 场景的定性预测，以及双臂策略的仿真结果，但没有证明模型在未知双臂真机上的长期闭环控制收益。普通夹爪的失败恢复若以它预判动作结果，应分别测抓空假阳性、遮挡下误判、推理延迟和重规划收益；这些是后续研究问题，不是论文已验证结论。（第 4.3–4.4、5 节）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_5_branch_3" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1219.5" as="sourcePoint"/><mxPoint x="3322" y="1219.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_42_5_field_4" parent="paper_42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者指出图像空间奖励仍可能接受视觉合理、物理却错误的结果，尤其遮挡下隐藏接触难判。奖励模型不是物理引擎&lt;br&gt;我的理解 / 不足：我的判断：如果用于恢复规划，需要额外检查抓握力、接触和碰撞。仅靠生成视频，可能把指尖内部滑动或未抓牢遗漏掉&lt;br&gt;未来展望：结合触觉、状态约束和真实执行反馈校准预测；按动作错误类型测试，明确哪些失败能被预测，哪些只能在执行中观察&lt;br&gt;对我们项目的启发：可参考其反事实测试来评估 DH116 世界模型：同一场景输入正确/错误抓握动作，检查物体是否真的随动作变化，避免预测器总是“想象成功”" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_42_5_branch_4" edge="1" parent="paper_42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1781.5" as="sourcePoint"/><mxPoint x="3322" y="1781.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
