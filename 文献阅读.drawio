            <mxGeometry x="2160" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_138_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-139" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_138_1_field_1" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题 Rethinking Bimanual Robotic Manipulation: Learning with Decoupled Interaction Framework，意为重新思考双臂机器人操作：用解耦交互框架学习。本地11页为ICCV2025的CVF公开接受版，正式论文页12427–12437；首页注明与接受版一致。作者与机构按首页记录，无法从当前PDF确定首次预印本月份或后续更新日期。本次不沿用旧卡引用数作实时值。正文使用未来时态承诺开源，不能据此认定代码当前一定可下载。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_1_branch_1" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="389.5" as="sourcePoint"/><mxPoint x="562" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_1_field_2" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体问题：独立动作与阶段性协作并存&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂场景不总需要两臂持续配合。两个瓶子同时抓起、选择离物体更近的一臂执行任务时，各臂主要学自己的动作；物体交接和叠放时又需要对方状态。传统单网络把双臂视觉和关节一起输入、同时输出高维动作，可能把无关信息过早混合，也难以表示协作需求随阶段变化。本文的目标是让每臂先具备独立操作能力，再按当前需要读取另一臂的信息，兼顾独立任务和协作任务。该框架改变策略结构和条件信息，不负责语言任务分解或人手到机器人动作映射。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_1_branch_2" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_2_field_1" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人输入输出与不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;ACT、DP、DP3等集中控制模型把两臂状态及图像或点云一起编码，输出双臂联合动作。以本文设置为例，联合动作14维，每臂为7维，包含关节与夹爪相关配置。集中模型有机会学习隐含协调，但某臂的无关运动也可能干扰另一臂训练。完全解耦路线如本文参照Voxact-b构建的基线，只看单臂输入、输出单臂动作，便于学习独立行为，却缺少交接、避碰时的状态交换。本文将两者结合：动作生成独立，必要的状态信息经过选择后交换。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_2_branch_1" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_2_field_2" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;生成方法与交互概念&lt;/b&gt;&lt;br&gt;&lt;br&gt;扩散生成器从加噪动作逐步恢复干净示范动作；流匹配生成器学习一条把简单噪声分布推向专家动作分布的速度场。两者都能描述多种合理动作，本文交互框架可装在不同生成器上。选择性交互并不是人工给每个任务写一条主从规则，而是由当前臂自己的点云和本体状态预测缩放系数与偏置向量，决定对方状态应多大程度参与以及如何对齐。这种设计仍需训练数据覆盖不同阶段，不能把系数直接解释为具备因果保证的协作判断。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_2_branch_2" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="916.5" as="sourcePoint"/><mxPoint x="1252" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_3_field_1" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;双分支解耦：每臂处理自己的输入和动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;每个机器人臂都有自己的观察编码器、状态编码器和动作生成器。观察为三维点云，状态为当前臂关节角；使用与DP3相同的点云骨干。每条分支把自己的视觉和状态特征送到生成器，输出本臂的动作序列，而不是让一个生成器同时覆盖双臂组合动作。总损失是左右臂动作损失相加，左右权重均为1。解耦减少每个预测器要建模的输出维数，有助于抓取和移动等基础动作；这不等于两臂在物理世界相互独立，空间避碰和协作仍需后续交互。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_3_branch_1" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_3_field_2" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;状态交换：用当前臂决定怎样理解对方&lt;/b&gt;&lt;br&gt;&lt;br&gt;交互模块交换的是编码后的本体状态特征，不是把全部原始视觉和全部中间信息无条件拼起来。对左臂而言，模块用左臂点云和状态经过调制编码器与MLP，预测0到1的缩放系数α1，以及偏置向量β1，再把右臂状态F2转换成α1·F2+β1；右臂对左臂同理。α调节对方信息强度，β把对方表示移到当前臂更容易使用的特征空间。两个参数都由接收方生成，符合当前执行阶段由自身判断需要何种协作信息的设计。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_3_branch_2" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="916.5" as="sourcePoint"/><mxPoint x="1942" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_3_field_3" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;融合与动作生成的具体目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;每臂生成器的条件包括自己的原始视觉特征、自己的状态特征，以及经过选择与对齐的对方状态特征。用DDIM扩散时，论文动作损失直接比较预测干净动作样本与专家样本的平方差；用流匹配时，从噪声x0和专家动作x1构造线性插值xt=t·x1+(1−t)·x0，要求网络预测目标向量x1−x0。前者学习去噪恢复动作，后者学习从噪声到动作的变化方向。交互模块不另加手工协调奖励，而由左右动作监督共同训练，所以其有效性依赖示范中是否出现等待、交接和协作顺序。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_3_branch_3" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1461.0" as="sourcePoint"/><mxPoint x="1942" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_3_field_4" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;结构选择为什么有意义&lt;/b&gt;&lt;br&gt;&lt;br&gt;完全集中会把所有阶段都当作联合高维预测，完全分开又可能看不到对方已经准备好接物。本文让基础动作在独立分支学习，再通过缩放和偏置动态引入协作信号，因此同一框架可在一臂抓杯时减少干扰，在交接阶段增加对方状态影响。缩放与偏置用途不同：只缩放无法解决特征基准不同，只偏置不能有效抑制无关信息。模型并没有显式任务阶段标注、刚性碰撞安全约束或符号计划；作者关于减少碰撞、等待和次序错误的结论来自观察到的行为和成功率，而不是数学上保证不会发生。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_3_branch_4" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2023.0" as="sourcePoint"/><mxPoint x="1942" y="2023.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_4_field_1" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真任务与训练条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboTwin选7个任务，协作类是长方块交接、按颜色顺序叠方块；非协作类是双瓶抓取简单和困难版、多样瓶抓取、按位置选择一臂敲击、按位置选择一臂放杯。各任务分开训练，因此这里不是一个统一模型零样本覆盖所有任务。实现用PyTorch、AdamW，单张RTX4090训练3000个epoch，批量120；点云与关节角为输入、关节角为动作。正式版将其余实现和任务细节指向附录5、6，本地没有附录，主比较的全部数据规模与评测细节不能靠猜测补全。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_4_branch_1" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_4_field_2" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与分类含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;7任务平均成功率本文78.9%、DP3 55.4%、参照Voxact-b的解耦基线55.1%、DP18.9%、ACT15.9%，对DP3提高23.5个百分点。本文任务成功率依次为100%、40%、99%、63%、70%、90%、90%；叠块40%仍然困难，而交接100%只对应此仿真评测设置。协作类平均70%，非协作类82.4%，均高于相应DP3。不同瓶子训练测试形状和纹理不同，用来评估类内泛化；这不能推广为对任意新任务或开放世界物体的保证。图示还记录集中模型可能抓取失败、执行顺序错或某臂长时间停住。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_4_branch_2" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_4_field_3" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融、兼容性和参数成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;使用流匹配的消融基线平均42.6%；仅解耦62.4%，提高19.8个百分点；解耦加缩放75.4%、解耦加偏置74.7%，两者都加78.9%。所以完整交互在解耦之上再提升16.5个百分点。框架接入DDIM后67.4%，对DP3 55.4%提高12个百分点；接入流匹配后78.9%，对PFM42.6%提高36.3个百分点，不能把不同生成器提升混用。参数对比中42.95M的小模型平均71.9%，仍高于262.43M的DP3 55.4%；最大本文模型536.07M为78.9%。因此优势不只来自参数增多，但最强结果也不是最小模型的结果。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_4_branch_3" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_4_field_4" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;示范扩展、三臂与真机&lt;/b&gt;&lt;br&gt;&lt;br&gt;叠块在100、150、200条示范时成功47%、53%、65%；困难双瓶为66%、74%、85%，显示增加示范有益，但这几组点不构成普遍缩放律证明。三臂SAPIEN叠块任务用50条示范、100场景测试，本文68%、DP3 40%，提高28个百分点，属于仿真。真机为Cobot Magic双臂平台，RealSense L515获取三维点云，不能记作D435i。每任务50条遥操作示范，香蕉交接、物品叠放、双瓶抓取、香蕉放置各15次测试。本文分别10/15、10/15、13/15、12/15，共45/60=75%；DP3共27/60=45%，提高30个百分点。每项次数较小，不能据此推定所有真实场景稳定达到75%。" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_4_branch_4" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2128.0" as="sourcePoint"/><mxPoint x="2632" y="2128.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_5_field_1" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者讨论与证据局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者强调框架可扩展、可接入不同生成器，并能缓解集中控制中基础抓取和阶段性协调困难；正式版没有独立的详尽局限章节。可见边界是7个仿真任务、4个真机任务，且每任务单独训练；交互只交换状态特征，受本体反馈准确性和示范覆盖限制。选择权重没有外部可解释性监督，也没有接触力和物体状态的显式失败恢复。附录缺失影响完整复现，代码承诺不能代替当前可获得性验证。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_5_branch_1" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_138_5_field_2" parent="paper_138" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向当前项目的具体分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116双臂夹爪可把每臂关节与夹爪反馈分别编码，用接收方自己的观察调节对方状态，重点测试独立抓取和物体交接是否同时改善。D435i可替代深度点云来源，但需要重新检查点云密度、工作距离、相机标定与两臂公共坐标；论文L515结果不证明D435i输入无需适配。人手视频若只提供双手三维轨迹，可先转为各臂末端目标与交接事件，再结合机器人示范训练，本文本身不提供这一步。建议除任务成功率外记录左右臂碰撞距离、等待时长和交接掉落，把失败区分为感知、抓取、次序与互撞；选择性交互不应替代运动学限位或实时安全检查。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_138_5_branch_2" edge="1" parent="paper_138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-139" name="05-15 You Only Teach Once">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3800" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_139_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
