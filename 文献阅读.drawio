        <mxCell id="paper_50_4_field_3" parent="paper_50" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：仿真相对普通推理平均提升32%是相对改善，不能写成提高32个百分点；与时间平均组合报告46%相对改善，口径仍是相对值" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_50_4_branch_4" edge="1" parent="paper_50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
