        <mxCell id="paper_27_1_field_2" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景与问题：历史依赖操作中，当前画面不足以决定下一步动作。固定采样帧或按像素变化挑帧，可能保留与动作无关的画面，却丢失先前抓取方式、对象位置或事件次数。论文把“记什么”表述为在当前观测已知时，保留历史中对动作仍有用的信息。（第 1、4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_1_branch_2" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_1_field_3" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;方向：长时序视觉记忆。VLA（看图读指令&lt;br&gt;并生成动作）只留下关键历史片段&lt;br&gt;核心问题：历史很长、记忆容量固定时，&lt;br&gt;怎样留下真正影响动作的信息？&lt;br&gt;每隔几帧抽样会漏掉短暂事件；&lt;br&gt;全存又超出模型能处理的长度" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_1_branch_3" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1394.5" as="sourcePoint"/><mxPoint x="562" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_2_field_1" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：FrameSamp 定期抽历史帧；&lt;br&gt;简单但与当前动作无关&lt;br&gt;相关方向 2：HAMLET 等历史感知策略；&lt;br&gt;把过去压入模型内部表示&lt;br&gt;代表对照：π0.5、HAMLET、FrameSamp；&lt;br&gt;评测同一批长任务&lt;br&gt;区别：递归比较候选视觉片段，&lt;br&gt;逐轮淘汰对动作较不重要的部分" vertex="1">
          <mxGeometry height="744" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_2_branch_1" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="512.0" as="sourcePoint"/><mxPoint x="1252" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_2_field_2" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_2_branch_2" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1102.0" as="sourcePoint"/><mxPoint x="1252" y="1102.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_3_field_1" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;Divide-and-Remember（D&amp;amp;R）以条件互信息 I(a_t; m_t | o_t) 解释理想记忆；实际训练使用 VLA 动作损失优化选择器，并不直接计算该互信息。方法在预训练视觉 token 空间保留历史图像 patch：共享的轻量选择器每次从 2K 个 token 选 K 个，再将相邻结果递归合并、重选。SigLIP 视觉编码器冻结，选择器用时空位置编码与自注意力评分，训练时借助可微近似和 Gumbel 噪声，部署时取 Top-K。记忆接入 π0.5 动作专家。（第 4–5 节、图 3–4）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_3_branch_1" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_3_field_2" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;阅读要点与补充说明：贡献 1：图像先切成视觉 token（小片段特征），&lt;br&gt;保留局部线索&lt;br&gt;贡献 2：选择器每轮从 2K 个候选选 K 个；&lt;br&gt;反复压缩长历史&lt;br&gt;贡献 3：用动作预测误差训练选择器，&lt;br&gt;让记忆直接服务控制&lt;br&gt;流程：历史画面切片→递归筛选&lt;br&gt;→固定大小记忆→VLA 预测动作&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="779" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_3_branch_2" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1056.5" as="sourcePoint"/><mxPoint x="1942" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_4_field_1" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、基线与实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboMME 含 16 项长程操作任务，涉及计数、遮挡后跟踪、回忆早期片段及模仿先前动作。所有模型在同一多任务示范集上训练；比较 FrameSamp、TokenDrop、HAMLET、RB-VLA、TTT 和无记忆 π0.5。仿真中记忆预算统一为 64 token，每任务评估 50 个 episode，并跨最后三个 checkpoint 和三个随机种子统计。（第 6.1 节、表 1／7）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_4_branch_1" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_4_field_2" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboMME 16 项平均成功率：D&amp;amp;R 38.6%，HAMLET 32.2%，FrameSamp 27.9%，无记忆 π0.5 17.9%。D&amp;amp;R 对依赖具体历史画面的任务更强；对持续累积的状态类事实，潜在记忆仍有竞争力。Franka Panda 真机四项任务、每项 10 次测试中，D&amp;amp;R 成功 35/40，FrameSamp 22/40，无记忆策略 3/40；这些是真机小样本结果。（第 6.2 节、表 1–2）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_4_branch_2" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_4_field_3" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;候选池扩大并非单调增益：64-token 预算下，512-token 候选池平均 38.58%，1024-token 候选池下降到 34.42%。加入世界预测辅助损失时平均成功率由 36.89% 降至 33.55%，加入历史文本 token 降至 30.32%；这两项消融固定候选池为 256 token，不能与 512-token 主设置直接比较。（第 6.3 节、表 4–6）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_4_branch_3" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_4_field_4" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：RoboMME 16 个长任务；&lt;br&gt;另测 4 类真机任务&lt;br&gt;对照：HAMLET、等间隔采帧、无记忆 π0.5；&lt;br&gt;指标是任务成功率&lt;br&gt;结果：仿真平均 38.6%；&lt;br&gt;HAMLET 32.2%，采帧 27.9%&lt;br&gt;真机：35/40 次成功；&lt;br&gt;采帧 22/40，无记忆 3/40" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_4_branch_4" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1830.5" as="sourcePoint"/><mxPoint x="2632" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_5_field_1" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;InsertPeg 中各方法成功率都很低；论文观察到策略能找到正确插入位置，但精密插入仍失败，说明记忆无法替代接触控制。真机 D&amp;amp;R 在 RepickCube 的一次失败中选错第二个方块；在 TrackCube 的一次测试中虽找到正确杯子，却因提前停止而判失败。（第 6.2 节、附录真机失败分析）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_5_branch_1" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_5_field_2" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：D&amp;amp;R 在状态类事实方面仅与潜在记忆相当，在 StopCube 和 ButtonUnmask 上落后；直接保存历史 token 不如潜在记忆善于压缩、聚合信息，多任务共享记忆也可能有冗余。（第 7 节）本库分析：方法改善历史信息选择，但没有建立针对物理执行偏差的在线检测与恢复。对当前项目可检验的组合是把历史关键状态与执行反馈对齐，判断偏差属于记忆错误、目标绑定错误还是机械执行错误；这不是本文已有结论" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_5_branch_2" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_27_5_field_3" parent="paper_27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者结果：精密插入仍很差，&lt;br&gt;该任务成功率不超过 3.3%&lt;br&gt;我的理解：筛选器能记关键画面，&lt;br&gt;但缺明确事件计数和失败原因表示&lt;br&gt;未来可把视觉片段与 ECoMEM 事件记录结合，&lt;br&gt;比较何时需要哪种记忆&lt;br&gt;项目启发：给 DH116 视频做固定预算记忆；&lt;br&gt;失败后优先保留接触与偏移画面" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_27_5_branch_3" edge="1" parent="paper_27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1373.5" as="sourcePoint"/><mxPoint x="3322" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-38" name="02-10 TraceVLA">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3900" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_38_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
