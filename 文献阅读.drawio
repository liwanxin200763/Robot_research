        </UserObject><UserObject id="paper_77_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-78" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_77_1_field_1" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CoRL 2024; PMLR 270 (published 2025)&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_1_branch_1" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_1_field_2" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：正式发表：CoRL 2024；论文集 PMLR 270，2729–2749，出版年2025，会议年与出版年不同" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_1_branch_2" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="829.0" as="sourcePoint"/><mxPoint x="562" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_1_field_3" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;Open-TeleVision关注一个容易忽略的问题：操作者和策略能否看见完成动作所需的信息。它让头显接收机器人第一视角双目图像，机器人头部随人转动，同时映射人的腕、手姿态。相机主动转向不是单纯展示功能，采集的头部动作也成为策略训练目标，因此机器人自主运行时要学会“边看边操作”（p2，图2）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_1_branch_3" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1338.5" as="sourcePoint"/><mxPoint x="562" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_1_field_4" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：通过主动双目视角改善远程双臂遥操作数据&lt;br&gt;Open-TeleVision 让操作者转头改变机器人视角，使采集的图像更接近任务所需信息" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_1_branch_4" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1771.0" as="sourcePoint"/><mxPoint x="562" y="1771.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_2_field_1" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：ALOHA式关节复制简化动作映射，却绑定机械拓扑；视觉或VR重定向换用末端目标，能适配不同臂手，但还要解决本体差异、奇异点与手指耦合。本文主要新意落在感知接口：固定第三人称画面容易被躯干／手臂挡住，单路远端RGB又丢失操作者直接观察时的双眼深度线索（§4）" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_2_branch_1" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_2_field_2" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_2_branch_2" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="997.0" as="sourcePoint"/><mxPoint x="1252" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_2_field_3" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：相比混合现实中在机器人旁直接观看，本文把机器人双目流送到远处头显，使操作者看到与策略接近的观察。ACT提供动作块学习骨架，DINOv2提供更强视觉特征；不能把成功全归于VR手势，也不能把“网页能打开”理解为手机具备完整头显手跟踪（附录E）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：动作重定向：把人的腕和手指动作变为目标机器人的可执行动作&lt;br&gt;ALOHA式关节复制简化动作映射，却绑定机械拓扑" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_2_branch_3" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1482.0" as="sourcePoint"/><mxPoint x="1252" y="1482.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_3_field_1" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 主动双目反馈闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vuer网页服务接收头显的头部、腕部SE(3)姿态与手关键点，再返回机器人双目RGB。实验使用Apple Vision Pro、ZED Mini；每眼480×640，论文称整个本地循环60 Hz。H1自制俯仰／偏航二轴云台，GR-1使用原生三轴颈部；二者只操作颈、两条七自由度臂及末端，未启用全身行走（p3，§2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_3_branch_1" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_3_field_2" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 主动双目反馈闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人头部追随人头，让兴趣区域进入较小中央画面。图像减少并不代表不需环境覆盖，而是把覆盖交给可动相机。论文展示跨约3000英里网络遥操作，但没有给该远程连接延迟的完整分布；本地60 Hz不能换算成跨洲端到端16.7 ms（附录图11）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_3_branch_2" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="794.0" as="sourcePoint"/><mxPoint x="1942" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_3_field_3" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 腕与手的两层重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;腕部位置以人头—手腕相对关系对齐机器人头—末端，腕部朝向则使用VisionPro初始化世界坐标下的绝对方向，避免头部转动时末端跟着错误旋转。先用SE(3)插值滤波抑制抖动，再用Pinocchio闭环IK求臂关节；接近可操作性边界时，在Jacobian零空间投影关节偏置（p15，附录A）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_3_branch_3" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1216.0" as="sourcePoint"/><mxPoint x="1942" y="1216.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_3_field_4" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 腕与手的两层重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;手指用dex-retargeting向量优化：五条腕到指尖向量，加拇指到食指、拇指到中指两条捏合向量；按尺寸缩放，最小化人与机器人向量差，并惩罚相邻关节变化。Inspire手缩放系数1.1，SLSQP实时求解；夹爪只用拇指—食指向量。目标手的运动学、耦合和关节范围仍需正确配置，不能复制人手角度充当通用命令（式1）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1441" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_3_branch_4" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1655.5" as="sourcePoint"/><mxPoint x="1942" y="1655.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_3_field_5" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 示范记录与学习主动观察&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集保存左右图像、机器人状态以及颈／臂／手的关节目标。H1动作28维，即14臂＋12手＋2颈；GR-1动作19维，即14臂＋2夹爪＋3颈。每任务独立训练ACT，用DINOv2替换ResNet，每眼生成16×22视觉token，与本体状态输入Transformer，输出绝对关节动作块（p4）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1898" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_3_branch_5" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2095.0" as="sourcePoint"/><mxPoint x="1942" y="2095.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_3_field_6" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 示范记录与学习主动观察&lt;/b&gt;&lt;br&gt;&lt;br&gt;默认动作块60步，插罐任务100步；时间集成平衡响应和稳定。AdamW学习率5×10⁻⁵、batch45、25000次迭代，单RTX4090。结束时操作者做固定姿态停止录制，结束姿态保留进数据，策略也学习它。采集频率、策略运算耗时和真实电机跟踪延迟应分别记录，不能只留一个“60 Hz”字段（p18–20）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2320" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_3_branch_6" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2534.5" as="sourcePoint"/><mxPoint x="1942" y="2534.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_4_field_1" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;小样本多阶段评估&lt;/b&gt;&lt;br&gt;&lt;br&gt;四任务为Can Sorting、Can Insertion、Folding、Unloading；分类同时在H1和GR-1，其余在H1。分类每平台10条完整示范，其他各20条；一次H1分类包含10次分拣，GR-1为6次。自主评估仅每任务5个完整episode，表1按子步骤计成功率，不是5个独立episode成功率的简单平均（p5、19，表1、5）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_4_branch_1" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_4_field_2" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;小样本多阶段评估 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;小样本多阶段评估 / 表中逐项记录：子任务：H1分类抓取／放置；DINOv2＋Stereo：92%／88%；ResNet18＋Stereo：74%／58%；DINOv2单目：46%／52%&lt;br&gt;&lt;br&gt;小样本多阶段评估 / 表中逐项记录：子任务：GR-1分类抓取／放置；DINOv2＋Stereo：87%／60%；ResNet18＋Stereo：83%／50%；DINOv2单目：73%／63%&lt;br&gt;&lt;br&gt;小样本多阶段评估 / 表中逐项记录：子任务：插罐抓取／插入；DINOv2＋Stereo：90%／87%；ResNet18＋Stereo：53%／70%；DINOv2单目：47%／63%" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_4_branch_2" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="899.0" as="sourcePoint"/><mxPoint x="2632" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_4_field_3" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;小样本多阶段评估&lt;/b&gt;&lt;br&gt;&lt;br&gt;抓取失败时实验者会辅助抓罐继续测后续阶段，前后数字不能相乘构造整任务成功率。折叠本方法四步均100%，ResNet也是四步100%；单目第三步60%。卸货本方法三阶段均100%，但样本很小且动作重复，不能写成普适长时操作已解决（§3.1）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_4_branch_3" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_4_field_4" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;遮挡诊断比总分更有意义&lt;/b&gt;&lt;br&gt;&lt;br&gt;GR-1夹爪遮住罐颜色，分类放置只有60%。正式版附录给罐子加可见颜色标签后，本方法抓取97%、放置100%；ResNet放置50%→97%，单目63%→93%。这支持观察缺失解释，也说明强模型不能从被完全遮挡的画面恢复未保留的语义。新增标签改变了环境条件，不应合并替换原表结果（p16，表4）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_4_branch_4" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1865.5" as="sourcePoint"/><mxPoint x="2632" y="1865.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_4_field_5" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;人类反馈与计算效率&lt;/b&gt;&lt;br&gt;&lt;br&gt;人类反馈与计算效率：四名20–25岁研究生用户比较Stereo与Mono，双目四任务平均耗时66、58、34、67秒，单目91、85、50、97秒；双目成功率均100%，单目为93%、71%、100%、50%。这是4人短时实验，不代表所有操作者（p7，表3）&lt;br&gt;&lt;br&gt;人类反馈与计算效率：中央主动裁剪比广角输入token更少：同batch10训练0.10秒对0.32秒；部署单步0.012秒对0.024秒，约83对42 Hz。实际系统仍设60 Hz并留IK／重定向时间；“83 Hz”是指定GPU、100步平均的计算吞吐，不是远程视频延迟（p7，表2）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="2108" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_4_branch_5" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2410.0" as="sourcePoint"/><mxPoint x="2632" y="2410.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_5_field_1" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：缺少触觉，在视觉被挡及接触密集任务中尤其重要；缺少专家数据重标注接口；未来可扩展到启用更多全身自由度的移动版本（§5）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_5_branch_1" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_5_field_2" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的理解：主动头部与手动作共同学习，会增加观察—动作耦合，跟踪丢失、网络抖动和限位仍需独立记录。D435i虽有深度流，不能把单路RGB-D直接当作给操作者双眼显示的ZED双目流；先做离线视野、深度与遮挡比较。DH116应按6主动轴、11总自由度重做三指向量和耦合模型，先验证离线映射及日志，多轴和臂手控制均未验收" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_5_branch_2" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="762.5" as="sourcePoint"/><mxPoint x="3322" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_77_5_field_3" parent="paper_77" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：最低成本的借鉴是同步左右视图、目标／实测动作与头部状态，并评估裁剪是否遮住关键信息；完整方案另需头显、主动云台、双目相机、双臂／手和RTX4090级训练设备。文中的头显参考价不是整套系统成本，本文没有可直接照搬的完整BOM&lt;br&gt;&lt;br&gt;对自己的实验怎样落地：可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_77_5_branch_3" edge="1" parent="paper_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1324.5" as="sourcePoint"/><mxPoint x="3322" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
