        </UserObject><UserObject id="paper_48_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-47" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_48_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-65" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_48_1_field_1" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CVPR&lt;br&gt;引用量：106（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_1_branch_1" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_1_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_1_branch_2" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_1_field_3" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Bimanual Manipulation; Dexterous Manipulation 方向，主要讨论人类双手操作能力丰富，但难以直接迁移到机器人灵巧手。&lt;br&gt;核心思路是ManipTrans 用两阶段流程，在仿真中把人类双手技能迁移到机器人灵巧手策略。&lt;br&gt;与当前项目的联系：项目联系：手型不同，普通夹爪适配仍需单独建模" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_1_branch_3" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_1_field_4" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：人类双手操作能力丰富，但难以直接迁移到机器人灵巧手&lt;br&gt;&lt;br&gt;为什么重要：展示 Human Video / Human Motion 到机器人双手动作的转换思路" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_1_branch_4" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1645.0" as="sourcePoint"/><mxPoint x="562" y="1645.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_1_field_5" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：双手灵巧操作迁移与残差学习。人的手部轨迹只是动作目标，还要机械手与物体产生正确接触，才能从“形状像”变成“操作成功”&lt;br&gt;核心研究问题：人手和机械手长度、自由度与受力能力不同。怎样高效迁移人类双手操作，同时纠正物理接触误差，而不是让机械手追着不可行轨迹走？&lt;br&gt;之前方法的问题：几何重定向能对齐手腕和指尖，却可能穿模、滑落或抓不稳。直接每任务重新强化学习又慢，已有动作跟踪能力难复用" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1870" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_1_branch_5" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2137.0" as="sourcePoint"/><mxPoint x="562" y="2137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_2_field_1" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;之前方法的问题：人手和机器人手的运动学、接触方式不同，逐帧模仿不能保证可执行" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_2_branch_1" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_2_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_2_branch_2" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="822.0" as="sourcePoint"/><mxPoint x="1252" y="822.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_2_field_3" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：动作重定向把人手运动映射到机器人；物理仿真检查接触是否真实发生。两者需要结合，不能只根据指尖位置接近就判迁移成功&lt;br&gt;相关方向 2：残差控制在已有模仿动作上补小修正。RL（强化学习：通过执行奖励改进策略）可让修正兼顾物体运动和接触，而非只追手部姿态&lt;br&gt;代表工作：与 QuasiSim 等物理迁移方法比较；#18 DexMimicGen 扩增机器人示范，本篇强调人类双手动作适配多种机械手与物理约束&lt;br&gt;与已有方法的区别：先训练通用动作跟随器，再针对物体操作学习残差。共享底层跟踪能力，减少每个新任务都从零学手部控制的成本" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_2_branch_3" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1359.5" as="sourcePoint"/><mxPoint x="1252" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_3_field_1" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：ManipTrans 用两阶段流程，在仿真中把人类双手技能迁移到机器人灵巧手策略&lt;br&gt;&lt;br&gt;先学会跟随运动，再修正接触：ManipTrans 第一阶段预训练通用轨迹模仿器，让机器人手在仿真中跟随人类手部运动；第二阶段固定这一运动先验，微调任务特定残差模块，在交互约束下修正动作。这样把自由空间运动与抓物后敏感接触分开处理，避免每个新操作都从头探索高维双手动作&lt;br&gt;&lt;br&gt;残差修正的是物理可行性：人的指长、关节轴和机器人不同，只把参考手形投过去可能拿不稳物体。第二阶段利用物体交互和任务约束，让动作既保留示范的任务意图，又允许偏离人类参考以保持接触。输出是经过仿真交互训练的机器人控制行为，不是对原视频逐帧做无误差的机械复制" vertex="1">
          <mxGeometry height="779" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_3_branch_1" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="529.5" as="sourcePoint"/><mxPoint x="1942" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_3_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：先训练模仿器跟踪手腕、指尖与平滑运动，适配机器人关节范围。它负责把人的运动转换为机械手可跟随的基础轨迹&lt;br&gt;贡献 2：冻结模仿器，再输入物体和接触状态，训练任务残差修正。目标是物体真的被抓、移、转，而非只让机器人的手看起来像人的手&lt;br&gt;贡献 3：用 PPO（近端策略优化：限制每次策略更新幅度的强化学习算法）及先易后难的课程训练，提高物理跟随要求；生成约3.3k段 DexManipNet 示范，验证多手型迁移并展示真机操作&lt;br&gt;方法流程：人类双手运动+物体状态 → 目标手重定向 → 训练动作模仿器 → 仿真执行检查接触 → 学任务残差 → 输出可执行双手轨迹 → 真机验证" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_3_branch_2" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1284.0" as="sourcePoint"/><mxPoint x="1942" y="1284.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_4_field_1" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：双手灵巧操作仿真任务；详细任务和基线见论文&lt;br&gt;&lt;br&gt;主要结果：作者报告成功率、动作保真度与训练效率优于所比较方法；摘要未给统一数字&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：双手灵巧操作仿真任务；详细任务和基线见论文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告成功率、动作保真度与训练效率优于所比较方法；摘要未给统一数字" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_4_branch_1" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_4_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：在不同物体交互、双手动作与 Shadow/Inspire/Allegro 等手型中测迁移，关注轨迹跟踪和任务操作；不能把所有手型与任务自合成总成功率&lt;br&gt;对照：比较直接模仿、不同残差/训练阶段和已有物理迁移方法，区分“跟手轨迹”与“控制物体”的要求&lt;br&gt;结果：仿真迁移单手/双手成功率58.1%/39.5%，几何重定向+残差基线47.8%/13.9%。成功要求物体旋转、平移及手部跟踪误差都低于阈值，不等于自由任务完整成功率&lt;br&gt;真机 / 关键补充：真机使用双 Realman 臂与 Inspire 手；仿真和实手关节接口仍需映射。实际演示支持可执行性，但不应扩大成 DH116 已验证或普适零样本成功率" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_4_branch_2" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_4_field_3" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_4_branch_3" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1601.0" as="sourcePoint"/><mxPoint x="2632" y="1601.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_1" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：手型不同，普通夹爪适配仍需单独建模&lt;br&gt;&lt;br&gt;主要局限：仿真到真机与普通夹爪迁移尚不能从摘要确认&lt;br&gt;&lt;br&gt;局限与启发：主要局限：仿真到真机与普通夹爪迁移尚不能从摘要确认" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_5_branch_1" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：论文讨论输入人手轨迹噪声、物体建模和实际硬件限制；物体关节或形状估计错误时，物理优化的目标也可能不正确&lt;br&gt;我的理解 / 不足：我的判断：仿真中的接触参数与 DH116 真机摩擦不同，即使动作能跟随，物体仍会滑；需要将真实接触反馈加入修正&lt;br&gt;未来展望：用真机触觉和物体状态校准残差，生成失败后重新握紧或换接触点的示范，把迁移从正常动作延伸到异常恢复&lt;br&gt;对我们项目的启发：适合 DH116 的双手示范迁移参考。先训练适合自身关节结构的跟随器，再单独学习接触残差；不能直接复制其他手型的关节动作" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_5_branch_2" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_3" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_5_branch_3" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1496.0" as="sourcePoint"/><mxPoint x="3322" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
