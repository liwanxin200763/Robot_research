        <mxCell id="paper_12_2_field_4" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="与已有方法的区别：不让整个 VLM 在后续所有层持续处理全部历史 token，而是在中间层把历史压缩成一个 context token，保留当前帧细节同时降低多帧计算成本" vertex="1">
