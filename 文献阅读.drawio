            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_124_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-20" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_124_1_field_1" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：HAMSTER: Hierarchical Action Models for Open-World Robot Manipulation，展开为Hierarchical Action Models with SeparaTEd Path Representations。本地ICLR 2025版29页，Li、Deng、Zhang共同一作，Li项目负责人，机构NVIDIA、华盛顿大学、南加州大学。官方https://arxiv.org/abs/2502.05485首发2025年2月8日，最新v4更新5月10日；该页面12名作者比本地11名多Raymond Yu，Caelan以全名Caelan Reed Garrett列出。笔记实验依据本地会议版，不混用新版作者身份。引用量未实时核验。" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_1_branch_1" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="424.5" as="sourcePoint"/><mxPoint x="562" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_1_field_2" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、问题与目标能力&lt;/b&gt;&lt;br&gt;&lt;br&gt;大VLM有开放语义知识却缺机器人动作数据，小型3D模仿策略有局部精度却缺语义泛化。本文问如何让两者结合，且利用不来自部署机器人环境的廉价数据。目标是让高层预测“图像平面上该往哪里走、何时开合”，低层用点云/本体状态解决深度、姿态和精确动作。这个中间接口不要求跨域数据拥有一致的低层控制量，从而允许仿真、其他本体机器人数据辅助真实部署。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_1_branch_2" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="969.0" as="sourcePoint"/><mxPoint x="562" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_2_field_1" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与分层意义&lt;/b&gt;&lt;br&gt;&lt;br&gt;单体VLA直接微调VLM出动作，视觉语言知识与具体机器人动力学接口耦合；小3D策略如RVT-2和3D Diffuser Actor擅长局部几何，却可能忽略复杂指令。RT-Trajectory把人画或通用VLM轨迹当灵活任务输入，HAMSTER进一步在跨域数据上训练路径预测器，并让专门策略负责执行。本文创新重心是分层为何便于利用off-domain监督，不是首次提出用路径指定任务。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_2_branch_1" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_2_field_2" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;二维路径与域外数据术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;路径是归一化像素位置顺序及夹爪开合事件，表示末端/人手在观察图中的粗运动，不等于可直接执行的三维轨迹。路径点在2D中可由姿态投影或点跟踪得到，故对机器人本体和动力学差异较不敏感；仍受相机、遮挡与深度歧义影响。论文概念上允许无动作人类视频和手绘草图，但实际训练主混合以RoboPoint、RLBench、Bridge/DROID和VQA为主，不应写成已大规模用人类视频训练。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_2_branch_2" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_3_field_1" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;高层输入→路径输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;高层VILA-1.5-13B读取单目RGB初始图像和任务描述，输出粗二维路径p。主文简图用(x,y,gripper_open)表示，但附录真实提示输出0–1坐标列表，并在列表中用Open Gripper/Close Gripper语言事件标开合；二者表示层级应区分。高层只看到RGB，不使用低层额外点云/深度。它主要决定任务相关对象、顺序和意图，不负责每个接触动作的精细旋转或力。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_3_branch_1" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_3_field_2" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;高层多域监督的具体来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboPoint约77万点定位任务提供“找哪里”，多为无序点/框而非时序路径；RLBench选前视角可见的81任务，每任务1000成功episode，约4种指令形成32万图像-指令-路径样本。Bridge约1万轨迹和DROID约4.5万视角轨迹形成真实场景路径，图3共约11万路径样本。DROID的4.5万约对应2.2万独立轨迹、每轨迹两个相机视角，不能当4.5万个完全独立行为。另混入66万VQA样本以保持世界知识，按全样本等权采样、标准监督答案似然训练。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_3_branch_2" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_3_field_3" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;标签处理、成本与数据非完全自动&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真用运动学与相机标定投影末端；Bridge外参需每场景随机抽帧人工标夹爪中心，以PnP估投影矩阵并检查/筛不对齐；DROID筛深度/RGB投影不准的外参。所以它减少新部署数据依赖，但并非所有源标签自动零人工。长路径经Ramer-Douglas-Peucker简化，阈值0.05，短任务约2–5点，保留开合关键点。8张A100训练约30小时、每卡约65GB、有效batch256、学习率1e-5，全模型含视觉编码器都更新。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_3_branch_3" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_3_field_4" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;低层路径条件策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;低层可选RVT-2或3D-DA，读取当前RGB、点云/深度、本体状态和路径。将路径以渐变颜色线画进各帧，标示时间顺序，圆点表示开合；RVT-2还可用原RGB加独立RGB路径图拼为6通道，避免重投影破坏线条。低层训练用真实示范投影出的oracle路径，坐标加N(0,0.01)噪声增强，夹爪事件不加噪。RVT-2路径版删除语言输入；真机3D-DA简化语言、减小模型避免小数据过拟合，仿真则保留详细语言更好。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_3_branch_4" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1935.5" as="sourcePoint"/><mxPoint x="1942" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_3_field_5" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;执行闭环与分层边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;图2实际高层起始调用一次产生路径，低层持续读新观察并跟随路径；总体架构允许高低层不同频率，主文说高层可调用一次或少数次，但附录明确当前路径无法随显著环境变化动态调整或重新识别目标。不能把该低层闭环误写成高层每步重规划/反思恢复。低层不用严格几何约束跟线，可能偏离；路径也不包含力/旋转细节，仍需本体策略学会这些控制。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_3_branch_5" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2445.0" as="sourcePoint"/><mxPoint x="1942" y="2445.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_4_field_1" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机数据、任务与评分&lt;/b&gt;&lt;br&gt;&lt;br&gt;Franka Panda遥操作320条：220条抓放、50条推倒物体、50条按按钮。高层没有用部署域数据训练，低层和基线使用相同320条，OpenVLA也在这些数据上LoRA适配。测试74任务、每模型共222次，跨基本、对象目标组合、视觉、语言、空间、未见物体、多重变化七轴。附录评分是进度得分：抓放四阶段各0.25，推倒接触/推倒各0.5，按按钮定位/按下各0.5，因此论文success score不是严格完整成功率。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_4_branch_1" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_4_field_2" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机结果与相机变化&lt;/b&gt;&lt;br&gt;&lt;br&gt;摘要平均提高约20个百分点、相对约50%，必须连同上述进度评分解释。表6按任务类型：抓放HAMSTER+RVT2为0.79、+3DDA0.78、OpenVLA0.46；按按钮0.50/0.63/0.25；推倒0.47/0.66/0.41。新相机10次测试，RVT2叠画路径score0.73、完整成功0.40；独立6通道路径score0.98、完整成功0.90；OpenVLA0.23/0。score与complete两列明确不同，不能只挑score98%称98%全程成功。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_4_branch_2" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="899.0" as="sourcePoint"/><mxPoint x="2632" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_4_field_3" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真与示范效率&lt;/b&gt;&lt;br&gt;&lt;br&gt;Colosseum从20任务中去掉前相机可见性差的6项，实际14任务；各100训练episode、每视觉扰动25评价episode、5随机种子。平均3D-DA0.35±0.04、HAMSTER0.46±0.04，绝对增0.11、相对约31%，不是增加31个百分点。五任务少示范子集：3DDA0.18±0.10，HAMSTER半数据0.36±0.04、全数据0.43±0.05。该2倍比较只对所选五任务，不代表所有基准半示范都达到同样比例。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_4_branch_3" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_4_field_4" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;设计消融、人工路径评价与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;给OpenVLA加入相同RLBench数据再真机适配，基本抓放平均score0.54对未加仿真0.58，支持单体接口未充分利用该源数据，但仍有训练结构混杂。48图像-指令对由5位机器人研究者给四种路径排序：完整HAMSTER平均rank1.40、无仿真2.13、零样本GPT-4o3.47、CaP/GPT-4o3.41；人工排序是预计可执行性，不是真机成功率。高层30小时训练成本有据，本文未给整体端到端延迟和低层训练总GPU时；引用OpenVLA6Hz不等于实测HAMSTER频率。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_4_branch_4" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1900.5" as="sourcePoint"/><mxPoint x="2632" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_5_field_1" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限与失败分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确2D接口缺原生3D理解，无法传递力或旋转细节，显著场景变化时路径不更新。失败分为路径预测错、低层不跟路径、正确跟随但抓取/执行失败。附录统计RVT失败72%属于路径遵循、28%执行；3DDA为10%/90%，该条件失败分布不是总体失败率。两种低层的瓶颈不同，增加高层语义知识不能自动修复末端滑落和接触误差。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_5_branch_1" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_124_5_field_2" parent="paper_124" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：训练用oracle路径、部署用预测路径有分布差，微小高斯噪声未必模拟语义错对象或深度歧义；长程示例主要定性，不能替代系统长任务统计。研究启发：分开评路径对象正确性、三维可达性、路径遵循与接触成功，以真实预测路径做低层训练增强；将重规划触发条件与低层可靠性相连，避免场景移动后机械照线。若扩展双臂，应增加臂身份、协作约束和相对接触状态接口，现有单臂结果不保证协同有效。建议未在本机执行。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_124_5_branch_2" edge="1" parent="paper_124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-page-data-08" name="08 数据与遥操作">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="5680" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="category_08_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
