            <mxGeometry x="2160" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_53_topnav_3" label="下一篇" link="data:page/id,literature-paper-54" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_53_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#53 SpatialVLA">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_53_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="07 VLA 基础与泛化  ·  本类第 3 / 13 篇  ·  问题：模型知道“拿杯子”，却可能分不清该伸多远、抬多高。怎样把三维位置和动作几何关系显式放进模型，并在换机器人时适配？&lt;br&gt;方法流程：图像 → 估计深度+三维位置编码 → 结合语言 → 预测自适应网格动作符号 → 还原连续动作段 → 执行并重观察；换平台用新示范适配网格">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
