            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_98_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-99" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_98_1_field_1" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / NeurIPS&lt;br&gt;引用量：12（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作&lt;br&gt;数据链条位置：把机器人轨迹转为视觉问答数据" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_1_branch_1" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_1_field_2" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_1_branch_2" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_1_field_3" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;机器人数据还可以教模型理解什么&lt;/b&gt;&lt;br&gt;&lt;br&gt;真实轨迹除视频外还记录末端位置、夹爪开合及部分深度或力信号，这些信息可以回答物体是否可达、动作进行到哪一步、是否抓稳等问题。Robo2VLM 把已有机器人数据变成有依据的视觉问答，用于测量和改善视觉语言模型的空间与交互理解；它主要训练理解前端，没有在本文把回答正确直接转成运动控制" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_1_branch_3" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1170.5" as="sourcePoint"/><mxPoint x="562" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_2_field_1" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;为什么普通图文问答不够：互联网图文经常描述物体是什么，却缺少机器人与物体的精确空间关系；仿真能提供标签，却有真实光照、遮挡和接触差异。OXE、DROID 已有真实机器人轨迹，Robo2VLM 复用这些传感记录生成问题，减少重新标注成本。它与直接训练动作的 VLA 共享数据来源，但学习目标是问答" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_2_branch_1" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_2_field_2" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_2_branch_2" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="997.0" as="sourcePoint"/><mxPoint x="1252" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_2_field_3" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;问答题需要正确答案的来源。比如从 RGB 判断物体在左还是右，与根据机器人末端坐标判断是否可达，是不同证据；多模态轨迹提供后者所需的额外信息。本文利用这种结构化传感记录生成监督，价值在于答案可以追溯，而不是让大模型凭常识再编一组看起来合理的问答" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_2_branch_3" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1412.0" as="sourcePoint"/><mxPoint x="1252" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_3_field_1" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;从连续轨迹到有语境的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;从连续轨迹到有语境的问题：先结合末端、夹爪及传感信号，把轨迹切成接近、稳定、接触、释放和复位等阶段；再提取目标物体与机器人状态，按问题模板生成多选题。不同问题依赖不同模态，例如跨视角对应需要双目图像，交互状态需要时间和接触线索，不能从只有一张 RGB 的样本补猜不存在的深度真值&lt;br&gt;&lt;br&gt;输出与训练过程：生成图像、问题、选项和答案，覆盖空间推理、目标条件推理、交互推理三组能力。对数据来源重新加权，避免最大的数据集控制整个分布，再划分训练与测试。模型微调学习从画面和问题选择答案；分阶段标签用于构造监督，不意味着运行时机器人已经具备可靠任务进度传感器" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_3_branch_1" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="477.0" as="sourcePoint"/><mxPoint x="1942" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_3_field_2" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：接近、接触和释放阶段适合的问题不同：刚接近时问几何与目标，抓持中问是否稳定，动作后问任务是否完成。以阶段组织问题能减少脱离时序的标签，但阶段切分错误也会把释放后的画面当成抓持中状态。构造数据时应保留轨迹来源和题目使用了哪些传感字段，便于逐类抽查&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_3_branch_2" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1179.0" as="sourcePoint"/><mxPoint x="1942" y="1179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_4_field_1" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据规模与评价协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;NeurIPS 2025 Datasets and Benchmarks 原文从 13 个 OXE 子集取约 17.6 万条真实轨迹，形成 684,710 道问题，覆盖 463 个场景和 3,396 项操作任务。比较 14 种开放模型配置、不同参数规模与是否逐步推理，并测人类参考表现；统计单位是问答题，不是机器人成功回合" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_4_branch_1" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_4_field_2" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 3 零样本总体准确率中，LLaVA 1.5-7B 为 21.58%，Qwen 2.5 VL-32B 为 37.68%，72B 为 37.76%，说明大模型仍有空间和交互理解缺口。使用所生成数据微调 LLaVA 可改善多项能力，但提升随问题类型与训练规模变化；不能把文中某类最高增益概括为所有类别统一提高 50 个百分点，更不能称真机成功率提高" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_4_branch_2" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_4_field_3" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：整体问答准确率会受题型配比影响，空间题提升可能掩盖交互题仍很弱。论文分别列十一类能力与三组推理类别，并比较零样本和逐步推理提示；提示模型解释过程不保证答案改善，部分模型甚至退化。因此读结果应看同模型同题目的前后变化，而不只看最大模型总分&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_4_branch_3" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_5_field_1" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;生成标签与动作结果必须分开验收&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成标签与动作结果必须分开验收：自动问题会继承轨迹切分、物体定位及传感缺失错误，模型也可能学习模板和选项偏差。若为自己的数据集增加问答标注，可先从有可核对记录的问题开始，例如夹爪是否闭合、当前是否移动物体，再人工抽查。要另做真实任务执行评测，才能判断理解前端改善是否传到控制端&lt;br&gt;&lt;br&gt;把关键设计与实验读透：若自己建立视觉问答辅助数据，训练测试必须按物体、场景和采集批次隔离，避免同一轨迹相邻帧落到两边，让模型只凭背景记答案。最终还要设计不依赖选项的理解检查，例如定位目标或预测接触阶段，再测它是否帮助机器人真正少抓错物体" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_5_branch_1" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_98_5_field_2" parent="paper_98" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_98_5_branch_2" edge="1" parent="paper_98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1004.0" as="sourcePoint"/><mxPoint x="3322" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
