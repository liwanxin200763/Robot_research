        </mxCell>
        <mxCell id="paper_35_1_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份 / Venue：2024 / Robotics: Science and Systems (RSS) 2024&lt;br&gt;关联：机器人数据采集与数据质量；机器人遥操作与动作重定向" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_1_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="829.0" as="sourcePoint"/><mxPoint x="562" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_1_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexCap 把“无需机器人采集自然人手示范”变成可执行工程系统：手套测手指相对运动，SLAM 追踪腕部与胸部，胸前 RGBD 记录环境，数据统一在世界坐标。DexIL 再把手形与环境转换到机器人空间，用点云扩散策略学习操作，困难任务可加入人在回路纠正。输入是专用可穿戴动捕和三维观察，输出目标腕姿与目标手关节，不是从普通 RGB 视频直接训练（§III–IV）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_1_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1356.0" as="sourcePoint"/><mxPoint x="562" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_1_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;六项真机任务显示点云表示与纠正数据的价值，但最复杂剪切/泡茶仅靠人类动捕并未完成完整任务。论文同时提供采集系统、转换算法与训练实验，不能把策略收益完全归为手套本身“更高质量”。对本项目，最值得借鉴的是统一坐标、轨迹切分、采样率管理和把采集数据与纠正数据区分" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_1_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1830.5" as="sourcePoint"/><mxPoint x="562" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_1_field_5" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：灵巧操作的数据采集与模仿学习（从人的示范学习怎样行动）。策略 Policy 是根据观察输出动作的规则或模型。这里先解决数据来源，再学习控制&lt;br&gt;核心研究问题：人直接捏、拿、转动物体很快，机器人遥操作却慢。怎样同时记录手指、手腕和物体，再把这些人手动作变成机器人手的训练示范？&lt;br&gt;之前方法的问题：只用相机追踪手会被物体遮挡；固定动捕设备不便搬动。人手与机械手的尺寸、关节也不同，直接复制人的关节角可能碰不到物体" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_1_branch_5" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2340.0" as="sourcePoint"/><mxPoint x="562" y="2340.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作与先前不足：相机手姿估计容易被抓物遮挡，IMU 位置积分会漂移；EMF 手套能测手指但缺世界系六维腕姿；固定多相机动捕又不便在不同场景穿戴采集。本文组合三类传感器，不主张某一个传感器解决全部问题（§II–III）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Behavior Cloning：行为克隆，学习示范中观察到动作的对应关系&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexMV、VideoDex 等人类视频方法常用视觉/动作先验后再补机器人数据；手持夹爪系统适合平行夹爪，缺多指精细动作。DexCap 用手指几何和三维场景直接构造低层监督，DexIL 用 Diffusion Policy 表达双臂高维动作。它仍有本体差异，尤其人手与 LEAP 的尺寸、指厚、接触力不同，所以保留纠正接口而非声称几何对齐已解决迁移（§II、§IV-C）" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1426.0" as="sourcePoint"/><mxPoint x="1252" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：遥操作让人控制机器人采示范，但受机器人速度限制。可穿戴动捕直接记录自然手部运动，仍需解决腕部漂移和环境信息缺失&lt;br&gt;相关方向 2：行为克隆 Behavior Cloning（行为克隆，用示范的观察—动作配对模仿专家） 用示范中的“观察—动作”训练模型。人手数据要先重定向：把人的运动转换为目标机械手可执行的运动&lt;br&gt;代表工作：UMI 用手持设备采操作；Diffusion Policy（扩散策略：反复去噪，生成连续动作）可学习多种动作。DexCap 把输入扩展到多指人手和三维场景&lt;br&gt;与已有方法的区别：#25 DexUMI 更强调与机器人手一致的可穿戴接口。DexCap 用电磁手套记录手指，再配合腕部定位和三维相机；两者采集硬件和迁移途径不同" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2023.0" as="sourcePoint"/><mxPoint x="1252" y="2023.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 硬件、坐标标定与记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rokoko 动捕手套提供相对手背 hub 的指尖位置；按论文描述采用 EMF。每只手背安装一台 T265，以双鱼眼＋IMU 的 SLAM 跟踪腕姿；胸部另有一台固定 T265 和 L515 LiDAR RGBD。胸架卡槽给相机已知初始变换，先全部放胸架建图，再把下面两台移至手背固定插槽；胸部主 T265 初始位姿定义世界系。由固定外参把腕姿、手指和环境点云放到共同坐标，不能省略胸部运动补偿（图2、§III-A、附录 A）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 硬件、坐标标定与记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集背包含 NUC 13 Pro、64GB RAM、2TB SSD、40000mAh电源，约四十分钟续航；文中采集系统约四千美元是当时系统预算，不含双臂机器人，也非当前采购价。正文约十秒标定与附录约十五秒准备口径不同，不据此承诺固定用时" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 硬件、坐标标定与记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;关键工程边界是缓存：原始记录60fps，RAM约十五分钟后转SSD会降至20fps，并可能影响SLAM产生跳变，因此实际优先取每session前十分钟。采后写盘约三至五分钟。作者人工标记每项示范起止、剔除复位运动，训练再降至20Hz；纠正数据直接20Hz。60Hz采集、20Hz控制及端到端延迟是不同指标，本文未报告统一时延与跨设备同步误差（§V-A、附录 A-B）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 动作重定向与观察转换&lt;/b&gt;&lt;br&gt;&lt;br&gt;LEAP 四指十六关节，人手小指不参与IK；以人腕六维姿态初始化、匹配其余指尖位置。末端姿态与十六手关节构成本体状态，下一时刻状态作位置目标监督，不是简单复制人手关节角。两臂配两手形成46维动作表示，其中每腕位姿用七维位置/四元数；不能把它误作两臂全部关节角（§IV-A、图4）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1795.5" as="sourcePoint"/><mxPoint x="1942" y="1795.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_5" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 动作重定向与观察转换&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGBD先变彩色点云，用胸部SLAM变到世界系，再人工一次调整到机器人工作区；同地点共用变换，手轨迹必须做同样变换。去掉桌下与无关点，保存5000点到HDF5，训练下采样1000点。用机器人正向运动学渲染手点云并并入观察，减轻外观差异；二维随机平移同时作用点云与轨迹，不能只动图不动动作（附录 A-C/E）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2038" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_5" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2252.5" as="sourcePoint"/><mxPoint x="1942" y="2252.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_6" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 策略与人在回路纠正&lt;/b&gt;&lt;br&gt;&lt;br&gt;动捕/场景 → 统一世界系 → 同步观察与动作变换 → 指尖IK → 点云Perceiver＋本体状态 → 扩散未来动作 → 控制器。 训练输入历史三步，batch16、学习率10⁻⁴、3000epoch，DDIM训练100扩散步/推理10步。机械臂OSC、手关节阻抗执行位置目标；未到目标超十步重新查询。GPU型号、总训练时间未报告（附录 A-D/E，表VII）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2495" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_6" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2709.5" as="sourcePoint"/><mxPoint x="1942" y="2709.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_7" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 策略与人在回路纠正&lt;/b&gt;&lt;br&gt;&lt;br&gt;可选纠正有小幅残差与完整遥操作两模式，脚踏切换。前者把人腕/手指相对初态增量叠加到策略，后者暂时接管；纠正日志保存发给控制器的目标命令，而非把未达到的实际位置误当命令。新纠正集与原始集等概率采样微调，故复杂任务的改进包含真机在回路数据（§IV-C、附录 A-G）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2952" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_7" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3166.5" as="sourcePoint"/><mxPoint x="1942" y="3166.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_8" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把电磁手套、腕部定位相机和胸前深度相机组合成便携系统。手套测手指，腕部相机做同步定位与建图，深度相机记录物体，让遮挡下的手运动仍可追踪&lt;br&gt;贡献 2：用逆运动学（由指尖目标位置反求机械手关节角）将人手示范映射到 LEAP 手；把三维点云（空间中的采样点）与动作配对，训练 DexIL 扩散策略&lt;br&gt;贡献 3：允许人接管失败执行，补入纠正示范再训练。它补的是策略没见过的异常状态；这属于人在环的数据改进，并非机器人自动诊断和恢复&lt;br&gt;方法流程：人自然操作 → 同步记录手指/手腕/三维场景 → 映射为机械手动作 → 训练策略 → 真机执行 → 必要时人纠正 → 加入新示范继续训练" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="3409" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_8" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3728.5" as="sourcePoint"/><mxPoint x="1942" y="3728.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;前三级任务 Sponge picking、Ball collecting、Plate wiping 的三十分钟采集分别得到251/179/102条；Packaging一小时多于十个场景，104条；Scissor cutting与Tea preparing各一小时96/55条。一般每配置每任务二十次，Packaging为六个训练物体各五次、九个新物体各五次，分别30/45次；表中Subtask与All必须分开（§V-A）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：数据/配置：仅动捕 DP-img；海绵：0%；收球：0%；擦盘：0%；平均：0%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：数据/配置：DP-point；海绵：75%；收球：65%；擦盘：50%；平均：63%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：数据/配置：DexIL DP-perc；海绵：85%；收球：60%；擦盘：70%；平均：72%&lt;br&gt;&lt;br&gt;实验与结果：Perceiver并非每项都胜PointNet，收球60%低于65%；遮罩图像DP平均42%。纯图像失效说明这些条件下外观/视角迁移困难，不证明所有图像策略无效（表I）" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="934.0" as="sourcePoint"/><mxPoint x="2632" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;Packaging全任务训练物体47%、新物体40%；加三十条纠正后57%/42%，新物体收益很小。剪切完整任务由0到20%，泡茶0到25%；泡茶开盖子任务由30%到65%，不是整任务65%。这些改进都含新真机纠正，不能宣传为仅人类动捕零机器人数据（表II–IV）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1496.0" as="sourcePoint"/><mxPoint x="2632" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;漂移表VIII在两条回起点轨迹上，IMU-only为8.0±3.1/11.3±4.7cm，SLAM-IMU为0.4±0.2/0.8±0.3cm，是端点漂移诊断，不是所有复杂抓取条件下的三维指尖误差。Ball collecting吞吐约遥操作三倍也仅对应这项演示，不宜扩成所有任务三倍效率（图8、附录 B-A）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1918.0" as="sourcePoint"/><mxPoint x="2632" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者承认：续航约四十分钟；指厚与比例差异使指尖IK不保证可用接触；没有力传感。Packaging中稳箱力不足、盒盖离开胸相机视野；剪刀需要深入指环、镊子抓取需精确指尖，几何复制不足（§V、§VI）。缓存降帧与SLAM跳变是附录明确工程限制，不应在使用摘要时遗漏" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的推论：统一坐标不等于无漂移或完全同步，传感器标定、异常追踪、点云裁剪与手—物关系都应有日志。D435i可先承担离线场景点云，但没有T265腕部/胸部位姿与手套，就不能按原系统生成同质量人手动作。可先搭低成本模块验证坐标、时间戳、静态重投影与三指可达性，再决定手套/追踪设备投入" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="776.5" as="sourcePoint"/><mxPoint x="3322" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116右手六主动轴/十一总自由度与十六主动关节LEAP不兼容，应重新定义三指受限IK和耦合，左手仿真资产不能代替右手真机标定。当前整手/多轴仍锁定且原因未知，优先离线运动学、仿真与数据审计；机械臂/双臂、视觉训练GPU、动捕设备均是额外条件，不能据论文暗示已完成臂手验收。后续可单独消融点云、纠正与重定向误差，避免把高策略分数当成普适采集质量证明" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1251.0" as="sourcePoint"/><mxPoint x="3322" y="1251.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：论文讨论胸前视野可能丢失盒盖、指尖动作误差及缺少接触力信息。复杂精细任务仍明显失败，几何运动示范不能完整描述接触受力&lt;br&gt;我的理解 / 不足：我的判断：人的手能稳定夹住物体，不代表重定向后的机械手也能夹稳。只匹配指尖位置，可能漏掉摩擦、力和手指接触顺序&lt;br&gt;未来展望：可加触觉、接触检查与自动纠正示范筛选；分别评估“映射能执行”和“策略学会了”两个环节，定位失败来自数据还是学习&lt;br&gt;对我们项目的启发：可作为 DH116 数据采集方案参考。先测量手指结构、行程和指尖坐标，重做关节映射；论文 LEAP 手动作不能直接发给 DH116" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1511" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1830.5" as="sourcePoint"/><mxPoint x="3322" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
