            <mxGeometry x="2160" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_92_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-93" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_92_1_field_1" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / Robotics: Science and Systems (RSS) 2026&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_1_branch_1" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_1_field_2" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：RSS XXII 正式论文页与DOI 10.15607/RSS.2026.XXII.003核实题名、九位作者及2026年会议。arXiv v1为2026-02-10，本地17页含补充；RSS的PDF入口本轮返回空白占位页，因此正文采用有效arXiv全文，不能宣称已读最终会议版" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_1_branch_2" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="864.0" as="sourcePoint"/><mxPoint x="562" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_1_field_3" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexImit 将单目人类视频离线转换为机器人示范，目标是降低双臂灵巧操作的数据成本。它重建手—物体轨迹，用任务分解与双臂调度组织动作，再以力闭合抓取和关键帧规划合成物理可行轨迹，最后增强数据训练DP3。输入可来自互联网或生成视频，输出是仿真机器人数据及可迁移策略；这是离线数据生成，绝非用摄像头实时遥控手。四种真机元任务做Sim2Real，但长时任务常需人工校正，复杂手内操作仍不支持（§III–V）" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_1_branch_3" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1443.5" as="sourcePoint"/><mxPoint x="562" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_1_field_4" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：把单目人类视频转为双臂灵巧手示范&lt;br&gt;DexImit 从视频重建物体和操作阶段，再规划抓取与双臂动作并生成训练轨迹" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_1_branch_4" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1911.0" as="sourcePoint"/><mxPoint x="562" y="1911.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_2_field_1" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作与定位：直接以人手作为另一种本体预训练，保留大量数据却有视觉和动作差异；重建物体轨迹再用规划/RL执行，动作能落到机器人上，但逐帧误差会使接触学习失稳。DexImit 把人手用作尺度、抓取位置/方向及参与手指数的提示，重新求机器人可执行抓取，避免逐关节模仿" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_2_branch_1" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_2_field_2" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_2_branch_2" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_2_field_3" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;RigVid原为单臂夹爪，本文扩展至双臂灵巧手；DexMan用RL跟踪视频轨迹，本文因其代码尚未公开而自行重实现。此对照测的是作者改造/重实现版本，不能当作原作者官方模型在同基准的直接排名（§II、IV-B）" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_2_branch_3" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1384.0" as="sourcePoint"/><mxPoint x="1252" y="1384.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_2_field_4" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;单目视频：只有一个普通相机视角，缺少直接的三维深度&lt;br&gt;直接以人手作为另一种本体预训练，保留大量数据却有视觉和动作差异&lt;br&gt;RigVid 原本把人类视频用于单臂夹爪任务；DexImit 加入双臂调度、多指接触和操作阶段。它仍需重建物体位置和抓取关系，不能仅看单帧人手姿态就输出机器人关节角" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_2_branch_4" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1816.5" as="sourcePoint"/><mxPoint x="1252" y="1816.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_3_field_1" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 单目到近似公制重建&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qwen3-VL识别物体并结构化标注；Grounded SAM2分出物体、左右手与桌面；SpatialTracker v2估深度，WiLoR重建手网格，以人手尺寸先验推全局尺度。先粗对齐网格和可见点云，再渲染去遮挡部分重新对齐，减小完整网格与部分点云中心差异（图2，PDF pp.3–4）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_3_branch_1" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_3_field_2" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 单目到近似公制重建&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 单目到近似公制重建：SAM3D生成物体网格并对齐尺度，FoundationPose跟踪变体估连续6D物体位姿；桌面法向作z轴，初帧双手关系确定水平方向，物体包围盒中心移入机器人工作区，形成统一世界系。所谓“无需深度”指无额外深度传感输入，仍使用学习估深；近似尺度不是测量真值&lt;br&gt;&lt;br&gt;2. 双臂调度及物理动作合成：任务记录参与本体、物体、有序子动作和当前进度；子动作包含pregrasp、grasp、motion、release及起始帧，调度队列协调左右臂的并发与先后。长视频可人工修正标注，不能将“自动”理解为所有长任务无人介入（算法1，pp.4–5）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_3_branch_2" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_3_field_3" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 双臂调度及物理动作合成&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 双臂调度及物理动作合成：BODex式优化在物体凸包初始化抓取，按VLM估计参与手指数选择接触点，优化力矩平衡/接触距离/手物及双手穿透。候选按与人手平移和旋转的相似度排序，再模拟滚动检查实际与目标物体点云偏差，低于阈值才保留（补充A.1，pp.13–14）&lt;br&gt;&lt;br&gt;2. 双臂调度及物理动作合成：抓稳后把手和物体当刚体，关键帧物体变换决定末端目标，再做运动规划；这是对物体交互的重合成，不是精确复刻人手每一关节。关节界、机器人碰撞模型和稳定阈值完整配置需查代码；论文没有实时反馈Hz、控制延迟及抖动滤波的报告，离线生成不应填这些指标" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_3_branch_3" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1548.5" as="sourcePoint"/><mxPoint x="1942" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_3_field_4" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 增强、过滤与训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 增强、过滤与训练：随机化物体姿态、0.8–1.2倍尺度、相机姿态和点云噪声。缩放时保留原抓取/运动，只调整手指以适应尺寸，避免各尺度重新规划产生冲突监督。VLM读取原视频描述及合成回放做自动过滤；这属于语义筛选，不能替代全部物理和执行质量验证（§III-D、补充A.3）&lt;br&gt;&lt;br&gt;3. 增强、过滤与训练：每个源视频生成100条示范用于DP3训练与模拟评价。官方代码输出包括物体/手姿、网格、世界变换、合成回放及data_record.npz；仓库存在不意味着模型权重与训练部署全链都已实测复现" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_3_branch_4" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2180.5" as="sourcePoint"/><mxPoint x="1942" y="2180.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_4_field_1" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据可用性与模拟成绩&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据可用性与模拟成绩：100个短时任务上，ST2＋FoundationPose++物体轨迹重建成功率82%，ST2＋彩色点云配准76%，TA＋RANSAC38%；这是重建可用性，不是82%真机操作成功（表I，p.6）&lt;br&gt;&lt;br&gt;数据可用性与模拟成绩：100示范训练的模拟六任务成功率依次为Put Cup100%、Grapefruit100%、Fruits100%、Pour100%、Pot78%、Stack Cups52%。最后两项说明长时协调仍困难；表中“-”表示失败，不能自行改写成某次固定试验计数（表II，p.7）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_4_branch_1" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_4_field_2" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机为两台UR5e＋XHands＋Azure Kinect，测试放苹果、左右独立放土豆/辣椒、双手放锅、协作倒水。图6（p.8）比较完整组、去尺度增强、重新生成抓取、去物体点云噪声，完整组更高；图未标各柱准确数字及完整试次分母，本卡不从柱高编精确成功率。做饮料、切苹果等长任务图4主要证明生成轨迹，不扩大成所有这些任务都已零样本真机成功" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_4_branch_2" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_4_field_3" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;可追溯的内部不一致&lt;/b&gt;&lt;br&gt;&lt;br&gt;正文§III-D写随机删除30%点并扰动，补充式19却写保留85%、再加噪声点，复现配置需以作者澄清或锁定代码版本核验。图7将100个失败案例分类，6D姿态31%、任务分解37%较大，但印出标签6/31/37/4/4合计仅82%，且抓取合成橙条宽度与4%标签不符，不能擅自改成22%" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_4_branch_3" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_4_field_4" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;可追溯的内部不一致&lt;/b&gt;&lt;br&gt;&lt;br&gt;补充表III（p.16）5/10/20秒视频总耗时173.1/201.1/256.6秒，是离线处理时间，未清晰给对应GPU与并行设定，不能当作实时处理或普适预算" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_4_branch_4" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1841.0" as="sourcePoint"/><mxPoint x="2632" y="1841.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_5_field_1" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限、复用边界与后续&lt;/b&gt;&lt;br&gt;&lt;br&gt;局限、复用边界与后续：作者明确局限：多模块误差传播；不支持软体/关节物体、移动操作、复杂手内操作；长视频有时需修分解或重建（§V、补充C，p.17）&lt;br&gt;&lt;br&gt;局限、复用边界与后续：我的分析：数据成功通过VLM与模拟不等于每条接触都正确；保持抓取刚体关系也限制指间换指。闭环DP3不自动提供完整失败恢复机制。更可行的研究切入是分阶段质量日志、尺度误差与监督一致性，而非单看合成数量&lt;br&gt;&lt;br&gt;局限、复用边界与后续：最低验证：用D435i录固定桌面单物体短视频，先离线比较估深与实测深度、检查分割/位姿/轨迹，不控制机器人。DH116右手六主动轴、十一总DOF需重建耦合及三指接触模型；当前整手/多轴运动仍锁定且根因未知，不能套XHand抓取或左手资产到真机" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_5_branch_1" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="512.0" as="sourcePoint"/><mxPoint x="3322" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_92_5_field_2" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限、复用边界与后续&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整复现需双UR5e/XHands与深度相机，或先做仿真。官方仓库建议人工标注单3090/4090 24GB，Qwen路径建议双4090或A100 80GB，这是仓库建议非本文实测预算；完整训练耗时仍待核验。双臂可借鉴调度与稳定性筛选，但应先通过右手离线几何与关节约束检查" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_92_5_branch_2" edge="1" parent="paper_92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
