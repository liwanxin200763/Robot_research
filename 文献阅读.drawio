        <mxCell id="paper_109_1_field_rail" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="108" as="sourcePoint"/><mxPoint x="550" y="2311" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_2_drop" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
