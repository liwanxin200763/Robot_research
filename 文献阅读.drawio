            <mxGeometry x="2160" y="5086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_55_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-56" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="5086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_55_1_field_1" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：7（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_1_branch_1" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_1_field_2" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_1_branch_2" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_1_field_3" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;大规模 VLA 预训练需要跨任务、跨场景的动作数据，而真实机器人轨迹涉及设备、遥操作、现场执行和安全成本。人类第一视角视频更容易大规模获得，记录了操作者所见的物体、双手与任务过程；但视频像素并不自带可执行的机器人控制标签。ACE-Ego-0 研究如何把这两类数据放进同一动作学习体系，而不是把人类视频简单当成机器人示范。（论文第 1 节、图 1）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_1_branch_3" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_1_field_4" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：将人类第一视角视频转为具有空间意义的伪动作，与机器人和仿真轨迹联合预训练 VLA，使较少的下游机器人数据也能产生可执行策略。核心障碍是空间坐标、身体形态、时间尺度、标签质量四种不匹配。（第 1、3 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：仅靠机器人数据难以覆盖大量长尾物体与交互；直接从视频学习潜在动作，难以保证动作落到真实末端执行器坐标；简单混合人类与机器人数据会把不同身体、帧率和人类动作估计噪声误当成统一监督。论文强调人类视频贡献的是交互先验与场景多样性，不能替代机器人精确动作标签。（第 1–3 节）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_1_branch_4" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1767.5" as="sourcePoint"/><mxPoint x="562" y="1767.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_1_field_5" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：训练视觉—语言—动作模型（VLA，即根据图像和任务指令生成机器人动作）的跨本体数据利用&lt;br&gt;人类第一视角视频是操作者所见画面；本篇重点是给视频补上可用于训练的伪动作，而不是直接遥控灵巧手&lt;br&gt;核心研究问题：真实机器人示范成本高，人类操作视频却很多，但视频像素没有可执行的关节或末端指令&lt;br&gt;作者问能否从手和相机运动估计近似动作，把它与机器人轨迹联合训练，使少量目标机器人数据更有用&lt;br&gt;之前方法的问题：只用机器人轨迹难覆盖长尾物体和场景；直接把人类视频当示范又混淆坐标系、身体形态与帧率&lt;br&gt;手指和相机位姿的自动估计还有噪声，若同等信任所有伪标签，模型可能学到错误控制" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="2115" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_1_branch_5" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2434.5" as="sourcePoint"/><mxPoint x="562" y="2434.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_2_field_1" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_2_branch_1" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_2_field_2" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_2_branch_2" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_2_field_3" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;相对仅以机器人数据训练的 VLA，本工作把人类第一视角视频中的交互过程转换成几何伪动作，重点放在数据、动作表示、跨执行体预训练。它使用已有的 RoboCasa/RoboTwin 来评估，并非新发明 Benchmark；没有提出失败恢复控制器。跨平台对比需留意基线的相同任务、数据预算和测试条件。（第 1、4 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_2_branch_3" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_2_field_4" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：机器人示范预训练给出真实可执行动作，却需设备、操作者和安全采集成本&lt;br&gt;ACE 保留机器人数据作为主监督，再借人类视频补充交互对象与场景覆盖，不声称视频可以完全替代机器人数据&lt;br&gt;相关方向 2：从人类视频学习潜在动作能利用大量无标签影像，但隐变量通常不能直接映射到某台机械臂的末端坐标&lt;br&gt;本篇恢复手腕与相机轨迹，构造相机坐标下的伪末端位姿，尝试让监督具有明确空间含义&lt;br&gt;代表工作：RoboCasa 和 RoboTwin 2.0 提供仿真任务与双臂评测；DIAL、π0.5、GR00T 等在实验中作为对照&lt;br&gt;这些基准与模型不是 ACE 新发明的数据生成模块，比较成绩也只适用于各自相同的任务设置&lt;br&gt;与已有方法的区别：作者同时处理空间坐标、机器人形态、动作时间跨度和伪标签可信度四种不匹配&lt;br&gt;通过相机系动作、URDF 关节图条件、按真实时长分块以及可靠性加权，把异构语料接到同一训练目标" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_2_branch_4" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1820.0" as="sourcePoint"/><mxPoint x="1252" y="1820.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_1" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;形成“第一视角视频 → 手与相机轨迹恢复 → 相机坐标系伪末端动作 → 与机器人/仿真动作对齐 → 混合预训练 → 机器人任务微调”的链路。模型用形态条件和时间对齐处理异构执行体，用可靠性加权目标降低伪标签噪声。（图 2；第 3 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_1" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_2" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;人类数据处理经过数据筛选、视频片段选择、手部与相机几何恢复、动作参数化、质量过滤。几何阶段结合 SAM3 手部跟踪、HaMeR 的局部 MANO 手形与 VIPE 相机位姿，并做全局轨迹优化。空间不匹配通过相机坐标系末端动作处理：机器人末端与人类手腕轨迹都映射到相机参考系。形态不匹配通过机器人 URDF 的关节图嵌入注入动作解码器；人类数据使用学习到的代理形态 token，避免伪造人类 URDF。时间不匹配通过按约 2 秒真实时间换算的动态动作分块处理。标签质量不匹配通过机器人数据主监督的 flow matching 损失、对人类伪动作使用 Huber 辅助损失及分通道/样本可靠性权重处理。（第 3.1–3.4 节；附录 A）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_2" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_3" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;模型接收视觉观测、语言任务指令和执行体条件；附录 B 指出训练视觉输入包含头部与腕部 RGB 图像，分辨率为 256×256。机器人形态信息来自 URDF 关节图；人类片段使用代理 token。真机 ARX 评估使用头部 RGB-D 相机；论文没有充分给出其是否使用腕部相机、普通夹爪的具体型号或控制频率，不能把训练视觉配置直接当成 ARX 硬件配置。（第 3、4 节；附录 B、C）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_3" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1461.0" as="sourcePoint"/><mxPoint x="1942" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_4" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;以手腕位置近似人类末端位置，以手掌平面近似方向，以拇指—掌心距离构造归一化夹爪开合代理（约 0.04–0.10 m），双手分别编码；这不等于人手有真实机器人夹爪标签。附录 A.1 的磁盘动作每手 8 维：位置 3、欧拉角 3、夹爪 1、活动标记 1；训练时每手 11 维：位置 3、连续 6D 旋转、夹爪 1、活动标记 1，双手共 22 维。模型预测相机坐标系动作分块，训练使用相机系增量末端动作；发布的检查点也区分绝对/增量动作配置，不能混称。分块长度按数据频率换算到目标时长 T*=2 s，即 H_d=round(f_d T*)；RoboCasa 20 Hz 微调对应 40 步。ARX 执行时将相机系增量末端指令经外参逆变换到机器人执行坐标。除视觉和形态条件外，不额外推断论文未明示的本体状态维度。（第 3 节；附录 A、B）" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_4" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2058.0" as="sourcePoint"/><mxPoint x="1942" y="2058.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_5" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;从原始约 5,929 h 人类视频筛出约 1,479 h 有效片段；先选择有清晰手—物交互的片段，再估计手与相机轨迹，把手腕/掌面/拇指距离转成伪末端位姿与夹爪代理。静止、突跳、轨迹不完整及双手不合格片段经质量过滤。人类伪动作仍有旋转和手指开合误差，因此训练目标给予位置较高权重，对旋转和夹爪降低权重（论文给出的通道权重为 1 对 0.001），并用 Huber 辅助项控制噪声影响。相机系动作对齐解决空间不匹配，形态 token 解决执行体差异，按物理时长分块解决帧率差异，可靠性权重解决标签质量差异。（第 3.1–3.4 节；图 3；附录 A）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="2423" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_5" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2707.5" as="sourcePoint"/><mxPoint x="1942" y="2707.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_6" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;主干为 Qwen3-VL-4B-Instruct 加约 6 亿参数的 flow-matching DiT 动作专家（附录 B：36 层、隐藏维 1,024、16 个注意力头），推理采用 4 步求解。先在混合数据上预训练，再在目标机器人任务上 SFT；主损失是机器人动作的 masked flow-matching MSE，人类伪动作采用权重 λ=0.1 的 Huber 辅助损失，样本/训练阶段的可靠性也参与加权。附录 B 报告预训练 200K 步、使用 128 张 A800，微调使用 16 张 A800；这是论文训练配置，不代表一般复现所需的最低资源。（第 3.4、4 节；附录 B）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="3020" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_6" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3287.0" as="sourcePoint"/><mxPoint x="1942" y="3287.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_3_field_7" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：人类视频没有机器人动作标签，因此先筛选清晰的手物交互片段，估计双手和相机轨迹&lt;br&gt;再用手腕位姿、掌面方向和拇指距离形成近似末端动作；质量过滤剔除跳变或缺失片段，降低伪动作误导训练的风险&lt;br&gt;贡献 2：人和机器人本体不同，直接共享关节向量不可行；作者把动作改写为相机系末端增量，并用机器人 URDF 的关节图编码硬件形态&lt;br&gt;还按约两秒真实时间确定动作段长度，使不同采样频率的数据描述相近时长的操作&lt;br&gt;贡献 3：人手旋转与夹爪开合估计并不精确，作者让机器人动作承担主要 flow-matching 训练损失&lt;br&gt;人类伪动作只以较低权重的 Huber 辅助损失参与，旋转和开合通道进一步降权，从而利用视频多样性而不等同信任噪声标签&lt;br&gt;方法流程：第一视角视频 → 手部与相机运动恢复 → 相机系双手伪动作和质量过滤；机器人/仿真轨迹也转换到可对齐表示&lt;br&gt;视觉、指令与形态条件进入 VLA，混合预训练后在目标机器人上微调，生成动作段并换回机器人执行坐标" vertex="1">
          <mxGeometry height="919" width="628" x="1942" y="3582" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_3_branch_7" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="4041.5" as="sourcePoint"/><mxPoint x="1942" y="4041.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_4_field_1" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;人类第一视角视频是人佩戴/携带相机在做任务时的视觉记录，不含可直接执行的机器人动作。表 1 列出六类来源：Ego4D 216.6 h、EgoExo4D 10.3 h、EPIC-KITCHENS-100 32.3 h、HOI4D 7.2 h、EgoDex 776.8 h、Xperience-10M 435.7 h，共 1,478.9 h、1,494,195 段。机器人与仿真轨迹来自 AgiBot Alpha/Beta 1,937.8 h、Galaxea R1Lite 488.1 h、AgiBot DigitalWorld 225.3 h、RoboCasa Tabletop 83.6 h（24 任务、每任务 1,000 段）及自采 Galbot 1,800+ h，合计 4,534.8+ h；总量 6,013.7+ h。人类数据提供低成本任务/视角覆盖，机器人数据提供可执行动作监督，仿真数据补充可控任务与评估分布；这些小时数是混合语料规模，不能解释成同一机器人采集的真实轨迹。（表 1；图 3）" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_4_branch_1" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="477.0" as="sourcePoint"/><mxPoint x="2632" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_4_field_2" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa GR1 TableTop：人形 GR1 平台的 24 个桌面任务，其中 18 个取放、6 个关节物体任务；一个多任务模型，每任务 50 次 rollout，以成功率平均比较。论文表 3 的基线包括 DIAL、JoyAI、ABot、FLARE、GR00T-N1.6 和 Qwen3PI。RoboTwin 2.0：双臂桌面操作 50 任务；训练包含每任务 50 条 clean、500 条 randomized 轨迹，总计 2,500＋25,000 条；Easy/Clean 和 Hard/Randomized 各按每任务 100 次评测，指标为任务成功率。表 4 比较 Hy-VLA、JoyAI、Motus、LingBot、ABot 和 π0.5 等。RoboCasa/RoboTwin 是 Benchmark，其他模型是 baseline，ACE-Ego-0 是受测方法；不同表中的任务与平台不能混为同一设置。（第 4 节；表 3、4）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_4_branch_2" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1161.5" as="sourcePoint"/><mxPoint x="2632" y="1161.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_4_field_3" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文在 ARX 双臂平台上测试 6 个任务：Pick Tea、Scoop Coffee、Category Sorting、Sweep Cubes、Stack Bowls、Pack Shoes。使用头部 RGB-D 观测；相机系增量末端动作经外参换算到执行坐标。每任务 30 次试验，以无需人工介入完成任务为成功，任务成功判据见附录 C.2；与 π0.5 和 GR00T-N1.7 比较。论文没有明确到足以核实的夹爪型号、腕部相机配置和控制频率，因此本卡不补猜；这组试验也没有证明跨所有真机、全部夹爪形态或 NERO 平台的泛化。（第 4.3 节；图 5a；附录 C.2）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1509" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_4_branch_3" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1776.0" as="sourcePoint"/><mxPoint x="2632" y="1776.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_4_field_4" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa 平均成功率 72.8%，高于 DIAL 70.2%、JoyAI 63.2% 和 ABot 58.3% 等表 3 基线。RoboTwin 2.0 为 Easy 91.12% / Hard 90.62%，对照 Hy-VLA 90.9% / 90.1%（表 4）。ARX 真机 6 任务平均 78.3%，对照 π0.5 71.7%、GR00T-N1.7 35.6%（图 5a）；Scoop Coffee 为 86.7%。论文据此报告在这些特定设置下达到当时最优或有竞争力的结果，并不意味着所有 VLA 或真机任务上最强。真机 Category Sorting 个别数值在图 5a 与正文叙述之间不完全一致，故不在本卡引用该单项数字。（表 3、4；图 5a）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="2071" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_4_branch_4" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2355.5" as="sourcePoint"/><mxPoint x="2632" y="2355.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_4_field_5" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa 完整模型为 72.8%；移除动态分块为 71.7%（−1.1 个百分点）、移除 URDF 形态条件为 70.9%（−1.9）、移除人类辅助损失为 69.2%（−3.6），支持四类不匹配需要分别处理（图 5b）。数据消融中机器人＋人类预训练为 72.8%，仅机器人预训练 68.3%，从 Qwen 直接训练、无具身预训练 65.4%（表 5）。Sweep Cubes 小样本补充实验用 34 条机器人示范约 45.8K 帧微调，原本 1/10 成功；加入 419 条人类片段约 117.5K 帧后为 4/10，人类轨迹覆盖面积 0.296 m²、机器人 0.062 m²。后者只有 10 次试验，适合看机制线索，不宜当成稳定泛化估计。（第 4.4 节；表 5；图 5）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="2668" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_4_branch_5" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2970.0" as="sourcePoint"/><mxPoint x="2632" y="2970.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_4_field_6" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;ARX 的 Pack Shoes 是相对困难的长时任务，完整成功率明显低于部分短任务；论文将其关联到长程执行误差累积。手部几何恢复本身还会出现旋转与手指开合伪标签不准，因而专门设计质量过滤与降权训练。论文没有给出可逐次统计的“抓取失败/定位失败/动作漂移”归因表，本卡不编造失败频数。图 5a、附录 C 的任务成功判据可用于后续逐任务复核。（第 3、4、7 节；图 5a；附录 C）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="3300" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_4_branch_6" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3532.0" as="sourcePoint"/><mxPoint x="2632" y="3532.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_5_field_1" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：评测集中于桌面操作，未覆盖移动/全身运动、可形变物体或灵巧手；数据缺少力/力矩监督；人类手部重建的旋转与手指细节仍有噪声，扩充视频规模不等于可靠动作规模。文献库分析：128 张 A800 的预训练代价与多阶段视觉几何处理可能限制小团队完整复现；ARX 只有 6 类真机任务、每类 30 次，尚不足以推断跨夹爪和跨场景稳定性；这两点是依据实验范围和训练配置作出的推论，并非作者声明已验证 NERO。（第 7 节；附录 B、C）" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_5_branch_1" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_5_field_2" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对 NERO 双臂＋普通夹爪＋遥操作的潜在启发：先确认 teleop 轨迹能否可靠转换为相机系末端位姿、开合量和活动标记；把双臂形态差异作为显式条件，而非把所有关节强行映射成同一向量；以可验证的真机数据作主监督，审慎加入人类第一视角伪动作；用 RoboTwin 2.0 的双臂任务与论文 ARX 的每任务多次试验、明确成功判据作为实验设计参考。应先做 NERO 外参、末端定义、夹爪语义和安全执行验证。以上是研究设想，论文并未测试 NERO，也未证明其对普通夹爪的直接迁移效果。（第 3、4、7 节）" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_5_branch_2" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="969.0" as="sourcePoint"/><mxPoint x="3322" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_55_5_field_3" parent="paper_55" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：评测主要是桌面操作，未覆盖移动全身控制、可变形物体或灵巧手；人类手部重建仍有旋转与指尖细节噪声&lt;br&gt;数据缺少力和力矩监督，因此视觉伪动作并不保证真实接触力正确&lt;br&gt;我的理解 / 不足：预训练要处理数千小时混合语料和昂贵计算，复现整套系统的门槛很高&lt;br&gt;ARX 只测六种任务，未说明足以迁移到 DH116 的手指关节映射与接触控制；这是根据实验范围作出的推断&lt;br&gt;未来展望：先测伪动作的几何误差和动作可执行率，再研究手指接触与力反馈如何补充仅靠视觉恢复的标签&lt;br&gt;对每个新硬件应分别验证相机外参、末端定义和开合语义，不能把跨本体结果理解为零校准部署&lt;br&gt;对我们项目的启发：可借鉴相机系动作和形态条件，把现有机械臂/双臂遥操作数据与人类视频做小规模联合实验&lt;br&gt;DH116 需另建关节与触觉动作表示、校准相机并设安全限幅；论文未证明该方法可直接控制 DH116" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_55_5_branch_3" edge="1" parent="paper_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1671.0" as="sourcePoint"/><mxPoint x="3322" y="1671.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
