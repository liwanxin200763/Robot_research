        <UserObject id="paper_122_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_122_bottomnav_1" label="返回分类" link="data:page/id,literature-page-04" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_122_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-121" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_122_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-125" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_122_1_field_1" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与首次公开&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：Self-Evolving Embodied Agents via Skill-Harness Evolution，框架简称SHAPER。作者见元数据，Peidong Wang、Zhiming Ma、Ying Chang共同贡献，Xufang Luo和Shi Feng通讯，机构为Northeastern University与Microsoft Research。官方https://arxiv.org/abs/2608.11350确认首发2026年8月11日，v2更新2026年9月10日；本地26页PDF为v2且标Preprint。年份 / Venue：2026预印本，不推断会议录用。引用量未实时核验。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_1_branch_1" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="389.5" as="sourcePoint"/><mxPoint x="562" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_1_field_2" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、具体问题与目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;具身系统的行为不仅由权重决定，还取决于技能说明、历史上下文和执行包装。SFT/RL需要权重、数据和训练，代码型机器人智能体又依赖可编程控制API，很多固定接口环境不具备。本文要解决的是冻结规划器和执行器时，能否用少量目标环境rollout改善跨任务行为。目标是共同演化可复用文字技能及上下文构造代码，以改进任务分解、进度识别、证据记忆和失败恢复，而不是训练新的低层控制能力。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_1_branch_2" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="916.5" as="sourcePoint"/><mxPoint x="562" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_2_field_1" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;SFT/RL把演示或奖励通过反向传播变成参数更新；SkillOpt/EmbodiSkill等可编辑外部技能说明，AutoHarness等可改执行包装。SHAPER把两个外部对象明确化：skill是持续附在规划提示中的程序性指导，可能包含动作配方、恢复规则、拆解策略；harness是build_context一类函数，选择并格式化历史观察/动作/结果。这里skill不是神经动作专家，harness代码也不是直接操控机器人关节的程序。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_2_branch_1" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_2_field_2" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;文本梯度与候选搜索&lt;/b&gt;&lt;br&gt;&lt;br&gt;textual gradient是将轨迹错误归纳成自然语言诊断，指出重复无进展、目标漂移、上下文有害、解析错误等，不是可微数学梯度。beam search保留若干经验证较好的候选，并分支提出改动。优化器与规划器可以调用同一冻结基础模型但提示角色不同。改写工件会长期改变后续任务上下文，因此不同于每个新episode多采几条轨迹再投票。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_2_branch_2" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_3_field_1" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;冻结系统的信息流&lt;/b&gt;&lt;br&gt;&lt;br&gt;给定目标g、当前观察ot、技能s与历史τ，规划器Mθ读取g、ot、s、h(τ&amp;lt;t)，输出推理及接口层命令yt；执行器Aϕ把命令转为动作at。全程冻结θ和ϕ，只优化(s,h)。VLABench里yt是给冻结π0执行器的文字子目标和步数预算；ESI-Bench直接经固定环境动作接口执行。动作接口、解析器和执行器始终固定，不能把harness演化描述为获得新机器人API或更新VLA权重。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_3_branch_1" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_3_field_2" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;rollout→局部诊断→episode摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练候选先在小批目标环境任务交互。round-level judger比较每次规划输出、动作、执行前后观察，分析子目标错误、无进展或执行器不匹配。随后episode summarizer结合命令记录、执行长度、错误、终端上下文、局部批评和任务最终结果，压缩为非视觉摘要，再与批次统计组成文本反馈。这样优化器不用直接吞整批长多模态轨迹。五级进度分数只用于诊断，最终成功仍由环境结果判定。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_3_branch_2" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_3_field_3" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;两阶段演化与验证门&lt;/b&gt;&lt;br&gt;&lt;br&gt;先固定初始h0优化文字技能s，再固定选中技能s*优化h，未采用任意轮次同时乱改两者。优化器接收当前工件、文本反馈和优化历史，给完整替换技能或完整build_context代码。代码需符合函数契约、禁止import/文件I/O/动态执行、满足超时及载荷约束，非法候选反馈错误并丢弃。合法候选在固定验证集跑任务，以任务成绩保留旧候选与新提案中top-K，最终选择历轮最佳。性能改进需要真实目标环境rollout及验证，并非只读失败日志就确认有效。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_3_branch_3" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1373.5" as="sourcePoint"/><mxPoint x="1942" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_3_field_4" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;演化出的具体恢复机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLABench技能演化把规划器变成执行器命令适配器：保留完整实体名、每轮只发一个原语、使用执行器熟悉的短canonical命令；先识别前次成功/失败/部分成功/停滞，再在重复无进展时换命令形式。harness强调最新真实图片、压缩旧历史、显式标记重复和长执行无进展。取书案例种子反复发retrieval，演化后发现仍与书架重叠，换pick-up并确认离架。这里恢复是更合理地调动既有演员，底层抓取权重没有变。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_3_branch_4" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1900.5" as="sourcePoint"/><mxPoint x="1942" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_3_field_5" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;演化出的视觉记忆与设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;ESI种子仅保留最近5帧并串联完整文字，早期镜像证据会被新空白/重复图挤掉。演化harness从全历史选最多3张信息丰富且多样的关键帧，配确定性focus crop，压缩动作路径，并给当前图选水平带和重叠切片。裁剪由RGB对比度、边缘密度、清晰度生成，不用目标框、深度、姿态或答案元数据。上下文用VIEW/TARGETS/EVIDENCE/READY/GAP组织，并检测逆向动作循环；这不同于通过特权3D状态增加证据。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_3_branch_5" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2427.5" as="sourcePoint"/><mxPoint x="1942" y="2427.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_4_field_1" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;模型、数据预算与任务接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;所有系统变体冻结Qwen3.6-27B作高层模型。VLABench执行器为官方π0检查点、经十类原语预训练，通过OpenPI每次5动作块执行；每episode最多10规划轮、400低层步。用15训练episode和24验证episode演化，与800留出episode分离。ESI用10训练、10验证和231评价题，最多30交互步。两基准均4轮beam search、宽3、分支2、每次4rollout反馈。优化并非零交互成本，且15条episode不等同15个低层动作样本。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_4_branch_1" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_4_field_2" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;VLABench结果与分布偏移&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者自定义C1–C4，而非官方现成切分：语义理解/常识任务形式×已见/未见目标类别，每格5任务族×40例共200。Direct VLA23.25%，同15例数据SFT24.00%，Seed Agent28.25%，仅技能33.50%、仅harness30.50%、完整34.50%。完整比seed增加6.25个百分点、比同数据SFT10.50个百分点。C1/C2/C3/C4为42.5/26.0/50.0/19.5%，跨新类别与新形式仍较难，不能由均值改善称泛化已解决。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_4_branch_2" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="899.0" as="sourcePoint"/><mxPoint x="2632" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_4_field_3" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基线与组件关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA+MG-Select21.38%、VLA+VOTE22.00%；Seed加两类测试时扩采为24.38/23.50%，低于普通seed28.25%，说明该配置下多采样未复制工件改进。技能本身贡献最大，技能后加harness仅平均再提高1个百分点；仅harness收益也不与技能收益线性相加。论文明确这些是完整系统配置差异，不是独立组件的无偏因果估计。取书受控案例固定主干及raw harness，seed400步回报0.5，演化技能297步回报1.0，同为3规划轮，是机制案例而非总体平均。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_4_branch_3" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1408.5" as="sourcePoint"/><mxPoint x="2632" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_4_field_4" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;ESI结果与外部参考边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;231题按官方类别比例采样，seed micro/macro32.5/31.2%，技能41.1/38.6%，完整49.8/42.9%。镜面反射从技能20.0到完整60.0%，空间关系37.3到54.9%；但计数类33.3降27.8%，动作序列40降20%，后者仅5题，不能忽略样本量。GPT-5被动单视角全评估集macro40.3%只是外部出版参考，与主动交互231子集并非配对，不能宣称同条件击败GPT-5。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_4_branch_4" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1918.0" as="sourcePoint"/><mxPoint x="2632" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_4_field_5" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成本与真实验证范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;一次演化API等价成本VLABench约2.25美元、ESI约2.83美元，来自日志token按论文指定价格和7.2汇率换算，包含rollout、评判、摘要和工件优化，排除最终评价、仿真器和GPU基础设施。选中工件跨留出任务复用，无需每个episode重新搜索；这是一次性搜索成本，不是每任务全部推理费。论文未报告真机实验、跨本体结果、完整墙钟时间/能耗或独立重复演化的置信区间；train-free意为无权重更新，并非零计算。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_4_branch_5" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2427.5" as="sourcePoint"/><mxPoint x="2632" y="2427.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_5_field_1" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者边界与实际局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;结论明确把跨本体和真实机器人验证列为未来工作。整体VLABench成功仍34.5%，ESI准确率49.8%，依赖冻结执行器已有能力；外部文本工件无法凭空让不会抓取的VLA学会新物理接触。固定小验证集用来多轮选择，也存在候选对验证任务习惯过拟合的风险。代码安全验证保证可运行与信息边界，不能代替行为可靠性或机器人安全验证。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_5_branch_1" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_122_5_field_2" parent="paper_122" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：同一冻结模型既行动又诊断，可能把自身错误解释固化为规则；少量轨迹发现的恢复规则未必跨对象稳定。研究启发：在固定总rollout和token预算下比较技能、上下文与纯采样，重复不同训练/验证划分，记录每次工件改动和留出收益；单独测记忆保留、无进展检测和合法动作比例。迁移真机前应限制上下文载荷、核对RGB裁剪不会漏关键接触信息，并增加真实失败复核。以上建议未在本机执行。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_122_5_branch_2" edge="1" parent="paper_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
