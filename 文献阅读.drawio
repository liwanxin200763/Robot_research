        <mxCell id="paper_48_1_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：双手灵巧操作迁移与残差学习。人的手部轨迹只是动作目标，还要机械手与物体产生正确接触，才能从“形状像”变成“操作成功”" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_1_branch_3" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
