        <mxCell id="paper_10_title_branch" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="100" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_rise" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_header_rail" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="3625" y="14" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_1_drop" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
