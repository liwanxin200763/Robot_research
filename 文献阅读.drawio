          </mxCell>
        </UserObject><mxCell id="paper_61_1_field_1" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / ICML 2024，PMLR 235，61229–61245&lt;br&gt;引用量：456（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_1_branch_1" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_1_field_2" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作&lt;br&gt;&lt;br&gt;研究背景：2D VLA 往往由当前图像直接生成动作，对物体的三维位置、场景关系以及执行后的目标状态表达不足。作者希望把三维场景理解与“未来会变成什么样”的生成式世界模型用于动作规划。（论文第 1–2 节）" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_1_branch_2" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="815.0" as="sourcePoint"/><mxPoint x="562" y="815.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_1_field_3" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：构建同一具身模型，使其能够在语言和三维场景条件下完成推理、物体定位、目标 RGB-D／点云生成与机器人动作预测，并检验生成目标是否帮助操作。（第 1、4–5 节，图 1–2）&lt;br&gt;&lt;br&gt;之前方法存在的问题：2D 图像特征不直接表明物体深度和空间关系；仅把视觉输入映射到动作忽略未来场景动态。已有 3D-LLM 的训练数据主要是物体和室内场景，与具身动作不完全对齐；通用图像扩散模型可能擅自改变视角、纹理或物体形状，不适合作为直接的机器人目标预测器。（第 1–2、4.2–4.3 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_1_branch_3" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1412.0" as="sourcePoint"/><mxPoint x="562" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_1_field_4" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：三维 VLA 与生成式世界模型；RGB-D 是彩色图加深度图，点云是物体表面的三维坐标集合&lt;br&gt;模型不仅预测动作，还生成任务完成后的目标图像或点云，作为可检查的中间状态&lt;br&gt;核心研究问题：二维图像难明确表达深度、物体间位置及动作后的目标状态，直接映射动作容易遗漏几何约束&lt;br&gt;作者问能否用三维场景和语言先想象目标，再辅助机器人选择动作&lt;br&gt;之前方法的问题：常见 VLA 用二维感知直接输出控制；已有 3D-LLM 偏向静态场景问答，缺少机器人动作与未来状态&lt;br&gt;通用图像扩散器还会改动视角、物体纹理或形状，不能直接当可靠的操作目标" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_1_branch_4" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2079.0" as="sourcePoint"/><mxPoint x="562" y="2079.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_2_field_1" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_2_branch_1" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_2_field_2" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_2_branch_2" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_2_field_3" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;方法借鉴 3D-LLM 的三维场景特征接入思路，但重训具身对齐部分；从 Open X-Embodiment 取得训练数据。相较 OpenVLA 一类直接动作预测，本文显式生成目标状态；与 DIAL 的潜在意图表征可比较“可视化未来目标”和“潜在空间未来意图”对执行的影响，但跨论文效果不能直接横比。（第 2–5 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_2_branch_3" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_2_field_4" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：3D-LLM 将多视角视觉特征接入语言模型，能回答场景问题，但预训练场景与操作轨迹不完全对齐&lt;br&gt;3D-VLA 借其三维特征与 Q-Former 接口思路，却从 BLIP2-FlanT5XL 初始化而非直接加载 3D-LLM 权重&lt;br&gt;相关方向 2：OpenVLA 一类方法从观察直接预测动作；SuSIE 等可生成目标图像，却未必同时提供三维定位和动作 token&lt;br&gt;本篇用物体框、点云目标和离散动作串联空间理解、未来想象与规划，但这些输出误差会逐级传播&lt;br&gt;代表工作：Open X-Embodiment 等提供原始操作视频，RLBench 与 CALVIN 用于动作评测&lt;br&gt;Instruct-P2P、Point-E 是目标生成对照或预训练来源；LanCon-Learn、MCIL 是不同规划基准的对照，不能合成总榜&lt;br&gt;与已有方法的区别：从已有机器人与人手—物体视频补估深度、光流和三维框，得到约 200 万训练数据对&lt;br&gt;语言模型用专门 token 指明物体、位置、图像／点云目标及动作，再由扩散器生成目标状态供动作预测使用" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_2_branch_4" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1837.5" as="sourcePoint"/><mxPoint x="1252" y="1837.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_1" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;从已有机器人和人手—物体数据构建三维具身指令数据；给语言模型加入场景、物体、位置、图像／点云目标和动作 Token；训练面向机器人状态变化的 RGB-D 与点云扩散生成器，并把生成器与语言模型对齐。生成的目标状态可以再作为动作预测条件。（第 3–4 节，图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_1" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_2" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;沿用 3D-LLM 的多视角特征汇聚和 Q-Former 接口，但没有直接加载 3D-LLM 预训练权重，改以 BLIP2-FlanT5XL 初始化。场景特征经 Q-Former 接入语言模型；&amp;lt;obj&amp;gt;、&amp;lt;loc0-255&amp;gt; 和 &amp;lt;scene&amp;gt; 标记对象、三维位置与场景。语言模型在 &amp;lt;image&amp;gt;／&amp;lt;pcd&amp;gt; 标记之间给出目标生成条件，经 Transformer projector 对齐到分别以 Stable Diffusion v1.4、Point-E 为起点的 RGB-D／点云扩散解码器；行动分支生成离散动作 Token。（第 4.1–4.3 节，图 2）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_2" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="829.0" as="sourcePoint"/><mxPoint x="1942" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_3" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;依据任务可输入单视角或多视角 RGB、估计或原有的深度／点云、自然语言任务指令以及可选的目标状态。三维场景构建使用相机内参与位姿；论文没有把关节速度或受力描述为统一、必需的模型输入，不能据其“7-DoF 动作”推断这些观测存在。（第 3.1–3.3、4.1 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_3" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_4" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;模型可输出具身问答、任务描述、物体的三维边界框、目标 RGB-D／点云，以及机器人动作。动作由 &amp;lt;aloc0-255&amp;gt;、&amp;lt;arot0-255&amp;gt;、&amp;lt;gripper0/1&amp;gt; 和 &amp;lt;ACT_SEP&amp;gt; 等离散 Token 表示 7-DoF 绝对位置、旋转与夹爪状态。论文未明确报告统一的控制频率、动作块长度和完整坐标系约定，不能补猜。（第 4.2.2 节，图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_4" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1760.5" as="sourcePoint"/><mxPoint x="1942" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_5" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;对多数缺少深度的视频用 ZoeDepth 估深、RAFT 算光流；固定相机片段借未动背景对齐跨帧深度尺度，再按相机参数提升为点云。spaCy 从指令提取名词短语，Grounded-SAM 给 2D mask，再投影得到 3D bounding box；用高光流且高置信的区域定位被操作对象。模板组织验证、描述、定位、生成和动作任务，GPT-3.5 基于对象位置与少量人工示例改写提示以增加表达多样性。对复杂机器人场景做筛选，HOI 数据增加目标生成时的场景多样性。（第 3.2–3.3 节；附录 B，表 7–8）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_5" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2270.0" as="sourcePoint"/><mxPoint x="1942" y="2270.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_6" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;先训练三维场景／语言模型和交互 Token，再分别在具身数据上训练 RGB-D→RGB-D 与点云→点云扩散模型，最后通过 projector 把语言模型输出对齐到生成器。动作预测可用真实或生成的目标状态作提示；LLM 用交叉熵，生成器用去噪损失，扩散模型以 LoRA 适配。正式 PMLR PDF 的附录 A 给出 6×32 V100 的前期训练、6×64 V100 的对齐训练、学习率前 1k 步预热至 10⁻⁵ 后余弦下降，以及 AdamW；这些是不同阶段的配置，不应与旧 arXiv v1 附录混写。（第 4.2–4.3 节；附录 A）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_6" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2832.0" as="sourcePoint"/><mxPoint x="1942" y="2832.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_3_field_7" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：多数操作视频没有三维标注，作者用 ZoeDepth 估深、RAFT 求光流，再按相机参数恢复点云&lt;br&gt;从指令取物体名，Grounded-SAM 给掩码并投到三维框；把未来帧当目标，形成约 200 万三维—语言—动作数据对&lt;br&gt;贡献 2：语言模型不能直接表达几何与控制，作者增添对象、位置、场景及动作 token&lt;br&gt;六个位置 token 编码三维包围框，离散位置、旋转和夹爪 token 编码七自由度动作，使场景指代与动作能进入同一序列&lt;br&gt;贡献 3：仅语言输出不能画出目标，作者分别用 Stable Diffusion 1.4 与 Point-E 适配 RGB-D 和点云生成&lt;br&gt;Transformer projector 对齐语言模型特征与扩散器条件；预测目标可回送给动作分支，在 RLBench 中比较有无目标&lt;br&gt;方法流程：单／多视角图像加语言 → 估深并汇聚三维特征 → Q-Former 接入 BLIP2-FlanT5XL → 输出物体位置与目标生成提示&lt;br&gt;RGB-D／点云扩散器生成目标 → 目标回送模型预测离散动作 token → 仿真机械臂开环执行" vertex="1">
          <mxGeometry height="919" width="628" x="1942" y="3127" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_3_branch_7" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3586.5" as="sourcePoint"/><mxPoint x="1942" y="3586.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_4_field_1" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;从 Open X-Embodiment 选取 12 个机器人数据集，另用有深度信息的 Dobb-E、RH20T，RLBench／CALVIN 仿真与 Epic-Kitchens／HOI4D 人手—物体数据。作者报告约 200 万个三维—语言—动作训练数据对；附录表 8 按原始 episode 另统计机器人约 305k、HOI 约 11k、合计约 316k。数据对数与 episode 数单位不同，不能相加。论文不是另采集并评测真实机器人示范。（第 3.1 节；附录 B，表 8）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_4_branch_1" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_4_field_2" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;评测分三组：①在 RoboVQA、Open X 和 RT-1 来源的 held-in 数据上做 Embodied QA、Task Caption、What-if QA、Dense Caption 与三维定位；问答对比 3D-LLM、BLIP2、OpenFlamingo、LLaVA，定位对比 Kosmos-2、CoVLM。②从 Open X 测试集抽 4,000 episodes 测目标 RGB／点云生成，对比 Instruct-P2P、SuSIE、NeXT-GPT、Point-E，指标包括 PSNR、CLIP Similarity、SSIM、FID、P-FID、Chamfer-L1。③RLBench 比较 LanCon-Learn，CALVIN 五步任务序列比较 MCIL；这些基线属于不同实验，不是同一张总榜。（第 5.1–5.3 节，表 1–6）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_4_branch_2" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_4_field_3" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文测试的动作规划任务是 RLBench 与 CALVIN 仿真。数据来源包含真实机器人记录，图像生成也展示互联网／日常场景样例，但这不构成真机闭环控制评测；本文没有可报告的实体机械臂试次、控制频率或真机成功率。Impact Statement 谈到未来在人工监督下部署，不是已经完成的实验。（第 5–7 节）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_4_branch_3" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1513.5" as="sourcePoint"/><mxPoint x="2632" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_4_field_4" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 1 的 What-if QA，3D-VLA 的 BLEU-1 为 53.09、BLEU-4 为 29.38，相同 held-in 对照 BLIP2-FlanT5XL 为 28.23／0.06；表 2 定位 IoU／Acc@25／Acc@50 为 29.33／42.26／27.09，CoVLM 为 19.81／25.39／16.61。表 3 的目标图像 PSNR／CLIP／SSIM／FID 为 17.21／0.920／0.636／0.177，同数据训练的 Instruct-P2P* 为 16.67／0.941／0.628／0.178；CLIP 相似度并未领先。表 4 的点云 P-FID／Chamfer-L1 为 4.796／0.139，Point-E* 为 5.241／0.159。正式版表 5 的 RLBench 四项 Put Knife／Take Umbrella／Pick up Cup／未见 Pick up Cup 为 68／80／40／28；表 6 的 CALVIN 连续完成 1–5 项比例为 44.7／16.3／8.1／1.6／0，平均完成长度 0.71。这些实验设置和指标不可合成一个“总体成功率”。（第 5 节，表 1–6）" vertex="1">
          <mxGeometry height="709" width="628" x="2632" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_4_branch_4" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2110.5" as="sourcePoint"/><mxPoint x="2632" y="2110.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_4_field_5" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;正式版表 5 去掉生成目标后，RLBench 四任务从 68／80／40／28 降到 58／68／34／24，但“放刀”任务仍有物体碰撞失败，不能把全部误差归因于目标生成。表 3 去掉预测 BBox 后，PSNR／CLIP／SSIM 从 17.21／0.920／0.636 变为 17.02／0.919／0.632，但 FID 0.177→0.173 反而略好；表 4 点云 P-FID／Chamfer-L1 从 4.796／0.139 变为 4.914／0.143。消融只支持这些具体对照，不代表每个模块均已单独验证。（第 5.2–5.3 节，表 3–5）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2493" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_4_branch_5" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2742.5" as="sourcePoint"/><mxPoint x="2632" y="2742.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_4_field_6" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者在第 6 节报告小立方体精细抓取失败，受三维特征与离散动作精度限制；Diffusion 目标有时改变物体纹理／形状、令物体消失、生成错误任务的未来状态或几乎不发生变化。表 6 还显示 CALVIN 五任务连续完成率为 0；这是量化的长序列弱项，不应混同作者单列的定性失败案例。（第 6 节，表 6）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="3020" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_4_branch_6" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3234.5" as="sourcePoint"/><mxPoint x="2632" y="3234.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_5_field_1" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：小物体精细控制不足；目标图像可能 hallucinate；真实环境跨场景深度尺度不统一、点云噪声影响生成；BC-Z、Roboturk 等数据质量差异会降低任务表现。作者提出改进深度解码与点云过滤。（第 6 节）本库分析：缺少真机与双臂闭环证据，CALVIN 长程成绩仍有限；生成目标进入动作规划前的可信度检查尚未被单独验证。后两点是由实验范围与表 6 推出的研究判断，非作者声称已解决。（第 5–6 节）" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_5_branch_1" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_5_field_2" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对 VLA grounding 和双臂普通夹爪研究，三维目标状态可作为动作前的可检查中间表示。潜在研究启发：检测生成目标与当前物体、语言指令、可达几何是否一致，再决定是否执行或重新生成；同时比较连续与离散动作表示对精细操作的影响。本文没有验证这类一致性检查或双臂恢复流程，必须另做实验。（第 5–6 节）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_5_branch_2" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="881.5" as="sourcePoint"/><mxPoint x="3322" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_61_5_field_3" parent="paper_61" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：小方块精细抓取失败，三维特征和离散动作精度不足；生成目标可能改纹理、让物体消失或生成错误任务&lt;br&gt;真实场景深度尺度不统一、点云噪声和原始数据质量差异也会削弱模型表现&lt;br&gt;我的理解 / 不足：动作评测只在仿真，且 CALVIN 五任务连做为 0%，还不能把目标生成能力视作可靠长程控制&lt;br&gt;目标图像有幻觉时，直接回送动作分支可能误导规划；论文未单独验证目标可信度筛选&lt;br&gt;未来展望：给目标生成增加物体身份、几何可达性和深度一致性检查，再比较有无筛选时的动作成功率&lt;br&gt;对小物体探索连续动作与更细三维特征；这属于由失败案例提出的后续实验，不是已证实改进&lt;br&gt;对我们项目的启发：可把双臂任务的目标点云当作动作前检查对象，先验证生成目标是否保持物体与接触面一致&lt;br&gt;接入 DH116 要另建多指动作及触觉条件，并做真实闭环测试；原文没有证明灵巧手或失败恢复能力" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_61_5_branch_3" edge="1" parent="paper_61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1531.0" as="sourcePoint"/><mxPoint x="3322" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
