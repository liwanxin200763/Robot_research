            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_111_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-112" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_111_1_field_1" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / CVPR&lt;br&gt;引用量：22（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量&lt;br&gt;数据链条位置：第一视角人类视频与多手型控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_1_branch_1" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_1_field_2" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;把人类数据变成多种手都能用的接口：不同灵巧手的指长、主动轴和耦合结构不同，为每种手重新采集整套任务代价很高。UniDex 同时构建人类视频转换的数据集、统一动作表示和三维视觉语言动作策略，研究能否先在多种手的共同表示中学知识，再用少量目标手示范适配" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_1_branch_2" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_2_field_1" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;统一关节编号为什么不够：相同的第一个关节在不同手上可能负责不同运动，复制数组位置会混淆功能。FAAS 按动作功能对应控制通道，例如拇指对捏和手指屈曲，再处理耦合关节；视觉方面去掉人手点云并加入机器人手几何，减少人类示范与机器人观察的外观差异" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_2_branch_1" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_2_field_2" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_2_branch_2" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_2_field_3" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;功能对齐与运动学相等是两回事：不同手都能捏合，但同样的功能位置未必对应同样关节角。FAAS 提供共享通道，让模型学习哪类运动有相似作用；具体驱动仍要按各手关节定义转换。对于从动关节，原文通过主关节关系更新，不能把全部总自由度当独立电机控制" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_2_branch_3" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1377.0" as="sourcePoint"/><mxPoint x="1252" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_3_field_1" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;人类视频到机器人数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;从第一视角 RGB-D 和手部轨迹出发，在人工参与的重定向中对齐指尖、检查接触，对关键帧作必要修正；按目标手运动学得到可执行关节轨迹。把人手区域从场景点云中去掉，再渲染重定向后的机器人手并按深度关系融合，防止穿插和错误遮挡" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_3_branch_1" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_3_field_2" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;统一表示与策略输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;FAAS 使用 82 维通道，其中两腕各 9 维、每手手指各 32 个槽位，按手的功能与结构填写，并非目标手都有 82 个执行电机。Uni3D 编码单视角彩色点云，模型结合语言和本体状态，经 flow matching 生成未来动作块；腕动作相对当前动作块第一帧，手指动作仍需映回具体驱动与耦合约束" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_3_branch_2" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_3_field_3" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：视觉转换也需处理深度顺序。把机器人网格简单画到人手位置上，会让本应被物体挡住的手指出现在物体前面；本文先融合三维点云再重新投影，以减少这种错误。人参与修正关键接触帧说明数据管线仍有质量成本，并非五万条视频经过一次全自动重定向就都正确&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_3_branch_3" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1356.0" as="sourcePoint"/><mxPoint x="1942" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_4_field_1" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据及真机平台&lt;/b&gt;&lt;br&gt;&lt;br&gt;本地 PDF 表 1 记录约 52k 轨迹、八种手型，覆盖 6–24 自由度；真机 Franka 配 Inspire、Wuji 与 Oymotion，RealSense L515 观察，每任务采 50 条微调示范。五类任务含冲咖啡、扫物、喷水、用剪刀和鼠标；比较 DP、DP3、π0 和无预训练版本" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_4_branch_1" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_4_field_2" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;指标与结果的边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要指标是各阶段成功率的平均，称平均任务进展，不是完整回合成功率。图 10 将 Inspire 策略零样本迁到 Wuji／Oymotion，十次测试的平均进展为 40%／60%，π0 为 0%／10%。文中最难剪袋任务的 84.6% 是相对最佳对照的平均进展增幅，不能改写为成功率或增加 84.6 个百分点" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_4_branch_2" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_4_field_3" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：五项工具任务要求不同指法，剪刀尤其依赖手指进入孔位，平均任务进展能说明策略完成了多少阶段，但不能代表剪切过程全部成功。零样本跨手结果使用相同技能而换手型，也不等于对新任务零样本；微调、物体变化、空间变化和换手型应分成四条结果线阅读&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_4_branch_3" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_5_field_1" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与 DH116 的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与 DH116 的关系：原文 Oymotion 具有六主动、十一总自由度，这让耦合映射尤其值得读，但不能仅凭自由度数量认定与本机模型完全相同。应核对关节顺序、符号、模仿关节比例与指尖可达范围，再验证 FAAS 的功能对应是否成立。数据生成还需人工校正，统一空间也没有消除触觉缺失和跨手接触动力学差异&lt;br&gt;&lt;br&gt;把关键设计与实验读透：若探索 DH116 统一动作空间，可以先制作主动轴、关节功能、耦合比例和指尖方向的映射表，离线回放同一捏合与工具握持。再分别评估手形误差、碰撞、接触保留和真实任务结果，防止只因关节曲线连续就认为跨手迁移成功。相机换成 D435i 后也需重新验证点云和遮挡条件" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_5_branch_1" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="477.0" as="sourcePoint"/><mxPoint x="3322" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_111_5_field_2" parent="paper_111" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_111_5_branch_2" edge="1" parent="paper_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1039.0" as="sourcePoint"/><mxPoint x="3322" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
