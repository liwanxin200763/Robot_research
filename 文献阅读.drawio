        <mxCell id="paper_57_code" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;Dream4ACT - A Shared Visual Action &lt;br&gt;Interface for Multi-Embodiment Vide&lt;br&gt;o-Action Modeling.md&lt;br&gt;&lt;br&gt;开源信息：—（官方论文与项目入口未提供可核实的公开仓库）" vertex="1">
          <mxGeometry height="569" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
