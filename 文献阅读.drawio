        </mxCell>
        <mxCell id="paper_54_1_field_4" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：只提高仿真画面逼真度成本高；端到端策略容易依赖背景。长任务若不检查前一步完成，后续动作会在错误现场继续执行" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="830" as="geometry"/>
