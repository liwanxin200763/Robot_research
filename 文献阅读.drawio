        <mxCell id="paper_78_fulltitle" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;OPEN TEACH: A Versatile Teleoperation System for Robotic Manipulation" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_78_authors" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Aadhithya Iyer、Zhuoran Peng、Yinlong Dai、Irmak Guzey、Siddhant Haldar、Soumith Chintala、Lerrel Pinto" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
