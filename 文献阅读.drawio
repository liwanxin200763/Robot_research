          </mxCell>
        </UserObject><mxCell id="paper_32_1_field_1" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICLR&lt;br&gt;引用量：6（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_1_branch_1" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_1_field_2" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_1_branch_2" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_1_field_3" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 VLA / Robot Foundation Models / Bimanual Manipulation / Robot Manipulation 方向，主要讨论双臂 VLA 训练通常需要昂贵的双臂示范和大模型参数。&lt;br&gt;核心思路是TwinVLA 组合两个预训练单臂 VLA，并加入协调机制形成双臂策略。&lt;br&gt;与当前项目的联系：项目联系：直接关系到项目未来 VLA 迁移" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_1_branch_3" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_1_field_4" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：双臂 VLA 训练通常需要昂贵的双臂示范和大模型参数&lt;br&gt;&lt;br&gt;为什么重要：提供低成本复用单臂模型的双臂 VLA 路线&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：从单臂 VLA（看图读指令并生成动作）&lt;br&gt;迁移到双臂协作，减少双臂示范&lt;br&gt;核心问题：双臂训练数据少时，&lt;br&gt;怎样利用已有单臂模型学会左右手配合？&lt;br&gt;直接从零训练双臂模型要大量数据；&lt;br&gt;两个独立单臂策略又缺协调" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_1_branch_4" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1802.5" as="sourcePoint"/><mxPoint x="562" y="1802.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_2_field_1" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;之前方法的问题：从单臂 VLA 迁移时，两只手臂仍要协调，而不能简单独立执行&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：单臂 VLA，&lt;br&gt;根据图像和指令输出一只手动作&lt;br&gt;相关方向 2：双臂联合策略，&lt;br&gt;同一模型同时预测左右动作&lt;br&gt;代表对照：RDT-1B 等双臂模型；&lt;br&gt;比较数据量与成功率&lt;br&gt;区别：复制单臂模型的两侧理解模块，&lt;br&gt;再让左右信息交互" vertex="1">
          <mxGeometry height="779" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_2_branch_1" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="529.5" as="sourcePoint"/><mxPoint x="1252" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_2_field_2" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_2_branch_2" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1137.0" as="sourcePoint"/><mxPoint x="1252" y="1137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_3_field_1" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：TwinVLA 组合两个预训练单臂 VLA，并加入协调机制形成双臂策略&lt;br&gt;&lt;br&gt;两条单臂流具体怎样交流：TwinVLA 复制预训练单臂视觉语言动作骨干，并保留臂特定的投影等组件；在联合注意力中，把两条流的查询、键、值拼起来共同计算，再拆回左右流。共享视觉语言内容和臂特定信息使用注意力掩码安排访问，既交换另一只手的信息，也保留动作自回归约束，因此不是两个完全独立的策略各做各的&lt;br&gt;&lt;br&gt;阅读要点与补充说明：贡献 1：左右臂各有视觉语言塔，&lt;br&gt;共享视觉编码器以节省计算&lt;br&gt;贡献 2：联合注意力让两塔交换信息，&lt;br&gt;同时保留每侧的具体任务线索&lt;br&gt;贡献 3：共享动作头联合输出左右动作段；&lt;br&gt;并非两个自主聊天 agent&lt;br&gt;流程：双臂观察/指令→左右塔理解&lt;br&gt;→信息互通→联合预测两臂动作" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_3_branch_1" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="564.5" as="sourcePoint"/><mxPoint x="1942" y="564.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_3_field_2" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1017" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_3_branch_2" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1231.5" as="sourcePoint"/><mxPoint x="1942" y="1231.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_4_field_1" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：仿真与真机双臂操作任务&lt;br&gt;&lt;br&gt;主要结果：论文报告在若干双臂任务上优于同规模 RDT-1B，而无需双臂预训练；具体任务结果见原文&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：仿真与真机双臂操作任务&lt;br&gt;&lt;br&gt;实验与结果：主要结果：论文报告在若干双臂任务上优于同规模 RDT-1B，而无需双臂预训练；具体任务结果见原文" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_4_branch_1" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_4_field_2" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;鲁棒性结果不能只报正向案例&lt;/b&gt;&lt;br&gt;&lt;br&gt;ICLR 2026 本地全文表 1 的折毛巾低光／干扰物条件，TwinVLA 为 45%／25%，π0 为 40%／60%，RDT-1B 为 15%／15%；低光下的优势没有延续到干扰物设置。RoboTwin Hard 中它也低于 RDT-1B，说明利用单臂预训练能提高数据效率，但不同环境变化仍可能破坏协调" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_4_branch_2" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_4_field_3" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：RoboTwin 2.0 的 50 个任务；&lt;br&gt;另有 5 类真实双臂任务&lt;br&gt;对照：RDT-1B 等；&lt;br&gt;以整任务成功率衡量&lt;br&gt;结果：真机平均成功率比 RDT-1B 高 26 个百分点；&lt;br&gt;说明单臂预训练有帮助&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;补充：RoboTwin 困难设置比 RDT-1B 低 3.72 点；&lt;br&gt;不是所有场景都领先" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_4_branch_3" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1461.0" as="sourcePoint"/><mxPoint x="2632" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_4_field_4" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_4_branch_4" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1953.0" as="sourcePoint"/><mxPoint x="2632" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_5_field_1" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：直接关系到项目未来 VLA 迁移&lt;br&gt;&lt;br&gt;主要局限：即使无双臂预训练，协调模块与目标任务示范需求仍需具体核实&lt;br&gt;&lt;br&gt;局限与启发：主要局限：即使无双臂预训练，协调模块与目标任务示范需求仍需具体核实&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者结果显示复杂双臂仿真仍有差距，&lt;br&gt;单臂先验不够解决所有配合问题&lt;br&gt;我的理解：主要是机械臂/夹爪动作；&lt;br&gt;灵巧手多指接触尚未验证&lt;br&gt;未来可加入共享场景记忆与明确任务阶段，&lt;br&gt;避免两臂互相干扰&lt;br&gt;项目启发：未来双臂 DH116 可复用单臂 VLA；&lt;br&gt;再训练左右协调层" vertex="1">
          <mxGeometry height="849" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_5_branch_1" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="564.5" as="sourcePoint"/><mxPoint x="3322" y="564.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_32_5_field_2" parent="paper_32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1017" as="geometry"/>
        </mxCell>
        <mxCell id="paper_32_5_branch_2" edge="1" parent="paper_32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1214.0" as="sourcePoint"/><mxPoint x="3322" y="1214.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
