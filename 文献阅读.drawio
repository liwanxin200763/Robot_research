          <mxGeometry x="100" y="3260" width="2000" height="90" as="geometry"/>
        </mxCell>
        <UserObject id="category_02_paper_57" label="#57 Dream4ACT&lt;br&gt;要解决：把不同机器人的关节动作渲染成统一多视角视频，与真实画面一起预测，再恢复为可执行动作&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-57" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
