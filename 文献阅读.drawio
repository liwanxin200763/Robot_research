        <mxCell id="paper_130_5_field_rail" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="108" as="sourcePoint"/><mxPoint x="3310" y="1518" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_fulltitle" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;VidMan: Exploiting Implicit Dynamics from Video Diffusion Model for Effective Robot Manipulation" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_130_authors" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Youpeng Wen、Junfan Lin（共同一作）、Yi Zhu、Jianhua Han、Hang Xu、Shen Zhao、Xiaodan Liang；中山大学深圳校区、鹏城实验室、华为诺亚方舟实验室" vertex="1">
