        </UserObject><UserObject id="paper_94_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-95" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><mxCell id="paper_94_1_field_1" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2023 / IEEE International Conference on Robotics and Automation (ICRA) 2023&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_1_branch_1" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_1_field_2" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：作者出版页核实ICRA 2023，arXiv v1发布于2022-03-24，本地PDF 9页。前两位作者同等贡献；正式标题及作者与首页一致，不能把预印本年份误作会议年份" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_1_branch_2" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="846.5" as="sourcePoint"/><mxPoint x="562" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_1_field_3" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;DIME 希望用单 RGB 相机和少量示范学会手内操作，省去多相机标定或昂贵手套。MediaPipe二维指尖通过校准映到Allegro的预定三维平面，用逆运动学与PD完成实时示教；真机用状态或视觉近邻学习，MuJoCo另用示范辅助强化学习。真实旋转90°的状态近邻10/10，视觉近邻7/10，但视觉转旋钮0/10，说明降低采集门槛不等于消除观察与学习瓶颈（§III–V）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_1_branch_3" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1391.0" as="sourcePoint"/><mxPoint x="562" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_1_field_4" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：单相机灵巧手示教与模仿学习&lt;br&gt;DIME 用二维指尖目标降低采集难度，再检验这些示范能否支持手内操作策略" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_1_branch_4" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1841.0" as="sourcePoint"/><mxPoint x="562" y="1841.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_2_field_1" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_2_branch_1" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_2_field_2" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_2_branch_2" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="745.0" as="sourcePoint"/><mxPoint x="1252" y="745.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_2_field_3" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与方法含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexPilot 通过多深度相机融合得到更完整三维手几何，DIME主动简化成二维指尖到固定高度目标，减少部署复杂性，也限制了自由三维手指动作。近邻模仿INN在已有状态中找相似例子并取动作；VINN先用BYOL把图像压成2048维特征再找近邻，省去实机物体状态估计但增加视觉表征负担" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_2_branch_3" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1184.5" as="sourcePoint"/><mxPoint x="1252" y="1184.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_2_field_4" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与方法含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作与方法含义：DAPG将示范梯度加入策略梯度，帮助探索并修正示范噪声，仍需奖励函数及大量仿真交互。本文模拟示范在模拟手上采、真机示范在真机采；两套实验并行，不是把模拟策略迁到实机的Sim2Real证明（§II、III-A/E/F）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：模仿学习：先看人给出的成功动作，再训练机器人在类似观察下重复执行&lt;br&gt;DexPilot 通过多深度相机融合得到更完整三维手几何，DIME主动简化成二维指尖到固定高度目标，减少部署复杂性，也限制了自由三维手指动作" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="1427" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_2_branch_4" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1729.0" as="sourcePoint"/><mxPoint x="1252" y="1729.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_3_field_1" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 有意简化的动作重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 有意简化的动作重定向：单RGB相机输出21个2.5D手关键点，但作者不把模型相对深度视为绝对深度，而忽略深度、固定机器人指尖离掌高度。用户将手指移至极限参考位置，记录人—机边界并线性插值；拇指使用四边形区域映射平面xy位移（图2、§III-B，PDF p.3）&lt;br&gt;&lt;br&gt;1. 有意简化的动作重定向：正文描述非拇指沿指定平面映射，并提及用小指作细控制；复现时完整手指对应须查代码，不凭自然手指顺序猜映射。这里的低维目标不是准确恢复人手全部三维接触，也不提供臂/腕运动接口" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_3_branch_1" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_3_field_2" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 机器人控制与人类反馈&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 机器人控制与人类反馈：机器人模型与逆运动学将四个期望指尖位置转关节目标，重力补偿加PD生成力矩；目标30 Hz传输，控制300 Hz，ROS连接感知与手。操作者观看实时机器人反馈纠正遮挡造成的错误。支持ROS远端接入不等于完成互联网延迟或跨地域稳定性评估（§III-C/D）&lt;br&gt;&lt;br&gt;2. 机器人控制与人类反馈：原文没有可确认的端到端延迟、关节限位实现、碰撞检查、丢跟踪暂停及滤波细节，不能补成一套已有安全机制。操作者主动调整姿态避开遮挡，是实验成功的重要条件" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_3_branch_2" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1021.5" as="sourcePoint"/><mxPoint x="1942" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_3_field_3" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 示例到底保存什么&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 Hz保存机器人RGB、AR标记估得的物体状态、目标指尖位置。系统状态含16个Allegro关节角及物体位置/姿态；状态INN用四指三维位置＋物体三维位置，共15维，动作是相对腕的四指三维目标，共12维。转旋钮实机不把旋钮旋转角放观察，模拟则有，比较时须注意信息不相同（§III-D、IV-A）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_3_branch_3" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1548.5" as="sourcePoint"/><mxPoint x="1942" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_3_field_4" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 示例到底保存什么&lt;/b&gt;&lt;br&gt;&lt;br&gt;剔除变化小于2 cm的转移以去除操作者暂停段，这会改变动作采样分布，不能把5 Hz直接理解成清洗后固定步长。真机近邻输出相似示例的动作，模拟用10条/任务示范训练DAPG或BCRL；真机30条/任务，另训练BYOL供视觉检索" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_3_branch_4" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1981.0" as="sourcePoint"/><mxPoint x="1942" y="1981.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_4_field_1" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务和收集成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务和收集成本：翻转要求一分钟内让物体落到掌心2 cm范围；转旋钮一分钟120°；掌内旋转一分钟90°。三项真机示范平均30、120、150 s，四位未经训练志愿者首次旋转平均210 s，比专家多40%。这些耗时属于该实验，不是所有新用户的学习曲线（§IV-A/B，pp.5–6）&lt;br&gt;&lt;br&gt;真机成功率 / 表中逐项记录：方法：INN 状态；Flipping：80%；Turning：60%；Rotation90°：100%；Rotation180°：80%" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_4_branch_1" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_4_field_2" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机成功率 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机成功率 / 表中逐项记录：方法：VINN 图像；Flipping：90%；Turning：0%；Rotation90°：70%；Rotation180°：50%&lt;br&gt;&lt;br&gt;真机成功率 / 表中逐项记录：方法：状态/图像BC；Flipping：0%；Turning：0%；Rotation90°：0%；Rotation180°：0%&lt;br&gt;&lt;br&gt;真机成功率：每方法每任务十次，表I（PDF p.7）中Turning对应正文Spinning旋钮任务。状态近邻并非逐项最好，翻转视觉90%高于状态80%；不能只引用INN平均较好便说所有任务超越VINN。少量试次也不支持精确估计长期可靠性" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_4_branch_2" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1039.0" as="sourcePoint"/><mxPoint x="2632" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_4_field_3" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;模拟与视觉失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;模拟与视觉失败：图4（p.5）曲线为十随机种子的均值与标准误差，BCRL及DAPG能解决三任务；纯PPO可用剧烈动作转旋钮，却难旋转掌中方块。作者定性指出示范辅助策略更平滑，不把曲线手读成未印出的终值百分比&lt;br&gt;&lt;br&gt;模拟与视觉失败：视觉转旋钮失败被归因于杂乱场景与小数据下BYOL特征不足；这一解释未通过固定表征的独立因果消融证明。旋转180°性能下降与方块逐渐离开掌内可操作区域有关（§IV-D/E）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_4_branch_3" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1671.0" as="sourcePoint"/><mxPoint x="2632" y="1671.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_4_field_4" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;可复现性与比较口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;模拟环境另设计物体与目标距离相关的稠密奖励，DAPG因此除了人类示范还获得额外任务监督。图像与状态策略输入信息、特征训练及物体追踪需求不同，表I可以说明这些系统配置的表现，不能仅据一行数字认定某种算法本身普遍更优（§III-E、IV-C/D）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1966" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_4_branch_4" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2163.0" as="sourcePoint"/><mxPoint x="2632" y="2163.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_5_field_1" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与项目应用&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与项目应用：作者局限：单RGB深度歧义迫使指定z平面，建议增加深度；真机转旋钮成功率不高，建议更省样本的RL微调（§V）。真机没有进行在线RL，不能把模拟改进直接当作真机收益&lt;br&gt;&lt;br&gt;不足与项目应用：我的分析：固定高度让数据便宜但缩小动作覆盖，2 cm清洗也可能丢精细接触动作。近邻策略每次重新看状态仍不代表主动识别失效、重新抓取或恢复掉落&lt;br&gt;&lt;br&gt;不足与项目应用：最低验证：D435i可先记录RGB与深度用于离线对比二维/三维目标误差；DH116右手六主动轴、十一总DOF不同于Allegro，应先在仿真验证拇指—食指—中指可达区域及耦合，不套用十六关节映射。当前整手/多轴运动仍锁定且根因未知，仅做离线与日志" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_5_branch_1" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="512.0" as="sourcePoint"/><mxPoint x="3322" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_94_5_field_2" parent="paper_94" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与项目应用&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与项目应用：完整复现需Allegro、AR物体跟踪、MuJoCo/MJRL与训练计算机；正文说模拟训练约两天但GPU型号和端到端预算未明确报告。接机械臂或双臂需另增腕位姿、协同与碰撞模块，可先复用清晰的观察/状态/动作记录接口&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者局限：单RGB深度歧义迫使指定z平面，建议增加深度；真机转旋钮成功率不高，建议更省样本的RL微调；真机没有进行在线RL，不能把模拟改进直接当作真机收益" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_94_5_branch_2" edge="1" parent="paper_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1196.5" as="sourcePoint"/><mxPoint x="3322" y="1196.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
