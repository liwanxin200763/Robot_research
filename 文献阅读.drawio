        </mxCell>
        <mxCell id="paper_35_pdf" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;08_数据与遥操作\&lt;br&gt;DexCap.pdf" vertex="1">
          <mxGeometry height="220" width="285" y="586" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_code" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="开源记录：&lt;br&gt;论文声明公开代码与硬件说明；本地卡无仓库链接，当前发布状态待核验" vertex="1">
          <mxGeometry height="230" width="285" y="818" as="geometry"/>
        </mxCell>
