        </UserObject><UserObject id="paper_93_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-92" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_93_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-94" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_93_1_field_1" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / arXiv preprint（本轮未核实正式录用）&lt;br&gt;引用量：待 Google Scholar 人工核验，不填写估计数量（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_1_branch_1" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_1_field_2" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_1_branch_2" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="752.0" as="sourcePoint"/><mxPoint x="562" y="752.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_1_field_3" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexMan 研究能否把单目第三人称人类视频变成双臂多指机器人可完成的操作。裸视频缺深度、相机标定、对象资产和真实动作；直接模仿估计手轨迹容易受遮挡、几何及本体差异影响。作者从视频重建物体、估计手—物运动、搭建稳定仿真场景，再用接触先验引导残差强化学习。输出是仿真中 Unitree G1 配两只 Shadow Hands 的状态策略，不是已部署真机的 RGB 端到端策略（§3、§5）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_1_branch_3" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1202.0" as="sourcePoint"/><mxPoint x="562" y="1202.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_1_field_4" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：本篇与数据路线的关系是把真实/生成的人类视频转成物理交互技能与潜在机器人数据。其价值在处理无标注视频噪声，但“无需深度传感器”不等于系统不使用深度估计，也不等于完全无人参与：实验对象由人工指定。全文明确只在仿真评估，不能归为已验证 Sim2Real&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：从真实与生成视频学习双臂灵巧操作&lt;br&gt;DexMan 恢复视频中的物体与手部运动，再用仿真训练跟踪动作的策略" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_1_branch_4" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1764.0" as="sourcePoint"/><mxPoint x="562" y="1764.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_2_field_1" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_2_branch_1" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_2_field_2" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_2_branch_2" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="762.5" as="sourcePoint"/><mxPoint x="1252" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_2_field_3" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;FoundationPose 使用 RGBD 与对象模型估姿，SpatialTracker 提供时序三维点运动；DexMan 以学习深度和单图重建补齐输入，并利用点轨迹稳定对象位姿。HaMeR 恢复 MANO 手形，Trellis 重建物体，VGGT 估计相对深度，均是管线依赖而非本篇从零提出（§2–3）" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_2_branch_3" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1202.0" as="sourcePoint"/><mxPoint x="1252" y="1202.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_2_field_4" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;ManipTrans、DexTrack 等从高质量参考动作学残差策略，但常依赖动捕真值或浮动手。严格追踪噪声手形会导向不可行姿态，放松模仿又可能让策略避免接触以少受惩罚。仅奖励“触最近表面”可产生无功能接触；奖励固定世界坐标则不随物体运动。DexMan 绑定人手关键点与对象表面对应点，提供随对象移动的接触目标（§2、§3.4）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1427" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_2_branch_4" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1641.5" as="sourcePoint"/><mxPoint x="1252" y="1641.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_2_field_5" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成视频：由视频生成模型合成的片段，仍需验证物理接触是否可行&lt;br&gt;FoundationPose 使用 RGBD 与对象模型估姿，SpatialTracker 提供时序三维点运动" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1884" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_2_branch_5" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2074.0" as="sourcePoint"/><mxPoint x="1252" y="2074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_3_field_1" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 由视频构造对象与度量尺度&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入真实 TACO 或 Veo3 合成的人体桌面视频，人工选目标对象，SAM2 分割首帧，裁剪后 Trellis 生成刚体网格。VGGT 在重叠视频块估深度，必要时对对象区域深度作时间尺度对齐。HaMeR 的度量 MANO 手宽与估计点云宽度对齐，给全视频深度统一尺度；这把手模型尺度误差也引入对象重建（§3.1–3.2、附录 B.1–B.2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_3_branch_1" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_3_field_2" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 由视频构造对象与度量尺度&lt;/b&gt;&lt;br&gt;&lt;br&gt;随后采多个对象尺寸候选，用 FoundationPose 的姿态评分选尺寸；跟踪三维点估计相邻帧刚体变换，先更新上一帧姿态，再交给 FoundationPose 精化，减少遮挡/快速运动时漂移。没有宣称此过程消除所有遮挡，也未报告一个通用视频剔除比例" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_3_branch_2" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="794.0" as="sourcePoint"/><mxPoint x="1942" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_3_field_3" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 场景稳定化及运动重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;桌面点云法向近似重力，人类髋部方向给朝向，骨盆位置与机器人骨盆对齐；若工作区超出还平移场景。机器人下半身固定，腕部使用 Genesis IK，手指使用五层 MLP 从五指尖三维位置预测目标手关节。它不是直接复制人手角度，更不是适用于 DH116 的现成标定（§3.3、附录 B.4）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_3_branch_3" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1216.0" as="sourcePoint"/><mxPoint x="1942" y="1216.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_3_field_4" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 场景稳定化及运动重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;单图网格外观逼真仍可能摇晃倾倒；系统对初始对象姿态采二十个随机旋转，角度不超过±45°，每个仿真二十步，选与原姿态差最小的稳定配置。该步骤更改了初始场景几何关系，后续需要检查与视频目标是否仍一致" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1441" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_3_branch_4" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1631.0" as="sourcePoint"/><mxPoint x="1942" y="1631.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_3_field_5" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 接触先验与残差 RL&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGB 视频 → 网格/深度/手物轨迹 → 场景坐标对齐与稳定化 → 腕/手分开重定向 → 接触对应点 → PPO 残差策略 → IK 与 PD 仿真执行。 离线先找人手关键点附近的对象网格点，距离过大者剔除；在线奖励拉近机器人关键点与该对应点，并以表面法向约束避免用手背“作弊”接触。再加对象平移/旋转跟随与手运动模仿奖励（式1–2、图4）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1849" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_3_branch_5" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2081.0" as="sourcePoint"/><mxPoint x="1942" y="2081.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_3_field_6" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 接触先验与残差 RL&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略输入关节、对象状态、目标姿态及时间步，输出双手腕平移、旋转、手关节残差，逐步累积到参考运动，再通过 IK 和 PD 执行。控制 30 Hz、仿真 dt=1/30、四个 substeps；这些不能当作视觉处理速度或端到端延迟。GPU 型号、完整处理时延和每视频总预算未报告，Isaac Gym 两千级并行环境与多个视觉基础模型意味着需 GPU 资源（附录 B.5，表5–6）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2341" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_3_branch_6" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2573.0" as="sourcePoint"/><mxPoint x="1942" y="2573.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_4_field_1" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、消融与数字边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;对象估姿在 TACO 244 段双手操作数据上比较；表1的 ADD-S、VSD 是 AUC 分数，FoundationPose 为0.49/0.70，DexMan 为0.57/0.82。提升0.08/0.12是绝对分数差，不是厘米或成功率；时序稳定性0.76仍低于 SpatialTracker 0.79，不宜称每指标都第一（§4.1）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_4_branch_1" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_4_field_2" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、消融与数字边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;OakInk-v2 取七十七段验证动作，每段十次；双方使用真实对象资产与手物动捕标注。PPO 五百轮、每轮2048环境×32步；以整条轨迹每步旋转误差&amp;lt;0.5 rad、位置误差&amp;lt;3cm判成功。DexMan44.3%对ManipTrans25.3%，差十九个百分点。基线浮动手、本文完整上肢且评价改为整集轨迹，因此不能只归因于某一个模块，也不能把这项当无标注视频结果（表2、§4.2）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_4_branch_2" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="794.0" as="sourcePoint"/><mxPoint x="2632" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_4_field_3" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、消融与数字边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整视频路线用五十段 TACO 真实视频及五十段 Veo3 生成视频，训练增至一千次更新（表3）：| 配置 | TACO | 合成视频 |&lt;br&gt;|---|---:|---:|&lt;br&gt;| 完整系统 | 27.4% | 39.0% |&lt;br&gt;| 去任务奖励 | 18.4% | 34.6% |&lt;br&gt;| 去接触奖励 | 7.2% | 7.8% |" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_4_branch_3" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1286.0" as="sourcePoint"/><mxPoint x="2632" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_4_field_4" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、消融与数字边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;引言写合成37.0%，与表3及§4.3的39.0%不一致，本卡采用表格并保留冲突。对象误差和 mask IoU 只在成功 rollout 上算，移除接触奖励后残留简单案例可能误差更小，不能视为更好技能。稳定初始化为98%对86%，判据是仿真后对象与初始估姿旋转偏差不超0.75 rad，并非操作任务成功率（表4）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_4_branch_4" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1760.5" as="sourcePoint"/><mxPoint x="2632" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_5_field_1" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者承认：只有仿真；单人、刚性桌面物体；不处理柔性/铰接对象；任务优先会牺牲自然动作；末端参数化忽略整臂姿态及避碰；手和对象分开估计导致接触不一致。吉他抬举失败显示小尺寸 G1 无法复现较长人臂的稳定构形（§5、图6、附录 C）" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_5_branch_1" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_5_field_2" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的推论：生成视频的视觉合理不保证力学正确，接触评分会继承网格、尺度与遮挡误差；每视频优化不能直接算通用策略。当前 D435i 可辅助离线验证重建尺度，重点先测手物相对几何和可达性。DH116 六主动轴/十一总自由度，与 Shadow 的关节和接触面积差别大，必须重新建立受限重定向，先比较三指接触与可达域；左手仿真资产不是右手标定证据" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_5_branch_2" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="794.0" as="sourcePoint"/><mxPoint x="3322" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_93_5_field_3" parent="paper_93" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;整手/多轴仍锁定且原因未知，优先离线运动学、仿真接触和日志审计，不让视频估计触发动作。未来双臂需额外机械臂、标定和整臂避碰；大型视觉模型与并行 RL 需计算预算。可以先复用对象坐标接触奖励与稳定初始化思想，待独立动力学验证后再讨论迁移" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_93_5_branch_3" edge="1" parent="paper_93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1251.0" as="sourcePoint"/><mxPoint x="3322" y="1251.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
