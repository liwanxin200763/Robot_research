        </UserObject><UserObject id="paper_53_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-54" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_53_1_field_1" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / RSS&lt;br&gt;引用量：537（沿用本地记录，未重新查询）&lt;br&gt;研究方向：07 VLA 基础与泛化" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_1_branch_1" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_1_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配&lt;br&gt;&lt;br&gt;研究背景：机器人抓取和放置取决于三维位置与运动方向，但常见 VLA 主要处理二维图像 Token，并逐维均匀量化动作。跨机器人时，相机安装和动作分布不同，单一表示难兼顾空间理解与适配。（论文第 I 节）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_1_branch_2" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_1_field_3" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：在无需各机器人统一外参标定的条件下，把相机视角内的 3D 线索引入 VLA，同时让离散动作表示保留空间结构、便于迁移到新机器人。（第 I、III 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：OpenVLA 的单维均匀动作档位没有把方向与距离作为相关的 3D 单元处理；仅用 2D 视觉特征也容易在高度、布局变化时失去可靠空间定位。Octo 等跨本体策略有适配能力，但本文重点是统一观测与动作的空间表征。（第 II–III 节）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_1_branch_3" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1429.5" as="sourcePoint"/><mxPoint x="562" y="1429.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_1_field_4" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：三维空间表示与 VLA（视觉—语言—动作模型：用图像与指令生成动作） 动作编码。输入仍是图像和文字，用估计深度恢复相机坐标中的三维位置，再把运动方向和距离编码为动作符号&lt;br&gt;核心研究问题：模型知道“拿杯子”，却可能分不清该伸多远、抬多高。怎样把三维位置和动作几何关系显式放进模型，并在换机器人时适配？&lt;br&gt;之前方法的问题：普通图像特征容易忽视高度和距离；各动作维度均匀分箱可能把常用小动作分得太粗，迁移新机器人时动作分布也会改变" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_1_branch_4" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2026.5" as="sourcePoint"/><mxPoint x="562" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_2_field_1" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_2_branch_1" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_2_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_2_branch_2" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="780.0" as="sourcePoint"/><mxPoint x="1252" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_2_field_3" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与 OpenVLA 的二维输入和逐维量化相比，SpatialVLA 引入相机坐标下的深度位置与联合空间动作格；不同于 3D-VLA 的 3D 世界预测重点，这里把空间信息直接用于低层动作 Token。其零样本优势与数据规模、主干和表示一起变化，表 IV 消融才提供表示模块的局部证据。（第 II–IV 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_2_branch_3" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1254.5" as="sourcePoint"/><mxPoint x="1252" y="1254.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_2_field_4" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：#52 OpenVLA 把动作拆成离散符号；空间表示方法用深度或点云补几何信息。空间感知与动作编码一起设计，才能把看懂位置转换为合适运动&lt;br&gt;相关方向 2：自回归逐个生成动作符号；Adaptive Action Grids（自适应动作网格）根据动作分布划分空间，使常用动作区域获得更细表示&lt;br&gt;代表工作：与 OpenVLA、Octo、TraceVLA 等比较。#40 4D-VLA 还引入跨帧历史与标定，本篇重点是单视角三维编码及动作离散，不是完整长记忆系统&lt;br&gt;与已有方法的区别：用相机内参和估计深度得到自我中心三维坐标，不需机器人—相机外参；这与世界坐标标定不同，不能混写成相同的跨场景坐标方法" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1497" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_2_branch_4" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1816.5" as="sourcePoint"/><mxPoint x="1252" y="1816.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_1" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ego3D Position Encoding 用估计深度把图像 Patch 放到相机坐标系，增强视觉语义；Adaptive Action Grids 按数据分布把平移和旋转分成两个三维空间格，再加夹爪 Token，单步动作只需三个 Token。新机器人微调时重新划格并插值初始化嵌入。（图 2–3；第 III 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_1" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入图像一支进入 SigLIP 提取语义，另一支经冻结的 ZoeDepth 预测深度并按相机内参反投影，再把位置编码加到视觉 Patch；PaliGemma2 主干结合语言自回归输出平移格、旋转格、夹爪三类 Token，反量化后执行。Ego3D 使用相机自身坐标，仍需要相机内参，并非无需任何几何信息。（第 III-A 节；附录 B）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_2" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_3" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;单张第三视角 RGB 图像与自然语言指令；训练/部署中用 ZoeDepth 从 RGB 估计深度，或新域用传感器深度。预训练实验并未把触觉、多相机或原始点云作为直接输入。（第 III–IV 节；附录 B–C）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_3" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1209.0" as="sourcePoint"/><mxPoint x="1942" y="1209.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_4" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;单臂 7 维末端动作由平移、旋转、夹爪构成；平移变换为方位角、俯仰角、距离后拟合动作分布，旋转也建立三维格。每步输出 3 个空间动作 Token；论文部署一次预测 4 步，即 12 个 Token，随后再感知和规划。该方法仍为离散自回归动作，未使用 Flow Matching。（第 III-A、IV 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1427" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_4" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1641.5" as="sourcePoint"/><mxPoint x="1942" y="1641.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_5" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;按数据集性能调整混合权重；DROID 在最后阶段从数据混合中移除。动作按机器人域归一化并拟合高斯分布，用等概率间隔划空间格；新域重新拟合后用相邻旧格嵌入三线性插值。附录 D 指出随机裁切和颜色扰动对零样本测试重要。深度预测器固定，避免在每个数据源要求实际深度标签。（第 III-B 节；附录 A、D）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1884" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_5" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2098.5" as="sourcePoint"/><mxPoint x="1942" y="2098.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_6" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;从 PaliGemma2 初始化，优化视觉编码器、语言主干、Ego3D MLP 与空间动作嵌入，文本 Token 嵌入保持冻结，以 next-token cross-entropy 训练。预训练 64 张 A100、约 10 天、批量 2048、学习率 2×10⁻⁵；前段完整混合数据 160k 步，去 DROID 后再 40k 步。LIBERO 新域采用 LoRA rank 32 微调 200 epoch，并重划动作格。（第 III–IV 节；附录 D）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2341" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_6" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2573.0" as="sourcePoint"/><mxPoint x="1942" y="2573.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_7" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：Ego3D 用估计深度与相机内参把像素还原到三维，将位置嵌入加入图像语义特征。模型可同时利用“是什么”和“在多远/多高”&lt;br&gt;贡献 2：平移转为方向和距离，旋转与夹爪分别编码，按统计分布分配动作网格。单步7维控制变为3类空间动作符号，再还原连续动作&lt;br&gt;贡献 3：用约110万条示范预训练；目标机器人微调时重新拟合动作分布并插值初始化嵌入。插值是在原动作表示间取邻近组合，不是无需目标数据&lt;br&gt;方法流程：图像 → 估计深度+三维位置编码 → 结合语言 → 预测自适应网格动作符号 → 还原连续动作段 → 执行并重观察；换平台用新示范适配网格" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="2833" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_7" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3152.5" as="sourcePoint"/><mxPoint x="1942" y="3152.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_4_field_1" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;从 Open X-Embodiment 与 RH20T 组成约 110 万条真实机器人 episode、28 个数据集。附录 A 表 VI 给出例子：Bridge 约 6.0 万条、Fractal 约 8.7 万、DROID 约 9.2 万、RH20T 约 10.4 万；这些来源包含多机构机器人示范，不能归成一种统一遥操作方式。Franka 新任务数据由操作者用 SpaceMouse 以 10 Hz 收集。（第 III-B 节；附录 A、D）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_branch_1" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_4_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;零样本在 SimplerEnv 的 Google Robot、WidowX 仿真中测试视觉匹配与变体聚合；真实 WidowX 用 7 组任务测背景、姿态、运动干扰与语言指代，每组 11 次。新域适配包括 LIBERO 四套任务、13 项 Franka 任务；还设空间指令与高度扰动测试。基线包括 RT-1-X、RT-2-X、Octo、OpenVLA、TraceVLA、RoboVLM 与 Diffusion Policy，按各实验提供的成功率评价。（第 IV 节；表 I–III、图 4–7）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_branch_2" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_4_field_3" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;WidowX 250 单臂与固定安装的 RealSense D435 进行 7×11 次零样本评测；Franka Panda 单臂用三脚架 D435，数据由 SpaceMouse 遥操作采集，13 项任务每项 11 次。部署在 RTX 4090 上约 20 Hz、8.5 GB 显存；论文未报告双臂实物操作。（第 IV 节；附录 D–E）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_branch_3" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_4_field_4" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;SimplerEnv Google Robot 零样本视觉匹配平均 71.9%、变体聚合 68.8%，RT-2-X 分别 60.7%／64.3%（表 I）。WidowX 仿真四任务平均零样本 34.4%，Bridge 微调 42.7%（表 II）；这两个数字是仿真表格，不能写成 77 次真机的总成功率。LIBERO 平均 78.1±0.7%，OpenVLA 76.5±0.6%；Spatial 套件 88.2±0.5%（表 III）。Franka 空间指令任务 #1 达 73%（图 7）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_branch_4" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1813.0" as="sourcePoint"/><mxPoint x="2632" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_4_field_5" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;在相同预训练子集上，移除 Ego3D 后 Google「Pick Coke Can」变体聚合由 81.6% 降到 68.9%，WidowX「Put Eggplant」成功率由 87.5% 降到 37.5%；改为逐维线性 256 档后前一任务降到 40.7%（表 IV）。LIBERO-Spatial 上 LoRA 83.6±0.7%，再加新域空间嵌入适配达到 88.2±0.5%（表 V）。附录表 IX 对细粒度任务报告 ZoeDepth 版本平均 72.7%，去深度 45.4%" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_branch_5" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2305.0" as="sourcePoint"/><mxPoint x="2632" y="2305.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_4_field_6" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出 LIBERO-Long 仍较弱，虽为该表最高但仅 55.5±1.0%，缺少长时序历史建模。附录 A 还报告 FMB 数据权重过高造成机器人向右偏移；低分辨率动作格容易输出偏小动作、移动缓慢。真实 WidowX 的干扰物和动态移动测试仍有失败，不能把个别演示视为全任务稳健。（第 IV–V 节；附录 A、C）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_branch_6" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2779.5" as="sourcePoint"/><mxPoint x="2632" y="2779.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_5_field_1" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者明确指出高斯拟合在单轴运动等极端分布下可能让网格挤到局部，噪声也会扭曲格点；每步 3 个自回归 Token 有推理代价，高自由度双臂／灵巧手直接扩维会带来更多嵌入参数。单帧观测和有限历史限制长任务，OXE 数据质量差异也会影响训练。（第 V 节；附录 C）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：对普通夹爪双臂协作，Ego3D 可启发相机视角下的目标相对位置编码，Adaptive Action Grids 可启发跨机械臂动作空间对齐；但目前 7D 单臂动作格不能直接当作双臂验证成果。应检验双臂联动格规模、遮挡下深度误差和接触任务精度，这是基于论文局限提出的研究问题" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_5_branch_1" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_53_5_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：高斯分布拟合动作可能对特定坐标轴聚集，噪声也会扭曲网格；自回归解码较慢，长历史结构不足。作者建议改进分布拟合、灵活解码与数据质量&lt;br&gt;我的理解 / 不足：深度估计错会污染空间编码，三维位置正确也不保证指尖接触正确。手指动作小而精细，网格需按 DH116 动作分布设计，不能照搬末端运动&lt;br&gt;未来展望：加历史和本体状态，并对深度误差设置置信度；分别测高度变化、动态目标与接触失败，明确空间改善的边界&lt;br&gt;对我们项目的启发：可为 DH116 的腕部定位与手指动作编码提供参考。先保留末端空间编码，再设计独立手指/接触输出，连接 #40 时间记忆" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_5_branch_2" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1126.5" as="sourcePoint"/><mxPoint x="3322" y="1126.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
