        </UserObject><UserObject id="paper_28_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-22" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_28_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-29" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_28_1_field_1" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ECCV 2026&lt;br&gt;引用量：16（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_1_branch_1" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_1_field_2" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作&lt;br&gt;&lt;br&gt;研究背景：许多机器人基准在 episode 开始前随机布局，执行期间目标仍近似静止；现实操作中物体会继续运动。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：构建真正执行中动态的操作基准，并训练能跟踪和拦截移动目标的视觉语言动作方法。（第 1 节）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_1_branch_2" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_1_field_3" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：静态随机化不能检验持续运动和未来目标位置预测；直接叠加历史帧还会干扰视觉语言模型的时序推理。（第 1–2 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：动态环境 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 与动态操作基准&lt;br&gt;目标会在机器人执行时移动&lt;br&gt;核心问题：物体持续移动时，&lt;br&gt;机器人能否根据过去运动预测抓取时的位置？&lt;br&gt;静态场景训练的策略常朝旧位置伸手；&lt;br&gt;反应和推理也有延迟" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_1_branch_3" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1534.5" as="sourcePoint"/><mxPoint x="562" y="1534.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_2_field_1" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读&lt;br&gt;&lt;br&gt;与已有工作的关系：与 DynaMem 的跨观测对象位置更新互补：DOMINO 更适合考验执行中运动目标，PUMA 更偏短期视觉预测&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：静态桌面操作基准，&lt;br&gt;通常固定物体位置&lt;br&gt;相关方向 2：运动预测，&lt;br&gt;从连续画面估计物体走向&lt;br&gt;代表对照：π0.5 和 OpenVLA-OFT；&lt;br&gt;比较动态难度逐级提高时的表现&lt;br&gt;区别：同时提出 DOMINO 评测与 PUMA 策略，&lt;br&gt;明确测试运动目标" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_2_branch_1" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="564.5" as="sourcePoint"/><mxPoint x="1252" y="564.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_2_field_2" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1017" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_2_branch_2" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1207.0" as="sourcePoint"/><mxPoint x="1252" y="1207.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_3_field_1" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一篇论文提出 DOMINO 基准与 PUMA 方法；DOMINO 是测试场景，PUMA 将历史光流与训练期未来物体状态查询接入 VLA。二者不是两篇独立论文。（第 3–4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_3_branch_1" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_3_field_2" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;DOMINO 有 35 类任务、超过 11.7 万轨迹、五种机器人形态和三级运动强度，目标在策略执行过程中独立运动。PUMA 以 Qwen3-VL 为基础编码场景历史光流，训练期使用对象中心未来 DINO 特征监督 world query，再预测动作片段。历史是短期视觉运动线索，不是持久对象记忆；未来预测用于动作选择，没有显式旧记忆删除或风险回滚。（第 3–4 节、图 2–4）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_3_branch_2" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="780.0" as="sourcePoint"/><mxPoint x="1942" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_3_field_3" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：当前和历史图像、语言指令、机器人状态、场景光流；训练期还有未来目标状态监督。（第 4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：输出连续机器人动作片段；目标运动时可在后续观测中重新规划，但未定义等待、no-op、失败诊断或回滚。（第 4 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：历史帧计算光流以表征物体运动，未来视频提取 DINO 对象特征作为训练监督；测试时不读取未来真实帧。（第 4 节）&lt;br&gt;&lt;br&gt;训练方式：行为克隆动作 L1 损失联合未来特征余弦目标训练 PUMA；world query 的未来监督仅在训练时提供。（第 4 节）" vertex="1">
          <mxGeometry height="709" width="628" x="1942" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_3_branch_3" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1394.5" as="sourcePoint"/><mxPoint x="1942" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_3_field_4" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：DOMINO 含 35 个动态任务、&lt;br&gt;11 万多条专家轨迹，分三类运动难度&lt;br&gt;贡献 2：PUMA 用光流（像素移动方向）&lt;br&gt;读取近期物体运动&lt;br&gt;贡献 3：预测未来目标特征，再生成动作段；&lt;br&gt;训练需目标标注，执行时不用未来画面&lt;br&gt;流程：连续图像→估计物体运动&lt;br&gt;→预测将来位置→生成动作→再观察" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_3_branch_4" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2026.5" as="sourcePoint"/><mxPoint x="1942" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_4_field_1" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：DOMINO 以五种执行体收集 35 项动态任务的 117k 轨迹；真机为双 Piper 的五项动态任务，每任务 50 条演示。（第 3、5 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：比较 ACT、OpenVLA、RDT、π0、π0.5 和 OpenVLA-OFT 等；按目标速度、形态和任务统计成功率及运动分数。（第 5 节、表 3）&lt;br&gt;&lt;br&gt;真机实验：双 Piper 五项动态任务，每项 20 次测试；PUMA 平均成功率 42%，π0.5 为 24%。（第 5 节）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_4_branch_1" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_4_field_2" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：DOMINO 表 3：PUMA 成功率 17.20%、运动分数 34.97；OpenVLA-OFT（Qwen3-VL）为 10.86%/30.49，π0.5 为 9.63%/26.17。绝对成功率仍较低。（表 3）&lt;br&gt;&lt;br&gt;消融实验：基线 10.86%；加历史光流 11.71%；再加两步未来预测 14.80%；四步预测 17.20%；直接堆历史帧仅 8.15%。（第 5 节、消融表）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_4_branch_2" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="986.5" as="sourcePoint"/><mxPoint x="2632" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_4_field_3" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;运动目标速度提高时抓取窗口缩短，许多方法在物体移动后仍朝旧位置行动；PUMA 也远未解决全部动态任务。（第 5 节及附录）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_4_branch_3" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1454.0" as="sourcePoint"/><mxPoint x="2632" y="1454.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_4_field_4" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：DOMINO 仿真动态操作；&lt;br&gt;报告成功率和完成进度&lt;br&gt;对照：π0.5、OpenVLA-OFT 等；&lt;br&gt;按速度、曲线、突变三层测试&lt;br&gt;结果：Level 1 成功率 17.20%；&lt;br&gt;最佳对照 10.86%，高 6.34 个百分点&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;补充：Level 2/3 为 10.5%/4.6%；&lt;br&gt;快速突变仍很难，真机测试规模较小" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1672" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_4_branch_4" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1939.0" as="sourcePoint"/><mxPoint x="2632" y="1939.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_5_field_1" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：真正动态；目标在策略执行期间独立移动，需持续跟踪和拦截&lt;br&gt;&lt;br&gt;主要局限：论文主要解决可观测目标运动的预测和拦截。按本库分析，尚无显式物体波动率、过期记忆置信度、失败归因和回滚机制；真实双臂实验没有证明两臂失败互助&lt;br&gt;&lt;br&gt;对当前研究方向的价值：DOMINO 可作 Dynamic / Volatility-Aware Memory VLA 的关键动态环境 benchmark；PUMA 可作光流与未来对象状态预测基线。后续双臂 DH116 研究可加“旧目标位置是否失效”的风险门控，但这是研究启发而非论文结果" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_5_branch_1" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_28_5_field_2" parent="paper_28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者设定主要是仿真；&lt;br&gt;刚体接触、动态数据成本和真实时延未充分覆盖&lt;br&gt;我的理解：预测位置不等于安全抓取，&lt;br&gt;手指接触和失败恢复仍需单独研究&lt;br&gt;未来可加现实观测校验预测，&lt;br&gt;变化太快时选择等待或重规划&lt;br&gt;项目启发：把 DOMINO 当动态 VLA 基准；&lt;br&gt;DH116 先测慢速移动再加接触控制" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_28_5_branch_2" edge="1" parent="paper_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1056.5" as="sourcePoint"/><mxPoint x="3322" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
