          </mxCell>
        </UserObject><UserObject id="paper_36_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-37" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_36_1_field_1" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / NeurIPS&lt;br&gt;引用量：17（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_1_branch_1" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_1_field_2" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_1_branch_2" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_1_field_3" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Bimanual Manipulation; Dexterous Manipulation; Dataset / Benchmark 方向，主要讨论许多机器人操作数据和仿真 benchmark 偏机械臂，缺少人形机器人操作数据。&lt;br&gt;核心思路是HumanoidGen 扩展人形机器人操作数据，用生成数据训练和评估 2D/3D Diffusion Policy。&lt;br&gt;与当前项目的联系：项目联系：本项目不是人形手，但双臂数据覆盖问题相通" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_1_branch_3" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_1_field_4" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：许多机器人操作数据和仿真 benchmark 偏机械臂，缺少人形机器人操作数据&lt;br&gt;&lt;br&gt;为什么重要：提醒跨本体数据设计比单纯增加示范数量更重要" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_1_branch_4" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1680.0" as="sourcePoint"/><mxPoint x="562" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_1_field_5" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：双臂灵巧手的数据生成。LLM（大语言模型：根据文字生成方案）负责拆任务；运动优化负责把文字方案变成连续机器人轨迹 Trajectory（轨迹，一段按时间排列的状态和动作），即随时间排列的状态和动作&lt;br&gt;核心研究问题：普通机械臂示范已较多，但左右手协作抓握、倒水、整理的示范很少。能否在仿真中自动建立任务和成功示范，减少人工双手遥操作？&lt;br&gt;之前方法的问题：直接让语言模型写动作容易遗漏碰撞和接触；已有仿真生成器多针对夹爪。灵巧手还需指定抓哪个位置、手腕朝哪边、两手如何配合" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1905" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_1_branch_5" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2189.5" as="sourcePoint"/><mxPoint x="562" y="2189.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_2_field_1" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;之前方法的问题：数据本体分布不足会限制策略对人形平台的适配" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_2_branch_1" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_2_field_2" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_2_branch_2" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_2_field_3" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：任务规划可把长任务拆成抓取、搬运、倾倒等原子操作（可复用的小动作）。但分解成文字步骤后，还需要把每一步落实为可解的几何条件&lt;br&gt;相关方向 2：#16 RoboTwin2.0 与 #18 DexMimicGen 扩增机器人示范；HumanoidGen 则先给物体和手标注功能位置，再生成双手约束与示范&lt;br&gt;代表工作：图像或点云扩散策略学习示范后控制机器人；这一步评估生成数据有没有训练价值。语言规划器找到可行方案，并不意味着学出的策略必然成功&lt;br&gt;与已有方法的区别：用蒙特卡洛树搜索（多次试不同规划分支，再根据成功与失败选择分支）改进语言方案。既生成数据，也检查复杂步骤组合能否在仿真中执行" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_2_branch_3" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1394.5" as="sourcePoint"/><mxPoint x="1252" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_3_field_1" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;HumanoidGen 扩展人形机器人操作数据，用生成数据训练和评估 2D/3D Diffusion Policy" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_3_branch_1" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_3_field_2" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;从原子操作生成可执行示范&lt;/b&gt;&lt;br&gt;&lt;br&gt;HumanoidGen 先为物体资产和灵巧手提供与原子操作相对应的空间标注，例如哪些位置可抓持、哪些关系需要保持。语言模型规划器把任务与场景解释成一串臂运动的空间约束，再调用原子灵巧操作组成示范；它不要求语言模型凭空输出每根手指的连续力矩。遇到长任务或标注不足时，用蒙特卡洛树搜索的变体探索和比较候选约束链，以提高规划可执行性" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_3_branch_2" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="780.0" as="sourcePoint"/><mxPoint x="1942" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_3_field_3" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;生成量与训练收益的连接&lt;/b&gt;&lt;br&gt;&lt;br&gt;把约束链放到仿真执行，保留可用于学习的操作轨迹，并在改变后的场景评估数据质量。原文以二维和三维扩散策略观察生成数据规模与下游表现的关系；因此要区分规划器成功生成数据、示范是否成功以及学习策略执行成功三种结果，不能把自动生成文件数量当作技能已经学会" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_3_branch_3" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1237.0" as="sourcePoint"/><mxPoint x="1942" y="1237.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_3_field_4" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：给物体和灵巧手标注关键点、方向轴和功能部位。输入任务与场景后，语言模型输出位置、朝向、接触等关系约束，使“倒水”有具体几何目标&lt;br&gt;贡献 2：运动优化把这些约束转成双臂路径，检查碰撞和执行结果；树搜索回看失败步骤并尝试另一种分解，降低长任务中“一步错误全链失败”的概率&lt;br&gt;贡献 3：建立 HGen Bench 的20类任务并生成不同规模数据，训练图像/点云策略。资产标注和原子操作仍需人工准备，自动化不是从任意物体零成本开始&lt;br&gt;方法流程：标注物体/手关键点 → 给出任务 → 语言模型生成约束链 → 运动优化与仿真检查 → 搜索修正规划 → 保留示范 → 训练双手策略" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_3_branch_4" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1781.5" as="sourcePoint"/><mxPoint x="1942" y="1781.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_4_field_1" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：生成的人形操作数据；具体任务与数据规模见论文&lt;br&gt;&lt;br&gt;主要结果：摘要报告 2D 与 3D 扩散策略表现会随生成数据增加而提升；未核验统一成功率&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：生成的人形操作数据；具体任务与数据规模见论文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：摘要报告 2D 与 3D 扩散策略表现会随生成数据增加而提升；未核验统一成功率" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_4_branch_1" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_4_field_2" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：用20/50/100条生成示范训练策略，正文重点比较14类任务，并在附录扩展任务。测试包含双手整理、堆叠和工具交互，区分规划成功与策略成功&lt;br&gt;对照：对比不使用树搜索的语言规划、不同搜索预算，以及图像和点云策略。数据越多是否帮助，还需按任务看，不能只看总轨迹数&lt;br&gt;结果：例如收纳积木的规划成功率46.7%→95%；这是约束规划器找到可执行方案的比例。部分长任务即使100条示范，学出的策略仍可能为0成功&lt;br&gt;真机 / 关键补充：真机 H1-2/Inspire 做两项任务；先执行仿真路径收集真机数据，再比较5/25条真机以及5真机+100仿真。此设置使用了真机示范，不属于纯零样本迁移" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_4_branch_2" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1091.5" as="sourcePoint"/><mxPoint x="2632" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_4_field_3" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_4_branch_3" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1636.0" as="sourcePoint"/><mxPoint x="2632" y="1636.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_5_field_1" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：本项目不是人形手，但双臂数据覆盖问题相通&lt;br&gt;&lt;br&gt;主要局限：仿真生成数据到普通夹爪真机的迁移需另行验证&lt;br&gt;&lt;br&gt;局限与启发：主要局限：仿真生成数据到普通夹爪真机的迁移需另行验证" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_5_branch_1" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_5_field_2" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者指出新增资产与操作需要标注，仿真对流体、柔性物体有限；含糊或动态变化目标也可能超出底层规划器能力&lt;br&gt;我的理解 / 不足：我的判断：空间约束能说明手该在哪里，却未必保证接触力稳定；生成成功轨迹还可能过于规整，缺少失败后重新抓握的状态&lt;br&gt;未来展望：加入动态扰动、接触验证和异常现场的数据生成，并分别报告规划率、策略完整成功率及双手同步误差，避免只优化生成器&lt;br&gt;对我们项目的启发：可用于 DH116 双手数据扩增。先做抓取、交接、扶稳三类原子技能，重建手的关键点与关节约束，再考虑树搜索组合长任务" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_5_branch_2" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_36_5_field_3" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_5_branch_3" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1531.0" as="sourcePoint"/><mxPoint x="3322" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
