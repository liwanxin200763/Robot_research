            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_1_field_2" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;年份 / Venue与来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：本地28页原论文页眉明确为ICLR 2026，官方proceedings亦确认。首次公开：官方https://arxiv.org/abs/2509.22195载明2025年9月26日v1，页面未列后续arXiv更新；此日期与会议版年份分别记录。canonical卡与本地Actions_as_Language.pdf标题、作者、方法一致。项目主页见元数据，代码发布状态未据卡片空字段推定。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_1_branch_2" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="864.0" as="sourcePoint"/><mxPoint x="562" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_1_field_3" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;常见VLA把连续控制量离散成特殊动作token，或者添加随机初始化的连续动作头，再在机器人数据上全量微调。作者认为动作监督与互联网图文预训练分布不一致，迫使模型大幅改变参数；示范覆盖又较窄，容易覆盖常识、图像理解和语言知识。本文把灾难性遗忘具体化为微调后的多种视觉问答性能下降，并进一步检查这些能力能否真正接入机器人动作。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_1_branch_3" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1356.0" as="sourcePoint"/><mxPoint x="562" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_1_field_4" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;目标能力与引用记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;目标是在不额外共同训练互联网图文数据的条件下，让机器人学会动作的同时保留原模型的视觉问答、常识、多语言和空间推理，并把保留的知识转成分布外操作能力。canonical卡所列引用量来自外部统计，本次未核验统计日期、检索口径与实时数量，不能作为本文贡献或影响力已确认的证据。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_1_branch_4" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1830.5" as="sourcePoint"/><mxPoint x="562" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_2_field_1" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;共同训练混合机器人数据和VQA、图像描述等数据，用原任务约束模型，但需要大规模数据与混合比例调优。LoRA学习低秩参数增量，尽量少改变主干；作者强调它还需要接近预训练分布的动作接口。ECoT先生成推理文字再生成动作token，说明高层有语言推理并不代表低层动作已经语言化。VLM2VLA把子任务、运动方向和实际数值动作都放进既有词表内，不增加独立动作解码器。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_2_branch_1" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_2_field_2" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;动作语言与知识保持的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文有两个应分开检验的环节：低秩微调是否保住原有知识，以及自然语言动作是否更容易把这些知识用于物理控制。动作token消融保留相近VQA却执行较差，恰好说明二者不能合并成一个指标；单看VQA或单看分布内抓取，都会遗漏作者真正关心的知识到动作的衔接。" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_2_branch_2" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="829.0" as="sourcePoint"/><mxPoint x="1252" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_3_field_1" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入→三层预测→输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入当前RGB观察与自然语言总任务。高层先产生子任务列表，如接近胡萝卜、抓取、抬起；中层根据观察和子任务生成相对末端的空间运动说明，如向下并稍向前；低层以观察、子任务和运动说明为条件，输出可变长度动作块。实际输出是Python嵌套列表的文本，每个向量为[dx,dy,dz,gripper]，包含真实平移增量及开合值，不是只让传统控制器理解“向左”。虽然硬件有6自由度，论文只研究平移加夹爪的4维接口。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_3_branch_1" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_3_field_2" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;概率分解与设计理由&lt;/b&gt;&lt;br&gt;&lt;br&gt;联合分布分为p(子任务|观察,指令)、p(运动规划|子任务,观察)、p(动作块|运动规划,子任务,观察)三项。这样先用语义知识确定做什么，再用空间知识决定方向，最后映射到可执行数值。中层只描述粗方向，是为了利用VLM相对擅长的空间理解，而不要求其先提供精细几何规划。动作仍自回归生成，但数字、符号均使用原词表，避免分配罕见动作专用token带来的表示失配。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_3_branch_2" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="899.0" as="sourcePoint"/><mxPoint x="1942" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_3_field_3" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;示范重标注&lt;/b&gt;&lt;br&gt;&lt;br&gt;使用Bridgev2中具有总任务指令的遥操作轨迹。Gemini输入整条时序图像、原始动作日志、语言目标以及机器人坐标正负约定，再切分子轨迹，关联子任务、运动解释和对应动作块。提示要求动作匹配原始日志，不能将其理解为大模型凭空合成控制标签。作者随机人工抽查标注，但未给抽查数量与标注错误率。先用Gemini 2.5 Pro，后改Flash控制成本，整个标注集约900美元；重标注后训练格式成为图像与文本问答对。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_3_branch_3" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_3_field_4" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练实现&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gemma-3-12B-IT主干所有线性模块使用LoRA，以文本交叉熵监督微调，无需额外互联网共同训练。附录给出rank16、alpha32、学习率5e-5、BF16、最大长度1024、有效全局batch8，4张A100训练1 epoch约300 GPU小时。AT消融把0–9映射到10个低概率token，其他训练设置及数据相同；NR消融去掉高层/中层推理，Q版本更换Qwen-3-8B-IT，用于检验表示、推理和主干可迁移性。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_3_branch_4" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1918.0" as="sourcePoint"/><mxPoint x="1942" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_3_field_5" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;执行反馈闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;测试时根据初始图像一次生成全部子任务，并在整个rollout中保持列表固定。每个动作块执行后，外部Gemini 2.5 Pro验证器比较前后观察，并结合当前和下一子任务，检查是否足够精确地满足下一动作前置条件。其结构化输出含success、confidence、reasoning，据此重试当前任务或进入下一项。该反馈更新的是执行进度，不是依据回报在线修改VLM2VLA权重，也不是每步重新规划整份任务。独立验证器是本论文真实系统组成，不能遗漏。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_3_branch_5" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2427.5" as="sourcePoint"/><mxPoint x="1942" y="2427.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_4_field_1" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机与任务条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;WidowX 250S在玩具厨房执行，侧面RealSense D435提供第三人称图像；安全过滤阻止继续撞桌面或墙面。测试抓胡萝卜、放胡萝卜入黄盘、放茄子入锅再抬鱼、多语言抓胡萝卜、抓小智图片上方物体。前两项分布内，组合任务的组成已见但组合未见；后两项考查西班牙语/中文/印地语及流行文化语义。通常每模型每任务30次，多语言按3种语言共90次，全文超过800次真机试验。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_4_branch_1" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_4_field_2" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;结果与评分口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;小智图像上方物体任务，主文报告VLM2VLA约60%、动作token消融约30%。图5纵轴为performance，附录D.1允许部分得分：简单任务接触目标可得1/2，组合任务按完成阶段计分；规划型与非规划型还有细则差异。因此宜称论文归一化任务表现，不把所有百分比解释为严格最终成功比例。OpenVLA在分布内抓取/放置最强，作者以其更大Open-X训练覆盖解释；VLM2VLA优势主要表现于组合、语义与多语言分布外条件。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_4_branch_2" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_4_field_3" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;VQA与消融归因&lt;/b&gt;&lt;br&gt;&lt;br&gt;表1中Gemma-3-12B-IT到VLM2VLA：MMMU46.0→42.7，TextVQA68.9→64.9，DocVQA80.6→78.4；MMStar46.3→48.0，ChartQA55.1→58.3。作者概括保留超过85%基础VQA能力，不能将其解释为每项完全无损。AT也有相近VQA，说明LoRA主要承担抗遗忘作用，而动作语言更有助于把知识接到机器人动作。不同主干模型比较还混有参数量、训练规模和数据差异，不能单凭总表确定唯一因果。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_4_branch_3" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1408.5" as="sourcePoint"/><mxPoint x="2632" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_4_field_4" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成本与延迟&lt;/b&gt;&lt;br&gt;&lt;br&gt;A100上30次推理周期测量包含中层推理与低层动作生成：中位6.1秒、均值10.5秒、标准差14.3秒、范围3.8–48.8秒，四分位区间5.0–6.7秒。约10%因坏格式触发重试，少量超过45秒。该周期耗时不是控制频率，也不能自动当成含外部验证服务的端到端时间。标注900美元和300 GPU小时有文献依据，真机人工工时、API推理总费用和能耗未报告。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_4_branch_4" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1918.0" as="sourcePoint"/><mxPoint x="2632" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_5_field_1" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出自回归延迟高、只控制平移而无精细旋转、单一本体、运动语言粒度粗、依赖独立验证器、训练数据规模有限。扩大机器人数据、让基座自己担任验证器或扩展跨本体动作语言，是未来方向，均不是本文已验证成果。现有证据覆盖特定厨房和抓放技能，不支持推论灵巧手、关节空间或多机器人通用控制已经解决。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_5_branch_1" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_115_5_field_2" parent="paper_115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：固定初始子任务列表配局部重试，在目标或前置状态改变时可能反复纠错却无法改全局计划；更大的基座和外部Gemini也可能贡献语义表现。研究启发：应同时记录严格最终成功、部分进度、重试次数、端到端耗时，并以同主干同验证器比较语言与特殊token动作接口。进一步按自动标注噪声和控制精度分组，扩展旋转时明确坐标、单位与原控制量的一致性。以上是建议，未在本机实施。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_115_5_branch_2" edge="1" parent="paper_115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
