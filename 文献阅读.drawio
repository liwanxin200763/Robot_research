          </mxCell>
        </UserObject><UserObject id="paper_41_bottomnav_1" label="返回分类" link="data:page/id,literature-page-03" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_41_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-29" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_41_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-42" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_41_1_field_1" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / CoRL 2026（作者项目页及 arXiv 标注已接收；正式论文集待核对）&lt;br&gt;引用量：引用量来源：（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_1_branch_1" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_1_field_2" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_1_branch_2" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_1_field_3" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：VLA（视觉—语言—动作模型）与潜在世界模型。世界模型根据观察等信息预测后续变化；本篇在压缩特征中预测未来，再用来生成动作，不先生成完整视频&lt;br&gt;核心研究问题：很多方法学会预测未来，却没有让未来信息直接影响动作。怎样把语言语义、历史和未来状态接起来，使策略能依据预测来行动？&lt;br&gt;之前方法的问题：渲染未来视频计算重，先预测再接独立控制器也可能目标不一致。只加辅助预测损失，模型可能仍主要依赖当前图像生成动作" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_1_branch_3" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1223.0" as="sourcePoint"/><mxPoint x="562" y="1223.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_2_field_1" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_2_branch_1" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_2_field_2" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_2_branch_2" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_2_field_3" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：#22 Mem-World 保持世界模型时空连续；#43 CLOVER 用可见视频目标做反馈。本篇改为潜在未来预测，减少像素生成负担&lt;br&gt;相关方向 2：V-JEPA 类模型从视频学习可预测的内部特征；Embedding（嵌入）就是把画面等信息变成数值向量。它不等于真实物理状态，也不直接是动作&lt;br&gt;代表工作：π0.5 等流匹配策略生成连续动作。Flow Matching（流匹配）学习由噪声到动作的连续变换；本篇把未来特征作为动作专家可使用的信息&lt;br&gt;与已有方法的区别：语义、世界、动作三个专家以受约束的信息通路交互。关键是未来信息进入动作计算，而非预测视频后只给人看" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_2_branch_3" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1275.5" as="sourcePoint"/><mxPoint x="1252" y="1275.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_3_field_1" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉—语言—动作策略若只依赖当前画面，长程任务中缺少对后续场景的预期；直接预测完整未来图像又耗费计算，并会关注与控制无关的视觉细节。PLaW-VLA 在冻结的 V-JEPA 2 表征空间预测任务相关的未来状态，以 Mixture-of-Transformers 连接语言／观测专家、潜在世界模型专家与连续动作专家，使用结构化因果注意力让动作读取历史、语义及预测未来。（§1、3，图 2）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_3_branch_1" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_3_field_2" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练分三阶段：无动作视频学习潜在未来预测；机器人轨迹联合训练预测与动作；最后对具体任务微调。与单纯把世界模型放在策略旁边不同，未来潜变量直接条件化动作生成。代码仓库已提供三阶段训练管线，但官方 PLaW-VLA 预训练 checkpoint 仍待发布。（§3；官方代码 README）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_3_branch_2" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_3_field_3" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：语义专家读取指令和观察历史，提取任务相关特征；世界专家在潜在空间预测未来，避免直接生成大量像素，让计算集中在控制相关变化&lt;br&gt;贡献 2：用冻结的 V-JEPA2 特征作预测目标，并设置未来到动作的信息通路。动作专家可读取预测结果，把“接下来会怎样”用于动作段生成&lt;br&gt;贡献 3：先用无动作视频学习未来，再用机器人数据联合学习，最后适配目标任务。分别去掉视频阶段或屏蔽未来条件，检查训练阶段与预测通路作用&lt;br&gt;方法流程：指令+观察历史 → 语义专家 → 世界专家预测未来特征 → 动作专家读取语义和未来 → 生成动作段 → 执行 → 新观察修正后续预测" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_3_branch_3" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_4_field_1" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO 四套任务平均成功率 97.4%，π₀.₅ 为 96.9%；其中 LIBERO-Long 为 94.6% 对 92.4%。零样本 LIBERO-Plus 七类扰动加权平均 72.7%；相同表中的 WorldVLA 为 25.0%，但不同方法的预训练与结构并非完全受控。RoboTwin 2.0 的 50 项任务中，Hard Horizon III 为 79.2%，π₀.₅ 为 67.4%，差 11.8 个百分点。（§4.1，表 1–3）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_4_branch_1" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_4_field_2" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机使用轮式双臂人形机器人执行叠毛巾、收玩具、投篮与整理文具；各模型每任务同用 400 条示范、10 种空间配置各 3 次。作者项目页给出原始成功率与零样本变体，但论文正文将任务进度作归一化评估；因此不能把项目页的成功率直接等同于正文的进度分数。（§4.2，图 4；项目页）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_4_branch_2" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="811.5" as="sourcePoint"/><mxPoint x="2632" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_4_field_3" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融中，去掉未来预测损失使 LIBERO-Plus 从 72.70%→67.56%，去掉未来条件使其降至 69.81%；改用重建导向的 Cosmos VAE 表征为 70.93%；推理时屏蔽所有未来状态令 LIBERO 从 97.40%→93.05%。在不使用第一阶段视频预训练、其余数据预算匹配的比较里，去掉预测世界模型使 LIBERO-Plus 从 69.05%→65.49%，把表征学习的额外数据优势与预测机制区分开。论文还报告相近性能下，相对生成式世界—动作建模约 1/19 的推理延迟。（§4.3–4.4，表 4）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_4_branch_3" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_4_field_4" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：测试 LIBERO、扰动更强的 LIBERO-Plus、RoboTwin 长任务及双臂真机。完整任务成功率与分阶段进度分开报告；不能混成一项总成功率&lt;br&gt;对照：与 π0.5、OpenVLA-OFT 等比较；屏蔽未来条件、移除第一阶段视频训练做消融。不同预训练数据的总模型比较需谨慎解释&lt;br&gt;结果：LIBERO 平均97.4%，π0.5 为96.9%；屏蔽未来条件后93.05%。后一个实验更直接支持“未来特征确实被动作模块使用”&lt;br&gt;真机 / 关键补充：RoboTwin 困难长任务79.2%，对照67.4%；双臂真机4项、每项30次，部分指标是步骤进度。不能把进度百分比标成全部任务完成率" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_4_branch_4" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1935.5" as="sourcePoint"/><mxPoint x="2632" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_5_field_1" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败案例与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败案例与局限：作者所述：执行轨迹偏离会损害未来状态预测，错误预测又可能经未来条件动作放大偏差；需要不确定性估计、可变预测时域和恢复机制。无动作视频到机器人控制的规模效应仍缺乏足够多样的训练数据验证。（§6）&lt;br&gt;&lt;br&gt;失败案例与局限：文献库分析：长程增益在 RoboTwin 随机化困难设置中较清楚，但尚不能证明模型会检测并修复真机执行误差。把未来预测与错误监测、物理反馈或场景恢复结合，需单独测试误预测后的闭环行为；当前模型 checkpoint 缺席也限制直接复现实验" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_5_branch_1" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_41_5_field_2" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者指出执行误差会破坏预测，错误预测又可能误导动作，形成连锁问题；可用视频训练的规模仍有限，泛化需继续验证&lt;br&gt;我的理解 / 不足：我的判断：高仿真成功不代表能识别突发失败。若预测没有置信度和真实观察纠正，模型可能自信执行错误未来对应的动作&lt;br&gt;未来展望：加入预测—实际偏差检测，偏差大时缩短动作段、重新观察或调用恢复；在快速移动物体与接触失败中验证，而非只测静态布局扰动&lt;br&gt;对我们项目的启发：可作为 DH116 的预测式动作模型参考。先预测物体/手部关键状态，再评估是否改善抓握；与 #44 RESETTLE 连接成“预测—发现偏差—纠正”链" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_41_5_branch_2" edge="1" parent="paper_41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1091.5" as="sourcePoint"/><mxPoint x="3322" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
