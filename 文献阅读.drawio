          </mxCell>
        </UserObject>
        <UserObject id="category_06_paper_49" label="#49 EquiBot&lt;br&gt;要解决：演示只在桌面一角采几次，换位置或尺寸后常失败。能否把几何规律写进策略结构，使少量数据也能处理新的物体位置、方向和大小？&lt;br&gt;年份 / Venue：2024 / CoRL 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-49" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="980" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_06_paper_50" label="#50 Bidirectional Decoding&lt;br&gt;要解决：长动作段平滑，却来不及响应物体移动；每步重新预测反应快，却可能一会儿左绕一会儿右绕。能否在两者之间保留一致且可及时修正的动作？&lt;br&gt;年份 / Venue：2025 / ICLR 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-50" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="1300" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_06_paper_51" label="#51 DexHandDiff&lt;br&gt;要解决：训练示范只开门到90度，测试要开30度并停住。能否在不重新采所有目标数据的情况下修改目标，同时保证手真的推动物体而非物体凭空动？&lt;br&gt;年份 / Venue：2025 / CVPR 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-51" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
