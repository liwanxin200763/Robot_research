        <mxCell id="paper_52_3_field_4" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="方法流程：图像+任务文字 → 双视觉编码 → 语言模型融合 → 预测动作符号 → 还原7维末端/夹爪控制 → 执行一步 → 输入下一张观察" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="830" as="geometry"/>
        </mxCell>
