        </UserObject><UserObject id="paper_119_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-113" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_119_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-126" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_119_1_field_1" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与公开信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：SimpleVLA-RL: Scaling VLA Training via Reinforcement Learning。作者见元数据，前四位为共同贡献，Bowen Zhou与Ning Ding通讯；机构有清华、上海AI Lab、Nature Will、上海交通大学、北京大学、香港大学、Frontis.AI。年份 / Venue：ICLR 2026，24页本地PDF与官方proceedings标题作者一致。首次公开由官方https://arxiv.org/abs/2509.09674确认2025年9月11日v1，未列后续arXiv更新；与2026会议版年份分开。代码链接直接来自论文首页，引用量未实时核验。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_1_branch_1" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_1_field_2" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景、问题与目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;SFT依赖昂贵机器人专家轨迹，示范覆盖不足时VLA容易记住窄模式、遇到新空间布局或物体退化。本文具体问：只有任务最终成败的稀疏反馈，能否像语言模型RL那样改进逐步机器人动作决策？目标是在已有非零能力的策略上，通过环境交互增加有效训练经验、增强泛化和仿真到真机迁移，并给出可并行运行的VLA强化学习框架。它并非完全取消预训练或从零奖励学会操作。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_1_branch_2" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_2_field_1" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与GRPO术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;SFT按专家动作最大化似然，擅长复现示范，却不直接优化整任务成功。PPO类策略梯度需要动作概率和新旧策略概率比；GRPO对同一初始任务采多条轨迹，用组内奖励均值与标准差形成相对优势，不另训练价值网络。对连续回归或普通扩散头，获得兼容的采样概率更复杂，所以本文主实验采用动作token分布。所谓长程“动作规划”是连续观察条件下的动作选择，不要求模型输出自然语言思维链。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_2_branch_1" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_2_field_2" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;为何要改探索与基础模型&lt;/b&gt;&lt;br&gt;&lt;br&gt;若一组轨迹全部成功或全部失败，组内标准化优势为零，无法提供有效策略梯度。机器人示范常有同质动作路线，导致策略难探索其他完成方式。本文相应修改采样与裁剪范围，使失败和成功可以比较，允许低概率动作获得更大提升。基座有起始能力仍是前提：不能把方法理解成稀疏0/1反馈对任何初始化都能学；作者专门报告初始成功为0时训练失败。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_2_branch_2" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="899.0" as="sourcePoint"/><mxPoint x="1252" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_3_field_1" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真正的策略反馈闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;首先用机器人示范SFT得到可执行策略；对一批任务/初始场景并行建立环境，每个初始输入采8条轨迹。每步模型根据最新图像（以及对应设置的本体状态）采样动作token，环境执行后返回新观察、完成状态，直到结束或最大步数。环境最终判成功赋1，否则赋0；收集动作概率和回报，再计算GRPO损失更新策略全部参数，随后用新策略继续采轨迹。这是环境交互→结果奖励→权重更新的训练闭环，不只是视觉反思、记录日志或选择一条执行计划。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_3_branch_1" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_3_field_2" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;动作主干与官方OFT区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;主干基于OpenVLA、视觉编码器及LLaMA2-7B，保留动作块和并行解码。附录G.2明确其OpenVLA-OFT实现不同于官方：只用单视角图像、指令和部分环境本体状态，取消腕部图像；LIBERO不输入本体状态；用LLaMA2输出头生成离散动作token及交叉熵，替换官方MLP连续动作和L1回归。因此不能直接加载官方OFT检查点，作者修改实现后重新SFT；把表中数字标为作者OFT实现才可复现。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_3_branch_2" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="899.0" as="sourcePoint"/><mxPoint x="1942" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_3_field_3" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;奖励与信用分配&lt;/b&gt;&lt;br&gt;&lt;br&gt;奖励只取任务完成0/1，不设计每阶段距离或接触奖励。整个成功轨迹的所有动作token均继承成功标签，失败轨迹继承失败标签，再经组内归一化得到同轨迹共享优势。优势乘新旧动作概率比并使用裁剪目标，限制更新过度。没有逐动作正确性评价，也无精细过程信用分配；这降低奖励工程需求，却要求足够探索才能在组中看到成功。结果判定器来自环境任务条件，不是训练一个通用视觉奖励模型。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_3_branch_3" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_3_field_4" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;三项探索增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态采样过滤全成或全败的轨迹组，继续收集直到batch有混合结果，保证相对优势非零。裁剪上界由1.2扩大到1.28、下界保持0.8，允许低概率有效token有更大上调空间。rollout温度由1.0增到1.6以增加行为多样性。去掉固定参考策略KL项，减少参考模型显存开销并避免约束探索。三项消融曲线报告约10–15个百分点收益，但不可直接相加为完整模型总收益。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_3_branch_4" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1918.0" as="sourcePoint"/><mxPoint x="1942" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_3_field_5" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;系统并行与实现设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;基于veRL增加持续多步环境交互、同步环境并行、渲染和训练/推理组织；完成环境从活动列表移除。全参数训练用8张A800 80GB，学习率5e-6，训练batch64、mini-batch128、每输入8采样；256类动作token。附录写LIBERO动作块数8、RoboTwin25，最大交互步分别512和按任务200/400/800。训练用随机采样，评估用贪心，基准重复3次。参数更新发生在训练回合之间，不在真机每个动作后即刻在线微调。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_3_branch_5" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2427.5" as="sourcePoint"/><mxPoint x="1942" y="2427.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_4_field_1" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;标准仿真条件与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO四套各10任务、每套500示范SFT，再500仿真场景RL；每任务50个留出场景测试。表3平均由91.0%到99.1%，Long86.5%到98.5%，分别增加8.1与12.0个百分点。RoboTwin1.0主表选四项双臂任务，每任务50示范、100场景RL，平均39.8→70.4%。RoboTwin2.0选12任务，跨度112–637步，每任务1000示范SFT及1000场景RL、100留出场景测试，平均38.3→68.8%，约80%相对增加，π0为52.7%。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_4_branch_1" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_4_field_2" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据效率与泛化条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;一示范设置每套10条，表4平均48.9→96.9%，Long17.3→91.7%；引言17.1与表格17.3不一致，笔记采用表4。它减少专家示范，但仍需要大量仿真交互，不能说总数据只用一条。泛化实验先用One-Trajectory SFT获得非零基础能力，再每套9任务继续SFT或RL，剩余任务用于留出评价；这不是从完全未见该任务的原模型直接零样本测试。Spatial例43.3→71.8%，Object某例提高36.5个百分点，部分SFT留出任务降至0。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_4_branch_2" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="916.5" as="sourcePoint"/><mxPoint x="2632" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_4_field_3" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机迁移及内部任务名差异&lt;/b&gt;&lt;br&gt;&lt;br&gt;双AgileX Piper真机，平台为Cobot Magic的Aloha配置，各臂6DoF加1DoF夹爪，D435相机640×480约30Hz；相机帧率不等于策略频率。每任务1000仿真示范和1000RL场景，无真实示范训练，每项50次真机，清洁桌面与未见背景。表5四项为Stack Bowls、Place Empty Cup、Pick Bottle、Click Bell，正文/附录文字却把第二项写Handover Block，存在任务名冲突。表5平均17.5→38.5%，RDT23.5%，仍有明显迁移失败。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_4_branch_3" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1443.5" as="sourcePoint"/><mxPoint x="2632" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_4_field_4" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体真机表现、成本与新行为&lt;/b&gt;&lt;br&gt;&lt;br&gt;表5堆碗38→70%，空杯2→10%，抓瓶0→14%，按铃30→60%，均为同表口径。单项RL在8张A800下RoboTwin约12–24小时；LIBERO一示范需1–2天，全示范约1天，弱初始化和长轨迹更慢。Pushcut例中，模型把示范“抓取—搬运—放置”换成推动物体到目标位置；它显示结果奖励允许不同动作路径，但不等于获得普遍推理能力，需检验任务成功判据是否接受这种捷径。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_4_branch_4" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1953.0" as="sourcePoint"/><mxPoint x="2632" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_5_field_1" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者失败条件与现实边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者报告0%起始成功时RL完全失败，低于5%时改进很小；基础模型先验比无差别增加探索更关键。真机抓瓶14%、空杯10%也说明仿真成功接近99%不能代表真实部署可靠。奖励只有最终成败，动态采样在接近全成或全败时可能提高收集开销；论文训练时长已反映弱先验代价，但未统一给环境步总数、API费用、能耗或真机端到端延迟。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_5_branch_1" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_119_5_field_2" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：Pushcut可能是高效策略，也可能绕过任务真实语义或安全要求，单一成功条件无法区分。研究启发：应同时核查终态、过程约束、碰撞和执行效率；报告每成功轨迹的采样成本及过滤比例，并对比同仿真交互预算下SFT加数据和RL。对双臂接触/交接场景，可在不扭曲目标的前提下增加明确过程约束，先确保非零成功再引入更强探索。以上属于后续实验建议，未在本机执行。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_119_5_branch_2" edge="1" parent="paper_119" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="829.0" as="sourcePoint"/><mxPoint x="3322" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
