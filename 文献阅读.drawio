            <mxGeometry x="120" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_90_bottomnav_1" label="返回分类" link="data:page/id,literature-page-data-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_90_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-89" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_90_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-91" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_90_1_field_1" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待 Google Scholar 人工核验（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_1_branch_1" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_1_field_2" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;项目主页：待核验&lt;br&gt;GitHub：待核验&lt;br&gt;代码状态：未确认 DQAF 专用实现；底层 Unitree XR 与 Forge 是其他项目，不能等同本文开源&lt;br&gt;查询与核验日期：2026-10-15&lt;br&gt;关联：机器人数据采集与数据质量 · 机器人遥操作与动作重定向" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_1_branch_2" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="902.5" as="sourcePoint"/><mxPoint x="562" y="902.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_1_field_3" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本信息与研究问题：研究方向：遥操作采集质量、操作员反馈、多模态示范审计。Teleoperation（遥操作）是把人的操作输入传给机器人，由人根据现场反馈继续控制；本篇研究每次采集结束后怎样帮助操作员改进，而非发明新的动作映射器&lt;br&gt;&lt;br&gt;基本信息与研究问题：一条轨迹最后把物体放进箱子，也可能包含长时间停顿、关节接近极限或反复开合。单个“成功”标签无法解释这些问题。作者提出 DQAF，把视频中的任务进度与机器人状态日志合并，生成质量分数和可执行的下一次操作建议（§I–III）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_1_branch_3" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1587.0" as="sourcePoint"/><mxPoint x="562" y="1587.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_1_field_4" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本信息与研究问题：快速摘要：任务说明与专家参考＋同步视频／状态／动作 → 语义进度和运动指标 → 对齐问题时间段 → 分数与自然语言反馈。它闭合的是“采集—评估—再次示范”的循环，目前没有验证反馈数据训练出的机器人策略是否更强&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：在遥操作后给示范质量反馈&lt;br&gt;DQAF 结合视频进度与机器人动作日志指出本次操作的坏片段，帮助人下次改进&lt;br&gt;为什么重要 / 旧方法的不足：单个“成功”标签无法解释这些问题；作者提出 DQAF，把视频中的任务进度与机器人状态日志合并，生成质量分数和可执行的下一次操作建议" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="1917" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_1_branch_4" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2271.5" as="sourcePoint"/><mxPoint x="562" y="2271.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_2_field_1" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：VR／XR 头显系统通过改善视角和手部追踪，降低控制负担；主从控制器通过形状对应降低映射难度。这些工作主要改善操作接口，DQAF 是可接在接口下游的审计模块&lt;br&gt;&lt;br&gt;相关工作：DataMIL、CUPID 等在采集后判断哪些数据有利于策略学习；另一类工具按画面清晰度、停顿或动作抖动筛选。DQAF 增加“为什么这次不好、下次怎样调整”的解释。其四个运动指标继承现有工具，不应把每项指标都写成本文原创（§II、IV-C）" vertex="1">
          <mxGeometry height="779" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_2_branch_1" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="529.5" as="sourcePoint"/><mxPoint x="1252" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_2_field_2" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;回合：一次从开始到结束的完整示范；质量反馈在回合结束后产生&lt;br&gt;VR／XR 头显系统通过改善视角和手部追踪，降低控制负担" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_2_branch_2" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1137.0" as="sourcePoint"/><mxPoint x="1252" y="1137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_3_field_1" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 输入必须同步&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 输入必须同步：每条 episode（一次有起止边界的示范）保存观察图像、机器人自身状态和操作命令。还需任务分解计划、带文字说明的优质参考图像，以及按任务标定的质量阈值。只录一段视频而不保存状态，无法复现关节边界诊断（式 1–2）&lt;br&gt;&lt;br&gt;2. 从图像估计任务进展：视觉语言模型联合理解图像与任务文字。每次输入初始锚点图像、最近短片段、有顺序的子任务清单和专家参考，输出当前子任务、该阶段完成比例、文字理由及异常标记" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_3_branch_1" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_3_field_2" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 从图像估计任务进展&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者将阶段序号和局部完成比例换算为全任务进度。反复退回前一阶段、持续进度下降等进入异常分析。进度是模型估计，不是来自接触传感器的确定事实；局部遮挡可能让模型误判（§IV-B）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_3_branch_2" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="927.0" as="sourcePoint"/><mxPoint x="1942" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_3_field_3" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 从日志检测执行问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;四项指标分别是：动作范围饱和率，表示命令经常接近上／下界；LDLJ，基于关节状态轨迹三阶时间导数 jerk 的平方积分、按回合时长与最大速度归一化后取对数的平滑性指标，值越大越不平滑；夹爪反复开合率；近零动作占比，反映停滞。各指标映射到 0–1 子分，再加权成为 0–10 的整次质量分数（式 7–11）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_3_branch_3" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1359.5" as="sourcePoint"/><mxPoint x="1942" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_3_field_4" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 从日志检测执行问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 从日志检测执行问题：夹爪开合指标针对二值状态，不是五指接触质量度量。静止也可能是等待插入或让物体稳定，不能脱离子任务语义只按停顿扣分。论文使用专家数据的百分位标定阈值，并未证明同一阈值可以跨本体通用&lt;br&gt;&lt;br&gt;4. 让建议有证据而不是凭空生成：把轨迹分段，记录指标值、阈值、超限状态和时间区间，寻找最接近的语义进度时刻。语言模型接收这些结构化证据，按约束提示生成“哪里出了问题—发生在哪段—下次怎样改”的简短反馈（§IV-D–F、图 1）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_3_branch_4" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1886.5" as="sourcePoint"/><mxPoint x="1942" y="1886.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_3_field_5" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 让建议有证据而不是凭空生成&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整流程：XR 操作 → 同步记录 → 视频进度分析与日志计算并行 → 语义／运动时间对齐 → 质量审计 → 回合后反馈 → 下一次示范。系统输出报告，不向机器人自动发送恢复指令；大模型也不属于实时底层控制环" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="2199" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_3_branch_5" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2389.0" as="sourcePoint"/><mxPoint x="1942" y="2389.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_4_field_1" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;平台为 Unitree G1、Meta Quest 手部追踪接口及顶视 RGB 相机；作者使用 Unitree XR 遥操作栈记录动作和关节状态。语义分析用 Gemini Flash 1.5，反馈用 Gemini 3 Pro，图像语义更新间隔 2.5 秒。状态日志称高频，但具体 Hz、相机型号和遥操作端到端延迟未报告（§V-A）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_4_branch_1" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_4_field_2" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果：任务一由左臂摆箱、右臂把圆柱体放入；任务二为双臂交接后投入箱中。没有 DH116 或五指抓取平台的直接实验，不把夹爪式指标当多指验证&lt;br&gt;&lt;br&gt;诊断验证：独立 100 次示范经专家标注有 72 成功、28 失败。系统标为失败的 26 次中有 24 真失败、2 误报，另漏掉 4 次失败。失败召回率是 24/28＝85.7%，衡量找到多少失败，不是策略任务成功率；也不能把它叫整体分类准确率（§VI-A）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_4_branch_2" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="829.0" as="sourcePoint"/><mxPoint x="2632" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_4_field_3" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;诊断验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;平均 50 秒的一次示范分成 20 个片段。20 次语义 API 调用各约 2 秒，加最后反馈约 3 秒，总回合后等待约 43 秒；日志计算约 2.2 秒但并行。若执行时提前处理，剩余等待约 20 秒。专家审阅约 15 秒，因此此实验不能证明自动系统整体比人工更快，更不能把 20 秒写成遥操作控制延迟" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_4_branch_3" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_4_field_4" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;探索性用户研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;探索性用户研究：只有三名新手，反馈分配没有完整随机交叉设计。表 I 的任务二，接受反馈的操作员 3 质量分为 9.4、均耗时 51.0 秒；无反馈操作员 1／2 分别为 8.2／5.6、45.4／71.8 秒。这是不同人的结果，反馈组也不是所有时间指标都更好（第 7 页表 I）&lt;br&gt;&lt;br&gt;探索性用户研究：表题称每条件 30 次，但 §V-D 对操作员 1／3 的“两个任务合计 30 次”描述存在歧义，故不合并推算试验总数。§VI-B 将表中成功按总错误数不超过三次定义，应与物理任务完成率分开理解。本文未报告训练后策略成功率，也没有严格消融证明每种反馈模块的独立贡献" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_4_branch_4" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1900.5" as="sourcePoint"/><mxPoint x="2632" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_5_field_1" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确承认：遮挡、子任务边界和进度估计敏感；阈值依赖专家数据；反馈发生在回合后；用户数量少，未来需评估更多本体与实际下游训练收益（§VII）&lt;br&gt;&lt;br&gt;不足与未来：本库分析：评分器既生成建议又评价改善，可能产生自洽偏差，需用独立人工标注和最终策略评估验证。参考文献若干 URL 与条目主题不一致，不能直接沿这些链接认定相关论文身份，应按正式标题回查官方来源&lt;br&gt;&lt;br&gt;不足与未来：对 D435i＋DH116，可先离线保存图像时间戳、目标值、实际反馈、报警和动作来源，做缺帧、越界、停滞检测，再把问题片段交给人工复核。DH116 的耦合指结构需要重设计“反复开合”指标；没有可靠标定前不使用未知状态阈值指导运动" vertex="1">
          <mxGeometry height="709" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_5_branch_1" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="494.5" as="sourcePoint"/><mxPoint x="3322" y="494.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_90_5_field_2" parent="paper_90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;可形成的研究设想是“接触阶段感知的可解释示范评分＋下一次采集建议”，但要通过随机分组或同人交叉实验、相同训练预算与独立抓取成功率验证。现有论文未确认官方 DQAF 专用代码／数据；Unitree XR 栈公开不等于整个质量系统已开源" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="877" as="geometry"/>
        </mxCell>
        <mxCell id="paper_90_5_branch_2" edge="1" parent="paper_90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1074.0" as="sourcePoint"/><mxPoint x="3322" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
