            <mxGeometry x="1140" y="4486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_05_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-125" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="4486" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><UserObject id="paper_05_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-07" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_05_1_field_1" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_1_branch_1" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_1_field_2" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_1_branch_2" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_1_field_3" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA 给出的是期望动作命令，真正运动还要经过控制器、传动和机械结构。摩擦、齿轮回差、关节柔顺性、重力补偿误差以及载荷、温度、磨损变化，会使 executed motion 偏离 commanded action。即使视觉目标选对、动作在理想机械臂上可行，末端仍可能抓不到物体或打不开抽屉。（论文第 1、4、5.3 节，图 1、5）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_1_branch_3" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1170.5" as="sourcePoint"/><mxPoint x="562" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_1_field_4" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;不重训整个 VLA、不改底层控制器，也不取得任务 reward 或成败标签，能否在部署中仅根据命令与本体感知到的实际运动差值，逐步学会提前补偿执行误差；同时建立可系统施加不同机械误差的评测。（第 1、3–4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_1_branch_4" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1603.0" as="sourcePoint"/><mxPoint x="562" y="1603.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_1_field_5" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练时 Domain Randomization 或 RobustVLA 提高对预设扰动的容忍度，但实际机器人误差随关节、姿态及近期运动历史变化；直接给末端命令加高斯噪声，不能复现特定关节的摩擦、回差或带载偏移。为每种磨损／载荷状态收集实体机器人训练数据也昂贵。（第 1–2、4 节）" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1821" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_1_branch_5" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2018.0" as="sourcePoint"/><mxPoint x="562" y="2018.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_1_field_6" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：看图、读指令并生成动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作）。真机关节没有照命令走时，研究运行中的自我补偿&lt;br&gt;核心问题：手臂实际走的距离与命令不同，又没有任务奖励时，能否用这个差别改进后续动作？&lt;br&gt;之前的问题：训练时加随机扰动，未必能模拟真机磨损、负载变化造成的具体关节偏差" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="2243" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_1_branch_6" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2475.0" as="sourcePoint"/><mxPoint x="562" y="2475.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_2_field_1" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_2_branch_1" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_2_field_2" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Domain Randomization：域随机化，训练时主动改变场景和物理条件以增加覆盖&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_2_branch_2" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_2_field_3" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;FP2 冻结基础策略、用力／力矩及本体历史驱动高频 force-position regulation，主要应对接触中的受力调节；本论文用命令—执行位姿／关节残差，在部署时更新 VLA 动作专家以预补偿机械跟踪误差。两者反馈、改动位置和评价任务都不同，不能归为同一种通用失败恢复。MemoryVLA 研究决策时的时间上下文；LT-Mem 维护世界状态历史；本论文适应机器人执行动力学。（第 2–5 节；相关主卡）" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_2_branch_3" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1205.5" as="sourcePoint"/><mxPoint x="1252" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_2_field_4" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：训练时加入扰动，让 VLA 提前见过误差；但现场误差可能不同&lt;br&gt;相关方向 2：运行时根据关节实际位置调整后续动作，能针对当前机器的偏差&lt;br&gt;代表工作：π0、π0.5、RobustVLA；比较原策略与训练期抗扰动的办法&lt;br&gt;区别：执行一段命令后测实际关节运动，用两者差别给动作模型提供在线修正信号" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_2_branch_4" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1732.5" as="sourcePoint"/><mxPoint x="1252" y="1732.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_1" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;在每次动作执行后比较“发出的命令”和“本体感知到的运动”，形成无需 reward 的自监督残差；把残差变成下一次策略应输出的伪目标，在线微调 VLA 动作专家上的小型 LoRA。模型以后生成的命令可预先抵消机械偏差。这是动作生成时的执行误差补偿，不是任务失败后选择恢复技能。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_1" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_2" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真中动作块每步是末端位姿增量。对齐尺度后，残差定义为 η_obs = Δx_executed − a_commanded；伪目标为 a_target = a_commanded − η_obs。LoRA 只加在 π0／π0.5 的 action expert，预训练权重与视觉语言骨干冻结；对伪目标使用 flow-matching 速度回归，并以 anchor loss 限制 LoRA 偏离初始化。已执行动作的伪目标进入在线 buffer，后续动作块才受更新影响，当前动作不能被事后改正。真机则按关节位置目标与测得关节状态计算残差。（第 3、5.1 节，式 1–3；附录 B.6）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_2" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_3" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;基础 VLA 使用图像、机器人本体状态和语言指令；在线更新另使用发出的动作命令与执行后的本体测量。仿真观察包括第三人称和腕部 RGB；真机 Piper 同样使用底座及腕部两路 RGB、关节状态与指令。无需额外任务成功标签或已知摩擦模型。（第 3、5.1 节；附录 B.3、B.6）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_3" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1356.0" as="sourcePoint"/><mxPoint x="1942" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_4" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 RoboStress 中输出末端位姿增量 Action Chunk，由机器人控制器转成关节执行；在 Piper 真机上输出绝对关节位置，残差和伪目标在关节空间计算。夹爪二值命令在仿真中不做连续残差修正。（第 3、5.1 节；附录 B.3、B.6）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_4" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1778.0" as="sourcePoint"/><mxPoint x="1942" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_5" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真中把本体位移与归一化动作放到同一尺度，并用 SO(3) 对数映射处理旋转。Domain Randomization 基线在训练时给末端命令加高斯扰动，RobustVLA 基线用对抗扰动；本方法不依赖这些训练时误差数据，而在执行时形成残差伪目标。（第 3、5.1 节；附录 B.3）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_5" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2200.0" as="sourcePoint"/><mxPoint x="1942" y="2200.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_6" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;π0 和 π0.5 作为两种 VLA backbone；分别在原任务数据上微调后，部署时给 action expert 加 rank-4 LoRA，Adam 学习率 10⁻⁶、anchor 权重 10⁻⁴。真机基础模型用每项任务 30 条示范微调 20,000 步、Action Chunk 长 50；每次执行 10 步后上传反馈，每收集 8 个反馈块调度一次异步更新。同一任务连续 25 次评测保留 LoRA／优化器／buffer，切换任务时重置；这意味着测得的是边评测边适应的成功率，并非完全独立的零样本单次测试。（第 5.1 节；附录 B.4、B.6）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2425" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_6" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2692.0" as="sourcePoint"/><mxPoint x="1942" y="2692.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_3_field_7" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：每次执行后比较“命令的动作”和“真正走出的动作”，量出执行残差&lt;br&gt;贡献 2：根据残差构造下次应多走或少走的目标，只微调动作生成部分来预先补偿&lt;br&gt;贡献 3：RoboStress 模拟七类关节机械误差，检查不同 VLA 遇到执行偏差时还能否完成任务&lt;br&gt;流程：模型发一段动作→读实际关节运动→算偏差→更新动作模型→下一段提前补偿" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2987" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_3_branch_7" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3236.5" as="sourcePoint"/><mxPoint x="1942" y="3236.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_1" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真用 LIBERO 四个 suite 的 40 项任务及原有示范；真机在两台 AgileX Piper 机械臂上，每台每项任务用遥操作采集 30 条示范，四项任务各自微调基础策略。在线阶段不另采“执行误差标签”：执行过程中的命令和关节／末端状态自身构成监督信号。（第 5.1、5.3 节；附录 B.6）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_1" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_2" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboStress 在 MuJoCo／LIBERO 控制管线对应物理位置注入四种关节级误差：低速显著的 Stribeck 摩擦、姿态／载荷相关的重力补偿残差、换向死区的 backlash、受力随历史变化的动态 compliance。组合为 Heavy Payload、两种 Thermal Drift、Aged Transmission、Aged Joint-Uniform／Shoulder／Elbow 共 7 种部署场景；噪声作用关节及持续时间各异，Clean 另列为对照。LIBERO 四套各 10 任务，每任务／场景 20 次；对比基础策略、训练期 Domain Randomization、RobustVLA 和本方法。（第 4、5.1 节，表 1–2；附录 A）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_2" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_3" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;这种仿真可覆盖真实硬件难以安全、重复制造的重载和老化条件，但模型与真实磨损仍不完全等同。（第 1、4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_3" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1349.0" as="sourcePoint"/><mxPoint x="2632" y="1349.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_4" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Robot A 为新 AgileX Piper，Robot B 已使用约一年；均为 6 关节＋平行夹爪。任务 1–3 从三个不同位置抓灰色碗并放到盘上，任务 4 打开柜顶抽屉；每任务／配置 25 次。论文测得两台机械臂的平均归一化命令—执行残差分别为 32.9%／35.0%。未见物体实验只在 Robot A、π0.5、任务 1 上进行：5 种训练示范未出现的碗／盘变体，各 5 次，共 25 次。（第 5.3 节、表 6、图 6；附录 B.6）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_4" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1799.0" as="sourcePoint"/><mxPoint x="2632" y="1799.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_5" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboStress：按七种误差场景平均、不计 Clean，π0.5 从 Base 49.1% 到本方法 56.6%（+7.5 个百分点），π0 从 41.7% 到 44.2%（+2.5 个百分点）；两种 backbone 均在七个场景逐项高于各自基线，但严重老化下绝对成功率仍低，例如 π0 的 Aged Joint-Uniform 为 24.0%。（表 2）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2059" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_5" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2273.5" as="sourcePoint"/><mxPoint x="2632" y="2273.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_6" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机：四任务平均成功率，Robot A 的 π0.5 43→76%、π0 40→72%；Robot B 的 π0.5 43→74%、π0 38→71%。因此“每台机械臂提升超过 30 个百分点”须按 backbone 分别理解，不能合并成一个未报告的总分。（表 6）未见碗／盘变体中，Robot A 的 π0.5 Base 16%、RobustVLA 36%、本方法 64%，样本为 25 次。（图 6）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2516" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_6" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2730.5" as="sourcePoint"/><mxPoint x="2632" y="2730.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_7" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;π0 的七场景平均：Base 41.7%；保留在线更新但去掉真实残差信号 40.8%；冻结策略、仅直接减去前一动作块平均残差 23.6%；完整方法 44.2%。这支持“残差提供信号，策略适应产生随观测改变的补偿”，但收益随误差类型不同：单一 compliance 场景仅 74.1→74.2%。真机任务 1 的 disturbance observer 单用 48→56%，与本方法联合 80%，本方法单用 84%，两者并非简单叠加。（第 5.2–5.3 节，表 3–5）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2973" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_7" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3222.5" as="sourcePoint"/><mxPoint x="2632" y="3222.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_4_field_8" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;图 5 中基础策略在碗抓取与抽屉开启示例中失败；RoboStress 的高强度磨损场景即使用自补偿仍会失败。论文并未展示系统能识别抓错物体、错误语义指令或错误子任务计划后自主重规划。（第 5.2–5.3 节、表 2、图 5）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="3500" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_4_branch_8" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3690.0" as="sourcePoint"/><mxPoint x="2632" y="3690.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_5_field_1" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；执行器误差随载荷和使用过程变化，主要场景并非外部移动物体&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：检测为命令—执行残差；粗粒度归因为机械跟踪偏差，未细分具体故障原因；没有任务级恢复技能选择，后续动作通过在线 LoRA 预补偿；后续残差可继续监督，原任务继续执行并从误差中更新策略，但未证明语义失败诊断与完整恢复" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_5_branch_1" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_5_field_2" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：未来可用外部传感器的运动估计，减少只依赖本体感知的限制；真机成功率提升并不构成人身环境中的安全保证。（第 6 节、伦理说明）本库分析：该方法针对可从命令—执行差值观测的机械误差；对象识别、语义理解、任务规划及完全不可行动作不在实验验证范围内。伪目标假设近期误差能指导后续动作，突然的大幅环境变化或几何失配仍需另行研究。（第 3–5 节）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_5_branch_2" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="899.0" as="sourcePoint"/><mxPoint x="3322" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_5_field_3" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对于普通夹爪 VLA，应把故障原因拆成“目标／计划不对”“命令正确但物理执行偏离”“接触后状态意外改变”。本论文直接提供第二类故障的自监督适应基线和 RoboStress 压力测试；若要研究完整 Failure Recovery，还需额外的错误检测、任务级状态判断及重规划，不能把成功率增益解释为这些能力已被解决。（第 3–6 节）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_5_branch_3" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1373.5" as="sourcePoint"/><mxPoint x="3322" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_05_5_field_4" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者的方法靠关节传感器估计实动；若传感器也有误差，补偿目标可能不准&lt;br&gt;我的理解 / 不足：它修的是“手臂没按命令走”；抓错物体或目标规划错仍需别的方法&lt;br&gt;未来展望：加入外部运动观测，检查更复杂误差下在线调整是否仍稳定&lt;br&gt;对我们项目的启发：先量命令与真实关节运动的差别；差别稳定可测时，再试在线补偿" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_05_5_branch_4" edge="1" parent="paper_05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1865.5" as="sourcePoint"/><mxPoint x="3322" y="1865.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
