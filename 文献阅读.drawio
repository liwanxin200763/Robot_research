            <mxGeometry x="120" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_91_bottomnav_1" label="返回分类" link="data:page/id,literature-page-data-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_91_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-90" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_91_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-92" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_91_1_field_1" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / arXiv preprint&lt;br&gt;引用量：待 Google Scholar 人工核验（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_1_branch_1" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_1_field_2" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2025&lt;br&gt;代码状态：官方代码与数据已公开；代码 CC BY-NC 4.0，与论文 CC BY 4.0 分开&lt;br&gt;查询与核验日期：2026-10-15&lt;br&gt;关联：机器人数据采集与数据质量 · 机器人遥操作与动作重定向" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_1_branch_2" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_1_field_3" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本信息与研究问题：研究方向：物理动作重定向、合成示范、跨本体与 Sim2Real。本卡依据 2026 年 9 月更新的 v3；首发年份为 2025，与摘要检索到的旧版数字分开记录&lt;br&gt;&lt;br&gt;基本信息与研究问题：Retargeting（动作重定向）把人或另一机器人动作变成目标机器人的控制。让指尖位置相似只能满足几何关系，未必能托住物体；接触、质量、摩擦和执行器都会影响运动。SPIDER 以人类动作为任务参照，通过物理模拟直接优化可执行控制序列（§1、3）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_1_branch_3" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1499.5" as="sourcePoint"/><mxPoint x="562" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_1_field_4" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本信息与研究问题：快速摘要：手物重建或动作数据 → 运动学初值 → 并行物理采样 → 接触约束和鲁棒化 → 控制轨迹／训练参考。它不需要为每条轨迹训练神经策略，但仍需机器人模型、碰撞网格和 GPU 模拟，不是低延迟在线遥操作器&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：在物理仿真中把人类手物动作变成多种机器人手示范&lt;br&gt;SPIDER 让候选手部动作经过接触仿真检验，减少只对齐指尖却拿不稳物体的问题&lt;br&gt;为什么重要 / 旧方法的不足：接触、质量、摩擦和执行器都会影响运动；SPIDER 以人类动作为任务参照，通过物理模拟直接优化可执行控制序列" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1812" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_1_branch_4" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2149.0" as="sourcePoint"/><mxPoint x="562" y="2149.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_2_field_1" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：逆运动学根据指尖目标求关节角度，快且便于换手，却可能让物体穿透或滑落。学习式映射需要预训练并受训练分布限制；ManipTrans、DexMachina 等逐轨迹强化学习能改善物理执行，但反复训练策略的计算成本大" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_2_branch_1" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_2_field_2" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_2_branch_2" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_2_field_3" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：SPIDER 在两者之间直接优化动作序列：不反向传播接触仿真，也不更新策略网络，而是模拟许多候选并按结果调整动作。它可替换视频学习管线中的动作转移模块，与后续模仿学习或强化学习互补。DexImit 的运动重建和规划仍需可用数据，不能仅因两者都用物理就视为同一机制（§2）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：动作重定向：把人手轨迹变成机器人手能执行的关节轨迹&lt;br&gt;逆运动学根据指尖目标求关节角度，快且便于换手，却可能让物体穿透或滑落" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_2_branch_3" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1482.0" as="sourcePoint"/><mxPoint x="1252" y="1482.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_3_field_1" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 准备可模拟的参照&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 准备可模拟的参照：输入机器人参考关节和基座运动、物体网格及位姿轨迹。视频实例用 Trellis 恢复网格、HaMeR 估计手形、FoundationPose 追踪物体；它们属于上游依赖，SPIDER 不保证任意严重遮挡视频都能正确重建（图 2、§4.3）&lt;br&gt;&lt;br&gt;1. 准备可模拟的参照：先用运动学映射初始化，再构建机器人—物体物理场景。优化目标同时衡量机器人姿态、物体运动偏离参照以及控制代价，约束含模拟动力学和动作范围。输出是关节位置等控制序列；物理可行只针对所建模型和相近起始状态（式 1）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_3_branch_1" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="442.0" as="sourcePoint"/><mxPoint x="1942" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_3_field_2" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 直接优化而不是先训练策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 直接优化而不是先训练策略：围绕当前动作序列采样高斯扰动，批量模拟，低代价候选获得更高权重，合成下一轮动作。退火采样逐渐缩小搜索范围：先探索不同接触，再细化稳定抓握；收益不足时提前停止（算法 1）&lt;br&gt;&lt;br&gt;2. 直接优化而不是先训练策略：机器人形态可以不同，但每种手仍需正确运动学、关节限制、碰撞和控制参数。框架兼容多本体不代表新增 DH116 时只改名称，也不代表生成的浮动手轨迹已经通过机械臂可达性检查&lt;br&gt;&lt;br&gt;3. 接触引导保留人的意图：物体能被拿起不代表抓法正确，采样可能用另一根手指或错误表面完成任务。SPIDER+C 在早期给目标手—物体接触点施加虚拟约束，逐渐放松，使求解从期望接触方式进入真实可行区域。接触标记可由运动学数据的模拟碰撞检测推导，错误参照也会产生错误引导（§3.3）" vertex="1">
          <mxGeometry height="779" width="628" x="1942" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_3_branch_2" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1161.5" as="sourcePoint"/><mxPoint x="1942" y="1161.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_3_field_3" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 扩增与鲁棒化&lt;/b&gt;&lt;br&gt;&lt;br&gt;4. 扩增与鲁棒化：改变物体位置、尺寸、网格或外力后重新优化，产生新轨迹。为改善模型误差，在有界摩擦、质量和接触参数批次上按最坏代价优化，而不是仅取平均表现。有限采样并不证明现实中所有扰动都能处理&lt;br&gt;&lt;br&gt;4. 扩增与鲁棒化：流程：人类数据 → 网格／手物轨迹 → 目标手初值 → 物理采样 → 有条件接触引导 → 参数扰动鲁棒化 → 对齐起始状态下回放，或用作闭环策略训练参考。后者才有机会根据现实偏差调整；轨迹生成中的修正不等于部署失败恢复" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1579" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_3_branch_3" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1863.5" as="sourcePoint"/><mxPoint x="1942" y="1863.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_4_field_1" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;v3 涉及多种手与人形机器人、MuJoCo Warp／Isaac Gym／Genesis。表 1 在同模拟器、数据、手型和奖励条件下分别比较 RL 参考；速度是单 L40S 的轨迹生成吞吐率，不是执行频率" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_4_branch_1" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="330.0" as="sourcePoint"/><mxPoint x="2632" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_4_field_2" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;OakInk／Inspire 上 SPIDER 的 ADD-AUC 为 22.3%，ManipTrans 为 19.4%，吞吐 2.5 对 0.1 帧／秒。Genesis／ARCTIC 为 43.6% 对 41.0%、1.5 对 0.05。ADD-AUC 把物体表面点误差阈值从 0 到 10 厘米积分，综合平移与旋转误差，不是整条任务成功率（第 8 页）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_4_branch_2" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="745.0" as="sourcePoint"/><mxPoint x="2632" y="745.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_4_field_3" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;同表中 MuJoCo 系列 OakInk 混合手型从运动学 11.0% 到 SPIDER 48.8%、加接触 56.9%；加入接触后吞吐从 6.1 降至 0.4，说明质量与计算有取舍。不要把不同平台行直接排名" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_4_branch_3" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1160.0" as="sourcePoint"/><mxPoint x="2632" y="1160.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_4_field_4" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据生成规模与筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;3,827 条源示范覆盖 213 个数据集内物体身份，四种手形成 15,308 个计划任务；15,041 个完成模拟的 rollout 均计入未筛选评估，包括失败抓握，平均 ADD-AUC 61.48%。按参照抬升、模拟抬升和末端位置误差筛选后，保留 6,520 条、191 个数据集内物体身份、1,291,575 帧、3.59 小时，ADD-AUC 为 78.30%（附录 A.4、表 7）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1378" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_4_branch_4" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1592.5" as="sourcePoint"/><mxPoint x="2632" y="1592.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_4_field_5" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据生成规模与筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据生成规模与筛选：这不是从 61.48% 提高到 78.30% 的独立测试增益，而是不同筛选分母。介绍中出现 6,532 的不一致写法，本卡以详细表 7 为准；仓库新闻的 7,876 条是另一发布快照，不混入 v3 实验。物体身份也未跨数据集全球去重&lt;br&gt;&lt;br&gt;数据生成规模与筛选：大规模生成是未连机械臂的浮动手，使用 L40S、固定 seed 0，单任务含预处理的中位时间约 220 秒。保存状态 100 Hz、参照 12.5 Hz 等与优化控制间隔不同，不当作真机实时能力（第 19–20 页）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1835" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_4_branch_5" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2119.5" as="sourcePoint"/><mxPoint x="2632" y="2119.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_4_field_6" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据生成规模与筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机为 Franka Panda＋Allegro，含单／双臂回放展示；手执行优化关节命令，臂用操作空间控制。未报告统一重复测试次数和成功率。另一仿真杯抓策略用 SPIDER 参照、七种子达到 0.99±0.01 的任务进度，对照 0.07±0.11；这是进度而非成功百分比（图 6、§4.3）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2432" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_4_branch_6" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2629.0" as="sourcePoint"/><mxPoint x="2632" y="2629.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_5_field_1" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确指出：感知误差、重遮挡和接触歧义会破坏结果；开环对齐初始状态以外容易失败；闭环策略蒸馏是未来工作。鲁棒化能容忍有限误差，不能在物体明显移位时自主找回（§4.5）&lt;br&gt;&lt;br&gt;不足与未来：本库分析：浮动手数据没有完整臂手可达性保证，源数据预处理和保留规则影响生成质量。代码及数据开放有利复现，但高维并行采样仍需显存；接触引导增加耗时，其标记质量需要单独评估&lt;br&gt;&lt;br&gt;不足与未来：对 D435i＋DH116，优先离线校正物体／指尖轨迹，再在已标定主动轴与耦合约束下比较纯运动学、物理修正和接触引导。先检验三指目标的穿透、越界、物体跟踪和模拟抬升；不要把其他手的五指指令直接映射为真机 raw 参数" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_5_branch_1" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="512.0" as="sourcePoint"/><mxPoint x="3322" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_91_5_field_2" parent="paper_91" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;可研究接触阶段不确定性、自适应选择采样预算、以及保留多种可行抓法的数据筛选，属于本库提出的方向。当前多轴控制未验收，臂手联动、真实摩擦辨识和闭环抓取须后续独立验证。官方实现／示例数据已确认，代码为 CC BY-NC 4.0，复用前需遵守非商业等条款" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_91_5_branch_2" edge="1" parent="paper_91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
