            <mxGeometry x="2160" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_80_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-81" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_80_1_field_1" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2023 / IEEE International Conference on Robotics and Automation (ICRA) 2023&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_1_branch_1" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_1_field_2" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：正式会议 ICRA 2023 由作者出版页核实；arXiv v1 发布于2022-10-12，本地PDF 10页。作者名、标题与首页一致" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_1_branch_2" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="829.0" as="sourcePoint"/><mxPoint x="562" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_1_field_3" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holo-Dex 研究如何让操作者看见机器人并稳定示教高维手内操作。Quest 2 多相机手跟踪输出人手关键点，混合现实呈现机器人视频，再以关节映射与拇指逆运动学控制 Allegro；记录真机图像和动作后用 BYOL 表征及近邻检索学习视觉策略。六任务中四项达到至少9/10，两种滑动拾取仅3/10；价值是把采集、反馈和小数据学习串成实物闭环，局限在触觉缺失与本体对应（§IV–VI）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_1_branch_3" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1356.0" as="sourcePoint"/><mxPoint x="562" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_1_field_4" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：用混合现实反馈采集灵巧手示范并训练视觉策略&lt;br&gt;Holo-Dex 让人看着机器人操作，再用少量记录的图像与动作训练近邻策略" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_1_branch_4" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1806.0" as="sourcePoint"/><mxPoint x="562" y="1806.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_2_field_1" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作与基本概念：DIME 用单 RGB 相机估二维指尖，遇到遮挡及深度歧义；DexPilot 用多 RGB-D 相机和定制跟踪降低遮挡，但标定与训练成本更高。Holo-Dex 借商用头显内部标定的四相机获得手姿，减少自建采集阵列，不是用头显画面直接生成机器人策略" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_2_branch_1" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_2_field_2" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Behavior Cloning：行为克隆，学习示范中观察到动作的对应关系" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_2_branch_2" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_2_field_3" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与基本概念&lt;/b&gt;&lt;br&gt;&lt;br&gt;Behavior Cloning 直接拟合观察到动作，少数据时会进入未见状态；VINN 将当前图像编码成特征，在示范库找近邻并执行对应动作，避免从很少样本拟合复杂动作函数。BYOL 是通过同图不同增强视图学习特征的自监督方法，不需要给每张图标物体位姿（§II–III）" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_2_branch_3" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1377.0" as="sourcePoint"/><mxPoint x="1252" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_2_field_4" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;近邻策略：遇到新画面时，从示范库找最相似的旧画面并参考其后续动作&lt;br&gt;DIME 用单 RGB 相机估二维指尖，遇到遮挡及深度歧义&lt;br&gt;Behavior Cloning（行为克隆）直接模仿记录中的观察和动作，少量示范容易让机器人进入训练时没见过的状态。VINN 改为先找当前画面最接近的示范画面，再参考那段示范的后续动作" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_2_branch_4" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1834.0" as="sourcePoint"/><mxPoint x="1252" y="1834.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_3_field_1" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 操作者—机器人视觉反馈&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quest 2 显示每眼1832×1920、刷新72 Hz，内建四个单色相机跟踪人手，位姿流72 Hz；机器人相机画面返回VR界面，操作者在里面查看手、物体和诊断面板。图2（PDF p.3）是实机视频与关键点控制回路，不是纯虚拟机器人训练" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_3_branch_1" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_3_field_2" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 重定向与低层控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;先从人手关键点求关节角，非拇指直接对应到 Allegro 关节；拇指因结构不同，改将人类拇指尖空间坐标映射到机器人拇指尖，再用逆运动学求关节角；Allegro 无小指，忽略人类小指。默认无需个体标定，但作者承认个体化拇指映射可改善效果，不能写成所有用户都无差别精确重现（§IV-C）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_3_branch_2" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_3_field_3" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 重定向与低层控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;重定向流60 Hz，ROS 异步通信，PD 加重力补偿以300 Hz 输出力矩；同一局域网测试延迟小于100 ms，视觉反馈60 Hz。72/60/300 Hz 分别属于跟踪、目标或反馈、底层控制，不是三个“端到端采集频率”。正文没有完整关节限位、碰撞检测、丢跟踪停机策略及滤波参数，复现时必须另核实，不补猜安全功能（§IV-D）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_3_branch_3" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1233.5" as="sourcePoint"/><mxPoint x="1942" y="1233.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_3_field_4" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 数据保存与近邻策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 数据保存与近邻策略：记录三台 RGB-D 观察、机器人状态和动作，但因带宽和数据量将落盘降为5 Hz。动作、相机与控制是异步的，直接回放检索到的原动作可能失配，作者改用检索示范的后续状态与当前状态之差来产生动作，跳步数对应记录时跳过的状态（§IV-E，p.5）&lt;br&gt;&lt;br&gt;3. 数据保存与近邻策略：训练 BYOL 编码示范图像，预先建立图像特征—状态—动作表；执行时编码当前画面、查最近邻、取后续目标并再次观察。属于视觉闭环检索，并没有奖励学习、仿真预训练或自主搜集失败恢复数据的阶段" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="1476" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_3_branch_4" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1778.0" as="sourcePoint"/><mxPoint x="1942" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_4_field_1" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务及数据规模&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务及数据规模：六任务为平面旋转、翻转、转罐、单手开瓶、滑卡拾取和滑便利贴；平面旋转120条，其余各30条。旋转/翻转须一分钟转90°，转罐30秒90°，开瓶180秒转盖360°；滑动拾取120秒内稳定拿起（§V-A，pp.5–6）&lt;br&gt;&lt;br&gt;任务及数据规模：表I比较熟练与五位新用户：熟练者平面旋转 DIME 60 s、Holo-Dex 30 s；翻转6→5 s；转罐15→10 s。开瓶新用户48 s，滑动两任务新用户未成功；不应将“新手四项成功”写成所有人所有任务都能零培训使用。头显399美元是论文年代报价，不是当前采购价" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_4_branch_1" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_4_field_2" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机学习结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机学习结果 / 表中逐项记录：任务：Planar Rotation；VINN 原物体：10/10；未见物体：35/50&lt;br&gt;&lt;br&gt;真机学习结果 / 表中逐项记录：任务：Object Flipping；VINN 原物体：9/10；未见物体：50/50&lt;br&gt;&lt;br&gt;真机学习结果 / 表中逐项记录：任务：Can Spinning；VINN 原物体：10/10；未见物体：45/50&lt;br&gt;&lt;br&gt;真机学习结果 / 表中逐项记录：任务：Bottle Opening；VINN 原物体：10/10；未见物体：未测&lt;br&gt;&lt;br&gt;真机学习结果 / 表中逐项记录：任务：Card / PostIt Sliding；VINN 原物体：各3/10；未见物体：未测" vertex="1">
          <mxGeometry height="709" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_4_branch_2" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1091.5" as="sourcePoint"/><mxPoint x="2632" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_4_field_3" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机学习结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机学习结果：表II（PDF p.6）中两种BC全为0/10。未见物体实验为每任务十个对象×五次，泛化范围集中在三项手内任务；不能扩展成开瓶与滑动也已验证泛化。作者将滑动低分归因于缺少触觉，属于解释而非独立触觉消融结论&lt;br&gt;&lt;br&gt;数据量分析的边界：图6（p.8）改变示范检索库大小时，保持使用全部任务数据训练的同一编码器，目的是隔离动作匹配与表征学习。因此转罐或开瓶“一条示范已高成功”不等于整套系统只看一条示范、只用一条图像数据训练" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1474" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_4_branch_3" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1758.5" as="sourcePoint"/><mxPoint x="2632" y="1758.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_4_field_4" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;比较协议还说明什么&lt;/b&gt;&lt;br&gt;&lt;br&gt;表I中的DIME耗时来自本文对六任务的对照，不应与DIME原论文的任务、物体和成功条件混为同一组记录。平面旋转额外采至120条，既为困难任务增加覆盖，也支撑数据量实验；这与其余任务各30条的设置不同。实验没有检验跨任务共享一个动作策略，因此编码器可迁移不能等同于所有任务共用同一控制器（§V-B/D/E）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2071" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_4_branch_4" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2285.5" as="sourcePoint"/><mxPoint x="2632" y="2285.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_5_field_1" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足、项目复用与未来：作者明确局限：精细滑动表现差，建议加触觉；关节映射依赖类似人手的结构，难以直接迁移其他形态；图5展示极薄、小物体及外观改变带来的失败（§VI，pp.7–8）&lt;br&gt;&lt;br&gt;不足、项目复用与未来：我的分析：近邻检索仍依赖示范覆盖，低频保存可能漏掉快速接触变化；视觉闭环能选动作但不保证掉落后恢复。头显无需自建外参不代表机器人手工作空间无需验证，且本文没有学习臂运动或双臂协调&lt;br&gt;&lt;br&gt;不足、项目复用与未来：D435i＋DH116最低验证：先离线录人手关键点，构建右手六主动轴、十一总DOF的受限映射，测试拇指、食指、中指姿态与日志；D435i可作外部观察，但不能替代 Quest 2 四相机跟踪而沿用其结论。当前整手/多轴运动锁定、根因未知，不进行多指或臂手联动" vertex="1">
          <mxGeometry height="779" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_5_branch_1" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="529.5" as="sourcePoint"/><mxPoint x="3322" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_80_5_field_2" parent="paper_80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整复现需 Quest 2 或等效SDK、Allegro、三视角RGB-D、ROS及训练计算机；原文未给可确认的完整GPU与训练时长预算。双臂扩展要新增腕位姿、臂规划及碰撞层，优先复用混合现实反馈设计与异步数据对齐思想" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_80_5_branch_2" edge="1" parent="paper_80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1137.0" as="sourcePoint"/><mxPoint x="3322" y="1137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
