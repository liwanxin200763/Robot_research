        <mxCell id="paper_52_4_field_3" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：论文报告在29项任务上较 RT-2-X 高16.5个百分点；模型和数据规模不同，说明整体系统更强，不能独立证明某一个编码器造成全部提升" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_4" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
