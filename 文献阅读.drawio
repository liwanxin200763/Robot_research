        <UserObject id="paper_144_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_144_bottomnav_1" label="返回分类" link="data:page/id,literature-page-data-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_144_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-102" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_144_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-75" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_144_1_field_1" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整题名 MILES: Making Imitation Learning Easy with Self-Supervision，可译为用自监督让模仿学习更容易。作者Georgios Papagiannis与Edward Johns来自伦敦帝国理工学院Robot Learning Lab。本地20页，含CoRL2024正文及补充方法、任务与伪代码；首次预印本和后续更新时间尚未核验，当前引用数也不报告。本文的一次示范是真实机器人遥操作示范，记录末端动作、腕部图像和力反馈；它不是只看一段普通人手视频便直接执行。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_1_branch_1" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="389.5" as="sourcePoint"/><mxPoint x="562" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_1_field_2" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景与具体问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;行为克隆只看一条成功轨迹时，机器人稍微偏离就会见到训练中没有的状态，误差继续积累，这叫协变量偏移。多次示范或人工纠正能覆盖偏差，但耗人力；强化学习能自主探索，却可能把物体推倒、掉落，需要不断人工复位。MILES沿单条示范逐步采集从附近扰动状态返回示范的轨迹，以自监督自动生成正确的纠偏动作标签，尽量只让人示范一次、复位一次，之后自主采集。目标是降低人工干预，不是取消真实机器人数据或所有工程设置。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_1_branch_2" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="916.5" as="sourcePoint"/><mxPoint x="562" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_2_field_1" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人方法的输入输出和不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;单示范回放直接重播已记录动作，初始物体略移就可能失败。位姿估计加回放先从图像估计机器人相对物体的偏差，移动到类似初态再播放，但位姿小误差仍会在长回放中累积。FISH及残差强化学习在示范基础上优化纠正动作，依靠奖励或相似度与随机探索；没有复位时环境一旦被破坏，后续探索可能不再有用。DAgger向专家查询偏离状态的正确动作，DART等通过扰动采集更鲁棒示范，但仍有人参与或额外假设。MILES利用机器人自己知道如何返回原路点这一事实，自生成局部纠正数据。" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_2_branch_1" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_2_field_2" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;关键假设：单物体、腕部视角和柔顺控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务要能以单个相关物体为中心表达，采集时腕部相机主要只看到该物体，多阶段任务需要组合多个这样的子策略。腕部相机固定在末端，动作也表达为末端坐标系相对位移，使不同世界位置下的局部视觉与动作关系可复用。可选力矩反馈帮助接触，阻抗控制让机器人碰到表面时具有柔顺性，而不是僵硬追踪。返回路点时真实碰撞可能改变路径，所以机器人实际走出的轨迹包含如何绕开接触和摩擦的经验；不能假设每条增强轨迹就是理想直线标签。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_2_branch_2" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="951.5" as="sourcePoint"/><mxPoint x="1252" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_3_field_1" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;原始示范与局部增强轨迹怎么采&lt;/b&gt;&lt;br&gt;&lt;br&gt;人提供一条示范，包含每步末端六自由度位姿、腕部RGB和力矩观察，以及夹爪状态和末端相对动作。人只复位一次，使重播示范能成功。机器人从第一个示范路点开始，先移动到其附近随机姿态，再尝试直线返回原路点，记录实际观察和相邻末端位姿变化作为监督动作；夹爪动作沿用该示范点。每个路点采若干条返回轨迹，再沿原示范推进到下一点。返回动作标签由本体测量自动得到，无需人逐帧标注，从而把单示范周围的偏差状态转成可学习的纠正样本。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_3_branch_1" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_3_field_2" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;有效性一：真正回到路点才可拼接&lt;/b&gt;&lt;br&gt;&lt;br&gt;增强轨迹必须在末端位姿上回到目标示范点，误差应在控制器可行精度内。若钥匙被摩擦卡住或碰撞使机器人到不了目标，即使几何上看接近也不能把之后的原示范直接接上。可达性由本体反馈检查，不合格轨迹丢弃，并可重新沿已知示范返回相关路点。该检验保证拼接的动作连续关系真实成立，区别于事后把任何状态都标成朝最近路点走的合成标签。它只检查到达既有路点，并不等于全局无碰撞规划或机械臂任意目标都可达。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_3_branch_2" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="951.5" as="sourcePoint"/><mxPoint x="1942" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_3_field_3" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;有效性二：环境没有改变才能继续用原示范&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人回到相同末端位姿时，物体可能已被推移或夹持物滑动，此时原示范的后续动作不一定有效。因此将返回后的RGB与示范该点图像提取DINO-ViT分块特征，计算对应块余弦相似度平均；低于θ=0.94判定环境扰动，停止采集。阈值先在RLBench模拟环境用已知复位条件确定，再沿用于真实任务。DINO比像素差更耐受光照和噪声，但相似度仍不是任务成功或接触稳定性的完美判断；细小变形、遮挡与视角变化都需要目标平台实测。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_3_branch_3" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1478.5" as="sourcePoint"/><mxPoint x="1942" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_3_field_4" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;拼接、行为克隆与记忆策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;每条有效返回轨迹连接其目标点之后的示范段，得到从偏离状态回到示范并沿示范继续的新轨迹。只保留到采集终止时刻R的有效部分。每任务单独训练ResNet18图像编码、力反馈MLP与LSTM动作策略；力编码100维，图像和力特征合并后用LSTM建模历史，行为克隆拟合六自由度相对动作和夹爪开闭。策略刻意不输入绝对本体位置，避免把固定世界坐标当捷径；本体数据用于采集和验证，却不作为训练输入。这种区分是空间泛化设计的重要部分。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_3_branch_4" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2005.5" as="sourcePoint"/><mxPoint x="1942" y="2005.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_3_field_5" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;部署：完整闭环或闭环前段加回放尾段&lt;/b&gt;&lt;br&gt;&lt;br&gt;如果采集覆盖全部示范，网络可全程根据新RGB与力反馈纠偏。如果在R点环境扰动导致提前终止，先用闭环网络到R，再回放剩下未学到的示范尾段。网络连续预测单位变换，即不再移动时，作为切换回放的信号。腕部视角有限，远距离接近先由无物体模型的相对位姿估计器把机器人带到物体附近，再切MILES。故本文不能统一描述成全任务都视觉闭环，也不能把一次复位理解为每次部署完全不需要初态准备。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2283" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_3_branch_5" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2532.5" as="sourcePoint"/><mxPoint x="1942" y="2532.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_4_field_1" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机、采集规模与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机为Franka Emika，腕部FLIR RGB相机，力矩由Panda关节力传感估计，采用阻抗控制。每示范路点采10条增强轨迹，随机扰动范围约4厘米和4度；范围依据初始位姿估计平均误差设定。7任务采集时间依次为钥匙锁24分钟、USB21分钟、插英式插头37分钟、插电源线28分钟、转玩具螺丝22分钟、面包入烤箱40分钟、开盒盖31分钟。一次示范只减少人工成本，仍需二三十分钟真实机器人自主运行和任务单独训练。本文没有D435i或DH116实验。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_4_branch_1" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_4_field_2" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果和受限对照条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;每任务20次测试，机器人与物体相对初态在物体周围20厘米球形范围随机化，要求目标仍在腕部视野内。MILES七任务成功90%、70%、85%、85%、85%、95%、100%，论文平均87%。位姿估计加回放平均71%，因此约提高16个百分点；原始回放6%、无复位残差RL7%、无复位FISH10%。RL对照被限制为单示范、相同观察预算、无人复位和六自由度动作，与原FISH常规设置不同，不能说MILES普遍胜过所有充分训练的RL。作者明确更多训练和允许复位会提高RL基线。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_4_branch_2" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="934.0" as="sourcePoint"/><mxPoint x="2632" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_4_field_3" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融说明哪些环节真正有用&lt;/b&gt;&lt;br&gt;&lt;br&gt;按随机顺序而非示范顺序采集，平均成功降到43%；不检测环境扰动降到47%，尤其拧螺丝、放面包、开盖三任务变0%；取消真实可达性、把动作重标为向最近路点移动，平均73%；去掉LSTM记忆为74%。这表明顺序采集、环境检查、实际返回路径和历史信息都在发挥作用。模态消融中只有力反馈几乎完全失败，因为自由空间力为零且接触力有歧义；只有视觉部分任务反而更好，说明力不是无条件增益。高容差开盖仅25%数据、约8分钟采集仍100%，低容差USB小于1毫米更依赖数据密度。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_4_branch_3" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1496.0" as="sourcePoint"/><mxPoint x="2632" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_4_field_4" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;回放边界、泛化与额外验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;拧螺丝、面包入烤箱、开盖采集因环境扰动提前停止，部署含回放尾段；钥匙任务因采集旋转时作用力过大，人工为保护硬件在90度旋转约中途停止，并按同样机制处理。这是正文自主描述的重要工程例外。新垃圾桶实验用5种桶训练，在2种新桶各10次测试为80%和60%，每桶约34分钟数据，并用DINO检索最相似桶的回放尾段；不是只在一个对象上一条示范训练便泛化所有桶。RLBench额外5任务仿真平均88%，与真机87%分开。多阶段面包任务通过先学抓取、再调用既有放入策略组合，没有报告统一大模型端到端多任务能力。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_4_branch_4" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2075.5" as="sourcePoint"/><mxPoint x="2632" y="2075.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_5_field_1" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;腕部相机让局部空间泛化更自然，却限制视野与大任务空间；采集前要人工保证相关物体为主要可见对象，未来可用分割减少布置要求；多对象情况下可能发生额外碰撞，外部相机辅助规划是未来方向；每任务单独训练，完全新任务泛化未清楚解决。还有一旦扰动过早发生，学到的闭环前段很短，后续更依赖回放，效果会更受初态误差影响。论文认为至少首路点有足够数据仍可工作，并非证明回放尾段风险消失。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_5_branch_1" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_144_5_field_2" parent="paper_144" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116、D435i与失败闭环的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;MILES适合当前项目把人手示范重定向后的成功机器人轨迹扩为局部纠偏数据，但原始人视频没有本体和控制标签，必须先完成安全可执行的机器人示范。D435i若固定在外部，视觉与末端相对动作的空间泛化关系不同于腕部FLIR；可考虑腕部安装RGB输入或显式目标裁剪，另测深度是否帮助扰动检测。DH116未必具备Franka等效阻抗与力估计，接触采集前应确认柔顺控制、力限和回退机制。最有价值的是保留实际返回轨迹、可达性与环境改变检测，分别记录未到路点、物体被推移、夹持滑动、网络停滞四类失败；把闭环与回放尾段成功率单独报告，避免把自主采集条件下的87%误写成所有步骤都闭环。" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_144_5_branch_2" edge="1" parent="paper_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="969.0" as="sourcePoint"/><mxPoint x="3322" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
