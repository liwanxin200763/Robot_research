        <mxCell id="paper_54_4_field_4" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：更长的交接8/20、篮子放置9/20、开锅放物7/20，明显低于简单倒水。背景等变化再测20次；不能只引用较高任务数字称真机普遍稳定" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
