        <mxCell id="paper_51_5_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：结论提出未来用真实手部状态和视觉物体位姿部署；当前依赖较准确状态与目标函数，真机感知与接触误差没有同等完整验证" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
