        <mxCell id="paper_51_4_field_4" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：多任务表平均70.7%，条件扩散58%；论文表格已给平均，此卡没有自行汇总。作者建议未来接入视觉估计物体状态和真实手部传感" vertex="1">
