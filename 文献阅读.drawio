            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_63_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#63 PEARS">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_63_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="04 执行误差与失败恢复  ·  本类第 12 / 16 篇  ·  用触觉条件化噪声空间强化学习纠正运动，以失败原因推理更新接触力范围；三项仿真和两项真机任务改善成功率，但定向推理仅覆盖力错误">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="2500" width="4000" x="140" y="450" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_title" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=16;editable=1;movable=1;resizable=1;shadow=0;" value="#63 PEARS" vertex="1">
          <mxGeometry height="140" width="480" y="30" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_63_title_branch" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="100" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_rise" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
