        <mxCell id="paper_92_4_header" parent="paper_92" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="D. 实验与结果" vertex="1">
          <mxGeometry height="78" width="650" x="2610" y="30" as="geometry"/>
