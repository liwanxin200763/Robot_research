        </UserObject><UserObject id="paper_126_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-132" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_126_1_field_1" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;AutoCGP: Closed-Loop Concept-Guided Policies from Unlabeled Demonstrations，本地28页PDF注明ICLR 2025，题名与canonical一致。正式来源为ICLR论文集；本文未给可用于确认首次arXiv月份的页边记录，本次不猜测首次提交和修订日期。作者隶属香港大学数据科学研究院及电机电子工程系、阿里达摩院/Hupan Lab、Transcengram。旧卡引用数5缺少时间点，本次未核验。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_1_branch_1" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_1_field_2" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pei Zhou、Ruizhe Liu、Qian Luo（共同一作）、Fan Wang、Yibing Song、Yanchao Yang；香港大学、阿里巴巴达摩院、Hupan Lab、Transcengram。代码/项目核验：https://github.com/PeiZhou26/AutoCGP（PDF官方链接；当前可运行性未核验）。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_1_branch_2" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="846.5" as="sourcePoint"/><mxPoint x="562" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_1_field_3" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景与目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;同样的抓取、搬运、拉抽屉会出现在不同长任务，但按人的自然语言手工标注技能既贵，也可能与机器人真正的运动差别不符。本文希望从没有技能名称或分段标签的机器人示范中，自动找出可复用的运动概念，再让策略在执行中根据视觉和当前状态持续选择概念。无标签指缺少人工概念/技能标签，示范仍包含状态、图像与动作监督，不能称完全无监督控制。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_1_branch_3" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1321.0" as="sourcePoint"/><mxPoint x="562" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_2_field_1" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关机制的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;BeT、VQ-BeT将动作离散化，主要为了表达多峰动作并减小连续输出噪声；这里的概念希望覆盖更高层、持续多个时刻的运动片段。InfoCon用状态变化的生成/判别信息发现概念，XSkill从视频中学技能表征，AWE按轨迹可线性插值程度抽关键点。AutoCGP先从本体感觉里提炼片段，再用这些片段指导扩散策略，并且把概念选择器与动作预测一起优化。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_2_branch_1" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_2_field_2" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语与闭环含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;本体感觉是机器人自身的位置、姿态和夹爪开合状态，不是外部摄像头图像。码本是一组可学习的有限向量，相似运动分到同一编号；编号不天然等于人类说的“抓”“推”。闭环意味着概念随新观测更新，而非先生成一串技能名称后一直盲目执行。扩散策略则从随机动作噪声反复去噪，表达同一场景下多种合理动作。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_2_branch_2" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_1" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入与总体训练顺序&lt;/b&gt;&lt;br&gt;&lt;br&gt;示范轨迹由每时刻本体状态s、图像o和动作a组成。第一阶段将不同任务混在一起，不提供任务类别，从本体状态序列训练自动概念发现模块；第二阶段将学到的概念编号加回所有示范，构成带自生成标签的数据；最后针对各任务训练概念选择Transformer和概念条件动作策略。概念发现阶段与控制阶段输入不同：后者仍需视觉来确定物体和场景关系。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_1" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_2" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：离散概念分配&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer编码每时刻本体状态及轨迹上下文，产生连续特征；VQ-VAE在30项码本里寻找最近向量，给该时刻一个概念编号。相邻同编号形成片段，编号变化确定片段边界。直通梯度让离散选择后仍能更新前面的编码器，量化与承诺损失维持特征和码本的配合。仅做聚类容易得到随意或过粗的片段，所以另加三个与目标相关的训练约束。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_2" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_3" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：目标状态检测GD&lt;/b&gt;&lt;br&gt;&lt;br&gt;在当前分配下，向前寻找最近的概念切换时刻，把切换前状态当作这一概念片段的目标。网络G输入当前状态和概念，预测该结束状态，再用预测误差训练概念编码器与码本。作用是让同一概念确实对应一段可预期的局部目的，而不是只把邻近时间点贴同一标签。目标是由当前分段自生成的，所以不是人工提供的成功状态。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_3" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1338.5" as="sourcePoint"/><mxPoint x="1942" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_4" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：目标评估GE&lt;/b&gt;&lt;br&gt;&lt;br&gt;值函数V输入当前本体状态、候选目标和概念，输出相容性分数。属于同概念且指向相同片段目标的组合为正例，其余为负例，二分类损失要求它区分概念是否匹配。作者又约束V对当前状态的梯度：将该梯度与当前状态输入网络Π，预测相邻状态之差，使分数变化方向与真实运动进展有关。这里的值函数服务于表征发现，并不是在线强化学习的回报估计器。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_4" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1813.0" as="sourcePoint"/><mxPoint x="1942" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_5" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：目标巩固GC与自标注&lt;/b&gt;&lt;br&gt;&lt;br&gt;重建网络R把概念向量序列还原成本体状态序列，鼓励同编号覆盖的运动具有一致性。GD、GE的相容性和进度项、GC及VQ损失共同训练，权重不同，避免某一约束独占。训练好后编码器为所有示范逐帧分配编号。图示里相同编号在不同任务出现类似接近或放置运动，但不同初始位置下同一个语言阶段也可能被拆成不同概念组合，不能假定每种自然语言技能唯一对应一个码。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_5" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2305.0" as="sourcePoint"/><mxPoint x="1942" y="2305.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_6" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：概念选择与扩散动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;CST根据历史图像、本体状态预测概念概率，以自标注编号的交叉熵监督。CGP采用U-Net扩散策略，两幅图像分别经过ResNet-18，再与本体状态及概念条件结合，通过FiLM注入去噪块。实际使用整个概念概率分布，避免只取最大编号阻断动作损失的反传；噪声预测损失与概念分类损失联合优化，使选择器既贴近已发现概念，也考虑执行效果。推理随新观测重新估计分布并生成动作块，因此可以改变概念。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_6" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2814.5" as="sourcePoint"/><mxPoint x="1942" y="2814.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_3_field_7" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;损失的物理含义补充&lt;/b&gt;&lt;br&gt;&lt;br&gt;三个发现约束分别回答“这段要到哪里”“当前状态与该目标是否匹配、是否在推进”“同一编号能否重现相似本体运动”。若只靠时间邻近，容易按示范长度切片；加入目标与运动预测，才把分段与可执行动作联系起来。不过这些监督仍从已有示范派生，无法凭空发现示范未覆盖的接触技能。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="3092" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_3_branch_7" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3306.5" as="sourcePoint"/><mxPoint x="1942" y="3306.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_4_field_1" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、任务、传感器与训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要控制实验在Robosuite/MimicGen仿真，六类为Coffee、Hammer Cleanup、Stack Three、Three Piece Assembly、Threading、Mug Cleanup，并含D0/D1/D2不同初始变化范围。每任务及相应变体使用950条示范；发现阶段只混合每类最大变化等级的950条，之后给所有变体标注。控制输入为前视和腕视各112×112 RGB加9维本体状态，历史4步、预测动作8步。未报告力触觉策略输入。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_4_branch_1" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_4_field_2" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;量化结果与分母&lt;/b&gt;&lt;br&gt;&lt;br&gt;每项变体以固定随机种子初始化50个测试episode，每次最多600步。Coffee D2本文72%即36/50，DP为40%即20/50，提升32个百分点；Mug D1本文50%即25/50，DP28%即14/50；Three Piece D2只有4%即2/50，DP为0/50，显示最难变体仍几乎失败。Hammer D0本文和DP均100%，Threading D1本文和DP均28%，不能概括为每个格子都严格更优。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_4_branch_2" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="899.0" as="sourcePoint"/><mxPoint x="2632" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_4_field_3" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对照与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;除普通DP、BeT，还把InfoCon、XSkill、AWE的概念接到同类DP控制器上，较直接检验概念发现的价值。Coffee D2完整模型72%，去GD为58%、去GE为58%、去GC为60%，均为50次测试口径。附录把概念发现输入由本体感觉换成图像，Coffee D2从72%降至64%，Mug D1从50%降至40%。这支持当前实现偏好本体感觉，并不证明所有视觉概念发现都不如状态。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_4_branch_3" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_4_field_4" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成本、可解释性与实物证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;概念发现训练4000 epoch，序列补齐440、批量16，单RTX 3090约1.5天；每项CST/CGP联合训练100 epoch、批量150，单RTX 4090不到一天。附录用BridgeData V2真实数据、10项码本展示接近/开合/放置等概念，但没有真实机器人执行成功率，不能把真实数据可视化写成真机控制验证。概念一致性主要靠轨迹PCA和画面观察，没有充分独立的语义一致性指标。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_4_branch_4" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1883.0" as="sourcePoint"/><mxPoint x="2632" y="1883.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_5_field_1" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限与未来工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出码本结构预先限定概念最大数量，未验证人形等复杂形态；未来需要结合视觉及其他模态，建立更可靠的概念一致性评价，并探索learning-from-play。作者承认成功率可能受某种概念与特定控制器匹配程度影响，不能独立、公平地评价概念本身。因而任务成功改善不自动证明发现的是普适人类技能。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_5_branch_1" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_5_field_2" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;对DH116可先从关节角、速度、指尖相对位置和接触变化中发现可复用片段，避免直接把平行夹爪开合状态映射到多指抓型。但码本可能把相同手指运动、不同受力状态归为同类，建议加入触觉或稳定接触条件，并把“外观相似”“运动相似”“目标功能相同”分开评价。视觉可以承担场景目标识别，本体/触觉承担接触阶段判断。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_5_branch_2" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="811.5" as="sourcePoint"/><mxPoint x="3322" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_126_5_field_3" parent="paper_126" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Sim2Real与验证路径分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文控制成绩来自仿真，不能据此声称自动概念本身可跨仿真真实迁移。可设计相同任务在仿真和真机的概念分布对比，检查传感噪声是否造成频繁切换，再比较硬编号和概率分布条件，报告失败恢复和动作延迟。对多指长任务应先验证片段边界是否对应真实接触变化，再扩展到多任务复用。上述均为拟议验证，不是本论文已实现的能力。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_126_5_branch_3" edge="1" parent="paper_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1268.5" as="sourcePoint"/><mxPoint x="3322" y="1268.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
