        </UserObject><UserObject id="paper_141_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-135" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_141_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-142" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_141_1_field_1" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整题名 3D Diffuser Actor: Policy Diffusion with 3D Scene Representations，中文可译为三维扩散动作策略：结合三维场景表示的策略扩散。本地26页含正文和详细附录，首页明确CoRL2024，作者来自卡内基梅隆大学。预印本首发年月与后续更新未在本次核验，会议年份不等于首次公开时间；引用量也未实时查询。项目入口由正文明确给出。本文中的Actor是动作策略网络，没有同时训练价值函数或以在线奖励强化学习的含义。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_1_branch_1" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="389.5" as="sourcePoint"/><mxPoint x="562" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_1_field_2" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;问题：空间理解与多模态动作同时重要&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一机器人状态下可以有多种合理动作，例如抓不同葡萄、向不同孔插入或以不同顺序叠杯。确定性回归可能把不同模式平均，得到不可用动作。扩散策略能学习多峰动作分布，但二维图像条件还要隐式学会像素与三维动作的对应。本文将带空间位置的场景token与生成动作放在同一个三维坐标系，让策略既理解物体相对位置，也保留多种行为。研究主要为单臂多任务操作，不应因其在后续双臂论文中被用作对照就称原作是双臂方法。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_1_branch_2" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="916.5" as="sourcePoint"/><mxPoint x="562" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_2_field_1" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;三维策略与扩散策略的已有机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;PerAct将RGB-D反投影为体素，分类下一个夹爪关键点；分辨率越高体素成本越大。Act3D用三维视觉特征和多轮采样的虚拟点，分类哪个采样点最接近目标，再回归旋转。Diffusion Policy输入二维图像或低维状态，从噪声恢复动作块，适合动作多样性。ChainedDiffuser先由Act3D给定目标关键点，再用扩散生成连接轨迹，关键点预测本身仍是另一模型。本文直接生成关键点及必要连接轨迹，目标不必由外部预测器提供。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_2_branch_1" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_2_field_2" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与DP3的关键区别及比较边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;同期DP3也结合点云和扩散，但把点云池化为整体向量，局部场景改变可能影响全局特征。本文保留多个带位置的三维token，让动作与附近物体进行局部注意力交互。作者在CALVIN给DP3额外加语言条件后比较，所以结果属于该重实现和多任务设置，并不等于原始DP3在全部单任务设置的性能。附录另做叠杯单任务对照，给出本文80%、DP3 8%，也只对应100条示范、25条测试这一任务。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_2_branch_2" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="899.0" as="sourcePoint"/><mxPoint x="1252" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_3_field_1" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入、三维抬升与动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入是一个或多个已标定RGB-D视角、任务语言和机器人末端本体状态。每视角用预训练CLIP ResNet50提取二维特征块，按块内平均深度和相机内外参把块中心反投影为三维点；每个场景token同时带视觉特征和世界坐标，多视角集合合并。当前末端也是一个带位置的本体token，语言经CLIP文本编码，但不强行为单词分配三维坐标。动作由三维位置、6维旋转表示和二值夹爪开闭组成；6维旋转避免某些旋转参数化的断点，位置与旋转轨迹一起生成。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_3_branch_1" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_3_field_2" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;三维相对去噪Transformer如何纠正轨迹&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练给专家末端位置和旋转序列加高斯噪声，每个噪声位姿经MLP变为轨迹token，并以当前带噪位置作为其三维坐标。去噪Transformer让轨迹、视觉和本体token通过三维相对注意力交互，注意力依赖点间位移而不是绝对坐标；整个场景平移时相对关系保持，利于位置泛化。语言用普通交叉注意力注入，CALVIN额外增加语言融合层。视觉token用最远点采样减少计算，随后动作token在场景条件下逐步修正位置与旋转误差，直至从噪声得到可执行目标。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_3_branch_2" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="969.0" as="sourcePoint"/><mxPoint x="1942" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_3_field_3" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;损失和噪声日程分别承担什么&lt;/b&gt;&lt;br&gt;&lt;br&gt;位置和旋转分别用L1监督预测的添加噪声，夹爪开闭用二元交叉熵监督，最终采样结束使用开闭输出。附录损失权重位置30、旋转10；分量权重平衡尺度不同的误差，避免旋转或位置一方支配训练。位置采用scaled-linear噪声日程，旋转用squared-cosine日程，改变不同去噪阶段的信噪比；不同几何量使用不同日程是经验结果，不是保证全任务最优的定理。附录最后一段日程文字有表述冲突，采用正文、表8和图7的明确设置，不按含糊一句改变实现。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_3_branch_3" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1513.5" as="sourcePoint"/><mxPoint x="1942" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_3_field_4" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;关键姿态切分与两种执行方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练按夹爪开闭改变或速度、加速度显著变化切分示范，将每段重采样为固定长度。模型可预测到下一关键点的整段轨迹，也可仅预测关键点，由采样运动规划器到达。RLBench和真机实验实际采用后者，使用BiRRT；CALVIN无运动规划器，必须预测并执行位姿轨迹，通常每段约6步，每任务最多60次推理以控制总动作预算。因而本文的能力不应统一描述成始终连续密集控制：关键点加规划器与轨迹预测是不同设置。每段之后重取观察可形成分段反馈，段内没有触觉闭环或自动失败恢复机制。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_3_branch_4" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2058.0" as="sourcePoint"/><mxPoint x="1942" y="2058.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_4_field_1" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;RLBench与消融结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;RLBench基于CoppeliaSim和Franka Panda，多视角设置18任务，四RGB-D相机位于前方、腕部和双肩；单视角设置10任务、仅前视图。多视角平均成功率本文81.3%、Act3D63.2%、RVT62.9%、PerAct49.4%，对Act3D提高18.1个百分点；单视角本文78.4%、Act3D65.3%，提高13.1个百分点。多视角去三维表示的2D Diffuser Actor为47%，保留三维但去相对注意力为71.3%，完整81.3%，说明三维与相对关系均有贡献。叠杯47.2%、挂杯24%等仍低于整体均值，不能说精细长任务全部解决。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_4_branch_1" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_4_field_2" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;CALVIN泛化与训练条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;CALVIN基于PyBullet，34技能、4环境，使用A/B/C训练、未见D测试，指标为最多连续完成5条语言指令的数量和平均链长。本文平均3.35±0.04，GR1为3.06，按(3.35−3.06)/3.06约相对提高9.5%，摘要称9%相对提升；这不是9个百分点成功率。完成完整5任务链概率41.2%。模型只用语言标注子集，而部分对照用全部play数据，应保留该训练来源差别。附录RLBench参数3.6M、100扩散步；CALVIN9.6M、25扩散步，学习率分别1e-4与3e-4，设置不同，不能用一个统一频率概括所有实验。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_4_branch_2" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_4_field_3" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机规模、传感器和计算成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机为Franka Emika配前视Azure Kinect RGB-D，原始1280×720降为256×256，MoveIt的BiRRT执行目标位姿。12任务每任务15条示范、10次测试；关盒、放鸭、竖直插孔、水平插环、放鼠标、开笔帽、按订书机、放葡萄、矩形排序、叠块、叠杯、三角摆块成功率依次100%、100%、50%、30%、80%、100%、90%、90%、50%、20%、40%、90%。小规模真实结果体现不同任务难度，不能把仿真81.3%当真机平均。在2080Ti的CALVIN条件下本文推理600毫秒，ChainedDiffuser1170毫秒、DP3 581毫秒，说明几何优势并没有免费带来实时高频控制。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_4_branch_3" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1548.5" as="sourcePoint"/><mxPoint x="2632" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_4_field_4" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;深度噪声与失败分类&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录单视角测试给每像素三维位置加高斯噪声，表头参数标为σ=0、0.01、0.03时平均78.4%、72.4%、50.1%，每任务25回合、3种子。正文把该数称variance，表头又用σ，单位和方差/标准差含义不够一致，应只按作者设置标签记录，不能据此承诺1厘米测量噪声下的实际性能。作者将失败分为位姿不够精确、语言理解错误、中间子任务失败、规划器找不到路径；前两类是主要来源。接近正确物体但最后几厘米抓偏，与抓错语言指定物体，需要不同修复。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1861" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_4_branch_4" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2128.0" as="sourcePoint"/><mxPoint x="2632" y="2128.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_5_field_1" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限与复现警告&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确需要相机标定和深度；实验任务准静态，快速动态和速度控制待研究；扩散比非扩散策略慢。附录提出更多多样数据、加强目标语言识别、把长任务拆为子任务，以及必要时用预测轨迹替代规划器。附录关键点发现代码存在拼写和变量名问题，如moition_changed，不应把论文中的伪代码当作已测试可直接执行代码。需要保留真实失败和规划失败，而不是只报告网络预测位置准确。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_5_branch_1" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_141_5_field_2" parent="paper_141" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116与D435i的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;对当前平台最有价值的是把D435i视觉特征反投影到机器人公共三维坐标，让末端目标与物体处于同一空间，再用局部token避免全局池化丢细节。D435i与Azure Kinect的噪声、盲区和反光表现不同，必须单独标定并测深度孔洞、尺度和延迟；本文噪声实验不足以代替实测。人手视频可提供关键姿态结构，但原作训练来自机器人示范，尚需重定向和接触验证。DH116双臂可扩展为双末端token与联合或解耦动作，属于新增设计。应先核对单臂定位与抓持，再测双臂避碰和等待，给600毫秒量级推理配失败检测、重抓与安全执行预算。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_141_5_branch_2" edge="1" parent="paper_141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
