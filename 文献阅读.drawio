          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_4_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
