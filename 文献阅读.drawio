        <UserObject id="paper_99_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_99_bottomnav_1" label="返回分类" link="data:page/id,literature-page-data-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_99_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-98" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_99_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-100" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_99_1_field_1" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL&lt;br&gt;引用量：198（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作&lt;br&gt;数据链条位置：移动底座与双臂的全身遥操作采集" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_1_branch_1" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_1_field_2" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;移动让双臂数据更难收集：机器人要从冰箱取物或开柜放锅时，底座移动会改变两臂的可达范围，手抓住把手后移动底座还会影响接触。Mobile ALOHA 把固定双臂 ALOHA 扩展为移动全身遥操作系统，让人一边带动底座一边控制双臂，并研究固定平台已有示范能否帮助新的移动任务" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_1_branch_2" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_2_field_1" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;固定双臂示范与移动操作的联系：固定台面数据能教会抓、放和精细对齐，但没有记录底座应何时前进后退。直接只学少量移动示范又容易缺少精细手部动作覆盖。本文把移动示范与固定 ALOHA 示范共同训练，问两者是否能互相补充；不是把静态数据补一个零速度字段就保证所有移动任务可迁移" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_2_branch_1" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_2_field_2" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_2_branch_2" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="997.0" as="sourcePoint"/><mxPoint x="1252" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_2_field_3" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;全身遥操作里的全身指移动底座和双臂共同参与，不是已经具备人形机器人的腿部平衡能力。操作者通过身体与平台的物理连接带动底座，双手控制主臂；这种接口让运动自然协调，却也意味着采集场景、人体工学和机械结构会影响示范分布，不能只比较模型而忽略采集方式" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_2_branch_3" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1412.0" as="sourcePoint"/><mxPoint x="1252" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_3_field_1" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入、采集与动作接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入、采集与动作接口：在 ALOHA 双臂装置下增加轮式底座，操作者通过身体带动系统移动，同时手动操作两个主臂；记录相机、机器人状态、双臂关节目标及底座运动。策略把双臂动作与底座命令一起预测，避免一个独立导航器与另一个操作器在抓持期间互相冲突&lt;br&gt;&lt;br&gt;共同训练为什么可能有效：使用 ACT 等模仿学习模型预测一段未来动作，再持续观察纠正；将少量移动任务示范和既有固定双臂数据混合。固定数据提供精细接触先验，移动数据教模型底座与手臂的配合。动作块减少逐步决策误差，但轮滑和接触仍使开环回放不可靠，因此不能只回放一次人工路径替代视觉闭环" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_3_branch_1" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_3_field_2" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：相机视角必须让策略既看见手边目标，也知道基座移动后的相对位置。两臂关节与底座速度作为联合动作输出，固定数据中的底座不动与移动数据中的底座运动要在训练接口里一致表达。共同训练没有要求固定数据包含新任务完整路径，而是让已有局部操作能力帮助目标移动技能&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_3_branch_2" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1144.0" as="sourcePoint"/><mxPoint x="1942" y="1144.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_4_field_1" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机任务与数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;CoRL 2024 原文系统当时成本约 3.2 万美元，包含电源与计算；不是当前采购报价。七项真实任务涉及擦酒渍、呼叫并进入电梯、柜中放锅、击掌、冲洗锅、推椅和烹虾，通常每任务 50 条示范，击掌和烹虾为 20 条" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_4_branch_1" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="330.0" as="sourcePoint"/><mxPoint x="2632" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_4_field_2" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;结果及正确分母&lt;/b&gt;&lt;br&gt;&lt;br&gt;共同训练后整任务成功率：擦酒渍 95%、电梯 95%、放锅 85%、击掌 85%、冲锅 80%、推椅 80%，这些评估通常每项 20 次；烹虾 40%，只评 5 次。表 1 子步骤成功率的分母是到达该阶段的尝试数，不能把它当整回合成功率。消融比较共同训练与仅移动数据，并比较 ACT、Diffusion Policy 和 VINN，不是所有任务都受同幅提升" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_4_branch_2" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="762.5" as="sourcePoint"/><mxPoint x="2632" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_4_field_3" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：开柜放锅要求两手拉把手时底座后退，属于真正的全身协调；按电梯按钮和开水龙头则检验小目标对齐。烹虾动作长、软物接触变化大，成绩明显较低。将这些任务分开分析，才能判断失败来自移动定位、视觉对齐还是接触操作，不能将七任务平均视为同一种难度&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_4_branch_3" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1342.0" as="sourcePoint"/><mxPoint x="2632" y="1342.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_5_field_1" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对双臂项目怎样借鉴&lt;/b&gt;&lt;br&gt;&lt;br&gt;对双臂项目怎样借鉴：较好的结果依赖相近任务、可见场景和人工采集，长时烹虾仍暴露感知与动作累积误差。固定双臂项目可先借鉴联合记录两臂、任务阶段与成功条件，以及旧任务数据辅助新技能的预算对照；若以后增加底座，需要重新定义坐标、同步和全身碰撞约束，不能只沿用固定台面标定&lt;br&gt;&lt;br&gt;把关键设计与实验读透：复用静态数据时，应保留采集来源，单独检查新任务的关键状态是否被覆盖。若旧数据只有抓放而新任务需要开盖或长期持物，它可能只提供感知帮助，不能替代缺失的动作示范。可以先固定目标任务数据数目，逐步增加相关与不相关静态子集，看成功率和失败类型是否一起改变" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_5_branch_1" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="477.0" as="sourcePoint"/><mxPoint x="3322" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_99_5_field_2" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_99_5_branch_2" edge="1" parent="paper_99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1039.0" as="sourcePoint"/><mxPoint x="3322" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
