          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_52_authors" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Moo Jin Kim、Karl Pertsch、Siddharth Karamcheti、Ted Xiao、Ashwin Balakrishna、Suraj Nair、Rafael Rafailov、Ethan Foster、Pannag Sanketi、Quan Vuong、Thomas Kollar、Benjamin Burchfiel、Russ Tedrake、Dorsa Sadigh、Sergey Levine、Percy Liang、Chelsea Finn" vertex="1">
          <mxGeometry height="429" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_52_pdf" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;01_VLA\&lt;br&gt;OpenVLA.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1055" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_52_code" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;OpenVLA - An Open-Source Vision-L&lt;br&gt;anguage-Action Model.md&lt;br&gt;&lt;br&gt;开源信息：官方 GitHub" vertex="1">
          <mxGeometry height="499" width="480" y="1512" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_52_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_52_bottomnav_1" label="返回分类" link="data:page/id,literature-page-07" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_52_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-20" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_52_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-53" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_52_1_field_1" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL 2024&lt;br&gt;引用量：4229（沿用本地记录，未重新查询）&lt;br&gt;研究方向：07 VLA 基础与泛化" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_1_branch_1" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_1_field_2" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配&lt;br&gt;&lt;br&gt;研究背景：机器人模仿学习通常依赖特定机器、场景和任务的示范，面对新物体、干扰物和新语言指令时容易退化。互联网预训练 VLM 有较强的视觉与语义先验，但此前的大型 VLA 多为闭源，难以复现或微调到新机器人。（论文第 1 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_1_branch_2" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_1_field_3" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：建立可公开使用、能跨机器人直接执行且能用少量示范适配新任务的 VLA，并明确训练数据、动作接口和计算成本。（第 1、4 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：RT-2-X 的模型、数据配方和适配流程不公开；Octo 等通用策略可以迁移，却没有直接把成熟 VLM 的视觉—语言能力作为整个动作模型的可训练主干。任务窄时，单纯扩大 VLA 也未必优于专门训练的连续动作策略。（第 2、4.2 节）" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_1_branch_3" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1447.0" as="sourcePoint"/><mxPoint x="562" y="1447.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_1_field_4" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：开源 VLA（视觉—语言—动作模型）。它把相机画面和语言任务直接变成机器人动作；为多篇后续记忆、纠错与三维改进提供共同基线&lt;br&gt;核心研究问题：如何用已有视觉语言理解和大量机器人示范，得到可以复现、可以换任务微调的通用机器人控制模型，而非只能调用闭源接口？&lt;br&gt;之前方法的问题：小任务策略语言理解有限；大闭源模型难复现或适配。不同机器人数据动作不一致，还要解决训练、清洗与下游低成本适配" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_1_branch_4" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2009.0" as="sourcePoint"/><mxPoint x="562" y="2009.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_2_field_1" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_2_branch_1" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_2_field_2" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_2_branch_2" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="780.0" as="sourcePoint"/><mxPoint x="1252" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_2_field_3" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;Octo提供开放的跨机器人策略及数据混合参照；OpenVLA 进一步用完整预训练 VLM 直接预测动作 token。Open X-Embodiment提供核心示范来源。与 RT-2-X 的比较同时变化了模型大小、数据量和预处理，不能将全部收益归于单一视觉模块。（第 2–4 节；附录 F）" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_2_branch_3" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1237.0" as="sourcePoint"/><mxPoint x="1252" y="1237.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_2_field_4" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：VLM（视觉语言模型）能理解图文，但没有机器人动作接口。机器人行为克隆用示范训练控制，两者结合才成为 VLA&lt;br&gt;相关方向 2：多机器人数据提供不同任务经验；动作需统一成末端位置/姿态变化和夹爪开合。数据质量与采样权重会影响模型能否学到正确动作&lt;br&gt;代表工作：RT-2-X 是相关大模型基线，Octo 是通用机器人策略，Diffusion Policy（扩散策略，从噪声逐步生成连续动作） 是扩散动作策略。OpenVLA 提供公开权重、代码及目标任务适配实验&lt;br&gt;与已有方法的区别：用通用视觉语言骨干预测离散动作符号，再转回连续控制。它原版是单图、逐步动作接口，后来的历史/动作段能力不能倒算进原版贡献" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_2_branch_4" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1799.0" as="sourcePoint"/><mxPoint x="1252" y="1799.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_1" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;以 Prismatic-7B VLM 为起点，将连续机器人动作逐维量化为语言模型可输出的 token；用多样的真实机器人示范训练整套模型，再针对新机器人做全参数或 LoRA 微调。（图 2；第 3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_1" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_2" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;单张相机图像分别进入 DINOv2 和 SigLIP 视觉编码器，拼接特征经两层 MLP 映射到 Llama 2 7B 的嵌入空间；语言指令与视觉 token 一起进入模型，动作 token 经反量化成为机器人控制量。图 2 的三段是“双视觉编码器 → 特征投影 → 语言模型和动作反量化”。（图 2；第 3.1–3.2 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_2" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="762.5" as="sourcePoint"/><mxPoint x="1942" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_3" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入为 224×224 单张 RGB 图像＋语言任务指令。该版本不直接输入多相机历史帧或本体状态；论文没有给出触觉或点云输入。视觉编码器在机器人训练中参与微调。（第 3.2–3.4、5 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_3" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1195.0" as="sourcePoint"/><mxPoint x="1942" y="1195.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_4" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;输出单步 7 维末端控制：平移、旋转和夹爪命令。每个连续维度按训练数据第 1 至第 99 百分位划分为 256 个区间，替换 Llama tokenizer 中 256 个少用 token；模型自回归预测动作 token，再按目标数据集反归一化。原版没有 Diffusion 或 Flow Matching 动作头，也没有 action chunk。（图 2；第 3.2 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_4" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1627.5" as="sourcePoint"/><mxPoint x="1942" y="1627.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_5" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;沿用 Octo 的数据混合权重思路，降低重复而单一的数据集权重，提高场景和任务多样数据的占比。BridgeData V2 每条示范的首个全零动作会导致模型在评测时停住，作者过滤这一过渡步。224×224 与 384×384 的早期比较中性能相近，后者训练耗时约三倍。论文主文没有将某种图像增强报告为主要贡献，不能据此编造增强配方。（第 3.3–3.4 节；附录 E）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1870" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_5" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2102.0" as="sourcePoint"/><mxPoint x="1942" y="2102.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_6" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;对 Prismatic VLM 端到端微调，仅在动作 token 上计算 next-token cross-entropy；最终训练约 27 个 epoch，学习率 2×10⁻⁵。附录 C 报告 64 张 A100 训练 14 天。新任务实验比较全量微调、仅末层、冻结视觉、sandwich 与 LoRA；LoRA rank 32 仅训练约 1.4% 参数。（第 3.2–3.4、4.3 节；附录 C）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2362" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_6" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2576.5" as="sourcePoint"/><mxPoint x="1942" y="2576.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_3_field_7" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：结合 DINOv2 与 SigLIP 两种视觉特征，兼顾几何细节和语义；投影到 Llama 语言骨干，使图像和任务文字可以共同参与动作预测&lt;br&gt;贡献 2：将7维动作分箱成离散符号，训练模型逐个预测，再还原机器人动作。动作包括末端平移、旋转和夹爪开合，不包含通用多指手关节&lt;br&gt;贡献 3：用约970k条机器人轨迹预训练，并研究 LoRA（低秩适配：只训练少量附加参数）与量化，使换任务训练和推理资源更可控&lt;br&gt;方法流程：图像+任务文字 → 双视觉编码 → 语言模型融合 → 预测动作符号 → 还原7维末端/夹爪控制 → 执行一步 → 输入下一张观察" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="2819" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_3_branch_7" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3138.5" as="sourcePoint"/><mxPoint x="1942" y="3138.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_4_field_1" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;从 Open X-Embodiment 社区汇集的真实机器人示范中筛出约 97 万条轨迹。只保留至少一台第三人称相机、单臂末端控制的操作数据，因此“跨本体训练”不等于已覆盖双臂或灵巧手。DROID 最初以 10% 混合权重加入，因动作 token 学习进展慢，最后三分之一训练阶段移除并重分配权重。（第 3.3 节；附录 A，表 3）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_1" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_4_field_2" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;零样本／直接部署评测包括 BridgeData V2 的 WidowX 真实机器人 17 项任务×10 次＝170 次 rollout，覆盖视觉、运动、物理、语义变化和语言指定目标；Google mobile manipulator 12 项×5 次＝60 次。基线为 RT-1-X、Octo、RT-2-X，指标为按任务平均成功率，部分 Bridge 任务允许 0.5 的部分成功。新机器人适配在 Franka-Tabletop 和 Franka-DROID 与 Diffusion Policy、匹配输入输出的 Diffusion Policy、Octo 和无 OpenX 预训练的 OpenVLA 对比。（第 4 节；附录 B，表 4、6、7）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_2" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_4_field_3" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;WidowX、Google mobile manipulator 和 Franka Panda 均为实体机器人。Franka-Tabletop 的控制频率为 5 Hz，Franka-DROID 为 15 Hz；后者含桌面清扫及干扰物测试。模型在单张相机画面上决策；论文没有给这三套真机平台统一的摄像头安装说明，不能写成相同观测硬件。Franka 每任务微调示范数随任务变化，正文概括为约 10–100 条，附录参数高效微调子集用 50／150 条；不同实验子集不可混为一组。（第 4.1–4.3 节；附录 B，表 7、8）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_3" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1408.5" as="sourcePoint"/><mxPoint x="2632" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_4_field_4" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;BridgeData V2 全 17 任务中 OpenVLA 平均 70.6±3.2%，RT-2-X 50.6±3.5%、Octo 20.0±2.6%、RT-1-X 18.5±2.7%（表 4）。Google 机器人 12 任务中 OpenVLA 85.0±4.6%，RT-2-X 78.3±5.4%，两者误差区间重叠，论文视为相近（表 6）。Franka 适配附录表 7 在所列任务中报告 OpenVLA 的平均成功率高于对照，但单指令“倒玉米”中 Diffusion Policy 仍更好；不能概括为所有任务都领先。LoRA rank 32 在 33 次 rollout 子集中为 68.2±7.5%，全量微调 69.7±7.2%（表 1）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_4" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1953.0" as="sourcePoint"/><mxPoint x="2632" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_4_field_5" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bridge 八任务子集里，完整 OpenVLA 76.3±4.8%，只用 Bridge 训练 45.6±5.6%，再去除 DINOv2 为 40.6±5.5%：数据多样性的作用大于双视觉编码器增益（附录 F，表 9）。其他视觉编码器实验中，参与微调平均 80.0%，冻结视觉 46.7%，但该子集与表 9 设置不同，不能直接拼成统一对照（表 10）。4-bit 量化在八任务非阻塞评测中 71.9±4.7%，接近 bfloat16 的 71.3±4.8%；8-bit 因推理变慢降到 58.1±5.1%（表 2）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2248" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_5" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2497.5" as="sourcePoint"/><mxPoint x="2632" y="2497.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_4_field_6" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;未过滤 Bridge 的全零初始动作时，模型会反复预测零动作、在真机评测中停住；附录 E 给出过滤后改善的处理。狭窄单指令高精度任务中，连续动作的 Diffusion Policy 轨迹更平滑；对某些新物体或语言组合，表 4 仍有失败。这些是论文报告的具体边界，不推断额外双臂失败类型。（第 4.2 节；附录 E，表 4、7）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2775" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_6" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2989.5" as="sourcePoint"/><mxPoint x="2632" y="2989.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_5_field_1" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：单图输入、缺本体状态和多相机历史；模型较大导致控制频率低；模型大小、联合互联网数据训练及视觉表征等设计尚未系统探索。附录 C 报告 RTX 4090 上约 6 Hz 推理，难直接满足如 ALOHA 50 Hz 的任务。文献库分析：其预训练数据约束为单臂末端动作，移到普通夹爪双臂协同需要重建观测和联合动作接口；这是尚待实验的适配问题。（第 5 节；附录 C）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_5_branch_1" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_5_field_2" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对普通夹爪双臂研究，它是可获取权重、训练与微调代码的 VLA 基线；需要先统一相机和动作维度，再与 RDT-1B 等双臂策略比较。优先试验高频 action chunk、双相机／本体状态输入，以及相同示范预算下的语言 grounding；这些是研究方案，不是原版已经验证的能力" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_5_branch_2" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="829.0" as="sourcePoint"/><mxPoint x="3322" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_52_5_field_3" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者指出原版仅支持单图，缺少多图和本体状态输入；大模型控制频率低。骨干规模、联合训练和视觉特征等设计仍未充分探索&lt;br&gt;我的理解 / 不足：我的判断：原版动作空间不覆盖 DH116 手指，缺少长期记忆和显式失败判断。直接加载权重不能得到灵巧手长任务系统&lt;br&gt;未来展望：可逐步加入历史、本体状态、动作段和接触监控，并用同一数据划分比较，控制变量后确定每个改动有没有实际收益&lt;br&gt;对我们项目的启发：适合作为机械臂+DH116 的基础 VLA 参照。需扩展动作输出、采集目标本体示范并微调；再接 #38–#40 记忆和 #44 恢复，形成可比较方法链" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_5_branch_3" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1373.5" as="sourcePoint"/><mxPoint x="3322" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-53" name="07-03 SpatialVLA">
