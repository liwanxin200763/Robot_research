          </mxCell>
        </UserObject><UserObject id="paper_95_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-96" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_95_1_field_1" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作&lt;br&gt;数据链条位置：正反向遥操作、触觉反馈与人工接管" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_1_branch_1" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_1_field_2" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究背景：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;研究背景：接触丰富的灵巧操作需要操作者感知力和指尖接触；仅靠摄像画面的遥操作容易在遮挡及中途接管时出错。（论文第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：如何用同一套接口为不同灵巧手采集示范，并在策略运行中让人的手快速、安全地对齐机器人当前构型后接管。（论文第 1 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_1_branch_2" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="899.0" as="sourcePoint"/><mxPoint x="562" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_1_field_3" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;常见手套或视觉遥操作缺乏关节力反馈和指尖接触提示；接管时人的手与机器人手姿态不一致，增加恢复操作的时间与失败率。（论文第 1–2 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_1_branch_3" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1454.0" as="sourcePoint"/><mxPoint x="562" y="1454.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_2_field_1" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;与已有工作的关系：相较 OPEN TEACH，本工作重点是灵巧手力／触觉反馈与部署时的反向接管对齐，而非仅增加可支持的机器人种类" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_2_branch_1" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_2_field_2" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_2_branch_2" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_3_field_1" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：正向遥操作传递手部动作并回馈力／触觉；反向遥操作由机器人手驱动人的外骨骼手指，使操作者在取得控制前匹配当前状态。（论文第 3 节、图 1）&lt;br&gt;&lt;br&gt;方法与系统结构：手部外骨骼、手型无关重定向、关节级力反馈、指尖触觉提示和反向驱动构成闭环。支持 Sharpa Wave、Wuji2、Inspire 三款商业灵巧手；触觉接触在 Sharpa 上来自触觉传感器，其他手型主要使用电机电流估计，不能视为相同传感质量。（论文第 3 节、表 1）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_3_branch_1" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_3_field_2" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：操作者手关节、机器人手关节与电机／触觉反馈，策略执行时还用视觉观测。（论文第 3–4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：经重定向的机器人手关节目标，以及传给操作者的关节力和指尖接触提示；反向模式输出给外骨骼驱动以匹配机器人手构型。（论文第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：三款灵巧手通过统一重定向接口使用同一设备；策略训练使用采集的示范和后续 DAgger 接管数据。论文未将跨手型零样本策略迁移作为已验证结果。（论文第 3–4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_3_branch_2" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1004.0" as="sourcePoint"/><mxPoint x="1942" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_3_field_3" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练方式：使用 Diffusion Policy UNet；初始示范数据训练 50 epochs，部署后两轮 DAgger、每轮 20 次接管，再微调 10 epochs。（论文第 4 节）&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_3_branch_3" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1618.5" as="sourcePoint"/><mxPoint x="1942" y="1618.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_4_field_1" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：通过 DITTO-X 收集示范和接管轨迹；作者项目页报告 DITTO-Human 数据共 1,888 条 episode、逾 16 小时，包含 847 条遥操作、379 条人工接管、662 条自主执行记录。此数字来自项目页，需与各实验子集区分&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：六名参与者进行与 Manus 手套的用户实验；示范采集、部署接管和触觉辨别分别测试。策略评测包括夹取钳子、覆盆子、电池等任务，每项每配置 30 次 rollout。（论文第 4 节、表 2）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_4_branch_1" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_4_field_2" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机实验：在单个 Franka 机械臂配灵巧手的平台上完成接触操作和人的中途接管；这些实验不能推断已验证双臂协作。（论文第 4 节）&lt;br&gt;&lt;br&gt;主要实验结果：六人实验中示范采集任务成功率为 70.0%，Manus 为 46.7%；接管任务为 78.3%，Manus 为 27.7%。触觉双线索下，物体尺寸与柔顺性辨别正确率分别为 86.1% 和 91.7%。（论文第 4 节、图 6）&lt;br&gt;&lt;br&gt;消融实验：论文比较视觉、力及接触提示的辨别效果，并以不同接管接口比较效率；没有完整分离反向驱动、重定向和每种反馈通道对最终策略成功率的独立贡献。（论文第 4 节）" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_4_branch_2" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_4_field_3" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;Failure Case：遮挡、抓握中途接管和接触状态不清会令视觉手套方案较难操作；论文中不同任务和手型的性能差异说明反馈优势并非所有场景同幅度。（论文第 1、4 节）&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_4_branch_3" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1741.0" as="sourcePoint"/><mxPoint x="2632" y="1741.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_95_5_field_1" parent="paper_95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：从实验范围看，参与者仅六人，学习策略评测集中在一套单臂装置和少数接触任务，跨手型统一遥操作不等于跨手型共享策略；这些是本库对证据范围的分析。（论文第 4–5 节）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：为灵巧操作的示范采集和失败接管提供可检验的人机接口；若用于双臂普通夹爪项目，需单独评估复杂外骨骼相对简易遥操作的成本收益&lt;br&gt;&lt;br&gt;对自己的实验怎样落地：可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_95_5_branch_1" edge="1" parent="paper_95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="512.0" as="sourcePoint"/><mxPoint x="3322" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
