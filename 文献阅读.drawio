          </mxCell>
        </UserObject><UserObject id="paper_29_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-28" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_29_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-41" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_29_1_field_1" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICCV&lt;br&gt;引用量：10（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_1_branch_1" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_1_field_2" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_1_branch_2" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_1_field_3" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Dexterous Manipulation; Dataset / Benchmark 方向，主要讨论人向灵巧手机器人递交物体时，动态抓取需要兼顾时机和接触稳定性。&lt;br&gt;核心思路是DexH2R 建立真实人向机器人交接数据集和评测基准，并给出任务解决方案。&lt;br&gt;与当前项目的联系：项目联系：时序与交接问题可借鉴，但灵巧手硬件不同于普通夹爪" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_1_branch_3" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_1_field_4" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：人向灵巧手机器人递交物体时，动态抓取需要兼顾时机和接触稳定性&lt;br&gt;&lt;br&gt;为什么重要：动态交接提供了感知、时序控制与接触安全的共同测试场景&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：人递物时的动态灵巧抓取&lt;br&gt;目标和人手都在运动&lt;br&gt;核心问题：机器人怎样预测交接位置，&lt;br&gt;同时避开人手并及时抓稳物体？&lt;br&gt;静态抓取只考虑物体当前姿态；&lt;br&gt;交接时物体会继续移动" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_1_branch_4" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1767.5" as="sourcePoint"/><mxPoint x="562" y="1767.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_2_field_1" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读&lt;br&gt;&lt;br&gt;之前方法的问题：高质量真实人机交接数据不足，限制动态灵巧抓取方法评测" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_2_branch_1" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_2_field_2" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_2_branch_2" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_2_field_3" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：静态灵巧抓取，&lt;br&gt;先选稳定手型再接近物体&lt;br&gt;相关方向 2：Diffusion Policy（逐步去噪生成动作），&lt;br&gt;从示范学习连续接近物体的动作&lt;br&gt;代表对照：MotionNet、Diffusion Policy、&lt;br&gt;DP3（利用三维点云的动作策略）；比较成功和安全&lt;br&gt;区别：提供真人动态交接数据与分阶段评测，&lt;br&gt;而非只报静态抓取率" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_2_branch_3" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1324.5" as="sourcePoint"/><mxPoint x="1252" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_3_field_1" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexH2R 建立真实人向机器人交接数据集和评测基准，并给出任务解决方案" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_3_branch_1" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_3_field_2" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集之外的 DynamicGrasp 方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入包含当前和历史的图像、深度、物体点云与交互状态，目标是给正在运动的物体预测后续手部运动。DynamicGrasp 的 MotionNet 结合当前手点云、顶点速度、到目标抓取手形的偏移与历史信息，自回归地预测未来手状态；重点是运动过程中的接近与闭合，不是先让人把物体停住再做静态抓取" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_3_branch_2" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="762.5" as="sourcePoint"/><mxPoint x="1942" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_3_field_3" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;阅读要点与补充说明：贡献 1：采集 4,282 次真人交接，&lt;br&gt;含人手、物体、ShadowHand 等信息&lt;br&gt;贡献 2：把交接拆成准备抓型、&lt;br&gt;接近移动、末端姿态对齐三段&lt;br&gt;贡献 3：分别评估抓型生成与接近策略，&lt;br&gt;同时记录碰撞等安全问题&lt;br&gt;流程：跟踪人手/物体→选抓型&lt;br&gt;→预测接近轨迹→对齐并抓取&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="744" width="628" x="1942" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_3_branch_3" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1377.0" as="sourcePoint"/><mxPoint x="1942" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_4_field_1" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;平台与采集规模的全文补充&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexH2R 真实系统为 UR10e 机械臂与右 ShadowHand，配多视角 RGB、四台 Azure Kinect 和腕部 RealSense；遥操作采集自然接递。表 1 记录 18 名参与者、56 个物体、39 种物体类别及 4282 条序列。数据数量、轨迹误差、抓取稳定与闭环接递表现须分开统计，不能把 4282 条记录写成四千次自主成功" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_4_branch_1" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_4_field_2" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据：39 人、56 种物体；&lt;br&gt;训练 2,888、验证 591、测试 803 次&lt;br&gt;对照：MotionNet、Diffusion Policy、DP3；&lt;br&gt;指标含成功率与安全率&lt;br&gt;结果：难模式 MotionNet 成功 26.6%、安全 15.4%；&lt;br&gt;DP3 为 27.1%/33.7%&lt;br&gt;补充：不同方法有成功/安全权衡；&lt;br&gt;论文没有统一的最佳交接成功率" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_4_branch_2" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_4_field_3" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_4_branch_3" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_5_field_1" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：时序与交接问题可借鉴，但灵巧手硬件不同于普通夹爪&lt;br&gt;&lt;br&gt;主要局限：摘要不足以判定方法对普通夹爪的可迁移性&lt;br&gt;&lt;br&gt;局限与启发：主要局限：摘要不足以判定方法对普通夹爪的可迁移性&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者实验表明动态难模式成功率仍低，&lt;br&gt;靠单一指标很难判断可用性&lt;br&gt;我的理解：数据来自 ShadowHand；&lt;br&gt;DH116 手型和关节动作不能直接照搬&lt;br&gt;未来需考虑速度变化、遮挡和人手安全，&lt;br&gt;并做跨机器人手迁移&lt;br&gt;项目启发：可借交接数据结构与安全指标；&lt;br&gt;先做 DH116 的人递物小基准" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_5_branch_1" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="547.0" as="sourcePoint"/><mxPoint x="3322" y="547.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_29_5_field_2" parent="paper_29" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="982" as="geometry"/>
        </mxCell>
        <mxCell id="paper_29_5_branch_2" edge="1" parent="paper_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1179.0" as="sourcePoint"/><mxPoint x="3322" y="1179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
