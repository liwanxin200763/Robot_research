        </UserObject><UserObject id="paper_86_bottomnav_1" label="返回分类" link="data:page/id,literature-page-data-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_86_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-85" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_86_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-87" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_86_1_field_1" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2023 / CoRL 2023&lt;br&gt;引用量：待 Google Scholar 人工核验，不填写估计数量（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_1_branch_1" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_1_field_2" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_1_branch_2" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_1_field_3" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;MimicGen 问的是：示范中有多少是独特技能，又有多少只是同一技能随物体位置变化重复采集？核心思路是把少量机器人遥操作示范拆成相对物体的片段，在新场景变换、拼接并实际执行，只保留成功轨迹，再用行为克隆训练。输入不是任意人类裸手视频，而是已有机器人状态—动作轨迹、子任务结构及生成时的物体位姿；输出新机器人演示数据和单独训练的视觉策略（§3–5）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_1_branch_3" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_1_field_4" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：论文用约两百条源示范生成超过五万条、覆盖十八任务，支持场景、同类物体及机械臂变化。价值在减少重复示教，但仍需采样执行和成功判定；不是离线复制文件就获得独立新数据，也不是跨臂共享一个策略或直接验证 Sim2Real&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：从少量种子示范扩增大量可训练轨迹&lt;br&gt;MimicGen 分段搬运人类示范，再在新物体位置接合轨迹并检查执行成功&lt;br&gt;为什么重要 / 旧方法的不足：输入不是任意人类裸手视频，而是已有机器人状态—动作轨迹、子任务结构及生成时的物体位姿；输出新机器人演示数据和单独训练的视觉策略" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_1_branch_4" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1802.5" as="sourcePoint"/><mxPoint x="562" y="1802.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_2_field_1" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_2_branch_1" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_2_field_2" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_2_branch_2" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_2_field_3" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;人工遥操作可采复杂技能，却要为各种物体位置反复操作；脚本和强化学习自动采集又常需任务专用设计。图像增强只改变视觉输入，未补新状态—动作覆盖。已有 replay imitation 把轨迹回放直接当部署策略，依赖初始对齐和局部伺服；MimicGen 把回放当数据采集器，允许许多尝试失败，最终用成功数据训练闭环策略，因此生成成功率与策略成功率可以差很大（§2、§6.3、附录 E/P）" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_2_branch_3" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1188.0" as="sourcePoint"/><mxPoint x="1252" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_2_field_4" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;与 robomimic 的关系是复用离线训练和数据接口；新贡献集中在对象坐标下的片段改写与在线执行，不是新的大模型。它与视频生成机器人画面的路线也不同：数据是机器人实际在仿真或真机环境中交互产生，含对应动作，而非仅合成 RGB" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_2_branch_4" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1645.0" as="sourcePoint"/><mxPoint x="1252" y="1645.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_2_field_5" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;示范扩增：由少量真实示范生成更多任务条件变化下的训练轨迹&lt;br&gt;人工遥操作可采复杂技能，却要为各种物体位置反复操作；脚本和强化学习自动采集又常需任务专用设计&lt;br&gt;robomimic 提供离线示范学习与评估接口，MimicGen 则从少量种子示范生成更多不同初始条件下的轨迹。前者侧重怎样学和比较，后者侧重训练数据从哪里扩增" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="1870" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_2_branch_5" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2102.0" as="sourcePoint"/><mxPoint x="1252" y="2102.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_3_field_1" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 三个关键前提与源数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;动作必须能转换为末端 delta pose 加夹爪开闭；任务有已知且固定顺序的 object-centric subtasks（每阶段相对一个参考物体）；每阶段开始时可取得该物体位姿。部署策略不一定需要物体位姿，生成器需要。用子任务完成判据切分源示范，保留每段控制器目标和夹爪动作。一般每任务十条源示范，Mobile Kitchen 用二十五条，Square 直接取 robomimic PH 十条（§3–5、图 2）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_3_branch_1" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_3_field_2" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 在对象坐标中变换并拼接&lt;/b&gt;&lt;br&gt;&lt;br&gt;新场景先选同阶段的参考段，可随机或依据物体位置选择。保持末端目标相对源物体的关系，再换到新物体坐标，得到新的世界系末端轨迹。这里操作的是统一控制帧，不能直接搬运原机械臂关节角。新段起点通常不在当前末端处，故在段前加入线性插值，并按源示范配对夹爪动作。每个阶段重新观察对象、选择参考、变换和执行，最终检查全任务成功；失败整段丢弃（§4、附录 M/N）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_3_branch_2" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_3_field_3" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 在对象坐标中变换并拼接&lt;/b&gt;&lt;br&gt;&lt;br&gt;少量源轨迹 → 子任务切段 → 新物体位姿 → 参考段对象相对变换 → 插值衔接 → 执行并记录 → 成功筛选 → BC-RNN 训练。 跨 Panda、Sawyer、IIWA、UR5e 要共同末端坐标约定及各自控制器，新物体要有同类规范坐标。共享的是生成机制和源片段，而不是无需适配的网络权重" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_3_branch_3" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_3_field_4" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 感知、记录与训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要仿真任务在 robosuite/MuJoCo，装配任务在 Factory/Isaac Gym。附录 L.1 说明 robosuite 控制 20 Hz，不将此频率泛化为所有模块采样率。真机使用标定外部 D415：深度变点云，RANSAC 去桌面、DBSCAN 分割，以颜色或尺寸区分物体，再初始化姿态并 ICP 精化；视觉策略输入另有腕部 D435。真机训练图像 120×160，通常仿真 84×84。端到端采集延迟未报告（附录 H/O）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_3_branch_4" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1778.0" as="sourcePoint"/><mxPoint x="1942" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_3_field_5" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 感知、记录与训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;每变体通常生成一千条成功轨迹；必须同时记录尝试次数和来源示范，因为生成成功会偏向某几条源数据。BC-RNN 学 RGB 到动作，模拟评测三种子，按训练中最高成功率汇总；并不与最终检查点等价。计算设置含 V100，真机实验机器 RTX 3090，不能据此假定普通 CPU 可低成本跑完整流程（附录 O）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2038" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_3_branch_5" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2252.5" as="sourcePoint"/><mxPoint x="1942" y="2252.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_4_field_1" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果：十八任务包括堆叠、螺母插入、穿线、多件装配、咖啡、厨房、移动操作及真机。D0 是源数据初始分布，D1/D2 扩大或移动物体初始区域，不是训练/验证数据划分。图 4 给 RGB BC-RNN 三种子结果：&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：任务：Square；十条源数据：11.3%；一千条生成数据 D0：90.7%；生成数据 D1：73.3%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：任务：Threading；十条源数据：19.3%；一千条生成数据 D0：98.0%；生成数据 D1：60.7%" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_4_branch_1" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="459.5" as="sourcePoint"/><mxPoint x="2632" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_4_field_2" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务：Three Piece Assembly；十条源数据：1.3%；一千条生成数据 D0：82.0%；生成数据 D1：62.7%" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_4_branch_2" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="997.0" as="sourcePoint"/><mxPoint x="2632" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_4_field_3" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;它证明这些任务的覆盖扩增能支持特定策略，不证明所有生成样本在任何算法下都更优。等量二百条生成与二百条人工数据在若干任务上接近；一千扩至五千存在收益递减；源数据十条增加到五十、两百也不总有明显提升。跨机械臂数据生成率差异较大，训练后的策略结果却接近，进一步说明生成率不能代替数据学习价值（§6.1–6.3）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_4_branch_3" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1429.5" as="sourcePoint"/><mxPoint x="2632" y="1429.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_4_field_4" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机每任务十条源示范，正文明确 Stack 生成二百条/二百四十三次尝试，Coffee 一百条/一百九十二次尝试，生成率为 82.3%/52.1%。图 5 图注与附录对 Stack 条数有简写不一致，本卡采用正文及尝试数可复核的二百条。BC-RNN 各评五十次，成功率 Stack 36%、Coffee 14%；这与生成率是不同分母。附录 H 将 Stack 换 Diffusion Policy 为 76%，是同一真机数据下不同策略结果（§6.4）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1672" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_4_branch_4" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1904.0" as="sourcePoint"/><mxPoint x="2632" y="1904.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_4_field_5" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真实数据为安全使用更长插值段；模拟对应消融中 Stack D1 从 99.3%降到 68.7%，Pick Place 从 50.7%降到 11.3%，提示“轨迹可执行”与“观察下可学”不是一回事。姿态噪声与数据来源选择也有专门分析（附录 H/I/U）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2164" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_4_branch_5" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2354.0" as="sourcePoint"/><mxPoint x="2632" y="2354.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_5_field_1" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：需要固定子任务序列及阶段物体位姿；每阶段只相对一个对象；成功过滤仍带偏差；线性插值无避碰保证；主要是刚体、近静态、相似类别与尺度。移动案例不同时移动底盘与机械臂，未解决完整通用移动操作（§7、附录 D）" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_5_branch_1" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_5_field_2" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的推论与复用：先在仿真中建立源段、目标段、碰撞检查及来源追溯，适合当前 D435i＋DH116 的离线数据工程。D435i 点云可研究物体定位，但要校准和标注失败，不能直接宣称达到论文姿态精度。DH116 是六主动轴/十一总自由度，多指接触不是夹爪开闭；需先做三指运动学和受限映射，再研究“末端＋手形”片段，不能直接套七维动作" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_5_branch_2" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="794.0" as="sourcePoint"/><mxPoint x="3322" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_86_5_field_3" parent="paper_86" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前整手/多轴运动仍锁定、原因未知，应只做离线日志与仿真；未来机械臂、腕部视觉、双臂及控制器都是新增成本。论文没有把其仿真策略直接迁到真机，Sim2Real 在文中是未来方向。下一步可把成功过滤加上碰撞、停顿、来源占比和阶段可预测性，检查扩增是否只复制容易成功的窄模式" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_86_5_branch_3" edge="1" parent="paper_86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1268.5" as="sourcePoint"/><mxPoint x="3322" y="1268.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
