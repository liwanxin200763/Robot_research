        <mxCell id="paper_48_2_field_3" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="代表工作：与 QuasiSim 等物理迁移方法比较；#18 DexMimicGen 扩增机器人示范，本篇强调人类双手动作适配多种机械手与物理约束" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="590" as="geometry"/>
