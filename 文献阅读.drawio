            <mxGeometry x="2160" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_37_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-55" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_37_1_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / RSS&lt;br&gt;引用量：1137（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_1_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_1_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_1_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_1_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Dataset / Benchmark / Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论通用操作策略需要规模大、场景多样且质量可靠的机器人交互数据。&lt;br&gt;核心思路是DROID 组织分布式采集，形成 6.5 万条示范轨迹、约 350 小时交互，覆盖 564 个场景和 86 项任务。&lt;br&gt;与当前项目的联系：项目联系：可借鉴采集协议，但需核对与本项目机器人形态和动作接口的差异" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_1_branch_3" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_1_field_4" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：通用操作策略需要规模大、场景多样且质量可靠的机器人交互数据&lt;br&gt;&lt;br&gt;为什么重要：为跨场景数据采集和数据规模设计提供具体参照" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_1_branch_4" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1680.0" as="sourcePoint"/><mxPoint x="562" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_1_field_5" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：真实机器人数据集与泛化 Generalization（在没见过的物体、场景上仍能做任务）。它研究数据的覆盖面和采集规范，而非提出新的记忆或恢复模块&lt;br&gt;核心研究问题：只在实验室同一张桌子采数据，模型可能记住背景而不是任务。怎样在大量真实房间持续采集可校准、可复用的机器人操作数据？&lt;br&gt;之前方法的问题：多地点采集既要搬动硬件，又要统一相机、动作、任务说明和质量检查。少量固定任务的数据，难以支持换背景、换布局后仍稳定行动" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1905" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_1_branch_5" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2172.0" as="sourcePoint"/><mxPoint x="562" y="2172.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;之前方法的问题：跨环境采集成本高，并受安全、硬件和人力协调限制" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;OOD：训练分布之外，例如未见物体或不同背景" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：单实验室数据可以训练固定技能，但物体和环境变化少；跨机构的数据集合又常有相机与动作格式不一致的问题，需要统一处理&lt;br&gt;相关方向 2：Co-training（联合训练：把大数据集与目标任务数据一起训练）利用通用经验；Fine-tuning（微调：用目标任务数据继续训练已有模型）适配新现场&lt;br&gt;代表工作：Open X-Embodiment（机器人本体，机械结构、传感器和动作空间的组合） 汇集多种机器人数据；DROID 以统一 Franka 采集平台扩展场景多样性。Embodiment（本体）指机器人的结构、传感器和动作接口&lt;br&gt;与已有方法的区别：重点把一个平台搬进很多真实环境，保留三路同步图像、深度、标定和任务文字。它增加“在哪里做”的多样性，并不覆盖所有机械手本体" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_branch_3" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1412.0" as="sourcePoint"/><mxPoint x="1252" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：DROID 组织分布式采集，形成 6.5 万条示范轨迹、约 350 小时交互，覆盖 564 个场景和 86 项任务&lt;br&gt;&lt;br&gt;分布式采集为什么要统一硬件：DROID 使用统一 Franka Panda 硬件与采集栈，让不同地区采集者把机器人带到不同环境。每条轨迹同时保留三相机视角、深度、相机标定及语言描述，统一接口减少格式差异，场景与任务变化增加覆盖。核心取舍是固定机器人本体而扩大环境，而不是在一个实验室不断重复同样摆放" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据怎样证明有用&lt;/b&gt;&lt;br&gt;&lt;br&gt;用这批数据训练或预训练视觉操作策略，再在目标任务及新场景测试；与小规模或较单一场景数据比较时，要保持策略与微调预算可比。采集协议和数据开放使别的研究者能重用，不代表每条轨迹都适合任何任务；应检查成功标记、相机可用性、动作接口和语言描述是否匹配自己的训练器" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="916.5" as="sourcePoint"/><mxPoint x="1942" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：搭建可移动的 Franka 机械臂采集平台，配统一相机和遥操作接口。不同采集者遵循共同流程，降低跨地点数据无法对齐的风险&lt;br&gt;贡献 2：收集564个场景、86类任务、52栋建筑的76,000条成功操作，约350小时；另有约16k未成功操作随数据发布。每条带任务文字与结果标记，可按目标选择训练数据&lt;br&gt;贡献 3：用目标任务数据和 DROID 成功示范联合训练策略，测试场景内外表现。质量与多样性都要检查，不能只把更多轨迹无差别塞进训练集&lt;br&gt;方法流程：移动平台到不同地点 → 标定相机 → 人遥操作 → 保存图像/动作/说明/结果 → 检查数据 → 和目标任务示范混合训练 → 新场景测试" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_branch_3" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1478.5" as="sourcePoint"/><mxPoint x="1942" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_4_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：DROID：约 6.5 万条轨迹／350 小时、564 个场景、86 项任务，50 名采集人员在 12 个月内完成&lt;br&gt;&lt;br&gt;主要结果：论文摘要报告，使用 DROID 训练的策略在性能、鲁棒性和泛化上改善；此处不附加未经实验表格核实的增幅&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：DROID：约 6.5 万条轨迹／350 小时、564 个场景、86 项任务，50 名采集人员在 12 个月内完成&lt;br&gt;&lt;br&gt;实验与结果：主要结果：论文摘要报告，使用 DROID 训练的策略在性能、鲁棒性和泛化上改善；此处不附加未经实验表格核实的增幅" vertex="1">
          <mxGeometry height="744" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_4_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="512.0" as="sourcePoint"/><mxPoint x="2632" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_4_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文版本的数据口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;RSS 2024 原文报告 76k 示范轨迹、350 小时交互、564 个场景、86 项任务与 50 名采集者，采集跨北美、亚洲、欧洲并持续一年。后续数据发布或其他论文使用的子集可能采用不同轨迹计数，引用时应注明版本，不能把这些数字与新版下载量或筛选子集合并" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_4_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1109.0" as="sourcePoint"/><mxPoint x="2632" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_4_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：六项真实任务、四个地点，包括实验室、办公室和住宅；每方法每设置测试10次。比较原场景和 OOD（训练未见的新环境）条件下的完整任务成功率&lt;br&gt;对照：对比只用目标任务数据、加入 Open X 数据、加入 DROID。相同下游任务设置下比较，让“多样数据是否有帮助”成为明确问题&lt;br&gt;结果：论文报告 DROID 联合训练较次优对照，场景内平均提高22个百分点，未见场景提高17个百分点；它们是成功率差值，不是相对倍数，也不是相对所有对照分别都提高这么多&lt;br&gt;真机 / 关键补充：50/50 混合目标任务与 DROID 成功数据是文中策略设置。数据集总量是76k；本地卡的其他旧数量口径不替代本轮核对的 PDF 数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_4_branch_3" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1671.0" as="sourcePoint"/><mxPoint x="2632" y="1671.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_5_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可借鉴采集协议，但需核对与本项目机器人形态和动作接口的差异&lt;br&gt;&lt;br&gt;主要局限：摘要不能分离数据量、场景多样性与策略结构各自的贡献&lt;br&gt;&lt;br&gt;局限与启发：主要局限：摘要不能分离数据量、场景多样性与策略结构各自的贡献" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_5_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_37_5_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：论文讨论分布式采集的成本和质量控制；尽管场景多样，采集仍集中在统一 Franka 与夹爪配置，不能代表灵巧手全部接触技能&lt;br&gt;我的理解 / 不足：我的判断：只用成功数据会减少失败现场覆盖。若要训练恢复，应保留抓空、滑落等片段及异常发生时间，不能仅记录整条成功标记&lt;br&gt;未来展望：可把场景多样性、动作标定和失败片段标签一起建设；比较按场景采样与按轨迹随机采样，避免同一房间数据占比过大&lt;br&gt;对我们项目的启发：适合制定机械臂+DH116 的采集规范：同步视觉、手指状态和接触信息。DROID 可提供机械臂视觉经验，夹爪动作仍需替换为灵巧手接口" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_5_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
