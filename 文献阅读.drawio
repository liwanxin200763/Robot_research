          </mxCell>
        </UserObject><UserObject id="paper_106_bottomnav_1" label="返回分类" link="data:page/id,literature-page-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_106_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-105" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_106_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-137" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_106_1_field_1" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICCV&lt;br&gt;引用量：15（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作&lt;br&gt;数据链条位置：从人类视频学习双手操作可执行区域" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_1_branch_1" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_1_field_2" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;双手任务需要知道哪里可以动手：倒水时一只手应拿杯身或把手，另一只手可能稳住目标容器；只把整个杯子分割出来，仍不知道两手应接触哪里。2HandedAfforder 从人类视频中提取动作相关接触区域，用文字与图像训练可执行区域预测，补足双手分工的视觉先验" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_1_branch_2" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_2_field_1" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;可执行区域与物体部件不同：Affordance 指为完成某动作适合接触或操作的区域，同一物体在倒、提、开盖时的区域可以不同。人工标注常画出概念上合理的大区域，视频中的真实手物接触提供更具体证据；本文把单手和双手情况都纳入，但区域预测仍不是完整机器人轨迹规划" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_2_branch_1" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_2_field_2" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;一只手扶住目标物，另一只手握工具，是关系上的协作；仅预测两个彼此独立的热区会漏掉这种关系。视频旁白提供动作语义，手物交互提供空间证据，模型需要同时利用两者。数据中的常见接触位置也只反映人类示范分布，不是穷尽所有可能抓法" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_2_branch_2" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="934.0" as="sourcePoint"/><mxPoint x="1252" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_3_field_1" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;从活动视频提取训练数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;从活动视频提取训练数据：定位手物交互并跟踪对应物体，通过接触关系得到精细区域掩码，再用视频旁白作为动作语义标签。输出的是带任务文字的单手／双手区域，而不是人手关节或机器人动作；时间序列帮助确认手真正在哪里使用物体，减少仅靠单帧想象接触部位&lt;br&gt;&lt;br&gt;预测模型怎样使用这些数据：在图像和语言条件下预测应操作的区域，训练视觉语言模型理解动作要求及两手关系。对大场景和裁剪物体分别评测，区分找错对象与对象上找错区域。机器人若要执行，还需将二维区域定位到三维、选择抓取姿态并规划可达的双臂轨迹" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_3_branch_1" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="442.0" as="sourcePoint"/><mxPoint x="1942" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_3_field_2" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：掩码比单个接触点给出更丰富的区域，但机器人仍需从区域中选择满足指间距离和姿态限制的抓取。二维区域投到三维后可能因遮挡缺少背面几何，还要检查另一只手和工具运动空间。本文的预测因此适合作为后续规划的输入，而不是直接替代运动规划和接触控制&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_3_branch_2" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1109.0" as="sourcePoint"/><mxPoint x="1942" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_4_field_1" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;规模、任务和指标&lt;/b&gt;&lt;br&gt;&lt;br&gt;规模、任务和指标：2HANDS 约含 278k 自动标注样本、73 类动作区域与 163 类物体；数据主要来自 EPIC-KITCHENS，另在 Ego4D 划分测试泛化。ActAffordance 与裁剪版使用 IoU、精度、Hausdorff 距离和 mAP 衡量区域与边界，不是操作成功率&lt;br&gt;&lt;br&gt;结果能说明什么：表 2 的裁剪版合并划分，本文模型 IoU 约 0.086、mAP 约 0.240，AffLLM 对照约 0.076、0.103；这些分割指标依赖阈值和裁剪协议。原文也展示机器人应用，但不能用区域预测优势代替所有任务重复真机试验；本轮不补造统一双臂执行成功率" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_4_branch_1" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_4_field_2" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：原图和目标裁剪版成绩差异可以帮助定位瓶颈：裁剪后仍错，可能是动作语义或接触区域理解不足；裁剪后明显变好，说明大场景目标定位也在限制结果。IoU 测重叠，边界距离测区域偏差，两者评价不同，不能只挑最有利的一项声称所有可执行区域都更精确&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_4_branch_2" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1091.5" as="sourcePoint"/><mxPoint x="2632" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_5_field_1" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对双臂与灵巧手的启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;对双臂与灵巧手的启发：遮挡、手物接触检测和旁白偏差会进入自动标签；单次可见接触也不一定覆盖全部有效抓法。可把区域作为 DH116 或双臂抓取的候选约束，再由三维几何、手指可达性和接触稳定性筛选；宜保留多种区域，避免把人类常用抓法当唯一合法机器人抓法&lt;br&gt;&lt;br&gt;把关键设计与实验读透：在自己的双臂试验中，可把预测区域、实际接触点和最终物体运动一同保存，检查区域看对但抓不稳的案例。对灵巧手尤其应分析拇指对指、支撑手与操作手的组合约束；如果区域来源于人手视频，还要验证目标手能否实现对应接触，而不是把分割得分当作抓取可行性" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_5_branch_1" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_106_5_field_2" parent="paper_106" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_106_5_branch_2" edge="1" parent="paper_106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1004.0" as="sourcePoint"/><mxPoint x="3322" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
