          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_1_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：灵巧手状态—动作联合扩散规划。扩散模型从噪声逐步生成轨迹；状态是手与物体目前情况，动作是机器人可执行的控制量" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
