        </UserObject><UserObject id="paper_01_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-11" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_01_1_field_1" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICLR 2026&lt;br&gt;引用量：221（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_1_branch_1" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_1_field_2" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：许多 VLA 只看当前画面。长时序操作中，当前图像可能看不出按钮是否按过、前一个物体是否已移动，决策因而依赖历史。直接拼接很多帧既增加自注意力开销，也偏离单帧机器人预训练分布。（论文第 1 节，图 1）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_1_branch_2" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_1_field_3" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：让视觉—语言—动作模型在不反复输入整段视频的前提下保留低层视觉细节和高层任务语义，从而应对非马尔可夫、长时序操作。（第 1、3 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：当前帧 VLA 容易把已完成子任务当成未完成；仅用有限帧窗口难覆盖长程依赖。纯粹扩大图像输入又有计算成本和分布偏移。单一路径的视觉记忆或语义记忆各会丢失另一种信息。（第 1–2、4.6 节）" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_1_branch_3" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1394.5" as="sourcePoint"/><mxPoint x="562" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_1_field_4" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：让看图、读指令并生成动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 记住过去。重点是步骤较多、前后有关联的任务&lt;br&gt;核心问题：机器人现在看到的画面相同，先前做过的事却可能不同。它怎样利用历史决定下一步？&lt;br&gt;之前的问题：只看眼前画面，机器人可能忘记按钮是否按过、物品是否移动过，因而做错顺序" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1672" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_1_branch_4" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1904.0" as="sourcePoint"/><mxPoint x="562" y="1904.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_2_field_1" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_2_branch_1" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_2_field_2" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;OOD：训练分布之外，例如未见物体或不同背景" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_2_branch_2" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="745.0" as="sourcePoint"/><mxPoint x="1252" y="745.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_2_field_3" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;模型沿用 OpenVLA 所属的 Prismatic／Open X-Embodiment 视觉—语言骨干路线，但显式加入随执行更新的双流记忆和扩散动作专家；与 SayCan 的技能级语言规划不同，它直接生成连续动作。LT-Mem 保存跨会话外部世界状态与物体事件，Taming VLAs 适应机器人机械执行误差；二者与本模型的策略时间上下文各处于不同层面。官方仓库另列 MemoryVLA+ 和 MemoryVLA++，它们不是本张主卡的同一实验版本，不能混入此卡分数。（第 2–4 节；官方仓库）" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_2_branch_3" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1237.0" as="sourcePoint"/><mxPoint x="1252" y="1237.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_2_field_4" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：普通 VLA 根据当前画面和文字指令给出动作；没有充分利用先前发生的事&lt;br&gt;相关方向 2：记忆方法会保存过去画面或状态；关键是留下对当前动作真正有用的部分&lt;br&gt;代表工作：OpenVLA、CogACT、π0 都能生成动作；这里比较的是加入历史记忆能否进一步帮忙&lt;br&gt;区别：同时保存刚发生的事和更久以前的重要信息，再把两类记忆交给动作模型" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1532" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_2_branch_4" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1781.5" as="sourcePoint"/><mxPoint x="1252" y="1781.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_1" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;建立 Cognition-Memory-Action 流程：当前图像和指令被编码成感知、认知两类短期工作记忆；这两类 Token 去长期的 Perceptual-Cognitive Memory Bank 检索、门控融合与更新；融合后的上下文再条件化 Diffusion Action Expert 生成动作。（第 3 节，图 2–3）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_1" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_2" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;以在 Open X-Embodiment 上继续预训练的 Prismatic 7B VLM 为骨干。DINOv2 和 SigLIP 的并行视觉特征经 SE bottleneck 压缩为 256 个 Perceptual Tokens；图像特征与语言指令进入 LLaMA-7B，EOS 输出形成一个高层 Cognitive Token。两者构成当前时刻的 Working Memory。检索时分别作为 query，带时间位置编码地读取银行中对应的感知细节与认知语义；门控在当前信息和历史信息之间分配权重。融合表示同时用于动作预测和写回长期银行，容量满时在各流内对时间相邻且余弦相似度最高的条目取平均合并，减少冗余。（第 3.1–3.3 节，图 2–3）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_2" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_3" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;单张第三人称 RGB 图像、自然语言任务指令，以及模型先前时刻积累的内部记忆。标准模型没有把腕部相机或 Proprioception 加入主输入；部分基线使用额外输入，表 1 和表 3 的星号应单独看待。（第 3.1–3.2、4.1 节，表 1、3）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_3" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1356.0" as="sourcePoint"/><mxPoint x="1942" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_4" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;记忆增强的认知 Token 提供语义条件，感知 Token 补充细节；约 300M 参数的 DiT 动作专家用 10 步 DDIM 去噪预测长度 16 的 Action Chunk。每步为连续 7-DoF 相对动作：三维平移、欧拉角旋转和二值夹爪状态；不是预测离散语言动作 Token。（第 3.4、4.1 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_4" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1778.0" as="sourcePoint"/><mxPoint x="1942" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_5" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机 D435 正前方相机采集 640×480、30 fps RGB，缩放到 224×224；只有末端平移超过 0.01 m、转动超过 0.4 rad 或距离上次保留帧已达 120 帧时才保留新帧，之后转 RLDS。训练时对 RGB 做随机裁剪、亮度、对比度、饱和度和色调扰动，测试时关闭；LIBERO 先剔除失败轨迹。为保持记忆学习中的时序顺序，采样器按同一 episode 提取有序帧。（附录 C.2–C.4）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_5" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2235.0" as="sourcePoint"/><mxPoint x="1942" y="2235.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_6" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文通用设置为 8×A100、全局 batch 256、学习率 2×10⁻⁵，动作专家用预测动作与真值的 MSE 去噪损失。Bridge 训练 50k 步、Fractal 80k；LIBERO 的 Spatial／Object／Goal 各 20k，Long-10 与 Long-90 联合 40k；Mikasa 五任务联合 20k；真机依任务约 5k–20k。普通任务记忆长度 16，真机长时序任务设 256。不同基准各自训练，不能将其当成一个单一联合模型的成绩。（第 3.4、4 节；附录 C.3）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2495" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_6" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2744.5" as="sourcePoint"/><mxPoint x="1942" y="2744.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_3_field_7" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：先把当前画面与任务指令联系起来，再查过去的信息，使动作不只依赖眼前一帧&lt;br&gt;贡献 2：记忆库既存物体等视觉线索，也存“这一步完成了吗”等任务含义，便于之后查找&lt;br&gt;贡献 3：动作模型读入相关记忆后，一次生成一小段连续动作；这样动作可考虑先前步骤&lt;br&gt;流程：看到画面并读指令→整理并保存重要信息→查找相关旧记忆→生成并执行一段动作" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="3022" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_3_branch_7" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3271.5" as="sourcePoint"/><mxPoint x="1942" y="3271.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_4_field_1" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;骨干先利用 Open X-Embodiment。下游分别使用 BridgeData V2、RT-1 数据、LIBERO 示范及 Mikasa-Robo 官方示范；真机在 Franka、WidowX 上用操纵杆遥操作采集。真机通用任务每项 50–150 条，长时序任务每项 200–300 条；Mikasa 五项任务各 250 条。不能把“150+ 任务”误写成训练轨迹数。（第 4 节；附录 C）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_4_branch_1" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_4_field_2" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真涵盖 SimplerEnv-Bridge（WidowX，四任务、每任务 24 次）、SimplerEnv-Fractal（Google 机器人，Visual Matching／Visual Aggregation）、LIBERO 五套（Franka；Spatial、Object、Goal、Long-10、Long-90）和 Mikasa-Robo 五任务（Franka；每任务 100 次），加上 Franka 与 WidowX 的两套真机评测，共计 150+ 任务、500+ 变化。基线依场景不同：Bridge／Fractal 有 CogACT、π0、OpenVLA、Octo、TraceVLA 等；LIBERO 有 CogACT、π0、Diffusion Policy 等；Mikasa 对比 OpenVLA-OFT、π0、SpatialVLA、CronusVLA；真机对比 OpenVLA、π0、CogACT。不同表中的 π0 输入、模型复现与附加状态不尽相同，不能跨表直接横比。（第 4.1–4.5 节，表 1–5）" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_4_branch_2" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="934.0" as="sourcePoint"/><mxPoint x="2632" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_4_field_3" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机有 6 项通用任务＋6 项长时序任务，使用 Franka 与 WidowX、固定正前方 Intel RealSense D435 RGB 相机，经 ROS 集成。通用任务每项通常 15 次，Pick Diverse Fruits 为五变体各 5 次、共 25 次；长时序任务每项 10–15 次，按子目标进度给 step-wise score。比较方法都只用第三人称 RGB 和语言。论文未给单一通用控制频率，不能据 30 fps 相机频率推断动作控制频率。（第 4.5 节，表 5；附录 C.2）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_4_branch_3" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1548.5" as="sourcePoint"/><mxPoint x="2632" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_4_field_4" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 1–4：Bridge 平均成功率 71.9%（CogACT-Large 57.3%，π0-Beta 68.4%；相对 CogACT +14.6 个百分点）；Fractal 整体 72.7%（CogACT 68.1%，分为 VM 77.7%、VA 67.7%）；LIBERO 五套平均 96.5%（CogACT 93.2%，其中 Long-10 93.4%、Long-90 95.6%）；Mikasa 平均 41.2%（π0 29.4%，但 Intercept Medium 上本方法 24%、π0 42%，不能说逐任务都领先）。表 5：真机通用任务 85%（CogACT 76%），长时序 83%（CogACT 57%，+26 个百分点）；两套等权平均 84%。真机长时序使用进度评分，不应与仿真二元成功率混称。（第 4.2–4.5 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_4_branch_4" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2128.0" as="sourcePoint"/><mxPoint x="2632" y="2128.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_4_field_5" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bridge 表 6：只保留 Cognitive Memory 63.5%，只保留 Perceptual Memory 64.6%，两者联合 71.9%；记忆长度 4／16／64 分别 67.7／71.9／67.7%。表 7：不加时间位置编码 69.8%，门控融合 71.9% 对直接相加 67.7%，相似条目合并 71.9% 对 FIFO 66.7%。这些实验支持双流记忆、时序编码及控制冗余的各自贡献。（第 4.6 节，表 6–7）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2458" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_4_branch_5" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2690.0" as="sourcePoint"/><mxPoint x="2632" y="2690.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_4_field_6" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文图 1 的 Push Buttons：按下前后视觉几乎一样，当前帧策略可能重复按；这是本文要处理的时序混淆案例。即便引入记忆，Mikasa 的 Intercept Medium 只有 24%，低于 π0 的 42%；附录 OOD 分析中未见过的相机视角会使成功率明显下降，例如文中报告一项相机变化条件为 42.0%。这些是报告中的任务／扰动弱项，不等于作者给出了统一的故障分类或恢复策略。（图 1；表 4；附录 B）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2950" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_4_branch_6" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3199.5" as="sourcePoint"/><mxPoint x="2632" y="3199.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_5_field_1" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;环境动态类型：静态随机化；物体会随机器人操作改变，但未验证外部异步移动目标" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_5_branch_1" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_5_field_2" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者提出的未来工作：加入 memory reflection，使长期记忆与 LLM 输入空间对齐，以及通过更持久的巩固机制发展 lifelong memory，说明当前实现尚未覆盖这些能力。（第 5 节）本库分析：结果集中在单臂 7-DoF 动作和给定基准；Mikasa 部分任务及新相机视角仍脆弱。真机长程比较按阶段进度计分，不能据此断言它能自动发现并修复任意执行故障。（第 3.4、4.4–4.5 节；附录 B）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_5_branch_2" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="780.0" as="sourcePoint"/><mxPoint x="3322" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_5_field_3" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对长时序操作，双流记忆可分别保存“之前看到了什么”和“哪个子目标已完成”，为研究动作历史、阶段判断和跨时刻决策提供可复现实验基线。潜在研究启发：若接入执行错误检测，可检索错误发生前的计划、动作和视觉状态，再决定是否重试或改道；MemoryVLA 本文验证的是时序记忆带来的任务收益，没有验证通用 Failure Recovery。（第 1、4–5 节）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_5_branch_3" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1272.0" as="sourcePoint"/><mxPoint x="3322" y="1272.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_01_5_field_4" parent="paper_01" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者主要研究怎样利用历史来做长任务；没有把“执行失败后如何补救”作为核心问题&lt;br&gt;我的理解 / 不足：它帮助机器人记住过去，但没有单独说明怎样发现抓取失败、找出原因并恢复&lt;br&gt;未来展望：可检查记忆保存多久、哪些历史值得留，以及预期结果与实际结果不一致时怎么办&lt;br&gt;对我们项目的启发：失败时应查已完成步骤和过去动作，再判断从哪一步开始偏离，而非只看当前画面" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1532" as="geometry"/>
        </mxCell>
        <mxCell id="paper_01_5_branch_4" edge="1" parent="paper_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1781.5" as="sourcePoint"/><mxPoint x="3322" y="1781.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
