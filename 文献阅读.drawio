            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><mxCell id="paper_67_1_field_1" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CoRL&lt;br&gt;引用量：16（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_1_branch_1" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_1_field_2" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_1_branch_2" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_1_field_3" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Bimanual Manipulation / Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论双臂扩散策略生成的动作可能违反安全和协调约束。&lt;br&gt;核心思路是SafeBimanual 在测试时对预训练扩散策略的轨迹进行优化，加入安全约束。&lt;br&gt;与当前项目的联系：项目联系：双臂普通夹爪真机部署需要碰撞与工作空间限制" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_1_branch_3" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_1_field_4" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：双臂扩散策略生成的动作可能违反安全和协调约束&lt;br&gt;&lt;br&gt;为什么重要：将安全约束放在策略与真机控制器之间，便于与现有策略组合" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_1_branch_4" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1680.0" as="sourcePoint"/><mxPoint x="562" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_1_field_5" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：双臂协作与安全控制&lt;br&gt;扩散策略会从噪声逐步生成未来一段双臂动作；SafeBimanual 在部署时修改这段动作，使夹爪、物体之间的几何关系更安全，并按任务阶段更新约束&lt;br&gt;核心问题：两臂各自的动作可能看似合理，合起来却会撞到彼此、戳坏物体或把共同抓住的物体拉扯变形&lt;br&gt;作者问能否在保留原策略任务能力的同时，按操作阶段为生成轨迹加入合适的物理约束&lt;br&gt;之前方法的问题：扩散策略会拟合示范动作分布，却不显式保证双臂同步和接触安全；固定的手工轨迹约束也难覆盖倒水、交接、搬运等不同阶段&lt;br&gt;只用一个恒定安全代价可能与当前任务动作冲突，反而降低成功率" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1905" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_1_branch_5" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2242.0" as="sourcePoint"/><mxPoint x="562" y="2242.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_2_field_1" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;之前方法的问题：训练完成后的策略不一定知道新的障碍物或当前碰撞边界" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_2_branch_1" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_2_field_2" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_2_branch_2" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="829.0" as="sourcePoint"/><mxPoint x="1252" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_2_field_3" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：Diffusion Policy、DP3 和 RDT-1b 能依据图像、点云等观察生成连续双臂动作段，论文把它们作为可插入安全修正的预训练基座&lt;br&gt;它们本身未对夹爪碰撞、物体撕扯等五类危险设置显式约束&lt;br&gt;相关方向 2：传统轨迹优化用几何或接触代价避障，但双臂高自由度操作需随阶段切换约束&lt;br&gt;ReKeP 式视觉关键点提供物体上的可计算位置；本文进一步把这些位置用于扩散去噪时的梯度引导&lt;br&gt;代表工作：VoxPoser、ReKeP 利用视觉语言模型推断操作区域或约束，提供语义推理思路；DP、DP3、RDT-1b 是本文量化对照的动作策略&lt;br&gt;这些模型没有自动构成 SafeBimanual 的完整安全系统，仍需关键点、位姿与动力学接口&lt;br&gt;与已有方法的区别：作者分析 7 个基准、65 个任务的 1320 条示范，归纳五类主要危险，再写成可微的安全代价&lt;br&gt;视觉语言模型依据当前阶段选代价和关键点，最后几轮去噪才修正轨迹，避免从一开始就强行压缩动作多样性" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_2_branch_3" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1478.5" as="sourcePoint"/><mxPoint x="1252" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_3_field_1" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;SafeBimanual 在测试时对预训练扩散策略的轨迹进行优化，加入安全约束" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_3_branch_1" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_3_field_2" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：单一碰撞约束覆盖不了倒水错位或共同抓物时的拉扯；作者分别定义物体碰撞、行为对齐、夹爪戳碰、夹爪撕扯和夹爪互撞五种代价&lt;br&gt;它们由物体关键点、夹爪尖位置和正向运动学计算，能对双臂关节轨迹求梯度&lt;br&gt;贡献 2：任务阶段不同，需保护的对象也不同；作者让 GPT-4o 根据画面、指令、阶段和关系关键点判断危险类型，再只启用相关代价&lt;br&gt;物体点由视觉提议与跟踪，夹爪点由机器人运动学给出；固定权重的所有代价可能互相妨碍&lt;br&gt;贡献 3：直接修改高噪声动作难判断几何风险；作者在去噪过程中先估计较干净的动作段，再用安全代价梯度调整最后几步采样&lt;br&gt;原扩散策略权重无需为这套安全代价重新训练，但效果依赖位姿、关键点与视觉语言模型判断质量&lt;br&gt;方法流程：相机、机器人状态和任务阶段 → 估计物体姿态及关键点 → 判断当前危险并选择代价&lt;br&gt;预训练扩散策略生成双臂动作段，最后几轮去噪按代价梯度修正 → 执行一段动作、更新观察和阶段后重新规划" vertex="1">
          <mxGeometry height="884" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_3_branch_2" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="990.0" as="sourcePoint"/><mxPoint x="1942" y="990.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_3_field_3" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1460" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_3_branch_3" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1674.5" as="sourcePoint"/><mxPoint x="1942" y="1674.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_4_field_1" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：双臂扩散策略的测试时轨迹优化任务；具体 benchmark 见论文&lt;br&gt;&lt;br&gt;主要结果：论文摘要未提供可安全复述的统一量化结果&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：双臂扩散策略的测试时轨迹优化任务；具体 benchmark 见论文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：论文摘要未提供可安全复述的统一量化结果" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_4_branch_1" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_4_field_2" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：RoboTwin 八项双臂仿真任务包括双瓶抓取、交接、堆叠和倒水；DP、DP3、RDT-1b 各用每任务 50 条示范训练或微调&lt;br&gt;每项测试 100 次，成功率要求整任务成功且无危险；危险率统计至少出现一次五类危险的回合&lt;br&gt;对照：同一基座分别比较加与不加 SafeBimanual；DP 的消融还逐项去掉五种代价，并把动态选择改为固定权重或去掉分步推理&lt;br&gt;这些试验检验改善是否来自安全引导及阶段调度，而非换了更强的基座策略&lt;br&gt;结果：表 1 中 DP 平均成功率 20.7%→36.0%、危险率 45.6%→20.9%；DP3 为 53.9%→67.3%、35.3%→19.1%&lt;br&gt;RDT-1b 为 36.4%→48.9%、50.8%→35.3%；三个基座的平均成功增益约 13.7 个百分点，不能说危险已经清零&lt;br&gt;真机 / 补充：Galaxea R1 四项双臂任务的成功率分别为 70→90、40→70、30→70、20→60%，平均提升 32.5 个百分点&lt;br&gt;表 2 的 DP 消融中，固定权重成功率 19.4%、危险率 42.5%，动态调度为 35.5% 和 19.8%，说明选对阶段约束很关键" vertex="1">
          <mxGeometry height="919" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_4_branch_2" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1196.5" as="sourcePoint"/><mxPoint x="2632" y="1196.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_5_field_1" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：双臂普通夹爪真机部署需要碰撞与工作空间限制&lt;br&gt;&lt;br&gt;主要局限：优化耗时、约束保守程度和任务成功率之间的权衡需实测&lt;br&gt;&lt;br&gt;局限与启发：主要局限：优化耗时、约束保守程度和任务成功率之间的权衡需实测" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_5_branch_1" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_5_field_2" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：极端拥挤场景仍可能发生危险，方法不能保证绝对安全；错放顺序等语义错误也不由几何代价解决&lt;br&gt;视觉关键点和物体位姿会受遮挡与噪声影响，视觉语言模型有时还会选出不完整或次优约束&lt;br&gt;我的理解 / 不足：安全率依赖论文定义的五类危险及阈值，不能等同于力控或硬件安全认证&lt;br&gt;共同抓物采用段内固定抓取偏移假设；对易滑动物体、柔软材料或 DH116 多指接触，偏移和受力可能随时间变化，这是适用范围推断&lt;br&gt;未来展望：可在接触阶段结合触觉、力矩与实时碰撞检测，检查关键点模型是否遗漏隐蔽风险&lt;br&gt;还应记录每次调度所选代价、轨迹修正幅度、额外延迟和任务失败类型，再评估更复杂的语义顺序纠错&lt;br&gt;对我们项目的启发：双臂机械臂可先借鉴五类危险的分阶段检测与去噪引导，逐项测成功率和危险率&lt;br&gt;若接入 DH116，须重新定义指尖、物体接触和关节安全边界；论文未证明其夹爪代价可直接覆盖多指手或失败恢复" vertex="1">
          <mxGeometry height="849" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_5_branch_2" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1091.5" as="sourcePoint"/><mxPoint x="3322" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
