            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_1_field_3" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 VLA 方向，主要讨论VLA 在连续控制中反复处理相邻视觉帧的重复内容，造成在线推理延迟。&lt;br&gt;核心思路是免训练地在相邻帧间复用静态视觉 token 的 KV 表示，并用 attention 和层级自适应策略保护任务相关区域。&lt;br&gt;与当前项目的联系：可作为双臂 VLA 推理加速候选，但需在双臂动态视角与本地控制栈上单独评估" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_1_branch_3" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_1_field_4" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA 在连续控制中反复处理相邻视觉帧的重复内容，造成在线推理延迟" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_1_branch_4" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_1_field_5" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：跨帧时间信息复用与 VLA 在线推理&lt;br&gt;Token 是图像切成的小块表示；KV 缓存保存网络注意力计算中的键和值，让稳定区域下一帧不必重新计算相同特征&lt;br&gt;核心研究问题：机器人连续控制时反复看相邻画面，背景等多数区域变化很小，VLA 却每次都重新处理，增加延迟&lt;br&gt;作者问能否复用稳定视觉计算，同时仍及时更新夹爪、目标物等对当前动作关键的内容&lt;br&gt;之前方法的问题：单帧删减 token 可以减算力，却可能删掉静止但任务重要的目标或接触区域&lt;br&gt;若只凭两帧外观相似决定缓存，论文消融显示成功率会明显下降，因此需要识别任务相关性和不同网络层的重要性" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_1_branch_5" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2175.5" as="sourcePoint"/><mxPoint x="562" y="2175.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_2_field_1" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;之前方法的问题：单帧 token pruning 可能同时移除对当前夹爪和目标物判断关键的视觉信息" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_2_branch_1" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_2_field_2" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_2_branch_2" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_2_field_3" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：OpenVLA 等基座模型从图像和指令生成动作，在线每步执行视觉编码与解码&lt;br&gt;VLA-Cache 不重新训练策略，而是在重复观察之间复用内部视觉表示，因此延迟和任务成功率必须一起比较&lt;br&gt;相关方向 2：SparseVLM、FastV 之类单帧裁剪方法减少视觉 token，但不利用上一帧已有计算&lt;br&gt;跨帧缓存能利用场景的时间连续性；如果环境剧烈变化，能复用的区域减少，收益也会变小&lt;br&gt;代表工作：论文在 LIBERO 用 OpenVLA/OpenVLA-OFT，在 SIMPLER 用 CogACT，在 Kinova 真机用 OpenVLA 作基座&lt;br&gt;这些是被加速模型；SparseVLM、FastV 是效率对照，不能说它们提供了本篇的注意力缓存模块&lt;br&gt;与已有方法的区别：先按 patch 相似度找稳定区域，再用 decoder attention 排除任务关键 token，最后按层的注意力熵调节复用数量&lt;br&gt;这比单一固定阈值更能在速度与成功率之间折中，不要求改机器人动作头" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_2_branch_3" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1499.5" as="sourcePoint"/><mxPoint x="1252" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_3_field_1" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：免训练地在相邻帧间复用静态视觉 token 的 KV 表示，并用 attention 和层级自适应策略保护任务相关区域&lt;br&gt;&lt;br&gt;输入：相邻时刻的图像帧、语言任务上下文及基座 VLA 的视觉 token/decoder attention&lt;br&gt;&lt;br&gt;输出与动作：保持原 VLA 基座动作输出；VLA-Cache 只改变推理中的视觉 token 计算与 KV 复用" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_3_branch_1" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_3_field_2" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：相邻帧大量内容重复，作者计算对应图像块的余弦相似度，选出外观稳定的候选 token&lt;br&gt;只复用这些 token 的上一帧 Key/Value，动态区域重新计算，从而减少重复推理而不是跳过整帧观察&lt;br&gt;贡献 2：目标物即使外观不变也可能决定抓取动作，作者读取解码器对视觉 token 的注意力，剔除任务相关区域的缓存候选&lt;br&gt;这样仍重新处理夹爪与目标等关键表示，避免仅按静态相似度缓存造成明显任务失败&lt;br&gt;贡献 3：不同网络层对视觉信息的依赖不同，作者根据各层注意力熵自适应分配复用比例&lt;br&gt;无需重新训练 OpenVLA 或 CogACT，就能在多个基座与动作头上插入相同的推理优化思路&lt;br&gt;方法流程：当前/上一帧图像 → 图像块相似度筛出静态候选 → decoder 注意力排除任务敏感区域&lt;br&gt;按层分配缓存比例 → 稳定 token 复用上帧 KV、其余重算 → 原 VLA 动作头照常输出动作" vertex="1">
          <mxGeometry height="814" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_3_branch_2" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1109.0" as="sourcePoint"/><mxPoint x="1942" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_3_field_3" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1544" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_3_branch_3" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1758.5" as="sourcePoint"/><mxPoint x="1942" y="1758.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_4_field_1" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：LIBERO、SIMPLER，以及 Kinova Jaco2 四项真机操作任务&lt;br&gt;&lt;br&gt;主要结果：LIBERO 上 OpenVLA 延迟从 51.91 ms 降至 31.83 ms，平均成功率从 75.0% 变为 74.7%；真机平均成功率为 82.1%→84.6%" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_4_branch_1" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_4_field_2" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：LIBERO 四类任务各含十项；SIMPLER 有两种视觉设置；Kinova Jaco2 单臂真机执行取锅、放方块、放香肠、擦桌四任务&lt;br&gt;同时报告任务成功率、理论计算量、GPU 延迟和控制频率，避免只看运行速度&lt;br&gt;对照：LIBERO 比较未缓存 OpenVLA 与加缓存版本，也比较单帧加速方法；SIMPLER 以 CogACT 为基座&lt;br&gt;消融分别只用静态相似度、再加任务注意力过滤、再加逐层自适应，检验成功率回升来自哪部分&lt;br&gt;结果：LIBERO 的 OpenVLA 平均成功率 75.0%→74.7%，GPU 延迟 51.91→31.83 毫秒，速度收益伴随 0.3 个百分点下降&lt;br&gt;真机四任务平均成功率 82.1%→84.6%，延迟 64.16→51.85 毫秒；并非每项任务都提升&lt;br&gt;真机 / 关键补充：只用静态相似度缓存的成功率在消融中 84.4%→74.2%；加入注意力过滤和层自适应后回到 83.8%&lt;br&gt;动态背景下 PickPot 基线从 95% 降至 80%，加缓存仍为 80%；这证明加速，并未消除运动干扰" vertex="1">
          <mxGeometry height="884" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_4_branch_2" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1039.0" as="sourcePoint"/><mxPoint x="2632" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_5_field_1" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;可作为双臂 VLA 推理加速候选，但需在双臂动态视角与本地控制栈上单独评估" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_5_branch_1" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_58_5_field_2" parent="paper_58" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：场景大范围运动会减少可复用视觉区域，使加速收益下降；不同于所测 LLaMA2 解码器的架构尚需验证&lt;br&gt;作者还建议真实部署持续监控，以保障安全与可靠性&lt;br&gt;我的理解 / 不足：该方法优化计算，不修正错误动作或过期场景记忆；Kinova 单臂四任务不足以说明双臂遮挡时也能稳住成功率&lt;br&gt;PickPot 的真机成功率从 95% 降到 90%，提示平均值可能掩盖个别任务退化&lt;br&gt;未来展望：按目标运动、双臂遮挡和动作不确定性触发局部或全量重算，并同时记录缓存比例、延迟和整任务成功率&lt;br&gt;这种风险触发缓存失效是研究设想，原论文尚未证明其效果&lt;br&gt;对我们项目的启发：若机械臂 VLA 控制频率受视觉推理限制，可先离线测静态背景与双臂动态画面的缓存命中率&lt;br&gt;接入 DH116 前必须验证关键手指/目标区域不会被误缓存，不能把推理加速当失败恢复能力" vertex="1">
          <mxGeometry height="849" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_58_5_branch_2" edge="1" parent="paper_58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
