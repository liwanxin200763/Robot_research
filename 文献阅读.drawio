          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 2：用机器人状态与视觉语言特征构建状态感知重表示。不是仅把两个向量并排放，而是建立交互，让动作模块知道视觉目标对应当前身体哪种动作" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="700" as="sourcePoint"/>
            <mxPoint x="1199" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 3：动作专家用流匹配生成未来动作段；视觉语义与动作相关特征分开处理再连接，让通用视觉理解能服务具体机器人的连续控制" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_4" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="940" as="sourcePoint"/>
            <mxPoint x="1199" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_4" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="方法流程：语言+多视角历史 → 选择性压缩 → 视觉语言编码 → 与本体状态交互重表示 → 动作专家生成动作段 → 执行 → 重新观察与更新历史" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_drop" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1788" y="14" as="sourcePoint"/>
            <mxPoint x="1788" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_header" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="D. 实验与结果" vertex="1">
          <mxGeometry height="58" width="390" x="1593" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_field_rail" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="88" as="sourcePoint"/>
            <mxPoint x="1603" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_branch_1" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="220" as="sourcePoint"/>
            <mxPoint x="1615" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_1" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="实验：在 LIBERO、SIMPLER 仿真及 Franka、双臂 Aloha 真机上测试；数据含22项原子子任务组成7个顺序长任务，另6个连续长任务平均2.3分钟。完整成功与步骤进度分开报告" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="460" as="sourcePoint"/>
            <mxPoint x="1615" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对照：比较 π0 等策略，消融历史与状态感知模块。消融是去掉某个组件重测，检查效果是否确由该设计带来" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="700" as="sourcePoint"/>
            <mxPoint x="1615" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：LIBERO 平均成功率91.2%；移除状态感知组件为84.7%。这一对照支持状态与视觉交互有效，不能证明所有差异都来自历史长度" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_4" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="940" as="sourcePoint"/>
            <mxPoint x="1615" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_4" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：真机单步骤平均46.1%，π0 为36.8%。论文的长任务倍数有“至少完成2步”等口径，不能把它改写成完整长任务成功率的倍数" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_5_drop" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
