          </mxGeometry>
        </mxCell>
        <mxCell id="paper_53_1_field_4" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：普通图像特征容易忽视高度和距离；各动作维度均匀分箱可能把常用小动作分得太粗，迁移新机器人时动作分布也会改变" vertex="1">
