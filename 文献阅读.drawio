            <mxPoint x="1603" y="940" as="sourcePoint"/>
            <mxPoint x="1615" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_46_4_field_4" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：评估按多个随机种子和每阶段50次执行统计；Rollout（一次执行）是策略从初始状态运行到结束的完整过程。本轮未发现真机部署成功率证据" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
