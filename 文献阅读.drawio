        <mxCell id="paper_99_pdf" parent="paper_99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;03_双臂协作\&lt;br&gt;Mobile_ALOHA.pdf" vertex="1">
