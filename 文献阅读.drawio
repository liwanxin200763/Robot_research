          </mxCell>
        </UserObject>
        <UserObject id="category_02_paper_21" label="#21 DynaMem&lt;br&gt;要解决：杯子昨天在桌上、今天被拿走了。机器人怎样不再去旧位置找它？&lt;br&gt;年份 / Venue：2024，arXiv:2411.04999&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-21" tooltip="点击进入页面">
