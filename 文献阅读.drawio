          </mxCell>
        </UserObject>
        <UserObject id="category_07_paper_53" label="#53 SpatialVLA&lt;br&gt;要解决：模型知道“拿杯子”，却可能分不清该伸多远、抬多高。怎样把三维位置和动作几何关系显式放进模型，并在换机器人时适配？&lt;br&gt;年份 / Venue：2025 / RSS 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-53" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="980" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_07_paper_54" label="#54 Sim2Real-VLA&lt;br&gt;要解决：仿真画面与真实背景、物体材质不同，直接学动作容易失效。能否以物体关键交互为中间目标，让模型关注任务必要运动而不是环境外观？&lt;br&gt;年份 / Venue：2026 / ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-54" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="980" width="980" height="280" as="geometry"/>
