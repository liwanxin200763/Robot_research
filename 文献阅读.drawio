        </UserObject><UserObject id="paper_133_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-134" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_133_1_field_1" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与时间线&lt;/b&gt;&lt;br&gt;&lt;br&gt;UniGraspTransformer: Simplified Policy Distillation for Scalable Dexterous Robotic Grasping，本地10页CVPR开放版与canonical一致。官方 https://arxiv.org/abs/2412.02699 首次2024年12月3日，v2为2025年3月4日，正式CVPR 2025；因此方法首次公开在2024年，不能只按会议年推断。官方Microsoft仓库可核验，当前运行依赖未实际安装测试。旧卡引用量28本次未重新核验。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_1_branch_1" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_1_field_2" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wenbo Wang、Fangyun Wei、Lei Zhou、Xi Chen、Lin Luo、Xiaohan Yi、Yizhong Zhang、Yaobo Liang、Chang Xu、Yan Lu、Jiaolong Yang、Baining Guo；Microsoft Research Asia、University of Sydney、National University of Singapore。代码/项目核验：https://github.com/microsoft/UniGraspTransformer；项目 https://dexhand.github.io/UniGraspTransformer/。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_1_branch_2" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="899.0" as="sourcePoint"/><mxPoint x="562" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_1_field_3" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体问题与适用范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;要让一个灵巧抓取策略控制上千物体，直接多任务RL常学不好，复杂的分组、课程、渐进蒸馏又难扩展。本文问能否先把单物体专家做强，再大量收集成功轨迹，用更大Transformer一次离线监督学成通用策略。它研究单一Shadow Hand的物体泛化，不是跨手型泛化，也不涵盖一般手内操作。当前PDF正文提及奖励和输入附录，但本地最后两页为参考文献，独立补充材料未在文件内，不假装已核验缺失公式。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_1_branch_3" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1443.5" as="sourcePoint"/><mxPoint x="562" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_2_field_1" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人蒸馏机制与本研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;UniDexGrasp/UniDexGrasp++先训练通才、按几何聚类成专才，再多轮课程和在线蒸馏；学生边行动边查询教师，网络容量与优化稳定性互相限制。本文把“找成功抓法”和“学统一表征”拆开：每物体一个小MLP专家，成功轨迹离线保存成大数据集，学生用较大Transformer拟合。这简化训练组织，并允许学生训练时换成部分点云等较真实输入，而动作监督仍来自全状态专家。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_2_branch_1" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_2_field_2" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语解释与输入边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略蒸馏是让一个学生复制多个专家的动作知识，并非压缩语言模型。状态版直接读取仿真完整点云、精确物体位姿；视觉版用五相机深度重建部分点云和估计位姿，依旧是仿真环境中的视觉观测，不自动等于真机验证。部分点云编码器向完整点云编码器的特征蒸馏，是训练感知特征的额外监督，与整策略专家到学生蒸馏需区分。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_2_branch_2" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_3_field_1" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：定义手与动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;Isaac Gym 3.0里用Shadow Hand，手指18主动自由度、腕部6自由度，共24维控制；除拇指外各指还有被动关节。腕部用三维力和力矩，手指用目标关节角，故动作不是一般机械臂末端位姿增量。专家输入包括手腕/手指/指尖状态、上次动作、物体状态、手上36点至物体的距离及时间嵌入，专家可使用完整仿真真值。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_3_branch_1" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_3_field_2" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：训练每物体专家&lt;/b&gt;&lt;br&gt;&lt;br&gt;对3200个训练物体各训练独立PPO策略，物体随机旋转落桌形成不同初始姿态。专家为四层MLP，任务短且对象固定，减少共享策略在不同物体间相互干扰。奖励先鼓励接近物体并保持手张开；距离达到接触阈值后激活抬升、目标到达与成功奖励。距离用手上多个点到物体点云，而非只到中心，可让细长或不规则形状拥有更合理的接触监督。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_3_branch_2" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="829.0" as="sourcePoint"/><mxPoint x="1942" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_3_field_3" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：生成多姿态成功轨迹&lt;/b&gt;&lt;br&gt;&lt;br&gt;每专家反复随机初始化对象，收集1000条成功抓取轨迹，合计320万条。每条最多200步，逐时刻保存状态与24维专家动作。只收成功轨迹让学生集中学习有效行为，同时减少失败恢复示范；是否能恢复训练分布外的接触偏差，需要另行测试。320万是轨迹数，不是物体数，也不等于所有轨迹都恰好满200帧，不能随意乘成已确认总动作帧。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_3_branch_3" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_3_field_4" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：六组输入变token&lt;/b&gt;&lt;br&gt;&lt;br&gt;通用学生将本体感觉、上次动作、物体状态、手物距离、时间、物体几何特征分别用MLP映射为256维token，再让12层自注意力交换信息。物体几何先采1024点，由类似PointNet的S-Encoder编码成128维，训练时解码重建点云、用Chamfer距离监督；推理只保留编码器。六个token代表同时刻的信息组，不是六个连续时间步，不能把Transformer自动解释成长期记忆。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_3_branch_4" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1813.0" as="sourcePoint"/><mxPoint x="1942" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_3_field_5" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：动作监督蒸馏&lt;/b&gt;&lt;br&gt;&lt;br&gt;学生经过自注意力和四层MLP头预测24维动作，以专家动作的L2误差训练，未用额外课程或渐进蒸馏。时间token含当前时刻和正弦余弦编码，帮助区分接近与抬升阶段；手物距离token显式提供接触几何。正文一处写距离26维，但表1与专家说明均为36维，笔记按表记录并标内部不一致，复现时仍需看官方代码。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_3_branch_5" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2287.5" as="sourcePoint"/><mxPoint x="1942" y="2287.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_3_field_6" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤六：适应视觉输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;五个桌边/顶置相机从深度重建部分物体点云，先分割去掉手点云；以部分云中心估物体位置、PCA估旋转，用部分云重新计算手物距离。V-Encoder采用相同几何网络，并接受完整云S-Encoder特征的蒸馏约束，让遮挡下特征尽量接近完整形状。然后以估计状态训练同结构动作学生。这里用的是估计输入来模仿理想动作，不要求部署时获得真实完整网格。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2530" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_3_branch_6" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2762.0" as="sourcePoint"/><mxPoint x="1942" y="2762.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_4_field_1" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据规模与评测分母&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练3200物体、133类别；测试包括相同3200物体的新初始姿态、已见类别140个新物体、未见类别100个新物体。每对象随机旋转落桌1000次，200步内到目标算成功，报告所有物体/尝试平均。相应测试尝试规模为320万、14万、10万（按每对象1000次换算）；这是仿真评测，未报告真实机器人rollout。官方正文也未给与所有数字一致的多训练种子方差。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_4_branch_1" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_4_field_2" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;单物体专家在3200训练对象平均94.1%。统一状态策略已见/新对象同类/新类为91.2/89.2/88.3%，UniDexGrasp++为87.9/84.3/83.1%；视觉策略为88.9/87.3/86.8%，对照85.4/79.6/76.7%，因此视觉新类别提高10.1个百分点，不是相对10.1%。视觉版仍低于对应全状态版，表明遮挡与状态估计带来损失。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_4_branch_2" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_4_field_3" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;扩展与模型消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;状态版3200对象、每对象成功轨迹200/500/1000条时成功87.2/89.3/91.2%；只用MLP85.5%、6自注意力块89.7%、12块91.2%。400对象子集上在线DAgger88.2%、离线Transformer92.5%，该结果不能直接写成3200对象上的DAgger对比。扩展对象数400→3200时对应已见对象成功92.5→91.2，说明扩展后仍有小幅损失，但测试集合随之变化，不能据此单独估计跨对象规模定律。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_4_branch_3" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_4_field_4" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入、奖励与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉无中心/PCA估计为83.2%，加中心86.4%，加PCA88.9%；V-Encoder无特征蒸馏86.7%，有88.9%。单物体专家奖励用中心距离90.3%，改点云距离92.9%，再加接触前张手94.1%。3200专家在16张V100训练80小时；学生8张A100约70小时、100 epoch、批量800轨迹；几何编码器单A100约40小时。论文没有提供部署推理延迟或真实运行功耗。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_4_branch_4" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1813.0" as="sourcePoint"/><mxPoint x="2632" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_5_field_1" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者报告范围与尚未证明项&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者展示了大模型离线蒸馏的可扩展性及较多样抓型，但未设置独立局限段。正文证据止于仿真状态版与多视深度版，不能从摘要“real-world inputs”表述推出已经真机部署。抓型多样性以3200对象各10条成功轨迹、归一化关节范围分析，不等同于功能抓取质量，也未覆盖给失败状态恢复的完整控制。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_5_branch_1" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_5_field_2" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116迁移分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;流程适合先给DH116少量对象训练可靠专家，再比较离线统一学生；但必须重建手的主动/被动自由度、关节耦合及控制接口，不能照抄Shadow的24维力矩/位置混合动作。本体输入里的关节/指尖力等仿真量，在真机不一定可直接测；建议做可部署观测清单，并逐步拿掉不可得的真值，避免视觉版仍借用隐含特权量。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_5_branch_2" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="811.5" as="sourcePoint"/><mxPoint x="3322" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_5_field_3" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;视觉与Sim2Real验证建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;五相机部分点云+PCA在对称或严重遮挡对象上可能出现姿态歧义，此点是几何分析推断，本文未单独量化。可先比较单/多相机、不同遮挡、估姿噪声与触觉辅助；同时检查学生只学成功轨迹后如何应对滑移。需要分开统计专家成功、蒸馏损失、仿真闭环、真机闭环与跨手型适应，不能把86.8%搬到DH116新类别成绩，也不能声称已实现双臂Sim2Real。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_5_branch_3" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1286.0" as="sourcePoint"/><mxPoint x="3322" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_133_5_field_4" parent="paper_133" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成功数据与真实传感差异分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练只保留成功轨迹，利于学习可靠抓法，却没有系统覆盖将掉未掉或严重偏位等恢复状态。学生输入还含时间和前一动作，若真实运行时频率、动作延迟与仿真不同，阶段判断可能失配。可在统一评测里加入控制延迟、初始姿态和点云遮挡扰动，检查成功示范蒸馏是否仍保持闭环稳定。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_133_5_branch_4" edge="1" parent="paper_133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1760.5" as="sourcePoint"/><mxPoint x="3322" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-134" name="06-15 Cross-Embodiment Grasping">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3900" background="#F7FBFF" math="0" shadow="0">
