            <mxGeometry x="2160" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_38_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-39" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_38_1_field_1" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICLR&lt;br&gt;引用量：313（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_1_branch_1" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_1_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：只看当前图像的 VLA 容易忽略机器人刚刚如何移动及物体是否被推动；直接堆叠多张历史图像又带来大量冗余视觉 Token。（论文第 1、3.1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：在不改动原有低层动作接口的前提下，把短期运动历史压缩成 VLA 易读取的视觉提示，提高相机视角、背景、干扰物和新目标变化下的操作成功率。（第 1、3 节）" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_1_branch_2" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="902.5" as="sourcePoint"/><mxPoint x="562" y="902.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_1_field_3" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenVLA 的单帧输入缺少运动记忆；直接输入 6 帧历史图像在论文消融中从 40.2% 降到 34.2%。仅把轨迹写成文本虽然有用，却多约 150 个文字 Token，效果弱于把轨迹画到图像上。（第 3.1、4.3 节，图 7–8）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_1_branch_3" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1475.0" as="sourcePoint"/><mxPoint x="562" y="1475.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_1_field_4" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：历史视觉与 VLA（视觉—语言—动作模型：看画面、读指令、输出机器人动作）。用运动轨迹提示当前变化，帮助模型判断物体如何移动&lt;br&gt;核心研究问题：单张画面看不出刚才推向哪边、物体是否在移动。怎样用少量额外信息补时间线索，又不让大量旧画面占满模型输入？&lt;br&gt;之前方法的问题：堆叠旧帧计算多，还要模型自己匹配物体。只输入当前画面可能把运动中与静止物体看成一样，动作容易缺少方向和阶段判断" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1693" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_1_branch_4" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1960.0" as="sourcePoint"/><mxPoint x="562" y="1960.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_2_field_1" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：TraceVLA 保留 OpenVLA 主干与动作 Token，只在输入侧提供视觉化短期历史；与 SpatialVLA 直接编码 3D 相机空间不同，它不需要深度但依赖点追踪。与把历史堆帧相比，图 7 的对照表明轨迹的选择性表示更有效。（第 3–4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_2_branch_1" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_2_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_2_branch_2" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_2_field_3" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：时间建模可以输入多帧或学习隐式记忆；Memory Bank（记忆库：存放历史特征的容器）要决定存哪些、怎样取，训练和接口改动较多&lt;br&gt;相关方向 2：视觉点追踪把同一位置在多帧中的运动连起来。它能提供几何运动，但本身没有“已完成第二步”这样的任务语义&lt;br&gt;代表工作：基于 #52 OpenVLA 和紧凑视觉语言模型测试。VLM（视觉语言模型：理解图像与文字）原有图像理解能力可用于读叠加的轨迹提示&lt;br&gt;与已有方法的区别：#01 MemoryVLA/#14 HAMLET 学习历史模块；本篇把短期运动变成可见的线条，尽量复用模型视觉入口，结构轻但表达内容较有限" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_2_branch_3" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1499.5" as="sourcePoint"/><mxPoint x="1252" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_3_field_1" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;用 CoTracker 从最近 6 帧追踪运动明显的点，挑 5 条点轨迹画到当前画面；将原图与画有轨迹的图同时输入 VLA，让模型直观看到近期末端和物体的运动方向，再预测动作。（图 1–2；第 3.1 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_3_branch_1" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_3_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;图像历史 → CoTracker 密集点追踪 → 筛出运动超过阈值的点 → 采样并绘制彩色视觉轨迹 → 与未覆盖原图、语言指令经分隔 Token 一起送入 OpenVLA 视觉语言主干 → 输出动作 Token。保留原图是为了避免轨迹遮挡夹爪或目标物；训练时随机丢弃轨迹以应对追踪失败。（第 3 节，图 1–2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_3_branch_2" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="762.5" as="sourcePoint"/><mxPoint x="1942" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_3_field_3" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：当前 256×256 RGB 画面、最近约 6 帧图像历史和自然语言指令。点轨迹由历史图像计算，非额外深度或真实机器人状态传感器。视觉提示与原始图像同时输入。（第 3–4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：继承 OpenVLA 的离散化末端动作 Token，表示位置/旋转增量和夹爪动作；视觉轨迹是输入提示，而非模型预测的未来轨迹，也不是独立的高层规划结果。（第 2–3 节）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_3_branch_3" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1272.0" as="sourcePoint"/><mxPoint x="1942" y="1272.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_3_field_4" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;CoTracker 使用 40×40 点网格，选出移动显著的点，再随机采样 5 条，历史窗为 6 帧；训练时对重叠的 12 帧片段做稀疏追踪以节省计算。随机用原图替换轨迹图，增强无追踪结果时的稳健性。附录 C 比较线宽、透明度和颜色，合理范围内性能变化很小。（第 3.1–3.3 节；附录 C）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_3_branch_4" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1764.0" as="sourcePoint"/><mxPoint x="1942" y="1764.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_3_field_5" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 OpenVLA 7B 基础上追加微调 5 个 epoch；Phi-3-Vision 4B 分支先按 OpenVLA 配方在 OXE 预训练 30 epoch、32 张 H100，然后同样微调 5 epoch。两种分支的对照都在相同数据上做了无视觉轨迹的额外微调，用于隔离轨迹贡献。（第 3.3、4.3 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1989" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_3_branch_5" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2186.0" as="sourcePoint"/><mxPoint x="1942" y="2186.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_3_field_6" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：用 CoTracker（跨帧匹配图像点的追踪器）追踪最近6帧的候选点。筛选移动明显的点，避免把静止背景的冗余轨迹全部画上去&lt;br&gt;贡献 2：把选中的少量轨迹叠在当前图像，同时保留原图输入。模型既看物体外观，也看最近运动方向，降低线条遮住重要视觉内容的风险&lt;br&gt;贡献 3：训练时随机丢掉轨迹提示，使模型不会完全依赖追踪器。追踪失败或光照变化时仍可用原图行动，这是应对上游感知不稳定的办法&lt;br&gt;方法流程：最近图像 → 点追踪 → 筛选活动轨迹 → 叠加当前画面并保留原图 → 结合语言指令 → VLA 输出动作 → 执行并更新短期轨迹" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="2411" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_3_branch_6" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2730.5" as="sourcePoint"/><mxPoint x="1942" y="2730.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_1" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 BridgeData V2 与 Google RT-1 机器人数据上计算视觉轨迹，合计约 15 万条带轨迹提示的操作轨迹；另为真机 4 个任务各采集 30 条示范，共 120 条。7B 主干在 Open X-Embodiment 预训练，4B Phi-3-Vision 分支另用约 97 万条 OpenX 轨迹预训练。不能把这几种数据量相加称为一个同质数据集。（第 3.3 节）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_1" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;SimplerEnv Google Robot 测 3 类任务、合计 137 种仿真配置；视觉匹配与变体聚合指标分别关注真实外观对齐和光照、相机、桌面纹理、背景、干扰物变化。基线是 OpenVLA、OpenVLA-Phi3、Octo-Base、RT-1-X。补充材料另在 LIBERO 四套任务测试多任务迁移，每套 10 项、每项 50 条示范。（第 4.1 节，表 1；附录 F）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_2" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="811.5" as="sourcePoint"/><mxPoint x="2632" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_3" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;固定第三视角相机观察 WidowX-250 单臂，每次输入 256×256 RGB。正文和图 6 共报告 8 项真机任务：4 项主任务及 4 项未见物体/目标/指令的追加泛化任务，每项 10 次；除折布外还放置 2–3 个干扰物。附录 A 给出具体成功标准，例如折布要抓住右边并翻向左边，推布要接近桌子右缘 1 英寸内。论文未给统一低层控制 Hz。（第 4.2 节，图 5–6；附录 A）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_3" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1286.0" as="sourcePoint"/><mxPoint x="2632" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_4" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;SimplerEnv 六项指标平均 TraceVLA 47.7%，OpenVLA 40.2%；Phi3 版 44.0% 对同基座 39.9%（表 1）。真机未见的玉米搬运任务 TraceVLA 8/10、OpenVLA 1/10（图 6a）；未见 AAA 电池抓取为 9/10 对 4/10（图 6b）。LIBERO 补充评测平均 74.8±0.4%，对应 OpenVLA 70.6±0.4%（附录表 5）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_4" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1760.5" as="sourcePoint"/><mxPoint x="2632" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_5" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;同数据额外微调但不加轨迹，7B 仅由 40.2% 到 41.3%；加轨迹为 47.7%。直接加入 6 帧历史反降到 34.2%（图 7）。文本形式轨迹相对基线只增约 2.4 个百分点，视觉轨迹再多约 6.4 个百分点（第 4.3 节）。历史长度 3、6、9、12 帧分别约 43.5%、47.7%、47.5%、46.6%，显示轨迹太短或过长均不理想（图 9）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_5" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2217.5" as="sourcePoint"/><mxPoint x="2632" y="2217.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_6" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;香蕉任务中 TraceVLA 的失败主要是抓取未成功；OpenVLA 有时抓住香蕉却放到盘上而非指令中的盘右侧。轨迹线过密会遮住夹爪或目标，低光下 CoTracker 也可能无法可靠追踪，故作者加入原图与训练时轨迹 Dropout。（第 3.2、4.2–4.3 节；附录 B）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2460" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_6" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2657.0" as="sourcePoint"/><mxPoint x="2632" y="2657.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_5_field_1" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者测得额外一张图及 CoTracker 带来开销：每步额外文字/图像 Token 约 0.002 秒、5 点追踪约 0.03 秒、密集点追踪摊销约 0.004 秒；训练时批量 32 的显存差小于 10 GB，但并非免费。作者提出未来仍需预测性轨迹与 3D 点云信息；现有方法只编码已发生的 2D 运动，评测仍限单臂真机。（第 5、7 节）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_5_branch_1" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_5_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂普通夹爪任务可试验分别标出两只末端和被操作物体的短时轨迹，再与显式状态估计比较；但追踪遮挡、双臂交叉与失败恢复仍须单独验证。论文已有证据主要支持单臂操作和 SimplerEnv 泛化，不支持直接推断双臂成功率" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_5_branch_2" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="787.0" as="sourcePoint"/><mxPoint x="3322" y="787.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_38_5_field_3" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者讨论追踪受光照等因素影响、叠加线条可能遮挡物体；轨迹丢弃训练可缓解依赖，但不能使错误追踪自动变正确&lt;br&gt;我的理解 / 不足：我的判断：运动轨迹能告诉模型“刚才往哪动”，不能可靠记录任务步骤、失败原因或长期物体消失事件，需要语义记忆补充&lt;br&gt;未来展望：结合长期事件记忆与轨迹置信度；在遮挡、物体突然加速和背景移动下单独测追踪误差及策略错误，观察谁先失效&lt;br&gt;对我们项目的启发：可先在机械臂+DH116 相机输入加轨迹，作为便宜的时间建模基线。手指遮挡强，须检查点是否跟到了物体，而非跟着手或背景" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_5_branch_3" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1324.5" as="sourcePoint"/><mxPoint x="3322" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
