        </UserObject><UserObject id="paper_68_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-69" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_68_1_field_1" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / AAAI&lt;br&gt;引用量：165（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_1_branch_1" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_1_field_2" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_1_branch_2" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_1_field_3" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 A (CCF 7th edition; venue category not independently extracted from official PDF) 方向，主要讨论扩散/流式动作生成往往需要多次采样，在线控制延迟较高。&lt;br&gt;核心思路是FlowPolicy 使用三维点云和 consistency flow matching，在单次推理中生成动作。&lt;br&gt;与当前项目的联系：项目联系：方法可借鉴，但迁移到当前双臂硬件需验证" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_1_branch_3" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_1_field_4" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：扩散/流式动作生成往往需要多次采样，在线控制延迟较高&lt;br&gt;&lt;br&gt;为什么重要：双臂真机尤其关注动作频率；该工作可用于比较速度与成功率" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_1_branch_4" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1680.0" as="sourcePoint"/><mxPoint x="562" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_1_field_5" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：三维视觉动作生成与推理加速&lt;br&gt;流匹配学习怎样把随机噪声沿连续路径变成可执行动作；本文用点云描述物体的三维位置，使策略不只依赖二维图像外观，并关注生成动作所需的实际时间&lt;br&gt;核心问题：扩散策略能表达多种抓取动作，但生成每段动作通常要反复调用网络，机器人等待推理会降低控制频率&lt;br&gt;作者问能否保持点云策略的任务成功率，同时把噪声到动作的采样缩短到一次网络评估&lt;br&gt;之前方法的问题：DP3 等三维扩散策略约需十次去噪评估，耗时较高；普通流匹配仍需数值积分多个时间步&lt;br&gt;直接压成单步若没有约束，可能走偏目标动作分布，因此需要训练不同时间点的预测保持一致" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1905" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_1_branch_5" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2224.5" as="sourcePoint"/><mxPoint x="562" y="2224.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_2_field_1" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：生成质量与推理速度之间存在权衡" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_2_branch_1" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="354.5" as="sourcePoint"/><mxPoint x="1252" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_2_field_2" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_2_branch_2" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_2_field_3" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：Diffusion Policy 从二维观察逐步去噪产生动作，DP3 换成紧凑点云特征以利用三维几何&lt;br&gt;FlowPolicy 沿用 DP3 的三维条件架构，但将多步扩散动作生成器改为一致性流生成器&lt;br&gt;相关方向 2：普通流匹配学习噪声到数据的速度场；Consistency-FM 约束同一路径不同时间点的速度和终点一致，可直接走较直的生成路径&lt;br&gt;本篇把该训练目标加上视觉与机器人状态条件，针对操作轨迹而非无条件图像&lt;br&gt;代表工作：Simple DP3 是轻量三维扩散对照；AdaFlow 和 Consistency Policy 是二维观察的加速对照，后者用一致性蒸馏&lt;br&gt;它们用于比较速度与成功率，不应把其训练数据、教师网络或性能直接当成 FlowPolicy 的模块&lt;br&gt;与已有方法的区别：单视角深度图经相机标定转成点云，最远点采样保留空间覆盖，再编码成紧凑三维条件&lt;br&gt;训练时把时间划成两段以放宽全路径恒速要求，推理仍只评估一次网络；论文称不需教师模型蒸馏" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_2_branch_3" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1548.5" as="sourcePoint"/><mxPoint x="1252" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_3_field_1" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：FlowPolicy 使用三维点云和 consistency flow matching，在单次推理中生成动作&lt;br&gt;&lt;br&gt;输入：官方摘要给出任务/数据类型；具体模型张量与接口需核对方法章节&lt;br&gt;&lt;br&gt;输出与动作：官方摘要未明确列出完整控制接口；需核对论文方法或代码&lt;br&gt;&lt;br&gt;方法概览：任务输入 → FlowPolicy 使用三维点云和 consistency flow matching，在单次推理中生成动作 → 官方摘要未明确列出完整控制接口；需核对论文方法或代码" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_3_branch_1" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_3_field_2" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：二维画面难直接表达深度和物体相对距离；作者从单视角深度生成点云，采样后用轻量网络编码，再与机器人本体状态合并&lt;br&gt;生成器因而能按空间几何而非仅按像素外观预测动作序列&lt;br&gt;贡献 2：反复积分拖慢动作输出；作者训练条件速度场，让不同时间点对同一动作终点的预测和速度彼此一致&lt;br&gt;再把路径分成两段训练，以提高复杂动作分布的表达力；部署时从噪声一次生成整段动作&lt;br&gt;贡献 3：高速不应以明显损失任务成功为代价；作者在与 DP3 相同的三维观察和示范预算下，比较网络调用次数、毫秒耗时和任务成功率&lt;br&gt;结果显示一次评估比 DP3 十次评估快约 7.3 倍，成功率在相同仿真集合中略高&lt;br&gt;方法流程：单视角深度图与相机参数 → 场景点云 → 最远点采样与三维特征编码；机器人状态另行编码&lt;br&gt;两个条件送入一致性流网络，训练时从示范轨迹学习噪声到动作的直线路径；运行时抽噪声、一次预测动作段并执行" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_3_branch_2" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1231.5" as="sourcePoint"/><mxPoint x="1942" y="1231.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_4_field_1" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：Adroit、MetaWorld&lt;br&gt;&lt;br&gt;主要结果：AAAI 摘要报告在 Adroit 与 MetaWorld 上保持有竞争力的成功率，同时推理速度提高约 7 倍&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：Adroit、MetaWorld&lt;br&gt;&lt;br&gt;实验与结果：主要结果：AAAI 摘要报告在 Adroit 与 MetaWorld 上保持有竞争力的成功率，同时推理速度提高约 7 倍" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_4_branch_1" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_4_field_2" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：Adroit 三项多指手任务和 MetaWorld 34 项两指夹爪任务，共 37 项仿真操作；每任务用 10 条启发式专家示范&lt;br&gt;观察含最近两帧，实验在单张 RTX 2080Ti 上报告每次动作推理时间、网络调用次数和任务成功率&lt;br&gt;对照：与 DP3、Simple DP3 的三维条件策略比较，也与二维的 Diffusion Policy、AdaFlow、Consistency Policy 比较&lt;br&gt;论文每 200 轮测试 20 回合，取五次最佳成功率均值，并跨三个随机种子汇总；示范数还试 1、10、20、50 条&lt;br&gt;结果：表 1 的平均推理时间 FlowPolicy 为 19.9±0.2 毫秒、一次网络评估，DP3 为 145.7±2.3 毫秒、十次评估&lt;br&gt;表 2 的 37 任务平均成功率 70.0±4.7% 对 DP3 的 68.7±4.7%，差 1.3 个百分点；快的是模型推理，不是整机控制频率保证&lt;br&gt;关键补充：Adroit Pen 成功率 53±12% 对 DP3 的 46±10%，但 MetaWorld 很难任务组为 36.6±7.6% 对 39.4±9.0%&lt;br&gt;示范数消融显示难任务增加示范通常有益；论文无真机实验，也没有单独量化两段训练每个部件的消融" vertex="1">
          <mxGeometry height="919" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_4_branch_2" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1196.5" as="sourcePoint"/><mxPoint x="2632" y="1196.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_5_field_1" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：方法可借鉴，但迁移到当前双臂硬件需验证&lt;br&gt;&lt;br&gt;主要局限：本段基于官方摘要；未覆盖全文失败案例、完整 Baseline 与方法消融&lt;br&gt;&lt;br&gt;局限与启发：主要局限：本段基于官方摘要；未覆盖全文失败案例、完整 Baseline 与方法消融" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_5_branch_1" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_68_5_field_2" parent="paper_68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者报告的边界：验证集中在 Adroit 和 MetaWorld 共 37 项仿真任务，论文没有给出真实机器人安全、相机延迟或接触误差结果&lt;br&gt;结论只支持这些环境中的快速动作生成；作者没有提供一段独立的正式局限性分析&lt;br&gt;我的理解 / 不足：19.9 毫秒只计网络推理，深度成像、点云处理、通信和电机执行仍会占时间&lt;br&gt;很难任务组略低于 DP3，且十条高质量启发式示范未必容易在双臂 DH116 上取得；这两点限制直接迁移&lt;br&gt;未来展望：把视觉预处理到电机反馈的端到端时延与整任务成功率一起测，并在遮挡、杂乱背景和相机误差下重复实验&lt;br&gt;还可专门消融三维点云、速度一致性和两段训练，判断每项对速度与精细接触的贡献&lt;br&gt;对我们项目的启发：若机械臂或 DH116 的 VLA 动作头推理太慢，可比较单步流生成与多步扩散，在同一示范和控制频率下测动作质量&lt;br&gt;先验证手指维度、双臂同步与接触安全；本文只证明仿真中的速度和成功率，不证明 Sim2Real 或失败恢复" vertex="1">
          <mxGeometry height="884" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_68_5_branch_2" edge="1" parent="paper_68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
