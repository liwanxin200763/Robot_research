            <mxGeometry x="1140" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_134_topnav_2" label="上一篇" link="data:page/id,literature-paper-133" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_134_topnav_3" label="下一篇" link="data:page/id,literature-paper-135" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_134_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#134 Cross-Embodiment Grasping">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_134_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="06 动作建模与控制 · 数据链条位置：不同手型的强化学习抓取">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
