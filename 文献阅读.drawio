        </mxCell>
        <UserObject id="paper_18_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_18_bottomnav_1" label="返回分类" link="data:page/id,literature-page-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_18_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-17" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_18_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-19" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_18_1_field_1" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICRA 2025（arXiv 首发于 2024）&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_1_branch_1" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_1_field_2" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;研究背景：双臂加多指灵巧手的同步遥操作负担很高，少量真人示范难以直接训练可靠的视觉策略。仿真中自动扩增真实可执行轨迹可降低采集瓶颈。（全文 §I–II）&lt;br&gt;&lt;br&gt;论文要解决的问题：如何把少量双臂示范转为多初始状态、多任务的操作轨迹，同时保留左右臂异步、协同以及先后顺序约束。（§I、IV）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_1_branch_2" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="881.5" as="sourcePoint"/><mxPoint x="562" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_1_field_3" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：原 MimicGen 侧重单臂、单条固定子任务顺序，直接复制到双臂会失去异步并行、交接同步与跨臂顺序控制；给原轨迹加噪也不能覆盖新初始状态。（§II–IV、VI-C）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：用少量人类双臂示范自动制造更多训练轨迹，并保留两臂或灵巧手的配合时间关系&lt;br&gt;核心问题：把几条人类示范搬到新物体位置后，怎样让左右臂仍能并行、等待或按顺序配合？&lt;br&gt;之前的问题：MimicGen 主要针对单臂、固定步骤；直接套到双臂，可能一只手还没准备好另一只就动了" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_1_branch_3" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1548.5" as="sourcePoint"/><mxPoint x="562" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_2_field_1" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;与已有工作的关系：继承 MimicGen 的物体中心轨迹重组，但扩展为双臂异步队列、同步协调与跨臂顺序约束；下游使用现有 BC/DP 学习器，而非提出新 VLA。（§II、IV）" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_2_branch_1" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_2_field_2" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_2_branch_2" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="927.0" as="sourcePoint"/><mxPoint x="1252" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_2_field_3" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：MimicGen 把单臂示范按子任务拆开，随物体新位置平移旋转后在仿真重放&lt;br&gt;相关方向 2：双臂任务有同时做、共同完成、先后接力；灵巧手还需控制更多关节和接触&lt;br&gt;代表工作：MimicGen、Demo-Noise 生成或扩增数据；BC-RNN、Diffusion Policy（扩散策略，从噪声逐步生成连续动作） 用这些数据学动作&lt;br&gt;区别：给每只臂单独安排步骤，再加同步与先后约束；它是数据生成方法，不是新的图文到动作模型" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_2_branch_3" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1412.0" as="sourcePoint"/><mxPoint x="1252" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_3_field_1" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;按每只臂把示范分为平行、协同、顺序三类子任务；在新物体位姿下进行 object-centric SE(3) 轨迹变换，执行成功后才保留生成示范。（§IV，图 2–3）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_3_branch_1" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_3_field_2" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;每臂各有动作队列，平行子任务异步执行；协同阶段两臂共享变换并同步结束时刻，交接可选择直接 Replay 以免超出运动学限制；顺序阶段以前置/后继约束阻止另一臂提前动作。手指动作相对末端沿用源示范。这里是双臂轨迹数据生成，不是训练两个独立智能体；同步与顺序机制用于避免时序冲突，论文未报告通用碰撞规划或在线失败恢复。（§IV-A–D）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_3_branch_2" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="780.0" as="sourcePoint"/><mxPoint x="1942" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_3_field_3" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：少量人类操作示范、按臂标出的子任务及参考物体、新仿真场景中的物体位姿和初始机器人状态。（§IV–V）&lt;br&gt;&lt;br&gt;输出 / 动作表示：生成每臂末端动作轨迹及灵巧手关节命令，按控制器转换为机器人执行动作；最终形成可用于 BC-RNN 或 Diffusion Policy 的视觉—动作示范。（§IV–VI）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_3_branch_3" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1289.5" as="sourcePoint"/><mxPoint x="1942" y="1289.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_3_field_4" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;对参考物体位姿及场景初始状态重新采样，以 SE(3) 物体中心变换产生新的末端轨迹；D0/D1/D2 扩大重置分布。多样性以跨任务、本体和 reset distribution 展示，未独立计算 state coverage、action diversity 或每条数据边际价值。（§IV、VI-B/C，表 II）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_3_branch_4" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1764.0" as="sourcePoint"/><mxPoint x="1942" y="1764.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_3_field_5" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据生成系统不学习轨迹扩增网络；在生成示范上训练 BC-RNN、BC-RNN-GMM 和 Diffusion Policy 等模仿策略，比较 100、500、1000、5000 条示范规模。真机视觉策略采用 Diffusion Policy。（§VI，图 5）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1989" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_3_branch_5" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2179.0" as="sourcePoint"/><mxPoint x="1942" y="2179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_3_field_6" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把示范分成以物体为中心的步骤，物体换位置时，同步变换相应的手臂轨迹&lt;br&gt;贡献 2：能并行时两臂各自推进；需共同配合时等双方都完成；有先后关系时限制一臂提前动&lt;br&gt;贡献 3：在仿真中重放新轨迹，只把成功完成任务的过程留下，供模仿学习模型训练&lt;br&gt;流程：拆分少量原示范→把动作对齐到新物体位置→按双臂时序重放→筛出成功轨迹" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2397" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_3_branch_6" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2646.5" as="sourcePoint"/><mxPoint x="1942" y="2646.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_4_field_1" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;9 个仿真任务、3 种本体：平行夹爪双 Panda、灵巧手双 Panda、灵巧手 GR-1。论文以 60 条人类源示范生成约 2.1 万条示范；真机 Can Sorting 从 4 条源示范经数字孪生生成 40 条成功示范。每次仿真生成仅保留成功执行；论文没有提供同规模真人数据所需小时或统一生成成本表。（§I、V–VI）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_4_branch_1" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_4_field_2" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;Robosuite/MuJoCo 的 9 任务和三种本体；以源示范直接训练、Demo-Noise 数据生成、不同数据量、Replay/Transform、顺序约束和策略架构作为对照，报告成功率并对多个种子取平均。（§V–VI，表 I–III）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_4_branch_2" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="787.0" as="sourcePoint"/><mxPoint x="2632" y="787.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_4_field_3" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fourier GR-1 搭载双 Inspire 灵巧手、头部和外部 RealSense 相机。先以 RGB-D 和 GroundingDINO 初始化数字孪生物体位姿，仿真生成成功轨迹后传至真机；40 条成功示范训练 Can Sorting 视觉策略，以红/蓝杯各 10 次测试。（§VI-D，图 6）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_4_branch_3" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1202.0" as="sourcePoint"/><mxPoint x="2632" y="1202.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_4_field_4" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;21K 示范来自 60 条源示范；仿真 Piece Assembly 中源示范训练的 DP 为 3.3±0.9%，生成数据训练为 80.7±0.9%；Can Sorting 0.7±0.9%→97.3±0.9%（表 I）。Demo-Noise 对比中 Piece Assembly 为 12.7±3.4% 对 74.0±2.8%，Pouring 26.7±2.5% 对 79.3±0.9%（表 III）。真机 4 条源示范策略 0%，40 条生成示范策略 90%（§VI-D）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1427" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_4_branch_4" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1659.0" as="sourcePoint"/><mxPoint x="2632" y="1659.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_4_field_5" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;协调子任务 Replay 与 Transform：Transport 63.3% 对 46.0%；顺序约束下 Pouring 88.7%，无约束 76.7%（§VI-C）。100→500/1000 条通常改善策略，但 1000→5000 不总增益（图 5）；说明扩增数量并非唯一质量因素" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1919" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_4_branch_5" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2109.0" as="sourcePoint"/><mxPoint x="2632" y="2109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_4_field_6" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成过程排除未成功执行轨迹；协调轨迹的 Transform 可能超运动学范围，因此交接任务常用 Replay。论文未给出系统化真机失败类型统计，也未实现部署后的在线失败检测/恢复。（§IV-B、VI-C/D）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2327" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_4_branch_6" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2517.0" as="sourcePoint"/><mxPoint x="2632" y="2517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_5_field_1" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：库内分析：源示范仍需按臂子任务分段与类型标注；SE(3) 变换和仿真成功门控依赖可知物体位姿、可重置环境及数字孪生精度。真机仅以单一 Can Sorting 任务、少量测试验证，跨未知任务泛化尚未证实。（§IV、VI）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：对普通夹爪双臂的数据扩增尤其可借鉴“平行/协调/顺序”划分和物体中心变换；研究执行错误时可进一步收集被过滤的失败样本，检验其对恢复策略的价值。（§IV–VI）" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_5_branch_1" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="424.5" as="sourcePoint"/><mxPoint x="3322" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_18_5_field_2" parent="paper_18" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文没有系统统计真机失败种类，也没有在部署后让机器人自动发现失败并补救&lt;br&gt;我的理解 / 不足：需知道子任务切分和物体位置，仿真也要够准；真机只验证一个分拣任务&lt;br&gt;未来展望：检查更复杂接触任务能否继续扩增，以及轨迹再增加时是否仍能带来收益&lt;br&gt;对我们项目的启发：可按并行、同步、先后三类扩增 DH116 示范；被筛掉的失败过程可另存供恢复研究" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_18_5_branch_2" edge="1" parent="paper_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
