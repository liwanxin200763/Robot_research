        </UserObject><UserObject id="paper_101_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-100" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_101_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-102" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_101_1_field_1" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CVPR&lt;br&gt;引用量：116（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作&lt;br&gt;数据链条位置：双手工具交互数据与组合评测" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_1_branch_1" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_1_field_2" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;双手数据要记录的不止手的姿态：人用一只手稳住碗、另一只手倒水时，工具、动作和目标物之间的关系决定了任务效果。TACO 为这种双手多物体交互构建数据，既记录多个视角，也重建手物网格与行为标签。它帮助研究组合动作和协同抓取，数据本身是人类动作记录，不等于机器人可以直接执行的示范命令" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_1_branch_2" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_2_field_1" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;与单手物体数据的区别：很多手物数据聚焦单手和一个物体，难描述一只手稳定目标、另一只手使用工具的协作。TACO 把工具—动作—物体三元组和两手交互纳入标注，并测试没见过的物体几何与行为组合；因此读它时应关注组合划分，而不只比较总帧数" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_2_branch_1" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_2_field_2" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;组合泛化不是简单换一个物体实例，而是把训练中分别见过的工具、动作和目标物重新组合。模型若只记住某个工具总与某个动作同时出现，遇到新组合仍会失败。TACO 的行为三元组让这类测试可构造，因此它对数据研究的意义还包括训练测试划分，而不只是精细网格" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_2_branch_2" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_3_field_1" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;从多相机和动捕到统一标注&lt;/b&gt;&lt;br&gt;&lt;br&gt;从多相机和动捕到统一标注：使用 12 个第三人称视角与一个第一视角，结合光学动作捕捉恢复手与刚体运动；随后优化物体位姿、人手关键点、手部模型和接触关系，生成三维网格与二维分割。去除动捕标记的图像处理减少标记对视觉模型的影响，但这一步也需检查是否改变手物边界&lt;br&gt;&lt;br&gt;数据怎样进入下游评测：用行为三元组组织不同工具和物体，建立组合动作识别、手物运动预测、协同抓取生成三项基准。识别输出动作类别，预测输出未来手物轨迹，抓取生成输出接触几何；三者都不是直接控制机器人动作。若要用来生成机器人示范，还需本体映射、碰撞约束与动力学检验" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_3_branch_1" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="477.0" as="sourcePoint"/><mxPoint x="1942" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_3_field_2" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：手物重建同时需要几何贴合、时间平滑、合理关节姿态和避免穿透。只优化每帧图像轮廓可能得到相邻帧跳动的手形，只有平滑又可能把真实快速接触抹掉；多视角与动捕帮助约束这个歧义。生成网格后再得到分割掩码，使二维与三维标注在同一轨迹中可对应&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_3_branch_2" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1161.5" as="sourcePoint"/><mxPoint x="1942" y="1161.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_4_field_1" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据规模与评价指标&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据规模与评价指标：CVPR 2024 原文含约 2500 条运动序列、520 万视频帧，提供第一与第三视角、网格、分割及行为标注。三项任务分别按识别与泛化性能、轨迹误差、生成手形与接触质量评测；表 2 的手部关节误差是毫米级几何误差，不是真机成功率&lt;br&gt;&lt;br&gt;实验说明什么：原文比较不同数据训练下的手姿重建，并比较组合识别、未来运动及抓取生成基线；协同抓取还检查生成手与环境碰撞，说明只看手形逼真不够。论文没有给出一个可代表所有任务的真实机器人执行成功率，因此不把数据规模或生成评分转换成可部署性能" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_4_branch_1" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_4_field_2" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：三项基准的好结果含义不同：动作识别测模型能否读懂组合，运动预测测后续轨迹，抓取生成测手与工具和环境是否协调。轨迹很接近人类真值，仍可能在机器人上不可达；生成手看似自然，也可能与另一只手或桌面碰撞。因此作者的环境碰撞检查和几何指标须与识别准确率并列看&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_4_branch_2" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1109.0" as="sourcePoint"/><mxPoint x="2632" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_5_field_1" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限及与灵巧手研究的连接&lt;/b&gt;&lt;br&gt;&lt;br&gt;局限及与灵巧手研究的连接：动捕、多相机和刚体模型提高标注精度，也带来设备成本与场景限制；人类关节与机器人手的耦合不同，复用数据仍需转换。可用它分析两手接触分工与工具功能，再把少量动作转入 DH116 运动学和物理仿真，检查接触是否保留，而不是逐角复制人手&lt;br&gt;&lt;br&gt;把关键设计与实验读透：若从 TACO 选片段给自己的双臂系统使用，可以先标明哪只手提供稳定约束、哪只手施加主要动作，并保留物体运动而非只看指尖。再在目标机器人的工作空间重建相同物体关系，对碰撞和接触失效做记录。这个过程是数据转换研究，不能把人类数据已有精度当机器人执行精度" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_5_branch_1" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_101_5_field_2" parent="paper_101" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_101_5_branch_2" edge="1" parent="paper_101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1004.0" as="sourcePoint"/><mxPoint x="3322" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
