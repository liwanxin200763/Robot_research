        </UserObject><UserObject id="paper_49_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-50" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_49_1_field_1" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL&lt;br&gt;引用量：126（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_1_branch_1" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_1_field_2" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_1_branch_2" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_1_field_3" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论少量示范条件下，操作策略要面对物体和空间变化。&lt;br&gt;核心思路是EquiBot 在模仿学习策略中加入等变结构，提高数据效率和空间泛化。&lt;br&gt;与当前项目的联系：项目联系：双臂空间变化可能受益，但平台不同" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_1_branch_3" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_1_field_4" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：少量示范条件下，操作策略要面对物体和空间变化&lt;br&gt;&lt;br&gt;为什么重要：提供以结构先验替代部分示范数据的路线" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_1_branch_4" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_1_field_5" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：三维点云策略与几何泛化。SIM(3) 是平移、旋转和统一缩放的组合；等变性表示输入这样变换时，输出动作也按相应规律变换&lt;br&gt;核心研究问题：演示只在桌面一角采几次，换位置或尺寸后常失败。能否把几何规律写进策略结构，使少量数据也能处理新的物体位置、方向和大小？&lt;br&gt;之前方法的问题：普通模型需要大量变换示范才能学这些规律；仅用随机数据扩增不能保证模型对几何变换一直一致，尤其超出训练范围时" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_1_branch_5" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2123.0" as="sourcePoint"/><mxPoint x="562" y="2123.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_2_field_1" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：普通网络不一定充分利用旋转、平移等几何对称性" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_2_branch_1" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_2_field_2" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_2_branch_2" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="822.0" as="sourcePoint"/><mxPoint x="1252" y="822.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_2_field_3" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：扩散策略通过去噪生成动作，可表示多种行为；点云提供三维几何，但普通点云编码器仍可能依赖固定坐标和物体尺寸&lt;br&gt;相关方向 2：数据扩增让训练样本更多；等变结构直接约束输入—输出关系。它对规定的几何变换有更强约束，但不能解决任意动力学或任务语义变化&lt;br&gt;代表工作：比较普通 Diffusion Policy（扩散策略，从噪声逐步生成连续动作） 和已有等变模仿方法。#51 DexHandDiff 强调接触及目标引导；EquiBot 强调几何变换下动作如何变化&lt;br&gt;与已有方法的区别：从编码器到动作去噪器保持几何一致，不只在输入做一次归一化；输出回到原坐标，机器人据此执行" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_2_branch_3" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1377.0" as="sourcePoint"/><mxPoint x="1252" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_3_field_1" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：EquiBot 在模仿学习策略中加入等变结构，提高数据效率和空间泛化&lt;br&gt;&lt;br&gt;等变性怎样减少重复示范：EquiBot 把 SIM(3) 几何等变网络与扩散动作生成结合：输入场景平移、旋转或缩放时，输出动作应按相应几何关系变化。等变不是动作数值保持不变，而是观察和动作一起正确变换，使同一种抓放关系不必在每个绝对位置重新采一遍&lt;br&gt;&lt;br&gt;哪些变化不能靠几何对称解决：点云提供物体空间结构，扩散模型表达同一任务的多种可能动作，等变结构负责把几何变化的规律写进模型。真实关节限位、桌面碰撞和接触摩擦并不总具有相同对称性，所以场景整体变换后的理论关系仍要接受机器人可达性检验；不能据此宣称对所有新物体都无需数据" vertex="1">
          <mxGeometry height="744" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_3_branch_1" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="512.0" as="sourcePoint"/><mxPoint x="1942" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_3_field_2" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：对点云计算中心与尺度，再用旋转等变编码提取几何特征。移动或转动物体时，特征与向量按对应规律变化，减少学固定场景的倾向&lt;br&gt;贡献 2：动作扩散去噪网络同样满足等变约束，使动作预测与观察变化同步；最后恢复原中心和尺度，将结果转回真实机器人坐标&lt;br&gt;贡献 3：用很少示范验证未见位置、方向、尺寸。统一缩放与平移旋转是结构支持范围；多物体相对布局改变或物体变形不享受同样保证&lt;br&gt;方法流程：三维点云+机器人状态 → 中心/尺度处理 → 等变几何编码 → 等变动作去噪 → 恢复实际坐标 → 执行动作 → 新点云反馈" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_3_branch_2" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1231.5" as="sourcePoint"/><mxPoint x="1942" y="1231.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_3_field_3" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1579" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_3_branch_3" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1793.5" as="sourcePoint"/><mxPoint x="1942" y="1793.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_4_field_1" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：作者报告在六项移动操作任务的多个真机变化中展示泛化；具体数值见论文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告在六项移动操作任务的多个真机变化中展示泛化；具体数值见论文" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_4_branch_1" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_4_field_2" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：六项仿真与六项真机，包括推椅子、铺床、折布等；一些任务每项约15条人类示范、5分钟。用未见布局与物体形状测试数据效率&lt;br&gt;对照：与普通扩散策略等比较，检查等变结构各部分及数据规模；测试场景的变化范围需明确，不等于任何新任务都能零样本完成&lt;br&gt;结果：例如真机长桌推椅子8/10成功，普通扩散策略0/10；折布6/10，对照0/10。这些是对应任务完整成功次数，样本规模较小&lt;br&gt;真机 / 关键补充：真机铺床8/10，对照0/10；另有移动机械臂操作。几何泛化证据覆盖特定变换，非统一“所有未见物体”成功率" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_4_branch_2" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_4_field_3" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_4_branch_3" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_5_field_1" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：双臂空间变化可能受益，但平台不同&lt;br&gt;&lt;br&gt;主要局限：移动操作结果不能直接替代普通夹爪双臂评测&lt;br&gt;&lt;br&gt;局限与启发：主要局限：移动操作结果不能直接替代普通夹爪双臂评测" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_5_branch_1" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_5_field_2" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者明确指出不由结构保证非线性形状/动力学变化，也不能处理多物体相对布局任意改变；严重遮挡或相机大幅变化仍可能失败&lt;br&gt;我的理解 / 不足：我的判断：DH116 接触取决于指尖结构、物体摩擦与受力，整体缩放动作不一定能保持抓稳。几何等变不等于接触物理等变&lt;br&gt;未来展望：加入独立物体建模、遮挡鲁棒点云和接触状态；把几何变换与摩擦/重量变化分开评估，判断结构先验真正帮助哪里&lt;br&gt;对我们项目的启发：可给 DH116 抓取动作头加入平移/旋转规律，减少重复摆位示范。关节角和夹持力要单独适配，不能跟物体尺寸直接等比缩放" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_5_branch_2" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_49_5_field_3" parent="paper_49" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_49_5_branch_3" edge="1" parent="paper_49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1496.0" as="sourcePoint"/><mxPoint x="3322" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
