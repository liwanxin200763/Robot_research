            <mxGeometry x="2160" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_81_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-82" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_81_1_field_1" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2020 / IEEE International Conference on Robotics and Automation (ICRA) 2020&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_1_branch_1" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_1_field_2" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：NVIDIA 官方出版页确认 ICRA 2020；本地 arXiv v2 为2019-10-14，首次提交2019-10-07，共18页含补充。主卡保留所读预印本首页及官方作者页的正式题名写法；DOI为10.1109/ICRA40945.2020.9197124" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_1_branch_2" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="864.0" as="sourcePoint"/><mxPoint x="562" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_1_field_3" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexPilot 研究能否仅观察裸手就让人操纵高维臂手系统，完成捏取、手内换指和多阶段操作。四台标定同步深度相机估人手姿态，学习先验辅助DART跟踪，非线性优化将人手指尖关系转换为Allegro动作，RMP控制KUKA臂。贡献在于23驱动轴完整遥操作及触觉—动作数据记录能力；本文没有训练自主模仿策略，数据将用于学习属于后续方向（§III–X）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_1_branch_3" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1426.0" as="sourcePoint"/><mxPoint x="562" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_1_field_4" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：多视角裸手追踪与高自由度臂手遥操作&lt;br&gt;DexPilot 用多台深度相机和指尖几何映射驱动臂手，并记录接触信号&lt;br&gt;为什么重要 / 旧方法的不足：贡献在于23驱动轴完整遥操作及触觉—动作数据记录能力；本文没有训练自主模仿策略，数据将用于学习属于后续方向" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_1_branch_4" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1900.5" as="sourcePoint"/><mxPoint x="562" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_2_field_1" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作与机制：传感手套能准确读手形并可提供触觉反馈，但设备成本和佩戴负担较高；裸手视觉跟踪更轻便，却有遮挡、指间接触不可见和尺度误差。DexPilot 的“免手套”指运行阶段，训练跟踪器时实际使用彩色手套产生标注，不能写成从开发到部署都无需手套" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_2_branch_1" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_2_field_2" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作与机制：DART 用可动人手模型对齐点云，精细但易陷局部极小；PointNet++ 与 JointNet 提供位置和关节先验帮助初始化。RMP 把目标运动和避碰要求写成加速度场，持续产生臂轨迹；它不是任务规划器，也不自动理解钱包或抽屉（§V–VII）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：触觉：传感器记录指尖受力与接触变化，帮助分析动作是否真正碰到物体&lt;br&gt;传感手套能准确读手形并可提供触觉反馈，但设备成本和佩戴负担较高" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_2_branch_2" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1056.5" as="sourcePoint"/><mxPoint x="1252" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_3_field_1" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 硬件、坐标与手跟踪&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 硬件、坐标与手跟踪：系统为KUKA LBR iiwa7 R800＋四指Allegro，共23驱动轴；指尖安装四个BioTac，每个23信号，合计92触觉通道，指节/掌面另加增摩胶带。操作者不接收这些触觉信号，主要靠直接视线观察旁边机器人（§III，图3）&lt;br&gt;&lt;br&gt;1. 硬件、坐标与手跟踪：四台Intel RealSense D415经外参标定及时间同步，融合点云；推荐深度观察在1 m内，操作者工作空间80×55×38 cm。启动时以张开手、掌面平行桌面和机器人假定初姿建立相机—机器人变换。D435i单台不能直接替代这套多视角感知而保留原成绩" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_3_branch_1" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="442.0" as="sourcePoint"/><mxPoint x="1942" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_3_field_2" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 硬件、坐标与手跟踪&lt;/b&gt;&lt;br&gt;&lt;br&gt;先用彩色手套与GloveNet产生DART手姿/分割标注，再用裸手点云训练两级PointNet++：第一级定位/分割手，第二级重采样手部点提高指节精度，JointNet再把23关键点转20人手关节角；DART用这些先验持续精化。正文报告10万点云、累计7–8小时采集、TitanXp单卡训练15小时（§VI，pp.4–5）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_3_branch_2" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="986.5" as="sourcePoint"/><mxPoint x="1942" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_3_field_3" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 保留捏合关系的重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 保留捏合关系的重定向：人手和Allegro关节轴不同，所以不逐角复制，而匹配指尖—指尖及掌—指尖向量的长度和方向。指尖接近阈值时加大权重并投影目标距离，补偿跟踪误差，让机器人实际闭合捏住小物体；加入趋向张手的关节正则，并把主要手指远端关节与中间关节设为相等（§VII-A，图8–9）&lt;br&gt;&lt;br&gt;2. 保留捏合关系的重定向：SLSQP每次以前一帧结果初始化，随后一阶低通滤波减小抖动与投影跳变。投影也可能妨碍及时释放或换指，是明确失败来源；正文未完整列出驱动限位、失踪帧保护和急停处理，不能把优化映射当成全套安全控制" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_3_branch_3" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1548.5" as="sourcePoint"/><mxPoint x="1942" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_3_field_4" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 臂控制、反馈与可保存数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 臂控制、反馈与可保存数据：RMP根据人腕位姿控制机器人掌，使用碰撞平面避免臂/掌与桌面或操作者碰撞；目标臂轨迹200 Hz送力矩级阻抗控制，Allegro目标角30 Hz送关节控制。三线程分布三台计算机，系统整体约1秒延迟，不能用200 Hz推导低延迟（§IV、VII-B）&lt;br&gt;&lt;br&gt;3. 臂控制、反馈与可保存数据：可记录92触觉通道、23轴命令/实测位置速度、23力矩命令及相机流。图16显示40秒换砖180°过程中中指七次接触及对应触觉峰，但统一落盘频率、时间同步文件格式、完整公开数据规模未报告。操作者拾回掉落物是人类恢复过程，不是训练出了自主恢复器（§VIII–IX）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_3_branch_4" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2215.5" as="sourcePoint"/><mxPoint x="1942" y="2215.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_4_field_1" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;操作者评价协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;操作者评价协议：15个任务条件涵盖抓放三种物体、三尺寸积木堆叠、倒珠、开罐、换砖、取套盒、套杯、抽茶包、滑卡、取钱和翻盒。两位操作者每条件先3–5次热身，再连续五次测试；物体落出工作区记失败。测完成时间及成功率，不是策略泛化基准（表II，PDF p.9）&lt;br&gt;&lt;br&gt;代表性结果与失败：补充§D的逐次表（p.17）可核算：换砖两人均3/5成功；套杯均4/5；取钱均5/5，但完成均时约105与212 s；套盒均5/5，均时约358与228 s。均时针对成功试次，失败标F，不能将耗时短单独解读为更熟练或更可靠。图14–15提供总体可视化，附表保留原始次数更方便追溯" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_4_branch_1" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="459.5" as="sourcePoint"/><mxPoint x="2632" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_4_field_2" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;代表性结果与失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;代表性结果与失败：高精度插孔不是已解决任务：0.1 mm间隙插销的个别成功视频见图17，作者指出在特定初始条件下成功率通常不超过10%；小物体释放失败见图18（§X，pp.10–12）&lt;br&gt;&lt;br&gt;代表性结果与失败：跟踪验证集7000图像平均关键点误差9.7 mm、每关节角误差1.33°，但不是跨论文同数据集对比。补充§E指出尝试的神经网络重定向精度不足，不应推广成所有学习式重定向必然劣于优化&lt;br&gt;&lt;br&gt;数据与自主性的界线：记录的触觉峰能提示何时接触，却未在本文中被用于自动调节握力；两名操作者的完成时间差反映训练、疲劳和策略选择等人因。不能因为真实机器人最终成功，便把成功归为自主控制能力或由触觉闭环保证的稳定性（§VIII–IX）" vertex="1">
          <mxGeometry height="744" width="628" x="2632" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_4_branch_2" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1179.0" as="sourcePoint"/><mxPoint x="2632" y="1179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_4_field_3" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1579" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_4_branch_3" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1776.0" as="sourcePoint"/><mxPoint x="2632" y="1776.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_5_field_1" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目关系与后续&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足、项目关系与后续：作者指出：工作空间有限、手形差异会影响跟踪、投影干扰换指/释放、无触觉反馈使精细任务困难、约1秒延迟和RMP响应可改善；建议自动抓握力调节及意图识别（§IX–X）&lt;br&gt;&lt;br&gt;不足、项目关系与后续：我的分析：这篇最有价值的是将指尖接触几何、执行信号与触觉对应起来。完整复现需要多D415、标定同步、KUKA＋Allegro＋BioTac及多机/GPU，不能因“低成本”称号推断符合当前预算" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_5_branch_1" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_5_field_2" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目关系与后续&lt;/b&gt;&lt;br&gt;&lt;br&gt;最低验证：D435i先离线采张手/捏合/释放序列，对DH116右手建立六主动轴、十一总DOF受限模型，比较有/无投影时三指指尖距离、跳变、释放滞后；使用仿真与日志即可，不解锁当前根因未知的整手/多轴运动。未来接臂需另做运动学、碰撞与命令接口核验；本篇是单臂证据，双臂仅可借鉴数据与控制分层" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_5_branch_2" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_81_5_field_3" parent="paper_81" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_81_5_branch_3" edge="1" parent="paper_81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1356.0" as="sourcePoint"/><mxPoint x="3322" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
