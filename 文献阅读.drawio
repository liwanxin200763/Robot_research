        <mxCell id="paper_51_4_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：只在开90度数据训练，测试开30度：DexHandDiff70%，条件扩散16.7%。表示完成指定新角度并满足任务判据，而非仅门角度预测准确" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
