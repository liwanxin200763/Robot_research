            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_1_field_3" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Dexterous Manipulation / Dexterous Hand / Robot Manipulation 方向，主要讨论机器人策略泛化需要大量高质量真实数据。&lt;br&gt;核心思路是Simulation-Guided Fine-Tuning 从物理仿真提取结构先验，加速真机策略适配。&lt;br&gt;与当前项目的联系：项目联系：双臂普通夹爪的真实示范预算有限" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_1_branch_3" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_1_field_4" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：机器人策略泛化需要大量高质量真实数据&lt;br&gt;&lt;br&gt;为什么重要：提供小数据真机适配的可比较路线" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_1_branch_4" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_1_field_5" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：仿真预训练后的真实机器人在线适应&lt;br&gt;价值函数估计某状态距离长期任务成功还有多少潜力；作者希望用它指导短时真机探索，而不是相信仿真动力学逐步预测都准确&lt;br&gt;核心研究问题：锤击、插接和推软物体涉及敏感接触，仿真策略直接上真机常失败；从头在线强化学习又耗时、损设备&lt;br&gt;能否保留仿真学到的任务方向，只用少量真机交互学会真正的接触动作&lt;br&gt;之前方法的问题：零样本域随机化或系统辨识难穷尽摩擦、刚度和碰撞细节；长时模型预测在真实环境会逐步积累误差&lt;br&gt;一般真机 RL 若无方向指引，必须反复随机探索整个长任务" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_1_branch_5" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2210.5" as="sourcePoint"/><mxPoint x="562" y="2210.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_2_field_1" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化&lt;br&gt;&lt;br&gt;之前方法的问题：普通微调方法在真机新任务上仍需要较多示范" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_2_branch_1" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_2_field_2" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;SAC：一种通过奖励学习连续动作的强化学习算法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_2_branch_2" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_2_field_3" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：域随机化、系统辨识尝试让仿真足够像真机，以直接迁移策略&lt;br&gt;SGFT 接受模型仍有偏差，把仿真当任务结构先验，再靠短时真实数据适应实际接触&lt;br&gt;相关方向 2：SAC、TDMPC-2 等在线强化学习能从反馈中改策略，却可能需要很多危险或低效尝试&lt;br&gt;只做潜在奖励塑形也未充分利用短时规划；本文在有限时域目标与在线优化中共同使用仿真价值&lt;br&gt;代表工作：论文比较 SAC、TDMPC-2、IQL、RLPD、奖励塑形以及域随机化/系统辨识等基线&lt;br&gt;比较时要分清仿真预训练量、真实交互时间和环境奖励来源，不能只摘最终成功率&lt;br&gt;与已有方法的区别：先在仿真中学策略和价值，再用仿真价值为每段短时真机训练提供终点价值&lt;br&gt;短时段减少模型误差累积；目标仍指向长期成功，避免只优化眼前一步的奖励" vertex="1">
          <mxGeometry height="779" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_2_branch_3" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1464.5" as="sourcePoint"/><mxPoint x="1252" y="1464.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_3_field_1" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;Simulation-Guided Fine-Tuning 从物理仿真提取结构先验，加速真机策略适配" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_3_branch_1" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_3_field_2" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把仿真价值函数作为真实环境的任务进度先验，构造以状态价值变化为核心的奖励指引&lt;br&gt;当真实接触与仿真不同，策略仍能沿正确的大方向探索，同时依据真实结果调整具体动作&lt;br&gt;贡献 2：将长期任务拆成 H 步短时优化，在每段末尾使用仿真价值作为剩余任务估计&lt;br&gt;这样真实模型只需预测较短未来，降低锤击或推软球时因接触误差引起的长期预测偏移&lt;br&gt;贡献 3：提供 Dyna-SGFT 和 MPC-SGFT 两种实例，分别把仿真先验结合短分支模型 rollout/在线学习与模型预测控制&lt;br&gt;共同核心是短时真机数据加仿真价值，而非固定依赖某一个 RL 算法&lt;br&gt;方法流程：在仿真中训练策略和价值函数 → 用仿真策略初始化真机控制 → 收集少量真实接触轨迹&lt;br&gt;在短时优化中使用真实奖励与仿真价值给出的远期方向 → 反复更新并比较真机成功率和交互成本" vertex="1">
          <mxGeometry height="814" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_3_branch_2" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="955.0" as="sourcePoint"/><mxPoint x="1942" y="955.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_3_field_3" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1390" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_3_branch_3" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1604.5" as="sourcePoint"/><mxPoint x="1942" y="1604.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_4_field_1" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：作者报告所需真实样本最多减少约一个数量级，并优于基线微调方法；具体任务见论文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告所需真实样本最多减少约一个数量级，并优于基线微调方法；具体任务见论文" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_4_branch_1" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_4_field_2" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：真实 Franka FR3 的五项动态接触任务：锤钉、插桌腿、推冰球、推毛巾和推软球&lt;br&gt;控制约 5 Hz，物体状态借点云颜色阈值或 ArUco 等估计，评测的是具备状态/奖励信号的 RL 设置&lt;br&gt;对照：直接仿真迁移、从头在线 SAC/TDMPC-2、其他离线到在线 RL、仅奖励塑形和多种仿真域泛化做法&lt;br&gt;关键读法是比较达到同样真实成功率所需的交互时间，而不只看最后一次评测&lt;br&gt;结果：作者报告锤击和部分推物任务在约 1 小时真机微调内达到 100% 成功，插接约 2 小时达到 70%&lt;br&gt;论文摘要称相对若干对照最高可节省约一个数量级的真实样本；各任务速度不同，不能概括为五项都一小时成功&lt;br&gt;关键补充：零样本仿真策略在这些接触丰富的真机任务上整体表现差，说明价值引导不等于直接把仿真动作照搬&lt;br&gt;论文的正向结果依赖真实交互、目标状态估计及可计算的奖励；纯视频、无奖励部署并未在此验证" vertex="1">
          <mxGeometry height="779" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_4_branch_2" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_4_field_3" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_4_branch_3" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1566.0" as="sourcePoint"/><mxPoint x="2632" y="1566.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_5_field_1" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：双臂普通夹爪的真实示范预算有限&lt;br&gt;&lt;br&gt;主要局限：仿真先验对接触和相机变化的稳定性需在目标硬件验证&lt;br&gt;&lt;br&gt;局限与启发：主要局限：仿真先验对接触和相机变化的稳定性需在目标硬件验证" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_5_branch_1" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_72_5_field_2" parent="paper_72" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：真实世界实验仍需调参和数据采集时间；从原始视觉获得稳定密集奖励并不容易&lt;br&gt;当仿真价值函数对真实状态排序本身错误，短时训练的方向也可能被误导&lt;br&gt;我的理解 / 不足：物体位置由点云/标记估计，成功奖励事先设计，和仅用语言及相机直接控制的 VLA 设置不同&lt;br&gt;五项集中于单臂桌面接触，未测试双臂同步、灵巧手或动态人机干扰，这是按实验范围作出的限制&lt;br&gt;未来展望：把价值先验接到视觉特征或世界模型，并用真机失败反馈识别错误先验&lt;br&gt;可以研究安全停止、复位与再次尝试，限制在线 RL 在易损设备上的碰撞成本&lt;br&gt;对我们项目的启发：若已有仿真和真机状态估计，可先在简单推、插任务测仿真价值是否能预测真实进度&lt;br&gt;对 DH116 需另设计触觉/接触奖励和安全动作约束；不能把单臂 FR3 的在线效率当成双臂灵巧操作结果" vertex="1">
          <mxGeometry height="779" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_72_5_branch_2" edge="1" parent="paper_72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1056.5" as="sourcePoint"/><mxPoint x="3322" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
