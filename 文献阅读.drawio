        <mxCell id="paper_57_5_field_rail" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="108" as="sourcePoint"/><mxPoint x="3310" y="1973" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_fulltitle" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;Dream4ACT: A Shared Visual Action Interface for Multi-Embodiment Video-Action Modeling" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_57_authors" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Xiangyu Zhu、Jin Xu、Yue Guo、Xin Wu、Yifan Sun、Xiancong Ren、Jianxin Sun、Yong Dai、Xiaozhu Ju" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
