        <mxCell id="paper_54_5_field_3" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="我的理解 / 不足：我的判断：可供性位置不等于接触力，物体遮挡和状态估计错可能让验证器误判。零真机动作微调的范围需要严格说明" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="350" as="geometry"/>
