        </UserObject><UserObject id="paper_24_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-32" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_24_1_field_1" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / CoRL 2026&lt;br&gt;引用量：1（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_1_branch_1" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_1_field_2" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;研究背景：双臂任务需要空间协调；把两臂动作一次性混在单一提示中难以清楚表达先后依赖。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：利用多智能体上下文学习，在少量演示条件下生成可协调执行的左右臂关键位姿。（第 1 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：单智能体提示容易忽略另一只手已经计划的路径；端到端监督策略通常需要特定任务数据。（第 2 节）" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_1_branch_2" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="902.5" as="sourcePoint"/><mxPoint x="562" y="902.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_1_field_3" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：双臂多智能体协作。两个独立语言模型代理分别规划一只手臂，通过先后传递计划配合&lt;br&gt;核心问题：不重训双臂策略，只看少量示例，两只手臂能否学会谁先做、谁配合？&lt;br&gt;之前的问题：一个提示同时管两臂不易讲清分工；两边各自计划又不知道对方下一步要做什么" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_1_branch_3" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1499.5" as="sourcePoint"/><mxPoint x="562" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_2_field_1" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;与已有工作的关系：与 TAO-DA 的单一 VLA 双塔专家不同，BiCICLe 是显式的双代理顺序计划架构" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_2_branch_1" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_2_field_2" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_2_branch_2" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="822.0" as="sourcePoint"/><mxPoint x="1252" y="822.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_2_field_3" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：从少量双臂示例中照着规划动作，能免去为每个任务单独训练策略&lt;br&gt;相关方向 2：leader 先规划一侧，follower 看过这份计划后再规划另一侧，减少相互冲突&lt;br&gt;代表对照：RoboPrompt-DA；在 TWIN 仿真和真实双臂上比较任务完成率&lt;br&gt;区别：两个冻结的文本语言模型分别出左右臂计划；第二个明确读到第一个的计划" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_2_branch_3" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1289.5" as="sourcePoint"/><mxPoint x="1252" y="1289.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_3_field_1" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：为左右臂建立 leader 与 follower 两个语言模型代理；先产生 leader 动作，再把它交给 follower 以生成互补动作。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：场景物体三维中心和任务示范序列化为文本，两个代理按顺序输出离散 7D 末端关键位姿。follower 提示包含 leader 轨迹；执行一个关键位姿队列后重新观察和规划。两臂有显式角色与行动消息，但没有长期共享场景记忆或独立训练的 VLA expert。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_3_branch_1" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_3_field_2" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：任务语言、示范、对象三维位置、当前双臂状态，以及 leader 已提出的动作。仿真对象分割使用真值，限制真实感知难度。（第 3–4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：左右臂 7D 末端关键位姿按 leader→follower 顺序生成，再由控制器执行；不是两个代理在每个时刻同时生成连续动作。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：将场景几何与示范压缩为文本，并将连续位姿离散化以适配语言模型；论文未报告独立数据增强收益。（第 3 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_3_branch_2" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1004.0" as="sourcePoint"/><mxPoint x="1942" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_3_field_3" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要使用已有语言模型的 in-context learning，不训练新的端到端双臂 VLA；模型对提示格式和调用次数敏感。（第 3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_3_branch_3" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1524.0" as="sourcePoint"/><mxPoint x="1942" y="1524.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_3_field_4" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：六路深度相机画面和物体分割合成三维物体位置，两侧代理共享这份简化场景&lt;br&gt;贡献 2：leader 看示例先输出一臂的位置、姿态和夹爪开合；follower 再参考这份计划规划另一臂&lt;br&gt;贡献 3：若两臂计划长度不同，让短的一侧保持最后动作；一段执行完再观察并重新规划&lt;br&gt;流程：两侧共享物体位置→leader 出计划→follower 依它出计划→对齐并执行→再看现场" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_3_branch_4" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1991.5" as="sourcePoint"/><mxPoint x="1942" y="1991.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_4_field_1" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：TWIN 13 项双臂任务，每项测试提示含 10 条上下文示范；真机为两台 Franka 的三项任务。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：TWIN 13 任务，三轮各 100 episode；对照 RoboPrompt-DA 等提示方法。监督式 3DFA 也列出，但其训练协议不同。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：两台 Franka、三项任务，每任务 10 次测试；平均成功率 53.3%，RoboPrompt-DA 为 33.3%。未报告一臂失败后另一臂协助恢复。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_4_branch_1" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_4_field_2" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：TWIN 平均成功率 70.5%，RoboPrompt-DA 为 64.4%；监督式 3DFA 为 85.1%，不能视为同数据设置下被 BiCICLe 超越。（第 4 节、主表）&lt;br&gt;&lt;br&gt;消融实验：去掉 leader 条件后 65.0%；对话式交互 57.5%；更昂贵的 best-of-N 为 71.2%。（第 4 节、消融表）&lt;br&gt;&lt;br&gt;Failure Case：细小物体抓取受离散化和三维位置误差影响；串行 LLM 调用增加延迟，论文报告约 125.3 秒，对照约 43.3 秒。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_4_branch_2" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_4_field_3" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：TWIN 测 13 个双臂任务，每项给 10 个示例；动作是 6D 手臂位姿加二值夹爪开合&lt;br&gt;对照：与 RoboPrompt-DA 比较；仿真用 3 个随机种子、每个种子 100 次尝试&lt;br&gt;结果：平均任务成功率从 64.4% 到 70.5%；但每次规划耗时约从 43.3 秒升到 125.3 秒&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真机：两台 Franka 真机测 3 项任务、每项 10 次；平均成功率从 33.3% 到 53.3%" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_24_4_branch_3" edge="1" parent="paper_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1671.0" as="sourcePoint"/><mxPoint x="2632" y="1671.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_24_5_field_1" parent="paper_24" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：静态随机化；两臂协调执行，未系统评测执行中独立移动目标&lt;br&gt;&lt;br&gt;主要局限：真实场景次数少，仿真使用理想分割。按本库分析，消息只承载计划动作，不承载失败原因或历史效果；没有 debate、LLM-as-Judge、共享 Failure Memory 和真机失败恢复实验&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可作双臂 Multi-Agent 架构基线：把一臂的计划作为另一臂的条件。若要接入 DH116 和失败互助，应另设计共享状态、失败证据传递和快速闭环控制；论文尚未验证这些功能" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
