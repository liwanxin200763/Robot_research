        <mxCell id="paper_52_4_field_1" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="实验：多机器人开箱测试及 Franka 七项适配任务；适配每任务10–100条示范。对照完整任务是否完成，而非只看动作符号预测准确率" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_4_branch_2" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
