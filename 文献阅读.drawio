        <UserObject id="category_04_paper_30" label="#30 SafeLoop&lt;br&gt;要解决：机器人快撞到物体/人时， 应继续、等待还是退回安全点？&lt;br&gt;年份 / Venue：2026，IROS 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-30" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="1620" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_04_paper_31" label="#31 FLARE&lt;br&gt;要解决：一次抓取或放置失败后， 机器人怎样继续原任务而非整次重来？&lt;br&gt;年份 / Venue：2026，CVPR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-31" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="1620" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_04_paper_44" label="#44 RESETTLE&lt;br&gt;要解决：策略跑偏后，高层语言诊断可能慢。能否利用模型自身动作的不一致触发干预，找一个成功参考状态，用短动作纠正后立即回到原策略？&lt;br&gt;年份 / Venue：2026 / arXiv 预印本，正式 Venue 待核验&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-44" tooltip="点击进入页面">
