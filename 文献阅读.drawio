        </UserObject><UserObject id="paper_135_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-134" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_135_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-141" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_135_1_field_1" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整论文名为 Dexterous Manipulation Transfer via Progressive Kinematic-Dynamic Alignment，简称PKDA，意为通过逐步进行运动学与动力学对齐来迁移灵巧操作。当前阅读的是9页AAAI-26正式会议版，页眉与版权年份均为2026；不能把会议年份当作首次公开年月。原卡记录的引用量是旧快照，本次没有检索实时引用数据库，因此引用状态应记为未实时核验。作者与机构来自首页，其中第四作者英文姓名在PDF中排成Jw L，不能凭邮箱自行补全。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_1_branch_1" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_1_field_2" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体问题与研究目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;从人手视频提取的动作看起来合理，机器人执行时却可能指尖没碰到正确表面、夹持力不足，刚抬起就滑落。问题同时来自手指数量、尺寸和关节结构不同，以及真实接触和惯性无法由几何姿态直接决定。本文要把一段人类操作转成多种灵巧手可执行的完整轨迹，以低成本生成机器人操作数据；目标既包括抓住物体，也包括保留摇晃、倾倒或敲击等操作意图。它主要是一条离线迁移和轨迹生成管线，不是由自然语言直接控制机器人的通用策略。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_1_branch_2" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="951.5" as="sourcePoint"/><mxPoint x="562" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_2_field_1" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制：重定向与物理优化&lt;/b&gt;&lt;br&gt;&lt;br&gt;运动重定向是把人手关节点或指尖位置转为机器人关节角的优化问题。AnyTeleop一类方法输入人手姿态，通过机器人正运动学计算对应位置，输出能在几何上模仿人手的关节配置。使用指尖到手腕向量能表达手的整体形态，但不同手型的手掌尺寸会让绝对接触位置偏离；即使几何误差小，也不能保证力闭合，即接触力能共同抵抗物体的外力和转矩。PGDM则从预抓姿态出发，用物体参考轨迹指导强化学习；D-Grasp用单帧抓姿及专门奖励生成动态接触。它们提供了物理改进，但探索耗时、任务奖励设计和参考范围会限制扩展。" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_2_branch_1" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_2_field_2" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;本文切入点与概念区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;运动学对齐回答关节和指尖应该放在哪里，动力学对齐回答在接触、重力和惯性作用下如何保持稳定。本文不让强化学习从空白学习整段操作，而先用几何映射给出基本动作，再让残差策略只补偿接触阶段的误差。残差动作就是在已有控制信号上增加小的修正量。之后用物体运动决定手腕轨迹，把高维探索集中在抓牢这一步。这样的分工依赖一个重要前提：后续操作期间手与物体的相对接触关系基本保持稳定。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_2_branch_2" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="986.5" as="sourcePoint"/><mxPoint x="1252" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_3_field_1" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;感知模块：视频变成可计算的交互先验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Interaction Perceptor输入RGB人手操作视频，输出手轨迹H、物体位姿轨迹O、接触点C与物体网格。每帧手状态包含5个指尖的三维位置共15维，以及手掌朝向3维；物体状态包含三维平移与三维旋转。已知物体模型时，使用HFL-Net从单目视频估计人手和物体姿态，再以指尖到表面的最小距离筛选候选接触点，阈值5厘米。未知模型时用HOLD联合重建手与物，随后做凸分解以便仿真碰撞检测，并降低重建物体的重心来改善稳定性。这里的重心调整是建模上的工程处理，不能理解成测得了真实质量分布；重建缺陷仍是误差来源。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_3_branch_1" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_3_field_2" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;轨迹提议：把绝对指尖位置作为主要目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trajectory Proposer逐帧求目标手的关节角q，目标函数是指尖位置误差、手掌朝向误差与时间平滑项的加权和。指尖误差比较人类与机器人指尖在世界坐标中的位置，机器人位置由正运动学计算；朝向误差用旋转空间中的测地距离，即两朝向之间最短旋转角；平滑项惩罚相邻帧关节角突变。绝对指尖位置优先，能让接触点更准确，手腕不必同时死板追随人腕。求得的离散关节序列再经逆动力学相关转换生成基础控制Aprimary。该结果提供可解释的初始轨迹，但还没有可靠解决抓持力与接触稳定性。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_3_branch_2" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1004.0" as="sourcePoint"/><mxPoint x="1942" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_3_field_3" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;接触优化：预抓初始化和动作空间缩放&lt;/b&gt;&lt;br&gt;&lt;br&gt;ContactAdapt Optimizer先用RL-Configurator把多种任务的开头统一成抓起物体。初始状态从基础轨迹中挑选：要求手物尚未碰撞，并让拇指到目标抓点最近。这个选择利用拇指对抓持的关键作用，减少无意义搜索。强化学习目标设置为参考物体第一次偏离初始位置0.1米时的位姿。策略输出修正基础控制的残差，其中前6维控制腕部平移与旋转，其余维度控制手指。动作空间缩放只把腕部活动范围压到预抓姿态附近，手指仍可在完整关节范围探索。这样既允许调整接触，也避免腕部大幅冲过物体，减少高维搜索中的干扰。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_3_branch_3" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1583.5" as="sourcePoint"/><mxPoint x="1942" y="1583.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_3_field_4" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;奖励：接近、接触与抬升分阶段提供信号&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一奖励包含三类用途。接近奖励引导各指尖靠近指定接触点，让尚未接触时也有训练方向；抓持奖励在所有指尖进入0.06米容差后启用，同时鼓励多点碰撞接触与模仿重定向姿态，姿态相似性采用关节角余弦相似度；抬升奖励要求拇指和至少另一根手指接触物体后才启用，引导物体到达目标位姿。这些门控避免策略在尚未抓牢时只追求移动物体。论文正式版只解释各项功能，把完整公式、系数和训练细节放在未随本地文件附带的附录A，因此不能据当前资料填写学习率、训练步数或复现用完整奖励表。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_3_branch_4" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2163.0" as="sourcePoint"/><mxPoint x="1942" y="2163.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_3_field_5" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;腕轨迹规划：保留任务语义的代价与收益&lt;/b&gt;&lt;br&gt;&lt;br&gt;抓稳后，Wrist Trajectory Planner使用物体参考运动及稳定抓持时的手物相对变换，计算每一帧腕部目标位姿，再由PD控制器跟踪。PD控制器根据位置误差及其变化产生纠正控制。其直观含义是：若抓住杯子后杯子相对手不滑动，则让杯子按参考做升起、倾斜、放回，手腕就应保持固定的相对抓持关系一起运动。这样不必用强化学习逐帧学整段任务，却也把频繁换指、手内滚动或滑动操作排除在主要适用范围外。原文变换公式涉及坐标约定，工程实现前应按实际坐标系验证乘法与逆变换，不能照OCR文本直接抄写。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="2458" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_3_branch_5" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2742.5" as="sourcePoint"/><mxPoint x="1942" y="2742.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_4_field_1" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务、数据、仿真与指标&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要评估在MuJoCo中进行，使用Adroit、Allegro和Leap三种手。完整信息场景从GRAB人工挑选约600条单手轨迹；公平比较PGDM时仅用其TCDM与GRAB重叠的40条任务。已知模型视觉场景从DexYCB和TACO各选10段右手操作；未知模型场景是自行拍摄的5类日用品操作。抓取成功要求物体保持在目标位置0.05米以内；跟随成功要求全程稳定持物不掉落；另报告平移误差、旋转误差与意图层面的迁移成功率TSR。TSR详细判定在缺失附录B，不能把它简单等同于抓取率或轨迹误差阈值。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_4_branch_1" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_4_field_2" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果与真实比较条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;40条TCDM重叠序列、Adroit手条件下，AnyTeleop、PGDM、D-Grasp、PKDA-P的TSR分别为7.5%、72.5%、57.5%、77.5%；PKDA-P抓取率与跟随率均80%。与PGDM相比TSR提高5个百分点，但平移误差0.058米高于PGDM的0.005米，旋转误差31.5度也高于18.2度。因此不能说所有指标都最好：本文优先保持任务意图并减少迁移训练，PGDM则更精确地追踪物体轨迹。600条GRAB上的PKDA-F抓取84.2%、跟随77.6%、TSR73.3%，摘要约73%的数字来自这一量级，不能与40条子集混用。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_4_branch_2" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_4_field_3" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;泛化、消融和失败解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;已知模型和未知模型视觉场景的TSR分别70%与80%，对应样本规模不同，不能据此断言未知模型更容易。40条任务上Adroit、Allegro、Leap的TSR为77.5%、72.5%、67.5%，大手处理小或细长物体更困难。改用指尖到腕部向量后TSR从77.5%降到70%，差7.5个百分点。最近时刻的拇指引导加动作缩放为77.5%，取消缩放后37.5%，降低40个百分点，说明腕部过冲对训练影响很大；同条件食指、中指引导分别70%和67.5%。这些结果支持局部探索与预抓设计，而没有给出其在当前DH116平台上的效果。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_4_branch_3" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_4_field_4" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机、成本与证据范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机使用UR10机械臂搭载Leap手，展示Shake、Pour、Stamp三类任务。执行方式是把仿真生成轨迹直接以开环控制在实物上播放，正文给出成功展示，没有多次试验汇总成功率、相机具体型号或完整耗时表。不能把仿真平均73.3%写成真机成功率，也不能把开环展示称作在线视觉纠错。图4表明学习效率优于相关对照，但当前正文没有足以精确引用的统一墙钟数字。重建、仿真建模、每段抓持优化以及真实手的控制接入仍构成实际成本。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_4_branch_4" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2075.5" as="sourcePoint"/><mxPoint x="2632" y="2075.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_5_field_1" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出主要处理较稳定的手物接触模式，未来要研究多个接触点频繁变化的灵巧操作。输入端仍依赖手姿估计和物体重建，遮挡导致的几何缺陷会影响预抓与接触。本文已经通过带感知误差实验验证一定鲁棒性，但没有证明复杂未知场景或快速接触切换也能保持同等表现。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_5_branch_1" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_135_5_field_2" parent="paper_135" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向当前项目的分析与建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;对人手到机器人路线最可借鉴的是先对齐接触几何，再在物理环境中修正，而不是要求DH116重现所有人手关节。若目标末端是夹爪，应把多指指尖约束改成两侧接触或夹持轴约束，并重新定义预抓，而不能直接继承拇指奖励。D435i可提供物体位姿或点云，但本文没有在D435i上验证这套迁移，需先检查深度空洞、标定与遮挡影响。建议先用静态接触的抓起后倾倒任务验证手物相对变换，再加入视觉闭环检查物体是否被真正带起、是否滑落；检测失败后回到预抓重试。这里的闭环与重试是本项目扩展建议，原文真机采用开环。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_135_5_branch_2" edge="1" parent="paper_135" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-141" name="06-17 3D Diffuser Actor">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_141_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_141_topnav_1" label="返回分类" link="data:page/id,literature-page-06" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_141_topnav_2" label="上一篇" link="data:page/id,literature-paper-135" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_141_topnav_3" label="下一篇" link="data:page/id,literature-paper-142" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
