          </mxCell>
        </UserObject><UserObject id="paper_123_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-120" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_123_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_123_1_field_1" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与时间来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：Think Small, Act Big: Primitive Prompt Learning for Lifelong Robot Manipulation。方法简称PPL。前三位Yuanqi Yao、Siao Liu、Haoming Song共同贡献，Dong Wang通讯；机构包括上海AI Lab、复旦、上海交大、浙江大学、西北工业大学、中国电信TeleAI、INSAIT/Sofia University。年份 / Venue：CVPR 2025，本地11页为CVF接受版，与canonical卡标题一致。官方https://arxiv.org/abs/2504.00420确认首次公开2025年4月1日，v2更新2025年6月1日，与会议出版分开；引用量未实时核验。" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_1_branch_1" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="424.5" as="sourcePoint"/><mxPoint x="562" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_1_field_2" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、具体问题与目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;终身操作学习既要保留旧技能，也要让旧知识帮助新技能。经验回放需存旧数据；每任务单独LoRA虽隔离干扰，却不一定共享“语义不同、运动相似”的动作原语。本文具体关注抓香蕉与放锅等任务是否存在可迁移的低层运动模式。目标是在多技能预训练中学可组合的潜在primitive prompts，再通过新增少量提示参数学习新技能，当前阶段不访问旧示范，并利用原有提示改善新技能学习。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_1_branch_2" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="969.0" as="sourcePoint"/><mxPoint x="562" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_2_field_1" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与提示学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;经验回放混入旧轨迹避免遗忘，但内存随任务增长；正则化约束旧参数，动态架构扩分支隔离任务；TAIL等按任务加LoRA，能减少相互覆盖，却可能各学各的。Prefix prompt不是用户写给聊天模型的文字，而是插入Transformer注意力键/值的可训练连续向量。本文将它们作为共享运动原语的潜在载体，不能将每个prompt等同人工命名、可直接调用的“抓取”函数。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_2_branch_1" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_2_field_2" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;运动语义查询与指标术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;单纯文本查询通常把语义近的抓杯/抓方块放一起，却遗漏抓杯/放香蕉在某时段运动相似的关系。光流描述图像局部运动，搭配CLIP任务语义让提示既关注动态又不丢任务目的。本文FWT定义为适应新任务可达到的最大成功率，BWT是学完当前任务后旧任务表现相对各自历史最好表现的平均差；它与一些持续学习文献“未训练新任务零样本迁移”的FWT定义不同，必须沿用本文口径。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_2_branch_2" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_3_field_1" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;观察→扩散策略与前缀提示&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略输入本体感知、RGB观察、语言指令及由视觉流计算的运动信息，预测未来动作序列。主干为diffusion transformer policy。每层提示p被分成pK与pV，分别前置到注意力的key/value序列，query仍来自观察特征。预训练阶段跨多任务联合优化策略和提示，让一组共享提示编码潜在运动片段；本文不是在大VLM上生成文字动作，也不是大模型规划器调用技能库。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_3_branch_1" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_3_field_2" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Motion-Aware Prompting&lt;/b&gt;&lt;br&gt;&lt;br&gt;RAFT迭代估计光流F，Φ提取其运动特征；预训练CLIP把任务T编码为语义向量，学习函数fprompt融合两者得到MAP(T,F)。光流基于短时间亮度一致性，侧重运动结构，对不同纹理有一定不变性，但光照突变会破坏这一假设。语言补充任务区分，防止纯光流把看似相同的运动都混为同一目标。原文没有完整列出部署取哪两帧、flow编码器全部规格与动作维度，因此这些不能根据RAFT名称或Diffusion Policy惯例补写。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_3_branch_2" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_3_field_3" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;组件加权和可复用原语&lt;/b&gt;&lt;br&gt;&lt;br&gt;建立提示组件库P、对应keys K和注意向量A。MAP查询与A逐元素结合形成Atten Query，再与各Km算余弦相似αm，最终提示为ΣαmPm。不同任务/时刻可得到不同权重而非固定任务ID选择一块adapter，既能借语义关系迁移，也能借运动相似迁移。图6只展示权重模式，不提供每个潜在组件的人工语义；相似权重支持共享表示假说，不能直接等同已发现具有物理因果意义的独立原语。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_3_branch_3" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1391.0" as="sourcePoint"/><mxPoint x="1942" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_3_field_4" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;终身扩展与冻结机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;学新技能时保留预训练提示及此前终身提示，扩展P/K/A为新任务分配组件，仅更新当前任务新增提示参数。权重计算仍允许访问所有已冻结组件，使新任务重用旧原语；旧参数不被覆盖，同时无需取回旧训练示范。原文强调确保扩展不改变旧任务权重计算，但未完整展开任务路由/屏蔽细节。算法1第15行写更新p和model parameters，与正文“only update当前任务prompts”不完全一致，笔记以正文解释机制并记录复现疑点。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_3_branch_4" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1900.5" as="sourcePoint"/><mxPoint x="1942" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_3_field_5" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据与优化边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真技能集由MimicGen和LIBERO整理，MimicGen相关技能每项约1000示范、初始状态分布广。训练用扩散动作损失，预训练多技能阶段与后续新技能监督学习分开。所谓lifelong不是部署中从成败自举新标签，而是收到新任务专家示范后增量训练。论文11页主文未给完整GPU配置、绝对训练小时、每任务参数增量、总提示容量和推理延迟，也未给所有数据集切分统计，本次不从未读取补充材料代填。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_3_branch_5" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2427.5" as="sourcePoint"/><mxPoint x="1942" y="2427.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_4_field_1" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验范围与真机设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;Franka Panda单臂验证抓香蕉/方块、放到篮子/毯子、压茶壶把手、放羊角包/饮料等。正文称多技能预训练4项、每项200条人类示范、每技能15次独立运行，随机物体初始位置。本地叙述存在范围差异：图4说9项技能、4预训练+5终身，正文说另4项，表2却只列2预训练+3终身。笔记分别保留各来源，不把“9项全部每项15次”作为已确认统一设计。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_4_branch_1" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_4_field_2" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;LIBERO与真机结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;图7 LIBERO预训练平均PPL0.84±0.02、MoE0.82±0.03、Diff-T0.77±0.02；后续3技能平均PPL0.73±0.03、Sequential0.72±0.04、ER0.65±0.03，第三技能PPL0.71低于Sequential0.74，非每项最优。真机表2预训练平均PPL0.84±0.05、MoE0.73±0.08、Diffusion Transformer0.42±0.09；终身3项PPL0.72/0.68/0.63，平均0.68，Sequential0.55、ER0.58。成功率均为0–1比例，差0.13即13个百分点。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_4_branch_2" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_4_field_3" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;MimicGen表格的数值问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;表1列7个后续任务，Sequential平均FWT0.65、BWT−0.56，ER0.61/−0.46，LoRA平均FWT标0.78，PPL标0.83。可是PPL逐行0.88、0.75、0.83、0.79、0.60、0.73、0.54的简单均值约0.731，并非0.83；LoRA逐行也不对应该表平均。因此保留作者标注与算术不一致提醒，不以0.83断言统一平均收益。表中LoRA/PPL没有列BWT，不可据空列声称实测零遗忘；需要补充原始结果或作者说明。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_4_branch_3" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_4_field_4" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融、光照与效率&lt;/b&gt;&lt;br&gt;&lt;br&gt;去掉预训练prompt、或新技能不用旧prompt，图8表现下降；prompt数过少难覆盖原语，过多未匹配组件引入噪声，说明容量需平衡。光照表3 warm→cold→dark下，flow+text为0.61、仅text0.80、Diff-T0.75；静态dark分别0.48/0.61/0.52。光流并非所有条件都有利，文本降级在强光变更稳。作者称MoE训练约为LoRA/PPL两倍，但未给本地可追溯绝对时长，不能写成明确GPU成本节约。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_4_branch_4" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1883.0" as="sourcePoint"/><mxPoint x="2632" y="1883.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_5_field_1" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者承认的限制&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确观察到复杂光照使光流查询退化，提出以后加入深度和3D scene flow，而非已实现的鲁棒方案。提示数量也非越多越好。实验以有限技能流验证，不足以说明长期无限增长的参数、任务检索和旧技能保持已解决；图表缺失BWT与内部样本数矛盾，使“既学得快又完全不忘”的强结论证据不足。真机是单臂，并未验证双臂接触协作或移动操作。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_5_branch_1" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_123_5_field_2" parent="paper_123" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：静态语义与视觉运动共享能帮助迁移，但相机移动、遮挡和光照可能让光流主要描述背景变化；扩展提示库还可能改变软匹配归一化。研究启发：复现时先核对表1均值、任务列表与冻结范围，报告旧任务逐项保持曲线、每任务参数增长和路由掩码；以同策略/数据比较文本、光流、深度流，并检查相似提示是否对应真实可迁移动作片段。对新技能应区分性能峰值和固定预算最终成功，避免只报最佳检查点。这些建议未在本机测试。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_123_5_branch_2" edge="1" parent="paper_123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="881.5" as="sourcePoint"/><mxPoint x="3322" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-page-03" name="03 动态环境与世界模型">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="3120" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="category_03_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="80" y="42" width="290" height="60" as="geometry"/>
          </mxCell>
        </UserObject>
        <mxCell id="category_03_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="03 动态环境与世界模型">
          <mxGeometry x="100" y="150" width="2000" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="category_03_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#24435A;align=left;verticalAlign=top;spacing=24;" value="这个方向在研究什么：动态环境与世界模型&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作&lt;br&gt;&lt;br&gt;知识链条：当前状态 → 识别环境变化 → 更新或预测 → 执行动作 → 再观察&lt;br&gt;共 14 篇 · 点击下方卡片进入独立论文页，再按本类编号顺序浏览">
          <mxGeometry x="100" y="280" width="2000" height="330" as="geometry"/>
        </mxCell>
        <UserObject id="category_03_paper_02" label="#2 LT-Mem&lt;br&gt;要解决：机器人隔天再来，杯子已换位置。它怎样认出还是同一只杯子，并记住变化？&lt;br&gt;年份 / Venue：2026；IROS 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-02" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_03_paper_03" label="#3 DIAL&lt;br&gt;要解决：高层说“把杯子放好”，低层动作怎样真正朝这个结果移动，而不只照当前画面动作？&lt;br&gt;年份 / Venue：2026；arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-03" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_03_paper_22" label="#22 Mem-World&lt;br&gt;要解决：手挡住物体、手腕相机换角度时，模型还能否记住物体并预测下一帧？&lt;br&gt;年份 / Venue：2026，CoRL 2026（PDF 为预印本）&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-22" tooltip="点击进入页面">
