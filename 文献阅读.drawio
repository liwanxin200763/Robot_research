        <mxCell id="paper_43_4_field_1" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="实验：CALVIN 连续五条指令任务和 AIRBOT 真机多步骤操作；另有动态摆动目标。完整五步成功率与平均完成指令数是不同指标" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_4_branch_2" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="460" as="sourcePoint"/>
            <mxPoint x="1615" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_43_4_field_2" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对照：与3D Diffuser Actor、RT-1、ACT 等比较，消融目标生成和反馈误差设计。不能把不同平台任务合并成一个自算平均成功率" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_4_branch_3" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="700" as="sourcePoint"/>
            <mxPoint x="1615" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_43_4_field_3" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：CALVIN 平均完成3.53条指令，对照3.27；五步全部完成45.4%，对照41.2%。前者表示进度，后者才是完整五步任务成功率" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_4_branch_4" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="940" as="sourcePoint"/>
            <mxPoint x="1615" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_43_4_field_4" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：真机三步任务完整成功26.7%（15次），动态目标任务20%，对照为0。证明有一定响应能力，也说明该设置距离稳定部署仍有明显差距" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_5_drop" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
