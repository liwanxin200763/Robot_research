          </mxCell>
        </UserObject><UserObject id="paper_132_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-133" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_132_1_field_1" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexTrack: Towards Generalizable Neural Tracking Control for Dexterous Manipulation from Human References，本地25页ICLR 2025 PDF与canonical一致。官方 https://arxiv.org/abs/2502.09614 记首次2025年2月13日、仅列v1，不能把ICLR发表与首次预印本混为同一时间。作者为清华/期智/上海AI实验室与UCSD团队；旧卡引用量32本次未核验。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_1_branch_1" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_1_field_2" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Xueyi Liu、Jianibieke Adalibieke、Qianwei Han、Yuzhe Qin、Li Yi；清华大学、上海期智研究院、上海AI实验室、UC San Diego。代码/项目核验：https://meowuu7.github.io/DexTrack；arXiv官方页列代码链接（具体可运行版本未核验）。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_1_branch_2" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="846.5" as="sourcePoint"/><mxPoint x="562" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_1_field_3" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;人类手物轨迹给出的是运动学参考，即手和物体希望处在哪里；把参考直接映射到机器人关节并不能保证摩擦和接触力足以实现它，甚至会产生穿透或不可达状态。本文要训练一个通用神经跟踪控制器，使机器人根据参考下一状态和当前真实状态，产生物理可执行的控制，覆盖薄物体、手内重定向和动态接触；难点是既缺大量成功控制示范，又很难靠从零RL学到所有轨迹。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_1_branch_3" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1321.0" as="sourcePoint"/><mxPoint x="562" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_2_field_1" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与目标抓取及逐轨迹优化的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;目标抓取策略常只需抓起并移动到一个目标，OmniGrasp类方法可跟踪物体路径，但复杂手内运动仍困难。逐轨迹RL或轨迹优化能为单一参考找控制，却没有直接得到能看新参考就执行的通用控制器。DexTrack把逐轨迹求解当作数据生成器，把人类参考、成功状态与专家动作配成示范，再用模仿+强化学习训练共享控制器，并反过来利用它改进难轨迹求解。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_2_branch_1" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_2_field_2" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;同伦与数据飞轮&lt;/b&gt;&lt;br&gt;&lt;br&gt;同伦优化在这里是先解决与目标相近、较易的任务，再逐步把已有解转移到更难的目标，不是文本语言推理。父任务提供较好的基准动作轨迹，子任务在该基准上学习残差。数据飞轮是控制器和示范相互改进：更强控制器帮助找到新成功轨迹，更多高质轨迹再训练出更强控制器；它需要显式优化与筛选，不能理解为机器人部署中无限自主学习。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_2_branch_2" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_3_field_1" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：重定向参考与控制输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;从GRAB/TACO的人类手物轨迹，用PyTorch Kinematics和L-BFGS最小化人手、机器人手关键点差，得到机器人手和物体的参考状态序列。控制器每步看当前手物状态/速度、下一参考状态、基准轨迹、上次动作、指尖位置、状态差，以及物体PointNet编码几何。参考动作不直接当真值命令，因为它只满足几何近似，并未考虑真实接触动力学。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_3_branch_1" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_3_field_2" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：残差跟踪动作与奖励&lt;/b&gt;&lt;br&gt;&lt;br&gt;浮动手含16个手指关节加腕部6自由度，共22维位置目标。策略输出相对基准的残差增量，累加后叠在基准轨迹上，经PD控制器执行，减少从任意关节空间探索的负担。奖励同时考虑物体位置/旋转、腕部、手指参考误差和手物亲和；附录说明不对参考速度直接设奖励，避免差分放大重建噪声。当前状态来自环境反馈，所以控制器可以偏离不可达参考以维持可实现的接触。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_3_branch_2" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_3_field_3" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：模仿与RL共同训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;用PPO在大量并行仿真中优化跟踪奖励，同时用专家轨迹中的动作做监督，让策略少走无效探索。模仿提供在困难阶段如何动作的指导，RL让它见到偏离专家轨迹的状态并学习恢复。两者共同作用于同一控制器，不是单纯离线BC后完全冻结。作者只用奖励高于阈值50的轨迹给动作监督，避免把不可靠的逐轨迹求解复制到通用策略。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_3_branch_3" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1338.5" as="sourcePoint"/><mxPoint x="1942" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_3_field_4" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：用共享跟踪先验改善专家&lt;/b&gt;&lt;br&gt;&lt;br&gt;对某个参考先运行已有通用控制器，把得到的动作序列改作新的基准，再重新训练该参考的残差PPO。这样把共享控制器从其他轨迹学到的跟踪知识转给单轨迹专家。单靠自己生成示范会偏向已会技能，因此另外搜索相邻参考之间可以转移的父子关系，用更容易且已成功的父轨迹作为初始化，逐步解原本失败的薄物体或小球抓取。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_3_branch_4" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1795.5" as="sourcePoint"/><mxPoint x="1942" y="1795.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_3_field_5" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：学习同伦路径生成器&lt;/b&gt;&lt;br&gt;&lt;br&gt;先以参考相似性筛每任务10个邻居，尝试转移并记录哪些父任务能改善子任务，最多3轮。为避免推理时穷举，训练条件扩散生成器：条件是目标参考与物体形状，输出潜在有效父任务；反复预测父任务形成优化路径，再从最易端往目标端逐个优化。生成器输出的是参考任务序列，不是直接控制力矩，仍需逐轨迹RL验证路径效果。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2038" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_3_branch_5" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2252.5" as="sourcePoint"/><mxPoint x="1942" y="2252.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_3_field_6" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤六：逐批扩充与真机执行接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;先100条参考生成初始专家并训练控制器；按物体跟踪误差选另100条，形成200条集合并学习路径生成器；再加入200条形成第三阶段数据。以最好成功解重训控制器，而非粗暴标注全部数据。真实LEAP+Franka部署时用FoundationPose估计物体位姿、差分估计速度，并先把策略命令送入同参数模拟手，读取模拟后的位置再作为真实位置目标，以缓解模拟PD与实机控制接口差异。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2495" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_3_branch_6" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2727.0" as="sourcePoint"/><mxPoint x="1942" y="2727.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_4_field_1" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、平台和评测&lt;/b&gt;&lt;br&gt;&lt;br&gt;重定向GRAB1269条、TACO2316条。GRAB留subject s1的197条测试；TACO训练1565条，S0/S1/S2/S3分别207/139/120/285条，依次提高对象几何、交互组合和新类别的难度。仿真Allegro、真机LEAP，均有16关节；训练8192并行环境，测试结果平均1000并行环境。成功同时限制物体平移、旋转及手部误差，分严格10cm/20°/0.8和宽松10cm/40°/1.2两套阈值，不是单纯抓起。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_4_branch_1" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_4_field_2" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与泛化边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;GRAB严格/宽松成功46.70%/65.48%，PPO自定义跟踪奖励基线38.58%/54.82%；TACO S0为48.77%/74.38%，该基线34.98%/57.64%。主表GRAB物体位置误差4.53cm，TACO2.10cm；附录说明跨轨迹误差汇总用中位数，不能一概写均值。TACO S3新类别和新交互严格成功仅10.18%、宽松46.32%，表明泛化难度增大仍显著下降。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_4_branch_2" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_4_field_3" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据质量、路径与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;相同示范数量下，不用控制器先验和同伦的TACO成功44.83%/67.00%，完整48.77%/74.38%；无动作示范监督时31.03%/57.64%。同伦生成器在每组50任务评测中，GRAB训练内未见64%有效、GRAB测试56%、跨TACO仅28%，联合训练后52%；有效指比直接逐轨迹RL更好。TACO完整管线约4天，在8张A10机器上并行优化专家、每模型单卡；全GRAB逐条标注需16 GPU约一周，成绩仍低于高质子集方案。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_4_branch_3" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_4_field_4" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真实结果与失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机用RealSense、FoundationPose和LEAP+Franka，分别报告接近并抬起一侧、完全离桌、离桌后跟踪超过100步三级成功。主文表2是迁移状态控制器，附录表7/8还含直接轨迹迁移，两种设置不可混用。附录GRAB三级平均0.537/0.415/0.293，即53.7/41.5/29.3%，不是所有条件都达70%以上；每对象轨迹数及重复试次数未统一清楚报告。典型失败是接触变化时物体掉落。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_4_branch_4" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1848.0" as="sourcePoint"/><mxPoint x="2632" y="1848.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_5_field_1" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出高质量示范挖掘耗时，未来需要更快近似同伦优化；新类别且很薄的物体、跨域交互仍会失败。仿真忽略手的重力、控制与仿真均60Hz，真实控制专门做接口修正，说明迁移并非直接复制网络输出即可。作者自定义的泛化/鲁棒/适应性分数不是领域统一标准，应与实际轨迹误差、成功条件一起读。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_5_branch_1" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_5_field_2" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116与视觉分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116可借鉴“运动学参考—物理跟踪示范—通用跟踪器”的分层，不宜只做关键点对齐就宣称人类操作可执行。需要独立标定关节耦合、控制延迟与PD/位置接口，物体状态估计遮挡误差也要进入测试。触觉可针对接触变化与滑落补充信息，但本文未验证触觉收益；建议先选薄物体或轻度重定向，逐项比较加入接触条件后的跟踪与掉落率。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_5_branch_2" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="829.0" as="sourcePoint"/><mxPoint x="3322" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_5_field_3" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;后续验证分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;可用少量高质参考验证残差动作是否降低探索，再决定同伦路径生成是否值得成本。应分开报告参考本身是否可达、专家求解成功、共享策略新轨迹成功和真实闭环成功；同时区分已见几何新运动与真正新类别。对DH116迁移必须建立本手模型与重定向，不应挪用Allegro或LEAP百分比作为性能预期，也不能声称本文已实现双臂或通用视觉端到端操作。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_5_branch_3" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1321.0" as="sourcePoint"/><mxPoint x="3322" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_132_5_field_4" parent="paper_132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;参考与任务成功的分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;跟踪误差与功能成功仍有区别：参考物体姿态接近目标可能得分较高，却未必完成真实工具用途；宽松旋转阈值也容忍明显方向偏差。若应用于DH116功能操作，应把轨迹忠实度和对象使用效果分别评测，并将接触改变时掉落作为独立失败类型。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_132_5_branch_4" edge="1" parent="paper_132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1778.0" as="sourcePoint"/><mxPoint x="3322" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
