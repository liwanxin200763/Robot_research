        <mxCell id="paper_52_4_field_4" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：目标任务适配中平均表现较强，但扩散策略在部分单指令精细任务仍竞争力很高。消融还表明视觉编码器训练和数据清洗很重要" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
