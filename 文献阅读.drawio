ground="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="category_07_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="80" y="42" width="290" height="60" as="geometry"/></mxCell></UserObject><mxCell id="category_07_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="07 VLA 基础与泛化"><mxGeometry x="80" y="125" width="1440" height="88" as="geometry"/></mxCell><mxCell id="category_07_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="这个方向在研究什么：研究通用视觉语言动作模型如何学习并迁移到新物体、新场景与新机器人&lt;br&gt;共 4 篇 · 建议先看 #20 π0.5，再按本页顺序浏览"><mxGeometry x="80" y="232" width="1440" height="105" as="geometry"/></mxCell><UserObject id="category_07_paper_20" label="#20 π0.5&lt;br&gt;要解决：把来源不同的机器人动作和图文资料一起学习后，模型能否在没练过的房间清理物品？&lt;br&gt;年份 / Venue：2025，arXiv 技术报告&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-20" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_07_paper_52" label="#52 OpenVLA&lt;br&gt;要解决：如何用已有视觉语言理解和大量机器人示范，得到可以复现、可以换任务微调的通用机器人控制模型，而非只能调用闭源接口？&lt;br&gt;年份 / Venue：2024 / CoRL 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-52" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_07_paper_53" label="#53 SpatialVLA&lt;br&gt;要解决：模型知道“拿杯子”，却可能分不清该伸多远、抬多高。怎样把三维位置和动作几何关系显式放进模型，并在换机器人时适配？&lt;br&gt;年份 / Venue：2025 / RSS 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-53" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_07_paper_54" label="#54 Sim2Real-VLA&lt;br&gt;要解决：仿真画面与真实背景、物体材质不同，直接学动作容易失效。能否以物体关键交互为中间目标，让模型关注任务必要运动而不是环境外观？&lt;br&gt;年份 / Venue：2026 / ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-54" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><mxCell id="category_07_foot" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="选择上方论文卡片进入详情 · 详情页可按上一篇 / 下一篇顺序浏览"><mxGeometry x="80" y="855" width="1440" height="55" as="geometry"/></mxCell></root></mxGraphM