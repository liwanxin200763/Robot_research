parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#42 DreamTrue"><mxGeometry x="120" y="126" width="2460" height="90" as="geometry"/></mxCell><mxCell id="detail_42_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="03 动态环境与世界模型  ·  本类第 7 / 8 篇  ·  问题：若世界模型把抓空也画成抓住，机器人会错误评估计划。怎样保证预测中的机械臂和物体运动符合输入动作，连失败也能生成？&lt;br&gt;方法流程：记录场景与相机 → 几何标定 → 改变候选动作并渲染条件 → 生成未来视频 → 人标记交互缺陷 → 学奖励并后训练 → 再评估动作忠实性&lt;br&gt;结果：论文表中交互缺陷48.12%→6.25%，物体缺陷31.88%→3.12%。表示这组生成视频更少出现被人工识别的缺陷，未证明真实任务同幅度提高"><mxGeometry x="120" y="228" width="2460" height="130" as="geometry"/></mxCell><mxCell id="paper_42" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="1100" width="2399" x="140" y="375" as="geometry"/>
        </mxCell>
