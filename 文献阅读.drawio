        </UserObject><UserObject id="paper_39_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-38" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_39_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-40" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_39_1_field_1" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / arXiv 预印本；正式会议未核验&lt;br&gt;引用量：9（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_1_branch_1" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_1_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：复杂操作会跨越多个子任务；单帧 VLA 难辨任务进度，长程执行中的小偏差又可能逐渐累积。（论文第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：让策略同时利用多视角历史画面和机器人本体状态，在较长任务中输出物理尺度一致的连续动作。（第 1、3 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_1_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_1_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;纯视觉语言表征与末端动作缺少物理对齐，简单拼接关节状态并不能充分过滤背景干扰；全量视频处理成本过高。（第 2–3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_1_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1440.0" as="sourcePoint"/><mxPoint x="562" y="1440.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_1_field_4" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：长任务的历史视觉与动作学习。Latent（潜在表示）是模型压缩后的内部特征；Proprioception（本体感知）是机器人自己的关节等内部状态&lt;br&gt;核心研究问题：做多分钟任务时，当前画面可能相似，但前面已完成的步骤不同。怎样保留长历史，并让这些视觉信息真正指导当前机器人动作？&lt;br&gt;之前方法的问题：把所有历史图像直接塞入模型代价高；视觉语言特征偏语义，与具体机器人关节和运动状态之间有差距，简单拼接状态未必够" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1658" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_1_branch_4" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1925.0" as="sourcePoint"/><mxPoint x="562" y="1925.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_2_field_1" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：相比只在末端拼接状态的 VLA，SALR 在逐层特征空间做状态锚定；相比 ContextVLA 的视觉上下文压缩，它更强调视觉与物理动作空间对齐。（第 2–3 节）" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_2_branch_1" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_2_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_2_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="986.5" as="sourcePoint"/><mxPoint x="1252" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_2_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：#01 MemoryVLA、#14 HAMLET 等利用历史帮助动作。记住过去只是第一步，还要让历史与当前身体状态对应，避免看到正确目标却生成不合适的运动&lt;br&gt;相关方向 2：Flow Matching（流匹配）学习把随机噪声连续变成动作，用于输出平滑动作段。Action Chunk（动作段）是一次预测未来一小段连续动作&lt;br&gt;代表工作：#20 π0.5 及 π0 类模型使用语言视觉与动作模块；LoLA 着重历史采样和状态感知表示，使视觉编码与动作生成之间有更明确的接口&lt;br&gt;与已有方法的区别：加入选择性的时空压缩与状态感知潜在重表示。它侧重端到端控制，不是保存所有事件的外部文字日志，也不是显式失败恢复器" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_2_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1583.5" as="sourcePoint"/><mxPoint x="1252" y="1583.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_1" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前帧保持高保真，历史帧降采样提取运动；State-Aware Latent Re-representation（SALR）使机器人状态在 VLM 各层调制视觉语言特征，再由动作专家生成动作块。（第 3 节，图 2）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_1" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qwen2.5-VL-7B 编码多视角视觉和语言；并行的 State Transformer 用关节角、末端位姿等形成 Query，在逐层与 VLM Key/Value 做乘性融合，再经可学习掩码抑制动作无关特征，送入 Conditional Flow Matching Action Expert。默认取 25 个历史帧。（第 3、6.3 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="745.0" as="sourcePoint"/><mxPoint x="1942" y="745.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：多视角 RGB、当前与降采样历史画面、语言指令，以及关节角、末端位置、夹爪宽度等 Proprioception；真机使用四个摄像头。（第 3、6.2 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：动作专家用 Conditional Flow Matching 生成多步连续机器人动作；不同机器人动作维度按各自具身映射，不能简化为纯文本动作。（第 3、6.3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：当前图像 224×224、历史图像 112×112；历史序列下采样并经可学习掩码过滤。其他统一的数据增强方案：论文未报告。（第 3、6.2 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1272.0" as="sourcePoint"/><mxPoint x="1942" y="1272.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_4" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;跨具身数据端到端预训练并在下游场景微调；论文报告用 32 张 A100、batch 1280 训练约 14 天。不是接到任意 VLA 就能免训练生效的插件。（第 4、6.1–6.4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_4" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1792.0" as="sourcePoint"/><mxPoint x="1942" y="1792.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_3_field_5" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：对长历史做选择性时空采样：当前关键画面保留更多细节，较旧画面压缩。输入多视角和历史，减轻长上下文的计算与重复信息&lt;br&gt;贡献 2：用机器人状态与视觉语言特征构建状态感知重表示。不是仅把两个向量并排放，而是建立交互，让动作模块知道视觉目标对应当前身体哪种动作&lt;br&gt;贡献 3：动作专家用流匹配生成未来动作段；视觉语义与动作相关特征分开处理再连接，让通用视觉理解能服务具体机器人的连续控制&lt;br&gt;方法流程：语言+多视角历史 → 选择性压缩 → 视觉语言编码 → 与本体状态交互重表示 → 动作专家生成动作段 → 执行 → 重新观察与更新历史" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="2010" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_3_branch_5" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2329.5" as="sourcePoint"/><mxPoint x="1942" y="2329.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_1" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：预训练混合 OXE 与 AgiBot，约 100 万条轨迹／6200 万时间点；Franka 用 Xbox 控制器遥操作采集 28 项任务，另有双臂 Aloha BusyBox。（第 4、6.1–6.2 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：SIMPLER、LIBERO、Franka 长程／短程任务以及双臂 Aloha BusyBox；对比 Diffusion Policy、π0 等；Franka 设置有 7 组顺序长程任务和 6 项不重置连续任务。（第 4、6.2 节）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_1" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机实验：Franka Research 3 与双臂 Aloha 均有评测；BusyBox 六类任务平均成功率 LoLA 46.7%、π0 30.0%、Diffusion Policy 8.3%（附录表 9）。（第 4.4、7 节）&lt;br&gt;&lt;br&gt;主要实验结果：LIBERO 加入机器人状态对齐，平均成功率从 84.7% 到 91.2%（表 7）。Franka 多步任务三个分组至少完成两子任务的比例分别为 5.9%、33.1%、28.9%，其中首组低于 π0 的 17.8%，不可声称所有设置均领先（表 6）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="986.5" as="sourcePoint"/><mxPoint x="2632" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融实验：移除历史帧、SALR、冻结 VLM 等组件分别比较；状态对齐消融显示 84.7%→91.2%（第 4.5 节，表 5、7）&lt;br&gt;&lt;br&gt;Failure Case：作者指出长程任务中早期轻微扰动可积累成偏离训练分布；Franka 首组多步结果偏弱。没有证明重大失败后自动重新规划或恢复。（第 1、4.4、5 节）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_4_field_4" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：在 LIBERO、SIMPLER 仿真及 Franka、双臂 Aloha 真机上测试；数据含22项原子子任务组成7个顺序长任务，另6个连续长任务平均2.3分钟。完整成功与步骤进度分开报告&lt;br&gt;对照：比较 π0 等策略，消融历史与状态感知模块。消融是去掉某个组件重测，检查效果是否确由该设计带来&lt;br&gt;结果：LIBERO 平均成功率91.2%；移除状态感知组件为84.7%。这一对照支持状态与视觉交互有效，不能证明所有差异都来自历史长度&lt;br&gt;真机 / 关键补充：真机单步骤平均46.1%，π0 为36.8%。论文的长任务倍数有“至少完成2步”等口径，不能把它改写成完整长任务成功率的倍数" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_4_branch_4" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2110.5" as="sourcePoint"/><mxPoint x="2632" y="2110.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_field_1" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者明确指出复杂、新颖或强扰动的长程执行仍不够稳健，动态闭环恢复重大失败是未来工作；训练资源开销也高。（第 5、6.4 节）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：给“历史视觉＋Proprioception”提供参考，但尤其值得研究的是作者留下的强扰动下动态失败恢复缺口。（第 5 节）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_5_branch_1" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：本地 PDF 未单列完整局限章节；结论强调长任务历史建模与效率。不能把“未写不足”理解为没有不足，下面两项是阅读后的判断&lt;br&gt;我的理解 / 不足：我的判断：历史压缩会遗漏短暂而重要的事件；视觉与关节交互再强，也未直接判断接触是否成功、是否应停止或重新抓握&lt;br&gt;未来展望：让失败、遮挡和步骤转换保留更高优先级；联合进度与触觉状态评估，检查长任务中漏事件和动作误差累积的来源&lt;br&gt;对我们项目的启发：适合 DH116 的“相似画面、不同手部状态”问题。可先加入指关节与抓握阶段状态，再测试视觉—状态交互是否优于直接拼接" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_5_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
