        <mxCell id="paper_71_1_branch_1" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_1_field_2" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_1_branch_2" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_1_field_3" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Robot Manipulation; Generalization 方向，主要讨论真机示范采集成本高，但只靠仿真训练又难泛化到现实。&lt;br&gt;核心思路是联合训练仿真和少量真实机器人数据，并做域适配，学习更可迁移的操作策略。&lt;br&gt;与当前项目的联系：项目联系：项目需要以有限真机数据训练双臂策略" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_1_branch_3" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_1_field_4" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：真机示范采集成本高，但只靠仿真训练又难泛化到现实&lt;br&gt;&lt;br&gt;为什么重要：帮助设计合成数据与真实示范的使用比例" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_1_branch_4" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_1_field_5" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：Sim2Real 域适应与行为克隆&lt;br&gt;域适应是让仿真和真机观察在策略内部尽量有相近含义；本文同时考虑视觉和动作对应关系，而非只把两组图像调成相似&lt;br&gt;核心研究问题：仿真可批量生成示范，真机示范只有少量；图像、物体位置和手臂状态一变，直接混合训练的策略会失效&lt;br&gt;作者问如何利用大量仿真轨迹，又不让它盖过目标域的真实动作规律&lt;br&gt;之前方法的问题：只对齐图像特征可能让外观相似但动作相反的状态被错误配对；普通联合训练会受仿真样本数量主导&lt;br&gt;完整时间序列还有快慢差异，若逐帧机械配对会把不同操作阶段错认成同一步" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_1_branch_5" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2210.5" as="sourcePoint"/><mxPoint x="562" y="2210.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_2_field_1" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化&lt;br&gt;&lt;br&gt;之前方法的问题：仿真与真实数据分布不同，简单混合训练可能利用不好少量真机样本" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_2_branch_1" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_2_field_2" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_2_branch_2" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="881.5" as="sourcePoint"/><mxPoint x="1252" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_2_field_3" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：MimicGen 可从少量种子示范扩充仿真轨迹；行为克隆再学习图像到动作映射&lt;br&gt;仿真轨迹提供覆盖度，但相机、背景和物体几何与真机仍不同，本文在训练时处理这些差异&lt;br&gt;相关方向 2：MMD 等域适应方法匹配两域特征的整体分布，能减轻视觉差异，却未必保证特定观察对应相同动作&lt;br&gt;最优传输寻找跨域样本匹配；本文把动作与视觉放进同一匹配空间，使配对更贴近控制任务&lt;br&gt;代表工作：论文比较只用仿真、只用真机、朴素混训和 MMD 对齐等基线，并在 RGB 与点云两种策略表示上测试&lt;br&gt;这些对照的训练数据预算与输入形式须分开看，不能把点云成绩直接与 RGB 成绩排名&lt;br&gt;与已有方法的区别：联合对齐观察特征和相应动作，并用非平衡最优传输允许仿真/真机样本数不等、状态只部分重叠&lt;br&gt;动态时间规整按轨迹进展抽取相近阶段，减少因操作速度不同造成的错误对齐" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_2_branch_3" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1531.0" as="sourcePoint"/><mxPoint x="1252" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_3_field_1" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;联合训练仿真和少量真实机器人数据，并做域适配，学习更可迁移的操作策略" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_3_branch_1" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_3_field_2" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：外观对齐不保证动作可迁移，作者把编码后的视觉观察与动作、机器人状态拼成联合表示&lt;br&gt;传输损失惩罚跨域状态—动作关系不一致，让特征保留与抓取、放置有关的控制信息&lt;br&gt;贡献 2：仿真示范约千条，真机每任务仅 10–25 条，平衡配对会强迫不相同的状态相互对应&lt;br&gt;非平衡最优传输允许部分质量不匹配，再与行为克隆损失共同训练，减少虚假配对&lt;br&gt;贡献 3：真实和仿真示范的执行速度不同；作者用动态时间规整寻找轨迹内相近进度的时间点再采样&lt;br&gt;这样比较的是相似操作阶段，降低开抽屉、堆叠等任务中前后步骤错位的影响&lt;br&gt;方法流程：用 MimicGen/Robosuite 准备大量仿真示范，并采少量 Franka 真机示范 → 编码 RGB 或点云及机器人状态&lt;br&gt;在行为克隆训练中加入联合最优传输对齐损失 → 在相同任务的新物体形状、复位位置、纹理条件下执行评测" vertex="1">
          <mxGeometry height="814" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_3_branch_2" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="955.0" as="sourcePoint"/><mxPoint x="1942" y="955.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_3_field_3" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1390" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_3_branch_3" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1604.5" as="sourcePoint"/><mxPoint x="1942" y="1604.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_4_field_1" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：作者报告在挑战性真机任务上成功率最高提升约 30%；具体比较条件见正文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告在挑战性真机任务上成功率最高提升约 30%；具体比较条件见正文" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_4_branch_1" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_4_field_2" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：六项 Franka Panda 操作，包括 Lift、BoxInBin、Stack、Square、MugHang 和 Drawer&lt;br&gt;仿真约每任务 1000 条，真机每任务 10–25 条；真实机器人用 RealSense D435 与 20 Hz 关节阻抗控制，分别测试常规及分布外视觉变化&lt;br&gt;对照：Source-only、Target-only、直接混训、MMD 等方法共享任务与数据预算&lt;br&gt;RGB 图像用 ResNet18 加 Diffusion Policy，点云用 PointNet 加 3D Diffusion Policy，检查收益是否依赖单一观察表示&lt;br&gt;结果：真实 RGB 分布外六任务平均成功率约 0.40，朴素混训约 0.10，提升 30 个百分点&lt;br&gt;点云分布外平均约 0.67 对 0.50，提升 17 个百分点；这不是对所有机器人或所有视觉变化的保证&lt;br&gt;关键补充：真实常规条件下文中报告 RGB 平均约 0.73、点云约 0.77；新纹理 BoxInBin 为 0.70 对朴素混训 0.30&lt;br&gt;论文针对新形状、纹理和复位位置分列结果，阅读时应看哪种变化导致收益，而不只看总平均" vertex="1">
          <mxGeometry height="849" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_4_branch_2" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="986.5" as="sourcePoint"/><mxPoint x="2632" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_5_field_1" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：项目需要以有限真机数据训练双臂策略&lt;br&gt;&lt;br&gt;主要局限：不同机器人与任务的 Sim2Real 差异需独立测量&lt;br&gt;&lt;br&gt;局限与启发：主要局限：不同机器人与任务的 Sim2Real 差异需独立测量" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_5_branch_1" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_71_5_field_2" parent="paper_71" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：主要处理观察域差异，仿真和真实接触动力学不同时，联合特征对齐不能直接修好动作执行&lt;br&gt;实验集中在单臂、较准静态的抓取操作，未验证快速移动目标或高自由度手指接触&lt;br&gt;我的理解 / 不足：方法仍需每项真实任务 10–25 条示范及任务内时序对齐，不能称无真机数据 Sim2Real&lt;br&gt;最优传输依赖跨域状态存在可比部分；若相机、夹具、动作语义同时变化，错误匹配风险可能更大，这是从机制推断&lt;br&gt;未来展望：可分别制造外观、几何、接触摩擦和动作控制差异，定位联合对齐能解决哪一类域差&lt;br&gt;再研究少量真机失败轨迹能否用来拒绝错误配对或在线修正策略&lt;br&gt;对我们项目的启发：若有机械臂仿真和少量真机示范，可先比较朴素混训、只对齐视觉、联合视觉—动作对齐三组&lt;br&gt;迁到 DH116 要重新定义手指动作与接触状态，并单独验证动力学差异；论文没有证明双臂灵巧手直接适用" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_71_5_branch_2" edge="1" parent="paper_71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1074.0" as="sourcePoint"/><mxPoint x="3322" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
