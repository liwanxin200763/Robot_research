kground="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="category_04_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="80" y="42" width="290" height="60" as="geometry"/></mxCell></UserObject><mxCell id="category_04_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="04 执行误差与失败恢复"><mxGeometry x="80" y="125" width="1440" height="88" as="geometry"/></mxCell><mxCell id="category_04_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="这个方向在研究什么：研究怎样发现执行偏差，选择纠正、回退或恢复后继续任务&lt;br&gt;共 11 篇 · 建议先看 #5 Taming VLAs under Robot Execution Errors，再按本页顺序浏览"><mxGeometry x="80" y="232" width="1440" height="105" as="geometry"/></mxCell><UserObject id="category_04_paper_05" label="#5 Taming VLAs under Robot Execution Errors&lt;br&gt;要解决：手臂实际走的距离与命令不同，又没有任务奖励时，能否用这个差别改进后续动作？&lt;br&gt;年份 / Venue：2026；arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_07" label="#7 RoboMonkey&lt;br&gt;要解决：抓之前若有几种抓法，能否先评估它们，再让机器人执行最有希望的一种？&lt;br&gt;年份 / Venue：2025，CoRL 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-07" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_08" label="#8 Self-Correcting Robot Manipulation&lt;br&gt;要解决：机器人做完抓取后，物体若没有到预定位置，它怎样及时发现而不继续错误步骤？&lt;br&gt;年份 / Venue：2025，AAAI 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_09" label="#9 Recova&lt;br&gt;要解决：原任务做到一半失败后，怎样先把现场恢复到可继续操作的状态，再完成任务？&lt;br&gt;年份 / Venue：2026，arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-09" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_10" label="#10 FailBank&lt;br&gt;要解决：安全系统一直替策略纠正动作，策略自己却没学会；怎样让它下次少犯同类错？&lt;br&gt;年份 / Venue：2026，arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-10" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_23" label="#23 LIBERO-RECOVER&lt;br&gt;要解决：模型从正常开局能做对，但抓错或碰乱现场后，能否从这个中间状态继续完成目标？&lt;br&gt;年份 / Venue：2026，arXiv:2609.05178&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-23" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_30" label="#30 SafeLoop&lt;br&gt;要解决：机器人快撞到物体/人时， 应继续、等待还是退回安全点？&lt;br&gt;年份 / Venue：2026，IROS 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-30" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_31" label="#31 FLARE&lt;br&gt;要解决：一次抓取或放置失败后， 机器人怎样继续原任务而非整次重来？&lt;br&gt;年份 / Venue：2026，CVPR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-31" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_44" label="#44 RESETTLE&lt;br&gt;要解决：策略跑偏后，高层语言诊断可能慢。能否利用模型自身动作的不一致触发干预，找一个成功参考状态，用短动作纠正后立即回到原策略？&lt;br&gt;年份 / Venue：2026 / arXiv 预印本，正式 Venue 待核验&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-44" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1220" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_45" label="#45 UAOR&lt;br&gt;要解决：视觉已经输入模型，却可能在深层计算中被语言先验冲淡。能否在动作不确定的层重新强调当前观察，减少看错对象或位置导致的错误？&lt;br&gt;年份 / Venue：2026 / arXiv 预印本，正式 Venue 待核验&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-45" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="1220" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_04_paper_46" label="#46 Policy Decorator&lt;br&gt;要解决：大策略从示范学会大部分动作，但某些位置偏一点就失败。怎样保留已有能力，用环境反馈只学习额外小修正，而不是重训整个大模型？&lt;br&gt;年份 / Venue：2025 / ICLR 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-46" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1430" width="700" height="180" as="geometry"/></mxCell></UserObject><mxCell id="category_04_foot" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="选择上方论文卡片进入详情 · 详情页可按上一篇 / 下一篇顺序浏览"><mxGeometry x="80" y="1695" width="1440" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="lit