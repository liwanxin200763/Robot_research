        </mxCell>
        <mxCell id="paper_51_1_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="核心研究问题：训练示范只开门到90度，测试要开30度并停住。能否在不重新采所有目标数据的情况下修改目标，同时保证手真的推动物体而非物体凭空动？" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_4" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="940" as="sourcePoint"/>
            <mxPoint x="367" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_1_field_4" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：只生成动作不易直接指定新物体目标；只生成物体状态却可能出现“幽灵状态”：笔自己转了、门自己开了，手并没有产生相应接触" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_drop" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="956" y="14" as="sourcePoint"/>
            <mxPoint x="956" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_header" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="B. 相关工作" vertex="1">
          <mxGeometry height="58" width="390" x="761" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_field_rail" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="88" as="sourcePoint"/>
            <mxPoint x="771" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_branch_1" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="220" as="sourcePoint"/>
            <mxPoint x="783" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 1：Diffusion Policy（扩散策略）直接生成动作，通常受训练目标范围限制；状态扩散便于改目标，但会忽视物体必须通过接触才改变" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="460" as="sourcePoint"/>
            <mxPoint x="783" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 2：引导式生成用可微目标函数推动采样满足要求；目标函数需同时考虑物体、手和动力学，否则可能只优化物体终点而忽略动作可执行性" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="700" as="sourcePoint"/>
            <mxPoint x="783" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="代表工作：Diffuser 与条件扩散基线分别体现状态/动作规划取舍。#48 ManipTrans 用残差修正接触；DexHandDiff 在规划生成阶段约束接触与动作一致" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_branch_4" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="940" as="sourcePoint"/>
            <mxPoint x="783" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_4" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="与已有方法的区别：联合预测状态和动作，再用交互引导连接二者。Zero-shot（零样本）在此主要指未训练过的目标设定，不代表任意新物体、新手型都无需数据" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_3_drop" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1372" y="14" as="sourcePoint"/>
            <mxPoint x="1372" y="30" as="targetPoint"/>
          </mxGeometry>
