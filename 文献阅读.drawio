          </mxCell>
        </UserObject><UserObject id="paper_87_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-88" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_87_1_field_1" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待 Google Scholar 人工核验（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_1_branch_1" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_1_field_2" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;项目主页：待核验&lt;br&gt;GitHub：待核验&lt;br&gt;代码状态：未确认官方代码或数据入口&lt;br&gt;查询与核验日期：2026-10-15&lt;br&gt;关联：机器人数据采集与数据质量 · 机器人遥操作与动作重定向" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_1_branch_2" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_1_field_3" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本信息与研究问题：研究方向：仿真示范筛选、数据组合、Sim2Real 联合训练。Sim2Real（仿真到真实）研究怎样让在模拟环境中获得的经验帮助现实机器人；仿真里成功的动作，可能利用了错误摩擦、特殊视角或过度重复的摆放，加入越多不一定越好&lt;br&gt;&lt;br&gt;基本信息与研究问题：TUCO 关注的不只是混多少仿真数据，而是“具体混哪几条”。作者用少量真实成功执行作为参照，选择既有帮助、又互相补充的仿真轨迹，再与真实数据一起训练策略（§1、图 1）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_1_branch_3" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1534.5" as="sourcePoint"/><mxPoint x="562" y="1534.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_1_field_4" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;快速摘要：仿真候选＋目标执行记录 → 冻结基础策略计算影响 → 分解单条效用与集合覆盖 → 逐条组合 → 固定混合比例训练 → 独立真机评估。它是数据筛选方法，不是自动生成所有示范或替代机器人模型的算法" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1847" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_1_branch_4" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2037.0" as="sourcePoint"/><mxPoint x="562" y="2037.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_1_field_5" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：按真实任务价值筛选仿真示范以做 Sim2Real&lt;br&gt;TUCO 不只看仿真轨迹是否成功，还估计它们对目标真实执行的帮助及彼此互补性&lt;br&gt;研究问题：仿真能廉价生成很多轨迹，其中一些虽然在模拟里成功，却未必有助于真实机器人。TUCO 询问应该挑哪几条仿真示范与少量真机示范共同训练，而不是只决定混入多少条&lt;br&gt;为什么重要 / 旧方法的不足：作者用少量真实成功执行作为参照，选择既有帮助、又互相补充的仿真轨迹，再与真实数据一起训练策略" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="2255" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_1_branch_5" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2539.5" as="sourcePoint"/><mxPoint x="562" y="2539.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_2_field_1" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：MimicGen 根据已有示范与物体位姿生成新轨迹，解决数据从哪里来；TUCO 在源数据池形成之后判断保留什么。DemInf 根据状态—动作统计关系估计质量，但仿真中的统计规律不一定对现实有价值" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_2_branch_1" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_2_field_2" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_2_branch_2" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="934.0" as="sourcePoint"/><mxPoint x="1252" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_2_field_3" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：CUPID 把训练数据对目标闭环执行的影响合成一个分数，按分数排序；不同轨迹可能得分相近，却都只支持同一种抓法。DataMIL、QoQ 等联系目标验证行为与学习贡献，主要解决单条效用。TUCO 额外研究组合里的冗余与互补，并要求多样性朝目标成功方向展开（§2）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：Sim2Real：把仿真中获得的动作经验迁移到真实机器人&lt;br&gt;MimicGen 根据已有示范与物体位姿生成新轨迹，解决数据从哪里来" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_2_branch_3" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1443.5" as="sourcePoint"/><mxPoint x="1252" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_3_field_1" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 先得到统一参照&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 先得到统一参照：输入固定目标数据、仿真候选池和选择预算 K。源与目标必须具有兼容的观察和动作接口；不能把另一种灵巧手的关节命令未经映射直接混进训练集&lt;br&gt;&lt;br&gt;1. 先得到统一参照：在模拟实验中，目标数据训练的基础策略提供 100 次目标 rollout，即策略闭环运行记录。真机实验则冻结仿真预训练策略，复用每任务 10 次已有成功执行；这些记录既作训练所用真实数据，也作筛选参照。最终测试另采，不能把这十次当最终成功率（§4.1–4.2）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_3_branch_1" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_3_field_2" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 用影响矩阵描述一条数据帮助谁&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 用影响矩阵描述一条数据帮助谁：对每条源轨迹和每次目标执行，利用损失梯度及曲率近似，估计提高这条源轨迹训练权重后，该目标执行变得更可能还是更不可能。全部结果组成“目标执行次数 × 候选轨迹数”的影响矩阵，每列是一条候选的影响模式&lt;br&gt;&lt;br&gt;2. 用影响矩阵描述一条数据帮助谁：一般模拟实验把成功／失败回报分别设为 +1／−1。真实参照只有成功，标签均为 +1，此时效用表示对已观测成功行为的支持，不能声称完整估计了真实失败分布上的收益。投影梯度与源梯度 Gram 矩阵是实际近似，不是直接求完整神经网络 Hessian 逆矩阵（附录 B.2）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_3_branch_2" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1056.5" as="sourcePoint"/><mxPoint x="1942" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_3_field_3" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 分解效用与互补性&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 分解效用与互补性：把影响向量沿目标回报方向的投影作为效用，把剩余正交分量作为“帮助哪些执行有差别”的表示。两个总体同样有用的样本可能支持不同场景，后者让这种差异在选择时可见&lt;br&gt;&lt;br&gt;3. 分解效用与互补性：先保留效用为正、与回报方向足够对齐的候选，再用 log-det（对数行列式）度量所选影响方向覆盖的体积。已有方向重复加入，新增覆盖小；新方向可增加覆盖。但新奇不等于有用，因此还需效用项和方向约束（§4.3–4.4）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_3_branch_3" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1688.5" as="sourcePoint"/><mxPoint x="1942" y="1688.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_3_field_4" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 贪心组合与训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;4. 贪心组合与训练：每轮选择“标准化效用＋加权新增覆盖”最大的轨迹，更新集合，直到达到预算。若合格池不足，就按剩余效用补足；因此不能说最终所有轨迹都满足最初方向门槛（算法 1）&lt;br&gt;&lt;br&gt;4. 贪心组合与训练：最终子集＋全部固定真实数据 → 从头训练新策略。真实／仿真采样比例固定为 20%／80%，保持各方法同等训练设置。真实样本把实际用于决策的观察与真正发出的命令配对；短序列补齐时，填充位置不参与损失（附录 C.1）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="2001" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_3_branch_4" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2285.5" as="sourcePoint"/><mxPoint x="1942" y="2285.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_4_field_1" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果：三种设置分别是同一 RoboSuite 中的 Robomimic 筛选、IsaacSim→MuJoCo 的跨模拟器联合训练，以及现实机器人。前两类的成功率来自多随机种子、不同检查点；不能与最后一次真机模型的单一评估设置混为一谈（图 2–3）&lt;br&gt;&lt;br&gt;实验与结果：真机使用 Franka Research 3＋Franka Gripper，腕部 D405、侧面 D435、头部 L515 三路 RGB，加七关节位置和夹爪宽度。物体通过 3D 打印与仿真对应，匹配相机和初始放置区域。不是任意未知场景下仅用一个深度相机直接迁移（附录 C.3）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_4_branch_1" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_4_field_2" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;每任务从相同 1200 条仿真候选中选 600 条，配每任务 10 条真实成功记录。策略为图像条件 Diffusion Policy：三路独立 ResNet-18、两步观察、16 步动作预测，七臂关节＋夹爪共八维动作；训练 150 epoch。具体采集／控制 Hz、端到端延迟与 GPU 型号未报告" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_4_branch_2" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_4_field_3" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机结果的分母&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 1 每方法每任务 40 次，三个任务合计 120 次。TUCO 的 Peg／StackCube／CupCake 成功率为 82.5%／75.0%／100.0%，即 33/40、30/40、40/40；宏平均 85.8%。全部仿真数据联合训练分别为 17.5%／40.0%／20.0%，仅真实数据为 15.0%／35.0%／0%" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_4_branch_3" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_4_field_4" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机结果的分母&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机结果的分母：相同 600 条预算随机选择的平均为 25.8%，说明在本文控制条件下，数据组成与增益有关，不只是数据减半。CUPID 平均 73.3%，TUCO 高 12.5 个百分点。100% 是四十次观察，不保证以后绝不失败，也不能外推到 DH116&lt;br&gt;&lt;br&gt;真机结果的分母：仿真消融把效用、覆盖与方向限制分别移除，完整方法在 18 个任务—预算组合中的 15 个最好；高预算时合格池耗尽，若干方法会选到同一子集，因此不能把每个预算都写成严格优势（表 2）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_4_branch_4" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1900.5" as="sourcePoint"/><mxPoint x="2632" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_4_field_5" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机结果的分母&lt;/b&gt;&lt;br&gt;&lt;br&gt;光照改变后 Peg 从标准条件 82.5% 降至 25.0%，后者只有 20 次测试，与标准条件 40 次不同。它仍比列出的对照高，却清楚表明数据筛选没有消除视觉分布变化（附录 D.2、表 7）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_4_branch_5" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2403.0" as="sourcePoint"/><mxPoint x="2632" y="2403.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_5_field_1" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确指出：子集大小和源／目标混合比例预先指定；不能自动判断数据是否已足够；跨任务、跨本体、大型 VLA 的观察动作对齐与影响几何还需研究（附录 E.3）&lt;br&gt;&lt;br&gt;不足与未来：本库分析：真实参照仅十次成功，未覆盖从未成功过的接触状态。相机、模型和打印对象匹配降低了复现难度，但也限制开放场景结论。作者“首次系统研究”的优先权表述作为作者主张保留，不当成本库穷尽检索后的证明&lt;br&gt;&lt;br&gt;不足与未来：对 D435i＋DH116，先在统一动作接口的仿真任务比较随机子集、单条效用和覆盖选择，按相同训练步数／样本预算测闭环结果。多指动作必须先用可控主动轴映射与限制建模，不照搬七关节＋二指夹爪接口；当前真机多轴未验收，先离线进行" vertex="1">
          <mxGeometry height="779" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_5_branch_1" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="529.5" as="sourcePoint"/><mxPoint x="3322" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_87_5_field_2" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;可研究“接触阶段的目标覆盖”及少量失败反馈是否改善选样，但属于本库设想。完整实验需要可复现模拟场景、策略梯度计算和后续真机测试；本轮未确认官方代码／数据下载入口，不将 arXiv 可读等同于全栈开源" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_5_branch_2" edge="1" parent="paper_87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1137.0" as="sourcePoint"/><mxPoint x="3322" y="1137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-88" name="08-14 DemInf">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
