        </mxCell>
        <mxCell id="paper_22_title" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=16;editable=1;movable=1;resizable=1;shadow=0;" value="#22 Mem-World" vertex="1">
          <mxGeometry height="140" width="480" y="30" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_22_title_branch" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="100" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_rise" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_header_rail" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="3625" y="14" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_1_drop" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="865" y="14" as="sourcePoint"/><mxPoint x="865" y="30" as="targetPoint"/></mxGeometry>
        </mxCell>
