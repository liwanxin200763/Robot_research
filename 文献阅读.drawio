            <mxPoint x="2019" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_branch_2" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="220" as="sourcePoint"/>
            <mxPoint x="2031" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_field_2" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：本地 PDF 未单列完整局限章节；结论强调长任务历史建模与效率。不能把“未写不足”理解为没有不足，下面两项是阅读后的判断" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_5_branch_3" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="460" as="sourcePoint"/>
            <mxPoint x="2031" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_field_3" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="我的理解 / 不足：我的判断：历史压缩会遗漏短暂而重要的事件；视觉与关节交互再强，也未直接判断接触是否成功、是否应停止或重新抓握" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_5_branch_4" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="700" as="sourcePoint"/>
            <mxPoint x="2031" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_field_4" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="未来展望：让失败、遮挡和步骤转换保留更高优先级；联合进度与触觉状态评估，检查长任务中漏事件和动作误差累积的来源" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_5_branch_5" edge="1" parent="paper_39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="940" as="sourcePoint"/>
            <mxPoint x="2031" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_39_5_field_5" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对我们项目的启发：适合 DH116 的“相似画面、不同手部状态”问题。可先加入指关节与抓握阶段状态，再测试视觉—状态交互是否优于直接拼接" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_39_fulltitle" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：LoLA: Long Horizon Latent Action Learning for General Robot Manipulation" vertex="1">
