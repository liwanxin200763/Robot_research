        <mxCell id="paper_02_fulltitle" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;LT-Mem: Volatility-Aware Spatio-Temporal Memory for Lifelong Scene Understanding" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_02_authors" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Yumin Lee、Hyoseok Ju、Giseop Kim" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_02_pdf" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;07_泛化与长程任务\&lt;br&gt;LT-Mem.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_02_code" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;07_泛化与长程任务\&lt;br&gt;LT-Mem - Volatility-Aware Spatio-Te&lt;br&gt;mporal Memory for Lifelong Scene U&lt;br&gt;nderstanding.md&lt;br&gt;&lt;br&gt;开源信息：作者项目页标注 Code (TBD)，未给出公开仓库" vertex="1">
          <mxGeometry height="569" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_02_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="4786" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_02_bottomnav_1" label="返回分类" link="data:page/id,literature-page-03" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="4786" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_02_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-131" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="4786" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><UserObject id="paper_02_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-03" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4786" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_02_1_field_1" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / IROS 2026（arXiv 页面注明已接收；当前本地 PDF 为 arXiv 预印本）&lt;br&gt;引用量：1（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_1_branch_1" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_1_field_2" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_1_branch_2" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_1_field_3" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人多次返回同一环境时，物体可能移动、消失或暂时被遮挡。只保留最新地图会覆盖旧位置；把每次观察存成独立快照又不能确定“这次的椅子”是否就是上次那把。论文把由此丢失对象历史的现象称为 temporal amnesia：系统能回答“现在在哪”，却不能可靠回答“以前在哪、何时移动、移动几次”。（论文第 I–II 节、表 I）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_1_branch_3" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1170.5" as="sourcePoint"/><mxPoint x="562" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_1_field_4" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：在长期、多会话场景中维持同一物体的身份和空间状态，同时保留变化事件，使机器人能回答跨会话的位置、出现／消失、频次和时间问题。（第 I、III 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：几何地图可保持全局一致，却常把搬动解释为删旧建新，丢掉对象的状态转移；语义记忆可累积图像或文本，但若没有跨会话身份约束，历史观察无法稳定归到同一个物体。每次查询重读原始视觉记录则会增加 token 成本。（第 II 节）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_1_branch_4" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1697.5" as="sourcePoint"/><mxPoint x="562" y="1697.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_1_field_5" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：多次走进同一地方后，记住物体在哪里、何时移动过；重点是长期场景记忆&lt;br&gt;核心问题：机器人隔天再来，杯子已换位置。它怎样认出还是同一只杯子，并记住变化？&lt;br&gt;之前的问题：固定地图会把旧位置当成现在的位置；只看单次照片又无法回答“之前在哪儿”" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="2010" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_1_branch_5" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2224.5" as="sourcePoint"/><mxPoint x="562" y="2224.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_2_field_1" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_2_branch_1" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_2_field_2" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_2_branch_2" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_2_field_3" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;MemoryVLA 保存 VLA 生成动作所需的感知与认知时间上下文；LT-Mem 则维护长期外部世界状态及物体身份／事件历史，不直接输出动作。MemoryVLA 官方仓库中的 MemoryVLA++ 是扩展版本，不能把其未在本卡核验的实验结果混入本论文。Taming VLAs 研究执行动力学的在线适应，和场景历史是不同层面。（第 II–IV 节；MemoryVLA 与 Taming VLAs 各自主卡）" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_2_branch_3" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1188.0" as="sourcePoint"/><mxPoint x="1252" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_2_field_4" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：多次建图要把不同时候看到的场景对齐，才能判断是不是同一个物体&lt;br&gt;相关方向 2：视频问答可检索过去画面，但还要把同一物体在不同时间的状态连起来&lt;br&gt;代表工作：Khronos、ReMEmbR、STAR；它们提供长期场景记录或跨时间问答的比较对象&lt;br&gt;区别：这篇主要记环境中的物体怎样变化；MemoryVLA 则更关注策略先前做过哪些动作" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_2_branch_4" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1697.5" as="sourcePoint"/><mxPoint x="1252" y="1697.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_1" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;先用多会话 SLAM 把每次巡查对齐到共同三维坐标，再为物体做跨会话身份关联；根据当前证据、物体的变化倾向及对齐质量，决定覆盖现状态、保持旧状态或保留多种假设。由这些决定生成当前状态、事件历史和长期统计三类记忆。（第 III 节、图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_1" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_2" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;空间对齐：基于 MASt3R-SLAM 扩展多会话图，每次巡查有局部 keyframe 位姿和 Sim(3) anchor；跨会话回环约束经联合优化，把不同时间的物体投到同一坐标系。物体提取：SAM3 文本提示分割，结合点图得到每个实例的三维质心、体积和视觉嵌入。身份关联：先按嵌入检索候选，再用空间接近、时间连续、外观相似、符合 volatility 的运动、遮挡处理五项确定性证据评分；简单情况用规则，模糊情况让受约束的 LLM 在 MATCH、NEW-TRACK、HOLD 中选择。结构锚点若偏移过大则整次会话不更新，以免错误配准污染记忆。（第 III-B–C 节、表 II）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_2" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_3" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;Volatility（对象的变化倾向）为 0–1 的动态分数，反映对象跨会话改变状态的证据；一次按语义类别向 LLM 获取初始先验，随后由 MOVE、NONE 等事件按固定概率规则更新，不是把“椅子永远静止、篮子永远移动”写死。频繁移动的对象要结合变化历史判断新位置并记录事件；长期稳定的家具若突然偏移，则需更审慎地检查身份关联或对齐。两类对象不宜共用固定运动阈值。更新动作有三种：OVERWRITE 确认新状态并替换当前值；HOLD 在遮挡或低置信度时保留旧值；MULTI-HYPOTHESIS 暂存几个带置信度的候选位置，待连续证据形成优势再定案。（第 III-C 节、式 2）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_3" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1461.0" as="sourcePoint"/><mxPoint x="1942" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_4" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tri-Memory：Live 保存每个对象当前确认的位置／状态及必要的候选假设，用于“现在在哪”；Delta 按会话记录同一身份的 APPEAR、MOVE、DISAPPEAR、RE-APPEAR、NONE 事件及位移，用于“何时变化、以前在哪”；Meta 汇总对象的 volatility、变化频次等统计，并反过来调节下次更新阈值。它是更新逻辑产生的三类互补记录，而不是三个独立训练的记忆网络。（第 III-D 节、图 1、表 I）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_4" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2040.5" as="sourcePoint"/><mxPoint x="1942" y="2040.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_5" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：跨会话的单目 RGB 录像、SLAM 位姿与全局对齐约束、实例分割所得三维对象观察，以及提问时的对象／事件查询。（第 III–IV 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：输出是带持续身份的物体当前状态、历史事件、变化统计和时序问答；本文不生成机器人末端动作或 VLA Action Chunk。频次与位移类问题可由结构化日志确定性计算。（第 III-D 节）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2318" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_5" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2567.5" as="sourcePoint"/><mxPoint x="1942" y="2567.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_6" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;多会话 SLAM 联合优化位姿，分割掩码投影成三维点簇；同会话碎片观察先合并。跨会话候选由 BGE-small-en-v1.5／ChromaDB 检索，实验取前 5 个候选；身份五项证据权重依次为 0.05／0.20／0.45／0.15／0.15。本文主要是记忆更新与数据关联流水线，不是通过图像增强训练新的 VLA。（第 III、IV-B 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2845" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_6" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3059.5" as="sourcePoint"/><mxPoint x="1942" y="3059.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_7" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心证据评分、事件规则与 volatility 更新是确定性算法，并非用 LT-VQA 端到端训练动作策略；LLM 用于初始先验和少数模糊关联。实验以 Gemini 2.5 Pro 对齐适用基线，另测试 Qwen2.5-3B。（第 III-C、IV-B–E 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="3302" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_7" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3492.0" as="sourcePoint"/><mxPoint x="1942" y="3492.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_3_field_8" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：先对齐不同访问时的场景，再判断两个画面里的物体是否是同一个&lt;br&gt;贡献 2：常变的物体和稳定的物体采用不同更新方式，避免一次看错就把旧记录覆盖&lt;br&gt;贡献 3：分别保存现在是什么样、发生过哪些变化、长期变化有多频繁，供不同问题查询&lt;br&gt;流程：多次观察同一地点→对齐物体→按变化程度更新三类记忆→回答“现在/曾经/常否变化”" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="3710" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_3_branch_8" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3959.5" as="sourcePoint"/><mxPoint x="1942" y="3959.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_1" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者构建 LT-VQA：Lab-S、Lab-L 两处室内空间和 Parking Lot 室外场景，各录 10 次会话。Lab-S／Lab-L 各跟踪 10 个对象；每会话约 115–183 帧、1.6–3.3 分钟，停车场约 124–195 帧、2.2–3.2 分钟。用 iPhone 拍摄单目 RGB，并标注全局对齐、持续对象身份、每次状态转移及按会话索引的问答。（第 IV-A–B 节、表 III）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_1" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_2" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;LT-VQA 的 Instance History Tracking 在两处室内环境测同一对象跨 10 次巡查的事件序列与时序问答；指标为 Event F1、事件问答正确率 QA-Event、变化频次问答正确率 QA-Freq。另在 Parking Lot 做 Spatial Statistics：比较不同时段停车数量等跨会话统计，主要是定性例子。基线为仅几何阈值的 Geometric Only、逐帧描述后汇总的 Text-Batch、一次输入对象全部帧的 VLM-Batch 和检索原始记录的 STAR；前两类无法回答某些问题时标为 N/A，不能算作 0。（第 IV-C–F 节、表 V、图 8）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_2" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_3" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者采集了真实场景的多次移动拍摄，但实验目标是长期场景记忆与问答；论文没有报告机械臂抓取、VLA 动作执行或失败恢复成功率。（第 IV 节）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_3" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1349.0" as="sourcePoint"/><mxPoint x="2632" y="1349.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_4" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 Lab-S／Lab-L 合并评测中，LT-Mem＋Gemini 的 Event F1／QA-Event／QA-Freq 为 0.910／0.820／0.600，累计 438K LLM/VLM API token；VLM-Batch 为 0.790／0.680／0.333、7,114K token，STAR 为 0.420／0.460／N/A、45,859K token。LT-Mem＋Qwen2.5 为 0.885／0.800／0.567、352K token。token 统计是整个评测集的运行调用量，感知提取作为一次性离线成本另计，且两种 LLM tokenizer 不同；不能解释为总计算成本缩小同样倍数。（第 IV-E 节、表 V）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_4" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1834.0" as="sourcePoint"/><mxPoint x="2632" y="1834.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_5" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文没有单列一个可与 Event F1 混同的“对象关联准确率”；身份保持的作用主要由消融支持。（第 IV-G 节）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2129" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_5" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2319.0" as="sourcePoint"/><mxPoint x="2632" y="2319.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_6" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;去掉跨会话 Re-ID 后，Event F1／QA-Event／QA-Freq 从 0.910／0.820／0.600 降至 0.140／0.120／0.070；把 volatility 更新改成固定阈值后降至 0.615／0.640／0.130。这支持持续身份和按对象变化倾向更新都重要；表 VI 没有逐一移除 Live、Delta、Meta 的独立量化结果。（第 IV-G 节、表 VI）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2537" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_6" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2751.5" as="sourcePoint"/><mxPoint x="2632" y="2751.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_4_field_7" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;遮挡与对齐噪声会把“未看见”误判为消失，或把位置偏移误判为 MOVE；论文以 E5 遮挡证据、结构锚点检查和 HOLD／多假设更新来减少这类错误。相似外观且位置接近的多个对象仍会造成跨会话身份歧义。（第 III-C、V 节）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2994" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_4_branch_7" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3191.0" as="sourcePoint"/><mxPoint x="2632" y="3191.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_5_field_1" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;环境动态类型：弱动态；跨会话场景和物体变化，非执行中连续移动目标" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_5_branch_1" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_5_field_2" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：LT-VQA 目前仅两处室内加一处室外场景、每处 10 次巡查；相似外观和空间上下文的对象难以重识别，更长部署及更多环境仍需验证。（第 V 节）本库分析：方法依赖多会话配准和对象分割质量；表 VI 报告实验中锚点位移未超过拒绝阈值，因此尚不能从该表推断严重 SLAM 失准后的表现。token 节省不包含一次性感知成本。（第 III-C、IV-E–G 节）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_5_branch_2" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="780.0" as="sourcePoint"/><mxPoint x="3322" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_5_field_3" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;潜在研究启发：当执行失败后需要判断“物体原来在哪、刚刚变了什么、这是不是同一物体”时，可把对象事件历史作为恢复策略的状态输入，并与策略自身记忆分开评测。LT-Mem 论文只验证场景历史问答，并未证明它能检测或恢复 VLA 执行失败。（第 IV–V 节）" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_02_5_branch_3" edge="1" parent="paper_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1237.0" as="sourcePoint"/><mxPoint x="3322" y="1237.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_02_5_field_4" parent="paper_02" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：仅测试两处室内和一处停车场；相似物体跨访问是否易关联错，原卡标为待核实&lt;br&gt;我的理解 / 不足：若场景没有对齐好，变化记录也会错；尚未证明它能改善机器人动作&lt;br&gt;未来展望：在更多地点和更长时间里检查：同一物体是否还能被认出，旧信息何时该更新&lt;br&gt;对我们项目的启发：分别记“环境自己变了什么”和“机器人刚做了什么”，便于追查异常来源" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1462" as="geometry"/>
        </mxCell>
