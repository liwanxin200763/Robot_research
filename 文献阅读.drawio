kground="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="category_03_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="80" y="42" width="290" height="60" as="geometry"/></mxCell></UserObject><mxCell id="category_03_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="03 动态环境与世界模型"><mxGeometry x="80" y="125" width="1440" height="88" as="geometry"/></mxCell><mxCell id="category_03_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="这个方向在研究什么：研究环境变化时怎样更新状态、预测未来并及时调整动作&lt;br&gt;共 8 篇 · 建议先看 #2 LT-Mem，再按本页顺序浏览"><mxGeometry x="80" y="232" width="1440" height="105" as="geometry"/></mxCell><UserObject id="category_03_paper_02" label="#2 LT-Mem&lt;br&gt;要解决：机器人隔天再来，杯子已换位置。它怎样认出还是同一只杯子，并记住变化？&lt;br&gt;年份 / Venue：2026；IROS 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_03" label="#3 DIAL&lt;br&gt;要解决：高层说“把杯子放好”，低层动作怎样真正朝这个结果移动，而不只照当前画面动作？&lt;br&gt;年份 / Venue：2026；arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-03" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_22" label="#22 Mem-World&lt;br&gt;要解决：手挡住物体、手腕相机换角度时，模型还能否记住物体并预测下一帧？&lt;br&gt;年份 / Venue：2026，CoRL 2026（PDF 为预印本）&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-22" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_28" label="#28 DOMINO / PUMA&lt;br&gt;要解决：物体持续移动时， 机器人能否根据过去运动预测抓取时的位置？&lt;br&gt;年份 / Venue：2026，ECCV 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-28" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_29" label="#29 DexH2R&lt;br&gt;要解决：机器人怎样预测交接位置， 同时避开人手并及时抓稳物体？&lt;br&gt;年份 / Venue：2025，ICCV 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-29" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_41" label="#41 PLaW-VLA&lt;br&gt;要解决：很多方法学会预测未来，却没有让未来信息直接影响动作。怎样把语言语义、历史和未来状态接起来，使策略能依据预测来行动？&lt;br&gt;年份 / Venue：2026 / CoRL 2026（本地 PDF 标注；正式论文集待核验）&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-41" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_42" label="#42 DreamTrue&lt;br&gt;要解决：若世界模型把抓空也画成抓住，机器人会错误评估计划。怎样保证预测中的机械臂和物体运动符合输入动作，连失败也能生成？&lt;br&gt;年份 / Venue：2026 / arXiv 预印本，正式 Venue 待核验&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-42" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_03_paper_43" label="#43 Closed-Loop Visuomotor&lt;br&gt;要解决：模型生成了理想任务视频，现实物体却可能被碰动。怎样比较当前真实画面与期望画面，持续改变动作，避免一直照旧计划走？&lt;br&gt;年份 / Venue：2024 / NeurIPS 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-43" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><mxCell id="category_03_foot" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamil