          </mxCell>
        </UserObject><UserObject id="paper_08_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-09" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_08_1_field_1" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / AAAI 2025&lt;br&gt;引用量：6（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_1_branch_1" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_1_field_2" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：语言条件操作策略通常只见过成功示范；某步未达到预期却继续下一步，会进入训练分布外状态。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：比较动作执行后真实场景与动作前预测的未来场景，发现执行失败并在偏差积累前修正。（第 1、3 节）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_1_branch_2" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_1_field_3" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：仅凭最终目标检查难判断某一步是否成功；没有预测—观测对照的策略无法及时阻止错误延续。（第 2 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：先预测一个动作完成后的三维场景，再看真实场景是否符合预期，发现问题就重试&lt;br&gt;核心问题：机器人做完抓取后，物体若没有到预定位置，它怎样及时发现而不继续错误步骤？&lt;br&gt;之前的问题：只从成功示范学动作的策略，遇到没抓住等意外状态，可能仍按原计划往下做" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_1_branch_3" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1517.0" as="sourcePoint"/><mxPoint x="562" y="1517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_2_field_1" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;与已有工作的关系：与 SafeLoop 的执行前危险预测不同，本文检测执行后的“预测几何—真实几何”偏差" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_2_branch_1" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_2_field_2" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_2_branch_2" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_2_field_3" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：语言和三维画面帮助机器人预测抓取动作；它们未必检查动作完成后的结果&lt;br&gt;相关方向 2：三维场景重建描述物体位置；若能预测下一刻场景，就能与实测结果比较&lt;br&gt;代表工作：PerAct、ACT3D 等做三维动作；GNFactor、ManiGaussian 等增强场景重建&lt;br&gt;区别：三维表示除帮助出动作，还用来预测动作后的场景，并判断实际结果是否偏离" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_2_branch_3" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1324.5" as="sourcePoint"/><mxPoint x="1252" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_3_field_1" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：用 3D Gaussian Splatting 建模当前场景，以计划动作预测 Gaussian 位移，再把预测点云与执行后的真实深度点云作 Chamfer 距离比较；超阈值时回到先前机器人位姿。（第 3 节、图 2）&lt;br&gt;&lt;br&gt;方法与系统结构：感知网络回归高斯原语的位置、协方差、颜色、透明度和语义特征；动作条件预测器估计位置和旋转变化。检测器对预测几何与真实点云比较，阈值 τ=0.40；超过阈值执行前一动作状态加微小扰动，再由 PerAct 式策略重新生成动作。（第 3 节、算法 1）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_3_branch_1" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_3_field_2" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：当前 128×128 RGB-D、语言指令、末端状态、先前动作及执行后 RGB-D；训练时另用 20 个视角监督场景表示。（第 3–4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：PerAct 骨干输出末端位置、角度、夹爪开合及碰撞避免类别；检测器决定是否回滚。回滚机器人状态不能保证物体恢复原位。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：多视角 RGB 与语义特征监督当前高斯重建，未来多视角图像和真实点云监督预测；专家示范采用 SE(3) 增强。（第 3–4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_3_branch_2" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1039.0" as="sourcePoint"/><mxPoint x="1942" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_3_field_3" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;先训练动作预测交叉熵，再联合当前场景重建和未来预测损失。PerAct 数据训练 300,000 步、HiveFormer 数据 100,000 步，batch size 2；前 3,000 步为动作预热。（第 3–4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_3_branch_3" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1559.0" as="sourcePoint"/><mxPoint x="1942" y="1559.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_3_field_4" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把当前场景表示为三维高斯，预测执行计划动作后物体和场景可能怎样变化&lt;br&gt;贡献 2：动作完成后读取新点云，与预测点云比较；差别太大时判作异常结果&lt;br&gt;贡献 3：发现异常后回退上一动作，加一点扰动再尝试，而不是继续执行错误序列&lt;br&gt;流程：看当前三维场景→预测动作后场景→执行→读取真实场景→差别超阈值则回退重试" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_3_branch_4" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2026.5" as="sourcePoint"/><mxPoint x="1942" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_4_field_1" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：PerAct 十项 RLBench 任务、166 种变化，每任务 20 条演示；另用 HiveFormer 六项任务、各 20 条演示。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：CoppeliaSim/Bullet 中比较 PerAct、GNFactor、ManiGaussian、ACT3D；每任务测试 25 个 episode、三个随机种子，并在 Colosseum 检查颜色与纹理扰动。（第 4 节、表 1–4）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_4_branch_1" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_4_field_2" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机实验：论文未报告真机实验；成功率均来自模拟操作。（第 4 节）&lt;br&gt;&lt;br&gt;主要实验结果：RLBench 十任务平均成功率 56.4%，此前最强 ManiGaussian 44.4%，高 12.0 个百分点；HiveFormer 六任务 59.3%，ManiGaussian 46.0%。（表 1–2）&lt;br&gt;&lt;br&gt;消融实验：去掉自纠正后 38.0%，加入后 56.4%；工具类任务 58.7%→70.7%，规划类 32.0%→64.0%。τ=0.40 为所测阈值中最高的 56.4%。（表 3、5）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_4_branch_2" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_4_field_3" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文展示扫地后垃圾仍在原处等“预测已改变、实际未改变”的失败。预测模型错误或场景受外力变化也可能触发错误回滚；后一句是本库对检测规则的分析。（图 1–2、算法 1）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_4_branch_3" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1454.0" as="sourcePoint"/><mxPoint x="2632" y="1454.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_4_field_4" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：在 RLBench 十项任务及 166 种变化上测试，另测六项 HiveFormer 任务&lt;br&gt;对照：与 PerAct、ACT3D 等三维策略和 GNFactor、ManiGaussian 等重建方法比较&lt;br&gt;结果：RLBench 十任务平均成功率为 56．4%；去掉自纠错为 38．0%，同设置 ManiGaussian 为 44．4%&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真机：论文没有报告真实机器人实验；主要结果均来自仿真，不能直接推断真机同样有效" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1672" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_4_branch_4" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1939.0" as="sourcePoint"/><mxPoint x="2632" y="1939.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_5_field_1" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；检测机器人动作后的场景变化，未测试独立持续运动目标&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：以未来预测和执行后点云差异检测失败；只识别几何不一致，未定位根因；固定选择回滚并重试，后续观测可重新核对，原任务继续；没有将失败结果积累为长期可检索记忆或在线学习&lt;br&gt;&lt;br&gt;主要局限：作者提出未来还需覆盖长程规划中的失败检测与纠正。按本库分析，实验没有真机、双臂、灵巧手或持续移动目标；回滚机器人位姿不保证场景复原，也没有显式失败原因分类及长期经验积累" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_5_branch_1" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_5_field_2" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;适合作为双臂 VLA 的执行后 Failure Detection 基线：保存动作前观测、计划动作、预测结果和真实结果。要形成 Failure Memory，还需标注根因、恢复动作与恢复成效；论文未实现可检索的此类记忆" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_5_branch_2" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="997.0" as="sourcePoint"/><mxPoint x="3322" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_08_5_field_3" parent="paper_08" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文未单列完整局限；结论指出长任务中怎样规划和纠错还需研究&lt;br&gt;我的理解 / 不足：异常后主要是回退重试；若抓错目标或场景被人改变，未必知道该如何改计划&lt;br&gt;未来展望：让系统理解失败是什么、该改哪个步骤，而不只是给原动作加扰动&lt;br&gt;对我们项目的启发：除比较命令与实动，也比较任务前后场景，检查“动作执行了但目标没达成”" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_08_5_branch_3" edge="1" parent="paper_08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1464.5" as="sourcePoint"/><mxPoint x="3322" y="1464.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
