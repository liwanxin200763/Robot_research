            <mxPoint x="3625" y="14" as="sourcePoint"/><mxPoint x="3625" y="30" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_5_header" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="E. 不足与未来" vertex="1">
          <mxGeometry height="78" width="650" x="3300" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_5_field_rail" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="108" as="sourcePoint"/><mxPoint x="3310" y="1483" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_fulltitle" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;SPIRE: Synergistic Planning, Imitation, and Reinforcement Learning for Long-Horizon Manipulation" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_125_authors" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Zihan Zhou, Animesh Garg, Dieter Fox, Caelan Garrett, Ajay Mandlekar；NVIDIA、University of Toronto/Vector Institute、Georgia Institute of Technology" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_125_pdf" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;07_泛化与长程任务\&lt;br&gt;SPIRE.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_125_code" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;07_泛化与长程任务\&lt;br&gt;SPIRE - Synergistic Planning, Imitatio&lt;br&gt;n, and Reinforcement Learning for Lo&lt;br&gt;ng-Horizon Manipulation.md&lt;br&gt;&lt;br&gt;开源信息：项目 https://sites.google.com/view/spi&lt;br&gt;re-corl-2024；专属代码发布状态本次未&lt;br&gt;核验" vertex="1">
          <mxGeometry height="639" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_125_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_125_bottomnav_1" label="返回分类" link="data:page/id,literature-page-04" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_125_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-122" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_125_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_125_1_field_1" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与题名核验&lt;/b&gt;&lt;br&gt;&lt;br&gt;本地25页PDF首页题名为 SPIRE: Synergistic Planning, Imitation, and Reinforcement for Long-Horizon Manipulation；canonical卡片和PMLR官方条目在Reinforcement后另有Learning，已确认属于同一作者组、同一SPIRE研究，而非错配论文。PDF注明CoRL 2024，PMLR页面给出2025年论文集，故会议届次和出版年应分开记录。首次arXiv日期、版本更新月份未核验，不能把2025误写成首次提出时间。官方出版页：https://proceedings.mlr.press/v270/zhou25a.html。旧卡引用数17没有检索日期，本次未核验实时引用量。" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_1_branch_1" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="424.5" as="sourcePoint"/><mxPoint x="562" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_1_field_2" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Zihan Zhou, Animesh Garg, Dieter Fox, Caelan Garrett, Ajay Mandlekar；NVIDIA、University of Toronto/Vector Institute、Georgia Institute of Technology。代码/项目核验：项目 https://sites.google.com/view/spire-corl-2024；专属代码发布状态本次未核验。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_1_branch_2" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="951.5" as="sourcePoint"/><mxPoint x="562" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_1_field_3" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;长任务需要搬运、对准、插入、关盖等连续阶段。纯模仿学习会继承示范速度并在误差累积后离开训练分布；从零强化学习又很难碰到最后才出现的成功奖励。传统任务与运动规划能够可靠组织刚体移动，却难准确建模接触丰富的插装。SPIRE研究如何让规划负责能规划的部分，让少量示范先建立局部技能，再用强化学习改善这些局部技能。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_1_branch_3" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1408.5" as="sourcePoint"/><mxPoint x="562" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_2_field_1" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与前人机制的差别&lt;/b&gt;&lt;br&gt;&lt;br&gt;TAMP即任务与运动规划，同时决定“先抓哪个物体”等离散步骤和“手臂如何无碰撞移动”等连续轨迹。HITL-TAMP在规划器认为困难的交接段收集人的遥操作，再以行为克隆训练策略；其输入是局部视觉，输出是末端动作，表现受限于示范覆盖。Plan-Seq-Learn等用规划串起强化学习技能，但从零探索稀疏奖励仍困难。SPIRE保留规划器的任务结构，并把已学会的示范策略同时用作强化学习起点和训练期间的行为参照。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_2_branch_1" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_2_field_2" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;关键术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;交接段不是整项任务的任意视频切片，而是规划前置条件已满足、需要学习技能达到指定后置条件的一段控制。稀疏奖励是在完成该段时给0/1信号，不额外手工设计对齐距离等密集奖励。残差策略是在冻结的示范动作上叠加小修正；KL散度惩罚则限制新策略与示范策略的动作分布差异，防止尚未学好时把原有技能丢掉。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_2_branch_2" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="881.5" as="sourcePoint"/><mxPoint x="1252" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_3_field_1" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;问题形式化与输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;系统把任务拆成共享物理动力学、但初始状态分布与成功条件不同的一系列MDP。规划器决定每段从哪里开始、何时结束，因此局部策略无需自己学完整的搬运和阶段组织。大多数任务只给一幅84×84腕部RGB；Tool Hang因腕视遮挡改用前视；Tool Hang Broad和Coffee Preparation同时用两视图与末端位姿、夹爪宽度。动作是末端六自由度增量和一维夹爪控制，共7维，不能直接理解成多指手的关节控制器。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_3_branch_1" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_3_field_2" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：建立规划与技能接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;用PDDLStream描述经典move、pick以及需要学习的insert、hang等动作。每个动作具有前置条件和执行效果：例如拿着框架、处于可插入区域时，插入策略接管；插入成功后环境状态发生变化。规划器的抓取及无碰撞运动由人工建模，哪些动作交给学习也由研究者根据规划器能力指定，并非系统自动发现全部技能边界。接口把学习范围压缩到接触区域，同时把可判定的后置条件变成奖励。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_3_branch_2" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="899.0" as="sourcePoint"/><mxPoint x="1942" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_3_field_3" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：采集局部示范与行为克隆&lt;/b&gt;&lt;br&gt;&lt;br&gt;规划器先把场景推进到交接位置，再要求操作者完成局部难段，记录状态、动作及所在段标签。队列系统减少操作者等待规划的时间。以示范动作的负对数似然训练BC策略，得到可以偶尔完成接触技能的初始控制器。它不必已很强，后续仍可能改进；但如果从未到达奖励附近，强化学习也没有无条件成功保证。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_3_branch_3" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1373.5" as="sourcePoint"/><mxPoint x="1942" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_3_field_4" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：强化学习改善技能&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者比较两种热启动：复制BC网络参数后微调，以及冻结BC、训练接近零初始化的残差网络。残差方案执行时使用BC动作均值加残差，避免基础策略采样噪声。强化学习最大化局部成功回报，同时扣除相对BC的KL惩罚；这样探索优先发生在已有技能附近。底层算法为DrQ-v2，用视觉增强学习连续动作，奖励仍来自交接段成功条件。KL是统计约束，不是碰撞安全证明。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_3_branch_4" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1848.0" as="sourcePoint"/><mxPoint x="1942" y="1848.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_3_field_5" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：并行规划与课程调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;一次TAMP规划可能花几十秒，若策略每次都等规划就会浪费训练时间。多个worker各自维护环境并并行规划，到达交接段后报告worker编号、段编号，进入等待池。中央调度器选择就绪环境供单线程RL采样。permissive允许所有阶段；sequential只有前面阶段成功率达到阈值才接受后续段，以减小初始状态分布变化。学习动作完成后重新观察与规划，避免把随机落点当成预设状态。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2108" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_3_branch_5" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2340.0" as="sourcePoint"/><mxPoint x="1942" y="2340.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_3_field_6" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;部署闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;推理循环先检查最终目标，未成功则搜索混合计划，执行经典轨迹直到第一项学习动作；学习策略根据新图像持续控制到局部后置条件成立，再重新规划。这既利用局部视觉反馈，也承认接触后状态具有随机性。理论附录的可解性结论依赖规划序列有效、每段可达和终态满足目标等假设，不能据此声称现实感知误差下必成功。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2600" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_3_branch_6" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2814.5" as="sourcePoint"/><mxPoint x="1942" y="2814.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_4_field_1" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务与训练条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验均为仿真桌面刚体操作，包括Square、Coffee、Three Piece、Tool Hang及其Broad初始位置范围扩大版本，再加Coffee Preparation，共9项。正文说Coffee Preparation有四个交接，附录说明相邻段合并后实际三段，应保留该差别。主实验用200条示范；DrQ-v2学习率1e-4、批量256、折扣0.99。论文未报告真机部署成功率、力触觉输入或DH116实验。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_4_branch_1" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_4_field_2" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与统计口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;九任务平均成功率87.8%，对照TAMP-gated BC为52.9%、TAMP-gated RL为37.6%。图3每个数据点取5个随机种子中最佳一次训练，再测50个rollout，不是五种子均值。Tool Hang该口径下BC为10%、SPIRE为94%；八项任务SPIRE达到至少80%。Square、Square Broad、Coffee、Three Piece这些BC本就较强任务，SPIRE平均只需BC的59%完成时长；该59%不能套用全部九任务。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_4_branch_2" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_4_field_3" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据效率与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;七项任务以达到至少80%成功率为门槛，SPIRE合计使用150条示范，BC需要超过870条，因此作者称约5.8倍示范效率；这不等于总交互数减少5.8倍。去掉KL的五种子比较中，Three Piece从84.0±34.7%降至17.6±39.4%，Tool Hang图6从74.4±11.8%降至0；后者与附录另一配置的54.0±46.8%不是同一汇总，不混写。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_4_branch_3" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_4_field_4" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;规划、吞吐与失败证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录Square Broad去掉TAMP后SPIRE为0%，有TAMP为100%，说明范围扩大时全程探索仍会崩溃。Tool Hang首次插入、同样6小时条件下，16个worker达98%成功、55.4 FPS；单worker为42%、7.7 FPS。附录五种子Tool Hang总任务均值54.0±46.8%，其中有0%和6%的失败训练，远低于最佳94%的展示。作者将失败与策略梯度过大、KL无法约束早期偏离联系起来。GPU总时及完整训练费用未统一报告。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_4_branch_4" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1830.5" as="sourcePoint"/><mxPoint x="2632" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_5_field_1" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者限定为桌面刚体或带关节刚体，假定状态可观察并能获得遥操作示范；策略只考虑马尔可夫输入，历史网络可能改善表现；RL微调需要足够快的仿真。附录明确承认五个种子不足以估计训练突然偏离的概率，提出自适应KL权重作为未来方向。其关于更安全关盖的例子是定性比较，不构成真实机器人安全验证。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_5_branch_1" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_5_field_2" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116与视觉的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;可借鉴“规划前置条件—局部接触技能—执行后重新规划”的接口，但DH116需要把末端七维动作改为适合多指关节、接触和握持稳定性的控制接口。建议先选可判定成功的单个插装/放置段，记录视觉遮挡、物体位姿误差和触觉是否改变交接判据，再比较BC与带KL的微调。需同时报告全部种子和真实rollout分母，以免最佳种子掩盖不稳定。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_5_branch_2" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="811.5" as="sourcePoint"/><mxPoint x="3322" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_125_5_field_3" parent="paper_125" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;迁移边界与后续验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文没有解决Sim2Real：规划状态真值、接触摩擦和动力学在真实环境都可能失配。实际迁移应分别验证感知到符号状态的可靠性、经典轨迹可执行性和局部技能接触鲁棒性，再考虑双臂任务中的相互避碰。以上为本笔记提出的实验设计建议，不能写成论文已完成DH116、双臂或真实多模态验证。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_125_5_branch_3" edge="1" parent="paper_125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1268.5" as="sourcePoint"/><mxPoint x="3322" y="1268.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
