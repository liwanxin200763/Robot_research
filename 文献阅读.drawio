        <mxCell id="category_02_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="02 记忆与时间建模">
          <mxGeometry x="100" y="150" width="2000" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="category_02_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#24435A;align=left;verticalAlign=top;spacing=24;" value="这个方向在研究什么：记忆与时间建模&lt;br&gt;当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;知识链条：历史观察 → 选择重要事件 → 压缩与更新 → 检索 → 当前动作&lt;br&gt;共 16 篇 · 点击下方卡片进入独立论文页，再按本类编号顺序浏览">
          <mxGeometry x="100" y="280" width="2000" height="330" as="geometry"/>
        </mxCell>
        <UserObject id="category_02_paper_01" label="#1 MemoryVLA&lt;br&gt;要解决：机器人现在看到的画面相同，先前做过的事却可能不同。它怎样利用历史决定下一步？&lt;br&gt;年份 / Venue：2025 arXiv；ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-01" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_02_paper_11" label="#11 TTF-VLA&lt;br&gt;要解决：现有 VLA 常独立处理当前帧，如何在不重新训练模型的情况下利用历史视觉信息，提高动作预测的稳定性和抗视觉噪声能力，利用历史帧，但又不…&lt;br&gt;年份 / Venue：2026，AAAI 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-11" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_02_paper_12" label="#12 ContextVLA&lt;br&gt;要解决：如何让 VLA 利用多帧历史解决部分可观测任务，同时避免视频输入造成巨大的训练和推理计算开销&lt;br&gt;年份 / Venue：2025，arXiv，ICLR 2026 投稿版本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-12" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="980" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_02_paper_13" label="#13 CronusVLA&lt;br&gt;要解决：先用单帧学习基本能力，再专门做多帧后训练，如何把已有单帧 VLA 高效扩展到多帧模式，使模型利用时间信息，同时避免从头训练多帧基础模型…&lt;br&gt;年份 / Venue：2026，AAAI 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-13" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="980" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_02_paper_14" label="#14 HAMLET&lt;br&gt;要解决：如何给已有 VLA 加入真正可利用的历史记忆，使当前动作预测知道过去发生过什么，同时避免从头重新训练整个 VLA&lt;br&gt;年份 / Venue：2026，ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-14" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
