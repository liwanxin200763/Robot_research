        <mxCell id="paper_52_5_field_2" parent="paper_52" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：作者指出原版仅支持单图，缺少多图和本体状态输入；大模型控制频率低。骨干规模、联合训练和视觉特征等设计仍未充分探索" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_52_5_branch_3" edge="1" parent="paper_52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
