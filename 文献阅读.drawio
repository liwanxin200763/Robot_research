            <mxGeometry x="1140" y="4586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_57_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-40" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="4586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_57_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-58" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_57_1_field_1" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：0（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_1_branch_1" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_1_field_2" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：视频生成模型具有时空先验，但机器人关节动作向量随本体变化，无法直接成为统一的视频输入／输出。只把末端位置画成图像又丢失机械臂整链和夹爪几何。作者希望让不同机器人的动作都以相同形状的视觉序列表达，供同一视频模型学习。（论文第 1–2 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_1_branch_2" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_1_field_3" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：构造能跨本体联合训练的观测—动作模型，在给定当前观测、关节状态、机器人 URDF 与指令时，支持预测未来画面、由目标画面反推动作，或同时生成未来观测与可执行关节动作。（第 3 节，式 1–3）&lt;br&gt;&lt;br&gt;之前方法存在的问题：关节向量维度与物理含义因机器人而异；学出来的潜在动作或单个末端姿态，最终仍需本体特定解码／逆解；把 URDF 渲染画面对齐实体相机，又会引入物理相机外参依赖。作者提出固定虚拟视角下的全身关节配置图，避免以物理相机视角作为动作表征的条件。（第 1–2 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_1_branch_3" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1482.0" as="sourcePoint"/><mxPoint x="562" y="1482.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_1_field_4" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：时间建模、世界模型和跨本体动作表示&lt;br&gt;本体是机器人的关节、夹爪与传感器结构；作者把关节配置渲染为固定形状的视觉序列，使不同机器人共用一个视频生成接口&lt;br&gt;核心研究问题：同一任务可由不同机械臂执行，但关节数和动作向量意义不同，普通视频模型也不会直接输出关节命令&lt;br&gt;作者问能否用统一视觉动作形式联合预测未来观察与动作，再把生成结果还原为每台机器人的可执行关节序列&lt;br&gt;之前方法的问题：只预测末端点会丢失机械臂整条运动链和夹爪几何；为每个硬件训练专属动作头又妨碍混合训练&lt;br&gt;把动作渲染到实体相机视角还依赖外参，换平台后容易失配" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1812" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_1_branch_4" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2149.0" as="sourcePoint"/><mxPoint x="562" y="2149.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_2_field_1" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_2_branch_1" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_2_field_2" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_2_branch_2" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_2_field_3" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;DIAL 用潜在未来表征联系意图与行动；Dream4ACT 把完整关节几何画成可逆的多视角动作视频。与只渲染末端点的视觉动作方法相比，它保留整条机械臂；与为每个本体训练动作头的方法相比，它改用 URDF 约束求解。对比需注意本论文完整 RoboTwin 排名并非最高，且五本体测试使用不同 checkpoint。（第 2–4 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_2_branch_3" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_2_field_4" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：视频世界模型利用连续画面学习物体如何变化，擅长视觉预期，却未必包含可执行的机器人关节动作&lt;br&gt;Dream4ACT 把动作也表示成视频流，使未来画面和未来控制可以在同一个生成器中建模&lt;br&gt;相关方向 2：潜在动作或末端轨迹能跨部分机器人共享，但转换回每台机器人的关节控制仍需额外解释或逆运动学&lt;br&gt;本篇使用 URDF（机器人关节与连杆的结构描述）渲染全身姿态，再用几何约束恢复关节角&lt;br&gt;代表工作：DIAL 通过潜在未来表征连接意图与动作；π0.5、Motus 等在 RoboTwin 表格里是受测对照&lt;br&gt;Dream4ACT 并非继承这些基线的训练权重，比较时还须区分完整 50 任务与五本体 31 任务使用不同 checkpoint&lt;br&gt;与已有方法的区别：动作图来自固定的四个虚拟相机，不需依赖真实相机的视角来编码关节形状&lt;br&gt;统一视频模型可做前向画面预测、由目标画面反推动作和联合生成，最后由通用求解器而非本体专属解码头输出关节" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_2_branch_4" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1820.0" as="sourcePoint"/><mxPoint x="1252" y="1820.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_1" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;用 URDF 正向运动学把每个目标关节配置从上、左、右、前四个规定虚拟相机渲染成 action views；这些图与真实 RGB 观测共同进入共享视频 VAE 和 DiT。根据不同遮挡／加噪方式，共享模型完成前向动力学、逆动力学与联合生成；生成后的 action views 再用 URDF 约束的多视角几何匹配还原关节序列。（第 3.1–3.5 节，图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_1" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_2" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;冻结的 Qwen3.5-VL 9B 读取当前头部画面与指令，训练中的语义 Adapter 从最后四层提取视觉／文字特征、用四个 Query 压缩视觉特征。共享 Wan2.2 VAE 分别编码真实 RGB 与四路 action-view 视频；给各序列加入模态、视角及分区位置编码，DiT 跨序列自注意力并交叉注意语言语义。训练外的动作求解器以当前关节状态热启动，迭代采样候选关节、URDF 渲染、比较四视角轮廓 IoU 与单向 Chamfer 距离，再做 Gauss–Newton 优化。（第 3 节，图 2、表 2；附录 A.3）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_2" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_3" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;条件包括当前头部／腕部 RGB 图像、关节位置与夹爪状态、任务指令，以及当前机器人的 URDF；四个 action views 是由 URDF 和虚拟相机生成的动作图，不是四台实体相机。真机单臂分别用前置＋腕部相机，双臂用头部＋双腕相机。相机视角数可变，但动作渲染及恢复必须按相同虚拟相机约定。（第 3 节；附录 A.2、A.4）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_3" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1373.5" as="sourcePoint"/><mxPoint x="1942" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_4" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;模型输出未来 RGB 与／或固定形状的 action-view 序列；后者经训练外求解器恢复为目标关节位置和夹爪状态，再形成执行动作段。仿真预测 40 步，真机预测 80 步；真实机器人把整段执行完才重新观测和规划。论文未报告通用逐步实时伺服接口，不能把此动作段机制称为每一步闭环。（第 3 节；附录 A.1、A.4、表 8）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_4" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1830.5" as="sourcePoint"/><mxPoint x="1942" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_5" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关节配置通过 URDF 渲染成四路固定虚拟相机视频，与多路 RGB 各自用同一视频 VAE 压缩；模态／视角编码与 RoPE 空间偏移帮助共享 DiT 区分流。训练时三种生成模式抽样概率分别为前向 0.2、逆向 0.2、联合 0.6；单帧前缀 I2V 与较长前缀 V2V 分别为 0.7／0.3，论文报告的推理只用 I2V。RoboTwin 随机化涵盖背景、桌面物与照明；真机训练未加入测试所用背景／干扰物变化。（第 3.3–3.4、4 节；附录 A.1–A.2，表 8）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_5" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2322.5" as="sourcePoint"/><mxPoint x="1942" y="2322.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_6" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;共享 DiT 用 masked flow matching，仅在被加噪的未来序列上计算速度场损失；当前帧始终保持干净，不同模式保留相应的未来 RGB 或 action views 作条件。附录表 8 给出 AdamW、学习率 1×10⁻⁵、batch 16、16 张 B200、1,000 步预热，视频序列 320×224，语义主视图 640×480。动作恢复不需要学习本体专属 decoder，但运行时仍要给该本体的 URDF、虚拟相机参数与数值求解器。（第 3.4–3.5 节；附录 A.1，表 1–2、8）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2600" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_6" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2849.5" as="sourcePoint"/><mxPoint x="1942" y="2849.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_3_field_7" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：不同机器人关节向量不可直接拼接，作者用 URDF 正向运动学把目标关节姿态渲染成上、左、右、前四路 action views&lt;br&gt;这种固定视觉动作接口保留整条机械臂轮廓，让多个本体共享同形状的学习目标&lt;br&gt;贡献 2：观察与动作互相影响，作者用共享视频 VAE 和 DiT 对真实 RGB 与四路动作图建模&lt;br&gt;训练时改变未来画面或动作流的遮挡方式，使同一网络学会前向预测、逆向求动作以及两者联合生成&lt;br&gt;贡献 3：生成的图像不能直接下发电机，作者从当前关节状态出发，反复渲染候选姿态并比较四视角轮廓和几何距离&lt;br&gt;再用数值优化恢复关节和夹爪状态，减少为每个平台单独训练动作解码器的需求，但运行时仍依赖准确 URDF&lt;br&gt;方法流程：任务文字、当前 RGB、关节状态和 URDF → 渲染四路动作图 → 多流视频模型预测未来 RGB 与动作图&lt;br&gt;求解器将未来动作图匹配为关节序列 → 机器人执行一个动作段 → 段末重新观察；论文真机并非每一步都闭环" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="3127" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_3_branch_7" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3551.5" as="sourcePoint"/><mxPoint x="1942" y="3551.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_4_field_1" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboTwin 2.0 完整 50 任务实验每任务收集 50 条 clean 与 500 条 randomized 示范，总计 2,500／25,000 条，两组背景、桌面物与灯光条件不同。五本体联合实验使用共有示范的 31 个任务，按每个本体—任务对 50／500 条训练，采用另一联合训练 checkpoint。真机四平台的 12 个本体—任务组合每组 60 条示范，共 720 条；训练场景为各平台正常背景，测试另加随机背景和干扰物。TriWorldBench 使用官方 500 episode 测试集。（第 4.1–4.2 节，表 3–6）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_4_branch_1" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_4_field_2" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboTwin 2.0 的 50 个双臂任务每任务每设置测 100 次，和 π0.5、Motus、LingBot-VA、Fast-WAM 的公开结果比较；TriWorldBench 的 500 episode 评估六项视频指标与总分，对比 Ctrl-World、Motus、Genie Envisioner、DreamDojo、BWM。五本体联合 checkpoint 另用 31 个共有任务，每本体每设置每任务 25 次，不能与完整 50 任务 checkpoint 成绩直接等同。真机四平台每个本体—任务组合测 20 次。（第 4 节，表 3–6；附录 A.5）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_4_branch_2" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_4_field_3" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一联合 checkpoint 用于 Aloha-Agilex、TienYi2.5 Pro 两种双臂和 Franka Research 3、UR5e 两种单臂。四平台均测放置指定色块、海绵擦盘；双臂还测三块堆叠以及一臂开抽屉、另一臂放块、前者关抽屉。单臂为一台外置 RealSense D435i＋腕部 D405、Robotiq 夹爪；Aloha 用头部 D435i＋双腕 D405、双 Robotiq；TienYi 用三台 Orbbec Gemini 336L、双 Robotiq。每组合 20 次测试，训练每组合 60 条。A800 上每 80 步段生成约 6.9 秒，动作恢复约 2.7 秒，整段执行后才重新规划。（第 4.2 节，表 6；附录 A.4、图 5）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_4_branch_3" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1513.5" as="sourcePoint"/><mxPoint x="2632" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_4_field_4" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整 RoboTwin 2.0 表 3：clean 90.50%、randomized 87.46%、平均 88.98%；超过 π0.5 的 79.80% 与 Motus 的 87.80%，但低于 LingBot-VA 的 92.20% 和 Fast-WAM 的 91.80%，不能称总体第一。TriWorldBench 表 4：总分 65.66，BWM 65.54；P3D／MQ／TC 为 61.30／41.66／64.88，但 TVC／TA 略低于 BWM。五本体共同训练表 5：Aloha-Agilex／Piper／ARX-X5／Franka-Panda／UR5-Xsg 的均值为 82.19／81.94／81.23／63.48／30.97%，后两者显著下降。真机表 6：两项共同任务四平台均值 87.5／85.0／87.5／90.0%；双臂四任务总均值分别仅 61.3／66.3%，主要被堆叠 20／30% 拉低。（第 4 节，表 3–6）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_4_branch_4" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2145.5" as="sourcePoint"/><mxPoint x="2632" y="2145.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_4_field_5" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者在 DROID 独立训练两种条件表示，用相同的 1,000 条训练轨迹、50 条 held-out CLVR／RAD 测试轨迹，预测 41 帧 RGB。表 7：相机对齐骨架渲染的 PSNR／SSIM／LPIPS 为 23.19／0.899／0.105，固定四视角 action-view 为 24.33／0.906／0.093。该实验验证动作表示对 RGB 预测的作用，不是直接证明全部 RoboTwin 闭环增益来自此模块；两种模型均从头训练。（第 4.3 节，表 7、图 3）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2493" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_4_branch_5" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2742.5" as="sourcePoint"/><mxPoint x="2632" y="2742.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_4_field_6" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;联合五本体的 UR5-Xsg 仅 30.97%，其 ground-truth action-view 恢复末端位置／旋转误差 11.85 毫米／21.39 度；Franka-Panda 为 63.48% 与 4.11 毫米／9.45 度。作者分析这两种仿真双臂由两个单臂拼合，协调与关节跟踪可能影响执行，但不能将差成绩全部归咎于求解器。真机双臂 Stack_blocks 为 20%／30%，是精细协调明显弱项。论文未给这些失败的逐试次错误类别统计。（第 4.1–4.2 节，表 5–6；附录 A.5）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="3020" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_4_branch_6" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3269.5" as="sourcePoint"/><mxPoint x="2632" y="3269.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_5_field_1" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：尚未验证更广任务与从未见过的本体；恢复依赖准确 URDF、与训练一致的渲染约定、动作图质量及几何可观测性；模型生成与数值恢复耗时较长，当前只支持动作段执行后的重规划而非每步实时闭环。（附录 A.6）本库分析：双臂精细堆叠与仿真拼合本体成绩低；几何模型与真实接触／执行偏差如何在线纠正仍需实验。后一点是从任务和反馈边界提出的研究问题，不是论文已解决的能力" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_5_branch_1" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_5_field_2" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对普通夹爪双臂的跨本体动作表示，本论文提供“URDF 几何 → 统一视觉接口 → 关节恢复”的可验证路径。潜在研究启发：把多视角重建误差或观测到的关节偏差作为执行前安全判据，在异常时缩短动作段、重新观察并规划；也可测试接触力反馈能否弥补纯几何恢复。论文目前尚未验证这种实时错误检测或力反馈恢复。（第 3–4 节；附录 A.5–A.6）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_5_branch_2" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="899.0" as="sourcePoint"/><mxPoint x="3322" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_57_5_field_3" parent="paper_57" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：尚未验证足够广的任务和全新本体；恢复需要准确 URDF、统一渲染约定和可辨认的动作图&lt;br&gt;生成与数值求解耗时较长，目前不提供逐步高频反馈控制&lt;br&gt;我的理解 / 不足：仿真五本体与真机双臂精细堆叠都有明显掉点，可能涉及几何恢复、接触物理与策略协调的共同误差&lt;br&gt;论文未按逐次试验区分这些原因，不能把所有失败归于某一个模块&lt;br&gt;未来展望：记录动作图恢复误差、真实关节偏差和接触失败，逐项决定是改视觉表示、求解器还是策略&lt;br&gt;可在不确定或接触关键阶段缩短动作段、加入触觉确认，但这只是待测试设想&lt;br&gt;对我们项目的启发：双臂机械臂可尝试用统一的 URDF 渲染检查跨平台动作；若接入 DH116，需描述手指关节、接触和可见性&lt;br&gt;先量化渲染—恢复误差与时延，再考虑闭环部署；论文未证明无需校准即可迁移到 DH116" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_57_5_branch_3" edge="1" parent="paper_57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1566.0" as="sourcePoint"/><mxPoint x="3322" y="1566.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
