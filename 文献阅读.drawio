        <mxCell id="paper_74_fulltitle" parent="paper_74" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;DiffusionVLA: Scaling Robot Foundation Models via Unified Diffusion and Autoregression" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_74_authors" parent="paper_74" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Junjie Wen、Yichen Zhu、Minjie Zhu、Zhibin Tang、Jinming Li、Zhongyi Zhou、Xiaoyu Liu、Chaomin Shen、Yaxin Peng、Feifei Feng" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_74_pdf" parent="paper_74" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;01_VLA\&lt;br&gt;DiffusionVLA.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_74_code" parent="paper_74" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;DiffusionVLA - Scaling Robot Founda&lt;br&gt;tion Models via Unified Diffusion and&lt;br&gt; Autoregression.md&lt;br&gt;&lt;br&gt;开源信息：作者发布的 DexVLA 仓库（项目页说明其中提供 DiVLA 训练脚本；DexVLA 是后续工作）" vertex="1">
          <mxGeometry height="604" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
