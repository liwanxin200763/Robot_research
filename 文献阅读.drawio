        <mxCell id="paper_12_authors" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Huiwon Jang、Sihyun Yu、Heeseung Kwon、Hojin Jeon、Younggyo Seo、Jinwoo Shin" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_12_pdf" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;01_VLA\&lt;br&gt;ContextVLA.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_12_code" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;ContextVLA - Vision-Language-Actio&lt;br&gt;n Model with Amortized Multi-Frame&lt;br&gt; Context.md&lt;br&gt;&lt;br&gt;开源信息：官方 GitHub" vertex="1">
          <mxGeometry height="534" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
