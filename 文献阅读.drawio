2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="01 数据生成与数据质量"><mxGeometry x="80" y="125" width="1440" height="88" as="geometry"/></mxCell><mxCell id="category_01_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="这个方向在研究什么：研究示范数据怎样采集、自动生成、筛选，并提高灵巧手数据的可用性&lt;br&gt;共 8 篇 · 建议先看 #16 RoboTwin 2.0，再按本页顺序浏览"><mxGeometry x="80" y="232" width="1440" height="105" as="geometry"/></mxCell><UserObject id="category_01_paper_16" label="#16 RoboTwin 2.0&lt;br&gt;要解决：如何自动生成可执行的双臂专家程序（一个百分之百知道任务应该怎么完成的脚本），批量采集数据并测量域偏移下的鲁棒性，失败恢复发生在数据生成阶段&lt;br&gt;年份 / Venue：2026，ICML 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-16" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_17" label="#17 RDGen&lt;br&gt;要解决：能否不用反复请人遥控，就生成平滑、真机也能执行的抓放示范，帮助 π0 学动作？&lt;br&gt;年份 / Venue：2026，arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-17" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_18" label="#18 DexMimicGen&lt;br&gt;要解决：把几条人类示范搬到新物体位置后，怎样让左右臂仍能并行、等待或按顺序配合？&lt;br&gt;年份 / Venue：2025，ICRA 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-18" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_19" label="#19 DataMIL&lt;br&gt;要解决：两条旧轨迹看起来都像目标任务，哪一条加入训练后真的会让策略做得更好？&lt;br&gt;年份 / Venue：2026，ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-19" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_25" label="#25 DexUMI&lt;br&gt;要解决：怎样让人自然示教复杂手指动作， 并把示教直接用于不同机器人手？&lt;br&gt;年份 / Venue：2025，CoRL 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-25" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_35" label="#35 DexCap&lt;br&gt;要解决：人直接捏、拿、转动物体很快，机器人遥操作却慢。怎样同时记录手指、手腕和物体，再把这些人手动作变成机器人手的训练示范？&lt;br&gt;年份 / Venue：2024 / RSS 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-35" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_36" label="#36 HumanoidGen&lt;br&gt;要解决：普通机械臂示范已较多，但左右手协作抓握、倒水、整理的示范很少。能否在仿真中自动建立任务和成功示范，减少人工双手遥操作？&lt;br&gt;年份 / Venue：2025 / NeurIPS 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-36" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_01_paper_37" label="#37 DROID&lt;br&gt;要解决：只在实验室同一张桌子采数据，模型可能记住背景而不是任务。怎样在大量真实房间持续采集可校准、可复用的机器人操作数据？&lt;br&gt;年份 / Venue：2024 / RSS 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-37" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><mxCell id="category_01_foot" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="选择上方论文卡片进入详情 · 详情页可按上一篇 / 下一篇顺序浏览"><mxGeometry x="80" y="1275" width="1440" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="literature-paper-16" name="01-01 RoboTwin 2.0"><mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1690" background="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="paper_16_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell paren