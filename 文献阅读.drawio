        <mxCell id="category_01_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="01 数据生成与数据质量">
          <mxGeometry x="100" y="150" width="2000" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="category_01_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#24435A;align=left;verticalAlign=top;spacing=24;" value="这个方向在研究什么：数据生成与数据质量&lt;br&gt;机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;知识链条：种子示范 → 物体与动作表示 → 轨迹扩增 → 物理检查 → 策略训练&lt;br&gt;共 21 篇 · 点击下方卡片进入独立论文页，再按本类编号顺序浏览">
          <mxGeometry x="100" y="280" width="2000" height="330" as="geometry"/>
        </mxCell>
        <UserObject id="category_01_paper_16" label="#16 RoboTwin 2.0&lt;br&gt;要解决：如何自动生成可执行的双臂专家程序（一个百分之百知道任务应该怎么完成的脚本），批量采集数据并测量域偏移下的鲁棒性，失败恢复发生在数据生成阶段&lt;br&gt;年份 / Venue：2026，ICML 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-16" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_01_paper_17" label="#17 RDGen&lt;br&gt;要解决：能否不用反复请人遥控，就生成平滑、真机也能执行的抓放示范，帮助 π0 学动作？&lt;br&gt;年份 / Venue：2026，arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-17" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_01_paper_18" label="#18 DexMimicGen&lt;br&gt;要解决：把几条人类示范搬到新物体位置后，怎样让左右臂仍能并行、等待或按顺序配合？&lt;br&gt;年份 / Venue：2025，ICRA 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-18" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="980" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_01_paper_19" label="#19 DataMIL&lt;br&gt;要解决：两条旧轨迹看起来都像目标任务，哪一条加入训练后真的会让策略做得更好？&lt;br&gt;年份 / Venue：2026，ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-19" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
