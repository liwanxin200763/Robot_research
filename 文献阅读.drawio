        <mxCell id="paper_20_1_field_2" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配&lt;br&gt;&lt;br&gt;研究背景：早期 VLA 往往在与训练场景相近的环境评测，家庭清理等多步骤操作要求迁移到新房间、新物体和新语义组合。（全文 §I–II）&lt;br&gt;&lt;br&gt;论文要解决的问题：机器人能否依靠不同本体的动作数据、高层子任务语言监督和网络视觉语义知识，在未见过的真实家居环境中完成长时操作。（§I、V）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_1_branch_2" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="899.0" as="sourcePoint"/><mxPoint x="562" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_1_field_3" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;只扩大某一机器人直接示范难以覆盖所有家庭布局和物体；π0 虽有连续 action expert，却缺少本工作强调的异质数据共训练和显式高层子任务预测流程。（§I–II、V-D）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_1_branch_3" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1454.0" as="sourcePoint"/><mxPoint x="562" y="1454.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_1_field_4" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：看图、读指令并生成动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作）。它混合不同机器人和网络图文数据，面向陌生家庭的长任务&lt;br&gt;核心问题：把来源不同的机器人动作和图文资料一起学习后，模型能否在没练过的房间清理物品？&lt;br&gt;之前的问题：只增加一台机器人的示范难覆盖新场景；π0 原方案也没有这里的联合训练和明确子任务步骤" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1672" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_1_branch_4" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1904.0" as="sourcePoint"/><mxPoint x="562" y="1904.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_2_field_1" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化&lt;br&gt;&lt;br&gt;与已有工作的关系：继承 π0 的基础 VLM 与连续动作专家，但增加离散 FAST 大规模共预训练、跨本体/网络/高层语言混合数据，再后训练 action expert 并做显式层级子任务推理。它是 VLA 而非外置符号规划器。（§II、IV–V）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_2_branch_1" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_2_field_2" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_2_branch_2" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_2_field_3" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：π0 用视觉语言模型理解画面和指令，再用动作生成部分给出连续动作&lt;br&gt;相关方向 2：FAST 把动作表示为离散符号，便于与不同机器人、网络图文和高层任务标签一起训练&lt;br&gt;代表工作：π0、π0-FAST+Flow；还通过去掉某类数据或训练步骤，检查哪些部分真正有帮助&lt;br&gt;区别：先用离散动作做联合预训练，再学连续动作；运行时先说下一子任务，再输出手臂动作" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_2_branch_3" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1429.5" as="sourcePoint"/><mxPoint x="1252" y="1429.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_3_field_1" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;以 π0 的 VLM/动作专家体系为基础，先把机器人动作和网络多模态任务统一成离散 token 共预训练，再用移动操作数据、语言子任务与 flow-matching 连续动作专家后训练；推理时先生成高层子任务，再生成低层动作块。（§IV，图 3–4）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_3_branch_1" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_3_field_2" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉编码器与语言骨干处理图像、指令和子任务文本，另有 action expert 生成连续动作；共享模型分解为高层 π(子任务|观测、总指令) 和低层 π(动作块|观测、子任务)。论文图 3 显示 SigLIP + Gemma 组成预训练 VLM，后训练加入 action expert；变化重点在训练配方和层级推理，不能说 π0.5 重新发明了 flow matching。（§IV-A–D）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_3_branch_2" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_3_field_3" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：总体任务语言、四路相机图像用于高层、手腕与前方相机用于低层，以及关节、夹爪、升降平台、底盘速度等本体状态；机器人为双 6-DoF 臂、平行夹爪和全向移动底盘。（§IV-A/E，图 5）&lt;br&gt;&lt;br&gt;输出 / 动作表示：预训练时用 FAST 把机器人动作离散化成 token，既可预测文本/框也可预测动作；后训练 action expert 以 flow matching 输出连续动作块，涵盖关节/末端目标及移动底盘等控制量，动作按各数据集分位数归一化并对短向量补零。（§IV-A–D）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_3_branch_3" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1303.5" as="sourcePoint"/><mxPoint x="1942" y="1303.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_3_field_4" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人动作按数据集的 1%/99% 分位数缩放至 [-1,1]，不同本体统一动作维度；高层口头指导把长任务拆为可执行子任务。这里的多样性来自机器人本体、真实家庭场景、语义数据类型，并非单一图像增强实验。（§IV-C/D）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_3_branch_4" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1806.0" as="sourcePoint"/><mxPoint x="1942" y="1806.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_3_field_5" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;先在机器人与非机器人任务上做约 280k 步 next-token 预训练，后以移动/多环境机器人数据、网络数据、高层任务及人工口头指导做约 80k 步训练，同时优化文本预测与 flow matching；action expert 在第二阶段初始化。推理先预测子任务再预测连续动作，与 π0 始终使用动作专家的流程不同。（§IV、图 3）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2024" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_3_branch_5" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2238.5" as="sourcePoint"/><mxPoint x="1942" y="2238.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_3_field_6" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：图像与文字由 SigLIP、Gemma 部分处理；另加入专门生成机器人动作的模型部分&lt;br&gt;贡献 2：混合约 400 小时移动双臂数据，也加入其他机器人、子任务标签及网络图文资料&lt;br&gt;贡献 3：先预测当前应完成哪个小步骤，再用 flow matching（流匹配，学习从简单分布连续变换到目标动作的路径） 方法生成一段连续动作&lt;br&gt;流程：用不同来源数据联合预训练→继续训练连续动作→运行时确定子任务→执行动作段" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2481" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_3_branch_6" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2748.0" as="sourcePoint"/><mxPoint x="1942" y="2748.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_4_field_1" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;约 400 小时移动双臂操作，覆盖约 100 个真实家庭环境；另有多环境固定机械臂、实验室跨本体机器人、网络视觉语言/目标定位数据、高层子任务数据和人工口头指导示范。此工作复用异质数据，并未给出精确的所有数据源总轨迹数或等量人力成本。（§IV-C/D，图 4）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_4_branch_1" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_4_field_2" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;在完全未见的模拟房间和真实家庭厨房/卧室中测试清理、放入抽屉/水槽、收拾衣物、铺床等；比较训练环境数 3、12、22、53、82、104，及 π0、π0-FAST+Flow、去除 ME/CE/WD/VI/HL 等训练成分。真实家庭为 3 间厨房与 3 间卧室，图 7 报每任务/环境平均 10 次试验。（§V，图 6–13）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_4_branch_2" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_4_field_3" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;两种移动双臂真机在未参与训练的房屋中执行多阶段任务，部分清理厨房/卧室可持续 10–15 分钟；量化任务包括抽屉、衣篮和水槽，图 7 给出真实房屋任务进度。该证据支持新场景和部分新物体泛化，但不能据此推断任意新任务的零样本可靠完成。（§V-A，图 7）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_4_branch_3" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1216.0" as="sourcePoint"/><mxPoint x="2632" y="1216.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_4_field_4" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练位置数增大时，未见房间四任务的平均进度总体提升（图 8）；新物体类别的语言跟随与放置成功也随场景数上升，但通常弱于已见类别（图 9）。图 10–13 显示完整 π0.5 优于 π0 和 π0-FAST+Flow，去掉跨本体/多环境数据、高层指导或网络视觉数据会损害对应能力；图中以柱状结果报告，论文正文没有统一可引用的“全任务成功率”单一数字。（§V）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1441" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_4_branch_4" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1673.0" as="sourcePoint"/><mxPoint x="2632" y="1673.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_4_field_5" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;去 ME/CE 跨本体数据使新场景表现明显下降；去 WD 网络数据主要损害未见物体语言跟随和高层推理；去 VI 人工语言指导、去 HL 子任务或只做 implicit HL 均弱于完整模型。与 GPT-4 零样本高层策略及 human HL 比较见图 13。（§V-C–E，图 10–13）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1933" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_4_branch_5" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2130.0" as="sourcePoint"/><mxPoint x="2632" y="2130.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_4_field_6" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者报告陌生抽屉把手/难开柜门持续失败、手臂遮挡污渍导致部分可观测性问题，以及高层子任务被干扰、反复开关抽屉。论文并未给出可靠的在线故障检测、动作级纠偏或长期记忆模块。（§VI）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2355" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_4_branch_6" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2545.0" as="sourcePoint"/><mxPoint x="2632" y="2545.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_5_field_1" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者承认复杂偏好/指令受训练标注限制，当前上下文长度较短，对跨房间导航与记住物体存放位置仍需更强记忆；物理接触与遮挡导致部分环境持续难解。（§VI）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可为当前 π0.5 实验设计对照：固定模型比较跨本体数据、高层语言指导、网络语义数据和训练场景数；同时以抽屉重开、遮挡、难抓把手作为执行错误基准。若研究自纠错与长期记忆，需要在 π0.5 已展示的不足上另加诊断和状态记忆，不能视为论文已有能力。（§V–VI）" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_5_branch_1" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_20_5_field_2" parent="paper_20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者报告陌生抽屉把手和遮挡下持续失败；可用上下文较短，跨房间状态也容易忘&lt;br&gt;我的理解 / 不足：展示了新房间和部分新物体上的能力，不能据此说任意新任务都能零样本完成&lt;br&gt;未来展望：让模型长期记住物体和步骤，并在执行偏离时诊断；论文尚未验证在线失败恢复&lt;br&gt;对我们项目的启发：可把 π0.5 当长任务基线，但 DH116 需单独检查动作映射，以及失败记忆是否带来增益" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_20_5_branch_2" edge="1" parent="paper_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1021.5" as="sourcePoint"/><mxPoint x="3322" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
