        <mxCell id="paper_40_1_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="核心研究问题：同一物体换视角后图像位置会变；同一画面也看不出历史。能否把跨场景图像映射到有意义的三维位置，并保留重要历史来生成动作？" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_1_branch_4" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="940" as="sourcePoint"/>
            <mxPoint x="367" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_1_field_4" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：普通二维特征缺少准确距离与位置对应；均匀选历史帧可能连续抽到几张几乎相同的图。时间线索浪费计算，空间也容易随相机变化混乱" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_2_drop" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="956" y="14" as="sourcePoint"/>
            <mxPoint x="956" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_2_header" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="B. 相关工作" vertex="1">
          <mxGeometry height="58" width="390" x="761" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_2_field_rail" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
