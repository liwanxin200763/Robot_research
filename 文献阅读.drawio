        <UserObject id="paper_13_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_13_bottomnav_1" label="返回分类" link="data:page/id,literature-page-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_13_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-12" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_13_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-14" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_13_1_field_1" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / AAAI 2026（正式论文）&lt;br&gt;引用量：22（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_1_branch_1" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_1_field_2" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：单帧 VLA 在遮挡和干扰下易失去阶段信息；直接输入多帧会增大 VLM 自注意力成本及部署延迟。（论文第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：把单帧预训练模型高效扩展为多帧 VLA，并量化时间／空间观测扰动下的鲁棒性。（第 1、3 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_1_branch_2" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_1_field_3" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;直接多帧拼接导致速度下降；从头训练时序模型难充分利用单帧大规模预训练；原有基准缺少观测鲁棒性量化。（第 1–2 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_1_branch_3" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1440.0" as="sourcePoint"/><mxPoint x="562" y="1440.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_1_field_4" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：多帧 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作），时间建模，视觉鲁棒性，高效后训练&lt;br&gt;核心研究问题：先用单帧学习基本能力，再专门做多帧后训练，如何把已有单帧 VLA 高效扩展到多帧模式，使模型利用时间信息，同时避免从头训练多帧基础模型的巨大成本&lt;br&gt;之前方法的问题：单帧 VLA 缺少时间上下文，直接多帧训练计算昂贵且推理延迟高，从头训练又浪费已有单帧基础能力" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1658" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_1_branch_4" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1942.5" as="sourcePoint"/><mxPoint x="562" y="1942.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_2_field_1" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：相对 TTF-VLA 的免训练相邻令牌融合，CronusVLA 通过多帧后训练形成特征缓存与动作解码器；相对 ContextVLA，它强调跨帧动作块和观测扰动评测。（第 2–4 节）" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_2_branch_1" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_2_field_2" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_2_branch_2" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="927.0" as="sourcePoint"/><mxPoint x="1252" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_2_field_3" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：单帧 VLA，利用大规模机器人数据学习视觉语言和基础动作能力&lt;br&gt;相关方向 2：多帧 VLA，通过连续观测增强时间推理与鲁棒性&lt;br&gt;代表工作：OpenVLA，CogACT，SpatialVLA 等&lt;br&gt;与已有方法的区别：不从零训练一个多帧基础模型，而是先完成单帧具身预训练，再通过多帧 post-training 专门学习历史特征聚合" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_2_branch_3" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1394.5" as="sourcePoint"/><mxPoint x="1252" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_3_field_1" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：两阶段训练：单帧数据学基础视觉语言动作能力，随后跨具身多帧后训练；缓存各帧紧凑特征，再由跨帧解码器生成动作块。（第 3 节，图 2）&lt;br&gt;&lt;br&gt;方法与系统结构：预训练时用 256-bin 离散动作 token 自回归；后训练把每帧 VLM 输出改为可学习连续特征，在推理中用 FIFO 维持 feature chunk。DiT 跨帧解码器、当前／历史特征调制和多帧正则完成动作生成；不是无需训练的插件。（第 3.1–3.2 节）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_3_branch_1" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_3_field_2" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：单视角 RGB 多帧历史和任务语言；每帧独立经 VLM 编码后特征融合，主方法并未把显式 Proprioception 作为核心记忆输入。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：阶段一离散动作 token；阶段二跨帧解码器生成连续动作块，面向不同机器人具身映射。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：后训练在 batch 维重构多帧序列，在线缓存旧帧特征；SimplerEnv-OR 设计 24 种观测扰动、120 种强度。训练数据增强细节另见附录，不能将基准扰动误称为全部训练增强。（第 3.2–3.3 节）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_3_branch_2" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1021.5" as="sourcePoint"/><mxPoint x="1942" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_3_field_3" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;先进行单帧动作 token 自回归预训练，后在跨具身多帧数据上训练视觉语言骨干和动作解码器，并加多帧正则；7B 与 0.5B 配置均报告。（第 3–4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_3_branch_3" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1559.0" as="sourcePoint"/><mxPoint x="1942" y="1559.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_3_field_4" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：提出单帧预训练加多帧后训练的两阶段 VLA 框架，复用已有单帧具身基础能力&lt;br&gt;贡献 2：在多帧 post-training 中利用可学习特征与 feature chunking 聚合历史视觉信息，实现高效时间建模&lt;br&gt;贡献 3：提出 SimplerEnv-OR，包含 24 类观测扰动和 120 个严重程度设置，用于系统评测 VLA 的视觉鲁棒性&lt;br&gt;方法流程：大规模单帧具身预训练 → 多帧后训练 → 历史特征聚合 → 当前与历史联合表示 → 动作预测" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_3_branch_4" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2026.5" as="sourcePoint"/><mxPoint x="1942" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_4_field_1" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：大规模机器人示范用于单帧预训练，跨具身数据用于后训练；真机 Franka 每任务约 50 条遥操作轨迹，并以每任务 25 次测试评估。（第 3–4 节；附录 F）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：SimplerEnv、LIBERO、SimplerEnv-OR 和 Franka 真机；对比 OpenVLA、CogACT、TraceVLA、RoboVLMs、SpatialVLA、DP3、π0 等。SimplerEnv-OR 另测时间和空间扰动。（第 4 节，表 1–5）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_4_branch_1" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_4_field_2" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;Franka Research 3 第三人称相机，覆盖简单抓放、顺序按键、多个物体操作和相机遮挡／干扰；长程任务中的重复按键是单帧基线的典型状态混淆。（第 4.2 节，图 4；附录 F）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_4_branch_2" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="927.0" as="sourcePoint"/><mxPoint x="2632" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_4_field_3" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;SimplerEnv 平均成功率 70.9%、推理约 8.73 Hz；直接多帧后训练基线为 32.4%／3.09 Hz，完整方法为 70.9%／8.73 Hz（表 4）。论文还报告 LIBERO 较 OpenVLA 提升 26.8%、真机平均成功率 72.6%；各数值应按其原评测设置解读。（摘要，第 4 节）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_4_branch_3" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1342.0" as="sourcePoint"/><mxPoint x="2632" y="1342.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_4_field_4" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融实验：单帧基线 31.0%，直接多帧 32.4%，加解码器 48.2%，训练骨干 67.2%，再加正则 70.9%（表 4）。7B 最优约 7 帧，0.5B 最优约 4 帧；更多历史不一定更好（图 5）&lt;br&gt;&lt;br&gt;Failure Case：附录 G 图 20 明列：杂乱场景中单第三人称视角导致杯子抓取位置反复调整；远处抽屉深度估计不准；遮挡下缺少显式避障使机械臂碰走目标；仿真中罐子被轻触即不合理滚动。论文有个别重试成功示例，但不能概括为通用故障恢复。（附录 G）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_4_branch_4" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1851.5" as="sourcePoint"/><mxPoint x="2632" y="1851.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_5_field_1" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者在附录失败案例指出单视角、深度估计、遮挡避障与 sim-to-real 差距。多帧观测鲁棒性不等于具有故障原因识别或自主重规划。（附录 G；后一项为文献库分析）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：SimplerEnv-OR 和附录 G 提供明确执行干扰、遮挡和失败类型，可用来设计错误检测与恢复测试；其自身仍主要解决感知鲁棒性。（第 3.3、4 节；附录 G）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者指出的不足：&lt;br&gt;我的理解 / 不足：&lt;br&gt;未来展望：&lt;br&gt;对我们项目的启发：" vertex="1">
          <mxGeometry height="709" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_5_branch_1" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="494.5" as="sourcePoint"/><mxPoint x="3322" y="494.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_13_5_field_2" parent="paper_13" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="877" as="geometry"/>
        </mxCell>
        <mxCell id="paper_13_5_branch_2" edge="1" parent="paper_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
