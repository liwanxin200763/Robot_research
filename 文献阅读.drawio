          </mxCell>
        </UserObject><UserObject id="paper_65_bottomnav_1" label="返回分类" link="data:page/id,literature-page-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_65_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-48" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_65_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-66" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_65_1_field_1" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICLR 2026（arXiv 首发于 2025）&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_1_branch_1" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_1_field_2" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;研究背景：双臂面对多项任务时既要满足先后依赖、拿取物体的连续性，又要利用可以并行的时间段；串行任务计划浪费双臂能力。（全文 §1）&lt;br&gt;&lt;br&gt;论文要解决的问题：给定自然语言多任务指令和环境状态，如何同时完成跨任务分解、去冗余、左右臂显式分配和无死锁并行调度。（§1、§3）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_1_branch_2" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_1_field_3" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;直接生成线性步骤的 LLM 规划器不显式约束依赖、占臂和物体持有关系；即便动作正确，也常退化为顺序执行或产出物理冲突计划。（§1–2）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_1_branch_3" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1405.0" as="sourcePoint"/><mxPoint x="562" y="1405.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_1_field_4" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：双臂多任务协作与长程调度&lt;br&gt;任务包是用户同时提出的一组目标；依赖图 DAG 用有向边表示先做什么后做什么，两个无依赖且资源不冲突的节点才可能在左右臂同时执行&lt;br&gt;核心问题：双臂必须同时考虑动作先后、夹爪是否持物、同一物体能否跨动作继续使用，以及需要双臂同步的步骤&lt;br&gt;作者希望从自然语言和场景状态产出可执行且尽量并行的计划，减少两臂被迫串行的时间&lt;br&gt;之前方法的问题：LLM 线性分解虽能列出步骤，常未明确每步所需臂数、物体持有和跨任务重复动作&lt;br&gt;因此会生成一臂空闲的低效计划，或两臂都已占用而无法执行下一双臂步骤的死锁" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1623" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_1_branch_4" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1942.5" as="sourcePoint"/><mxPoint x="562" y="1942.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_2_field_1" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;与已有工作的关系：相较顺序式 LLM Planner 或对话式 RoCo，核心改进是显式 DAG 依赖、跨包重组和资源约束下的并行调度；π0 等只是可接入的底层技能执行器。（§2–5）" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_2_branch_1" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_2_field_2" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_2_branch_2" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_2_field_3" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：LLM-Planner 等把语言目标拆成子目标，也可在失败后重规划，却通常按顺序执行&lt;br&gt;RoboPARA 在此基础上显式构造依赖边和臂资源约束，寻找可并行的步骤；LLM-Planner 在实验中是对照方法&lt;br&gt;相关方向 2：RoCo 通过两个代理对话协调双臂，FLTRNN 借记忆处理长程规划，二者仍可能缺少跨任务包统一去冗余&lt;br&gt;本篇把所有任务包放进一张图，使一次拿刀可服务多个切割任务，避免重复拿放&lt;br&gt;代表工作：ACT、Diffusion Policy 和 π0 负责把已规划的技能变成连续低层动作，是可接入的执行器而非高层图算法来源&lt;br&gt;X-DAPT 是作者自建的多场景规划评测集，不能把其计划节点数量说成机器人动作训练轨迹&lt;br&gt;与已有方法的区别：RAG 检索历史过程，LLM 生成带前驱、动作类型、所需臂数和耗时的 DAG；规则检查后再重遍历&lt;br&gt;调度器保持 pick-use-place 的同臂连续性、双臂节点同步，并在持物冲突时回滚重排，故并行性受物理资源限制" vertex="1">
          <mxGeometry height="884" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_2_branch_3" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1552.0" as="sourcePoint"/><mxPoint x="1252" y="1552.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_3_field_1" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;先让 LLM 生成并纠正全局依赖 DAG，再以规则化图重遍历分配左右臂、合并重复动作、插入同步并解除持有冲突。（§3，图 2）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_3_branch_1" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_3_field_2" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;RAG 检索程序知识，LLM 把任务包合并为节点带动作类型、所需臂数、持续时间和前驱边的 DAG；校验节点依赖与资源约束。调度器仅在前驱完成、对应臂空闲时启动，pick-use-place 要保持同臂；双臂节点同步等待两臂。若两臂各持物导致后继双臂动作死锁，则回滚较晚的 pick 及依赖子树并重新排队。这是集中式高层规划，底层 ACT/DP/π0 可分别执行技能，并非端到端 VLA 或两个自主智能体的学习框架。（§3、图 2、式 4–8）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_3_branch_2" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="797.5" as="sourcePoint"/><mxPoint x="1942" y="797.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_3_field_3" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：多任务自然语言指令、场景物体和机器人状态、记忆检索结果、技能库与动作约束，以及执行历史反馈。（§3，图 2）&lt;br&gt;&lt;br&gt;输出 / 动作表示：输出左右臂随时间的动作计划与高层操作节点，节点表示 pick、place、use 等离散技能及依赖；它不直接预测关节/末端连续动作。双臂动作需同一时刻分配两臂，单臂动作可交叉并行。（§3）&lt;br&gt;&lt;br&gt;数据处理与数据增强：跨任务节点合并消除重复操作，例如一次持刀完成多次切割再放刀；DAG 校正去除错误依赖，并在调度时加入臂占用与死锁约束。未报告面向图像或动作训练的常规数据增强。（§3、§5.3）" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_3_branch_3" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1412.0" as="sourcePoint"/><mxPoint x="1942" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_3_field_4" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;高层采用 GPT-4o 或 DeepSeek V3 推理加规则调度，非训练新 VLA；底层实验使用 ACT、DP、π0 等已训练技能策略。论文未把高层规划描述为联合训练双臂策略。（§5.1）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_3_branch_4" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1967.0" as="sourcePoint"/><mxPoint x="1942" y="1967.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_3_field_5" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：多任务若各自规划，会重复拿放物体且看不见跨任务依赖；作者检索程序知识和环境状态，提示 LLM 汇总成一张 DAG&lt;br&gt;每个节点携带动作类型、所需臂数、预计耗时及前驱，随后检查错误边并要求 LLM 修正，让计划可供规则调度&lt;br&gt;贡献 2：有图仍可能发生两臂争用或物体持有冲突；重遍历调度只启动前驱已完成且相应手臂空闲的节点&lt;br&gt;拿起物体后的使用与放下保持同一臂；两臂步骤等待两臂空闲，遇到持物死锁时回滚较晚的拿取及依赖分支并重排&lt;br&gt;贡献 3：作者建立 X-DAPT，覆盖厨房、办公室、温室、工厂等 10 种场景及易中难三档、超过 1000 个任务包&lt;br&gt;它专门测步骤完成效率、失败比例、跨包并行和双臂同时使用，使规划收益不只靠一条演示轨迹说明&lt;br&gt;方法流程：多任务文字、物体／机器人状态、技能约束及执行历史 → 检索相关程序 → LLM 生成并校验依赖图&lt;br&gt;规则调度器合并重复节点、分配左右臂、处理同步和死锁 → 输出离散技能计划 → 底层已训练技能执行并反馈重规划" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="2185" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_3_branch_5" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2609.5" as="sourcePoint"/><mxPoint x="1942" y="2609.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_4_field_1" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;自建 X-DAPT，涵盖厨房、办公室、温室、工厂等 10 场景，超过 1000 个任务包，按 easy/medium/hard 设置任务复杂度；它是规划评测集，论文没有报告用 X-DAPT 生成大量低层动作训练轨迹。（§4）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_4_branch_1" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="330.0" as="sourcePoint"/><mxPoint x="2632" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_4_field_2" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;X-DAPT 四个重点场景和三档任务复杂度，评估 TEI（执行效率）、TFR（任务失败率）、PPR（跨包并行）、APR（双臂同时使用）。基线为 LLM3、ChatGPT-Prompts、VOYAGER、Embodied TaPA、LLM-Planner、FLTRNN、RoCo；另测试 DeepSeek V3、RoboTwin 和真机。（§5、表 1–3、附录 E）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_4_branch_2" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="762.5" as="sourcePoint"/><mxPoint x="2632" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_4_field_3" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 Franka Research 3、UR5e 与人形机器人配置中验证任务计划；温室场景的 Franka 任务给出 RoboPARA 相比顺序基线更短的 10 步执行序列，论文图 1 报真机执行时间缩短约 30%–50%。这些是规划与技能执行验证，不能视为开放世界连续控制通用成功率。（§5、图 1、4、附录 E）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_4_branch_3" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1219.5" as="sourcePoint"/><mxPoint x="2632" y="1219.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_4_field_4" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPT-4o 厨房场景 TEI 1.407、TFR 0、APR 0.334；办公室 TEI 1.553、APR 0.293，多数基线 PPR 为 0（表 1）。不同难度下 RoboPARA 的 APR 为 0.342/0.321/0.351；Hard 的 TEI 0.869、TFR 0.041（表 2）。论文文字报告可比任务包执行步骤约减少 7%。（§5.3）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1462" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_4_branch_4" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1659.0" as="sourcePoint"/><mxPoint x="2632" y="1659.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_4_field_5" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;去掉环境信息、指令约束、deadlock check、DAG correction 分别造成规划质量下降；例如厨房 Hard 包完整模型 TFR 为 0，去掉 deadlock check 为 0.618、去掉 DAG correction 为 0.488，说明资源检查和图校正不能省。（表 3）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1884" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_4_branch_5" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2081.0" as="sourcePoint"/><mxPoint x="2632" y="2081.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_4_field_6" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM 生成错误依赖、臂持物冲突和死锁是被显式检测的规划失败；论文展示任务执行失败后闭环重规划，但复杂包中仍可能超过有限轮纠正能力。VOYAGER 在该设定下无法给出具体双臂执行步骤。（§3、§5.3–5.5）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2306" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_4_branch_6" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2496.0" as="sourcePoint"/><mxPoint x="2632" y="2496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_5_field_1" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者说明使用 API 的成本高，DAG 反复校正使 token 消耗平均为基线约 1.3 倍；复杂依赖仍可能纠正失败，技能库绑定既定场景和任务模板，未见任务泛化受限。（§5.5）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：给普通夹爪双臂长期任务提供“检测执行冲突→重规划”的高层架构参考；若用于 VLA 错误恢复，需补充连续动作失误、感知误判与技能失败的因果诊断，现有规划器并未解决这些低层问题。（§3、§5）" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_5_branch_1" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_65_5_field_2" parent="paper_65" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：调用 GPT-4o／DeepSeek V3 且反复修正 DAG，平均 token 消耗约为对照的 1.3 倍&lt;br&gt;复杂依赖在有限轮修正中仍会规划错误；技能库依赖预定义场景与任务模板，未见任务的泛化受限&lt;br&gt;我的理解 / 不足：真机案例展示规划与现成技能协同，不能证明所有未知物体和接触状态都能稳定执行&lt;br&gt;TEI、TFR 多由规划节点统计，底层抓取、视觉误判与实际轨迹碰撞并未被高层 DAG 彻底解决；这是按方法边界作的推断&lt;br&gt;未来展望：让依赖校验同时检查可达区域、夹爪持物与接触安全，在实际技能失败后更新图而非仅重新调用原计划&lt;br&gt;应分别记录规划耗时、真实并行时间、执行成功和 token 成本，测更开放的任务包能否保持收益&lt;br&gt;对我们项目的启发：双臂机械臂可沿用 DAG 节点与臂资源锁，把 VLA 输出封装成可监控技能并加入失败反馈&lt;br&gt;若接入 DH116，需要把指间抓持状态和交接安全也写成约束；论文的普通夹爪计划不能直接保证灵巧手接触操作" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_65_5_branch_2" edge="1" parent="paper_65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-66" name="05-07 VoxAct-B">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
