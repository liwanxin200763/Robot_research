        </UserObject><UserObject id="paper_19_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-18" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_19_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-25" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_19_1_field_1" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICLR 2026（arXiv 首发于 2025）&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_1_branch_1" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_1_field_2" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;研究背景：通用机器人数据集很大但异质，针对新任务简单使用全部旧数据可能产生负迁移；目标任务示范又少，需要知道哪部分旧数据真正有用。（全文 §1）&lt;br&gt;&lt;br&gt;论文要解决的问题：在不做大量真机 rollout 的前提下，为既有示范估计其对目标任务最终模仿策略表现的贡献，并选出值得联合训练的子集。（§1、§3–4）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_1_branch_2" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_1_field_3" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：视觉、语言、动作相似度是启发式代理，未必等于训练后的策略收益；真实机器人 rollout 昂贵且不可微。只用目标任务少量示范或混用所有历史数据也可能很差。（§1–2）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：从旧机器人示范中挑真正有助于新任务的数据，而不是把所有数据一起训练&lt;br&gt;核心问题：两条旧轨迹看起来都像目标任务，哪一条加入训练后真的会让策略做得更好？&lt;br&gt;之前的问题：全量混训可能让目标任务变差；外观或动作相似，也不等于能提高最终成功率" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_1_branch_3" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1517.0" as="sourcePoint"/><mxPoint x="562" y="1517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_2_field_1" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_2_branch_1" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_2_field_2" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;IL：模仿学习，从示范学习动作&lt;br&gt;SAC：一种通过奖励学习连续动作的强化学习算法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_2_branch_2" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_2_field_3" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;Re-Mix 优化数据域的混合比例；相似度/“Data Quality”规则根据表观属性判断；CUPID 用在线 rollout 的 policy-gradient influence 做单任务筛选。DataMIL 关注目标任务策略表现的离线影响估计，可在异质数据集选择片段/轨迹，而不是简单固定域权重或凭视觉相似度打分。（§2）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_2_branch_3" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_2_field_4" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：常按画面或动作相似度选数据，容易找到相近例子，却未直接测训练收益&lt;br&gt;相关方向 2：Re-Mix 调整各数据来源比例；CUPID 用真实尝试估影响，但目标和收集成本不同&lt;br&gt;代表工作：Re-Mix、CUPID、Behavior/Flow Retrieval（检索，从已有记录中找出当前相关的信息）、STRAP 和 All-Data，分别代表配比、检索与全量训练&lt;br&gt;区别：先离线估计每组旧示范对目标策略的贡献，再挑片段训练；它不制造新轨迹" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_2_branch_4" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1680.0" as="sourcePoint"/><mxPoint x="1252" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_3_field_1" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;用 datamodel 估计训练数据子集变化对目标策略指标的影响；以目标任务保留示范上的 proxy loss 替代在线成功率，在轨迹/片段簇粒度排序，选高正贡献数据与目标示范 co-training。（§3–4，图 1）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_3_branch_1" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_3_field_2" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;给历史数据簇分数 τ，目标是预测训练子集加入/移除后策略评价的变化。小策略可在随机子集上反复训练，用回归估分；大策略用对数据权重求 metagradient 估影响。以 held-out target loss 作为可微代理，缓解真机 rollout 成本；结果是在固定选择比例下选分数最高的旧数据，而非生成新轨迹或给所有样本持续加权。分数是特定目标任务和训练算法条件下的影响估计，不是任务无关的绝对“质量”。（§3–4）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_3_branch_2" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="797.5" as="sourcePoint"/><mxPoint x="1942" y="797.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_3_field_3" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：大规模旧示范 D、少量目标示范 Dtarget、可训练策略 A、目标示范上的代理评价指标；在视觉设置中还输入图像、语言、动作轨迹。（§3–5）&lt;br&gt;&lt;br&gt;输出 / 动作表示：输出对旧数据轨迹/片段簇的影响分数和选中子集 Dsel；下游 Octo/MLP 策略再学习动作。DataMIL 本身不产生新的关节或末端控制动作。（§4.3）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_3_branch_3" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1307.0" as="sourcePoint"/><mxPoint x="1942" y="1307.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_3_field_4" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;把样本聚成轨迹或短片段以降噪，LIBERO 用长度 15 的片段、按影响分数选前 10%；真机按整条轨迹筛选，并拆分目标数据以减小代理评价的分布偏移。多样性不是单独最大化指标；实验发现可从不同本体、不同来源选出正迁移数据。未给单独的 state coverage 或 action diversity 优化目标。（§4.2–4.3、§5.2、附录 F）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_3_branch_4" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1781.5" as="sourcePoint"/><mxPoint x="1942" y="1781.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_3_field_5" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;MetaWorld 用回归估计 datamodel；LIBERO/OXE 因 Octo 训练昂贵采用 metagradient。选完数据按 α=0.5 混合目标数据和选中旧数据做 BC/Octo 微调；LIBERO 训练 10k 步，OXE 50k 步。附录 G 指出 metagradient 通常比普通训练慢 3–5 倍，OXE 的估分在 4 张 A100 上需 3–4 天。（§4–5、附录 F–G）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2024" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_3_branch_5" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2238.5" as="sourcePoint"/><mxPoint x="1942" y="2238.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_3_field_6" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：反复比较加入不同旧示范后目标任务的表现，给数据簇估一个“能带来多少帮助”的分数&lt;br&gt;贡献 2：小策略训练不同随机子集来估分；大策略用梯度近似，减少直接反复训练的代价&lt;br&gt;贡献 3：选择预测为正贡献的轨迹或片段，与少量目标任务示范一起训练最终策略&lt;br&gt;流程：收旧数据和目标示范→估计每组旧数据的帮助→挑高分片段→训练目标策略并评估" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2481" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_3_branch_6" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2730.5" as="sourcePoint"/><mxPoint x="1942" y="2730.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_4_field_1" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;MetaWorld 50 任务：专家示范加 SAC 探索轨迹，每任务 5 条目标专家示范；LIBERO-90 的 4500 条遥操作示范作旧数据，LIBERO-10 每目标任务取 5 条；真机从异质 OXE13/OXE23/OXE24 子集选数据，目标任务另行遥操作采集 10–40 条。OXE 选择比例 0.5%–1%，研究的是筛选现有数据而非扩增规模；计算成本详见附录 G。（§5、附录 F 表 2–3）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_4_branch_1" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_4_field_2" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;MetaWorld 50 任务、LIBERO-10、四类真实任务（Franka-Ball、Franka-Pouch、Tiago-Sink、Droid-Multitask）；对照 Target-Only、All-Data/Random、基于状态或动作的检索、Behavior Retrieval、Flow Retrieval、STRAP。LIBERO 每任务 50 次 rollout、5 个随机种子；真机按附录 F 表 3 的固定次数评测且只有一个种子。（§5、附录 F）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_4_branch_2" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_4_field_3" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;OXE 异质数据支持 Franka 两任务、未在旧数据出现的 Tiago 本体任务和 DROID 三任务组合；比较以固定物体位姿的真机 rollout 评估。其跨本体结果是“选择相关旧轨迹”的证据，并非模型无微调零样本执行。（§5.1–5.2、附录 F）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_4_branch_3" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_4_field_4" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO-10 平均成功率 DataMIL 37.76%，优于 BR 36.4% 与 All-Data 27.72%；OXE 真机平均 61.0%，对比 Flow 40.0%、BR 39.4%、All-Data 30.9%；Franka-Pouch 为 70.6%，Tiago-Sink 为 64.1%，均见附录表 1。并非每个单独 LIBERO 任务都第一，如 Bowl-Cabinet 低于 STRAP。（§5、附录 C.7 表 1）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_4_branch_4" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1760.5" as="sourcePoint"/><mxPoint x="2632" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_4_field_5" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO-5 上比较选取比例、簇长度和 co-training 比例：5%–10% 选择比例时优势明显，≥20% 时方法差距缩小；长度 15 片段优于更粗聚类；α=0.5 效果较好。也比较 rollout 真指标与 proxy loss、回归与 metagradient，代理和高效估计稍有精度损失但避免昂贵 rollout。（§4.2、附录 C.3–C.5、图 2、13）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_4_branch_5" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2217.5" as="sourcePoint"/><mxPoint x="2632" y="2217.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_4_field_6" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;相似状态可对应相反或无益动作，启发式检索会选到视觉接近但损害目标策略的样本；DataMIL 在部分 LIBERO 任务仍弱于特定基线，说明影响估计并非万能。论文未提供在线机器人执行错误恢复机制。（§5.2、附录 A、C.7）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2460" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_4_branch_6" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2650.0" as="sourcePoint"/><mxPoint x="2632" y="2650.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_5_field_1" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者指出估分成本仍高，选择比例与簇粒度缺乏原则化设定，主要评价仍偏单目标任务，超大规模多任务推广待验证；真机仅单种子评估。（§6、附录 F–G）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可用于判断跨本体轨迹、普通夹爪双臂数据中哪些片段真正改善目标 VLA/IL 策略；若面向失败恢复，可以把目标验证集设为执行误差场景，但这是库内研究设想，论文未直接实证。（§4–6）" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_5_branch_1" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_5_field_2" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出估计每组数据的作用仍费计算；数据怎样分组、取多少比例还缺稳妥规则&lt;br&gt;我的理解 / 不足：同一条数据对不同目标和训练算法作用可能不同；真机只跑单种子，不能当通用质量分&lt;br&gt;未来展望：降低估分成本，测试同时面对多个目标任务；失败恢复数据是否适用尚无直接结果&lt;br&gt;对我们项目的启发：从双臂仿真和少量真机记录中挑数据，仍要用 DH116 的目标任务测是否真的有增益" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_5_branch_2" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_19_5_field_3" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_19_5_branch_3" edge="1" parent="paper_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1391.0" as="sourcePoint"/><mxPoint x="3322" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
