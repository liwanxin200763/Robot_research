            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_46_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#46 Policy Decorator">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_46_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="04 执行误差与失败恢复  ·  本类第 11 / 16 篇  ·  问题：大策略从示范学会大部分动作，但某些位置偏一点就失败。怎样保留已有能力，用环境反馈只学习额外小修正，而不是重训整个大模型？&lt;br&gt;方法流程：观察 → 冻结基础策略提议动作 → 小残差策略补修正 → 执行合成动作 → 环境给奖励 → 更新残差策略 → 保持基础策略不变">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
