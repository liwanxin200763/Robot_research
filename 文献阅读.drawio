        <mxCell id="paper_48_2_field_4" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="与已有方法的区别：先训练通用动作跟随器，再针对物体操作学习残差。共享底层跟踪能力，减少每个新任务都从零学手部控制的成本" vertex="1">
