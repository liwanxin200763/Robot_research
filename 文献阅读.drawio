            <mxGeometry x="1140" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_78_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-77" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_78_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-79" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_78_1_field_1" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / Conference on Robot Learning (CoRL) 2024; PMLR 270 (published 2025)&lt;br&gt;引用量：待Google Scholar人工核验，旧卡数字不作当前核实结果；核验日期2026-10-15（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_1_branch_1" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="354.5" as="sourcePoint"/><mxPoint x="562" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_1_field_2" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_1_branch_2" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="787.0" as="sourcePoint"/><mxPoint x="562" y="787.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_1_field_3" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整七位作者与PDF首页、PMLR页核对一致。会议为CoRL 2024，正式论文集于2025年出版，PMLR 270:2372–2395；本地复用24页会议版全文。arXiv 2403.07870v1发表于2024-03-12，为另一版本入口，不能把会议年份、出版年份和预印本日期混写" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_1_branch_3" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1202.0" as="sourcePoint"/><mxPoint x="562" y="1202.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_1_field_4" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;OPEN TEACH解决跨机器人平台示范采集工具昂贵、专有或只支持特定形态的问题。它以Quest 3手/腕跟踪输入，通过可定制映射控制机械臂、夹爪、Allegro或移动机器人；彩色透视与机器人视频提供视觉反馈，记录观察及机器人状态供策略训练。38项遥操作展示说明接口覆盖面，十项策略学习表明数据可用，但不是38项都学会自主策略，更不是一套通用Diffusion/Flow Matching算法（§3–4）" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1427" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_1_branch_4" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1659.0" as="sourcePoint"/><mxPoint x="562" y="1659.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_1_field_5" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：跨不同机器人形态采集遥操作示范&lt;br&gt;OPEN TEACH 把头显手部追踪、动作映射、视觉反馈和数据记录拆成可替换模块" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1919" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_1_branch_5" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2109.0" as="sourcePoint"/><mxPoint x="562" y="2109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_2_field_1" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作与基本机制：ALOHA、GELLO以类似目标机械臂的装置控制机器人，将机械结构约束直接反馈给操作者，但需额外硬件及本体适配。AnyTeleop用视觉感知与优化，支持多本体及仿真；OPEN TEACH沿用统一接口方向，改以商用头显跟踪和混合现实反馈降低外部相机设置负担" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_2_branch_1" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_2_field_2" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_2_branch_2" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_2_field_3" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与基本机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holo-Dex已有VR到Allegro手指映射；本文增加腕到臂、夹爪开关、移动平台包装器，并改善拇指工作区映射。所谓包装器就是把统一的人手关键点转换成不同机器人的原生动作，不保证不同本体具有相同可达空间（§2、3.3）" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_2_branch_3" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1384.0" as="sourcePoint"/><mxPoint x="1252" y="1384.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_2_field_4" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;本体：机器人的具体身体结构，包括手臂、手指和移动底盘&lt;br&gt;ALOHA、GELLO以类似目标机械臂的装置控制机器人，将机械结构约束直接反馈给操作者，但需额外硬件及本体适配&lt;br&gt;Holo-Dex 已把头显手势映射到 Allegro 灵巧手，但主要针对手部。OPEN TEACH 再把腕部位置送给机械臂，把手指姿态送给灵巧手或夹爪，并提供不同平台的连接模块" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_2_branch_4" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1851.5" as="sourcePoint"/><mxPoint x="1252" y="1851.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_3_field_1" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 人手输入与操作界面&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 人手输入与操作界面：Quest 3内置手姿流90 Hz，彩色透视让用户直接看到周围场景，界面另显示机器人相机近景。头显相机已内部标定，减少外部多相机标定，但机器人的坐标、工作区和驱动仍需接入。头显约500美元为论文年代硬件报价，不包含机器人、相机、计算机或触觉设备（图2，PDF p.4）&lt;br&gt;&lt;br&gt;1. 人手输入与操作界面：机械臂用腕点、食指与小指掌指点建立掌平面及法向，腕位置映到末端位置，掌坐标的旋转变化映到末端旋转。普通夹爪用小指—拇指捏合触发状态切换；移动Stretch改用食指—拇指捏合，腕前后、上下和左右运动分别映到伸臂、高度及底盘移动（§3.3）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_3_branch_1" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_3_field_2" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 灵巧手重定向和操作者控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 灵巧手重定向和操作者控制：非拇指关节直接对应，忽略Allegro没有的小指；拇指用指尖位置映射后求逆运动学。相较Holo-Dex多个二维分区，本文用一个覆盖全工作区的大区域，越界时投影到最近边界以减少停滞与跨区抖动，并加入垂直掌面的高度映射（附录5.1.2、图4，pp.14–15）&lt;br&gt;&lt;br&gt;2. 灵巧手重定向和操作者控制：提供暂停让用户重新摆手再恢复，以及降低运动分辨率/缩放的精细操作模式。它们帮助人修正姿态，不能替代关节限位、碰撞检查、故障恢复；正文没有完整量化的端到端延迟或各平台失踪帧保护/滤波参数，未报告部分须查驱动及代码" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_3_branch_2" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1126.5" as="sourcePoint"/><mxPoint x="1942" y="1126.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_3_field_3" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 通信、数据保存与学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;ZeroMQ连接Detector、Keypoint Transformer、Operator、Controller与Visualizer。Operator同时读目标姿态和实测机器人状态；Controller执行后发布状态；录制进程分开保存RGB/深度/触觉、关节/夹爪状态及时间戳，再按时间戳对齐。控制流频率不等于落盘频率，附录未给统一录制Hz（附录5.1.1，p.14）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1474" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_3_branch_3" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1688.5" as="sourcePoint"/><mxPoint x="1942" y="1688.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_3_field_4" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 通信、数据保存与学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allegro采用重力补偿PD，300 Hz输出力矩；Franka用Deoxys，xArm用官方API，Jaco与Stretch各用已有控制器。表1中Franka-Allegro/Jaco-Allegro为60 Hz、双xArm夹爪90 Hz、Stretch5 Hz，Allegro模拟60 Hz、LIBERO20 Hz；不能将“最高90 Hz”套到全部平台" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1931" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_3_branch_4" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2128.0" as="sourcePoint"/><mxPoint x="1942" y="2128.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_3_field_5" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 通信、数据保存与学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机Franka-Allegro记录视觉＋Xela触觉，以TAVI示范引导残差RL学习；Allegro模拟用FISH，LIBERO模拟用Transformer BC＋GMM头及动作块。不同环境使用不同算法和传感监督，因此平均成功率衡量数据用途，不等于统一策略性能（§4.2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2353" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_3_branch_5" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2550.0" as="sourcePoint"/><mxPoint x="1942" y="2550.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_4_field_1" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;覆盖面与策略学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;覆盖面与策略学习：六种配置包括四真机和两模拟。双xArm、Stretch等展示了长时遥操作，如双臂做三明治、插USB和移动开门；人持续观察并纠错完成，不应写成这些任务都已自主完成或从模拟迁移（§4.1/4.5、附录图5–10）&lt;br&gt;&lt;br&gt;覆盖面与策略学习：正文表2（PDF p.7）真机四任务用3/6/4/6条示范，分别开盒9/10、抓海绵7/10、拾茶包7/10、抓物扭转8/10。Allegro模拟三任务为10/10、10/10、7/10；LIBERO为10/10、9/10、9/10，十任务合86/100，即86%" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_4_branch_1" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_4_field_2" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;覆盖面与策略学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录表7（p.23）另报模拟每任务三种子、每种子25试次：Allegro翻块0.97±0.03、翻海绵0.79±0.05、捏取0.75±0.07，LIBERO关抽屉0.96±0.03、开炉0.95±0.04、放汤罐0.77±0.02。它与正文十次结果不是同一统计协议，不混算；项目页87%也不覆盖正文86%的口径" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_4_branch_2" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="934.0" as="sourcePoint"/><mxPoint x="2632" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_4_field_3" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;新用户研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;15名新用户先练习10分钟，任务顺序随机，每人约参与三任务、每任务五次，并非每人完成所有方法所有任务。因基线缺少可用臂重定向代码，Holo-Dex/AnyTeleop只对比无需臂运动的翻块和捏取；其余任务只有OPEN TEACH，不能据此宣称臂任务全面胜过基线（§4.6、附录表5）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_4_branch_3" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_4_field_4" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;新用户研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;表3汇总新用户翻块成功率三法均1，完成时间中位数为Holo-Dex6.58 s、AnyTeleop13.71 s、本文5.5 s；捏取成功率0/0.2/0.8。表3却在Holo-Dex捏取0成功时列17.49 s“成功示范中位耗时”，与附录无成功标记存在解释冲突，本卡不使用该耗时推优势。正文称新用户成功率为专家的76%、耗时2.25倍，是汇总描述而非每个任务定律" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_4_branch_4" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1795.5" as="sourcePoint"/><mxPoint x="2632" y="1795.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_5_field_1" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目联系与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足、项目联系与未来：作者明确指出：头显遮挡会降低关键点质量，有时手指识别错误令捏合关闭夹爪失灵；改进手姿跟踪可改善易用性（§5）&lt;br&gt;&lt;br&gt;不足、项目联系与未来：我的分析：包装器灵活也把本体约束与安全责任留给接入者；手势误触发应单独统计。真实学习含触觉及残差RL，不是纯人类裸手视频即可直接学会。论文未报告一套完整自主失败恢复机制，也没有统一端到端算力和数据量预算&lt;br&gt;&lt;br&gt;不足、项目联系与未来：D435i＋DH116最低验证：优先复用异步时间戳记录、暂停/分辨率设计和离线受限重定向。DH116右手六主动轴、十一总DOF需要独立耦合、关节排序和三指工作区模型，不能照搬Allegro或左手仿真资产。当前整手/多轴运动锁定、故障根因未知，仅做D435i离线观测、仿真与日志" vertex="1">
          <mxGeometry height="779" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_5_branch_1" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="529.5" as="sourcePoint"/><mxPoint x="3322" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_78_5_field_2" parent="paper_78" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目联系与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整复现需要Quest 3及SDK、目标臂/手和相机，TAVI还需触觉及在线训练；GPU型号与完整学习耗时预算未明确报告。双臂可先复用手腕映射与双客户端结构，另验证双臂碰撞及同步，不暗示当前已支持实机臂手联动" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_78_5_branch_2" edge="1" parent="paper_78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1137.0" as="sourcePoint"/><mxPoint x="3322" y="1137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
