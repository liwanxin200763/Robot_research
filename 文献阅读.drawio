          </mxGeometry>
        </mxCell>
        <mxCell id="paper_48_1_field_4" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：几何重定向能对齐手腕和指尖，却可能穿模、滑落或抓不稳。直接每任务重新强化学习又慢，已有动作跟踪能力难复用" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="830" as="geometry"/>
        </mxCell>
