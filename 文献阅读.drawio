        </UserObject><UserObject id="paper_83_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-82" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_83_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-84" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_83_1_field_1" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / Robotics: Science and Systems (RSS) 2024&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_1_branch_1" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_1_field_2" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：UMI把采集地点从机器人工作台扩展到家庭、办公室和餐馆：人直接拿带相机的夹爪示范，离线恢复动作，再训练机器人策略。它既不是从任意网络人类视频直接学动作，也不是完全无需标定的任意硬件迁移。关键是让手持采集和机器人部署具有接近的视觉、末端动作与时间接口（§III）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_1_branch_2" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="881.5" as="sourcePoint"/><mxPoint x="562" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_1_field_3" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：在日常场景用手持夹爪采集可部署示范&lt;br&gt;UMI 把机器人工作台上的采集带到野外，再处理轨迹坐标与执行延迟&lt;br&gt;为什么重要 / 旧方法的不足：它既不是从任意网络人类视频直接学动作，也不是完全无需标定的任意硬件迁移；关键是让手持采集和机器人部署具有接近的视觉、末端动作与时间接口" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_1_branch_3" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1461.0" as="sourcePoint"/><mxPoint x="562" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_2_field_1" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：ALOHA、GELLO获得真实从臂动作，几何约束清楚，却必须携带机器人；裸手视频地点多，但缺少可信动作标签，手和夹爪外观差异也大。手持工具是折中：保留便携性，同时用与机器人接近的夹爪接触物体。此前手持接口常只支持慢速抓放，因为单目尺度、追踪与延迟问题会阻断动态技能转移（§II）" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_2_branch_1" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_2_field_2" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_2_branch_2" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="997.0" as="sourcePoint"/><mxPoint x="1252" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_2_field_3" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：UMI不是另造策略模型，而是把视觉惯性SLAM、连续夹爪宽度、相对轨迹和部署延迟匹配接成一致数据管线，用Diffusion Policy表达多峰行为。其价值在于各模块共同满足动作可部署条件；只有一个便宜夹爪而没有这些接口，不等于完成UMI复现&lt;br&gt;&lt;br&gt;阅读要点与补充说明：视觉惯性定位：结合相机和惯性测量，推算手持设备在场景中的运动&lt;br&gt;ALOHA、GELLO获得真实从臂动作，几何约束清楚，却必须携带机器人；裸手视频地点多，但缺少可信动作标签，手和夹爪外观差异也大" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_2_branch_3" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1517.0" as="sourcePoint"/><mxPoint x="1252" y="1517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_3_field_1" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 一份视频包含观察和动作恢复所需信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;手持3D打印平行夹爪装软手指、GoPro和155°鱼眼镜头。大视野减少物体离开腕部视野的概率；两块侧镜形成隐式双目，网络输入前对镜内图像翻转并左右交换。部署在机器人上时保持相机相对指爪位置相同，让策略不必适应完全不同的手与机器人外观（p2–5，图2–4）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_3_branch_1" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_3_field_2" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 一份视频包含观察和动作恢复所需信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;GoPro的MP4同时保存RGB及IMU，ORB-SLAM3视觉惯性优化恢复公制尺度和快速运动轨迹；短暂视觉模糊时惯性信息可维持追踪，但长期无纹理仍会失败。夹爪上的标记连续估计开口宽度，软指形变提供隐式夹持调节，不是直接测量接触力。单夹爪780 g，打印机构BOM73美元、相机及附件298美元，共371美元；这不含部署机器人和工业夹爪（p5）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_3_branch_2" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="794.0" as="sourcePoint"/><mxPoint x="1942" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_3_field_3" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 相对轨迹与双臂同步&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 相对轨迹与双臂同步：采集新场景先建图，再将各示范、各夹爪定位到共享地图。动作块中的每个未来SE(3)目标都相对本次推理的当前末端，而非相对前一步动作；后者是会累积误差的delta表示。历史末端轨迹也用相对表示，双臂额外输入两夹爪相对位姿，才能在两腕相机视野重叠少时协调同时抓取（p6，图6）&lt;br&gt;&lt;br&gt;2. 相对轨迹与双臂同步：这降低对机器人基座世界坐标精确标定的依赖，但仍需相机／IMU内参、传感器时间关系、末端安装及目标机器人运动学。手持工具能做出的动作未必机器人能做；作者根据已知基座与运动学过滤不可行轨迹，不能把采集自由度当成机械臂已具备的可执行范围" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_3_branch_3" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1373.5" as="sourcePoint"/><mxPoint x="1942" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_3_field_4" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 延迟匹配是部署接口的一部分&lt;/b&gt;&lt;br&gt;&lt;br&gt;观察流分别测真实延迟，以最慢流通常为图像的捕获时间为基准，对臂位姿、夹爪宽度插值；双腕相机软同步。输出动作有目标时间戳，分别按臂与夹爪执行延迟提前发送，删除已因采集、推理和执行等待而过期的动作。图5的100 ms臂／120 ms夹爪为该图系统示意，不能转写成所有平台固定值（p5–6、附录A）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_3_branch_4" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1935.5" as="sourcePoint"/><mxPoint x="1942" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_3_field_5" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 延迟匹配是部署接口的一部分&lt;/b&gt;&lt;br&gt;&lt;br&gt;“同步腕部RGB＋相对末端历史＋宽度／双夹爪关系→Diffusion Policy→未来相对末端与宽度轨迹→各硬件定时执行”是完整管线。论文通常用10–20 Hz策略观察，不能与臂底层125 Hz或相机录制帧率混称同一种控制频率。这里没有远端操作者视觉回传环节，因为人直接拿工具接触现场" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_3_branch_5" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2392.5" as="sourcePoint"/><mxPoint x="1942" y="2392.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_4_field_1" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;能力测试与明确计数 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;能力测试与明确计数 / 表中逐项记录：任务／设置：Cup Arrangement；数据量：305条；结果与对照：UR5 20/20；同checkpoint迁移Franka 18/20&lt;br&gt;&lt;br&gt;能力测试与明确计数 / 表中逐项记录：任务／设置：Dynamic Tossing；数据量：280条；结果与对照：105/120个物体=87.5%；去延迟匹配69/120=57.5%&lt;br&gt;&lt;br&gt;能力测试与明确计数 / 表中逐项记录：任务／设置：双臂折衣；数据量：250条；结果与对照：14/20=70%；去相对夹爪状态6/20=30%" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_4_branch_1" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_4_field_2" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;能力测试与明确计数 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;能力测试与明确计数 / 表中逐项记录：任务／设置：Dish Washing；数据量：258条；结果与对照：ViT组14/20=70%；ResNet对照0/10&lt;br&gt;&lt;br&gt;能力测试与明确计数：杯子任务要求杯直立放在碟上且把手角度在目标±15°。Franka两次失败为关节限位，支持共享末端接口的可迁移性，同时暴露基座布局边界。投掷按120个物体统计，不能写成120个完整任务回合；洗碗包括恢复额外污渍的明确示范，不能推导为无需恢复数据的通用纠错（p7–10，图7–8）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_4_branch_2" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1056.5" as="sourcePoint"/><mxPoint x="2632" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_4_field_3" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;能力测试与明确计数&lt;/b&gt;&lt;br&gt;&lt;br&gt;杯子消融中去鱼眼为11/20；绝对动作5/20、delta16/20。侧镜未经正确图像变换只有17/20，去镜18/20，正确处理后20/20，表明增加视觉信息本身也可能制造表征困难。绝对动作差还受SLAM到基座标定误差影响，不能证明所有场景中绝对动作天然劣于相对动作（p7–8）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_4_branch_3" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1566.0" as="sourcePoint"/><mxPoint x="2632" y="1566.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_4_field_4" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;野外泛化与采集效率&lt;/b&gt;&lt;br&gt;&lt;br&gt;三位示范者12人时采集30地点、15种杯子的1400条示范，ViT-L/14策略在两个未见环境合计43/60=71.7%，其中见过杯28/40、未见杯15/20；只用单实验室数据、同预训练骨干的对照为0%。结论支持多样场景数据的必要性，不等于对任何新物体零样本通用（p9–10，图9）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_4_branch_4" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1988.0" as="sourcePoint"/><mxPoint x="2632" y="1988.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_4_field_5" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;野外泛化与采集效率&lt;/b&gt;&lt;br&gt;&lt;br&gt;吞吐实验包含重置和机器人故障耗时，杯子为UMI111条/小时、SpaceMouse35、裸手231；动态投掷149、0、237。MoCap基准的单夹爪轨迹均值误差6.1 mm／3.5°，双夹爪相对位姿10.1 mm／0.8°；“小于1 cm”不能无条件覆盖双夹爪平移误差（p11，图11–12）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_4_branch_5" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2410.0" as="sourcePoint"/><mxPoint x="2632" y="2410.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_5_field_1" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：采集时不知道下游机器人限位，只能事后筛轨迹；SLAM依赖纹理；夹爪笨重且自由度少，效率仍不如裸手。未来应改进可行性学习、无纹理恢复及设备人体工学（§VIII）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_5_branch_1" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_83_5_field_2" parent="paper_83" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的理解：本项目可先用D435i录离线RGB-D，研究统一时间戳、相对轨迹与质量过滤，但它不能直接替换GoPro鱼眼／IMU后继承UMI结果。DH116为欠驱动多指手，不等同80 mm平行夹爪，需要新的接触与手指动作接口；先离线检查三指重定向、耦合和工作空间，多轴动作仍未验收。完整复现另需手持机构、镜头侧镜、相机同步、目标臂、兼容夹爪与计算资源；371美元只对应采集端单工具" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_83_5_branch_2" edge="1" parent="paper_83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
