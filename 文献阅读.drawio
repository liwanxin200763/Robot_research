        <mxCell id="paper_107_code" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;03_双臂协作\&lt;br&gt;DemoBot - Efficient Learning of Bima&lt;br&gt;nual Manipulation with Dexterous Ha&lt;br&gt;nds From Third-Person Human Video&lt;br&gt;s.md&lt;br&gt;&lt;br&gt;开源信息：沿用本地卡的代码与授权记录，未补猜开放状态" vertex="1">
