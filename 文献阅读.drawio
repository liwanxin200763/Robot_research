        <mxCell id="paper_37_3_header" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="C. 核心贡献与方法" vertex="1">
          <mxGeometry height="58" width="390" x="1177" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_field_rail" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="88" as="sourcePoint"/>
            <mxPoint x="1187" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="220" as="sourcePoint"/>
            <mxPoint x="1199" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 1：搭建可移动的 Franka 机械臂采集平台，配统一相机和遥操作接口。不同采集者遵循共同流程，降低跨地点数据无法对齐的风险" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="460" as="sourcePoint"/>
            <mxPoint x="1199" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_3_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 2：收集564个场景、86类任务、52栋建筑的76,000条成功操作，约350小时；另有约16k未成功操作随数据发布。每条带任务文字与结果标记，可按目标选择训练数据" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_branch_3" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="700" as="sourcePoint"/>
            <mxPoint x="1199" y="700" as="targetPoint"/>
