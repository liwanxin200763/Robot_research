        <mxCell id="paper_53_1_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：三维空间表示与 VLA（视觉—语言—动作模型：用图像与指令生成动作） 动作编码。输入仍是图像和文字，用估计深度恢复相机坐标中的三维位置，再把运动方向和距离编码为动作符号" vertex="1">
