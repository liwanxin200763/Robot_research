            <mxPoint x="2620" y="108" as="sourcePoint"/><mxPoint x="2620" y="2502" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_130_5_drop" edge="1" parent="paper_130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
