        <UserObject id="category_04_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="80" y="42" width="290" height="60" as="geometry"/>
          </mxCell>
        </UserObject>
        <mxCell id="category_04_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="04 执行误差与失败恢复">
          <mxGeometry x="100" y="150" width="2000" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="category_04_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#24435A;align=left;verticalAlign=top;spacing=24;" value="这个方向在研究什么：执行误差与失败恢复&lt;br&gt;任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;知识链条：发现偏差 → 判断原因 → 选择纠正或回退 → 验证恢复 → 继续任务&lt;br&gt;共 16 篇 · 点击下方卡片进入独立论文页，再按本类编号顺序浏览">
          <mxGeometry x="100" y="280" width="2000" height="330" as="geometry"/>
        </mxCell>
        <UserObject id="category_04_paper_05" label="#5 Taming VLAs under Robot Execution Errors&lt;br&gt;要解决：手臂实际走的距离与命令不同，又没有任务奖励时，能否用这个差别改进后续动作？&lt;br&gt;年份 / Venue：2026；arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-05" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
