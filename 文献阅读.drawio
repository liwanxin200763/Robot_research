        </UserObject><UserObject id="paper_109_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-108" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_109_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-110" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_109_1_field_1" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待核验；来源为 Google Scholar，未经人工查看不填写数字（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量&lt;br&gt;数据链条位置：以物体为中心重建四维手部示范" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_1_branch_1" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_1_field_2" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;GitHub / 开源程度：见本卡“来源与核验边界”；未核实不视为代码已完整开放&lt;br&gt;版本查询与全文核验日期：2026-10-15&lt;br&gt;&lt;br&gt;研究方向与快速摘要：本篇研究人类视频怎样生成可用于机器人策略后训练的动作标签，主线是物体中心的手物重建，而不是完全替代真机示范或训练一个通用失败恢复系统" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_1_branch_2" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="916.5" as="sourcePoint"/><mxPoint x="562" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_1_field_3" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：Object-centric（物体中心）以物体的形状、位置、朝向和运动作为参照；4D 重建是随时间变化的三维形状与位姿恢复；Retargeting（动作重定向）把人的手形与运动转换为目标机器人能够执行的动作，同时尽量保留操作效果&lt;br&gt;&lt;br&gt;研究方向与快速摘要：只恢复手腕轨迹不够：手看似在杯子旁边，实际上可能没有碰到杯壁，或者手指穿入物体，这样的标签会教机器人抓空或穿模。作者先修好物体轨迹，再用物体约束手的全局运动和手指配置，最终补充少量真机数据进行 π0.5 后训练（§1、§3，图 1–2）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_1_branch_3" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1601.0" as="sourcePoint"/><mxPoint x="562" y="1601.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_1_field_4" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入及以前方法的不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;实际输入是 RGB-D 视频及相机内参，不能写成任意纯 RGB 单目视频。手遮挡物体、对称物体多解、单帧姿态估计跳变，都会使手的接触优化跟着错误物体跑；仅压低穿透体积也可能把手推到不符合图像的位置（§3，附录 D.3）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1931" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_1_branch_4" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2121.0" as="sourcePoint"/><mxPoint x="562" y="2121.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_2_field_1" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作：WiLoR 等手模型先估计 MANO 参数化手网格，它们可提供手指与手腕初始化，但不以操纵物体的接触为主要约束。FoundationPose 给定物体网格和 RGB-D 估计位姿，本篇保留每帧多个候选，再做全序列选择，改变的是追踪稳定性而非重新设计网格生成器（§2–3）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_2_branch_1" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_2_field_2" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：MagicHOI 的手优化模块和 Do as I Do用于实验比较；后者的动力学优化输出还需由 Sharpa 适配到本文 xHand。比较中保持目标手重定向和坐标变换一致，不能把对照结果理解为原版方法在所有平台的成绩（表 3–4、附录 F）&lt;br&gt;&lt;br&gt;相关工作：DexUMI通过示教接口减少人手和机器人差异；DexMimicGen从源机器人示范变换轨迹。它们可作为数据成本路线对照，不是本文继承的物体追踪算法" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_2_branch_2" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1039.0" as="sourcePoint"/><mxPoint x="1252" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_3_field_1" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 保留物体多解，再选择整条轨迹&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉语言模型先把长视频分成操作片段，给出任务及物体描述；Rex-Omni 定位物体，SAM3 传播掩膜；MapAnything 估计相机外参，SAM 3D 提供物体网格（§3.1–3.2）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_3_branch_1" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_3_field_2" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 保留物体多解，再选择整条轨迹&lt;/b&gt;&lt;br&gt;&lt;br&gt;对每帧 FoundationPose 候选，不只取分数最高者：先归一化 ScoreNet 分数，再乘上渲染轮廓与实际掩膜的重合率。相邻候选间加入平移、旋转变化成本，把 T 帧、每帧 N 候选形成分层图，用 Viterbi 动态规划找全局最优路径，复杂度 O(TN²)。遮挡帧的图像证据弱时，时间连续性相对更有作用，但若所有候选都错，此选择也不会凭空恢复真值（§3.2，式 1–5）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_3_branch_2" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="780.0" as="sourcePoint"/><mxPoint x="1942" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_3_field_3" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 先对齐观察，再稳定接触&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 先对齐观察，再稳定接触：WiLoR 给出手网格初始化，深度协助尺度对齐。作者固定恢复后的物体几何与轨迹，按物体运动、手物距离区分抓取和交互阶段；抓取阶段先强调手轮廓与图像匹配，避免一开始就施加强接触约束把手拉错（§3.3）&lt;br&gt;&lt;br&gt;2. 先对齐观察，再稳定接触：交互阶段从手的接触候选向图像投影，再沿相机射线找到物体表面对应点。除单帧距离损失，还把接触点换到物体坐标系，在相邻帧保持相同局部接触区域；物体在移动，手指应跟着该区域走，而不是在世界坐标中固定不动。穿透惩罚、运动平滑和偏离初始估计的正则项共同约束优化（式 7–9）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_3_branch_3" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1359.5" as="sourcePoint"/><mxPoint x="1942" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_3_field_4" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 重定向后与真实数据混合&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 重定向后与真实数据混合：GeoRT 将优化后的 MANO 手形转为 xHand 关节配置；相机外参把手腕轨迹映到世界坐标，再利用人类与机器人示范的代表性初始物体位姿估计世界到机器人变换。输出与视频逐帧配对的机器人动作标签，而不是只提供漂亮的重建动画（§3.4）&lt;br&gt;&lt;br&gt;3. 重定向后与真实数据混合：实际动作是机械臂 3 维平移、3 维轴角旋转及 xHand 的 12 维关节，共 18 维相对偏移。π0.5 后训练 30,000 步，混合样本按人类∶机器人 = 1∶1 采样；这不等于各来源示范数量相同，也不是完全无真机数据训练（附录 F）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="1707" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_3_branch_4" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2009.0" as="sourcePoint"/><mxPoint x="1942" y="2009.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_3_field_5" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 重定向后与真实数据混合&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整流程：RGB-D 与相机内参 → 任务分段和物体定位 → 网格与多候选物体轨迹 → 全局路径选择 → 图像及物体局部接触约束优化手 → GeoRT 与坐标转换 → 视频—动作标签 → 混合真机示范后训练 → 真实动作执行" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="2339" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_3_branch_5" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2529.0" as="sourcePoint"/><mxPoint x="1942" y="2529.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_4_field_1" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;重建指标与对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;重建指标与对照：DexYCB 选 1000 段做物体评测，其中 120 段做手评测；HO3D-v3 选 12 段。表 1 的物体平移误差从 FoundationPose 的 6.80 cm 降为 3.44 cm，旋转误差 27.14°→18.47°；这些是轨迹估计误差，不能当机器人任务成功率&lt;br&gt;&lt;br&gt;重建指标与对照：表 2 的手腕轨迹误差 MRPE 在 DexYCB 为 97.31→38.49 mm，平均穿透体积 2.57→1.07 cm³；HO3D 的相对手关节误差却从 4.22→4.40 mm，说明各重建指标并非全部提高（指标单位见附录 C）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_4_branch_1" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_4_field_2" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机后训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机后训练：Franka + xHand 用同一固定侧视相机采人类和真机示范，测试放花瓶、开盒、插吐司三任务。每配置每任务 20 次，初始物体位置在训练分布中随机采样，以整任务完成判成功，三任务均值等权（§4.2、附录 F）&lt;br&gt;&lt;br&gt;真机后训练 / 表中逐项记录：每任务训练数据与处理：20 条真机；放花瓶：45%；开盒：60%；插吐司：40%；平均任务成功率：48.3%&lt;br&gt;&lt;br&gt;真机后训练 / 表中逐项记录：每任务训练数据与处理：同样 20 真机 + 100 人类，WiLoR；放花瓶：25%；开盒：20%；插吐司：10%；平均任务成功率：18.3%" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_4_branch_2" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1056.5" as="sourcePoint"/><mxPoint x="2632" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_4_field_3" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机后训练 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机后训练 / 表中逐项记录：每任务训练数据与处理：同样数据，MagicHOI；放花瓶：40%；开盒：25%；插吐司：15%；平均任务成功率：26.7%&lt;br&gt;&lt;br&gt;真机后训练 / 表中逐项记录：每任务训练数据与处理：同样数据，Hand2Robot；放花瓶：80%；开盒：85%；插吐司：75%；平均任务成功率：80.0%&lt;br&gt;&lt;br&gt;真机后训练：相比 20 条真机均值增加 31.7 个百分点；60 条纯真机为 81.7%，接近混合组的 80.0%，但仅 100 条人类为 8.3%。这证明的是本设置下补充数据有用，不能宣称无需真机示范或已验证跨新场景普适迁移（表 3–4）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_4_branch_3" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1723.5" as="sourcePoint"/><mxPoint x="2632" y="1723.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_4_field_4" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融的意义&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录表 7 去掉二维对齐后，穿透体积虽更低，手腕误差却 38.49→113.17 mm，运动急变指标 2.49→9.93 mm/s³；去掉时间接触约束，急变指标为 3.19。接触优化需要图像锚点，否则“少穿模”并不等于“动作正确”" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2071" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_4_branch_4" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2261.0" as="sourcePoint"/><mxPoint x="2632" y="2261.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_5_field_1" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者边界：当前实验证据集中在指定平台、同一侧视设置、三项任务及有限预算；正文未提供单独的全面局限段，因此不把以下分析写成作者明确承认的缺陷&lt;br&gt;&lt;br&gt;不足与未来：我的理解：物体路径是手优化的固定参照，几何和姿态误差仍会向接触传递；只跟随成功示范并未解决掉落后的重新抓取。图像可见接触不保证真实摩擦或握力合适，重建误差降低和真机安全仍需分别衡量" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_5_branch_1" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_5_field_2" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116 / D435i 可复用：D435i 可提供 RGB-D，但需同步、内参、手眼／世界坐标标定和可靠深度掩膜；可先做“物体多候选追踪＋手指局部接触稳定”的小规模重建对照，再接 DH116 运动学模型与驱动命令。xHand 的 12 维指令不能直接改名作为 DH116 指令" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_5_branch_2" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="864.0" as="sourcePoint"/><mxPoint x="3322" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_109_5_field_3" parent="paper_109" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;资源与未来实验：作者用 RTX 4090 做手轨迹优化（附录 A.3），π0.5 后训练的完整硬件预算本卡未核实。优先分别测重建误差、DH116 指令可达性、真实抓取成功，再决定是否做大模型训练；主动重观测、滑落检测和失败恢复属于后续研究设计" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_109_5_branch_3" edge="1" parent="paper_109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1286.0" as="sourcePoint"/><mxPoint x="3322" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
