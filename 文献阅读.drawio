            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_36_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#36 HumanoidGen">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_36_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="01 数据生成与数据质量  ·  本类第 7 / 21 篇  ·  问题：普通机械臂示范已较多，但左右手协作抓握、倒水、整理的示范很少。能否在仿真中自动建立任务和成功示范，减少人工双手遥操作？&lt;br&gt;方法流程：标注物体/手关键点 → 给出任务 → 语言模型生成约束链 → 运动优化与仿真检查 → 搜索修正规划 → 保留示范 → 训练双手策略">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
