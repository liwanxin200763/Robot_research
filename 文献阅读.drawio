        </UserObject><UserObject id="paper_82_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-81" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_82_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-83" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_82_1_field_1" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CoRL 2024; PMLR 270 (published 2025)&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_1_branch_1" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_1_field_2" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：ACE把“腕在哪里”和“手指怎么弯”交给不同传感器：低成本外骨骼用编码器与正向运动学测腕，始终面向手掌的相机估手形，再重定向到不同机器人。它希望兼顾同构主端的稳定性和视觉方案的跨平台能力。跨平台是采集／映射系统可适配多种本体，不代表一个权重在所有平台直接执行（图2、§3）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_1_branch_2" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="881.5" as="sourcePoint"/><mxPoint x="562" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_1_field_3" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：外骨骼腕追踪加视觉手形估计的跨平台采集&lt;br&gt;ACE 分开测量腕位姿与手指姿态，尝试降低双臂灵巧操作的采集成本&lt;br&gt;为什么重要 / 旧方法的不足：它希望兼顾同构主端的稳定性和视觉方案的跨平台能力；跨平台是采集／映射系统可适配多种本体，不代表一个权重在所有平台直接执行" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_1_branch_3" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1443.5" as="sourcePoint"/><mxPoint x="562" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_2_field_1" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_2_branch_1" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_2_field_2" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角&lt;br&gt;FK：正向运动学，根据关节角计算末端或指尖位置" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_2_branch_2" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_2_field_3" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALOHA和GELLO按同构关节复制，几何清楚但每种目标臂要配对应主端；比例缩小后，手端小移动可能变成大臂位移。纯视觉AnyTeleop容易受到腕部尺度、世界位置与遮挡误差影响；DexCap用更丰富跟踪器提高动作观测，但设备价格和链路复杂度不同。ACE固定相机相对手的位置，外骨骼独立给腕位姿，减少这两类误差相互干扰（§2）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_2_branch_3" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_2_field_4" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;由腕位姿求目标臂IK，让设备不必复制目标臂拓扑；手形仍需依赖目标手模型做几何优化。此路线在“同构复制”与“只靠视觉”之间提供工程折中，但把难点转移到工作空间映射、IK及多指重定向，不能把600美元设备等同完整机器人系统（p2，表1）" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_2_branch_4" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1610.0" as="sourcePoint"/><mxPoint x="1252" y="1610.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_2_field_5" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;正向运动学：根据外骨骼关节角计算人手腕在空间中的位置和朝向&lt;br&gt;ALOHA和GELLO按同构关节复制，几何清楚但每种目标臂要配对应主端；比例缩小后，手端小移动可能变成大臂位移&lt;br&gt;ACE 根据外骨骼测到的腕部位置与朝向，使用逆运动学求目标机器人关节角，因此主端不必与目标臂有同样关节结构；但目标机器人仍需自己的关节限位和运动控制配置" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1835" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_2_branch_5" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2084.5" as="sourcePoint"/><mxPoint x="1252" y="2084.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_3_field_1" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 双底座、机械腕追踪与掌前相机&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂外骨骼每侧6自由度、七连杆，DYNAMIXEL XL330-M288-T提供12-bit角读数，经U2D2读取；相机架可二轴调整，使低成本RGB相机朝向掌面。桌面底座稳定且可托肘，移动底座可背负。磁连接便于独立穿戴和调整腕圈／连杆长度，作者报告桌面穿戴小于30秒（p4–5，图3）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_3_branch_1" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_3_field_2" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 双底座、机械腕追踪与掌前相机&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 双底座、机械腕追踪与掌前相机：编码器角经FK算腕，MediaPipe从相机图像得到腕坐标中的21手关键点。相机跟随手腕降低全局遮挡，但手指相互遮挡及模型误差仍可能存在；外骨骼本身测不到指尖接触力，也没有从机器人向人体的主动触觉反馈。表1约0.6k美元是采集接口报价，未包含被控臂、灵巧手和训练算力&lt;br&gt;&lt;br&gt;2. 工作空间与动作尺度分别映射：先让操作者移动手臂测人工作空间中心ch，再指定机器人任务中心ct和比例γ，位置按xe=γ(xh−ch)+ct映射。附录算法从三轴活动范围求中心与半径，再限制映射点留在机器人工作球内；旋转按各轴范围缩放。这里的中心／比例需显式采集和配置，不能称无需标定（式1、p14–15）" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_3_branch_2" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="899.0" as="sourcePoint"/><mxPoint x="1942" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_3_field_3" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 工作空间与动作尺度分别映射&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normal Mode按工作区比例直映；Mirror Mode用于面对面控制大机器人；Bimanual Mode调整两侧中心与比例，让相机架将接近碰撞时机器人双手恰好接触。后者改变了人手与机器人距离关系，是处理设备几何冲突的取舍，不是让穿戴设备真的能自由交叉（p6）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_3_branch_3" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1461.0" as="sourcePoint"/><mxPoint x="1942" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_3_field_4" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 臂、夹爪与手采用不同求解器&lt;/b&gt;&lt;br&gt;&lt;br&gt;映射腕目标后，IK转换为目标臂关节；平台仍需各自PID、滤波与奇异点／运动限制。夹爪模式把拇指—食指距离线性映到0–1；灵巧手模式最小化人和机器人关键点向量差，加相邻关节变化惩罚，并约束ql≤q≤qu。α补偿手尺寸，β控制时间平滑，不能把关键点等同各机器人关节的角度真值（p16，式2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_3_branch_4" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1900.5" as="sourcePoint"/><mxPoint x="1942" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_3_field_5" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 臂、夹爪与手采用不同求解器&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前手姿追踪约27 Hz；论文说换高频相机可进一步到100 Hz，应区分实测系统与可改进目标。全文没有清楚给每平台完整端到端延迟分布，不用27 Hz倒算延迟。该系统主要依赖现场观察；没有把沉浸式双目远程回传作为核心模块（§3.2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2143" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_3_branch_5" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2340.0" as="sourcePoint"/><mxPoint x="1942" y="2340.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_3_field_6" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 从采集到两类模仿策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;xArm＋Ability Hand使用3D Diffusion Policy，输入两相机视角独立采样的点云和本体状态，输出腕与手目标；H1＋Inspire使用ACT，输入头顶RGB。采集动作、图像／点云和状态需对齐，但正文未充分交代各流时间戳及存储频率，复现应单独核仓库，而不补猜。不同平台训练不同策略，跨设备演示不构成策略零样本迁移（§4.2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_3_branch_6" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2779.5" as="sourcePoint"/><mxPoint x="1942" y="2779.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_4_field_1" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;精度与模拟到达实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;精度与模拟到达实验：作者报告外骨骼FK平均约1 mm，拉卷尺20→40 cm的臂端综合平均误差约3 mm，后者含遥操作及从臂控制误差；这些不是所有姿态、全部手指的定位保证（p7，图5）&lt;br&gt;&lt;br&gt;精度与模拟到达实验：六名操作者在仿真xArm中用双末端到达目标球，对比GELLO；测试四组工作空间与目标尺寸。小工作区／小目标下ACE 4.69秒、97.1%成功，GELLO13.6秒、47.6%；中工作区／小目标4.54秒、91.4%，对照6.52秒、73.8%（p8，表2）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_4_branch_1" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_4_field_2" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;精度与模拟到达实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;精度与模拟到达实验：不能复述成所有设置全面更好：中工作区／中目标时GELLO3.65秒、93.8%，ACE4.05秒、87.5%，有效路径比也为75%对67.1%，是GELLO占优。表2主张“多数场景”更合理；这些结果是仿真到达效率，不是接触丰富真机任务成功率（附录C）&lt;br&gt;&lt;br&gt;模仿学习与示范质量 / 表中逐项记录：平台／任务：xArm Vacuum Keyboard；采集成功／尝试：30/38；最后阶段策略成功率：50%&lt;br&gt;&lt;br&gt;模仿学习与示范质量 / 表中逐项记录：平台／任务：xArm Serve Candies；采集成功／尝试：45/53；最后阶段策略成功率：40%" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_4_branch_2" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_4_field_3" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;模仿学习与示范质量 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;模仿学习与示范质量 / 表中逐项记录：平台／任务：xArm Wipe Whiteboard；采集成功／尝试：30/37；最后阶段策略成功率：70%&lt;br&gt;&lt;br&gt;模仿学习与示范质量 / 表中逐项记录：平台／任务：xArm Grasp Dolls；采集成功／尝试：120/123；最后阶段策略成功率：80%&lt;br&gt;&lt;br&gt;模仿学习与示范质量 / 表中逐项记录：平台／任务：H1 Put in Tennis；采集成功／尝试：25/29；最后阶段策略成功率：90%&lt;br&gt;&lt;br&gt;模仿学习与示范质量 / 表中逐项记录：平台／任务：H1 Grasp Dolls；采集成功／尝试：62/66；最后阶段策略成功率：90%" vertex="1">
          <mxGeometry height="744" width="628" x="2632" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_4_branch_3" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1811.0" as="sourcePoint"/><mxPoint x="2632" y="1811.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_4_field_4" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;模仿学习与示范质量&lt;/b&gt;&lt;br&gt;&lt;br&gt;模仿学习与示范质量：每项策略只评估10个episode；采集成功率高不能替换训练后成功率。长程任务吸尘从抓取100%到最终放回50%，倒糖从抓取90%到最终丢筒40%，反映下游误差累积仍明显。正文说“六个任务”含同名Grasp Dolls的两个平台，宜写六个任务—平台设置（p14，表3）&lt;br&gt;&lt;br&gt;模仿学习与示范质量：抓娃娃训练9种小娃娃、2种大娃娃，测试15种小、3种大，并变化机器人位置，提供一定物体泛化证据；没有与相同训练协议下其他遥操作数据做充分对照。多平台操作视频是能力展示，不能替代每平台重复试验（图4、6）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="2211" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_4_branch_4" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2530.5" as="sourcePoint"/><mxPoint x="2632" y="2530.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_5_field_1" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：相机架阻碍双手靠拢，并因额外力臂增加腕部旋转负担；缩放控制虽缓解功能限制，部分操作仍不直观（§5）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_5_branch_1" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_5_field_2" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的理解：对DH116可先复用“腕追踪和手形分开、受限向量优化、时间平滑”的离线模块。其6主动轴、11总自由度需正确耦合，先评估拇指／食指／中指指尖误差与捏合范围；当前多轴与臂手运动未验收，不把论文兼容性当本项目控制通过。D435i可提供训练点云，但掌前相机的视角和遮挡条件需要重做评估" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_5_branch_2" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="762.5" as="sourcePoint"/><mxPoint x="3322" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_82_5_field_3" parent="paper_82" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：最小方案是离线关键点、工作空间标定和日志质量检查；完整硬件还需两侧编码器外骨骼、底座、掌前相机、目标臂与手及训练设备。优先比较桌面固定与外部视觉腕追踪误差，再判断是否值得制作背负式完整装置&lt;br&gt;&lt;br&gt;阅读要点与补充说明：可先离线测量外骨骼腕部位置、摄像头手指关键点与目标机器人工作区之间的误差，再记录丢帧和关节饱和。全套双臂硬件及其安全控制另需搭建" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_82_5_branch_3" edge="1" parent="paper_82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1254.5" as="sourcePoint"/><mxPoint x="3322" y="1254.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-83" name="08-09 UMI">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
