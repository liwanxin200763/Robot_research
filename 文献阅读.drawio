            <mxPoint x="550" y="864.0" as="sourcePoint"/><mxPoint x="562" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_1_field_3" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景与核心问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人动作数据少，互联网人类视频多，但人手与机器人关节完全不同。本文选择双方都能握持或安装的已知工具，把跨形态问题转为工具轨迹：先让视频模型想象人在新场景里使用工具，再跟踪工具三维运动，机器人执行同一工具位姿。这种接口适合刚性工具操作与视觉泛化，但并不直接学习DH116手内操作或接触力控制。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_1_branch_3" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1338.5" as="sourcePoint"/><mxPoint x="562" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_2_field_1" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与行为克隆、视频世界模型的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;标准行为克隆用图像对应机器人动作训练，从输入直接回归或扩散生成控制。Dreamitate的中间输出是一段人类工具操作视频，由预训练视频先验补足新物体、新背景的常识，然后通过已知CAD模型跟踪动作。视频不是拿来对候选机器人动作做前向仿真打分，也不是先生成目标图再让另一个学习控制器靠近；它本身就是工具运动计划的来源。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_2_branch_1" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_2_field_2" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;工具作为具身接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;六维位姿包含工具三维位置与旋转，处于SE(3)空间。知道工具CAD形状、相机标定后，就能从图像估计工具姿态，再用逆运动学把工具轨迹变成机械臂轨迹。人手如何弯曲无需直接映射成机器人手指动作，这降低数据采集成本，同时把适用范围限定于可视、刚性、能跟踪的工具。" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_2_branch_2" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="829.0" as="sourcePoint"/><mxPoint x="1252" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_3_field_1" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：人类示范与双视角&lt;/b&gt;&lt;br&gt;&lt;br&gt;两台标定后的Intel RealSense D435i以约45°夹角、约660mm间距观察桌面，距桌面约760mm，拍摄人在不同物体条件下使用3D打印工具。示范不需要遥操作机器人，也无需关节动作真值。每项任务单独收集和训练；第一帧是场景，后续出现人和工具。双视角用于减少深度歧义，采集和部署保留相同相机布置。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_3_branch_1" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_3_field_2" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：微调视频生成器&lt;/b&gt;&lt;br&gt;&lt;br&gt;以Stable Video Diffusion预训练权重初始化，只微调空间/时间注意力，冻结编码器解码器。模型一次输出25帧，前13帧对应视角一、后12帧对应视角二；根据各输出帧视角修改其图像条件嵌入，首帧固定为输入并在测试丢弃，形成12对双目生成帧。每个任务独立模型，无统一文本条件任务选择，Push-Shape额外把目标掩码叠加到输入。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_3_branch_2" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="811.5" as="sourcePoint"/><mxPoint x="1942" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_3_field_3" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：在新场景想象操作&lt;/b&gt;&lt;br&gt;&lt;br&gt;测试只给新场景双目初始图，模型生成预期的人类工具操作视频。生成的轨迹可让人提前看到机器人打算如何移动，但像素合理不保证真实物理可行。模型保留互联网视频预训练带来的物体外观与行为先验，专门任务微调则确定需要执行的动作。该结构不依赖逐帧真实机器人反馈修正生成，因此主要属于短段开环计划执行。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_3_branch_3" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1268.5" as="sourcePoint"/><mxPoint x="1942" y="1268.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_3_field_4" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：工具跟踪与双目融合&lt;/b&gt;&lt;br&gt;&lt;br&gt;MegaPose结合已知CAD模型在每幅生成图上估计工具六维姿态。初始工具框通过背景减除与肤色去手获得，少数失败样本由人修正，本文和基线都采用这一处理。双相机中心射线在三维中求最近点中点确定平移，两视角旋转平均得到方向；舀取只跟踪勺柄避免颗粒遮挡，扫/推时跟踪不含被手挡住的柄的工具部分。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1511" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_3_branch_4" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1725.5" as="sourcePoint"/><mxPoint x="1942" y="1725.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_3_field_5" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：转成机器人动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;将工具安装到机械臂末端，跟踪的相机坐标轨迹经标定转换并由逆运动学执行，阻抗控制平滑轨迹。执行中接触由工具形状和动作产生，本文未学习精细力矩。基线也用同样人类视频和双目跟踪提取动作目标，分别训练DP、ACT、VQ-BeT预测12步轨迹、无段内重规划，以尽量统一开环设置。Push-Shape可多段连续推进，但其最佳轨迹统计另有选择口径。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1968" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_3_branch_5" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2200.0" as="sourcePoint"/><mxPoint x="1942" y="2200.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_3_field_6" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;几何恢复与控制的误差链&lt;/b&gt;&lt;br&gt;&lt;br&gt;MegaPose单视角估姿给出工具大致旋转和位置，双目融合主要修正深度；已知相机内外参把生成的二维位移变成可执行的尺度。跟踪只提取与执行相关的刚性工具部分，刻意避开被人手或颗粒遮挡的区域，表明该接口依赖明确对象设计。即使两幅视频都逼真，也可能在三维融合时冲突；姿态平滑只能减小跳变，不能保证生成计划的碰撞和受力可行。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2460" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_3_branch_6" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2692.0" as="sourcePoint"/><mxPoint x="1942" y="2692.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_4_field_1" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务、硬件与数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;四项真机任务：物体旋转371条示范、31训练物体，10未见物体测40次；舀颗粒368条、17碗/8颗粒类型训练，8新碗/4新颗粒测40次；扫桌面356条，训练与测试颗粒和干扰物分开，测40次；Push-Shape用26字母泡沫形状727条示范，测试8种新数字/多边形，共32试次。旋转和舀取用xArm7，扫与推用UR5；实验含多个机械臂工具协作，但不等于一般双臂手内操作。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_4_branch_1" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_4_field_2" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成功标准与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;旋转要求保持接触并逆时针转至少25°，本文37/40=92.5%，DP22/40=55%；舀取只要求任意颗粒进入空碗，本文34/40=85%、DP22/40；扫要求任意颗粒进入目标50mm内，本文37/40、DP5/40。较宽松的“任意颗粒”标准不能被改写成搬空所有颗粒。ACT和VQ-BeT这三项均更弱，但相机与工具跟踪辅助对所有方法相同。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_4_branch_2" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_4_field_3" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;长任务统计与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;Push-Shape报告每试次四条rollout中最佳结果，32试次下mIoU0.731、旋转误差8.0°；DP mIoU0.550，旋转44.1°的最佳基线为ACT而非DP（DP48.2°）。这不是随机单次执行成功率。旋转消融均40次：完整37/40、无视频预训练18/40、双目输入但只用单目输出跟踪30/40、单目输入输出14/40，支持预训练与几何融合价值。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_4_branch_3" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1303.5" as="sourcePoint"/><mxPoint x="2632" y="1303.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_4_field_4" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成本与失败证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录微调使用4张A100约40小时，768×448输入；推理30步去噪。A100上每段视频33.5秒、工具跟踪7.5秒，无法实时高频闭环。模型在透明袋等难形状上会选不稳接触点，小工具跟踪也困难；黑布桌面摩擦变化增加推形状不确定性。减少示范到1/3时旋转仍较稳定，但曲线不在正文提供完整精确数值，不补猜百分比。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_4_branch_4" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1760.5" as="sourcePoint"/><mxPoint x="2632" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_4_field_5" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基线公平性与任务难度补充&lt;/b&gt;&lt;br&gt;&lt;br&gt;基线动作标签不是机器人遥操作真值，而是由同一人类视频跟踪工具得到，DP使用双ResNet-18与384×224输入，ACT/VQ-BeT为768×448；作者报告提高DP分辨率未带来改善，扫粒任务还去掉其末端池化以保留小物体空间信息。因此提升不能简单解释为只给本文更高分辨率，但预训练规模和模型家族仍不同。扫任务含多种合理路线，基线可能平均成撞障碍的路径；这是作者观察，未给各失败原因的统一计数。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_4_branch_5" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2252.5" as="sourcePoint"/><mxPoint x="2632" y="2252.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_5_field_1" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;依赖可视跟踪工具、已知CAD和相机标定；模型按任务分别训练，缺乏文本条件去消除场景歧义；刚性工具和视频生成难以支持精细力控；小物体姿态估计、计算延迟限制实时操作。未来统一文本条件策略是作者方向，不能写成已有多任务语言控制。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_5_branch_1" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_5_field_2" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116与视觉接口分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;对DH116最可迁移的是把工具或物体位姿当作跨形态接口，而非要求人手关节逐一对应。若DH116握持工具，仍需另行学习或控制抓稳、滑移检测和手内调整，工具位姿计划不能替代这些动作。建议先选外观易跟踪的刚性工具，明确手—工具标定，再对遮挡、抓持偏移和跟踪失败分别记分。双目可帮助几何定位，但并不保证生成的两视图严格物理一致。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_5_branch_2" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="794.0" as="sourcePoint"/><mxPoint x="3322" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_5_field_3" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Sim2Real与后续验证分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文本身是人类真实视频到真实机械臂，不是仿真到真实；可与Sim2Real结合之处是用工具轨迹减少形态依赖，再让局部接触策略在仿真训练。应单独评估计划视频、姿态恢复和机器人执行三段误差，并以随机单次、含所有失败的指标补充最佳四次成绩。若要应对外界扰动，需要测试短段重规划与视觉触觉反馈带来的收益；这些是本笔记建议，尚非论文已证明。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_5_branch_3" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1286.0" as="sourcePoint"/><mxPoint x="3322" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_129_5_field_4" parent="paper_129" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对长程与闭环称谓的分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文“长程”主要体现在Push-Shape连续推移的多段任务，而一个生成片段只对应有限工具轨迹；实时扰动恢复不在其高延迟管线的已验证能力内。若后续改成每执行短段再拍照重生成，必须同时计算总等待时间、累计跟踪误差和人干预，不能沿用当前开环对照成绩宣称闭环收益。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_129_5_branch_4" edge="1" parent="paper_129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1743.0" as="sourcePoint"/><mxPoint x="3322" y="1743.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
