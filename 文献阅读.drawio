            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_33_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-47" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_33_1_field_1" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_1_branch_1" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_1_field_2" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;研究背景：双臂任务既有单臂分工，也有共同操作；单个共享动作头容易受到非活动手臂状态干扰。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：让一个 VLA 根据指令和视觉判断当前参与的手臂，并以相对独立的左右臂动作专家执行协调任务。（第 1 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_1_branch_2" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_1_field_3" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：单动作塔可能把另一臂无关状态混入动作生成；刚性指定参与手臂难适应不同任务阶段。（第 2 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：双臂角色分配与动作生成&lt;br&gt;判断该用左臂、右臂还是两臂&lt;br&gt;核心问题：任务指令不总说明用哪只手；&lt;br&gt;如何避免闲置手臂干扰？&lt;br&gt;单一双臂动作头容易让无关手臂乱动；&lt;br&gt;预设角色又不适应新任务" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_1_branch_3" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1464.5" as="sourcePoint"/><mxPoint x="562" y="1464.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_2_field_1" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;与已有工作的关系：相较 BiCICLe 的双代理顺序关键位姿，TAO-DA 是共享感知主干下双动作专家的端到端 VLA&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：单一双臂动作塔，&lt;br&gt;一起预测左右动作&lt;br&gt;相关方向 2：双塔专家，&lt;br&gt;左右臂各学自己的动作&lt;br&gt;代表对照：Single-Tower、Dual-Mask、Dual-Tower；&lt;br&gt;比较角色路由效果&lt;br&gt;区别：显式判断哪侧参与，&lt;br&gt;并按任务进度协调双臂" vertex="1">
          <mxGeometry height="779" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_2_branch_1" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="529.5" as="sourcePoint"/><mxPoint x="1252" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_2_field_2" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_2_branch_2" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1137.0" as="sourcePoint"/><mxPoint x="1252" y="1137.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_3_field_1" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;冻结共享视觉语言骨干，为左右臂建立独立 DiT 动作塔，并加入双臂意图路由和任务进度估计。（第 3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_3_branch_1" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_3_field_2" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eagle2.5-VL/SigLIP 特征共享，两个 flow-matching 动作塔分别预测左右臂动作；语言初始路由，再由视觉分类器调整活动手臂。GRU 加交叉注意力估计归一化轨迹时间作为进度。左右臂是独立 expert，不是两个可对话的 agent；没有显式通信、debate 或共享长期记忆。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_3_branch_2" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="762.5" as="sourcePoint"/><mxPoint x="1942" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_3_field_3" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：视觉、语言、双臂关节状态与任务上下文；进度目标来自轨迹时间，不能等同于语义目标完成或失败验证。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：左右动作塔分别生成连续动作并按路由执行；两个专家可服务同一双臂任务，但不是 leader 先向 follower 发消息。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：为左右臂动作分别建立监督，利用轨迹相对时间训练进度分支；论文未报告独立图像或状态增强贡献。（第 3–4 节）&lt;br&gt;&lt;br&gt;训练方式：视觉语言骨干冻结，双 DiT 塔以 flow matching 学习动作；路由器学习活动手臂类别，进度头学习轨迹时间。（第 3 节）" vertex="1">
          <mxGeometry height="744" width="628" x="1942" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_3_branch_3" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1377.0" as="sourcePoint"/><mxPoint x="1942" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_3_field_4" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：共享视觉语言编码，&lt;br&gt;左右臂各有独立动作塔&lt;br&gt;贡献 2：DAIR（手臂参与选择）先读指令中的左右线索，&lt;br&gt;隐含指令再靠图像判断&lt;br&gt;贡献 3：任务进度控制两塔同步，&lt;br&gt;避免不该动的一侧继续动作&lt;br&gt;流程：图像/指令→左/右/双臂路由&lt;br&gt;→两塔生成动作→按进度执行" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_3_branch_4" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2026.5" as="sourcePoint"/><mxPoint x="1942" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_4_field_1" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：AGIBOT G1 双臂真机 9,080 条遥操作轨迹，覆盖六类任务；每臂 7 自由度。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：比较 Single Tower、Dual-Mask、Dual-Tower 及 GR00T、π0.5，评估六项真机任务、路由准确率与非活动臂状态扰动。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：AGIBOT G1 双臂；Collaborative Tea 成功率 100%，Desktop Organization 95%。六台机器人餐厅系统 101 次完整任务成功率 92.08%，该系统结果不能单独归因于 VLA。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_4_branch_1" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_4_field_2" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：单臂任务平均 88.4%，GR00T 82.0%，π0.5 80.5%。非活动臂关节扰动下 Dual-Tower 两任务保持 100%/95%，Single Tower 降至 25%/20%。（第 4 节、结果表）&lt;br&gt;&lt;br&gt;消融实验：Single/Dual-Mask/Dual-Tower 比较支持分离动作塔对状态串扰的鲁棒性；路由类别准确率报告 85.37%/83.31%/96.13%，但没有充分隔离路由模块对最终成功率的因果贡献。（第 4 节）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_4_branch_2" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1039.0" as="sourcePoint"/><mxPoint x="2632" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_4_field_3" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;未报告“一臂失败，另一臂协助恢复”的系统实验；非活动臂状态扰动是输入噪声/干扰，不等于外部动态物体或真实执行失败。（第 4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_4_branch_3" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1524.0" as="sourcePoint"/><mxPoint x="2632" y="1524.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_4_field_4" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：AGIBOT G1 双臂；&lt;br&gt;9,080 条遥操作轨迹训练&lt;br&gt;对照：单塔、双塔及路由变体；&lt;br&gt;测桌面整理的三种手臂模式&lt;br&gt;结果：双塔在三模式为 100%/90%/95%；&lt;br&gt;单塔为 80%/50%/50%&lt;br&gt;补充：集成系统的餐厅任务 101 次中&lt;br&gt;成功率 92.08%，不能全归功于本模块" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_4_branch_4" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1991.5" as="sourcePoint"/><mxPoint x="2632" y="1991.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_5_field_1" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：静态随机化；非活动臂状态扰动不等于外部场景持续运动&lt;br&gt;&lt;br&gt;主要局限：论文中比较模型参数规模与训练配置并非完全匹配。按本库分析，进度是时间代理变量，不是任务成功核验；系统无失败原因通信、持久共享记忆或恢复选择&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可作双臂普通夹爪 VLA 的专家隔离与意图路由基线。若研究 DH116 加双臂共享 Failure Memory，需要另建语义进度验证及跨臂失败信息交换；本文尚无这些实验" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_5_branch_1" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_33_5_field_2" parent="paper_33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;阅读要点与补充说明：论文预印本篇幅较短；&lt;br&gt;跨物体、跨机器人和灵巧手验证有限&lt;br&gt;我的理解：进度多按时间比例估计，&lt;br&gt;真实失败可能使时间和完成度脱节&lt;br&gt;未来可改用视觉/触觉确认任务阶段，&lt;br&gt;并与恢复模块共享双臂状态&lt;br&gt;项目启发：给双臂 DH116 加显式角色路由；&lt;br&gt;先测闲置臂误动率和同步&lt;br&gt;&lt;br&gt;对自己的实验怎样落地：可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_33_5_branch_2" edge="1" parent="paper_33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1144.0" as="sourcePoint"/><mxPoint x="3322" y="1144.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
