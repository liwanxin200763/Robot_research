        </UserObject><UserObject id="paper_85_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-86" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3486" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_85_1_field_1" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2021 / CoRL 2021（PMLR 164 正式论文集出版于 2022）&lt;br&gt;引用量：待 Google Scholar 人工核验，不填写估计数量（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_1_branch_1" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_1_field_2" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_1_branch_2" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="752.0" as="sourcePoint"/><mxPoint x="562" y="752.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_1_field_3" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文研究离线人类示范为何“采得更多却未必学得更好”。操作员可能依赖历史、操作设备和策略看不到的信息；不同人的熟练度与解法也不一致。作者把这些因素和模型、输入、训练检查点选择一起控制比较，形成 robomimic 数据与算法基准，而非提出一个把所有示范自动判好坏的新分数。输入为机器人本体状态及物体真值或相机图像，输出末端相对动作和夹爪命令。五个仿真与三个真机任务表明历史信息、相机及超参数会显著改变成功率（§2–4）" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_1_branch_3" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1219.5" as="sourcePoint"/><mxPoint x="562" y="1219.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_1_field_4" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：对当前项目，它最有价值的是建立可审计的示范数据和合理比较协议。训练 loss 低不保证闭环成功，某个策略学得不好也不能单独证明采集数据普遍低质。论文观察局限于指定任务、算法和本体，不能推广为“离线强化学习永远不如模仿学习”&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：研究人类示范质量和训练设置怎样影响模仿学习&lt;br&gt;robomimic 用统一任务与算法比较不同操作者、历史观察、图像和检查点选择" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1497" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_1_branch_4" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1781.5" as="sourcePoint"/><mxPoint x="562" y="1781.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_2_field_1" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_2_branch_1" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_2_field_2" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;SAC：一种通过奖励学习连续动作的强化学习算法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_2_branch_2" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_2_field_3" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;BC（行为克隆）把观察到动作当监督学习；BCQ、CQL 则离线估值并限制分布外动作。既有离线 RL 基准常用训练过程中的机器策略混合轨迹，人类示范却包含非 Markov 决策、停顿、回撤和多种解法，两类数据不能仅凭名字都叫“混合质量”就直接等同。HBC 用分层子目标、IRIS 结合层级和离线价值学习；BC-RNN 用循环网络记住时间上下文。本文用统一数据比较六种算法，暴露先前只在机器数据上评测的盲区（§2、§3.3、附录 A/C）" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_2_branch_3" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1205.5" as="sourcePoint"/><mxPoint x="1252" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_2_field_4" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboTurk 是采集接口，robosuite/MuJoCo 是任务与仿真层，robomimic 是离线学习与数据协议。三者在管线中职责不同，不能把本篇框架理解为一个新遥操作硬件或跨手动作重定向系统" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_2_branch_4" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1673.0" as="sourcePoint"/><mxPoint x="1252" y="1673.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_2_field_5" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;行为克隆：把示范中的观察和动作配对，训练模型预测人会如何操作&lt;br&gt;BC（行为克隆）把观察到动作当监督学习；BCQ、CQL 则离线估值并限制分布外动作；既有离线 RL 基准常用训练过程中的机器策略混合轨迹，人类示范却包含非 Markov 决策、停顿、回撤和多种解法，两类数据不能仅凭名字都叫“混合质量”就直接等同&lt;br&gt;RoboTurk 是人类远程采集示范的接口，robosuite/MuJoCo 提供机器人仿真任务，robomimic 则组织离线训练和评估。三者职责不同，因此本篇不是一套新的遥操作硬件" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="1891" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_2_branch_5" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2175.5" as="sourcePoint"/><mxPoint x="1252" y="2175.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_3_field_1" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 按来源组织数据并保留质量差异&lt;/b&gt;&lt;br&gt;&lt;br&gt;MG 来自 SAC 训练中不同检查点，每个检查点采 300 次 rollout，含成功和失败；PH 通常每任务由熟练者采 200 条；MH 由六名操作者各采 50 条，分 better、okay、worse 三组，每组两人。Transport 例外：双臂 PH 为两名熟练者协作采 300 条；MH 为六种操作者配对各 50 条。质量标签是操作员群组代理，不是每帧接触或动作真值（§3.2、附录 B.1）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_3_branch_1" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_3_field_2" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 按来源组织数据并保留质量差异&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真操作者用手机与浏览器远程视频控制；系统记录末端、手指、关节、物体与多相机流。数据不只留一条最终成功率：任务、操作者、初始状态、完整时间序列都需要保留，才能研究混合质量及历史依赖。本文未提出通用去重、轨迹异常清洗或自动延迟校正算法，不能补写成已有模块" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_3_branch_2" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_3_field_3" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 观察、动作与时间接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;每臂本体输入为末端位置三维、四元数四维、夹爪两指位置二维。low-dim 另外提供物体真值，image 则用外部及腕部 RGB 替代；Transport 共四个相机输入。动作每臂七维：三维相对平移、三维轴角增量、夹爪开闭。策略 20 Hz；附录 E.1 的 operational space controller 为 500 Hz，不能当作相机或策略频率。真机传感器与两相机约 20 Hz，端到端延迟未报告" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_3_branch_3" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_3_field_4" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 观察、动作与时间接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机 Panda 使用外部 SR300、腕部 D415；原始图像 640×480，先中心裁成 480×480，再缩放。常规仿真训练图为 84×84，真机 120×120，Tool Hang 为 240×240。训练随机裁剪产生 pixel shift，改变图像输入而不改变动作语义；并非生成新物理轨迹（附录 E.2–E.3）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_3_branch_4" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1778.0" as="sourcePoint"/><mxPoint x="1942" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_3_field_5" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 历史策略与比较协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;示范轨迹 → 连续观察窗口 → 图像编码/本体特征 → RNN 记忆 → GMM 动作分布 → 末端增量 → 控制器执行。 GMM 用多峰分布表达不同可行动作，ResNet-18 加空间特征抽取支持视觉输入。加入记忆、改变观察或数据子集时，需要分别比较，否则把模型差异误归因给示范质量" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_3_branch_5" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2200.0" as="sourcePoint"/><mxPoint x="1942" y="2200.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_3_field_6" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 历史策略与比较协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真每个检查点评 50 条 rollout，取训练过程最高成功率，再汇总三种子；low-dim 训练 2000 epoch、每 epoch 100 更新，image 600 epoch、每 epoch 500 更新。这样的最好检查点是研究用上界，部署时没有免费真机试错来帮忙挑选。最终检查点和最低验证损失都可能明显偏离最好策略（§3.3、§4.5）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2425" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_3_branch_6" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2639.5" as="sourcePoint"/><mxPoint x="1942" y="2639.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_4_field_1" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果：任务含 Lift、Can、Square、双臂 Transport、多阶段 Tool Hang；前三个真机评测任务是 Lift、Can、Tool Hang。下表为 low-dim，均为百分比，三种子汇总，不能与图像或真机数字混列（表 1）：&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：数据/任务：Transport PH；BC：17.3；BC-RNN：71.3；BCQ：7.3；CQL：0.0&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：数据/任务：Square MH；BC：52.7；BC-RNN：78.0；BCQ：14.0；CQL：0.7" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_4_branch_1" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_4_field_2" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据/任务：Can MG；BC：64.7；BC-RNN：68.7；BCQ：75.3；CQL：1.3" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_4_branch_2" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="927.0" as="sourcePoint"/><mxPoint x="2632" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_4_field_3" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;同为 Square，低维 BC-RNN 在 100 条 worse 数据上 39.3%，better 上 66.0%；增加 worse 到 better 混合后可达 73.3%，说明少熟练数据并非对所有方法都无用。PH 的 200 条熟练数据达到 84.0%，MH 的 300 条达到 78.0%，也说明总条数不能代替来源质量及解法一致性（表 1–2）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_4_branch_3" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1359.5" as="sourcePoint"/><mxPoint x="2632" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_4_field_4" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机每任务 200 条单人示范、最终检查点评 30 次：Lift 96.7%，Can 73.3%，Tool Hang 3.3%。Can 去掉随机图像平移为 26.7%，去掉腕部相机为 43.3%。这是指定视觉策略对输入与增强的依赖，不能解读成任何任务加一台腕相机都提高同样幅度（§4.7）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_4_branch_4" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1799.0" as="sourcePoint"/><mxPoint x="2632" y="1799.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_4_field_5" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据量实验按轨迹取 20%、50%、100%；简单任务较少数据即可学会，复杂任务更依赖覆盖。最低验证 loss 与最好闭环策略的差别验证了评估目标错位。图像分辨率、随机种子、rollout 上限与选择规则必须跟数字一起记录，才能比较（§4.5–4.6、附录 B/G）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2024" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_4_branch_5" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2221.0" as="sourcePoint"/><mxPoint x="2632" y="2221.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_5_field_1" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出/研究中直接呈现：历史和观察设计敏感；人类混合质量数据仍让离线 RL 困难；离线检查点选择未解决；真机复杂装配仍低成功。研究没有验证普适质量指标，也没有跨本体训练或灵巧多指控制" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_5_branch_1" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_5_field_2" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的推论：操作员标签会混入速度、解法与任务难度，不能把慢轨迹都删掉；应保留失败原因与关键阶段。对 D435i＋DH116，先离线建立同一时钟下图像、手状态、目标命令与任务结果的日志，再比较当前帧/历史窗口和不同观察；暂不让质量分数代替控制验收。DH116 右手六主动轴、十一总自由度与夹爪不同，需要单独动作维度、耦合和限位定义，左手仿真资产也不能替代右手标定" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_5_branch_2" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="780.0" as="sourcePoint"/><mxPoint x="3322" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_85_5_field_3" parent="paper_85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;整手/多轴运动目前仍受锁定且根因未知，优先用离线日志、运动学和仿真检查三指映射，不据本文触发真机动作。未来机械臂、腕部相机或双臂是额外硬件与标定成本；视觉模型训练需计算资源，原文未给可直接照搬的统一 GPU 时间预算。可先用公开数据测记录协议和训练评估，再决定是否扩采" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_85_5_branch_3" edge="1" parent="paper_85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1254.5" as="sourcePoint"/><mxPoint x="3322" y="1254.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
