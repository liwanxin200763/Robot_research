        <mxCell id="paper_143_authors" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Inkook Chun、Seungjae Lee、Michael S. Albergo、Saining Xie、Eric Vanden-Eijnden；纽约大学、马里兰大学、哈佛大学、Capital Fund Management" vertex="1">
