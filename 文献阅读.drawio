        </UserObject><UserObject id="paper_64_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-121" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><mxCell id="paper_64_1_field_1" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本；已投稿 ICRA 2027，尚非录用论文&lt;br&gt;引用量：引用量来源：（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_1_branch_1" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_1_field_2" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_1_branch_2" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_1_field_3" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：长程操作、失败检测与场景恢复&lt;br&gt;技能衔接处指上一项动作结束、下一项开始的时刻；后者训练时见过的抽屉和物体初态，可能与前者实际留下的状态不同，单项技能分数因此不足以预测整链表现&lt;br&gt;核心问题：单项技能从标准初态出发平均能成功约 79%，串成三段后可能仅 7.6% 完成&lt;br&gt;作者问失效究竟来自机械臂姿态、当前目标物，还是被前序技能改变的其他场景组件，并据此设计可执行的恢复&lt;br&gt;之前方法的问题：重新回位或多次重试仍可能从同一异常场景起步；加大采样量无法产生策略不会执行的场景复位动作&lt;br&gt;只看运动预测误差也可能漏掉停滞，因为机器人停住时下一帧反而容易预测" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_1_branch_3" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1293.0" as="sourcePoint"/><mxPoint x="562" y="1293.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_2_field_1" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_2_branch_1" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_2_field_2" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;SAC：一种通过奖励学习连续动作的强化学习算法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_2_branch_2" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_2_field_3" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：BOSS-44 把 LIBERO 任务连成连续链，测独立技能从前一技能终态启动时的损失&lt;br&gt;本篇在其中十条困难三技能链上做组件级仿真重置，查明场景哪一部分造成衔接失效；这一步使用特权状态作诊断&lt;br&gt;相关方向 2：回放示范、退回前一技能、对象关键点修正和局部强化学习都尝试从失败状态继续&lt;br&gt;作者在相同衔接状态比较这些途径，并发现已有动作库难把抽屉等副作用恢复到后续技能熟悉的状态&lt;br&gt;代表工作：Diffusion Policy、best-of-K 采样及世界模型生成／监测／规划是论文测试的替代路线，不是本方法直接继承的模块&lt;br&gt;检测器借鉴逐帧任务进度估计；恢复教师用 SAC 或 RLPD 学习，分别承担进度判断和场景复位的技术基础&lt;br&gt;与已有方法的区别：先通过分别复位机械臂、抽屉和次要物体定位原因，再在运行时按“检测停滞—恢复场景—重启技能”闭环处理&lt;br&gt;恢复只适用于前序动作留下的可逆副作用；若打开抽屉本就是下一技能的前提，关抽屉反会伤害任务" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_2_branch_3" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1380.5" as="sourcePoint"/><mxPoint x="1252" y="1380.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_3_field_1" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;单项技能从标准初态出发可能成功，却在前一技能留下的场景状态下失效。作者把这种技能衔接处的分布偏移称为 Observation-Space Shift（OSS）；用模拟器特权重置分别考察机械臂位姿、当前目标物、抽屉等关节物体和次要物体，发现后两类场景状态是所测链条中的主要原因。（§I、V-A，表 II）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_3_branch_1" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_3_field_2" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;方法保持基础技能冻结，采用“检测—恢复—继续”：冻结 DINOv3-B/16 编码器上的轻量进度头监测停滞；从失败状态训练恢复策略，把被前序动作改变的抽屉等组件带回后续技能支持域；再通过衔接状态微调与恢复后的重试完成链条。恢复教师在仿真中用特权状态训练，相机学生蒸馏其行为；真机演示中的恢复则由语言提示的 π₀.₅ 策略执行，并非同一个蒸馏学生。（§IV、V-E–F）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_3_branch_2" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="829.0" as="sourcePoint"/><mxPoint x="1942" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_3_field_3" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：使用模拟器特权传送，把机器人姿态、关节物体及次要物体分别拉回标准初态，再看整条链能否完成&lt;br&gt;机械臂单独复位收益小，抽屉与次要物体联合复位收益大，由此把 OSS 的主因定位到场景副作用&lt;br&gt;贡献 2：冻结 DINOv3 图像编码器训练约百万参数的任务进度头，用成功轨迹的时间顺序及失败尾段监督进度&lt;br&gt;监测进度斜率长时间不升时触发报警；比只测绝对进度更能避免技能刚开始时被误报为停滞&lt;br&gt;贡献 3：从真实失败初态在仿真中训练按场景划分的恢复教师，再蒸馏为读相机和本体状态的学生&lt;br&gt;恢复抽屉后，下一技能用恢复后的衔接示范微调以容忍不完美回位；基础技能在检测与恢复评测中保持冻结&lt;br&gt;方法流程：上一技能结束 → 下一技能读取相机与本体状态 → 进度头检测停滞 → 恢复策略把抽屉等副作用拉回标准附近&lt;br&gt;机械臂回位、清除旧观察历史并重试当前技能；真机恢复改用语言提示的 π0.5，并非仿真蒸馏学生" vertex="1">
          <mxGeometry height="814" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_3_branch_3" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1496.0" as="sourcePoint"/><mxPoint x="1942" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_4_field_1" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;BOSS-44 中选取 10 条三技能困难链，每条链 20 次、5 个随机种子；独立技能平均成功率约 79%。未恢复的链条完成率为 7.6%，给予同等回位／重试预算为 12.9%，仅恢复 17.5%，仅预防 11.4%，恢复加衔接微调为 26.5%；模拟器特权重置的上界为 51.8%。组合方法相对原始基线的链条级置换检验为 p=0.047；单项组件均未达到 p&amp;lt;0.05。（§V-C，表 IV）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_4_branch_1" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_4_field_2" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者还比较更多采样、更强基础策略、Diffusion Policy 和世界模型式搜索；在所测试的失败初态下，这些对照没有替代场景恢复。按链细分时，抽屉阻挡后续非抽屉操作，恢复有效；若后续操作本身需要改变抽屉，恢复可能撤销正确动作，ch3_8 从 0.32 降至 0.21；若阻碍来自被移开的自由物体，现有抽屉恢复器无法修复，三条链仍为 0。（§V-B–D，表 V）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_4_branch_2" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_4_field_3" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;模拟器监测器的 seam-window AUROC 为 0.903、耗时 6.1 ms/帧。在 Franka＋微调 π₀.₅ 的三条真机链上，外部相机的跨 episode AUROC 仅 0.625、跨链仅 0.672，样本量 45，置信区间宽且不显著优于随机。匹配检测触发条件时，恢复组的失败放置尝试有 3/21 被救回，而无恢复组为 0/19；作者明确不宣称真机总体成功率显著提升。（§V-E–F，表 VI–VII）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_4_branch_3" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_4_field_4" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：BOSS-44 中选 10 条困难三技能链，Franka Panda 在 MuJoCo 厨房／客厅场景执行，逐链 20 次并扩展到 5 个种子&lt;br&gt;以完成全部三项技能的 L2 成功率为主指标；另用特权组件复位测试到底要恢复哪部分场景&lt;br&gt;对照：基础链条、同等回位和重试预算、只恢复、只做衔接微调、两者结合及特权复位上界一起比较&lt;br&gt;best-of-K、Diffusion Policy 和世界模型路线也在相同异常衔接初态测试，不能把它们的干净初态成绩混进来&lt;br&gt;结果：L2 从基础 7.6% 到同预算重试 12.9%、只恢复 17.5%、只微调 11.4%、恢复加微调 26.5%；特权复位为 51.8%&lt;br&gt;组合相对基础的逐链置换检验 p=0.047；单独模块未达 p&amp;lt;0.05，绝对成功率仍低&lt;br&gt;真机 / 关键补充：Franka 加微调 π0.5 测三条链各 15 次；外部相机检测跨回合 AUROC 0.625，跨链 0.672，置信区间宽&lt;br&gt;在相同触发条件下，有恢复的失败放置尝试救回 3/21、无恢复为 0/19；作者不声称真机总体成功率显著提升" vertex="1">
          <mxGeometry height="884" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_4_branch_4" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2058.0" as="sourcePoint"/><mxPoint x="2632" y="2058.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_5_field_1" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败案例与局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败案例与局限：作者所述：主定量证据来自仿真；真机外部视角会漏看抓空或掉落，需腕部、夹爪感知。恢复器仅覆盖抽屉，不能处理自由物体移位；最终链条成功率 26.5% 仍低，单个基础策略种子与 10 条困难链限制结论范围。增加同分布衔接示范没有解决问题，更广的训练分布尚未检验。（§VII）&lt;br&gt;&lt;br&gt;失败案例与局限：文献库分析：这篇工作把执行错误后的“是否重试”细化为“场景能否先恢复到策略支持域”。对普通夹爪与双臂任务，值得验证触觉／夹爪状态能否提高错误定位、恢复器能否同时处理可动关节与散落物体，以及何时把控制权交还 VLA；这些是研究线索，不是本文已证实的结果" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_5_branch_1" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="477.0" as="sourcePoint"/><mxPoint x="3322" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_64_5_field_2" parent="paper_64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：主量化证据在仿真，真机外部视角常看不见抓空或掉落；真机检测结果不显著优于随机&lt;br&gt;恢复器只可靠处理抽屉，散落自由物体不能修复；十条困难链、单个基础策略种子与 26.5% 最终成功率限制外推&lt;br&gt;我的理解 / 不足：仿真恢复教师用特权场景状态训练，虽蒸馏学生可用相机部署，但真机展示用的是另一个提示驱动策略&lt;br&gt;因此仿真增益不能直接当真机端到端增益；双臂场景中的左右臂占用和互相阻挡还需重新定义恢复目标&lt;br&gt;未来展望：先让检测器接入腕部视角、夹爪宽度或触觉，区分抓空、掉落与任务正常暂停&lt;br&gt;再为自由物体移位训练恢复技能，学习何时交还控制权；只有恢复动作不撤销后续任务前提时才启用&lt;br&gt;对我们项目的启发：机械臂长程 VLA 任务可记录每个技能结束时的抽屉、物体和抓取状态，标记下一技能是否仍在训练支持域&lt;br&gt;对 DH116 与双臂任务应先验证失败检测，再比较直接重试、场景复位及复位后重试，尤其防止恢复动作撤销必要前提" vertex="1">
          <mxGeometry height="884" width="628" x="3322" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_64_5_branch_2" edge="1" parent="paper_64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1284.0" as="sourcePoint"/><mxPoint x="3322" y="1284.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
