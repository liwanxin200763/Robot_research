t="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1690" background="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="paper_48_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="120" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_48_topnav_1" label="返回分类" link="data:page/id,literature-page-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="739" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_48_topnav_2" label="上一篇" link="data:page/id,literature-paper-47" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="1359" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><mxCell id="paper_48_topnav_3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EFF3F6;strokeColor=#C4D0D8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#8093A1;align=center;verticalAlign=middle;spacing=8;shadow=0;" value="下一篇"><mxGeometry x="1978" y="42" width="601" height="62" as="geometry"/></mxCell><mxCell id="detail_48_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#48 ManipTrans"><mxGeometry x="120" y="126" width="2460" height="90" as="geometry"/></mxCell><mxCell id="detail_48_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="05 双臂与 Multi-Agent 协作  ·  本类第 5 / 5 篇  ·  问题：人手和机械手长度、自由度与受力能力不同。怎样高效迁移人类双手操作，同时纠正物理接触误差，而不是让机械手追着不可行轨迹走？&lt;br&gt;方法流程：人类双手运动+物体状态 → 目标手重定向 → 训练动作模仿器 → 仿真执行检查接触 → 学任务残差 → 输出可执行双手轨迹 → 真机验证&lt;br&gt;结果：仿真迁移单手/双手成功率58.1%/39.5%，几何重定向+残差基线47.8%/13.9%。成功要求物体旋转、平移及手部跟踪误差都低于阈值，不等于自由任务完整成功率"><mxGeometry x="120" y="228" width="2460" height="130" as="geometry"/></mxCell><mxCell id="paper_48" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="1100" width="2399" x="140" y="375" as="geometry"/>
