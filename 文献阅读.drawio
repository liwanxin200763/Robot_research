        <mxCell id="paper_87" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="3000" width="4000" x="140" y="450" as="geometry"/>
        </mxCell>
        <mxCell id="paper_87_title" parent="paper_87" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=16;editable=1;movable=1;resizable=1;shadow=0;" value="#87 TUCO" vertex="1">
