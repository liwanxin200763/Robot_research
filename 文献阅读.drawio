        </mxCell>
        <mxCell id="paper_38_1_field_4" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：堆叠旧帧计算多，还要模型自己匹配物体。只输入当前画面可能把运动中与静止物体看成一样，动作容易缺少方向和阶段判断" vertex="1">
