        <mxCell id="paper_05_code" parent="paper_05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;Taming VLAs under Robot Execution &lt;br&gt;Errors - Self-Compensation and Stres&lt;br&gt;s Testing.md&lt;br&gt;&lt;br&gt;开源信息：论文表示将公开 Self-Compensating VLA 与 RoboStress 代码；作者项目页目前未提供公开仓库链接" vertex="1">
          <mxGeometry height="604" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_05_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="4486" width="1000" height="70" as="geometry"/>
          </mxCell>
