        <mxCell id="paper_121_code" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;07_泛化与长程任务\&lt;br&gt;MobiAgent - Dual-Loop Recursive Po&lt;br&gt;licy Self-Improvement for Long-Horiz&lt;br&gt;on Mobile Manipulation.md&lt;br&gt;&lt;br&gt;开源信息：https://github.com/kaiknower/MobiA&lt;br&gt;gent；项目 https://kaiknower.github.i&lt;br&gt;o/mobiagent" vertex="1">
