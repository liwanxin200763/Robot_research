        <mxCell id="paper_107_5_header" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="E. 不足与未来" vertex="1">
