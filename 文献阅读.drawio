            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_1_field_2" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景与具体目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务不仅动作维数更高，还会出现多种合理分工，例如左手或右手拿杯、两手共同持物；交接和倾倒又要求两臂在空间和时间上对齐。作者想让策略学习执行动作后场景会如何变化，借此在训练中形成共享的未来目标。核心贡献是把未来视频预测做成动作学习的辅助任务，同时设计推理时可以删除视频分支的结构。这里的想象是训练监督带来的表示改善，不等于部署时每一步都先生成视频、再做显式规划。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_1_branch_2" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="951.5" as="sourcePoint"/><mxPoint x="562" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_2_field_1" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;已有双臂策略与视频方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;ACT用条件变分自编码器表示动作多样性，给定图像和本体状态一次预测未来动作块，常用时间集成平滑执行。Diffusion Policy把动作序列当作条件生成分布，从噪声多次去噪得到轨迹；DP3进一步用三维点云表达场景。固定主从、稳定臂与操作臂等协调设计能缩小问题，但依赖任务角色假设。另一条视频路线如GR1用未来图像预测共享视觉特征；视频计划加逆动力学则先预测未来画面，再从前后状态推断动作，部署需额外生成和解码，开销较大。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_2_branch_1" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_2_field_2" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;为何使用潜在视频与单向信息流&lt;/b&gt;&lt;br&gt;&lt;br&gt;潜在表示指把高维图像压缩成较短的特征序列，保留与运动相关的语义，同时减少像素纹理冗余。只预测一张未来图像可能忽略动作过程中的先后依赖，多帧预测可提供更连续的任务结构。若动作去噪必须读取预测的未来视频，那么推理时就无法去掉昂贵的视频计算；本文让视频读动作，动作不读视频，通过共享训练参数把动态规律传入策略。这一区别决定了它的速度优势，也避免把未来真实观测误当作部署时可用输入。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_2_branch_2" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="916.5" as="sourcePoint"/><mxPoint x="1252" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_3_field_1" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;观察编码：图像与机器人状态共同作为条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入是当前单视角RGB图像及双臂本体状态，输出是未来两臂关节位置和夹爪状态组成的动作序列。图像经ResNet-18提取二维特征图，展开为视觉token，即一组按空间位置排列的特征向量，并加入二维位置编码。机器人状态用线性层投影到同样维数，作为额外一个token。Transformer编码器融合这些特征，形成动作和视频去噪共享的观察条件。模型没有要求输入人手关节、物体精确网格或语言指令；数据仍来自机器人专家示范。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_3_branch_1" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_3_field_2" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;未来目标编码：均匀采样、多帧压缩与位置标签&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练时从示范后续片段均匀抽取若干未来帧，用预训练Cosmos视频tokenizer压缩。视频tokenizer会同时压缩时间和空间冗余，不是逐张图独立编码。潜在特征再切成不重叠小块，并加入时空位置编码，让网络知道哪些token对应哪个未来时刻、哪个区域。该设计使预测目标既有连续时间结构，又避免用大量像素淹没动作token。选帧与压缩均是训练数据处理；测试时策略不需要访问真实未来帧。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_3_branch_2" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="916.5" as="sourcePoint"/><mxPoint x="1942" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_3_field_3" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;联合扩散与单向注意力的运行细节&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练随机选扩散时间步，对干净动作序列和未来视频潜在token分别加噪。共享Transformer去噪解码器读取当前观察，通过两个输出头分别预测动作和视频的去噪结果。注意力掩码限制动作token只读取动作token，未来视频token可读取自身及其之前发生的动作token。这种时间约束让视频预测利用动作对环境造成的结果，而不让动作依赖未来视频。与完全隔离两种模态相比，视频损失仍能通过共享参数约束动作相关表示；与全注意力相比，训练和推理时动作路径的输入结构保持一致。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_3_branch_3" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1461.0" as="sourcePoint"/><mxPoint x="1942" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_3_field_4" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;目标函数与部署机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;总目标由动作噪声预测的L1误差和视频潜在噪声预测的均方误差组成，视频项乘权重w。动作L1衡量每个动作分量的重建误差，视频均方误差提供未来状态监督，w控制辅助任务是否压过动作拟合。测试时仅从高斯动作噪声开始迭代去噪，完全省去未来视频分支。生成的动作块在完成前按开环执行，随后获取新观察生成下一块，因此反馈发生在动作块之间。块太长会延迟响应滑落或障碍变化，不能把报告的控制频率自动理解成逐帧视觉闭环频率。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_3_branch_4" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2005.5" as="sourcePoint"/><mxPoint x="1942" y="2005.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_4_field_1" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真数据与评测协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALOHA基于MuJoCo，包含方块交接与双臂插入，分别有脚本和人遥操作示范，每任务50条、每条400步约8秒。训练3个种子，每1000训练步在100个初态评估，取最高3次成功率平均再跨种子汇总。RoboTwin基于ManiSkill，16类任务，每任务100条自动生成示范，长250–850步；评估使用最后检查点、100次试验，报告3种子均值和标准差。两套协议不同，不能直接把其成功率当作同一测试集合；论文在RoboTwin对语言条件基线也逐任务微调以控制设置。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_4_branch_1" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_4_field_2" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要仿真结果与百分点解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALOHA四种任务与示范来源组合平均成功率，本文71.9%、ACT47%、Diffusion Policy33%，因此对ACT提高24.9个百分点，不能写成相对增加24.9%。本文在脚本交接、人示范交接、脚本插入、人示范插入分别95.9%、78.1%、83.2%、30.2%，最后一项仍困难。RoboTwin平均本文56.3%、RDT-1B51.1%、ACT44.9%、DP3 42.3%、DP27.3%；对最强RDT-1B提高5.2个百分点，对ACT按表中数值相减为11.4个百分点。摘要写11.1%，与表2数值不一致，笔记采用表格并保留冲突。挂杯等任务仍仅0%或3%，平均领先不代表全任务成功。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_4_branch_2" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="986.5" as="sourcePoint"/><mxPoint x="2632" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_4_field_3" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融回答哪些设计有效&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALOHA无未来预测基线64.6%，下一帧像素预测68.7%，下一帧潜在预测71.3%，多帧潜在预测71.9%，表明潜在目标和多帧各有贡献。全注意力成功70.8%、单次推理0.06秒；完全分离注意力70.1%、0.03秒；单向注意力71.9%、0.03秒，时间在V100上测量。w为0.05、0.2、0.5时分别71.1%、71.9%、70.6%，过弱或过强的辅助损失都略差。动作块100时预测20、40、100帧分别71.1%、71.9%、70.6%，未来越长并非越好。按任务类别看，视频预测使顺序协作提升6.2个百分点，却让同步独立任务下降0.7个百分点，说明预测也会引入不必要依赖。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_4_branch_3" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1583.5" as="sourcePoint"/><mxPoint x="2632" y="1583.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_4_field_4" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机配置、结果与统计规模&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机使用Mobile Trossen，即Mobile ALOHA变体，执行臂为两台ViperX300、示教臂为两台WidowX250，采集480×640、50FPS的RGB图像，图7标注RealSense D405，正文描述RGB图像，不是D435i深度输入。水渍擦拭、叠杯、易拉罐交接、咖啡搅拌每任务50条遥操作示范，每方法最后检查点仅测试10回合。本文四项分别40%、70%、70%、20%，算术均值50%，但原表8的平均行印为60%，两者不一致。ACT和DP平均行分别27.5%、7.5%；本文不基于有矛盾的60%计算相对基线的整体提升，优先逐任务比较。搅拌20%与ACT相同，精确旋转仍未解决。同块长、RTX4060条件下控制频率本文35.8Hz、ACT33.9Hz、DP15.4Hz；这是一组特定硬件比较，不能保证DH116相同延迟。" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_4_branch_4" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2233.0" as="sourcePoint"/><mxPoint x="2632" y="2233.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_5_field_1" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限与未覆盖问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出小物体或遮挡物体如笔需要更强视觉编码器；松耦合任务可能因共享未来表示受到干扰，未来应探索各臂专属表示；均匀抽帧可能遗漏关键事件，可改为更有信息量的关键帧。论文还提出多模态传感和自适应规划作为未来方向。正式版把部分实现细节指向附录，但本地11页未含该附录，因此训练全部超参、各任务块长及完整实现仍需额外核验。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_5_branch_1" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_137_5_field_2" parent="paper_137" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116与人手示范的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前双臂夹爪任务可先在同一批DH116机器人示范上比较ACT、仅动作扩散、加未来潜在监督三种设置，重点看交接时机和一臂等待另一臂的阶段。人手视频缺少机器人动作标签，本文没有解决人到机器人重定向；若要利用人视频，需要另加动作接口或先进行视觉预训练，不能直接宣称少量人视频即可训练本文策略。D435i可先只使用RGB以匹配输入，再单独评估深度是否改善遮挡与空间定位。部署应测动作块期间物体滑移和突发障碍的响应，必要时缩短块长并加入抓持成功检测；生成视频分支在推理被删除，不能把它当作在线失败预测器直接使用。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_137_5_branch_2" edge="1" parent="paper_137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
