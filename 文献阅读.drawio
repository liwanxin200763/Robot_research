          </mxCell>
        </UserObject><UserObject id="paper_118_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-124" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_118_1_field_1" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与时间来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：ReconVLA: Reconstructive Vision-Language-Action Model as Effective Robot Perceiver。作者与机构见元数据，通讯作者Haoang Li。本地9页AAAI正式论文与canonical卡一致。年份 / Venue：AAAI-26；官方https://ojs.aaai.org/index.php/AAAI/article/view/38921标明2026年3月14日出版。首次公开另由官方https://arxiv.org/abs/2508.10333确认2025年8月14日v1，未列后续arXiv更新；不把2026正式出版日视为预印本首发。引用量及代码开放细节未作实时核验。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_1_branch_1" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_1_field_2" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、具体问题与目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人在杂乱场景和连续任务中必须随指令切换当前操作目标，但作者可视化发现一般VLA视觉注意力容易分散，甚至关注无关位置。额外给裁剪图或先输出目标框能帮助定位，却未必让内部视觉表示获得精细目标信息。本文希望通过训练时重建“当前要操作的局部区域”，促使VLA自己形成指令相关的内部感知，从而改善精确堆叠、连续子任务及未见物体操作。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_1_branch_2" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_2_field_1" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制：显式定位与CoT定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;显式定位先由外部检测/分割专家找目标，把目标裁剪图与全图一起输入策略；它依赖部署期额外专家，重复视觉内容也增加冗余。CoT定位让模型先输出目标框坐标，再输出动作，期望动作利用前面的空间推理。这里坐标预测和动作值都需要精确生成，可能增加训练难度。本文的隐式定位不要求推理阶段把目标框写成文字，而把目标区域作为训练监督约束视觉输出。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_2_branch_1" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_2_field_2" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;重建与预测未来的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;UniPi、SuSIE、GR-1等生成未来图像，主要提供目标或动力学信息；ReconVLA重建的是当前观察中的注视区域，并不等于生成未来计划。Gaze region是由任务指令确定的当前操作区域，名称借鉴人眼注视，但没有眼动仪或真实人类注视标签。扩散去噪器负责检验视觉表示是否含有足以恢复目标细节的信息，它是辅助感知训练模块，不能将其误写为扩散动作生成头。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_2_branch_2" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_3_field_1" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入与主干信息流&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略接收多视角观察和语言指令，介绍中还列机器人本体感知。实现基于LLaVA-7b视觉语言模型，LLM为Qwen2-7b，视觉编码器为siglip-so400m-patch14-384。图像经编码和投影成为视觉token，文本经分词后送入LLM。常规动作分支自回归生成离散动作token，经动作反分词器转为末端平移、旋转、夹爪等实际控制量；本地正文未给出所有维度的量化分档和控制周期，不能从其他VLA实现代填。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_3_branch_1" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_3_field_2" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;指令前缀与重建token&lt;/b&gt;&lt;br&gt;&lt;br&gt;若图像token不能看到任务指令，重建目标可能只反映视觉显著性，无法区分同场景不同任务。作者因此把一组指令token放在图像token之前，使因果注意力下图像表示能融合前缀文本。LLM产生reconstructive tokens作为后续去噪条件。这个设计直接对应“当前应看哪”的问题，而非仅增大图像特征容量；重建监督推动这些token保留目标区域的语义和精细外观。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_3_branch_2" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="899.0" as="sourcePoint"/><mxPoint x="1942" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_3_field_3" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;目标潜变量与扩散监督&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练时将注视区域裁剪图I′输入冻结的连续VAE视觉tokenizer，得到潜在scene tokens z0。给潜变量加噪得到zt，轻量Transformer去噪器接收zt、时间步t与重建token hR，预测噪声ε。视觉损失为预测噪声与真实噪声的均方误差期望；总损失为动作token交叉熵加视觉去噪损失。这里重建token提供条件、scene tokens是真值目标，二者概念不同；冻结tokenizer避免目标编码本身随策略训练一起漂移。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_3_branch_3" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_3_field_4" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;大规模数据与预训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者从BridgeData V2、LIBERO、CALVIN组织超过10万条轨迹、约200万样本。给定图像与文本，用微调Grounding DINO定位需要交互的区域，制作全图/裁剪图配对数据。该过程依赖自动检测器产生训练标签，不能称为无需目标标注来源。预训练同时反传动作和重建损失以保持优化目标一致，下游再针对相应环境与动作空间微调。其核心是让VLM先具有跨环境局部重建能力，再把这一能力用于精确动作。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_3_branch_4" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1935.5" as="sourcePoint"/><mxPoint x="1942" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_3_field_5" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;执行闭环与设计界限&lt;/b&gt;&lt;br&gt;&lt;br&gt;部署中根据当前观察与指令输出动作，执行后新的场景进入下一轮策略输入；注视目标可随连续子任务变化。本文证据主要支持辅助监督提升内部感知，未提供奖励反馈更新权重、技能库积累或外部验证器调度的算法。重建当前局部也不构成显式全局任务规划器。正文称避免额外输入输出，故不应擅自要求部署每步运行Grounding DINO或生成裁剪图；具体推理实现及辅助去噪器是否完全裁除，本地正文未量化说明。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_3_branch_5" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2462.5" as="sourcePoint"/><mxPoint x="1942" y="2462.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_4_field_1" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;CALVIN设置与比较口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;CALVIN基于PyBullet、Franka Panda，有34任务和A/B/C/D四环境；长程评测每链5个子任务、500次rollout，指标为连续完成前k项的比例及平均完成长度。ABC→D训练不含D背景，用于视觉场景泛化；ABCD→D包含D，不能把两个设置直接横向当成同难度。表3部分基线取不同既有方法，参数量、数据和训练细节并非完全统一；同一基座的定位范式消融更适合判断辅助监督贡献。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_4_branch_1" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_4_field_2" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;连续任务结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;ABC→D完整ReconVLA前1/2/3/4/5项为95.6/87.6/76.9/69.3/64.1%，平均3.95；OpenVLA五项完成43.5%、平均3.27，UniVLA56.5%、平均3.80。64.1对43.5是20.6个百分点，不能写成相对20.6%。ABCD→D平均4.23，五项70.5%；GR-1平均4.21、五项73.1%，说明本文平均长度略高并不等于完整任务链成功最好。堆积木单项由59.3%提高到79.5%，绝对增加20.2个百分点。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_4_branch_2" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_4_field_3" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;范式与组件消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;同基座ABC→D：无定位基线平均3.36、五项49.0%；显式裁剪输入EG为3.61/50.2%；输出框坐标的CG为0.63/0%；隐式重建IG为3.95/64.1%。这说明作者实现下的CG训练困难，不能推出所有CoT定位普遍无效。组件表2：重建全图且无预训练平均3.42、五项46.5%；改为局部注视区域3.85/58.2%；加预训练3.95/64.1%。局部监督带来较大增益，预训练进一步促进未见场景泛化。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_4_branch_3" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_4_field_4" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机数据、图表与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机为6DoF AgileX PiPer、1DoF平行夹爪，论文原文相机名为RealSense D515（基座）和ORBBEC Dabai（腕部），不擅自改成其他型号。四项为水果入碗、叠碗、翻杯、清桌，每项平均150示范、每模型每任务20次，改变目标和背景；两类未见任务用新物体替换目标。渲染核对图6，ReconVLA四项约90%、95%、70%、70%，未见水果入碗约65%、未见清桌约50%。这些是柱图读数，原图未标逐柱数字与误差条，应保留近似符号。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_4_branch_4" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1865.5" as="sourcePoint"/><mxPoint x="2632" y="1865.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_4_field_5" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;成本与证据限制&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机比较OpenVLA与PD-VLA，完整模型每项最高；未见水果任务并非两个基线都严格0%，图中约5%与15%，所以正文“nearly 0%”不能逐字当作精确表格值。本文未报告可核验的训练GPU型号/总GPU小时、绝对推理延迟、FPS、标注费用和功耗，2百万样本也不等于2百万条独立轨迹。注意力图和重建图属于机制可视化，应与动作成功消融结合解释，不能单凭亮区断言模型具有可靠因果注意。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2143" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_4_branch_5" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2392.5" as="sourcePoint"/><mxPoint x="2632" y="2392.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_5_field_1" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者报告范围与未解决问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文没有单列完整局限章节。作者在消融分析承认未见环境下定位并重建有泛化难度，全图像素冗余使重建更困难，因此采用局部目标并扩大预训练。实验仅覆盖单臂桌面操作，真机新物体有一定泛化但清桌仍约一半失败；不支持灵巧手、移动底盘或双臂协同已验证的说法。大规模预训练的成本和部署速度缺失，也限制“简单高效”一类工程结论。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_5_branch_1" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_118_5_field_2" parent="paper_118" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：自动检测器错框会把重建目标与任务真正所需区域错配，狭窄裁剪可能遗漏接触面、放置容器或障碍物，重建外观也可能偏向纹理而非可操作性。研究启发：可对比目标框噪声、裁剪范围、物体与接触点联合重建，分开测定位、姿态误差和最终成功；固定预训练规模检验收益究竟来自更多数据还是重建监督。还应报告去掉辅助分支后的端到端延迟，确认部署收益。以上是研究建议，未在本机执行。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_118_5_branch_2" edge="1" parent="paper_118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="881.5" as="sourcePoint"/><mxPoint x="3322" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
