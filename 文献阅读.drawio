            <mxGeometry x="100" y="2260" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_02_paper_40" label="#40 4D-VLA&lt;br&gt;要解决：同一物体换视角后图像位置会变；同一画面也看不出历史。能否把跨场景图像映射到有意义的三维位置，并保留重要历史来生成动作？&lt;br&gt;年份 / Venue：2025 / NeurIPS 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-40" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
