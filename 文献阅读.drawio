          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_5_branch_3" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
