          </mxCell>
        </UserObject><UserObject id="paper_108_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-107" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_108_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-109" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_108_1_field_1" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待核验；来源为 Google Scholar，未经人工查看不填写数字（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量&lt;br&gt;数据链条位置：日常人类视频转为灵巧操作数据" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_1_branch_1" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_1_field_2" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;GitHub / 开源程度：见本卡“来源与核验边界”；未核实不视为代码已完整开放&lt;br&gt;版本查询与全文核验日期：2026-10-15&lt;br&gt;&lt;br&gt;研究方向与快速摘要：本篇把日常单目 RGB 视频变成机器人可执行的灵巧手轨迹，输入可来自第一人称、第三人称、网络及生成视频。核心是“重建手物关系 → 在物理仿真中优化目标手动作 → 真机回放”，没有在本文中训练并系统评测一个视觉闭环策略（§1、§3–4）" vertex="1">
          <mxGeometry height="744" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_1_branch_2" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_1_field_3" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;手物交互重建同时恢复人手姿态、物体网格及物体随时间的位姿；动力学一致性要求动作在考虑质量、接触与摩擦的仿真中也能带动物体，而不仅手指位置接近参考。人的指长与机器人不同，几何映射只能作为起点，不能自动保证抓得住" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_1_branch_3" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1531.0" as="sourcePoint"/><mxPoint x="562" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_2_field_1" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作：DexMan 用重建轨迹引导强化学习，DexImit 更强调机器人轨迹合成、双手安排与后续数据学习。本文表 1 列举这些不同路线，但它们不是本文重定向结果表 3 的直接数值对照；表 3 的主要基础是 SPIDER 的退火采样式物理重定向（§2，表 1）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_2_branch_1" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_2_field_2" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_2_branch_2" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_2_field_3" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：FoundationPose 等给定网格追踪位姿，在模糊、遮挡下可能丢失物体；逐帧运行三维生成器又可能生成不同形状和跳变姿态。作者重用 SAM 3D 的联合形状—姿态分布，在固定形状的同时沿视频更新姿态，主要新增的是推理期追踪策略（§3.1）&lt;br&gt;&lt;br&gt;相关工作：几何式重定向将指尖等目标映到机器人关节；SPIDER 类方法进一步在仿真中采样控制序列，评价物体与手的运动是否符合示范。本文面向参考重建噪声，补充起始稳定化、扰动测试及放下／拿起事件约束，而非声称所有参考都是真值（§3.2）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_2_branch_3" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1482.0" as="sourcePoint"/><mxPoint x="1252" y="1482.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_3_field_1" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 固定形状的生成式物体追踪&lt;/b&gt;&lt;br&gt;&lt;br&gt;SAM3 分割，MoGe 估计深度和相机内参，SAM 3D 从图像产生物体网格，HaWoR 跟踪人手。SAM 3D 原本每帧独立生成形状及位姿，本文固定锚点帧的物体形状，把当前流匹配更新向此形状和上一帧姿态的带噪目标拉近（图 2、式 1）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_3_branch_1" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_3_field_2" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 固定形状的生成式物体追踪&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching（流匹配）学习从噪声到目标的连续变换；这里用模型的生成路径作姿态采样，不等于训练机器人控制的流策略。姿态引导强度根据二维点追踪估计的旋转速度调整，避免快速转动时仍被旧姿态锁住。每帧采多个姿态，用位姿距离聚类与掩膜重合筛选，而非昂贵地计算每个候选完整生成概率（§3.1）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_3_branch_2" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_3_field_3" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 对齐尺度与环境方向&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 对齐尺度与环境方向：人手、物体分别重建后可能尺度不一致。作者以人手的近似公制尺度为参照，用手物中心与深度关系求物体平移尺度，随后由 GeoCalib 对齐重力。输入不要求深度相机，但依赖单目估计足够可靠；推断的深度不是实测深度，也不保证绝对尺度精确（§3.1）&lt;br&gt;&lt;br&gt;3. 在物理仿真中修正不可靠动作：在 MuJoCo 中使用 MPPI 风格的采样优化：提出一批未来控制序列，运行物理仿真评价参考追踪，再逐渐从大范围探索转为局部细化。MPC（模型预测控制）在有限未来窗口中选择动作后继续滚动优化；本篇离线得到轨迹，真机回放不等于已部署在线视觉 MPC（§3.2、官方实现）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_3_branch_3" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1338.5" as="sourcePoint"/><mxPoint x="1942" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_3_field_4" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 在物理仿真中修正不可靠动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;Warmup（预热）在原轨迹前增加一个窗口，暂时固定物体而允许机器人调整抓取；解除固定后再正常模拟，避免第一帧未抓稳就掉落&lt;br&gt;随机外力扰动给仿真物体小扰动，促使优化选择能承受扰动的抓法，减少仅短暂平衡在指尖上的不稳定解&lt;br&gt;转移奖励检查参考是物体静置还是在手中，对缺少地面接触或手物接触的相应阶段加惩罚，防止位置误差不大但实际上没拿起／没放下" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_3_branch_4" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1935.5" as="sourcePoint"/><mxPoint x="1942" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_3_field_5" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 在物理仿真中修正不可靠动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 在物理仿真中修正不可靠动作：这三个机制都修改数据生成时的物理轨迹优化，不能直接称作真机执行失败后的恢复控制器&lt;br&gt;&lt;br&gt;完整流程：RGB 视频 → 手／物体分割 → 单目深度与内参估计 → 人手跟踪及固定形状物体追踪 → 尺度和重力对齐 → 仿真退火采样＋预热＋扰动＋事件约束 → 目标灵巧手控制轨迹 → 初始场景人工对齐与机械臂逆运动学 → 真机回放" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_3_branch_5" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2480.0" as="sourcePoint"/><mxPoint x="1942" y="2480.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_4_field_1" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;重建、数据与指标&lt;/b&gt;&lt;br&gt;&lt;br&gt;重建、数据与指标：DexYCB 160 段、HOI4D 12 段做手物重建，其中用真实手轨迹隔离物体评测；另有 150 段网络／第一视角／生成视频，每段 3 人做物体追踪偏好比较。67% 是人类偏好本文追踪而非 FoundationPose 的比例，不是机械臂成功率（§4.1–4.2，图 5）&lt;br&gt;&lt;br&gt;重建、数据与指标：表 2 的 DexYCB F-10（10 mm 阈值下的几何 F-score）为本文 0.93、FoundationPose 0.89；几何指标更好并不直接证明动作可执行。论文给出重建误差及对齐协议，不能混为任务完成分数" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_4_branch_1" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_4_field_2" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;重定向消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;重定向消融：在 655 条重建参考与 1352 条 OakInk2 动捕参考上评估 22 自由度 Sharpa Wave。成功条件是物体平均位置误差 &amp;lt;0.1 m 且平均旋转误差 &amp;lt;0.5 rad；这是仿真轨迹追踪通过标准，不是任意任务语义成功（§4.1、表 3）&lt;br&gt;&lt;br&gt;重定向消融 / 表中逐项记录：重定向配置：原退火采样；重建参考通过率：25%；OakInk2 通过率：72%&lt;br&gt;&lt;br&gt;重定向消融 / 表中逐项记录：重定向配置：加预热；重建参考通过率：66%；OakInk2 通过率：77%" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_4_branch_2" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1039.0" as="sourcePoint"/><mxPoint x="2632" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_4_field_3" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;重定向消融 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;重定向消融 / 表中逐项记录：重定向配置：再加扰动；重建参考通过率：67%；OakInk2 通过率：79%&lt;br&gt;&lt;br&gt;重定向消融 / 表中逐项记录：重定向配置：再加转移奖励；重建参考通过率：71%；OakInk2 通过率：81%&lt;br&gt;&lt;br&gt;重定向消融：重建参考 25%→71% 是增加 46 个百分点，预热贡献最大；扰动对数值增益较小，但作者给出更自然抓取的定性证据。单独模块贡献取决于这个加入顺序，不是所有可能交互的完整因果分解" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_4_branch_3" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1653.5" as="sourcePoint"/><mxPoint x="2632" y="1653.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_4_field_4" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机和质量筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;UR3e 双臂＋Sharpa Wave 以 50 Hz 执行搅拌、倒液、除尘、挤压、擦除等 10 种代表动作。部署前人工对齐初始 x/y/z/yaw，再求机械臂逆运动学；论文没有提供这些动作统一的反复测试总数和真机成功率表，应记作真机可执行展示，而非 71% 真机 Sim2Real 成绩（§4.4，图 6）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1966" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_4_branch_4" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2163.0" as="sourcePoint"/><mxPoint x="2632" y="2163.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_4_field_5" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机和质量筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;最终得到 500 条人工检查的高质量轨迹，来源比例网络 53%、第一视角 31%、生成 16%。从 100DOH 抽取的 2000 段视频仅 83 段通过重建质量筛选，提示“网上有大量视频”远不等于“大量可用机器人示范”（§4.5）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2388" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_4_branch_5" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2578.0" as="sourcePoint"/><mxPoint x="2632" y="2578.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_5_field_1" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确指出：只处理刚体，依赖近似正确的单目深度；视觉遮挡与真实接触难区分；只重建手和操作物，不能推理完整障碍场景和关节物体；物理引擎也只近似现实动力学（§5）&lt;br&gt;&lt;br&gt;不足与未来：我的理解：10 种动作回放说明可行性，但没有证明对初始位置扰动、滑落或换手型仍有可靠闭环性能。500 条轨迹仍经人工过滤，整流程不是无人工质量审计的大规模自动采集&lt;br&gt;&lt;br&gt;不足与未来：DH116 最可借鉴：先复用“预热稳定抓取＋外力扰动＋拿起／放下事件检查”的数据生成验证思路，目标手须换成 DH116 的关节耦合、碰撞网格和执行器模型；配机械臂时仍需可达性和碰撞检查。D435i 的实测深度可用于对照单目尺度误差，但这属于改造实验，不能写作原方法已验证" vertex="1">
          <mxGeometry height="779" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_5_branch_1" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="529.5" as="sourcePoint"/><mxPoint x="3322" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_108_5_field_2" parent="paper_108" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;成本与研究方向：公开代码将重建、重定向、部署分开，便于从单个刚体抓放做模块复现；三维视觉模型和 MuJoCo Warp 采样仍需要 GPU 和复杂依赖，未核实统一训练预算，不称完整流程“无算力成本”。若目标是部署恢复，应额外设计实时状态观测、错误判定与重抓规划" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_108_5_branch_2" edge="1" parent="paper_108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1144.0" as="sourcePoint"/><mxPoint x="3322" y="1144.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
