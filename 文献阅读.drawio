        </UserObject><mxCell id="paper_06_1_field_1" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / AAAI&lt;br&gt;引用量：7（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_1_branch_1" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_1_field_2" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_1_branch_2" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_1_field_3" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 A (CCF 7th edition; venue category not independently extracted from official PDF) 方向，主要讨论多任务模仿学习策略需要可靠动作，也需要用少量示范适应未见任务。&lt;br&gt;核心思路是FoAM 输入多模态目标，在动作重建之外加入 foresight augmentation，让策略利用预期视觉结果。&lt;br&gt;与当前项目的联系：项目联系：方法可借鉴，但迁移到当前双臂硬件需验证" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_1_branch_3" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_1_field_4" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：多任务模仿学习策略需要可靠动作，也需要用少量示范适应未见任务&lt;br&gt;&lt;br&gt;为什么重要：可比较“预见动作后果”是否帮助双臂动作前验证&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：一套模仿学习模型做多种任务。它同时看指令和希望达到的目标画面，还学习动作之后画面会怎样变化&lt;br&gt;核心问题：任务少量示范时，模型能否先想象动作的结果，再在没专门练过的任务上操作？&lt;br&gt;之前的问题：只看文字可能不知道物体要摆成什么样；只看目标图片又可能弄不清任务真正要求" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_1_branch_4" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1820.0" as="sourcePoint"/><mxPoint x="562" y="1820.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_2_field_1" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：只根据当前状态重建动作，可能缺少对动作视觉后果的预测" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_2_branch_1" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_2_field_2" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：语言引导的模仿学习，让模型从示范中学会多种取放动作；文字有时不够具体&lt;br&gt;相关方向 2：目标图像让模型看到完成后应是什么样；相似画面可能对应不同操作步骤&lt;br&gt;代表工作：MT-ACT、BAKU 用语言引导；Gimg-ACT 用目标图像，都是本论文的比较对象&lt;br&gt;区别：训练时同时给文字和目标图，并要求预测动作后果；实际运行时直接输出动作" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_2_branch_2" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="881.5" as="sourcePoint"/><mxPoint x="1252" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_3_field_1" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：FoAM 输入多模态目标，在动作重建之外加入 foresight augmentation，让策略利用预期视觉结果&lt;br&gt;&lt;br&gt;输入：官方摘要给出任务/数据类型；具体模型张量与接口需核对方法章节&lt;br&gt;&lt;br&gt;输出与动作：官方摘要未明确列出完整控制接口；需核对论文方法或代码&lt;br&gt;&lt;br&gt;方法概览：任务输入 → FoAM 输入多模态目标，在动作重建之外加入 foresight augmentation，让策略利用预期视觉结果 → 官方摘要未明确列出完整控制接口；需核对论文方法或代码" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_3_branch_1" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="477.0" as="sourcePoint"/><mxPoint x="1942" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_3_field_2" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把目标与动作后果联系起来&lt;/b&gt;&lt;br&gt;&lt;br&gt;FoAM 同时使用文字任务与目标图像，动作策略除重建示范动作外，还接受对动作视觉后果的预测约束。目标图像说明希望到达什么状态，后果预测帮助内部表示区分哪些动作会接近这个状态；这两种信息不是同一信号。原文还微调视觉语言模型生成目标图像，不能把输入目标图像理解为部署时免费获得未来真值" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_3_branch_2" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1056.5" as="sourcePoint"/><mxPoint x="1942" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_3_field_3" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把指令和目标图片一起交给模型，让它既知道做什么，也看到完成后的样子&lt;br&gt;贡献 2：训练时再让模型预测动作后的画面，促使动作与预期结果一致；部署时不用额外预测&lt;br&gt;贡献 3：提供双臂仿真任务，并在多种真机任务上测试模型是否能复用所学动作&lt;br&gt;流程：读指令与当前画面→形成目标画面→训练时同时学动作和动作后画面→执行时输出动作段" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_3_branch_3" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1548.5" as="sourcePoint"/><mxPoint x="1942" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_3_field_4" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_3_branch_4" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2040.5" as="sourcePoint"/><mxPoint x="1942" y="2040.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_4_field_1" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：超过 100 项仿真/真机任务；官方发布的仿真任务套件&lt;br&gt;&lt;br&gt;主要结果：AAAI 摘要报告仿真与真机超过 100 项任务，成功率相对基线最高提升 41%；另发布 80 多项仿真任务&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：超过 100 项仿真/真机任务；官方发布的仿真任务套件&lt;br&gt;&lt;br&gt;实验与结果：主要结果：AAAI 摘要报告仿真与真机超过 100 项任务，成功率相对基线最高提升 41%；另发布 80 多项仿真任务" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_4_branch_1" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="459.5" as="sourcePoint"/><mxPoint x="2632" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_4_field_2" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;新增全文核对的实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;原文的 FoAM 仿真套件包含八十多项任务、十多个场景，覆盖五类任务与四项未见任务，每任务评估 50 次；比较多任务 ACT、BAKU、仅目标图像 ACT 及去掉 foresight augmentation 的版本。各实验同时改变目标条件或辅助损失，读表时应判断是哪一项对照隔离了对应因素；摘要所称最高增益不是每个任务的平均收益" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_4_branch_2" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1021.5" as="sourcePoint"/><mxPoint x="2632" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_4_field_3" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：仿真共 86 项任务，真机共 14 项任务；用多任务设置检查同一模型能否处理不同操作&lt;br&gt;对照：与只用语言的 MT-ACT、BAKU，及只用图片的 Gimg-ACT 比较；也去掉“预测后果”看作用&lt;br&gt;结果：仿真双臂 12 项任务平均成功率 86%，Gimg-ACT 为 45%；差 41 个百分点，指本基准上的完成比例&lt;br&gt;真机：真机使用带夹爪的 xArm 7 单臂，测试四类场景中的 14 项任务；不等于真机双臂验证" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_4_branch_3" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1513.5" as="sourcePoint"/><mxPoint x="2632" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_4_field_4" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_4_branch_4" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1988.0" as="sourcePoint"/><mxPoint x="2632" y="1988.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_5_field_1" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：方法可借鉴，但迁移到当前双臂硬件需验证&lt;br&gt;&lt;br&gt;主要局限：本段基于官方摘要；未覆盖全文失败案例、完整 Baseline 与方法消融&lt;br&gt;&lt;br&gt;局限与启发：主要局限：本段基于官方摘要；未覆盖全文失败案例、完整 Baseline 与方法消融" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_5_branch_1" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_5_field_2" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出高精度真机任务中，目标图片的细节含义仍可能生成不准&lt;br&gt;我的理解 / 不足：预测后果主要用于训练；运行时它没有直接比较预期和真实画面来检测失败&lt;br&gt;未来展望：让目标画面包含更准确的中间步骤，减轻长任务中前面误差累积的影响&lt;br&gt;对我们项目的启发：可另做“预期画面与执行后画面”的比较，检验能否发现接触或任务结果异常" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_5_branch_2" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_06_5_field_3" parent="paper_06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_06_5_branch_3" edge="1" parent="paper_06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1391.0" as="sourcePoint"/><mxPoint x="3322" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
