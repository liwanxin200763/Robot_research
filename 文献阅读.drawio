          </mxCell>
        </UserObject><UserObject id="paper_07_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-08" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_07_1_field_1" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CoRL 2025；PMLR 305，3200–3217&lt;br&gt;引用量：73（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_1_branch_1" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_1_field_2" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：已有 VLA 常在每次观察后只输出一组动作，实际部署可能出现抓取不准、任务进度中断或碰撞。相比继续增加训练算力，本文研究能否在测试时多生成候选动作，再用单独的动作验证器选择较好的动作，从而提高泛化与鲁棒性。（PMLR 正式论文第 1 节；项目页真机案例）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_1_branch_2" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_1_field_3" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;检验动作候选数与最优可选动作误差之间是否存在测试时扩展规律，并设计可在实际机器人上运行的候选生成、偏好数据构建与动作验证方法，缓解分布偏移导致的动作错误。（第 1、3–5 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_1_branch_3" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1335.0" as="sourcePoint"/><mxPoint x="562" y="1335.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_1_field_4" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;只执行 VLA 的单次输出，不利用同一状态下可采样的其他动作。简单反复调用 VLA 增加延迟；仅靠离线价值函数重排也可能随采样数增大出现评分漏洞。论文附录 C 报告 V-GPS 在其离线动作误差实验里采样多于 8 个动作时性能退化，但该现象不应外推到所有配置。（第 1、3、6 节；附录 C）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1553" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_1_branch_4" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1767.5" as="sourcePoint"/><mxPoint x="562" y="1767.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_1_field_5" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;首次 arXiv：2025年6月&lt;br&gt;研究方向：看图、读指令并生成动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作）。一次给出多种候选，执行前检查哪个更可靠&lt;br&gt;核心问题：抓之前若有几种抓法，能否先评估它们，再让机器人执行最有希望的一种？&lt;br&gt;之前的问题：普通 VLA 常直接执行一次预测；它可能抓偏或碰撞，却没有执行前筛选" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="2010" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_1_branch_5" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2259.5" as="sourcePoint"/><mxPoint x="562" y="2259.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_2_field_1" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_2_branch_1" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_2_field_2" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法&lt;br&gt;OOD：训练分布之外，例如未见物体或不同背景" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_2_branch_2" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_2_field_3" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenVLA 是主实验基础策略；本文改变测试时的候选动作生成与选择，而不是重新预训练通用 VLA。相比仅对候选应用离线价值函数的 V-GPS，本文用演示轨迹自动构造偏好数据，训练视觉—语言动作评分器；相较 ReconVLA 的视觉 Grounding 改造，本文主要处理动作输出端的决策。（第 4–6 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_2_branch_3" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_2_field_4" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：普通 VLA 看画面后直接给动作，速度快，但某次输出不可靠时缺少备选&lt;br&gt;相关方向 2：测试时多生成几种动作并排序，可用更多计算换取一次更稳妥的选择&lt;br&gt;代表工作：OpenVLA 是基础动作策略；V-GPS 和 CogACT 提供候选动作或重排的比较路线&lt;br&gt;区别：另训一个看画面、语言和候选动作的验证器，先评分再执行，不必重训基础策略" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_2_branch_4" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1662.5" as="sourcePoint"/><mxPoint x="1252" y="1662.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_1" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;先在演示状态下从参考策略采样、聚类出不同候选动作，以到专家动作的 RMSE 生成合成偏好对，训练 VLM 验证器。部署时用少量 VLA 初始动作拟合高斯分布，以多数票定夹爪开合，再扩充候选并让验证器评分选择；这是执行前动作选择，不等于先模拟每个候选动作的真实后果。（第 4 节，图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_1" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_2" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;系统由通用 VLA、候选分布、LLaVA-7B 动作验证器及批量推理服务组成。训练数据管道把同一观察下的候选动作聚类，依据其与专家动作的 RMSE 排出优劣；验证器用 Bradley–Terry 偏好目标加评分差距项训练。推理时连续平移／旋转维度由少量初始 VLA 输出拟合高斯，夹爪由多数票固定；扩展候选由验证器打分，选择最高分动作执行，再观察并重复。SGLang 改造服务减少多次采样延迟。（第 4 节、算法 1；附录 B、G）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_2" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_3" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本输入是当前腕部相机图像、语言任务指令及机器人状态；动作验证器还接收候选动作的离散 token 表示。构造偏好数据时额外使用演示中的专家动作来算 RMSE；部署阶段不需要专家动作或真实奖励。（第 2、4 节；附录 B.1）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_3" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_4" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;每一步选出一条 7 维末端增量动作：三维平移、三维旋转和二值夹爪状态。连续动作维度在验证器输入中各离散为 256 档；测试时高斯扰动只用于候选平移／旋转分量，夹爪通过多数票决定。即使底层模型可能输出动作块，附录 D 的跨策略实验也要先做时序集成并转换成验证器可评分的离散动作。（第 2、4.4 节；附录 B、D）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_4" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1760.5" as="sourcePoint"/><mxPoint x="1942" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_5" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;针对每个演示状态，从 VLA 采样候选并聚类保留代表性动作，再做两两比较；比较标签来自候选与专家动作的距离。部署阶段从少量初始动作拟合连续维度高斯分布并抽更多候选，夹爪用多数票；这属于测试时动作采样增强，不能等同于训练数据增强。附录 B.2 报告真机使用 5 个初始动作与 16 个扩展候选。（第 4.2、4.4 节；附录 B.2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_5" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2217.5" as="sourcePoint"/><mxPoint x="1942" y="2217.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_6" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;动作验证器用 LLaVA-7B 骨干、ViT-Large 视觉编码与 reward head；使用 LoRA rank 512、alpha 128、batch 256、Adam 学习率 2e-5、1 epoch，在 8 张 H100 上训练，偏好损失中的 margin 权重取 0.1。OpenVLA 是主实验的基础策略；LIBERO-Long 则同时微调 OpenVLA 与验证器。作者提供官方仓库的验证器服务和推理脚本，但论文未声称这些设置适用于所有 VLA。（第 4.3、5.1、5.5 节；附录 B.1）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2460" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_6" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2709.5" as="sourcePoint"/><mxPoint x="1942" y="2709.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_3_field_7" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：增加候选动作时动作误差大致呈幂律下降；这是采样更多动作有价值的实验观察&lt;br&gt;贡献 2：从示范动作制造“好/坏候选”的训练例子，让验证器学会判断哪种动作更接近示范&lt;br&gt;贡献 3：对候选动作加小扰动并处理夹爪开合，再让验证器选分数最高的动作&lt;br&gt;流程：VLA 提出多种动作→扩充和整理候选→逐一评分→只执行选中的动作" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2987" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_3_branch_7" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3236.5" as="sourcePoint"/><mxPoint x="1942" y="3236.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_4_field_1" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要训练数据来自 Bridge V2 的 4 万余条真实 WidowX 演示，跨 24 种环境；作者从中构建 2000 万组合成动作比较，以候选到演示动作的 RMSE 自动生成偏好标签，不额外要求人工逐对评分。LIBERO-Long 适配时重新构造该机器人设置的偏好数据。主文没有把不同数据源合并为一个新的跨本体预训练集。（第 2、4.2、5.1、5.5 节）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_4_branch_1" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_4_field_2" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;测试包括 Bridge V2 上的离线动作误差、SIMPLER 的 4 项同分布仿真任务、WidowX-250 S 的 4 组分布外真机任务，以及 LIBERO-Long 的 10 项长程仿真任务。真机每任务 10 次，三方法合计 120 次 rollout；LIBERO 共 500 次评估。基线是独立 OpenVLA 与配 V-GPS 价值函数的 OpenVLA。跨策略离线分析还用 CogACT、Octo、SpatialVLA，但主要闭环表不是这三者的真机结果。（第 3、5 节；附录 A–D）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_4_branch_2" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="846.5" as="sourcePoint"/><mxPoint x="2632" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_4_field_3" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;WidowX-250 S 的四组分布外任务涉及未见指令、物体、形状与干扰物：叠杯、拿锤子放篮、香蕉入黄篮、甜椒上盘。图 3 报告平均成功率 RoboMonkey 60%、OpenVLA 35%、V-GPS 30%，即对 OpenVLA 高 25 个百分点。香蕉任务中 OpenVLA 0%，论文将其联系到难以区分两个黄色对象。项目页展示抓取不准、进度中断和碰撞案例，但这是示例，而非严格的失败类别发生率统计。真机系统在单张 H100 上约 1.5 Hz、占用 28 GB 显存。（第 5.1、5.3 节，图 3–4；附录 A–B；项目页）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_4_branch_3" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_4_field_4" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIMPLER 四项任务平均成功率 47.5%，较 OpenVLA 高约 9 个百分点；官方代码页分任务列出茄子入篮 73% 对 54%、叠方块 45% 对 35%。真机 OOD 为 60% 对 35%。LIBERO-Long 表 1 中联合适配后平均 56.5%，仅微调 OpenVLA 为 49.8%，差 6.7 个百分点，并非 7% 相对增长。离线采样规律实验假设理想验证器，OpenVLA 在 1 万候选下 RMSE 降 59.3%；这个数不能当作实际部署验证器的闭环成功率。（第 3、5 节，表 1、图 1、3；官方代码页评测表）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_4_branch_4" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1953.0" as="sourcePoint"/><mxPoint x="2632" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_4_field_5" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录 C 中，同样 64 个候选时 RoboMonkey 验证器的动作误差相对贪心 OpenVLA 降 21%，V-GPS 降 6%；这是离线 RMSE 指标。附录 D 的跨模型离线误差：CogACT 0.145→0.133，Octo 0.196→0.166，SpatialVLA 0.137→0.1298。附录 E 的偏好 margin 实验，alpha=0／0.1／1.0 的 F1 分别 0.83／0.85／0.81。附录 F 在 OOD、64 候选下，偏好学习比直接 RMSE 回归的动作误差低 6%。训练偏好数据规模扩大时，SIMPLER 平均成功率从 37.5% 增至 46.3%。这些实验的任务与指标不同，不能直接合并成单一增益。（第 5.4 节；附录 C–F）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="2248" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_4_branch_5" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2532.5" as="sourcePoint"/><mxPoint x="2632" y="2532.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_4_field_6" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文引言和项目页展示原 VLA 的抓点不准、任务进度失败、碰撞；验证器可在部分案例中选出更合适的动作。作者也指出评分器存在被采样分布利用的风险：附录 C 的 V-GPS 随候选增多在该设置下退化。本文自己的真机仍有 40% 平均失败试次，但正式论文没有给这些失败逐例标注原因，不能推断所有失败都源于验证器。（第 1、5.3 节；附录 C；项目页）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2845" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_4_branch_6" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3077.0" as="sourcePoint"/><mxPoint x="2632" y="3077.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_5_field_1" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者在第 7 节指出：多次动作采样加 7B 验证器产生额外延迟与显存开销，可能不适于高频控制；偏好训练仅扩到 Bridge V2 的 2000 万比较；评测本体主要为 WidowX 250S 与 Franka。本库分析：基于单步专家动作 RMSE 的偏好未显式估计远期任务后果；单步动作评分无法自动保证复杂双臂协同或长程失败恢复。这些研究空白并非论文已证明的缺陷" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_5_branch_1" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_5_field_2" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboMonkey 对普通夹爪的执行错误预防有直接参考价值：部署时用多个动作提案加验证器，减少抓点偏差和碰撞；其 1.5 Hz 与单步评分边界也提醒研究者考虑控制频率和长程后果。潜在研究启发：在双臂或长程操作中把单步偏好验证扩展为接触后观察、任务进度检查与失败恢复，并对危险动作增加约束。论文没有实证这些扩展。（第 5、7 节）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_5_branch_2" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="864.0" as="sourcePoint"/><mxPoint x="3322" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_07_5_field_3" parent="paper_07" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出候选采样和验证耗时间、占显存；要高频控制时可能来不及&lt;br&gt;我的理解 / 不足：它只在执行前选动作；动作做完后若仍抓失败，还需另做检测和恢复&lt;br&gt;未来展望：减少评分开销，并收集更多不同机器人上的候选偏好数据&lt;br&gt;对我们项目的启发：可先筛掉风险高的动作，再记录执行后的真实偏差，比较事前筛选与事后补救" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_07_5_branch_3" edge="1" parent="paper_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1373.5" as="sourcePoint"/><mxPoint x="3322" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
