            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_31_1_field_1" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / CVPR 2026&lt;br&gt;引用量：8（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_1_branch_1" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_1_field_2" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：操作失败有轻微姿态偏移，也有物体或场景已经被破坏两种不同情形；统一“再试一次”很难有效。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：区分可直接纠正的分布内偏差与需要先重置场景的分布外失败，并自动选用相应技能。（第 1 节）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_1_branch_2" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_1_field_3" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：通用策略对失败状态缺少训练；简单重试无法复原对象，纯人工接管也限制扩展性。（第 2 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：执行失败识别、纠正与恢复&lt;br&gt;按失败状态选择不同处理&lt;br&gt;核心问题：一次抓取或放置失败后，&lt;br&gt;机器人怎样继续原任务而非整次重来？&lt;br&gt;原策略多从正常起点训练，&lt;br&gt;偏离轨迹后常不知道如何回到可执行状态" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_1_branch_3" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1499.5" as="sourcePoint"/><mxPoint x="562" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_2_field_1" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;与已有工作的关系：相较 Recova 的双臂任务与持续接管，FLARE 更明确地区分姿态纠错和场景重置两级恢复&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：在线监控，&lt;br&gt;判断执行是否偏离目标&lt;br&gt;相关方向 2：重试和重置，&lt;br&gt;分别修正动作或修复场景&lt;br&gt;代表对照：原始 π0.5 与只做部分恢复的方案；&lt;br&gt;比较最终任务成功&lt;br&gt;区别：把失败分为可直接重试和&lt;br&gt;必须先重置场景两类" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_2_branch_1" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="547.0" as="sourcePoint"/><mxPoint x="1252" y="547.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_2_field_2" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;OOD：训练分布之外，例如未见物体或不同背景" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="982" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_2_branch_2" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1172.0" as="sourcePoint"/><mxPoint x="1252" y="1172.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_3_field_1" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;对轻微偏差训练 bridging correction，对场景改变学习 reset skill；在线监测器决定继续任务或先复原对象。（第 3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_3_branch_1" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_3_field_2" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;对 ID 姿态偏差，使用扰动与桥接示范增强 π0.5；对 OOD 场景失败，离线多模态模型分析失败视频，确定需重置的对象和时机，并用少量人工示范训练 reset skill。在线多模态监测在任务策略与 reset skill 间切换；没有跨任务长期失败记忆。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_3_branch_2" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="745.0" as="sourcePoint"/><mxPoint x="1942" y="745.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_3_field_3" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：任务指令、视觉和本体观测、在线监测判断；离线还读取失败视频。没有显式 command 与实际关节执行残差字段。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：π0.5 连续操作动作或对象 reset skill 动作；reset 后再运行原任务，但论文没有统一证明每次复原后的语义目标已被充分验证。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：ID 数据通过姿态扰动与 bridging trajectory 扩增，OOD 恢复数据以对象重置示范和增强构建。（第 3 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_3_branch_3" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1272.0" as="sourcePoint"/><mxPoint x="1942" y="1272.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_3_field_4" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练方式：基于 π0.5 微调任务纠错策略与 reset skill；多模态模型离线提取失败类型，在线监测器选技能。（第 3 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：贡献 1：多模态大模型离线分析失败，&lt;br&gt;在线监控当前场景&lt;br&gt;贡献 2：用扰动和桥接示范训练 retry（重试），&lt;br&gt;让策略能从偏离姿态继续&lt;br&gt;贡献 3：场景已乱时调用 reset（重置）技能，&lt;br&gt;先修复环境再回原任务&lt;br&gt;流程：正常执行→发现失败→判断场景&lt;br&gt;→重试或重置→检查→继续" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_3_branch_4" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1939.0" as="sourcePoint"/><mxPoint x="1942" y="1939.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_4_field_1" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：九项模拟操作任务和单 Piper 真机任务；每种需重置对象采集约 10–20 条人工示范。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：九项模拟任务比较 π0.5、Phoenix 等，评估最终完成率以及失败识别和 reset 的贡献。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：单 Piper 任务各 40 次测试：blocks 62.5%→75%，U-shape 45%→55%；某些物体重置仍困难，如 coffee pod 24%、U-block 20%。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_4_branch_1" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_4_field_2" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：模拟九任务平均成功率 84.0%，Phoenix 为 57.8%，相对 π0.5 提高 11.8 个百分点；在线 ID/OOD 判断准确率约 88%–96%。（第 4 节、主结果表）&lt;br&gt;&lt;br&gt;消融实验：对比只做 ID 纠错、只用 reset 及完整框架，显示两种恢复分支互补；额外失败示范与增强影响效果。（第 4 节、消融表）&lt;br&gt;&lt;br&gt;Failure Case：硬物或狭窄空间重置仍失败；监测器若把场景破坏误判成普通姿态偏差，就可能错误重试。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_4_branch_2" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_4_field_3" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;阅读要点与补充说明：实验：仿真任务与 Piper 真机两任务；&lt;br&gt;每个真机任务 40 次&lt;br&gt;对照：原始 π0.5；&lt;br&gt;指标是整任务最终成功率&lt;br&gt;结果：叠三块真机 62.5%→75%；&lt;br&gt;插 U 形块 45%→55%&lt;br&gt;补充：真机每任务 10 条人工示范扩成 50 条；&lt;br&gt;恢复依赖已收集的技能&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="779" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_4_branch_3" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1793.5" as="sourcePoint"/><mxPoint x="2632" y="1793.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_5_field_1" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；机器人失败导致场景破坏，D0/D1 是初始状态随机化，不是执行中独立运动目标&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：在线监测识别失败并粗分 ID 姿态偏差/OOD 场景破坏，选择重试或 reset skill，执行后续接原任务；任务成功率检验整体效果。训练期从失败视频学习技能，但没有持久保存细粒度原因与每次恢复结果的 Failure Memory&lt;br&gt;&lt;br&gt;主要局限：作者提出更灵巧的恢复技能为后续工作。按本库分析，任务多为初态随机化而非外部持续运动目标；没有保存失败原因—恢复结果的可检索长期记忆，也没有真机双臂恢复" vertex="1">
          <mxGeometry height="709" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_5_branch_1" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="494.5" as="sourcePoint"/><mxPoint x="3322" y="494.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_31_5_field_2" parent="paper_31" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可作 Failure Detection / Recovery 的分支选择基线；对 Failure Memory 的启发是记录“判定为 ID/OOD—所选动作—复原结果”，并检验错误诊断代价。这些持久记录并非本文机制&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者方法需要恢复技能库，&lt;br&gt;监控和技能选择若出错会影响后续&lt;br&gt;我的理解：只测少数真机任务，&lt;br&gt;难说明面对未知失败也能恢复&lt;br&gt;未来可用失败记忆搜索相似场景，&lt;br&gt;再验证恢复是否真的修复目标&lt;br&gt;项目启发：可做 DH116 的 retry/reset 基线；&lt;br&gt;按失败原因加入触觉和状态记录" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="877" as="geometry"/>
        </mxCell>
        <mxCell id="paper_31_5_branch_2" edge="1" parent="paper_31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1214.0" as="sourcePoint"/><mxPoint x="3322" y="1214.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-44" name="04-09 RESETTLE">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_44_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_44_topnav_1" label="返回分类" link="data:page/id,literature-page-04" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
