            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><mxCell id="paper_70_1_field_1" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CoRL&lt;br&gt;引用量：91（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_1_branch_1" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_1_field_2" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_1_branch_2" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_1_field_3" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Dexterous Manipulation / Dexterous Hand / Robot Manipulation 方向，主要讨论人形机器人多指操作的控制维度高，真机直接强化学习成本大。&lt;br&gt;核心思路是在仿真中训练视觉条件强化学习策略，再迁移到人形机器人完成抓取、搬箱等灵巧任务。&lt;br&gt;与当前项目的联系：项目联系：可借鉴迁移流程，但人形灵巧手与普通夹爪差异较大" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_1_branch_3" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_1_field_4" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：人形机器人多指操作的控制维度高，真机直接强化学习成本大&lt;br&gt;&lt;br&gt;为什么重要：为接触密集任务的 Sim2Real 训练流程提供参照" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_1_branch_4" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1645.0" as="sourcePoint"/><mxPoint x="562" y="1645.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_1_field_5" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：视觉多指操作的仿真到现实迁移&lt;br&gt;Sim2Real 指先在模拟器内训练，再把策略放到真实机器人；本文平台是 Fourier GR1 人形机器人，双臂和双多指手共同控制，而非单夹爪抓取&lt;br&gt;核心问题：双手多指操作有高维关节、复杂接触和视觉误差，在真机靠试错训练代价高；仿真策略又易因电机、摩擦和相机差异失效&lt;br&gt;作者问怎样组合模型校准、奖励设计、探索与视觉表示，让仿真强化学习策略实际完成双手任务&lt;br&gt;之前方法的问题：已有灵巧手强化学习多偏单手或直接用物体真实状态，难覆盖视觉双臂协作；纯真人示范采集费时&lt;br&gt;低成本人形机器人的关节跟踪与接触物理更难匹配仿真，仅靠一个通用奖励也难探索长程交接" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="1870" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_1_branch_5" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2224.5" as="sourcePoint"/><mxPoint x="562" y="2224.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_2_field_1" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：仿真策略可能因视觉、动力学和接触差异在真机失败" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_2_branch_1" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_2_field_2" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_2_branch_2" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="822.0" as="sourcePoint"/><mxPoint x="1252" y="822.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_2_field_3" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：视觉模仿学习通过大量真人示范学习动作，接触密集任务往往需要昂贵采集；仿真强化学习可在模拟器中反复试错&lt;br&gt;本文仍用少量人手姿态帮助初始化，并用仿真专家轨迹蒸馏，不能理解成完全没有人工先验&lt;br&gt;相关方向 2：过去的灵巧手 Sim2Real 常对单手旋转或抓取使用真实物体位姿、状态或高精度硬件；视觉双臂人形机器人还要协调两手与低精度电机&lt;br&gt;本文把真机参数校准、视觉目标位置和深度图一起纳入训练与部署流程&lt;br&gt;代表工作：作者指出已有方法用动作捕捉的人手轨迹或单手强化学习解决部分操作，论文自身以 Fourier GR1 和两种手结构作验证&lt;br&gt;它们是研究背景；本文的核心证据来自校准、奖励、初始化、蒸馏和视觉输入的消融，而非复用某个 VLA 基座&lt;br&gt;与已有方法的区别：先用少量真实关节运动自动匹配模拟器，再用物体表面接触标记与目标位置定义奖励&lt;br&gt;分物体训练强化学习专家、筛选成功轨迹后蒸馏成视觉扩散策略，结合头部深度和外部相机估计的物体位置部署真机" vertex="1">
          <mxGeometry height="919" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_2_branch_3" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1499.5" as="sourcePoint"/><mxPoint x="1252" y="1499.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_3_field_1" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;在仿真中训练视觉条件强化学习策略，再迁移到人形机器人完成抓取、搬箱等灵巧任务" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_3_branch_1" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_3_field_2" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：厂家模型与真实关节响应不一致会毁掉接触策略；作者让真机与多组仿真模型执行同一批关节目标，选跟踪误差最小的物理及机器人参数&lt;br&gt;校准仅用不足四分钟真机数据；物体则用圆柱、方块等简形并随机化质量和摩擦&lt;br&gt;贡献 2：双手交接难用单一终点奖励引导；作者在仿真物体表面放接触标记，奖励指尖接近指定位置并让物体到达阶段目标&lt;br&gt;少量人操作状态作为训练初始姿态，增加早期碰到有效接触状态的机会；这不是收集完整专家轨迹&lt;br&gt;贡献 3：多物体一起从头强化学习探索困难；作者先分别训练专家，筛选成功仿真轨迹，再蒸馏为共享的视觉扩散策略&lt;br&gt;部署输入是机器人关节、外部相机估计的物体三维位置与头部相机分割深度，并在训练中随机扰动物体、相机和动作延迟&lt;br&gt;方法流程：短时真机关节轨迹 → 自动校准 Isaac Gym 模型与随机化；定义接触和物体目标奖励 → 分任务强化学习专家&lt;br&gt;筛选成功轨迹并训练扩散动作策略 → SAM2 跟踪物体、融合外部三维位置与头部深度 → 输出双臂和双手关节目标，在 GR1 上以 5 Hz 闭环执行" vertex="1">
          <mxGeometry height="989" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_3_branch_2" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1042.5" as="sourcePoint"/><mxPoint x="1942" y="1042.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_3_field_3" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_3_branch_3" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1779.5" as="sourcePoint"/><mxPoint x="1942" y="1779.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_4_field_1" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：论文报告 grasp-and-reach、box lift 等三项任务&lt;br&gt;&lt;br&gt;主要结果：论文摘要未给可安全复述的统一量化成功率&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：论文报告 grasp-and-reach、box lift 等三项任务&lt;br&gt;&lt;br&gt;实验与结果：主要结果：论文摘要未给可安全复述的统一量化成功率" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_4_branch_1" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_4_field_2" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：Fourier GR1 双 7 自由度机械臂配六主动自由度多指手，另试 Inspire 手；任务为单手抓取搬运、双手抬箱和一手向另一手交接&lt;br&gt;真机用头部与外部 RealSense 深度相机，物体形状、质量、姿态和目标位置变化，每件测试物体试 10 次&lt;br&gt;对照：真实关节跟踪误差低、中、高的仿真模型训练相同策略；另比较有无人手初始姿态、不同物体分组训练、仅深度与深度加三维位置&lt;br&gt;既测仿真专家是否学成，也测蒸馏策略在真机的抓起阶段和整任务成功，不能混用两种指标&lt;br&gt;结果：真机整系统按测试物体平均成功率为抓取搬运 62.3%、双手抬箱 80%、双手交接 52.5%&lt;br&gt;校准误差最低组的抓取/到位成功检查点为 8/10、7/10，中误差 3/10、3/10，高误差均 0/10，说明模型匹配与迁移效果有关&lt;br&gt;关键补充：表 3 的真机深度加物体位置，在四组条件下整任务为 10/10、10/10、9/10、5/10；仅深度为 2/10、0/10、0/10、0/10&lt;br&gt;人手初态让交接训练成功的随机种子从 0/10 到 3/10，抬箱仍为 9/10；这些是局部消融，不是全系统平均成功率" vertex="1">
          <mxGeometry height="919" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_4_branch_2" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1196.5" as="sourcePoint"/><mxPoint x="2632" y="1196.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_5_field_1" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可借鉴迁移流程，但人形灵巧手与普通夹爪差异较大&lt;br&gt;&lt;br&gt;主要局限：不能从人形任务结果直接推断双臂普通夹爪表现&lt;br&gt;&lt;br&gt;局限与启发：主要局限：不能从人形任务结果直接推断双臂普通夹爪表现" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_5_branch_1" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_70_5_field_2" parent="paper_70" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：距离人类通用操作仍远；动态交接成功率偏低，动力学差异只用了常规域随机化来缓解&lt;br&gt;多指硬件主动自由度和可靠性仍有限，作者提出未来研究更强的人类先验及其他控制方式，例如力矩控制&lt;br&gt;我的理解 / 不足：部署策略并非从像素直接估计全部状态，依赖 SAM2 分割跟踪和外部相机三维位置；遮挡或相机偏差可能放大误差&lt;br&gt;方法含硬件专用校准和仿真接触标记，换成 DH116 后不能沿用同一关节、摩擦或奖励参数，这是迁移推断&lt;br&gt;未来展望：把动力学随机化与真实接触数据结合，分别量化交接时手指打滑、目标定位和动作延迟造成的失败&lt;br&gt;还可在相同对象集上比较外部相机缺失、不同手结构与更高控制频率，检验哪些条件决定可迁移性&lt;br&gt;对我们项目的启发：DH116 与双臂平台可借鉴短时关节校准、接触标记奖励和分任务专家到视觉策略的训练路径&lt;br&gt;先测手指欠驱动映射、外部相机与头部视角、接触安全及真实成功率；论文提供 Sim2Real 实例，但未验证 VLA 记忆或失败后自主恢复" vertex="1">
          <mxGeometry height="849" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_70_5_branch_2" edge="1" parent="paper_70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1091.5" as="sourcePoint"/><mxPoint x="3322" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
