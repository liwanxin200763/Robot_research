            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_21_bottomnav_1" label="返回分类" link="data:page/id,literature-page-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_21_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-15" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_21_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-26" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_21_1_field_1" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_1_branch_1" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_1_field_2" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：开放世界移动操作跨越多次观测；物体被移动或移走后，静态语义地图会给机器人错误目标位置。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：让机器人在持续变化的室内场景中维护可用于定位、搜索与抓取的在线三维语义记忆。（第 1 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_1_branch_2" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_1_field_3" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;仅追加观测的地图会保留已经消失的物体；只在初始时建图的策略不能处理后续布局变化。（第 2 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_1_branch_3" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1440.0" as="sourcePoint"/><mxPoint x="562" y="1440.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_1_field_4" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：移动机器人保存可更新的三维场景记忆；目标会移动、出现或消失。它不是直接由图文生成动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作）&lt;br&gt;核心问题：杯子昨天在桌上、今天被拿走了。机器人怎样不再去旧位置找它？&lt;br&gt;之前的问题：只追加旧画面或固定地图会把已经移动的物体仍记在原处，导致找错目标" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1658" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_1_branch_4" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1907.5" as="sourcePoint"/><mxPoint x="562" y="1907.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_2_field_1" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：与 LT-Mem 相比，DynaMem 更直接维护行动用三维地图；LT-Mem 更强调跨会话变化率。两者均不同于策略内部工作记忆" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_2_branch_1" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_2_field_2" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_2_branch_2" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_2_field_3" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：三维语义地图把物体位置和图像特征放在地图里，支持按语言找目标&lt;br&gt;相关方向 2：长期记忆能保存过去所见，但环境变化后还必须判断哪些旧记录已失效&lt;br&gt;代表对照：静态 OK-Robot 和只追加不删除的记忆；比较目标位置变化后还能否找到它&lt;br&gt;区别：新深度画面若显示原位置已经空了，就删除与实测场景矛盾的旧三维记录" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_2_branch_3" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1359.5" as="sourcePoint"/><mxPoint x="1252" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_3_field_1" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：保存带视觉特征和最后观测时间的稀疏体素；新深度观测用于加入新点，并通过射线检查删除与当前观测冲突的旧点。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：RGB-D 观测更新稀疏三维点云；每个体素记录位置、观测次数、图像来源、CLIP/SigLIP 特征及最后观测时间。查询可用视觉语言相似度或多模态模型选择候选视图，再用 OWLv2 确认目标；目标不存在时启动探索，移动途中按新观测重规划。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_3_branch_1" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_3_field_2" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：Stretch 移动机器人的 RGB-D、相机位姿、语言目标和已有体素记忆。记忆是三维语义点云，不是语言事件日志或 VLA 隐层 token。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：输出目标定位、导航路点以及抓取和放置动作；底层抓取使用现成模块。允许重新观察、搜索与导航重规划；未提出等待、动作回滚或失败后技能选择。（第 3–4 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：观测投影为稀疏体素；更新时按当前视线和深度删除过期空间证据，再融合新证据。论文未报告针对该系统的独立数据增强消融。（第 3 节）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_3_branch_2" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1021.5" as="sourcePoint"/><mxPoint x="1942" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_3_field_3" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心是在线记忆维护和检索系统，使用预训练视觉模型与现成操作组件；论文并未训练端到端 VLA 策略。（第 3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_3_branch_3" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1559.0" as="sourcePoint"/><mxPoint x="1942" y="1559.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_3_field_4" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：深度相机每次拍摄后，把物体附近空间、图像特征、见过次数和时间写进三维小格&lt;br&gt;贡献 2：新画面来了就合并或更新小格；若深度证据说明旧位置已空，再删除过时小格&lt;br&gt;贡献 3：按文字查地图中的目标，再用视觉检测核实；没找到时继续探索，不只相信旧位置&lt;br&gt;流程：深度画面与相机位置→更新/删除地图记录→按指令找物体→抓取→再观察并更新" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_3_branch_4" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2026.5" as="sourcePoint"/><mxPoint x="1942" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_4_field_1" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：在实验室及公寓场景进行真实 RGB-D 建图和移动操作；DynaBench 包含九个场景及跨轮次布局变化。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：DynaBench 九场景多轮变化，并在真实实验室和两处公寓测试定位、导航和取放；比较静态地图及不同记忆更新与查询配置。（第 4 节、表 1）&lt;br&gt;&lt;br&gt;真机实验：实验室 30 次取放查询成功率 70%，静态 OK-Robot 为 30%；两处公寓共成功 9/17 次。（第 4 节）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_4_branch_1" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_4_field_2" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：DynaBench 默认视觉语言查询成功率 70.6%；仅追加记忆为 67.8%，混合查询为 74.5%，人工参照为 81.9%。（表 1）&lt;br&gt;&lt;br&gt;消融实验：仅追加记忆不如包含删除与更新的方案；混合查询优于单一路径，显示过期信息清理与候选验证均有作用。（表 1）&lt;br&gt;&lt;br&gt;Failure Case：公寓失败包含导航四次、操作三次和放置一次；近似颜色物体与抓取误差也会使正确定位不能转化为任务成功。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_4_branch_2" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1039.0" as="sourcePoint"/><mxPoint x="2632" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_4_field_3" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：DynaBench 有 9 个会变化的场景，也测移动机器人在真实环境里寻找和抓放物体&lt;br&gt;对照：与只追加记录和静态 OK-Robot 比较，主要看目标是否找对以及任务最终是否完成&lt;br&gt;结果：视觉语言查询结果为 70.6%，只追加记忆为 67.8%；混合查询为 74.5%（论文报告）&lt;br&gt;真机：实验室 30 次抓取中成功 70%，静态 OK-Robot 为 30%；公寓任务成功 9/17" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_4_branch_3" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1618.5" as="sourcePoint"/><mxPoint x="2632" y="1618.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_5_field_1" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；跨轮次或行进中重新观察到物体出现、消失、移动，未以连续运动目标拦截为主要评测&lt;br&gt;&lt;br&gt;主要局限：作者展示的操作仍受现成抓取器与导航器限制。按本库分析，体素时间戳和射线删除提供过期清理，但不是对物体变化率的显式估计，也未系统处理执行残差或双臂协作&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可作为动态三维场景记忆模块和旧信息失效机制的基线。对双臂 VLA 的研究启发是把地图中的观测时效性接入行动前风险判断；这属于后续构想，论文未验证双臂和 DH116 灵巧手" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_5_branch_1" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="477.0" as="sourcePoint"/><mxPoint x="3322" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_21_5_field_2" parent="paper_21" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文重点是移动机器人的目标重定位；没有训练一套从视觉直接生成连续动作的 VLA&lt;br&gt;我的理解 / 不足：它会按新画面删错误位置，但没有专门判断失败动作记录是否值得写入记忆&lt;br&gt;未来展望：把“看见物体在哪儿”和“抓取是否成功”分开记录，给记忆附可信度&lt;br&gt;对我们项目的启发：可先复现地图写入、更新和删除；抓取失败时另做标记，避免旧位置反复误导" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_21_5_branch_2" edge="1" parent="paper_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1091.5" as="sourcePoint"/><mxPoint x="3322" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
