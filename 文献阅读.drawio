        </UserObject><UserObject id="paper_66_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-67" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_66_1_field_1" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL&lt;br&gt;引用量：50（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_1_branch_1" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_1_field_2" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_1_branch_2" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_1_field_3" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Bimanual Manipulation / Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论细粒度双臂操作需要在三维场景中同时定位两只手的关键区域。&lt;br&gt;核心思路是VoxAct-B 用 VLM 关注关键区域，再在体素空间中生成语言条件的双臂动作。&lt;br&gt;与当前项目的联系：项目联系：可参考两只普通夹爪的空间目标表示" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_1_branch_3" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_1_field_4" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：细粒度双臂操作需要在三维场景中同时定位两只手的关键区域&lt;br&gt;&lt;br&gt;为什么重要：把视觉目标定位与双臂三维动作表示连接起来" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_1_branch_4" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1680.0" as="sourcePoint"/><mxPoint x="562" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_1_field_5" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：非对称双臂模仿学习&lt;br&gt;非对称是两臂分工不同，一臂稳住抽屉或罐子，另一臂开拉或旋拧；体素把 RGB-D 三维空间离散为小立方格，可把目标位置当分类问题预测，而非直接回归关节角&lt;br&gt;核心问题：双臂要同时定位两只夹爪的六自由度姿态，示范少时直接回归高维关节动作较难&lt;br&gt;作者问能否集中高分辨率体素于目标附近，并按操作臂与稳定臂的职责学习可交换左右手的动作&lt;br&gt;之前方法的问题：全工作区体素若变密会显著增加内存和训练负担；只用稀疏全局体素又不利于精细抓把手和罐盖&lt;br&gt;固定左右手职责的模型在物体位置变化时难调整，依赖预设动作原语也限制跨任务使用" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1905" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_1_branch_5" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2224.5" as="sourcePoint"/><mxPoint x="562" y="2224.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_2_field_1" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;之前方法的问题：直接从全局图像预测高维双臂动作，可能忽略局部空间线索" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_2_branch_1" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_2_field_2" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLM：联合理解图像和文字的模型" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_2_branch_2" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="829.0" as="sourcePoint"/><mxPoint x="1252" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_2_field_3" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：PerAct 把语言与体素输入映射到单臂六自由度末端姿态、夹爪开合等离散动作，具空间对应性&lt;br&gt;VoxAct-B 在其上扩成操作与稳定两类策略，并通过缩小物理覆盖范围保持同体素数下的局部精度&lt;br&gt;相关方向 2：ACT 用动作块学习高频双臂关节控制，Diffusion Policy 学多模态动作分布；论文把二者改到相同任务比较&lt;br&gt;它们在较少示范和较大场景变化下表现较弱，但属于实验对照，不是 VoxAct-B 的动作解码组件&lt;br&gt;代表工作：VoxPoser 用语言模型构造三维可行性和约束图，再以运动规划执行；它可处理开放指令，却可能难精确处理接触&lt;br&gt;Stabilize to Act 分离稳定与操作角色，但使用俯视关键点；本篇研究双臂六自由度姿态并用目标附近体素决策&lt;br&gt;与已有方法的区别：OWL-ViT 检测语言指定物体，Segment Anything 给出掩码中心，结合深度估计三维目标位置&lt;br&gt;同时判定哪只手执行操作、哪只手稳定物体；相同体素数只覆盖目标局部，使每格代表更小真实距离" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_2_branch_3" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1478.5" as="sourcePoint"/><mxPoint x="1252" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_3_field_1" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;VoxAct-B 用 VLM 关注关键区域，再在体素空间中生成语言条件的双臂动作" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_3_branch_1" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_3_field_2" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：全局体素精度与计算成本冲突，作者先从正面 RGB 图和物体名称检测框，再分割目标并用 RGB-D 点云求位置&lt;br&gt;以目标为中心裁剪三维工作区，保持体素数量不变却提高单位空间分辨率；目标大到覆盖全场时此策略受限&lt;br&gt;贡献 2：左臂和右臂的功能会随抽屉朝向或罐子位置交换；训练数据把动作标为 acting 或 stabilizing，并输入双臂本体状态、指令及臂 ID&lt;br&gt;两类 PerAct 式网络分别预测下一末端位置、离散旋转、夹爪开合和避障标志，以动作角色而非固定左右臂分工&lt;br&gt;贡献 3：作者把 RLBench 扩展为开罐、开抽屉、放物入抽屉和双手交接四项双臂任务，左右臂角色各占一半示范&lt;br&gt;示范以关键帧监督两臂离散动作分类，使同一评测可检验少量示范、物体位置变化和角色切换&lt;br&gt;方法流程：语言任务和正面 RGB → OWL-ViT 检测、SAM 分割 → RGB-D 定位目标并构建局部体素&lt;br&gt;语言与目标位姿确定左右臂角色 → 两类策略读取体素及双臂状态，输出各自六自由度夹爪目标 → 运动规划器执行并再次观察" vertex="1">
          <mxGeometry height="884" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_3_branch_2" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="990.0" as="sourcePoint"/><mxPoint x="1942" y="990.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_3_field_3" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1460" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_3_branch_3" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1674.5" as="sourcePoint"/><mxPoint x="1942" y="1674.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_4_field_1" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：仿真细粒度双臂任务；真机覆盖需进一步核验&lt;br&gt;&lt;br&gt;主要结果：作者报告在仿真任务上优于所比较基线；摘要未给统一量化值&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：仿真细粒度双臂任务；真机覆盖需进一步核验&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告在仿真任务上优于所比较基线；摘要未给统一量化值" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_4_branch_1" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_4_field_2" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：RLBench 双臂仿真四任务，每任务用 10 或 100 条示范；25 个未见测试回合、5 个训练种子求平均成功率&lt;br&gt;比较 ACT、Diffusion Policy、VoxPoser 和左右臂分别训练的 PerAct；后者因计算限制只做 10 示范设置&lt;br&gt;对照：10 条示范时，开罐、开抽屉、放物入抽屉、交接物体的 VoxAct-B 成功率依次 40.0%、73.6%、39.2%、19.2%&lt;br&gt;同条件 ACT 为 4.0%、12.8%、8.8%、1.6%；这些百分比对应仿真测试，不是两台 UR5 的真机结果&lt;br&gt;结果：100 条示范时四任务为 59.2%、72.8%、49.6%、14.4%，交接物体没有随示范增加而提高&lt;br&gt;开抽屉 10 示范消融从完整 73.6% 降至无 VLM 裁剪 19.2%，无分割 67.2%，无角色分工 64.8%，支持局部体素与分工设计&lt;br&gt;真机 / 关键补充：两台 UR5 配平行夹爪，各任务约 10 条遥操作训练示范；开抽屉 10 次成功 6 次，固定角色开罐 10 次成功 5 次&lt;br&gt;角色可交换的开罐另用 20 条示范，10 次成功 5 次；失败包括关节到限位、把手／罐盖抓取偏差和碰撞" vertex="1">
          <mxGeometry height="884" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_4_branch_2" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1214.0" as="sourcePoint"/><mxPoint x="2632" y="1214.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_5_field_1" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可参考两只普通夹爪的空间目标表示&lt;br&gt;&lt;br&gt;主要局限：体素分辨率与真机延迟、遮挡和接触误差需验证&lt;br&gt;&lt;br&gt;局限与启发：主要局限：体素分辨率与真机延迟、遮挡和接触误差需验证" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_5_branch_1" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_66_5_field_2" parent="paper_66" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：目标若占据大部分工作区，局部裁剪会丢掉相关空间；检测或分割偏差也可能把体素中心放错&lt;br&gt;真机开抽屉会遇关节限位、碰撞和把手抓取不准，开罐时稳定臂较稳但操作臂抓罐盖精度不足&lt;br&gt;我的理解 / 不足：少样本仿真成绩显示表示有价值，但交接物体 100 示范结果低于 10 示范，方法仍受任务差异影响&lt;br&gt;真机每项仅 10 次测试、对象和相机布局有限，不能推断未见硬件或 DH116 多指抓握能直接迁移&lt;br&gt;未来展望：可分别测目标分割偏移、深度噪声与裁剪尺度对六自由度动作误差的影响，并在工作区较大时加入多尺度体素&lt;br&gt;真机需要把关节可达性、接触反馈和碰撞检查纳入角色选择及执行闭环；这些是由失败案例导出的后续建议&lt;br&gt;对我们项目的启发：双臂普通夹爪可先实现“稳定臂／操作臂”角色标签，比较全局体素与目标局部体素在同数据预算下的表现&lt;br&gt;接入 DH116 时须重设多指动作、接触判据和相机遮挡处理；原论文只验证平行夹爪，不证明灵巧手控制效果" vertex="1">
          <mxGeometry height="884" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_66_5_branch_2" edge="1" parent="paper_66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
