        <mxCell id="category_07_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="07 VLA 基础与泛化">
