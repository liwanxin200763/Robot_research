          </mxCell>
        </UserObject><UserObject id="paper_09_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-10" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_09_1_field_1" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_1_branch_1" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_1_field_2" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：机器人在长程操作中会遇到抓取落空、物体卡住和中间状态偏离；单纯重复原任务动作不一定能把环境带回可执行状态。（论文第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：如何从部署失败中构建可复用的恢复技能，并使任务策略在人工接管数据累积后减少对人的依赖。（论文第 1 节）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_1_branch_2" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_1_field_3" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;仅靠任务策略的 DAgger 更新，不能处理所有需要额外操作才能回到任务轨迹的状态；预先穷举恢复技能也难覆盖开放的失败形态。（论文第 1–2 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_1_branch_3" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1405.0" as="sourcePoint"/><mxPoint x="562" y="1405.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_1_field_4" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;首次 arXiv：2026年10月&lt;br&gt;研究方向：双臂任务失败后的诊断与恢复；用仿真试错、人类接管和真机记录逐步积累经验&lt;br&gt;核心问题：原任务做到一半失败后，怎样先把现场恢复到可继续操作的状态，再完成任务？&lt;br&gt;之前的问题：成功示范几乎没有失败后的状态；盲目重试原动作，挡路的物体可能仍在那里" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1623" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_1_branch_4" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1855.0" as="sourcePoint"/><mxPoint x="562" y="1855.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_2_field_1" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;与已有工作的关系：与 FailBank 的失败经验累积方向相邻，但这里突出恢复策略与可调用技能的独立学习及真机闭环" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_2_branch_1" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_2_field_2" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_2_branch_2" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_2_field_3" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：看图读指令并生成动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 从成功示范学正常动作；遇到失败现场时，不一定会补救&lt;br&gt;相关方向 2：恢复技能或人类接管可处理异常，但还需要判断何时调用以及是否真的修好&lt;br&gt;代表工作：ASPIRE、RATs、RecoveryChaining；比较技能扩充和独立恢复控制的做法&lt;br&gt;区别：正常任务和恢复任务分别训练；系统监控失败、选恢复动作，并在恢复后检查现场" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_2_branch_3" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1377.0" as="sourcePoint"/><mxPoint x="1252" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_3_field_1" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：在由真机记录和标定构建的 digital twin 中探索恢复轨迹，分别训练任务策略和恢复策略；部署时由监测器判断任务进展并调用恢复技能，必要时交给人示范。（论文第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：系统包含仿真环境、任务策略、恢复策略、code-as-policy 恢复技能、视觉监测器和人工接管环节。恢复经验写入独立数据集；任务与恢复策略分别更新，而非把全部轨迹混成一种监督信号。（论文第 3 节、图 2）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_3_branch_1" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_3_field_2" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：真机多视角相机观测、机器人状态、任务目标及监测器对执行状态的判断；具体输入随仿真和真机设置而异。（论文第 3–4 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：任务策略和恢复策略输出机器人控制动作；监测器在继续任务、调用恢复技能和请求人工接管之间选择。论文并未证明任意未见机器人形态可直接迁移。（论文第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：利用真机记录与标定建立 digital twin 并在其中生成成功任务轨迹和恢复轨迹；真实部署失败通过人工接管补入相应数据集。（论文第 3 节）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_3_branch_2" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1056.5" as="sourcePoint"/><mxPoint x="1942" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_3_field_3" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务策略先训练，再以 DAgger 数据改进；恢复策略和可调用技能使用失败状态及恢复轨迹构建。监测与技能选择属于部署闭环。（论文第 3–4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_3_branch_3" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1594.0" as="sourcePoint"/><mxPoint x="1942" y="1594.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_3_field_4" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：在重建的仿真场景里反复试做任务与补救动作，生成两类示范数据&lt;br&gt;贡献 2：真机执行时观察进度；失败后调用恢复技能，并检查物体状态能否让原任务继续&lt;br&gt;贡献 3：把人或机器人产生的记录分成“正常任务”和“恢复”两类，多轮更新对应策略&lt;br&gt;流程：做原任务→监测失败→判断需补救什么→运行恢复技能→确认现场可继续→再做原任务" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1812" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_3_branch_4" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2061.5" as="sourcePoint"/><mxPoint x="1942" y="2061.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_4_field_1" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：仿真部分使用 MolmoSpaces 与 LIBERO-Pro；真机为四项双臂操作任务，并通过并行 YAM 工作站收集接管数据。（论文第 4 节、表 1–3）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：MolmoSpaces 四类任务、LIBERO-Pro 六种设置，以及四项真机任务。真机表 3 每任务、每配置 20 次试验。（论文第 4 节、表 1–3）&lt;br&gt;&lt;br&gt;真机实验：双臂 YAM 配平行夹爪及四台 RealSense 相机；实验比较初始策略、加入 DAgger、再加入恢复技能。四工作站接管率变化只在其中一个任务上展示。（论文第 4.3 节、表 3、图 6）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_4_branch_1" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="459.5" as="sourcePoint"/><mxPoint x="2632" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_4_field_2" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;MolmoSpaces 平均成功率 64.9%，对照 RATs 为 38.0%（表 1）；LIBERO-Pro 平均 78.8%，对照 ASPIRE 为 71.7%，但并非每个子设置都领先（表 2）。四项真机平均成功率从 23.8% 升至加入 DAgger 后 77.5%，再加入恢复技能为 87.5%（表 3）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_4_branch_2" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1004.0" as="sourcePoint"/><mxPoint x="2632" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_4_field_3" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融实验：表 3 的递增配置显示 DAgger 和恢复技能各自带来增益；这是组合配置比较，论文没有在完全等量训练数据下隔离每个系统模块的因果作用&lt;br&gt;&lt;br&gt;Failure Case：文中展示环卡住、抓取落空、托盘卡阻等需要重新定位或清障的失败。若监测器误判、技能库无相应动作，仍需人工接管。（论文第 3–4 节、图 5）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_4_branch_3" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1461.0" as="sourcePoint"/><mxPoint x="2632" y="1461.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_4_field_4" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：测试 LIBERO-Pro 六种设置、MolmoSpaces 四类任务，还做四项真实双臂任务&lt;br&gt;对照：与 ASPIRE、RATs 和多个直接从画面及文字生成动作的 VLA 比较&lt;br&gt;结果：LIBERO-Pro 平均成功率为 78．8%，最强基线 71．7%；MolmoSpaces 报告 64．9%&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真机：四台双臂 YAM 工作站测四项任务；系统各阶段成功率由 23．8% 到 77．5%，再到 87．5%" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_4_branch_4" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1988.0" as="sourcePoint"/><mxPoint x="2632" y="1988.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_5_field_1" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；失败造成中间场景变化，未报告持续运动目标评测&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：视觉监测发现任务偏离并调用恢复技能或人工接管；覆盖失败状态识别、恢复选择、执行、任务续接和 DAgger 学习，最终以任务成功评价。抓空、卡住等类型有示例，但没有系统的细粒度根因标签及逐步恢复正确性验证&lt;br&gt;&lt;br&gt;主要局限：作者在结论中提出自动注册与共享恢复技能仍是后续方向。另从实验范围看，digital twin 与实物的偏差、监测器失误和四项真机任务的覆盖度限制了更广泛的泛化结论；后者是本库分析，不是作者报告的独立消融。（论文第 5 节）" vertex="1">
          <mxGeometry height="709" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_5_branch_1" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="494.5" as="sourcePoint"/><mxPoint x="3322" y="494.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_5_field_2" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;为普通夹爪双臂任务提供“监测—恢复—接管—再训练”框架；值得进一步验证恢复技能跨任务共享、监测误判代价和少量示范下的收益" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="877" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_5_branch_2" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1067.0" as="sourcePoint"/><mxPoint x="3322" y="1067.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_09_5_field_3" parent="paper_09" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者把新恢复技能的自动加入和跨任务共享留作后续工作&lt;br&gt;我的理解 / 不足：监测器若判断错或仿真现场与真机不符，恢复也会受影响；真机只测四项任务&lt;br&gt;未来展望：让系统从新失败里自动学会新补救动作，减少人接管，并测更多任务&lt;br&gt;对我们项目的启发：小的执行偏差可先补偿；若现场已被破坏，应调用独立恢复动作并验证结果" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_09_5_branch_3" edge="1" parent="paper_09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1517.0" as="sourcePoint"/><mxPoint x="3322" y="1517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
