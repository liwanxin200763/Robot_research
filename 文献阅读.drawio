            <mxGeometry x="3180" y="4386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_10_1_field_1" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：0（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_1_branch_1" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_1_field_2" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_1_branch_2" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_1_field_3" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA 在复杂操作场景里须同时完成任务、避开不希望接触的物体。部署时的 CBF shield 能修正单步动作，但原 VLA 不变；若它不断提出与 shield 冲突的动作，局部安全修正可能导致任务停滞。作者尝试把这些运行时纠正变为持久的策略训练信号。（论文第 1–3 节，图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_1_branch_3" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1153.0" as="sourcePoint"/><mxPoint x="562" y="1153.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_1_field_4" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文要解决的问题：在不把安全 shield 固定留在部署闭环的情况下，利用 VLA 自己执行时的失败轨迹和安全教师提出的反事实动作，改进任务成功率与策略造成的接触代价，并检验对未参与数据收集的任务、难度与另一骨干的转移。（第 4–5 节）&lt;br&gt;&lt;br&gt;之前方法存在的问题：直接运行时屏蔽只改变当下执行动作，无法消除策略—屏蔽器持续分歧；若把屏蔽器放进训练轨迹的执行闭环，收集到的“失败”可能是屏蔽器诱发的，而非原策略失败。只学纠正动作也可能丢失原策略已会的成功行为，故作者提出旁路观察、结果筛选与保守更新。（第 1、4、6.1 节，图 5）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1378" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_1_branch_4" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1697.5" as="sourcePoint"/><mxPoint x="562" y="1697.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_1_field_5" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;首次 arXiv：2026年9月&lt;br&gt;研究方向：机器人运行时发现并记录危险或错误动作，之后用这些记录改进原策略&lt;br&gt;核心问题：安全系统一直替策略纠正动作，策略自己却没学会；怎样让它下次少犯同类错？&lt;br&gt;之前的问题：安全屏蔽器只改眼前一步；原策略不变，就可能一直提出冲突动作，拖慢任务" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="2045" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_1_branch_5" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2277.0" as="sourcePoint"/><mxPoint x="562" y="2277.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_2_field_1" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_2_branch_1" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_2_field_2" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_2_branch_2" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_2_field_3" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;AEGIS 通过运行时 CBF 改执行动作，FailBank 借固定 CBF 教师的旁路建议改变后续策略权重；两者在成功—代价之间有不同权衡。与 MemoryVLA 的时间记忆不同，本文的 bank 是离线训练记录池，部署时不检索历史失败案例。与 DIAL 的未来意图学习也不同，它直接对运行时动作纠正做后训练。（第 2–5 节；附录 E.3）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_2_branch_3" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_2_field_4" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：安全屏蔽器在动作执行前改掉可能碰撞的命令，能挡当前风险但不改策略&lt;br&gt;相关方向 2：把失败和纠正记录变成训练例子，才能让模型之后自己少提有问题的动作&lt;br&gt;代表工作：AEGIS 负责运行时保护，VLA（视觉—语言—动作模型，把图像和指令变成机器人动作）-Arena 提供测试场景，LoRA 是轻量更新模型的工具&lt;br&gt;区别：旁路教师只在收集阶段给建议；筛过数据后更新策略，之后不必每一步依赖教师" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_2_branch_4" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1680.0" as="sourcePoint"/><mxPoint x="1252" y="1680.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_1" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;四阶段：①当前策略实际执行，固定 CBF 教师只在旁路提出纠正；②按轨迹结果、纠正时机和安全／进度信号筛选有用记录，并可保留成功且未触发教师的动作；③把各轮合格记录累积进 failure bank；④每轮从同一个 base checkpoint 训练 LoRA 候选，通过留出数据的损失／动作漂移门槛才替换下一轮采集策略。部署采用学到的策略，不调用教师。（第 4.1–4.5 节，图 3）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_1" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_2" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略生成名义动作，教师利用仿真中额外可得的障碍几何，解 CBF 约束投影，仅提出平移通道的替代动作；环境始终执行名义动作。记录观测、指令、原动作、教师提议、触发标志和最终结果。触发记录的得分结合一步安全、任务进度、已观察到的恢复与后续代价，拒绝无效／过晚建议；成功未触发的记录称 quiet anchors。LoRA 训练以带权第一动作 flow-matching 损失学习；留出集用完整动作块损失和相对 base 的第一动作漂移筛选。（第 4 节；附录 E.1）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_2" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="899.0" as="sourcePoint"/><mxPoint x="1942" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_3" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;部署时沿用 π0.5 或 π0 的视觉、语言与本体观测，论文未为它们增加可在真机直接获得的障碍真实坐标。旁路 CBF 教师在训练收集阶段使用仿真器特权几何；对照 AEGIS 在运行时另通过 GLM-4.5V 做视觉定位。不能把教师的仿真真值误写成部署策略输入。（第 4.2、5.1 节；附录 E.1、E.3）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_3" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_4" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;π0.5／π0 是带连续 flow-matching 动作头的 VLA。教师只修正名义动作的平移分量，训练时以第一动作作为纠正目标；实际部署仍由更新后的 VLA 输出动作块，仿真每步重新规划。附录表 15 的动作 horizon 为 π0.5 的 10 步、π0 的 50 步，每回合上限 300 控制步。这套监督和 guard 不能直接套用离散动作 Token 模型。（第 4 节；附录 E.1，表 15）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_4" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1883.0" as="sourcePoint"/><mxPoint x="1942" y="1883.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_5" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;教师提议只作为反事实标签，不改变被采集的执行分布。对失败轨迹仅保留距离危险接触较早的纠正：附录把超过 30 步、15–30 步和 0–15 步分别划为早期、中期、紧急，拒绝紧急和接触后纠正；再按分数门槛给触发记录 0／0.25／0.60／1.00 权重。数据按 episode 先切训练／验证，再筛选，防止留出 guard 与训练 bank 重叠。Quiet anchors 仅来自成功、未触发纠正的原动作，不等于所有无触发步。（第 4.3–4.4 节；附录 E.1.2–E.1.3）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2143" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_5" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2392.5" as="sourcePoint"/><mxPoint x="1942" y="2392.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_6" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;每轮从同一原始 πbase 而非上一轮权重出发拟合新 LoRA，保留此前 bank；只有候选的留出完整动作块损失比率和第一动作偏移均不超过预设阈值才接受。附录表 15：PaliGemma 2B LoRA rank 16、动作专家 LoRA rank 32，AdamW、batch 32、主更新 800 步、峰值学习率 3×10⁻⁵。关键口径：主 π0.5 实验的 quiet-anchor 权重 λq＝0；五轮曲线实验取 0.2，跨骨干 π0 取 0.5。因而不能将主表增益直接归因为 quiet-anchor 训练。失败候选被丢弃，但合格记录仍留在 bank。（第 4.5 节；附录 E.4，表 15–16）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="2670" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_6" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2954.5" as="sourcePoint"/><mxPoint x="1942" y="2954.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_3_field_7" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把运行中的错误、教师建议和后续结果记下来，筛选后作为下一轮训练数据&lt;br&gt;贡献 2：训练时保留原本正确的动作，避免只学纠错样本后把已会的行为改坏&lt;br&gt;贡献 3：新模型先过留出数据检查；只有训练损失和动作变化都合格，才接替旧模型&lt;br&gt;流程：策略执行并收教师建议→筛出有用失败与成功记录→更新模型→验证合格后部署" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="3267" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_3_branch_7" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3516.5" as="sourcePoint"/><mxPoint x="1942" y="3516.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_4_field_1" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;基准是 VLA-Arena 静态障碍安全套件，各难度有五项任务。作者从 Level 1 的 Mango 单一任务收集策略执行轨迹，在五项 Level 1 和五项更难的 Level 2 任务上测试；后九项未进入主训练 bank。主静态两轮 bank 经筛选后有 6,535 条记录，其中 2,863 条触发 CBF、3,672 条未触发；另有留出验证折。12,343 是筛选前数据池，不是实际用于该主更新的训练量。实验没有真实机器人轨迹或真机成功率。（第 5.1 节；附录 E.2，表 16）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_4_branch_1" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_4_field_2" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;主比较在 VLA-Arena 静态障碍 Level 1／2 各五任务上，用相同初始状态比较 Base、AEGIS 运行时屏蔽和 FailBank 更新后的策略；两个骨干为 Arena 已微调的 π0.5 和 π0。指标包括任务成功率 SR、官方累计代价 CC、扣除初始状态已有代价后的策略造成代价 CCpolicy，以及归一化的成功—代价综合分 BRS。代价指标不能与成功率混为一个“安全成功率”。作者另做动态障碍压力测试和多轮实验，但不纳入主静态结果。（第 5–6 节；附录 B.10）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_4_branch_2" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="916.5" as="sourcePoint"/><mxPoint x="2632" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_4_field_3" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;没有真机实验。全部主结果来自 VLA-Arena 仿真；训练时 CBF 教师依赖仿真器特权障碍几何，而部署策略省去该教师。作者报告的运行时延迟审计是匹配主机上的相对 wall-clock 比较，包含服务启动和 checkpoint 恢复，不能当作隔离的真机推理延迟或安全部署验证。（第 4–5 节；附录 E.3）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_4_branch_3" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1408.5" as="sourcePoint"/><mxPoint x="2632" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_4_field_4" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 1 十项静态任务等权均值：π0.5 的 Base→FailBank，SR 66.0→74.5%、CCpolicy 47.76→30.76；π0 的 SR 47.5→54.4%、CCpolicy 10.62→8.09，分别对应成功率增加 8.5／6.9 个百分点、策略代价下降 35.6／23.8%。对 AEGIS，π0.5 的 SR 49.1→74.5%、π0 的 44.9→54.4%；但 FailBank 的 CCpolicy 30.76／8.09 高于 AEGIS 的 29.01／6.27，即成功率更高但代价并非同样更低。Level 1 Mango 留出初始状态 π0.5 SR 71.1→93.3%；未采集的四个 Level 1 任务 82.5→88.7%，五个 Level 2 任务 50.5→59.4%。这些是指定模拟分布内的转移证据。（第 5.2–5.3 节，表 1，图 4；附录 B.8）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_4_branch_4" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1953.0" as="sourcePoint"/><mxPoint x="2632" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_4_field_5" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;图 5：让 shield 真正进入采集执行闭环，在 46 个配对回合里令原本成功的 8 次失败、救回 5 次，成功回合由 40 降至 37；其失败记录 88.9% 源于 shield 自身引发的失败。Level 1 Onion 的训练信号消融中，Base SR／CCpolicy 为 65%／38.61，只用触发纠正记录为 89%／20.88，再加入有正权重的 quiet anchors 为 89%／16.52。该 quiet-anchor 消融与主表 λq＝0 设置不同。五轮 bank 从约 3.7k 增至 22.7k 条，SR 于第 2 轮最高、CCpolicy 于第 3 轮最低，不是轮数越多越好。（第 6.1–6.2 节，图 5–6；附录 E.4）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="2283" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_4_branch_5" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2567.5" as="sourcePoint"/><mxPoint x="2632" y="2567.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_4_field_6" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;第 3 节图 2 的 Level 2 Onion 显示 AEGIS shield 反复把名义动作从目标旁的障碍物拉开，最终回合超时；这是基线屏蔽器与策略不匹配的示例。FailBank 自身并非全任务改进：表 1 的 Level 2 Lemon 在 π0.5 骨干上三者 SR 都是 0%；π0 骨干的 Level 1 Onion，Base 28%、FailBank 24%。静态更新向动态障碍转移的配对检验 p＝0.5078，不足以确认收益；部分多轮更新还因 guard 被拒绝。（第 3、5–6 节，表 1；附录 B.10、E.7）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2880" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_4_branch_6" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3129.5" as="sourcePoint"/><mxPoint x="2632" y="3129.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_5_field_1" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：主实验为静态障碍；另有动态障碍压力测试，但静态更新向动态场景转移未获显著支持&lt;br&gt;&lt;br&gt;主要局限：失败闭环覆盖：旁路 CBF 标记潜在危险并在 episode 结果后筛选记录；bank 保留观测、原命令、教师提议、触发与结果。它从失败中离线/轮次式更新策略，部署时不执行在线恢复选择、场景复原或失败原因诊断" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_5_branch_1" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_5_field_2" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确指出：当前只覆盖连续 flow-matching 动作头；离散或其他动作表示需要另改监督与 guard；主要评估静态障碍，动态场景需预测移动障碍并改造教师。附录动态压力测试未支持静态更新的显著转移。（第 6.3 节；附录 B.10）本库分析：未做真实机器人、安全事故和双臂接触控制验证；教师标签来自特权几何，换成实际视觉估计后标签误差、数据采集风险和计算开销仍需单独测试。论文现有结果不能视为实际部署时的安全保证" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_5_branch_2" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="881.5" as="sourcePoint"/><mxPoint x="3322" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_5_field_3" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;对双臂普通夹爪与执行错误研究，值得借鉴“策略自己执行—旁路纠正建议—按结果筛选—受限更新”的闭环，并把成功率、接触代价、超时分别记录。潜在研究启发：在双臂任务中区分策略本身失败与安全模块诱发失败，并测试纠正记录是否提升下一轮操作；若教师只能看到摄像头或触觉而无仿真真值，还要测标签可信度。论文没有完成这些真机双臂实验。（第 4–6 节）" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_5_branch_3" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1391.0" as="sourcePoint"/><mxPoint x="3322" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_10_5_field_4" parent="paper_10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出当前只适合连续动作输出；物体会动时还需预测和新的指导信号&lt;br&gt;我的理解 / 不足：训练时的教师借助仿真里较准的几何信息；真机和双臂安全效果尚未证明&lt;br&gt;未来展望：把方法扩到移动障碍、其他动作表示和不同来源的纠正意见&lt;br&gt;对我们项目的启发：可保存执行偏差与恢复记录，但先检查标签可靠，再防止更新后原有技能退步" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_10_5_branch_4" edge="1" parent="paper_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1900.5" as="sourcePoint"/><mxPoint x="3322" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
