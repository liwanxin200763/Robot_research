        <mxCell id="paper_15_5_field_5" parent="paper_15" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对我们项目的启发：短期视频可以记录执行错误发生前后的精细变化，长期语言或事件记忆可以记录已完成子任务，失败原因和有效恢复方法，从而连接 Failure Detection（失败检测，识别动作或任务是否已经偏离目标），Recovery 和 Self-Improvement" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_15_fulltitle" parent="paper_15" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="论文：MEM" vertex="1">
          <mxGeometry height="180" width="285" y="162" as="geometry"/>
        </mxCell>
        <mxCell id="paper_15_authors" parent="paper_15" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="阅读重点：核心研究问题：（短期：我刚才到底有没有抓稳奶酪，长期：我已经放过黄油没有，长期只需要记忆一句）长时序任务既需要几秒级精细视觉记忆，又需要数分钟级任务语义记忆，如何同时保存两种不同时间尺度的信息并保持实时机器人控制" vertex="1">
          <mxGeometry height="220" width="285" y="354" as="geometry"/>
        </mxCell>
