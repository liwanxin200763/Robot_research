        </UserObject><mxCell id="paper_43_1_field_1" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / NeurIPS&lt;br&gt;引用量：78（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_1_branch_1" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_1_field_2" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作&lt;br&gt;&lt;br&gt;论文定位：这篇论文属于 Robot Manipulation 方向，主要讨论机器人长任务容易因局部错误累积而失败。&lt;br&gt;核心思路是CLOVER 借鉴闭环控制，把生成式未来预期与视觉运动策略结合，持续比较执行进展。&lt;br&gt;与当前项目的联系：项目联系：双臂长任务尤其需要检查每步结果" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_1_branch_2" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_1_field_3" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：机器人长任务容易因局部错误累积而失败&lt;br&gt;&lt;br&gt;为什么重要：为动作后验证和失败检测提供闭环思路" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_1_branch_3" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1370.0" as="sourcePoint"/><mxPoint x="562" y="1370.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_1_field_4" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：生成式视觉规划与闭环控制。Closed-loop（闭环）是执行后再观察并调整；Open-loop（开环）是按预先计划持续执行，不及时根据真实结果纠正&lt;br&gt;核心研究问题：模型生成了理想任务视频，现实物体却可能被碰动。怎样比较当前真实画面与期望画面，持续改变动作，避免一直照旧计划走？&lt;br&gt;之前方法的问题：只把未来视频翻译成整段动作，偏差出现后仍会累积。反馈控制又需要一个能表达任务目标的误差，不能只比较像素颜色" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1588" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_1_branch_4" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1855.0" as="sourcePoint"/><mxPoint x="562" y="1855.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_2_field_1" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读&lt;br&gt;&lt;br&gt;之前方法的问题：只按当前观测输出动作，缺少对下一状态的预期与检查" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_2_branch_1" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_2_field_2" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：视觉规划把语言任务变成未来子目标；经典反馈控制根据目标与现状的差距行动。把两者接好，才能让生成式计划及时响应现实偏差&lt;br&gt;相关方向 2：彩色加深度的未来生成保留空间信息；图像特征比较需要对背景变化不敏感，并突出正在操作的物体与手部状态&lt;br&gt;代表工作：CALVIN 上与3D Diffuser Actor 等比较，真机与 RT-1、ACT 比较。ACT 是从示范生成动作段的模型；这些对照分别测试规划和连续控制能力&lt;br&gt;与已有方法的区别：CLOVER 生成视觉期望，再将当前与目标的特征差输入反馈控制器；执行后重看并必要时重规划 Replanning（重规划，发现条件变化后重新制定后续动作），即根据新现场重新安排后续动作" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_2_branch_2" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1004.0" as="sourcePoint"/><mxPoint x="1252" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_3_field_1" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：CLOVER 借鉴闭环控制，把生成式未来预期与视觉运动策略结合，持续比较执行进展&lt;br&gt;&lt;br&gt;CLOVER 如何形成视觉反馈：先用文字条件视频扩散模型生成期望视觉计划，作为机器人希望逐步达到的参考。再把真实观察与参考画面映到可度量的表示空间，计算偏差，而不是直接用像素差把光照或背景变化都当操作错误。反馈控制器利用这个误差修正动作，偏差足够大时重新规划；这把生成计划、误差测量和动作纠正连接起来&lt;br&gt;&lt;br&gt;为什么重规划不能替代反馈：若一直照最初视频执行，早期抓取偏差会把后面全部动作带偏；若每次都完全重生成，又可能破坏已经形成的进展。本文用反馈调动作，并在需要时才触发新计划，研究这两层机制如何配合。视觉未来只是参考，不是环境真实未来，因此还要看任务完成和扰动下恢复，而不只看视频生成质量" vertex="1">
          <mxGeometry height="779" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_3_branch_1" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="529.5" as="sourcePoint"/><mxPoint x="1942" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_3_field_2" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：根据语言和当前彩色—深度观察生成视觉子目标序列，用运动一致性约束减少相邻帧的突变。目标不仅描述“是什么”，也包含空间变化&lt;br&gt;贡献 2：把当前观察和子目标编码为可比较特征，差值作为任务误差。反馈控制器根据误差生成动作，把视觉规划变成可执行的连续控制&lt;br&gt;贡献 3：执行中持续观察并调节；偏离计划时更新目标和控制。能应对部分物体扰动，但它没有独立的失败原因诊断和恢复技能库&lt;br&gt;方法流程：语言+当前观察 → 生成未来视觉子目标 → 比较当前与目标特征 → 反馈控制动作 → 再观察 → 根据误差纠正/重规划 → 逐步完成任务" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_3_branch_2" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1266.5" as="sourcePoint"/><mxPoint x="1942" y="1266.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_4_field_1" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：CALVIN 与真机操作任务&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：CALVIN 与真机操作任务" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_4_branch_1" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="330.0" as="sourcePoint"/><mxPoint x="2632" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_4_field_2" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：CALVIN 连续五条指令任务和 AIRBOT 真机多步骤操作；另有动态摆动目标。完整五步成功率与平均完成指令数是不同指标&lt;br&gt;对照：与3D Diffuser Actor、RT-1、ACT 等比较，消融目标生成和反馈误差设计。不能把不同平台任务合并成一个自算平均成功率&lt;br&gt;结果：CALVIN 平均完成3.53条指令，对照3.27；五步全部完成45.4%，对照41.2%。前者表示进度，后者才是完整五步任务成功率&lt;br&gt;真机 / 关键补充：真机三步任务完整成功26.7%（15次），动态目标任务20%，对照为0。证明有一定响应能力，也说明该设置距离稳定部署仍有明显差距" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_4_branch_2" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="867.5" as="sourcePoint"/><mxPoint x="2632" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_4_field_3" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_4_branch_3" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1412.0" as="sourcePoint"/><mxPoint x="2632" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_5_field_1" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：双臂长任务尤其需要检查每步结果&lt;br&gt;&lt;br&gt;主要局限：未来预测误差与真实接触误差如何区分仍需验证&lt;br&gt;&lt;br&gt;局限与启发：主要局限：未来预测误差与真实接触误差如何区分仍需验证" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_5_branch_1" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_43_5_field_2" parent="paper_43" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：论文讨论视觉规划及控制仍受任务数据与表示质量限制；生成目标或特征误差失真时，闭环也可能向错误目标纠正&lt;br&gt;我的理解 / 不足：我的判断：目标画面接近不一定抓牢，遮挡和柔性物体可能让误差变小但任务未完成。需要接触和阶段完成验证&lt;br&gt;未来展望：加入目标置信度、触觉完成判据和恢复分支；分别测试“目标预测错”与“动作执行错”，不要用一个总失败数掩盖来源&lt;br&gt;对我们项目的启发：适合 DH116 的视觉反馈控制参考。先定义抓住/放稳等可测子目标；再把实际手物状态与期望比较，连接 #44 恢复模块" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_43_5_branch_2" edge="1" parent="paper_43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
