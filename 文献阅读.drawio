          </mxCell>
        </UserObject><mxCell id="paper_34_1_field_1" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICLR&lt;br&gt;引用量：21（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_1_branch_1" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_1_field_2" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_1_branch_2" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_1_field_3" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论机器人必须实时响应，但动作块策略可能错过中途变化。&lt;br&gt;核心思路是REMAC 用 masked action chunking 学习对预训练策略动作的修正。&lt;br&gt;与当前项目的联系：项目联系：可比较动作块长度、控制频率和失败恢复" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_1_branch_3" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_1_field_4" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：机器人必须实时响应，但动作块策略可能错过中途变化&lt;br&gt;&lt;br&gt;为什么重要：直接对应普通夹爪真机的实时执行与修正&lt;br&gt;&lt;br&gt;阅读要点与补充说明：方向：实时动作执行与推理延迟&lt;br&gt;一段动作执行时并行预测下一段&lt;br&gt;核心问题：模型计算要等 100 多毫秒，&lt;br&gt;机器人怎样不断顿又不让前后动作打架？&lt;br&gt;同步等待会停顿；直接异步拼接动作段，&lt;br&gt;又可能突然改变方向或抓取时机" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_1_branch_4" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1750.0" as="sourcePoint"/><mxPoint x="562" y="1750.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_2_field_1" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：固定动作块执行快，却不容易及时修正已预测动作" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_2_branch_1" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_2_field_2" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_2_branch_2" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="822.0" as="sourcePoint"/><mxPoint x="1252" y="822.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_2_field_3" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：Action Chunk（动作段，一次预测并执行的一小段连续动作），&lt;br&gt;一次预测未来一小段连续动作&lt;br&gt;相关方向 2：RTC 等测试时修正，&lt;br&gt;利用已执行动作接上下一段&lt;br&gt;代表对照：Naive Async、RTC、时间集成；&lt;br&gt;比较成功率和执行时长&lt;br&gt;区别：训练时就模拟推理延迟，&lt;br&gt;只重新预测尚未执行的动作" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_2_branch_3" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1307.0" as="sourcePoint"/><mxPoint x="1252" y="1307.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_3_field_1" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：REMAC 用 masked action chunking 学习对预训练策略动作的修正&lt;br&gt;&lt;br&gt;异步执行为什么会错：机器人执行上一段动作的同时计算下一段，计算完成时新观察已经变旧；即使段与段衔接平滑，一段内部的动作仍可能与真实当前状态不符。REMAC 用前缀掩码训练模型适应已经执行的那一部分，并逐步从真值前缀过渡到模型自身预测的前缀，让训练更接近部署时的偏差；采样时再保留前缀连续性&lt;br&gt;&lt;br&gt;阅读要点与补充说明：贡献 1：遮住已执行的动作前缀，&lt;br&gt;只监督未来还能改的动作&lt;br&gt;贡献 2：训练初期用真实动作引导，&lt;br&gt;后期逐渐用模型自己的预测练习纠偏&lt;br&gt;贡献 3：采样时固定已执行前缀，&lt;br&gt;新动作与上一段平滑接续&lt;br&gt;流程：执行旧动作段→新画面到达&lt;br&gt;→固定已做动作→补预测余下动作" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_3_branch_1" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="564.5" as="sourcePoint"/><mxPoint x="1942" y="564.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_3_field_2" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1017" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_3_branch_2" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1231.5" as="sourcePoint"/><mxPoint x="1942" y="1231.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_4_field_1" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：作者报告仿真与真机中执行更快，并保持任务表现；具体延迟和成功率需查论文&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告仿真与真机中执行更快，并保持任务表现；具体延迟和成功率需查论文" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_4_branch_1" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_4_field_2" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;怎样隔离训练组件的作用&lt;/b&gt;&lt;br&gt;&lt;br&gt;ICLR 2026 本地全文表 1 在五档推理延迟下比较朴素异步、仅 LoRA、加入前缀掩码、自条件课程和完整损失。仅 LoRA 在最高延迟档为 0.428，朴素为 0.451，加入前缀掩码为 0.636，再加课程为 0.710；这些是该仿真消融的 solve rate，说明改参数形式本身不足，不能把它们改写成任意真机任务的实时成功率" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_4_branch_2" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_4_field_3" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：Kinetix 12 个动态任务；&lt;br&gt;另有 Franka 真机 3 类抓放任务&lt;br&gt;对照：Naive Async、RTC、时间集成；&lt;br&gt;测成功率与任务进度&lt;br&gt;结果：仿真延迟 d=4 时成功率 0.779；&lt;br&gt;直接异步 0.451&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真机：困难抓放进度 0.812；&lt;br&gt;RTC 0.753，每法每任务 30 次" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_4_branch_3" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1286.0" as="sourcePoint"/><mxPoint x="2632" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_4_field_4" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_4_branch_4" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1778.0" as="sourcePoint"/><mxPoint x="2632" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_5_field_1" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可比较动作块长度、控制频率和失败恢复&lt;br&gt;&lt;br&gt;主要局限：在线修正是否产生不安全突变需在控制器层验证&lt;br&gt;&lt;br&gt;局限与启发：主要局限：在线修正是否产生不安全突变需在控制器层验证" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_5_branch_1" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_5_field_2" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出需预设最大推理延迟；&lt;br&gt;超出范围可能失效，微调需较多数据&lt;br&gt;我的理解：真机用平行夹爪，&lt;br&gt;多指灵巧手的高维控制尚未测&lt;br&gt;未来可把动态风险预测接入动作段更新，&lt;br&gt;避免平滑但仍危险的动作&lt;br&gt;项目启发：DH116 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 可先测真实延迟，&lt;br&gt;再训练不会跳变的手指动作段" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_5_branch_2" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="934.0" as="sourcePoint"/><mxPoint x="3322" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_34_5_field_3" parent="paper_34" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_34_5_branch_3" edge="1" parent="paper_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1426.0" as="sourcePoint"/><mxPoint x="3322" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
