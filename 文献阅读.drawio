          </mxGeometry>
        </mxCell>
        <mxCell id="paper_53_2_field_1" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 1：#52 OpenVLA 把动作拆成离散符号；空间表示方法用深度或点云补几何信息。空间感知与动作编码一起设计，才能把看懂位置转换为合适运动" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_2_branch_2" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="460" as="sourcePoint"/>
            <mxPoint x="783" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_53_2_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 2：自回归逐个生成动作符号；Adaptive Action Grids（自适应动作网格）根据动作分布划分空间，使常用动作区域获得更细表示" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_2_branch_3" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="700" as="sourcePoint"/>
            <mxPoint x="783" y="700" as="targetPoint"/>
          </mxGeometry>
