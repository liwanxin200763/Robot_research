round="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="category_06_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="80" y="42" width="290" height="60" as="geometry"/></mxCell></UserObject><mxCell id="category_06_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="06 动作建模与控制"><mxGeometry x="80" y="125" width="1440" height="88" as="geometry"/></mxCell><mxCell id="category_06_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="这个方向在研究什么：研究怎样把视觉语言决策转为平稳、及时、准确的机器人动作&lt;br&gt;共 6 篇 · 建议先看 #4 FP2，再按本页顺序浏览"><mxGeometry x="80" y="232" width="1440" height="105" as="geometry"/></mxCell><UserObject id="category_06_paper_04" label="#4 FP2&lt;br&gt;要解决：上层模型知道手臂要往哪里走后，碰到物体时怎样控制推、拉和压的力度？&lt;br&gt;年份 / Venue：2026；arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-04" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_06_paper_06" label="#6 FoAM&lt;br&gt;要解决：任务少量示范时，模型能否先想象动作的结果，再在没专门练过的任务上操作？&lt;br&gt;年份 / Venue：2026，AAAI 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-06" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_06_paper_34" label="#34 REMAC&lt;br&gt;要解决：模型计算要等 100 多毫秒， 机器人怎样不断顿又不让前后动作打架？&lt;br&gt;年份 / Venue：2026，ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-34" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_06_paper_49" label="#49 EquiBot&lt;br&gt;要解决：演示只在桌面一角采几次，换位置或尺寸后常失败。能否把几何规律写进策略结构，使少量数据也能处理新的物体位置、方向和大小？&lt;br&gt;年份 / Venue：2024 / CoRL 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-49" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_06_paper_50" label="#50 Bidirectional Decoding&lt;br&gt;要解决：长动作段平滑，却来不及响应物体移动；每步重新预测反应快，却可能一会儿左绕一会儿右绕。能否在两者之间保留一致且可及时修正的动作？&lt;br&gt;年份 / Venue：2025 / ICLR 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-50" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_06_paper_51" label="#51 DexHandDiff&lt;br&gt;要解决：训练示范只开门到90度，测试要开30度并停住。能否在不重新采所有目标数据的情况下修改目标，同时保证手真的推动物体而非物体凭空动？&lt;br&gt;年份 / Venue：2025 / CVPR 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-51" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><mxCell id="category_06_foot" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="选择上方论文卡片进入详情 · 详情页可按上一篇 / 下一篇顺序浏览"><mxGeometry x="80" y="1065" width="1440" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="literature-paper-04" name="06-01 FP2"><mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1690" background="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="paper_04_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="120" y="42" width="601" height="62" as="geometry"/></mxCell></UserObject><UserObject id="paper_04_topnav_1" label="返回分类" link="data:page/id,literature-page-06" tooltip="点击进入页面"><mxCell parent="1" vertex