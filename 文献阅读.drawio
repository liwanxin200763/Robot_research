        </UserObject>
        <mxCell id="category_07_foot" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="选择上方论文卡片进入详情 · 详情页可按上一篇 / 下一篇顺序浏览">
          <mxGeometry x="100" y="2940" width="2000" height="90" as="geometry"/>
