        <mxCell id="paper_11_1_field_4" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：单帧 VLA 会丢失连续操作中的时间信息，直接输入大量历史帧又增加计算量，而且并非所有历史区域都值得重复处理" vertex="1">
