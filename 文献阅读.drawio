            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_45_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-46" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_45_1_field_1" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_1_branch_1" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_1_field_2" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景：VLA 的语言和历史上下文可能压弱当前视觉与本体信息，动作 token 在困难时刻表现出较高不确定性。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：在不重训主干的条件下，于动作不确定时强化当前观测对 VLA 内部表征的影响。（第 1 节）" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_1_branch_2" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_1_field_3" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一地强化全部观测可能干扰已确定的动作；只靠模型原始注意力未必能在关键层保留及时感知。（第 2 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_1_branch_3" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1370.0" as="sourcePoint"/><mxPoint x="562" y="1370.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_1_field_4" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：VLA（视觉—语言—动作模型：用图像与指令生成动作） 内部不确定性与观察再注入。不确定性是模型对动作的拿不准程度；它调整生成动作时怎样使用视觉，归入执行误差，并非完整失败恢复框架&lt;br&gt;核心研究问题：视觉已经输入模型，却可能在深层计算中被语言先验冲淡。能否在动作不确定的层重新强调当前观察，减少看错对象或位置导致的错误？&lt;br&gt;之前方法的问题：给所有层一律加强视觉可能引入干扰；额外训练感知模块又费数据。需要判断何时、哪层缺少视觉证据，再有选择地补入" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1588" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_1_branch_4" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1872.5" as="sourcePoint"/><mxPoint x="562" y="1872.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_2_field_1" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;与已有工作的关系：与 SafeLoop 的外部风险决策不同，UAOR 在 VLA 推理内部强化当前观测；两种不确定性信号不可直接等同" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_2_branch_1" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_2_field_2" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_2_branch_2" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_2_field_3" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：VLA 同时使用预训练的知识和现场观察，两者不一致时可能“按经验”行动。重新注入观察试图提高现场证据的权重&lt;br&gt;相关方向 2：模型不确定性可由输出分布的熵衡量：候选动作越分散，熵通常越高。但它不是物理风险概率，也不是“已经失败”的直接证据&lt;br&gt;代表工作：在 CogACT、OpenVLA-OFT 等基础模型上加插件。#44 RESETTLE 在执行中触发外部纠正；UAOR 在模型内部调整注意力，二者干预位置不同&lt;br&gt;与已有方法的区别：把前馈网络理解成键值记忆，再按动作熵决定是否补视觉键值。这里的“记忆”是网络计算结构，不是保存多分钟任务事件的外部记忆库" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_2_branch_3" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1429.5" as="sourcePoint"/><mxPoint x="1252" y="1429.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_3_field_1" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：根据动作 token 熵选择高不确定层，将当前已编码的视觉和本体特征检索并回注至模型隐藏状态。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：从前馈网络内的 key-value 表征检索观测信息，在高熵位置以系数融合；最有效配置选取 top-K 约 256 项。这里的 reinjection 是同一次推理中重用当前观测，并非外部重新拍摄、等待目标稳定或维护跨时段记忆。（第 3 节、图 2）&lt;br&gt;&lt;br&gt;输入信息：当前图像、本体状态、语言指令以及模型内部动作分布；未输入失败类型或场景变化率。（第 3 节）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_3_branch_1" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_3_field_2" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;输出 / 动作表示：基础 VLA 仍输出原形式动作；UAOR 修改内部表征，未增加显式停止、回滚或重新规划动作。（第 3 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：核心处理是观测特征检索、熵门控与特征融合；论文未报告以数据增强作为主要贡献。（第 3 节）&lt;br&gt;&lt;br&gt;训练方式：以插入式模块适配不同 VLA，包括 OpenVLA-OFT、π0、CogACT、LLaVA-VLA；主要贡献是推理表征调节，而非重新收集失败恢复训练数据。（第 3–4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_3_branch_2" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1109.0" as="sourcePoint"/><mxPoint x="1942" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_3_field_3" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：逐层计算 Action Entropy（动作熵：动作分布的分散程度），定位模型不确定的层。输入是模型内部动作相关分布，而非人工标注失败结果&lt;br&gt;贡献 2：在需要的层把当前视觉特征（如有，也含本体状态）重新注入后续键值交互，强化现场证据。补的是当前输入信息，不是重新调用相机拍一帧&lt;br&gt;贡献 3：按阈值和混合系数控制注入量；插件本身不训练，但基础策略可已预训练或微调。不能把这一点写成“整套机器人从未用目标任务数据”&lt;br&gt;方法流程：当前图像+指令 → 基础 VLA 逐层计算 → 动作熵检测不确定层 → 再注入当前视觉特征 → 生成动作 → 执行后输入新的观察" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_3_branch_3" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1758.5" as="sourcePoint"/><mxPoint x="1942" y="1758.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_4_field_1" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：评估 LIBERO、SIMPLER、CALVIN 和真实 Franka 四任务；真机每任务 50 条示范、20 次测试。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：比较多个基础策略的原始与回注后表现，并消融注意力检索方式、熵门控与回注层选择。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：单台 Franka Research 3 的四项任务：OpenVLA-OFT 平均 55%→72.5%，CogACT 63.8%→78.8%；未测试双臂或执行中独立移动目标。（第 4 节）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_4_branch_1" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_4_field_2" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：LIBERO 上 OpenVLA-OFT 97.1%→98.0%、π0 91.7%→93.2%；SIMPLER CogACT 73.1%→75.7%；CALVIN 平均连续完成长度 3.55→3.67。（第 4 节、主结果表）&lt;br&gt;&lt;br&gt;消融实验：注意力检索加熵门控为 98.0%，均值池化 96.8%，全量注意力 96.7%；阈值和回注层敏感。（第 4 节、消融表）&lt;br&gt;&lt;br&gt;Failure Case：论文没有系统标注失败类型、原因及恢复结果；不确定性升高只能作为内部信号，不能自动说明物体移动或执行器未按命令动作" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_4_branch_2" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1091.5" as="sourcePoint"/><mxPoint x="2632" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_4_field_3" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：SIMPLER、LIBERO、CALVIN 和 Franka 真机四项任务；指标含单任务成功率与连续指令进度。插件训练成本和基础模型适配成本分开说明&lt;br&gt;对照：相同基础模型加/不加 UAOR，并改变注入阈值和权重做消融，检查是否只有不确定层受益，而非任意增加视觉都有效&lt;br&gt;结果：SIMPLER 中 CogACT73.1%→75.7%；CALVIN 平均完成指令3.55→3.67。前者是任务成功率，后者是进度分数，不能互换&lt;br&gt;真机 / 关键补充：Franka 每项20次，OpenVLA-OFT 平均55%→72.5%。基础模型此前用每项50条示范适配；UAOR 不再训练，不代表真机零样本测试" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_4_branch_3" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1758.5" as="sourcePoint"/><mxPoint x="2632" y="1758.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_5_field_1" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：静态随机化；任务环境并非专门的执行中持续运动目标基准&lt;br&gt;&lt;br&gt;主要局限：作者实验范围主要是既有静态或每 episode 初始化随机化的基准与单臂真机。按本库分析，熵不是已校准的任务风险概率，也不提供旧记忆清除、物理反馈或完整恢复闭环&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可作为双臂 VLA 行动不确定性探针与 Risk-Aware Action Gating 的候选特征，但必须单独验证它是否预示真实执行误差。论文没有 Failure Memory、双臂协作或 DH116 实验" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_5_branch_1" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_45_5_field_2" parent="paper_45" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者讨论阈值与注入强度需要适配模型和任务，真机范围主要是 Franka。内部熵能提示不确定，但与具体执行错误并非一一对应&lt;br&gt;我的理解 / 不足：我的判断：模型可能低熵地输出错误动作，仍不会加强视觉；反之接触本来允许多种动作，高熵未必危险，不能直接据此停机&lt;br&gt;未来展望：联合观察变化、任务进度与接触证据校准触发；分别评估抓错物体、遮挡和高动作自由度条件，验证熵信号何时有效&lt;br&gt;对我们项目的启发：可在 DH116 VLA 中测试视觉再注入对抓点选择的影响。它可与 #44 的执行后恢复互补，但不能替代抓牢、滑落和碰撞检测" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_45_5_branch_2" edge="1" parent="paper_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1126.5" as="sourcePoint"/><mxPoint x="3322" y="1126.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
