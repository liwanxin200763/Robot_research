          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_5_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：作者在结论明确指出依赖彩色—深度输入，带来硬件限制。深度缺失、反光物体以及相机标定问题，会影响三维空间信息的可靠性" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_5_branch_3" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="460" as="sourcePoint"/>
            <mxPoint x="2031" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_5_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="我的理解 / 不足：我的判断：历史记忆把旧位置带入当前，物体快速移动时可能变成过时证据。本文并未为记忆设计显式过期检测或风险等待机制" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_5_branch_4" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="700" as="sourcePoint"/>
            <mxPoint x="2031" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_5_field_4" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="未来展望：可用物体变化速度与深度置信度控制记忆更新；比较动态场景中“保留旧帧”与“及时刷新”的收益，连接 #02 LT-Mem 的变化程度建模" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_5_branch_5" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="940" as="sourcePoint"/>
            <mxPoint x="2031" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_5_field_5" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对我们项目的启发：可作 DH116 操作中的空间记忆基线。先保证腕部/外部相机标定，再测手遮挡和物体移动；不能把三维坐标准确直接等同于接触稳定" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_fulltitle" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：4D-VLA: Spatiotemporal Vision-Language-Action Pretraining with Cross-Scene Calibration" vertex="1">
