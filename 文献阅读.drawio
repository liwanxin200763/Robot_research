        <mxCell id="detail_25_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="01 数据生成与数据质量  ·  本类第 5 / 21 篇  ·  问题：怎样让人自然示教复杂手指动作， 并把示教直接用于不同机器人手？&lt;br&gt;流程：人戴外骨骼示教→记录动作/触觉&lt;br&gt;→替换视频手像→训练策略→机器人执行">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
