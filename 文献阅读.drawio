            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_117_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-118" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_117_1_field_1" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与时间&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：BridgeVLA: Input-Output Alignment for Efficient 3D Manipulation Learning with Vision-Language Models。作者及机构见元数据；首页列Peiyan Li、Hongtao Wu、Xiao Ma为项目负责人，Hongtao Wu与Yan Huang为通讯作者。年份 / Venue：NeurIPS 2025。官方https://arxiv.org/abs/2506.07961载明首次公开2025年6月9日、v2更新2025年10月14日，和会议日期分开记录；本地39页PDF标题与canonical卡一致。引用量未作实时核验。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_1_branch_1" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_1_field_2" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、问题与目标能力&lt;/b&gt;&lt;br&gt;&lt;br&gt;2D VLA可迁移语言视觉知识，但往往需较多机器人示范；高效3D策略会让输入空间与动作输出空间对应，却未充分结合VLM知识。直接给VLM拼接3D信息又可能偏离其原先图像输入分布。本文具体问题是：能否保持2D预训练接口，同时利用3D空间结构，提高精细操作和少示范泛化能力。目标不是仅加入深度，而是使预训练、机器人观察和空间动作在同一2D热图接口上对齐。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_1_branch_2" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_2_field_1" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制：三维结构先验&lt;/b&gt;&lt;br&gt;&lt;br&gt;PerAct在体素空间预测动作位置，Act3D在3D点中选高分位置，RVT/RVT-2把点云正交投影成多个视图再预测空间目标。它们利用“动作应落在观察空间某处”的归纳偏置，比直接回归三维坐标更容易学。常见VLA则用无空间结构的token序列生成动作，虽然能理解指令，但可能浪费这些几何先验；SpatialVLA引入3D位置编码，改变了主干接收的特征分布。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_2_branch_1" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_2_field_2" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;本文热图接口的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;热图是与输入图像对齐的二维概率分布，每个像素表示末端目标投影位置的可能性。预训练时预测文本指称对象中心，机器人阶段预测下一关键帧末端位置，两者使用同类空间输出。粗到细指先预测整场景位置，再围绕它裁切并放大点云、第二次推理。碰撞标志只告诉运动规划器是否避免碰撞，不代表网络直接预测完整无碰轨迹。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_2_branch_2" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_3_field_1" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入重建与三视图&lt;/b&gt;&lt;br&gt;&lt;br&gt;观察来自已标定RGB-D相机，先重建彩色点云，再从顶部、正面、右侧做三张正交投影图。三张图与语言指令送入PaliGemma，其SigLIP视觉编码和Gemma主干保留熟悉的2D图像输入形式。作者特意不把机器人状态或逐像素3D位置额外注入VLM前向，以减小预训练与微调分布差异。3D信息并未消失，而是通过投影关系和后续反投影参与求解。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_3_branch_1" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_3_field_2" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阶段一：二维热图预训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;用RoboPoint中12万张目标检测样本，以语言描述选出一个或多个目标。每个对象边界框中心建立截断高斯概率图，合并后平均、归一化成目标热图。VLM输出的图像token按patch位置还原空间网格，再经可学习凸上采样恢复输入分辨率。上采样学习逐像素插值权重，相比固定双线性插值有更灵活的细节恢复。以交叉熵训练热图，先教原本主要输出文本的VLM做空间密集预测。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_3_branch_2" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="864.0" as="sourcePoint"/><mxPoint x="1942" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_3_field_3" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阶段二：位置与其余动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人微调为三视图各预测一张末端位置热图。将工作空间均匀3D网格点投影到各热图，汇总对应概率，选择得分最高的3D点作为下一关键帧位置。姿态使用Euler角，每轴72档；每视图分别提取全局max-pooling token和热图峰值处局部token，共六个特征拼接后由MLP预测旋转、二值夹爪及碰撞标志。这让平移用密集空间监督，而方向和离散控制保留较轻的读出头。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_3_branch_3" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1356.0" as="sourcePoint"/><mxPoint x="1942" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_3_field_4" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;粗到细与损失&lt;/b&gt;&lt;br&gt;&lt;br&gt;整点云第一次推理给粗目标，随后以该位置为中心裁剪长方体点云并放大，第二次前向给最终执行动作。位置真值是下一关键帧末端位置投影形成的高斯热图，平移和角度用交叉熵，夹爪和碰撞用二元交叉熵，四项相加。训练时对点云和动作同步施加随机刚体变换。它学习的是关键帧动作，轨迹中的到达由采样式运动规划器完成，不能把模型0.21秒推理时间当作整个机械运动耗时。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_3_branch_4" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1848.0" as="sourcePoint"/><mxPoint x="1942" y="1848.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_3_field_5" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练与反馈流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;整个训练期间冻结SigLIP和语言token嵌入，其余模块按阶段训练。执行循环是观察→预测下一关键帧SE(3)位姿/夹爪/碰撞标志→采样式规划器移动→重新观察，直到完成或达到步数上限。反馈用于下一关键帧选择，没有部署时的奖励训练或技能库演化。附录预训练8张A100、3800步约2小时；RLBench和COLOSSEUM各48张H100、83000步约20小时；真机8张A100、300 epoch约1.5小时。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2108" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_3_branch_5" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2340.0" as="sourcePoint"/><mxPoint x="1942" y="2340.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_4_field_1" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;RLBench设置与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真Franka Panda加平行夹爪，前、左右肩及腕部四台标定RGB-D相机；18任务各100条专家示范，每任务每次25轮、每轮最多25动作步，重复5次。平均成功率88.2%，RVT-2为81.4%、3D Diffuser Actor81.3%；插销88.0%对RVT-2的40.0%，形状分类60.8%对35.0%，显示精细对齐优势。表1平均名次为2.03，而正文称1.9，笔记不把两者当成统一值。Place Cups为58.4±10.0%，仍远未饱和，作者怀疑投影视图共同遮挡关键点。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_4_branch_1" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_4_field_2" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;鲁棒性与泛化基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;COLOSSEUM用原始20任务、每任务100轨迹训练，测试12种未见扰动及组合扰动，每条件25次；RVT-2和本文自行训练、测试重复3次，其他基线取原论文。表4总体64.0%对56.7%，绝对增加7.3个百分点；但干扰物项51.8±1.5%低于RVT-2的60.8±0.5%，组合全部扰动仅18.7±2.2%，不能说所有扰动均稳健。GemBench用16任务31变体训练，44任务92变体测试，覆盖新摆放、新刚体、新关节物体和长任务；跨层平均领先不等于每项任务领先。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_4_branch_2" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="916.5" as="sourcePoint"/><mxPoint x="2632" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_4_field_3" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机设置、数据与基线&lt;/b&gt;&lt;br&gt;&lt;br&gt;Franka Research 3加平行夹爪，单台静态ZED 2i提供彩色点云。13任务从抓放到开抽屉并放入物品，每条3–9关键帧，通常各10条示范、各10次测试。基本设置BridgeVLA96.9%、RVT-2 90%、π0 3.8%、ACT22.3%、SpatialVLA(10)3.1%；SpatialVLA(50)额外用50轨迹为28.5%。ACT不支持语言，按任务单独训练。论文对不同方法测试场景拍照并人工对齐，但仍不能由该少数据设定推断π0一般无效。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_4_branch_3" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1443.5" as="sourcePoint"/><mxPoint x="2632" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_4_field_4" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;少样本与七种设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;七种真机条件为基本、类似目标的干扰物、关灯、三种桌布、物体抬高9.5厘米、13种新对象技能组合、7个新类别物体。基本设置较差的基线未继续全面测泛化，后续主要比较RVT-2和本文。每任务仅3轨迹时主实验和摘要为95.4%；同PDF引言及官方arXiv摘要写96.8%，存在版本内不一致，采用主实验口径并保留问题。全文“平均高32%”跨多个条件，不能解释为基本设置96.9对90的差。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_4_branch_4" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1953.0" as="sourcePoint"/><mxPoint x="2632" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_4_field_5" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融、延迟与因果边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;将309M凸上采样热图模块换成相近303M参数Transformer直接回归位置，RLBench由88.2降到31.4%；添加逐像素3D位置特征为56.2%。这支持热图和输入分布对齐，但回归损失与训练难度也变化，不能视为只改变一个抽象空间因素。去热图预训练主要削弱语言组合泛化。RTX4090上100次测量，从点云输入到动作输出平均0.21秒，约为推理吞吐参考，不含采集、运动规划和机械执行总时间。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_4_branch_5" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2445.0" as="sourcePoint"/><mxPoint x="2632" y="2445.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_5_field_1" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;新类别绝对成功率仍低，常见失败是忽略源物体直接去放置目的地。作者认为第三人称检测图像与正交投影图有域差，且检测学对象中心、动作却预测不一定对应物体的关键点。投影视图遮挡也限制放杯任务。扩大分割/关键点预训练、动态选视图和增强动作解码器是未来设想；本文没有证明保留对象定位能力就必然保留所有视觉语言知识。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_5_branch_1" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_117_5_field_2" parent="paper_117" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：精确标定与深度质量是热图反投影的隐含前提，透明反光、遮挡或可变形物体会影响点云及投影；规划器能否到达也是网络外的成功瓶颈。研究启发：应分别记录热图定位误差、关键帧姿态误差、规划失败率和最终成功；在同数据预算下测深度噪声、视图遮挡及末端目标不在可见表面的情况。语义预训练最好加入动作接触点监督，核对它能否改善新类别“跳过抓取”失败。上述均为后续研究建议。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_117_5_branch_2" edge="1" parent="paper_117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="846.5" as="sourcePoint"/><mxPoint x="3322" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
