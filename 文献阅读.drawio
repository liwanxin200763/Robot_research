            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_140_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-24" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_140_1_field_1" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与标题纠正&lt;/b&gt;&lt;br&gt;&lt;br&gt;首页完整正式题名为 Gripper Keypose and Object Pointflow as Interfaces for Bimanual Robotic Manipulation，简称PPI，即关键姿态与点流接口。原卡和selected.json写作Gripper Pose and Object Pointflow as Interfaces for Robotic Bimanual Manipulation，漏了Keypose并调整词序；笔记使用首页题名，不能把卡片写法继续当成正式标题。本地为RSS2025会议版，11页，首页给会议时间2025年6月21–25日；首个预印本和更新日期未核验。作者机构来自首页；引用状态未实时查询，不沿用旧卡数字。" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_1_branch_1" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="424.5" as="sourcePoint"/><mxPoint x="562" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_1_field_2" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;问题与关键主张&lt;/b&gt;&lt;br&gt;&lt;br&gt;稀疏关键帧策略擅长定位抓哪里，但关键帧之间常由运动规划连接，可能无法完成擦拭曲线或双手水平抬托盘等连续约束。连续动作策略能模仿复杂轨迹，却可能记住本体运动而弱化对物体位置的感知。PPI把两种信息结合：预测未来关键夹爪姿态，明确动作空间的目标；预测物体点流，明确物体将怎样动；再用它们作为接口指导连续双臂动作。它是端到端行为克隆策略，需要机器人示范，不是直接从人视频重定向的管线。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_1_branch_2" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="986.5" as="sourcePoint"/><mxPoint x="562" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_2_field_1" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;关键姿态与连续控制的机制差别&lt;/b&gt;&lt;br&gt;&lt;br&gt;PerAct2、3D Diffuser Actor等输入三维场景及语言，输出关键时刻夹爪目标，再借运动规划器到达下一目标。少量关键点能迫使模型关注物体局部位置，但没有密集监督时可能把擦盘动作变成起点到终点的直线。ACT、RDT、DP3等连续策略从观察序列预测每步或动作块，可表示轨迹形状，却可能依靠初态关节等捷径拟合示范，在目标位置变化时定位不准。PPI保持连续输出，同时加入物体与关键夹爪两层中间监督，以改善局部空间注意力。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_2_branch_1" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_2_field_2" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;点流、语义场和接口的通俗解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;物体点流不是光学流的二维像素位移，而是物体表面一组查询点在未来关键时刻的三维位置序列。三维语义场把点云几何与图像中识别物体的语义特征合在一起，让模型知道某点在哪里以及可能属于什么。接口是网络内部可监督的中间表示：点流表达对象运动，关键姿态表达夹爪目标，连续动作表达实际过程。这里的点流预测由模型端到端完成，部署并不需要逐帧运行真值物体六自由度跟踪。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_2_branch_2" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="899.0" as="sourcePoint"/><mxPoint x="1252" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_3_field_1" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;感知：多视角RGB-D构建有语义的三维场景&lt;/b&gt;&lt;br&gt;&lt;br&gt;每个时刻输入语言、多个相机RGB-D及机器人状态。点云先裁剪、降采样；每个三维点投影到多个RGB视角，从DINOv2提取像素特征并按点到投影表面的距离加权融合。PointNet++进一步压缩为场景token，同时保留点位置和语义。这个过程区别于把整幅点云压成一个全局向量，能保留抓持位置等局部结构。初始时刻由语言提示经GroundingDINO检测框，再用SAM分割目标，从掩码深度中随机选200个物体表面查询点F0；每回合只做一次初始选点。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_3_branch_1" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_3_field_2" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;两种监督标签怎样获得&lt;/b&gt;&lt;br&gt;&lt;br&gt;关键帧由夹爪开闭和机械臂关节变化的启发规则确定，对应示范夹爪位姿直接作为关键动作标签；剩余关键帧不足时重复末尾标签补齐。点流标签以同一组初始物体点为基础：先变到物体坐标，再用每个关键时刻的物体位姿变回世界坐标，得到未来位置。仿真使用RLBench2真值物体位姿；真机用BundleSDF和FoundationPose估计，因此标注质量依赖位姿跟踪。点流在训练中需要六自由度物体信息，推理则由网络预测，不能把训练要求和部署传感要求混为一谈。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_3_branch_2" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="934.0" as="sourcePoint"/><mxPoint x="1942" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_3_field_3" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;单向注意力：由场景到物体、夹爪、连续动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;扩散Transformer接收场景token、语言token、初始查询点，以及加噪的关键姿态和连续动作。所有点流与动作token读取场景和语言；关键姿态token额外读取点流，获得对象层面的变化；最终连续动作token读取前面全部表示，从物体轨迹和夹爪目标中提炼局部信息。它的单向注意力方向与单纯辅助视频预测不同：这里连续动作确实以预测接口为条件，部署时仍保留接口计算。三维相对位置用旋转位置编码进入注意力，本体状态和去噪时间步用FiLM特征调制注入。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_3_branch_3" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1496.0" as="sourcePoint"/><mxPoint x="1942" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_3_field_4" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;损失、采样与输出控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;连续动作损失与关键动作损失分别监督扩散噪声预测，点流损失直接回归未来三维点位置，三项都用L1。总权重依次为0.05、0.05、1，使物体点流监督有足够影响。训练DDPM共1000时间步；实际预测50个连续动作和4个关键动作及点流。仿真采样1000步DDPM，真机改用20步DDIM降低延迟。输出是双臂目标夹爪位姿及开合度，能在连续段中学习擦拭曲线、水平抬升等约束，仍依赖底层控制器执行；注意力和示范并不构成严格的碰撞安全保证。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1791" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_3_branch_4" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2040.5" as="sourcePoint"/><mxPoint x="1942" y="2040.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_4_field_1" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机硬件、示范与指标&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机为两台Franka Research3，有两台腕部Eye-on-Hand与一台Eye-on-Base RealSense D435i，共3台RGB-D相机；货架场景用Robotiq2f-85夹爪。任务是搬托盘、交接并插盘、擦盘、扫描瓶子。用两个GELLO同构遥操作设备采集示范，搬托盘50条，其余每任务20条。每任务10个设置、每设置3次，区分完整任务成功率SR、找到接触位置的定位成功率Loc-SR，以及按中间阶段归一到10分的得分。定位成功不能当作任务成功，因为抓对位置后仍可能碰撞、轨迹失当或任务次序失败。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_4_branch_1" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_4_field_2" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机主结果与泛化的实际含义&lt;/b&gt;&lt;br&gt;&lt;br&gt;表I本文四任务SR为50%、40%、70%、90%，平均62.5%；Loc-SR分别100%、100%、80%、90%，平均92.5%，归一得分平均8.2。DP3的SR35%、Loc-SR57.5%、分数5.5，因此SR高27.5个百分点，分数高2.7分；3D Diffuser Actor定位65%但SR5%，说明定位与可执行过程差距很大。泛化测试含托盘上物品干扰、暗光和闪烁光、擦盘多对象干扰，以及新盒子和酸奶瓶。新对象表V中本文定位成功但完整任务失败、得7.5分，不能把作者所说零样本新对象操作写成整任务全部成功。每泛化条件仅3次，统计规模较小。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_4_branch_2" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="986.5" as="sourcePoint"/><mxPoint x="2632" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_4_field_3" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真结果、消融与协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真在CoppeliaSim的RLBench2选7任务，作者因训练测试阴影不一致和缺少点流元信息重新生成数据。每任务100回合，主结果对3个检查点平均：本文80.8%、3D Diffuser Actor64.7%、PerAct2 40%、DP3 26%、ACT15.4%，比最强基线高16.1个百分点。本文各项为Box96.7%、Ball89.3%、Drawer79.7%、Laptop46.3%、Dustpan98.7%、Tray92%、Handover62.7%。消融报告最好检查点：仅连续47.6%、仅关键帧49%、连续加关键姿态53.6%、连续加点流74.3%、完整82.6%。82.6%的最佳值不能与主表80.8%的检查点平均混用。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_4_branch_3" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1583.5" as="sourcePoint"/><mxPoint x="2632" y="1583.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_4_field_4" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练成本、失败与证据边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练批量128、学习率1e-4并用余弦调度，RLBench2训练500轮，真机5000轮；示例100条、每条150–250步数据在8张A100上约20小时，评估选平均验证损失最低的检查点。这与仅需要20条真机示范不是同一个成本维度，视觉基础模型与采样仍耗算力。主表显示搬托盘50%和插盘40%还远未解决；泛化中定位正确但任务未完成，说明连续过程仍可能失败。本地11页没有正文指向的附录，全部评分细则、每个控制设置与更详细失败数据未完整获得。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_4_branch_4" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2145.5" as="sourcePoint"/><mxPoint x="2632" y="2145.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_5_field_1" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者列出两点：视觉基础模型和扩散过程计算量限制效率，需要更快采样和轻量视觉模型；跨机器人形态评估仍欠缺，需要在不同硬件上检验泛化。因此本文Franka结果不能直接支持DH116迁移结论。另一个从实验可见的边界是已知刚体点流标注较成熟，但物体变形或跟踪失败时标签和接口质量会下降，这属于本文结果之外的分析，不冒充作者已经验证。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_5_branch_1" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_140_5_field_2" parent="paper_140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116、D435i与闭环的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;D435i多视角输入与当前硬件有直接参考价值，可先在DH116建立相机外参、深度对齐与公共坐标系，再用目标物体200查询点和关键夹爪位姿作为可视化接口。人手视频可帮助定义物体点流与目标接触，但缺少机器人连续动作，仍需重定向或机器人示范补齐，本文没有解决这部分。建议首先选择搬托盘和交接任务，比对接口预测误差、定位成功和完整任务成功，避免只看终点位置。部署中用新观测检查预测点流与物体实际运动是否相符，偏差大时缩短动作块、重采样或进入重抓；这类失败恢复和实时控制频率需要单独实现、计时与评估。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_140_5_branch_2" edge="1" parent="paper_140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-page-06" name="06 动作建模与控制">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="4080" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="category_06_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="80" y="42" width="290" height="60" as="geometry"/>
          </mxCell>
        </UserObject>
        <mxCell id="category_06_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="06 动作建模与控制">
          <mxGeometry x="100" y="150" width="2000" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="category_06_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#24435A;align=left;verticalAlign=top;spacing=24;" value="这个方向在研究什么：动作建模与控制&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去&lt;br&gt;&lt;br&gt;知识链条：观察与任务 → 动作表示 → 生成或规划 → 实时执行 → 反馈更新&lt;br&gt;共 19 篇 · 点击下方卡片进入独立论文页，再按本类编号顺序浏览">
          <mxGeometry x="100" y="280" width="2000" height="330" as="geometry"/>
        </mxCell>
        <UserObject id="category_06_paper_04" label="#4 FP2&lt;br&gt;要解决：上层模型知道手臂要往哪里走后，碰到物体时怎样控制推、拉和压的力度？&lt;br&gt;年份 / Venue：2026；arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-04" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_06_paper_06" label="#6 FoAM&lt;br&gt;要解决：任务少量示范时，模型能否先想象动作的结果，再在没专门练过的任务上操作？&lt;br&gt;年份 / Venue：2026，AAAI 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-06" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="1120" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_06_paper_34" label="#34 REMAC&lt;br&gt;要解决：模型计算要等 100 多毫秒， 机器人怎样不断顿又不让前后动作打架？&lt;br&gt;年份 / Venue：2026，ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-34" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
