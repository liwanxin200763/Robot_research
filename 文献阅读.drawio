            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_46_1_field_1" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICLR&lt;br&gt;引用量：73（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_1_branch_1" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_1_field_2" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_1_branch_2" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_1_field_3" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论大型模仿策略在新环境中仍可能出现局部失误。&lt;br&gt;核心思路是Policy Decorator 在已有模仿策略外加模型无关的 residual policy，对执行动作进行局部修正。&lt;br&gt;与当前项目的联系：项目联系：可作为双臂 VLA 或 ACT 的附加纠错层" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_1_branch_3" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_1_field_4" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：大型模仿策略在新环境中仍可能出现局部失误&lt;br&gt;&lt;br&gt;为什么重要：提供不改动主策略的轻量失败修正路线" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_1_branch_4" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_1_field_5" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：在线策略改进与残差动作纠正。RL（强化学习）通过环境奖励学习；SAC（软演员评论家）是兼顾奖励与探索的强化学习算法，用来训练小纠正器&lt;br&gt;核心研究问题：大策略从示范学会大部分动作，但某些位置偏一点就失败。怎样保留已有能力，用环境反馈只学习额外小修正，而不是重训整个大模型？&lt;br&gt;之前方法的问题：完整大模型在线训练成本高；随机探索也会破坏已会的技能。只靠更多成功示范，未必能覆盖策略自己跑到的异常状态" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_1_branch_5" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2123.0" as="sourcePoint"/><mxPoint x="562" y="2123.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_2_field_1" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开&lt;br&gt;&lt;br&gt;之前方法的问题：重新训练完整策略成本高，且难快速修复特定失败" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_2_branch_1" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_2_field_2" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;SAC：一种通过奖励学习连续动作的强化学习算法" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_2_branch_2" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="934.0" as="sourcePoint"/><mxPoint x="1252" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_2_field_3" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：模仿学习从示范得到基础行为，强化学习在实际交互中依据奖励改进。两者组合可补示范遗漏，但需要环境能判断任务成功&lt;br&gt;相关方向 2：残差学习在基础动作上加一个小增量。纠正器要受到范围约束，否则可以完全推翻基础行为，使探索变得困难和不稳定&lt;br&gt;代表工作：Behavior Transformer 与 Diffusion Policy（扩散策略，从噪声逐步生成连续动作） 等基础策略都可接纠正器。模型无关指接口兼容多种策略，并不意味着无需观察、奖励和训练&lt;br&gt;与已有方法的区别：#44 RESETTLE 有分歧触发与参考检索；本篇用持续在线学习出的残差改动作，没有独立失败原因诊断、场景重置和恢复技能选择" vertex="1">
          <mxGeometry height="674" width="628" x="1252" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_2_branch_3" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1566.0" as="sourcePoint"/><mxPoint x="1252" y="1566.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_3_field_1" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：Policy Decorator 在已有模仿策略外加模型无关的 residual policy，对执行动作进行局部修正&lt;br&gt;&lt;br&gt;冻结大策略，在其动作上学小修正：Policy Decorator 保留离线模仿学来的基础策略，另训练与模型类型无关的残差策略；最终动作由基础动作与受限制的修正合成。基础策略提供已有技能和较平滑运动，残差利用在线交互的任务奖励修正它在新状态下的不足，避免从零随机探索整套动作" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_3_branch_1" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_3_field_2" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;探索范围为什么必须受控&lt;/b&gt;&lt;br&gt;&lt;br&gt;若小修正可以任意大，在线强化学习仍可能离开基础策略分布并产生抖动。本文围绕基础动作控制探索，使改进在可用先验附近进行；收益同时依赖交互数据和奖励，因此不能称为只重排旧示范就提高性能。它对 Behavior Transformer 与 Diffusion Policy 的实验，也是在检验修正层能否跨基础模型复用" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_3_branch_2" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="916.5" as="sourcePoint"/><mxPoint x="1942" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_3_field_3" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：冻结预训练的基础策略，只训练小残差策略。输入当前状态与基础动作，输出额外动作增量，使大模型主要能力得到保留&lt;br&gt;贡献 2：用 SAC 从任务成功奖励中学习纠正，先限制残差幅度，并逐步提高其参与程度，避免早期随机残差把基础策略的有效行为破坏&lt;br&gt;贡献 3：适配不同基础模型，检查受限探索与渐进混合的作用。仍需在线环境交互和奖励信号，成本发生在纠正器训练，不是免费推理插件&lt;br&gt;方法流程：观察 → 冻结基础策略提议动作 → 小残差策略补修正 → 执行合成动作 → 环境给奖励 → 更新残差策略 → 保持基础策略不变" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_3_branch_3" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1478.5" as="sourcePoint"/><mxPoint x="1942" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_4_field_1" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：ManiSkill 与 Adroit，共八项任务&lt;br&gt;&lt;br&gt;主要结果：作者报告在两项 benchmark 的八个任务上提升所比较策略；具体幅度需查论文表格&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：ManiSkill 与 Adroit，共八项任务&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告在两项 benchmark 的八个任务上提升所比较策略；具体幅度需查论文表格" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_4_branch_1" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_4_field_2" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：在 ManiSkill 与 Adroit 等仿真操作任务中验证，包括搬物体和灵巧手操作；报告学习曲线与最终成功率。本地论文主要证据是仿真&lt;br&gt;对照：比较不同在线改进方法、基础策略和探索约束；Behavior Transformer 覆盖8项，扩散策略覆盖6项，已有近满分任务未全纳入后者比较&lt;br&gt;结果：论文多项任务学习曲线接近满成功，说明在给定奖励和交互预算下能补基础动作误差。没有统一总成功率时，此卡不自算或虚构一个平均值&lt;br&gt;真机 / 关键补充：评估按多个随机种子和每阶段50次执行统计；Rollout（一次执行）是策略从初始状态运行到结束的完整过程。本轮未发现真机部署成功率证据" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_4_branch_2" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1056.5" as="sourcePoint"/><mxPoint x="2632" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_4_field_3" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_4_branch_3" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1601.0" as="sourcePoint"/><mxPoint x="2632" y="1601.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_5_field_1" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可作为双臂 VLA 或 ACT 的附加纠错层&lt;br&gt;&lt;br&gt;主要局限：残差动作要经过安全限幅，避免真机接触中的突然修正&lt;br&gt;&lt;br&gt;局限与启发：主要局限：残差动作要经过安全限幅，避免真机接触中的突然修正" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_5_branch_1" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_46_5_field_2" parent="paper_46" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：作者讨论扩散大策略在线采样成本，以及需要可交互环境和成功奖励。纠正只在少数关键状态有用时，探索仍可能困难&lt;br&gt;我的理解 / 不足：我的判断：仿真允许反复试错，真机灵巧手不能同样大量碰撞探索；基础策略若根本不会任务，小残差也不一定能救回来&lt;br&gt;未来展望：先在仿真训练有动作限制的纠正器，再测试低风险真机校准；把失败类型与奖励定义清楚，评估纠正是否引入新的动作抖动&lt;br&gt;对我们项目的启发：适合作为 DH116 的残差控制参考：基础抓握负责主要动作，小模块补指尖或腕部偏差。必须设计接触安全限制与成功判据，不能直接照搬仿真探索" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_46_5_branch_2" edge="1" parent="paper_46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
