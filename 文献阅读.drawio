            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_105_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-106" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_105_1_field_1" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICLR&lt;br&gt;引用量：949（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作&lt;br&gt;数据链条位置：大规模跨机器人预训练后的双臂策略" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_1_branch_1" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_1_field_2" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;双臂基础策略的数据瓶颈：左右臂组合使动作空间更大，同一任务又可能由不同手先动或分工完成。RDT-1B 研究如何利用多机器人数据预训练一个大规模双臂策略，再用目标双臂示范适配；它同时处理输入模态差异和动作表示差异，并非把两个单臂模型简单并排" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_1_branch_2" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_2_field_1" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;为何需要统一动作空间：不同机器人把动作存为关节、末端、速度或夹爪值，强行按同一位置拼接会混淆物理含义。RDT 的统一空间按可解释物理通道放置动作，并通过掩码区分缺失量；扩散模型表达多种可行动作，Transformer 负责融合语言、视觉与机器人状态" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_2_branch_1" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_2_field_2" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_2_branch_2" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="927.0" as="sourcePoint"/><mxPoint x="1252" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_2_field_3" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务中，对某些观察可能左右手都能完成，但两只手一起去抓同一位置会冲突。动作生成模型需要表达一套连贯的联合解法，而不是分别选两个看起来合理的动作。RDT 的联合动作序列和条件输入处理这种相关性，预训练则提供可复用视觉与操作经验" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_2_branch_3" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1342.0" as="sourcePoint"/><mxPoint x="1252" y="1342.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_3_field_1" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;预训练与双臂微调&lt;/b&gt;&lt;br&gt;&lt;br&gt;预训练与双臂微调：先把多机器人观察和动作转换到统一物理表示，结合相应缺失掩码训练扩散 Transformer；模型根据文字、图像和本体状态，逐步把动作噪声变成未来双臂轨迹。随后用超过 6000 条自采多任务双臂示范微调，把共享先验接到 ALOHA 的具体关节与任务&lt;br&gt;&lt;br&gt;执行与设计取舍：模型规模约 1.2B，推理用扩散采样加速减少生成步骤，并以动作块交给控制器。统一语义有助于共享知识，却不免除目标本体标定、动作频率和限位核验；对不存在的通道用掩码，不代表机器人凭空获得该自由度" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_3_branch_1" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="442.0" as="sourcePoint"/><mxPoint x="1942" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_3_field_2" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：统一表示应保留物理量意义，缺失的通道通过掩码处理，不能把空值误当必须输出零动作。训练时还要处理不同频率的状态和图像，动作块的每一步对应具体时间。部署到新机器人后，预测的抽象通道仍由本体转换器解码，若坐标系或夹爪正负号错了，模型预训练能力也救不了接口错误&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_3_branch_2" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1109.0" as="sourcePoint"/><mxPoint x="1942" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_4_field_1" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机设置和对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;ICLR 2025 原文在 ALOHA 上比较 ACT、OpenVLA、Octo、从头训练 RDT 和预训练版本，测试洗杯、按语言倒指定水量、交接、折短裤等。洗杯与跨房间倒水每条件 8 次，交接、折裤等每项 25 次；不同任务分母不同。训练报告 48 张 H100 80GB 预训练约一月，不能称普通单卡即可完整复现" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_4_branch_1" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_4_field_2" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与主要数字&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 2 新杯子条件完整 RDT 成功 50%，小模型 37.5%、回归版 12.5%、从头训练 0%；新场景为 62.5%，并非每项都严格胜过小模型。指定水量子任务完整模型 100%，回归版 12.5%。这些小样本真机结果支持预训练和动作分布建模的重要性，但不保证任意双臂任务都能只靠一到五条示范学会" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_4_branch_2" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="811.5" as="sourcePoint"/><mxPoint x="2632" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_4_field_3" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：洗杯各列包含抓杯、开水龙头、接水、倒水和放回，最后 Total 才是完整任务成功；指定倒水还检验左右手和量词，不能只统计拿起容器。模型规模、预训练和去掉扩散的消融分别改变不同能力，单一表格的最好数值不足以说明通用双臂模型已经胜任所有长程任务&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_4_branch_3" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1391.0" as="sourcePoint"/><mxPoint x="2632" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_5_field_1" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对本项目的可用层次&lt;/b&gt;&lt;br&gt;&lt;br&gt;对本项目的可用层次：完整训练算力和示范采集成本高，公开预训练模型的本体适配比从头训练更现实。DH116 的耦合手指动作不能直接塞进双夹爪通道，可先研究统一状态和掩码，再比较目标任务微调前后成功率；语言遵循、动作稳定和接触安全仍需独立评估&lt;br&gt;&lt;br&gt;把关键设计与实验读透：适配灵巧手时，可先从左右腕动作与低维手指功能开始定义接口，检验公开模型的观察表示是否可用，再研究完整高维动作头。数据预算应包括微调示范与困难失败状态，既测训练任务也测新物体和新指令；不能因为能读懂文字，就默认手指接触执行也会正确" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_5_branch_1" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_105_5_field_2" parent="paper_105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_105_5_branch_2" edge="1" parent="paper_105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="969.0" as="sourcePoint"/><mxPoint x="3322" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
