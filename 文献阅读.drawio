            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_103_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-104" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_103_1_field_1" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL&lt;br&gt;引用量：46（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作&lt;br&gt;数据链条位置：示范驱动的移动双臂基准" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_1_branch_1" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_1_field_2" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;为什么简单抓放基准不够：家庭任务需要机器人换位置、开抽屉、取盘子，动作可能被自身和柜门遮挡，示范者也会用不同解法。BiGym 提供示范驱动的移动双臂仿真环境，检验算法在这些困难下能学到什么，而不是只在固定台面的短动作上得高分" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_1_branch_2" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_2_field_1" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;基准提供环境，算法负责学习：普通模仿学习从示范拟合动作，示范引导强化学习还会在环境中试动作并用奖励更新。BiGym 同时测试两类路线，所以数据预算、环境交互次数和输入必须分开看。相同任务上低成功率可能来自记忆不足、两臂协调或移动控制，不能一律归因于示范质量" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_2_branch_1" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_2_field_2" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_2_branch_2" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="927.0" as="sourcePoint"/><mxPoint x="1252" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_2_field_3" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;人类示范常含停顿、回撤和不同路径，仿真脚本的轨迹则更规则。BiGym 使用人工示范，是为了让学习算法面对更接近真实采集的噪声与多解性。用脚本专家重新采一套更整齐数据也可以做研究，但那已经改变了原基准的数据条件，应单独报告" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_2_branch_3" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1342.0" as="sourcePoint"/><mxPoint x="1252" y="1342.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_3_field_1" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务、观察和示范接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务、观察和示范接口：基于 MuJoCo 搭建 Unitree H1 移动双臂家庭场景，提供 40 项任务与人类采集示范；观察含本体状态和三个视角的 RGB、深度。任务从目标触达延伸到洗碗机与厨房整理，机器人要在只能看到部分场景时推断接下来该去哪、哪只手先动&lt;br&gt;&lt;br&gt;怎样比较学习路线：统一任务和人类示范，比较 BC、ACT、Diffusion Policy 及 DrQ-v2、AWAC、IQL、CQN 等示范引导方法。前者主要依赖固定数据，后者还有在线仿真训练；动作多模态指同一目标存在多种正确解法，模型若简单平均这些动作，可能选出两种解法之间都不成功的动作" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_3_branch_1" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_3_field_2" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：三个视角和本体状态可帮助机器人补足局部遮挡，但并不让所有场景状态都可见。比如柜门挡住另一只手时，策略要利用过去观察推断手的位置；移动到新位置后，相同局部画面也可能对应不同任务阶段。这解释了为什么历史窗口和记忆模型是适合在该基准检验的改进&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_3_branch_2" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1144.0" as="sourcePoint"/><mxPoint x="1942" y="1144.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_4_field_1" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;评测数字与困难&lt;/b&gt;&lt;br&gt;&lt;br&gt;评测数字与困难：附录表 2 每任务评估 50 回合并汇总最后三个检查点：ACT 单目标触达 100%，双目标触达约 90.7%，移动盘子 30.0%；堆块对列出的方法均为 0%。这些是仿真结果，说明简单到达与接触丰富任务的难度差距很大，不能用一个高分代表四十任务普遍解决&lt;br&gt;&lt;br&gt;基准价值与证据边界：论文把完整任务成功作为核心指标，并展示长任务和部分观察的失败；没有在本文证明某模型可直接部署到真实 H1 或固定双臂硬件。其主要贡献是可重复比较任务和数据，低分为方法改进提供空间，不意味着任务数据自动有问题" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_4_branch_1" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_4_field_2" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：表 2 的 ACT 触达成绩很高，而堆块和多物体整理低分，说明靠动作块还不足以解决细接触和长程协作。示范引导强化学习还可能因为稀疏奖励难以接续任务；比较失败率时，应看策略是否完成早期步骤、在哪个阶段失去物体或选错下一目标，而不是只把零分叫没有学习&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_4_branch_2" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1109.0" as="sourcePoint"/><mxPoint x="2632" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_5_field_1" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对双臂研究的用法&lt;/b&gt;&lt;br&gt;&lt;br&gt;对双臂研究的用法：原文局限包括当前只有 H1 本体、许多任务仍是技能级而非复杂长程规划。可先选固定底座也能对应的开抽屉、放盘和双手稳定任务，研究历史观察或左右手信息共享，再逐步引入移动；应保持相同示范数与评估回合，避免把任务简化后的成绩直接与原表比较&lt;br&gt;&lt;br&gt;把关键设计与实验读透：可先从基准中选三类任务形成小评测集：自由空间到达、单臂接触、双臂耦合。保持图像输入、示范数和评估种子相同，再加入历史记忆或左右信息共享。若需要删去移动能力来适配自己的固定双臂，保留原任务和修改任务两套结果，避免失去可比较性" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_5_branch_1" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_103_5_field_2" parent="paper_103" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_103_5_branch_2" edge="1" parent="paper_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="969.0" as="sourcePoint"/><mxPoint x="3322" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
