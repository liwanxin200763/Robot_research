round="#F7FBFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="category_02_back" label="← 返回总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;"><mxGeometry x="80" y="42" width="290" height="60" as="geometry"/></mxCell></UserObject><mxCell id="category_02_title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="02 记忆与时间建模"><mxGeometry x="80" y="125" width="1440" height="88" as="geometry"/></mxCell><mxCell id="category_02_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="这个方向在研究什么：研究机器人怎样保存过去的重要画面、状态和事件，再用它们决定当前动作&lt;br&gt;共 12 篇 · 建议先看 #1 MemoryVLA，再按本页顺序浏览"><mxGeometry x="80" y="232" width="1440" height="105" as="geometry"/></mxCell><UserObject id="category_02_paper_01" label="#1 MemoryVLA&lt;br&gt;要解决：机器人现在看到的画面相同，先前做过的事却可能不同。它怎样利用历史决定下一步？&lt;br&gt;年份 / Venue：2025 arXiv；ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_11" label="#11 TTF-VLA&lt;br&gt;要解决：现有 VLA 常独立处理当前帧，如何在不重新训练模型的情况下利用历史视觉信息，提高动作预测的稳定性和抗视觉噪声能力，利用历史帧，但又不…&lt;br&gt;年份 / Venue：2026，AAAI 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-11" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="380" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_12" label="#12 ContextVLA&lt;br&gt;要解决：如何让 VLA 利用多帧历史解决部分可观测任务，同时避免视频输入造成巨大的训练和推理计算开销&lt;br&gt;年份 / Venue：2025，arXiv，ICLR 2026 投稿版本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-12" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_13" label="#13 CronusVLA&lt;br&gt;要解决：先用单帧学习基本能力，再专门做多帧后训练，如何把已有单帧 VLA 高效扩展到多帧模式，使模型利用时间信息，同时避免从头训练多帧基础模型…&lt;br&gt;年份 / Venue：2026，AAAI 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-13" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="590" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_14" label="#14 HAMLET&lt;br&gt;要解决：如何给已有 VLA 加入真正可利用的历史记忆，使当前动作预测知道过去发生过什么，同时避免从头重新训练整个 VLA&lt;br&gt;年份 / Venue：2026，ICLR 2026&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-14" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_15" label="#15 MEM&lt;br&gt;要解决：（短期：我刚才到底有没有抓稳奶酪，长期：我已经放过黄油没有，长期只需要记忆一句）长时序任务既需要几秒级精细视觉记忆，又需要数分钟级任务…&lt;br&gt;年份 / Venue：2026，arXiv&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-15" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="800" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_21" label="#21 DynaMem&lt;br&gt;要解决：杯子昨天在桌上、今天被拿走了。机器人怎样不再去旧位置找它？&lt;br&gt;年份 / Venue：2024，arXiv:2411.04999&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-21" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_26" label="#26 ECoMEM&lt;br&gt;要解决：机器人怎么记得已放几件物品、 哪只杯子被换过，而不只看当前画面？&lt;br&gt;年份 / Venue：2026，arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-26" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="1010" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_27" label="#27 Divide-and-Remember&lt;br&gt;要解决：历史很长、记忆容量固定时， 怎样留下真正影响动作的信息？&lt;br&gt;年份 / Venue：2026，arXiv 预印本&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-27" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1220" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_38" label="#38 TraceVLA&lt;br&gt;要解决：单张画面看不出刚才推向哪边、物体是否在移动。怎样用少量额外信息补时间线索，又不让大量旧画面占满模型输入？&lt;br&gt;年份 / Venue：2025 / ICLR 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-38" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="810" y="1220" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_39" label="#39 LoLA&lt;br&gt;要解决：做多分钟任务时，当前画面可能相似，但前面已完成的步骤不同。怎样保留长历史，并让这些视觉信息真正指导当前机器人动作？&lt;br&gt;年份 / Venue：2025 / arXiv 预印本，正式 Venue 待核验&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-39" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;shadow=0;"><mxGeometry x="80" y="1430" width="700" height="180" as="geometry"/></mxCell></UserObject><UserObject id="category_02_paper_40" label="#40 4D-VLA&lt;br&gt;要解决：同一物体换视角后图像位置会变；同一画面也看不出历史。能否把跨场景图像映射到有意义的三维位置，并保留重要历史来生成动作？&lt;br&gt;年份 / Venue：2025 / NeurIPS 2025&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-40" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontColo