          </mxCell>
        </UserObject><UserObject id="paper_25_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-19" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="4186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_25_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-35" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="4186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_25_1_field_1" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CoRL 2025; PMLR 305:437-459&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_1_branch_1" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_1_field_2" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：正式发表：Conference on Robot Learning（CoRL）2025，PMLR 305:437–459&lt;br&gt;&lt;br&gt;基本信息与研究问题：DexUMI让人穿外骨骼直接接触物体采集示范，再把人手动作和画面转换为目标机器人手的数据。目标是同时缩小运动学、接触与视觉本体差异，不是用任意裸手视频零样本控制所有手。外骨骼按目标手设计，策略也针对手和任务训练；“Universal”指接口设计原则可复用（§1、3）" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_1_branch_2" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="902.5" as="sourcePoint"/><mxPoint x="562" y="902.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_1_field_3" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;方向：灵巧手数据采集与仿人示教&lt;br&gt;VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 是把图像、语言变成动作的模型&lt;br&gt;核心问题：怎样让人自然示教复杂手指动作，&lt;br&gt;并把示教直接用于不同机器人手？&lt;br&gt;旧式遥操作需要额外控制器；&lt;br&gt;人手与机器人手的形状、触觉也不一致" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_1_branch_3" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1517.0" as="sourcePoint"/><mxPoint x="562" y="1517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_2_field_1" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作：UMI用手持平行夹爪对齐采集和部署，但指间协调与手侧接触能力有限；DexUMI把工具扩成可穿戴多指机构，使人仍能直接感受物体。相对视觉重定向先估人手关键点再优化，本文把可行动作约束前移到机械结构和编码器映射，减少纯视觉姿态误差（§2）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_2_branch_1" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_2_field_2" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_2_branch_2" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_2_field_3" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：DexCap等动捕方案能记录自然手运动，却仍要处理人手与机器人形态差异；同构主从设备采真实机器人数据，又需要现场机器人。DexUMI在采集时不带机械臂，但并非整个流程不需目标手：它仍要标定编码器到电机命令，并让真实手回放动作拍摄外观，才能合成训练视频（§3–4）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：相关方向 1：手部遥操作&lt;br&gt;人控制机器人手，却常缺真实触觉反馈&lt;br&gt;相关方向 2：模仿学习&lt;br&gt;策略模仿示范，但数据采集费时&lt;br&gt;代表工作 UMI 用手持接口采集腕部动作；&lt;br&gt;灵巧手还需要多手指接触信息&lt;br&gt;区别：把机器人手结构穿到人手上，&lt;br&gt;同时记录手指、腕部、视觉和触觉" vertex="1">
          <mxGeometry height="744" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_2_branch_3" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1552.0" as="sourcePoint"/><mxPoint x="1252" y="1552.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_3_field_1" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 让穿戴机构先服从机器人可达性&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 让穿戴机构先服从机器人可达性：外骨骼同时追求可穿戴和指尖工作空间相符。双层优化采样机器人与外骨骼构型，最小化两个方向的指尖姿态距离：一项鼓励覆盖目标手工作空间，另一项防止外骨骼产生机器人达不到的姿态；连杆长度、关节位置与限位约束兼顾穿戴，尤其将拇指机构后移避免与人手争空间（p3–4，图2–3、式1）&lt;br&gt;&lt;br&gt;1. 让穿戴机构先服从机器人可达性：XHand可从URDF／网格提取几何；Inspire闭环四连杆不能只靠普通树形URDF表达，作者用动捕记录真实指尖轨迹，拟合等效机构。为补偿打印件形变，实际还收紧关节范围、调整尺寸。这是几何和材料共同设计，不是下载目标手URDF便自动完成可穿戴设备（附录C）" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_3_branch_1" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="477.0" as="sourcePoint"/><mxPoint x="1942" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_3_field_2" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 标定编码器、腕位姿与触觉&lt;/b&gt;&lt;br&gt;&lt;br&gt;每主动关节配Alps电阻位置传感器；因摩擦和回差，编码器角到机器人电机命令非线性，用逐关节成对采样拟合回归。腕6DoF用iPhone ARKit／Record3D，腕下OAK-1相机150°对角视野在采集与部署保持相同安装关系。相机固定于腕不等于整个世界中不能移动，而是不能随意改变相机相对手的位置（p4–5）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_3_branch_2" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1056.5" as="sourcePoint"/><mxPoint x="1942" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_3_field_3" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 标定编码器、腕位姿与触觉&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 标定编码器、腕位姿与触觉：人手直接接触产生的是操作者自然触感；策略要使用触觉，还需在外骨骼和目标手装同类型传感器。Inspire用FSR电阻触觉，XHand用磁式阵列；人手触感不会自动成为机器人监督。电阻编码器同时测供电电压做归一化，串口包带头和校验，降低供电漂移及解码失真（附录D）&lt;br&gt;&lt;br&gt;3. 消除人手外观，并保留正确遮挡：SAM2分割人手和外骨骼，ProPainter修补背景；随后把同一关节命令在真实目标手上回放，拍下并分割机器人手图像。再求外骨骼掩膜和机器人手掩膜交集，只把可见的机器人手像素合入背景，避免把手错误贴到物体前方。固定起始手势使SAM2可复用提示点（p5–6，图4）" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_3_branch_3" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1636.0" as="sourcePoint"/><mxPoint x="1942" y="1636.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_3_field_4" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 消除人手外观，并保留正确遮挡&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 消除人手外观，并保留正确遮挡：因此该合成不是纯CAD渲染，更不是仅做绿色遮罩。掩膜漏分、背景模糊、光照差、结构形变和电机回差都会同时影响视觉与动作；合成外观漂亮不等于接触几何已经准确&lt;br&gt;&lt;br&gt;4. 时间管理和策略接口：Inspire采集全部流45 FPS，XHand因触觉不稳定降为30 FPS。保存接收时间后减各传感器延迟得捕获时间；iPhone／相机用滚动二维码测延迟，编码器靠动作回放叠图调齐，再对关节和触觉插值至相机时间，训练前下采样3倍（p22，附录E）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="2001" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_3_branch_4" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2285.5" as="sourcePoint"/><mxPoint x="1942" y="2285.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_3_field_5" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 时间管理和策略接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;DINOv2视觉CLS与触觉拼接进Diffusion Policy，预测16步“腕6DoF＋手6或12主动维”动作，执行前8步后重观察；训练400 epochs，DINOv2参与更新。策略10 Hz，UR5底层125 Hz，Inspire10 Hz、XHand60 Hz，动作经插值适配。XHand还用累积已执行相对动作的虚拟当前位置减轻弹性工具导致的读数漂移，属于硬件特定补偿，不能不加验证直接移植（p19、22）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2598" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_3_branch_5" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2830.0" as="sourcePoint"/><mxPoint x="1942" y="2830.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_3_field_6" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：为目标机器人手设计可穿戴外骨骼，&lt;br&gt;编码器记录每根手指关节&lt;br&gt;贡献 2：腕部相机与触觉传感器随手采集；&lt;br&gt;将人的动作映射到机器人手&lt;br&gt;贡献 3：把视频中的人手替换成机器人手，&lt;br&gt;减小训练与部署时的视觉差别&lt;br&gt;流程：人戴外骨骼示教→记录动作/触觉&lt;br&gt;→替换视频手像→训练策略→机器人执行" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="3090" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_3_branch_6" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3339.5" as="sourcePoint"/><mxPoint x="1942" y="3339.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_4_field_1" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据与主表口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;四种任务、五个手—任务设置为Inspire方块、开蛋盒、镊子夹茶；XHand夹茶与厨房操作。数据分别为方块310条、蛋盒175条、两种手夹茶各400条，厨房370条加单独关旋钮100条。每设置20次评估，初态用参考图对齐；两种手因相机可视范围不同，夹茶初态并非严格一模一样（§5、附录B/E）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_4_branch_1" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_4_field_2" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据与主表口径 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据与主表口径 / 表中逐项记录：相对手动作＋触觉＋图像合成：Inspire Cube；最后阶段累计成功率：100%&lt;br&gt;&lt;br&gt;数据与主表口径 / 表中逐项记录：相对手动作＋触觉＋图像合成：Inspire Carton；最后阶段累计成功率：85%&lt;br&gt;&lt;br&gt;数据与主表口径 / 表中逐项记录：相对手动作＋触觉＋图像合成：Inspire Tea；最后阶段累计成功率：85%&lt;br&gt;&lt;br&gt;数据与主表口径 / 表中逐项记录：相对手动作＋触觉＋图像合成：XHand Tea；最后阶段累计成功率：85%&lt;br&gt;&lt;br&gt;数据与主表口径 / 表中逐项记录：相对手动作＋触觉＋图像合成：XHand Kitchen；最后阶段累计成功率：75%" vertex="1">
          <mxGeometry height="709" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_4_branch_2" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_4_field_3" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据与主表口径&lt;/b&gt;&lt;br&gt;&lt;br&gt;五设置算术平均为86%，不能称每种任务／每个阶段都86%。Tea需稳定拿镊子并把至少部分茶叶转入杯；Kitchen为关旋钮、移锅、取盐撒入锅的累计阶段，前段失败后段自动计失败。它们可解释为整链难度，不能和只测独立末阶段的百分比混用（p7，表1；p19）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_4_branch_3" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_4_field_4" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相对动作、视觉和触觉的收益不同&lt;/b&gt;&lt;br&gt;&lt;br&gt;同为带触觉合成图像，手动作改为绝对后，方块100%→10%、Inspire夹茶85%→0%、厨房75%→0%；腕动作两组始终相对，因此该对比不能解释成腕坐标效果。无触觉、相对动作时，蛋盒90%反而高于带触觉85%，Inspire夹茶90%也高于85%，表明触觉噪声会损害部分任务（表1）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_4_branch_4" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1970.5" as="sourcePoint"/><mxPoint x="2632" y="1970.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_4_field_5" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相对动作、视觉和触觉的收益不同&lt;/b&gt;&lt;br&gt;&lt;br&gt;相对动作、视觉和触觉的收益不同：厨房取盐对照最清楚：相对动作下去触觉75%→15%，明显力接触能弥补碗口遮挡；镊子只有微弱力信号，收益不稳定。视觉消融在无触觉／相对动作下，蛋盒Inpaint90%、Mask10%、Raw5%，支持外观适配对精确交互的价值，而不是所有任务都相同幅度提升（p7–8，图6）&lt;br&gt;&lt;br&gt;相对动作、视觉和触觉的收益不同：同一操作者各15分钟采夹茶，DexUMI36条、裸手51条、遥操作11条，约3.2倍效率；这是单任务采集吞吐，未包含外骨骼设计、标定、视频合成与策略训练全部时间（p8，图7）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_4_branch_5" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2515.0" as="sourcePoint"/><mxPoint x="2632" y="2515.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_5_field_1" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：每手都需专用外骨骼和穿戴调参；只匹配指尖，未完整建模手掌接触；打印材料会形变，触觉会受安装和压力漂移影响；图像合成仍需真实手、固定相机关系且有模糊／光照差；目标手回差使同一电机数值受运动方向影响（§7）" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_5_branch_1" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_5_field_2" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的理解：DH116可先做6主动轴、11总自由度的离线耦合与三指工作空间匹配，再决定是否制作机构；不能照抄论文Inspire“12总DoF”或现成XHand映射。当前多轴与臂手控制未验收，不进行命令回放。D435i适合先做外部RGB-D记录和遮挡诊断，替换腕下150°相机后需重建视觉一致性，不能继承86%结果" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_5_branch_2" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="776.5" as="sourcePoint"/><mxPoint x="3322" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_25_5_field_3" parent="paper_25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：最小可复用模块是标定数据定义、相对动作、时间戳及图像遮挡检查；完整系统还需定制机构、编码器／采集板、iPhone、腕相机、匹配触觉、目标手和机械臂。论文未给完整一致BOM与GPU墙钟训练预算，应明确待核验，而非据“人手采集”判断低成本即可全复现&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者指出：每种机器人手需定制外骨骼；&lt;br&gt;3D 打印形变和触觉漂移会影响测量&lt;br&gt;我的理解：手像替换仍需真实机器人图像；&lt;br&gt;光照与遮挡修补可能留下训练偏差&lt;br&gt;未来可自动适配手部结构，&lt;br&gt;并提高触觉与视频转换的可靠性&lt;br&gt;项目启发：可为 DH116 设计手部示教接口；&lt;br&gt;先验证关节映射与触觉一致性" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_25_5_branch_3" edge="1" parent="paper_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1391.0" as="sourcePoint"/><mxPoint x="3322" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
