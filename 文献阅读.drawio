        </UserObject><UserObject id="paper_62_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-130" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><mxCell id="paper_62_1_field_1" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CVPR&lt;br&gt;引用量：20（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_1_branch_1" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_1_field_2" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作&lt;br&gt;&lt;br&gt;论文定位：这篇论文属于 Robot Manipulation; Data 方向，主要讨论机器人操作需要规模大且接近真实交互的训练场景。&lt;br&gt;核心思路是DynScene 根据文字指令用扩散模型生成动态机器人操作场景。&lt;br&gt;与当前项目的联系：项目联系：生成场景需经过真机接触与任务相关性验证" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_1_branch_2" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_1_field_3" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：机器人操作需要规模大且接近真实交互的训练场景&lt;br&gt;&lt;br&gt;为什么重要：为扩展双臂训练环境提供合成数据思路" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_1_branch_3" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1405.0" as="sourcePoint"/><mxPoint x="562" y="1405.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_1_field_4" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：操作场景和轨迹的合成数据；动态场景由机器人的初始环境与后续动作序列组成&lt;br&gt;任务包含开抽屉、调柜门角度和倒水等连续目标状态，需同时保证场景可达与动作可执行&lt;br&gt;核心研究问题：手工布置房间和遥操作录轨迹耗时，独立生成的场景与动作又可能互相冲突&lt;br&gt;作者问能否从指令生成相配的环境和动作，并通过物理仿真筛掉失败样本以扩充训练数据&lt;br&gt;之前方法的问题：静态场景生成可能把机器人或物体放进墙里，或让目标超出可达范围；单独合成动作缺少环境约束&lt;br&gt;随机扰动物体朝向还会使其因重力倒下，导致开始时的任务状态已错误" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1623" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_1_branch_4" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1960.0" as="sourcePoint"/><mxPoint x="562" y="1960.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_2_field_1" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读&lt;br&gt;&lt;br&gt;之前方法的问题：人工制作动态场景速度慢，动作多样性不足" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_2_branch_1" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_2_field_2" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：DiffuScene、PhyScene 侧重房间布局与物体姿态，可生成静态环境，但不保证存在配套成功操作&lt;br&gt;DynScene 从指令生成目标物和机器人初始状态，再从现有布局中挑选位置相近的房间以提高可达性&lt;br&gt;相关方向 2：SynthER、MTDIFF 侧重合成动作轨迹，未联合检查房间与目标物体的物理交互&lt;br&gt;本篇让动作扩散器以已生成场景为条件，并用 Isaac Sim 执行与筛选，避免只凭轨迹形状判断成功&lt;br&gt;代表工作：ARNOLD 提供八项带连续物体状态的仿真任务、3571 条训练和 773 条测试样本&lt;br&gt;PerAct 及其分阶段版本是数据效用评测的策略；DiffuScene、ARNOLD 人工采集是场景生成对照，不是新方法模块&lt;br&gt;与已有方法的区别：把静态布局和末端动作拆成两个条件扩散阶段，再用残差坐标复用轨迹与扩增数据&lt;br&gt;最后以仿真整任务成功作为过滤条件，而非将全部生成结果直接送去训练" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_2_branch_2" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1074.0" as="sourcePoint"/><mxPoint x="1252" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_3_field_1" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;DynScene 根据文字指令用扩散模型生成动态机器人操作场景" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_3_branch_1" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_3_field_2" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：文字只规定目标，不能保证生成摆位可达，作者先以指令条件扩散生成机器人和目标物的初始状态&lt;br&gt;再按机器人底座与物体位置，从现有房间布局挑近邻，并量化物体四元数朝向，降低碰撞、够不到和初始倾倒&lt;br&gt;贡献 2：同一任务可有多条末端轨迹，作者另用场景条件扩散器生成每步位置与四元数的增量及夹爪状态&lt;br&gt;残差表示减弱绝对位置依赖，使一个静态配置可采多条动作；动作增广扩大了轨迹与目标状态覆盖&lt;br&gt;贡献 3：生成动作不一定能完成任务，作者将场景和动作在 Isaac Sim 中执行，并按 ARNOLD 目标阈值只保留成功样本&lt;br&gt;再用这些样本补充 ARNOLD 训练集，训练 PerAct 或抓取、操作分阶段的 PerAct-PSA，测合成数据是否有用&lt;br&gt;方法流程：任务文字 → 静态扩散器生目标物和机器人位姿 → 匹配房间布局并修正物体朝向 → 动作扩散器按场景生末端增量序列&lt;br&gt;同场景多次采样增广 → Isaac Sim 执行并过滤失败 → 合格样本与原数据联合训练策略" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_3_branch_2" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="972.5" as="sourcePoint"/><mxPoint x="1942" y="972.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_3_field_3" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1425" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_3_branch_3" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1639.5" as="sourcePoint"/><mxPoint x="1942" y="1639.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_4_field_1" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：只用 ARNOLD 的八项仿真操作任务，含抓取、物体重定向、柜门／抽屉开合与倒水；每任务生成 100 个场景评测&lt;br&gt;另在 ARNOLD 测试集比较策略成功率，正文称每项策略结果按三次试验求均值，未报告实体机器人试验&lt;br&gt;对照：表 3 比 ARNOLD 人工采集的场景生成时间及成功率；表 4 比 DiffuScene 静态场景加 ARNOLD 动作&lt;br&gt;表 5 比仅用 ARNOLD 与加入 DynScene 数据训练的 BC-Lang、PerAct、PerAct-PSA，表 7 测未见物体、场景和状态&lt;br&gt;结果：表 3 DynScene 平均每场景 2.52 秒、生成成功率 69.50%，人工为 67.50 秒、37.50%，对应 26.8 倍速度和 1.84 倍比值&lt;br&gt;表 5 PerAct 平均成功率 29.14%→34.79%，PerAct-PSA 41.46%→45.62%，分别增加 5.65 和 4.16 个百分点&lt;br&gt;真机 / 关键补充：没有真机实验；表 5 中 PerAct 开抽屉和倒水等个别任务下降，不能说全部任务受益&lt;br&gt;表 7 未见物体 14.53%→17.29%、未见场景 19.00%→22.92%，但范围外新状态 4.58%→3.30%" vertex="1">
          <mxGeometry height="884" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_4_branch_1" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="582.0" as="sourcePoint"/><mxPoint x="2632" y="582.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_4_field_2" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1052" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_4_branch_2" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1249.0" as="sourcePoint"/><mxPoint x="2632" y="1249.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_5_field_1" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：生成场景需经过真机接触与任务相关性验证&lt;br&gt;&lt;br&gt;主要局限：场景多样性不一定等于真实机器人成功率提升&lt;br&gt;&lt;br&gt;局限与启发：主要局限：场景多样性不一定等于真实机器人成功率提升" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_5_branch_1" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_62_5_field_2" parent="paper_62" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：只在 ARNOLD 一个数据集检验；更复杂、超出训练范围的目标状态仍未解决&lt;br&gt;表 7 的范围外新状态成绩下降，作者提出未来增加更丰富的状态表示与数据范围&lt;br&gt;我的理解 / 不足：仿真过滤保证符合 ARNOLD 的成功判据，不保证真实摩擦、液体流动或接触力一致&lt;br&gt;部分任务在加入合成数据后退化，说明数量与多样性增长仍需按任务检查质量；这是从表 5 推出的判断&lt;br&gt;未来展望：跨仿真器和真机重测生成样本的可达性、物体稳定性、接触结果，再按任务筛选有益轨迹&lt;br&gt;尤其应单独扩充超范围目标状态并比较是否修复表 7 的下降；这些测试尚未出现在论文中&lt;br&gt;对我们项目的启发：可在双臂仿真里先生成场景和动作，再以接触与任务判据筛选训练轨迹&lt;br&gt;若用于 DH116，需把夹爪开合改成多指关节及触觉约束，并验证真机抓握；目前证据只支持 ARNOLD 仿真数据增广" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_62_5_branch_2" edge="1" parent="paper_62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1039.0" as="sourcePoint"/><mxPoint x="3322" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
