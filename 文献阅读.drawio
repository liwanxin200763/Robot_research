          </mxCell>
        </UserObject><UserObject id="paper_63_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-64" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_63_1_field_1" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本；未见正式会议或期刊接收信息&lt;br&gt;引用量：引用量来源：（沿用本地记录，未重新查询）&lt;br&gt;研究方向：04 执行误差与失败恢复" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_1_branch_1" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_1_field_2" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：任务失败可能来自抓空、碰撞、观察变化或动作执行偏差。发现异常只是第一步，系统还要判断是否能局部重试、需要回退到哪一步、怎样确认恢复有效；短时修正与长期重新训练也属于不同层次&lt;br&gt;&lt;br&gt;研究背景与问题：预训练 VLA／VTLA 在部署环境的物体属性、接触动力学或位置变化下，可能出现对位、接触时机及接触力错误。直接用真机 RL 纠错需要大量可能损坏物体的试验。论文要减少接触丰富操作中部署期适应所需的交互次数。（第 I 节）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_1_branch_2" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="832.5" as="sourcePoint"/><mxPoint x="562" y="832.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_1_field_3" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：触觉操作、执行偏差与失败恢复&lt;br&gt;VLA 从视觉、指令和机器人状态生成动作；触觉版本另看双指尖力／力矩，接触力区间是任务允许的用力范围，不等同于完整动作轨迹&lt;br&gt;核心问题：换物体位置或接触条件后，机械臂可能对不准、接触过早或用力不当；真机逐次试错昂贵且可能损坏物体&lt;br&gt;作者研究能否区分运动错误与力错误，用少量在线回合修正已训练策略&lt;br&gt;之前方法的问题：残差强化学习或扩散策略更新主要靠奖励反复探索，成功与失败只给稀疏信号&lt;br&gt;单靠快速力控制又不会自动修正接近路径和接触时机，因此需要让运动适应与力区间更新各管不同误差" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_1_branch_3" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1482.0" as="sourcePoint"/><mxPoint x="562" y="1482.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_2_field_1" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败检测判断哪里不对，恢复策略决定接下来做什么，在线修正改变当下动作，后训练把经验留进模型。阅读时应确认本文实际实现其中哪些环节，以及恢复后能否继续原任务；人的接管与机器人自主恢复要分开" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_2_branch_1" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_2_field_2" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_2_branch_2" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_2_field_3" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：视觉或视觉触觉行为克隆把示范映射为末端动作段，GR00T N1.7 是本篇微调的基础模型&lt;br&gt;它提供初始可执行行为，却可能在未见过的摩擦、物体位置与力阈值下失效；PEARS 在部署期继续适应&lt;br&gt;相关方向 2：DSRL 在冻结扩散／流匹配策略的初始噪声上训练轻量强化学习策略，借改变噪声改变生成动作&lt;br&gt;PEARS 接入指尖触觉以修正对位和接触时机，同时另设力推理模块，不把 DSRL 当作新发明的底座&lt;br&gt;代表工作：Residual RL 直接学习动作残差，AWR 与 DPPO 从在线奖励更新策略，论文把它们作为相同任务的适应对照&lt;br&gt;ForcePolicy、ForceVLA2 等研究高速力位混合控制；它们说明接触反馈的重要性，却不是本篇的失败原因推理模块&lt;br&gt;与已有方法的区别：每回合结束后把最后接触画面和力曲线交给视觉语言模型，判断力不足、力过大或非力错误&lt;br&gt;只有力错误才定向调整目标力范围；在接触阶段由 50 Hz 控制器执行范围约束，避免只靠随机探索寻找合适力度" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_2_branch_3" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1380.5" as="sourcePoint"/><mxPoint x="1252" y="1380.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_3_field_1" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;PEARS 将两条纠错途径分开：触觉条件化 DSRL 在冻结的 GR00T N1.7 flow-matching 策略的初始噪声空间训练轻量 actor–critic，主要纠正自由空间轨迹和接触时机；Physics-guided Force Reasoning（PFR）在每回合后根据最终接触画面、触觉力轨迹和本回合力区间判断用力不足、过大或非力相关错误，再更新力区间。50 Hz 的混合力—位置控制器只在接触阶段约束选定力轴，其他自由度仍跟随基础策略。PFR 判断为对位／轨迹错误时不改力区间。（第 III–IV 节、图 1–2、算法 1）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_3_branch_1" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_3_field_2" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：基础流匹配策略参数冻结，触觉条件化 actor 读取视觉特征、末端状态与双指尖力，输出 10 维初始噪声&lt;br&gt;该噪声引导 32 步动作段的生成；每次只执行前 10 步再观察，从而用轻量在线学习改变对位和接触时机&lt;br&gt;贡献 2：用力失败与轨迹失败不能混为一谈；PFR 读取本回合最终接触画面、力轨迹、已用力范围及历史记录&lt;br&gt;判断欠力或过力时移动相应区间；若是定位、轨迹或证据不清，则保持范围，避免错误地越调越大&lt;br&gt;贡献 3：仅更新目标力还不足以稳定接触；作者先估计并人工核对需控制的力轴，接触成立后才开启 50 Hz 力位混合控制&lt;br&gt;选中轴受 PFR 范围约束，其余方向跟随策略动作；离开接触阶段便释放力控制，减小对自由空间运动的干扰&lt;br&gt;方法流程：腕部／外部图像、指令、末端状态和指尖力 → 触觉 actor 选择潜在噪声 → 冻结 GR00T 生成末端动作段&lt;br&gt;接触门控按目标力修正选定轴并执行；回合结束后 PFR 诊断结果、更新下回合力范围，再继续在线学习" vertex="1">
          <mxGeometry height="814" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_3_branch_2" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1109.0" as="sourcePoint"/><mxPoint x="1942" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_4_field_1" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入、动作与数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;基础策略读取腕部与外部 RGB、语言指令、末端位姿和夹爪宽度；两指尖 6D 力／力矩可加入 VTLA 输入。策略预测 32 步的 10 维末端动作块，每次执行前 10 步再观测。RL actor 使用视觉特征、本体状态及双指尖力信号，在 10 维潜在噪声空间学习；基础模型参数保持冻结。每项任务用 50 条离线示范微调基础策略，在线适应另用成功／失败终止奖励。（第 III–V 节）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_4_branch_1" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_4_field_2" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、基线与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;Isaac Sim 三任务是 Thin Sheet Transfer、Bottle Cap Twisting、Fragile Fruit Picking；基线为冻结策略、Residual RL、AWR、DPPO、DSRL。每种在线方法进行 3 次各 100 回合适应，随后每次 100 个测试回合。PEARS 最终成功率分别为 94.7%、87.7%、77.7%；各任务最强对照分别为 DSRL 82.3%、Residual RL 68.0%、DSRL 40.3%，提升 12.4、19.7、37.4 个百分点。Bottle Cap Twisting 达到 80% 在线成功率的回合数为 22，对照 Residual RL 为 47。真机 Whiteboard Erasing 为 19/20，Pipette Liquid Aspiration 为 18/20；冻结策略分别为 11/20、8/20，DSRL 为 15/20、12/20。真机方法各用 40 次在线交互后评估 20 次。（第 V 节、表 I、III、图 3）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_4_branch_2" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="951.5" as="sourcePoint"/><mxPoint x="2632" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_5_field_1" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与失败案例&lt;/b&gt;&lt;br&gt;&lt;br&gt;去掉 PFR／外部力控制，仅保留 DSRL 时三任务成功率为 82.3%、57.7%、40.3%；去掉 DSRL，仅保留 PFR／力控制时为 77.0%、84.7%、61.7%；完整模型为 94.7%、87.7%、77.7%。固定初始力区间、随机搜索力区间及替换 VLM 为 Qwen3-VL-2B 的结果也见表 II，说明力区间适应与噪声空间运动纠错有互补性。真机最终剩余失败：白板擦拭 1 次对位不准，移液管吸液 2 次初始抓取偏位；作者明确指出 PFR 目前只为用力不当提供定向纠正，其他错误仍依赖常规 RL。（第 V–VI 节、表 II–III）" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_5_branch_1" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_5_field_2" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限与研究线索&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者所述：PFR 的定向推理目前限于接触力错误；未来需让失败原因推理指导更一般的 RL 探索与策略更新。（第 VI 节）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_5_branch_2" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="892.0" as="sourcePoint"/><mxPoint x="3322" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_5_field_3" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;局限与研究线索&lt;/b&gt;&lt;br&gt;&lt;br&gt;文献库分析：力控制轴在训练前仍需人工审核纠正；真机只验证两类接触任务，尚不能推出普通夹爪双臂或长程失败恢复的性能。可对照 Taming VLAs 的命令—实际运动残差补偿与 Recova 的失败后恢复，单独测试“检测到失败原因 → 调整力／轨迹 → 再执行”的收益。（第 IV–VI 节；后两项为研究建议）" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_5_branch_3" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1324.5" as="sourcePoint"/><mxPoint x="3322" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_63_5_field_4" parent="paper_63" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：PFR 目前只对接触力不当提供定向修正，偏位等其他错误仍靠常规强化学习探索&lt;br&gt;论文建议把失败原因推理进一步用于更一般的探索和策略更新；当前真机剩余失败主要是初始抓取或擦拭对位&lt;br&gt;我的理解 / 不足：所需力轴在训练前由视觉语言模型估计并由人核对，尚不是无人干预的全自动部署&lt;br&gt;真机仅两类单臂接触任务、每项 20 次测试，不能据此推断长程双臂任务或 DH116 手指接触也有相同收益&lt;br&gt;未来展望：可把对位、接触时机和力过大分别标注，在同一在线预算下比较定向探索与随机探索&lt;br&gt;多接触阶段还应检验力轴估计误差、视觉语言模型误判和控制器安全限幅对最终成功率的影响；这些是后续实验建议&lt;br&gt;对我们项目的启发：机械臂与 DH116 可先做可安全复位的单一接触任务，记录视觉结果、指尖力曲线和失败原因&lt;br&gt;分别测试只改轨迹、只改力范围、两者联合及固定范围；需重建 DH116 力轴和接触阶段判据，论文未证明直接适配" vertex="1">
          <mxGeometry height="849" width="628" x="3322" y="1567" as="geometry"/>
        </mxCell>
        <mxCell id="paper_63_5_branch_4" edge="1" parent="paper_63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1991.5" as="sourcePoint"/><mxPoint x="3322" y="1991.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
