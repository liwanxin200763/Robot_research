          </mxCell>
        </UserObject><UserObject id="paper_134_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-135" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_134_1_field_1" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cross-Embodiment Dexterous Grasping with Reinforcement Learning，方法名CrossDex，本地22页ICLR 2025 PDF与canonical一致。官方 https://arxiv.org/abs/2410.02479 首次2024年10月3日、当前仅列v1；因此应写2024首次公开、2025会议发表。四作者来自北京大学及智源，官方PKU-RL仓库可核验，未运行复现。旧卡引用量42没有本次统计，不视为当前数值。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_1_branch_1" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_1_field_2" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Haoqi Yuan、Bohan Zhou、Yuhui Fu、Zongqing Lu；北京大学计算机学院、北京智源人工智能研究院。代码/项目核验：https://github.com/PKU-RL/CrossDex；项目 https://sites.google.com/view/crossdex。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_1_branch_2" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="829.0" as="sourcePoint"/><mxPoint x="562" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_1_field_3" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;不同灵巧手的关节数量、方向、限位和指头形状不同，直接把一种手的关节控制给另一种手无意义。本文把人类遥操作的思想变成策略接口：策略输出共同的人手姿态，再由各手映射器转成各自关节动作；观测也去掉手型专属关节角。目标是训练一个策略控制多种手，并在未参与策略训练的新手上零样本执行或少量微调。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_1_branch_3" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1268.5" as="sourcePoint"/><mxPoint x="562" y="1268.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_2_field_1" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与单手泛化和形态变体的区别&lt;/b&gt;&lt;br&gt;&lt;br&gt;UniDexGrasp类工作主攻同一手的多对象抓取；GET-Zero等研究一种手的连杆变化，但同一关节序号在不同品牌手上没有统一功能。原始多任务基线用补零的关节角和手型标签，策略容易记住手型。CrossDex选择MANO人手姿态子空间作为动作公共语言，输入用指尖/掌心几何；不同手型通过可单独训练的重定向模块接入，保持共享策略不依赖手型ID。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_2_branch_1" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_2_field_2" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;特征抓型与重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eigengrasp可译为“特征抓型/主成分抓型”，是在人手关节数据做PCA得到的常见协同变化方向，线性组合能表达自然开合等动作，维数低于直接45维手指轴角。重定向按指尖相对几何和关节限位把人手动作变成机器人姿态。零样本特指共享抓取策略未在新手上RL训练，不是新硬件无需模型、标定、重定向训练就能直接接入。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_2_branch_2" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="846.5" as="sourcePoint"/><mxPoint x="1252" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_3_field_1" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：从人手数据建立公共动作空间&lt;/b&gt;&lt;br&gt;&lt;br&gt;在GRAB约160万帧人手交互数据中固定手形状，去除腕部旋转，仅对45维手指轴角做PCA，取前k个特征向量。策略输出k维系数加六维机械臂目标关节位置，线性组合还原人手姿态，再经MANO生成关键点。低维空间压缩不常见的独立关节噪声，让不同机器人共享相似抓型语义；过低维也可能失去抓取自由度，需用消融验证。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_3_branch_1" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_3_field_2" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：建立每只手的快速重定向&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexPilot优化人手/机器人指尖间相对位置，并加入与上时刻关节差及关节限位约束，生成每种机器人手的训练标签。优化逐步求解约300 FPS，会拖慢上万并行仿真，因此为每手训练四层512隐藏MLP，以MSE拟合45维人手姿态到其关节目标，200 epoch后用于批量转换。共享的是策略和人手空间，映射器仍是每手专属；新手必须有正确运动学模型及对应映射。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_3_branch_2" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="829.0" as="sourcePoint"/><mxPoint x="1942" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_3_field_3" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：统一观测并隐藏手型ID&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入保留机械臂关节角、掌心和拇/食/中/无名四指的三维位置、物体信息与上次公共动作；五指手忽略小指位置，少于四指则为缺失位置补零。手本身的原始关节角不输入共享策略，避免维数和含义冲突。物体信息在教师是位姿与几何编码，在学生是512点点云。关键点让策略依据手与物体相对几何行动，但不能完整表达每个关节力学状态。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_3_branch_3" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_3_field_4" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：跨形态训练单物体教师&lt;/b&gt;&lt;br&gt;&lt;br&gt;用Isaac Gym把四种手分别安装到同一六自由度RealMan RM65臂，在并行环境内轮换手型。每个对象训练一个PPO状态教师，故教师按物体分开，却同时看四种手。统一奖励鼓励手指/掌心靠近物体、抬高、减少水平乱移、稳定保持目标高度；不需要为各手单独设计完全不同任务奖励。手臂到手的安装关节原点加高斯噪声，迫使策略适应装配偏差，训练输入不泄露该手型专属变量。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_3_branch_4" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1813.0" as="sourcePoint"/><mxPoint x="1942" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_3_field_5" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：DAgger蒸馏视觉通用策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;学生在所有物体×手型组合里自己采rollout，再由对应物体的教师看状态真值为学生访问的状态补动作标签，最小化公共动作MSE。这与仅保存教师成功轨迹的离线蒸馏不同，学生能在自己造成的偏离状态上得到教师纠正。PointNet和策略一同训练，得到一个不需手型ID、能从物体点云执行的策略。微调新手时复制共享策略，用PPO目标加相对预训练策略KL惩罚，缓解遗忘。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_3_branch_5" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2305.0" as="sourcePoint"/><mxPoint x="1942" y="2305.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_3_field_6" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤六：视觉获取与真实接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;为保并行效率，仿真点云由物体网格采样后按真值位姿变换，不实际渲染相机。真实使用RealSense D435i和实例分割先捕获物体点云，后续用跟踪/位姿估计变换该点云，保持形状一致。这样桥接仿真完整几何与真实部分可见点，但也留下分割遮挡和估姿误差。策略最终输出重定向后的手关节目标和臂目标，经PD控制执行，不是直接输出接触力。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_3_branch_6" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2797.0" as="sourcePoint"/><mxPoint x="1942" y="2797.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_4_field_1" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对象、手型与成功条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;45个YCB刚体对象，剔除非刚体、过多凸分解、过大/过平而需功能抓取奖励的对象。训练手为Shadow22DoF、Allegro16、Schunk SVH20、Ability10，未见手为LEAP16与Inspire12；这是四训练手、两测试手的特定范围。物体从0.3m初始高度，成功需保持0.6±0.05m且手够近：测试30步、训练60步。总评测rollout分母与种子数量没有统一清楚报告，不用8192训练环境数冒充评测次数。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_4_branch_1" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="372.0" as="sourcePoint"/><mxPoint x="2632" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_4_field_2" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与基线&lt;/b&gt;&lt;br&gt;&lt;br&gt;四训练手平均状态88.5%、视觉80.0%；两未见手零样本状态39.1%、视觉35.2%。原始观测+动作MT-Raw-OA训练视觉78.2%、未见视觉16.2%，改公共观测但原始动作MT-Raw-A为72.8%/21.0%，原始观测+公共动作MT-Raw-O为77.9%/14.5%。因此优势重点在新手迁移，状态教师训练分数并非始终最高；普通原始基线训练状态91.4%高于本文88.5%。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_4_branch_2" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="864.0" as="sourcePoint"/><mxPoint x="2632" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_4_field_3" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;微调与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;未见LEAP上五个YCB对象状态微调87.2±1.3%，从零75.8±12.2%；全部YCB视觉微调64.3±0.9%，从零43.6±15.9%；55个新GRAB对象视觉74.0±0.9%，从零31.3±37.3%。这些是微调后，不能混成零样本。去安装随机化且无手型专属观测时，未见视觉20.9%；加入随机化升35.2%。五对象子集比较重定向与训练手数时口径更小，不能将其48.2%未见成绩替代主表35.2%。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_4_branch_3" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_4_field_4" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;算力、真机和特殊形态边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;PPO4090可运行8192环境、4万迭代；DAgger使用16384环境、2万迭代，单A800约10小时，4090用4096环境约两天达到相近表现。正文概述8192环境同时含RL和DAgger，细节以附录配置区分。真实RM65+LEAP提供视频，但未给真机试次和成功率。附录加D’Claw三指手、五个YCB对象联合训练成功85.3±3.3%，这是训练内三指手扩展，非对三指手零样本；其内弯抓型一致性仍较差。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_4_branch_4" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1848.0" as="sourcePoint"/><mxPoint x="2632" y="1848.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_5_field_1" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;仅四训练手限制形态覆盖，未来需更多模型；当前只研究抓起对象，手内重定向、动态交接、功能抓取未验证。附录明确D’Claw形态差异大，特定抓型重定向较差，需更针对的映射方法。YCB筛选已排除过平/过大物体，不能把“通用抓取”理解为所有日常物体或所有手形。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_5_branch_1" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_5_field_2" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116适配分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇对DH116最直接的启发是以人手动作与指尖几何隔开硬件接口，但前提是DH116具有可标定的运动学模型、关节限位和可用目标位置控制。若手指耦合或主动自由度不足，不能任意跟随45维人手姿态；需先用代表性抓型评估重定向误差、接触点覆盖和自碰撞，再决定是否训练专属映射器或把DH116加入联合训练。零样本仍需完成这些适配工作。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_5_branch_2" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="794.0" as="sourcePoint"/><mxPoint x="3322" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_5_field_3" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;视觉与Sim2Real评测建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;建议分别量化公共抓型到本手关节的误差、物体点云/位姿误差、模拟接触稳定和真实抓取保持，而不是只看共享策略输出。触觉可补掌指位置无法表达的受力与滑移，但本文未验证。真正跨手测试应冻结共享策略和明确记录新手映射训练；微调、重定向校准和零样本三个成本分别报告，才能评估DH116接入是否比从零训练节省。以上为后续建议，不表示本项目已经完成。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_5_branch_3" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1286.0" as="sourcePoint"/><mxPoint x="3322" y="1286.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_134_5_field_4" parent="paper_134" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;共同表征的限制分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;丢掉手关节状态能降低对具体手型的依赖，也会隐藏相同指尖位置下不同关节弯曲和接触受力状态；因此这是一项有收益和损失的设计取舍。对耦合较强的DH116可比较仅几何输入与附加可部署接触/关节摘要，不宜预先认定完全去掉本体关节总是最优。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_134_5_branch_4" edge="1" parent="paper_134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1743.0" as="sourcePoint"/><mxPoint x="3322" y="1743.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-135" name="06-16 Progressive Alignment">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3900" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_135_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_135_topnav_1" label="返回分类" link="data:page/id,literature-page-06" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
