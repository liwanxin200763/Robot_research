            <mxGeometry x="3180" y="4086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_73_1_field_1" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / RSS&lt;br&gt;引用量：2275（沿用本地记录，未重新查询）&lt;br&gt;研究方向：07 VLA 基础与泛化" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_1_branch_1" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_1_field_2" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配&lt;br&gt;&lt;br&gt;研究背景：针对每个机器人和任务从零收集示范、单独训练策略成本很高；跨机器人共享的数据已有规模，但观测、动作空间和任务标注并不统一。（论文第 I–II 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：建立可公开复现的通用机器人策略，让同一预训练模型既能在已有机器人上直接执行，也能以少量目标域示范适配新相机、传感器、动作空间及双臂形态。（第 I、III 节）" vertex="1">
          <mxGeometry height="709" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_1_branch_2" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="902.5" as="sourcePoint"/><mxPoint x="562" y="902.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_1_field_3" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;RT-X 等模型对输入和动作接口要求较固定，较大模型未完全开放，针对新传感器或新动作维度微调困难。单一机器人数据训练的策略泛化范围更窄。（第 I–II 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1285" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_1_branch_3" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1475.0" as="sourcePoint"/><mxPoint x="562" y="1475.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_1_field_4" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：跨机器人通用操作策略与少样本微调&lt;br&gt;输入可为语言指令或目标图像，加外部/腕部相机；输出是机器人连续动作段，需按目标硬件重新适配传感器和动作头&lt;br&gt;核心研究问题：单一机器人数据不足以覆盖许多任务，不同数据集又有相机、控制量和语言标注差异&lt;br&gt;作者问能否以统一策略学习可迁移表示，使新机器人只需少量示范就能获得实用成功率&lt;br&gt;之前方法的问题：很多大规模机器人策略只开放有限模型细节，难复现；固定输入与动作维度也不便加入新相机或双臂关节&lt;br&gt;数据混合若缺少标注约束，模型可能把不相关语言与动作联系起来" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1693" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_1_branch_4" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2030.0" as="sourcePoint"/><mxPoint x="562" y="2030.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_2_field_1" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_2_branch_1" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_2_field_2" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_2_branch_2" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="797.5" as="sourcePoint"/><mxPoint x="1252" y="797.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_2_field_3" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;相较 RT-X 的固定接口，Octo 用模块化 Token 与动作头实现传感器、动作空间微调；与从头训练的 Diffusion Policy 或 VC-1 表征基线相比，它提供跨机器人预训练的完整策略初始化。它直接做低层控制，而 SayCan 负责高层技能选取。（第 II、IV 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_2_branch_3" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1272.0" as="sourcePoint"/><mxPoint x="1252" y="1272.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_2_field_4" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：Open X-Embodiment 汇集多种机器人轨迹，提供跨本体预训练资源；RT-1-X 等证明数据聚合有迁移潜力&lt;br&gt;Octo 在其中筛选可用轨迹、训练并开放权重和适配接口，比较时应留意训练集合差异&lt;br&gt;相关方向 2：Diffusion Policy 用扩散过程生成连续多模态动作，适合一个指令对应多种合理操作&lt;br&gt;Octo 把扩散动作头接到通用视觉语言 Transformer 的读出 token，而非只训练单任务扩散模型&lt;br&gt;代表工作：与 RT-1-X、从零训练的 Diffusion Policy、VC-1 初始化模型等比较&lt;br&gt;预训练数据、机器人平台及微调示范数决定可比性；论文同时给出零样本和约百条示范后的结果&lt;br&gt;与已有方法的区别：观察、任务定义和动作空间由模块化 token 接口组合；新机器人可换入相机/本体输入及动作头&lt;br&gt;开放模型、权重和代码，让跨本体微调从可获取的共同起点开始" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="1497" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_2_branch_4" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1904.0" as="sourcePoint"/><mxPoint x="1252" y="1904.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_1" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;把语言或目标图像、历史视觉观测分别转成 Token，送入可按模块扩展的 Transformer，随后由轻量 Diffusion Head 生成连续 Action Chunk。遇到新机器人时增加输入适配器和动作头，保留并微调预训练主干。（第 III 节，图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_1" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_2" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;冻结的 T5-base 编码语言，浅层 CNN 将第三视角/腕部图像切为 Patch；Block-wise attention 的 Transformer 汇合任务与观察 Token，独立 Readout Token 读出动作条件。小型 Diffusion Head 迭代去噪，输出连续动作序列；主干只需前向一次，去噪集中在动作头。（第 III-A、III-C 节，图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_2" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_3" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;语言指令或目标图像，加上最多两个时间步的 RGB 图像；预训练兼容第三视角及腕部相机。新域微调可加力/力矩或本体状态，但论文附录指出，预训练中直接增加本体状态输入的探索反而不佳，不能说原模型普遍依赖本体状态。（第 III、IV 节；附录 E、F）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_3" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1216.0" as="sourcePoint"/><mxPoint x="1942" y="1216.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_4" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;预训练数据统一为末端位置/姿态增量与夹爪状态，预测连续 Action Chunk；Diffusion Head 按 DDPM 目标训练。针对 ALOHA 双臂任务，重新初始化输出到 14 维动作空间的动作头，即双臂各 6 维关节位置加各 1 维夹爪位置。（第 III-C 节；附录 F）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1441" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_4" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1638.0" as="sourcePoint"/><mxPoint x="1942" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_5" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;筛掉缺图像、非末端增量控制、低分辨率、重复或过于狭窄的数据；按多样性调整数据集抽样权重，缺失相机通道用零填充，统一夹爪开闭表示。用未来帧重标记目标图像，随机丢弃语言/目标条件；第三视角随机裁切、缩放到 256×256 并做颜色扰动，腕部相机不做随机裁切、缩放到 128×128。（第 III-B、III-D 节，附录 C–D）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1863" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_5" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2077.5" as="sourcePoint"/><mxPoint x="1942" y="2077.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_6" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;多数据集模仿学习预训练，连续动作使用 DDPM 去噪目标。Octo-Base 为 93M 参数，论文报告 TPU v4-128、300k 步、批量 2048、约 14 小时；下游约 100 条示范、微调 50k 步，单张 A5000 约 5 小时。论文方法是 Diffusion，不是 Flow Matching。（第 III-C、III-D 节）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2320" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_6" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2517.0" as="sourcePoint"/><mxPoint x="1942" y="2517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_3_field_7" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：从 Open X-Embodiment 的多数据集清理约 80 万条可用机器人轨迹，覆盖不同视觉、语言和动作格式&lt;br&gt;对任务指令与图像目标分别建模，使同一主干能接收不同任务定义&lt;br&gt;贡献 2：视觉历史、语言或目标图像经 token 化进入 Transformer，以分块注意力处理异构输入&lt;br&gt;读出 token 连接扩散动作头，生成连续未来动作段；这比硬编码统一动作维度更方便适配新本体&lt;br&gt;贡献 3：预训练 93M 参数基础模型，并给出新观察与新动作空间的微调流程&lt;br&gt;在 ALOHA 双臂平台把动作头适配到约 14 维关节控制，展示模型不局限于单臂末端位姿&lt;br&gt;方法流程：筛选跨机器人轨迹并统一观察与任务接口 → 训练视觉/语言 Transformer 与扩散动作头&lt;br&gt;部署时加入目标机器人相机和动作定义，用少量目标示范微调 → 分块预测并滚动执行动作" vertex="1">
          <mxGeometry height="779" width="628" x="1942" y="2742" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_3_branch_7" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3131.5" as="sourcePoint"/><mxPoint x="1942" y="3131.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_4_field_1" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;从 Open X-Embodiment 约 150 万条机器人 episode 中挑选 25 个数据集、约 80 万条轨迹。原始数据汇集不同机构的真实机器人示范，包含语言标注或目标图像；例如双臂下游实验使用单独采集的 ALOHA 示范。论文没有把全部 80 万条都描述成统一采集方式。（第 III-B 节，附录 C、F）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_4_branch_1" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_4_field_2" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;9 个真实机器人设置、4 家机构：零样本任务覆盖 WidowX、UR5、RT-1 Robot；6 个新域微调任务包括精密插入、咖啡胶囊、烘焙、拾取、可乐罐与双臂取笔帽。指标为任务成功率；零样本对照 RT-1-X、RT-2-X，微调对照从头训练的 ResNet+Transformer Diffusion Policy 和 VC-1 视觉预训练。（第 IV 节，图 4–5、表 I）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_4_branch_2" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="811.5" as="sourcePoint"/><mxPoint x="2632" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_4_field_3" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;WidowX、UR5、Google Robot 等执行零样本桌面操作；各选两项语言任务，每项 10 次。6 个微调域各约 100 条示范、每域 20 次评测。双臂任务在两台 ViperX 组成的 ALOHA 上，以左右腕部相机观察、关节位置与夹爪为动作，取下笔帽，测试 10 次；训练预测 64 步动作，执行 12 步后重规划。实验设置不同，控制频率不能归成一个统一值；附录给出 CMU Baking 15 Hz、Peg Insertion 策略 5 Hz 等具体例子。（第 IV 节，附录 F）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_4_branch_3" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1303.5" as="sourcePoint"/><mxPoint x="2632" y="1303.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_4_field_4" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;零样本语言任务：WidowX、UR5、RT-1 Robot 成功率分别为 50%、70%、80%，对应 RT-1-X 为 20%、35%、60%（图 5；项目页结果表）。六项微调任务 Octo 平均 72%，从头训练 20%，VC-1 15%；Berkeley Bimanual 80%（10 次中的 8 次），Stanford Coffee 75%，Berkeley Insertion 70%（表 I）。上述零样本测试选自预训练数据分布，不能等同未知技能泛化" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_4_branch_4" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1813.0" as="sourcePoint"/><mxPoint x="2632" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_4_field_5" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;WidowX 四项任务平均成功率：完整 Octo-Small 83%；RT-X 较窄数据混合 60%，只用 Bridge 43%；离散动作头 18%，MSE 连续动作头 35%，ResNet-50+Transformer 70%（表 II／附录表 VI）。附录 E 还发现动作分块、两帧历史和较小视觉 Patch 有益；简单增加历史长度未进一步获益" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_4_branch_5" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2287.5" as="sourcePoint"/><mxPoint x="2632" y="2287.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_4_field_6" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;零样本新技能最困难：在 WidowX 上，新场景平均 40%，翻杯子与插槽等新技能平均仅 5%，其中插槽任务为 0%（附录表 VII）。MSE 动作头容易缓慢犹豫，离散动作头常抓取位置不准；腕部相机加入后有时反而降低微调效果。（附录 E；第 IV 节结论）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="2530" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_4_branch_6" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2727.0" as="sourcePoint"/><mxPoint x="2632" y="2727.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_5_field_1" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者指出仅 27% 预训练数据含腕部相机、56% 含语言标注，导致腕部信息利用和语言条件表现不足；训练主要来自最优示范，尚未利用次优/在线交互数据。新技能和新场景表现下降，移动操作未覆盖。（第 IV 节结论、附录表 VII）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：Octo 已在 ALOHA 双臂普通夹爪取笔帽实验中达到 80%（表 I），可作为双臂少样本微调基线。对复杂双臂任务，可进一步检验双腕相机、关节动作表示和失败后重规划；这些扩展是基于论文局限的研究设想，不能当作已验证结果" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_5_branch_1" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_73_5_field_2" parent="paper_73" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：训练数据中腕部相机覆盖约 27%，语言标注约 56%，未见技能的直接迁移仍较弱&lt;br&gt;机器人数据及任务分布偏向已有平台和操作，模型不能凭预训练自动掌握任意新技能&lt;br&gt;我的理解 / 不足：ALOHA 双臂结果证明接口可适配，却只是一类任务和少量试验；没有灵巧手触觉、双臂冲突调度或失败恢复模块&lt;br&gt;模型开源降低复现门槛，但迁移到新本体仍需相机、动作定义和目标示范校准&lt;br&gt;未来展望：增加语言与腕部相机标注质量，扩展失败轨迹及安全停机样本&lt;br&gt;应在相同新硬件上控制微调示范预算，比较只换动作头与全模型微调的收益和代价&lt;br&gt;对我们项目的启发：Octo 可作为开放基线，先在现有双臂数据上适配输入和动作头，与从头训练比较&lt;br&gt;DH116 需额外处理手指关节、触觉和接触安全；论文没有验证直接移植到该灵巧手的成功率" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_73_5_branch_2" edge="1" parent="paper_73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1179.0" as="sourcePoint"/><mxPoint x="3322" y="1179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
