        <mxCell id="paper_48_3_header" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="C. 核心贡献与方法" vertex="1">
          <mxGeometry height="78" width="650" x="1920" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_3_field_rail" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="108" as="sourcePoint"/><mxPoint x="1930" y="1621" as="targetPoint"/></mxGeometry>
        </mxCell>
