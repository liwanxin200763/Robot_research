        <UserObject id="paper_104_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_104_bottomnav_1" label="返回分类" link="data:page/id,literature-page-05" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_104_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-103" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_104_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-105" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_104_1_field_1" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / CoRL&lt;br&gt;引用量：273（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作&lt;br&gt;数据链条位置：多样双臂数据与灵巧任务训练配方" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_1_branch_1" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_1_field_2" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败&lt;br&gt;&lt;br&gt;复杂双臂技能是否必须另造算法：系鞋带和挂衣服涉及柔性物体、多次接触和长动作链，少量规范示范很难覆盖皱褶与不同起始状态。ALOHA Unleashed 研究大规模多样示范加表达能力更强的策略，能否把模仿学习推进到这些任务；它的关键是采集与训练配方，不能只理解为换了一个网络名" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_1_branch_2" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="850.0" as="sourcePoint"/><mxPoint x="562" y="850.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_2_field_1" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;从 ALOHA 和 ACT 继续推进：ALOHA 证明低成本主从硬件和动作块能学习若干精细双臂任务；复杂柔性物体还存在多种有效解法。扩散策略通过逐步去噪生成动作序列，比单一确定动作更容易表达这些分支。本文同时扩展数据规模和模型能力，因此要用数据量、过滤和模型消融判断各因素的作用" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_2_branch_1" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_2_field_2" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_2_branch_2" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_2_field_3" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;动作分布多峰是指两种不同动作都可能成功，例如先扶衣领或先拉袖子；把两者简单平均可能什么也抓不到。扩散策略可以生成其中一条连贯路径，但是否选择了正确分支，仍取决于数据有没有覆盖当前初态。表达能力解决能否表示，数据覆盖解决能否学到，两者不能互相替代" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_2_branch_3" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1377.0" as="sourcePoint"/><mxPoint x="1252" y="1377.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_3_field_1" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;大规模示范怎样进入策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;大规模示范怎样进入策略：在 ALOHA 2 上采集多种初始摆放、任务进展和纠正过程，记录相机图像与两臂状态和动作；用 Transformer 编码观察，并以扩散损失训练动作块。训练目标让模型从带噪动作恢复出与当前观察相符的整段动作，执行时再观察并更新，避免只能重复单条固定轨迹&lt;br&gt;&lt;br&gt;数量、覆盖与筛选的配合：为衣服和鞋带分别保留较规范与凌乱的起始条件，检验模型是否只是适应整齐场景。还按示范时长过滤数据，研究减少无效停顿与保留困难恢复之间的取舍。最短轨迹未必最好，因为长轨迹可能包含关键纠正，数据质量不能只由速度判定" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_3_branch_1" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_3_field_2" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：这篇工作的训练不是把一段成功视频当整任务标签，而是逐时刻对齐多相机观察、机器人状态和后续动作块。多步骤任务中的失败纠正也进入数据覆盖，让策略在动作偏离后有机会接续；若在清洗时只保留最短、最规整示范，反而可能丢掉这些恢复状态&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_3_branch_2" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1126.5" as="sourcePoint"/><mxPoint x="1942" y="1126.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_4_field_1" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;五项真机与三项仿真&lt;/b&gt;&lt;br&gt;&lt;br&gt;CoRL 2024 原文真实任务为挂衣、系鞋带、换机器人手指、装齿轮、随机厨房堆放；每任务单独训练。挂衣 8658 条示范，鞋带 5133 条，换指 5247 条，齿轮 4005 条，厨房 3198 条；部分任务使用域外数据，不能全部称目标场景现场示范" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_4_branch_1" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_4_field_2" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;表 1 与表 2 的结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;挂衣 Easy／Messy 成功率 75%／70%，鞋带 70%／40%；齿轮完整三阶段 40%，厨房完整三物体 25%，不能把早期子阶段 95%当最终成功率。挂衣只留 50%数据时 Easy 85%但 Messy 20%，只留25%时为30%／0%；说明简单条件对数据数量不敏感，不等于困难条件也已覆盖。时长过滤也非越短越好" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_4_branch_2" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_4_field_3" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：ShirtEasy 与 ShirtMessy 共用同一个模型，区别是初态和皱褶等变化；鞋带也用类似划分。这样可以看到同一策略在较窄和较宽分布中的落差。数据量降到一半时规范条件偶尔更好，但凌乱条件大幅下降，因此单一简单测试会错误地支持少采数据的结论&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_4_branch_3" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1338.5" as="sourcePoint"/><mxPoint x="2632" y="1338.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_5_field_1" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究启发与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究启发与成本：效果依赖大量人工示范、任务专用模型和硬件设置，不能把成功视频理解为低成本通用技能。若做双臂或灵巧手数据研究，可先固定模型，按起始条件、失败恢复和动作策略分层采集，再做等数量子集对照；单独测难初态和完整任务成功，避免只报容易子步骤&lt;br&gt;&lt;br&gt;把关键设计与实验读透：对自己的数据集，可为每个任务预先定义正常初态、困难初态和偏离后的恢复状态，并分开统计采集覆盖。若研究自动筛选，至少保留随机等量子集和按时长筛选两个对照，再评估完整任务与困难初态。否则删掉长轨迹后训练更快，也未必说明策略更可靠" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_5_branch_1" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_104_5_field_2" parent="paper_104" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_104_5_branch_2" edge="1" parent="paper_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="969.0" as="sourcePoint"/><mxPoint x="3322" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-105" name="05-11 RDT-1B">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_105_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
