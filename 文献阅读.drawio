        <mxCell id="paper_60_1_field_2" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_1_branch_2" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_1_field_3" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 A (CCF 7th edition; venue category not independently extracted from official PDF) 方向，主要讨论开放环境操作需要预见动作后果并适应新场景。&lt;br&gt;核心思路是VideoVLA 将视频生成模型用于 VLA，利用想象的未来画面帮助动作选择。&lt;br&gt;与当前项目的联系：项目联系：可用于双臂动作前预期与动作后验证" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_1_branch_3" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_1_field_4" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：开放环境操作需要预见动作后果并适应新场景&lt;br&gt;&lt;br&gt;为什么重要：把世界模型式视觉预期与机器人动作生成连接起来" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_1_branch_4" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_1_field_5" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：视频世界模型与视觉—语言—动作策略；世界模型在这里指预测执行动作后可能出现的画面&lt;br&gt;七维动作包含腕部旋转、平移和夹爪开合；模型用当前图像和语言同时生成动作段与未来视频&lt;br&gt;核心研究问题：普通 VLA 从当前观察直接预测动作，可能缺少对动作后物体变化的显式约束&lt;br&gt;作者问预训练视频生成模型能否把未来视觉变化的知识带到控制中，并迁移到本体未示范过的技能或新物体&lt;br&gt;之前方法的问题：以视觉理解模型为骨干的 VLA 不直接学习动作与未来画面的对应；模块化视频规划还需逆动力学等另一个动作器&lt;br&gt;生成视频看起来合理，也未必意味着机械臂能准确执行，因此两类输出必须一起检验" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_1_branch_5" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2193.0" as="sourcePoint"/><mxPoint x="562" y="2193.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_2_field_1" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读&lt;br&gt;&lt;br&gt;之前方法的问题：只从当前视觉预测动作，可能缺少对未来状态的理解" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_2_branch_1" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_2_field_2" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_2_branch_2" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="857.0" as="sourcePoint"/><mxPoint x="1252" y="857.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_2_field_3" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：OpenVLA、π0、CogACT 等从图像和指令学可执行动作，依赖大规模机器人数据及预训练理解模型&lt;br&gt;VideoVLA 改用预训练视频生成器提供未来运动先验，再加入动作输出，不把这些基线当作自身的视频模块&lt;br&gt;相关方向 2：已有视频辅助控制先生成未来画面，再用逆动力学、光流或目标帧转换为动作&lt;br&gt;本篇把视频 latent 和动作向量放进同一 DiT 同步去噪，使两者每步交换信息，并省去串联的专属逆动力学器&lt;br&gt;代表工作：CogVideoX-5B 是本文直接初始化的预训练骨干；OXE 提供跨 22 种本体的数据子集&lt;br&gt;SIMPLER 用于 Google 与 WidowX 仿真评测；OpenVLA、SpatialVLA、π0、CogACT 则是真机与仿真对照&lt;br&gt;与已有方法的区别：除整任务成功率，还比对生成视频中的机器人运动与实际执行轨迹&lt;br&gt;作者用前景关键点跟踪和匹配计算运动相似度，图 3 显示相关性；这不是部署时已验证的自动失败检测器" vertex="1">
          <mxGeometry height="779" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_2_branch_3" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1464.5" as="sourcePoint"/><mxPoint x="1252" y="1464.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_3_field_1" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;VideoVLA 将视频生成模型用于 VLA，利用想象的未来画面帮助动作选择" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_3_branch_1" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_3_field_2" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：单靠当前画面难给动作加入未来结果约束，作者用 CogVideoX 的因果视频 VAE 编码当前帧和未来帧&lt;br&gt;把 T5 指令 token、当前帧 latent、带噪未来 latent 与带噪七维动作合入一个 DiT，联合预测可执行动作和视觉后果&lt;br&gt;贡献 2：为让视频预训练知识帮助控制，同一扩散时间步给未来视频与动作加噪，并用两种去噪损失同时训练&lt;br&gt;仿真消融中联合预测平均 80.4%，去掉视频损失仅 27.0%，只预测动作 25.5%；支持双输出训练的重要性&lt;br&gt;贡献 3：输出为动作段而非单步动作，默认预测六步、执行前三步后重新观察；真机只生成 13 帧以减轻延迟&lt;br&gt;未来视频解码器主要用于可视化分析，实际控制直接取动作输出；因此不是先把视频逐帧转成电机指令&lt;br&gt;方法流程：语言指令经 T5 编码、当前 RGB 经因果视频 VAE 得到首帧 latent → 与带噪未来帧和动作送入 DiT 联合去噪&lt;br&gt;取七维动作段前三步驱动机器人 → 获取新图像再次生成；需要检查预测时才把未来 latent 解码成视频" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_3_branch_2" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="972.5" as="sourcePoint"/><mxPoint x="1942" y="972.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_3_field_3" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1425" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_3_branch_3" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1639.5" as="sourcePoint"/><mxPoint x="1942" y="1639.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_4_field_1" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：作者报告想象未来质量与动作可靠性、任务成功相关；具体数字见实验章节&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者报告想象未来质量与动作可靠性、任务成功相关；具体数字见实验章节" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_4_branch_1" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_4_field_2" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：用 OXE 的 2250 万帧预训练，另收 Realman 单臂遥操作 5824 条样本微调；SIMPLER 测 Google 与 WidowX&lt;br&gt;真机 Realman 测已有抓放、新物体抓放与跨本体技能；附录列出每新物体 12 次、每新技能 16 次试验&lt;br&gt;对照：仿真与真机比较 OpenVLA、SpatialVLA、π0、CogACT；新技能是 WidowX 数据出现过、目标机器人未示范过的技能&lt;br&gt;还消融预训练骨干、未来帧数、视频损失及双向注意力，分别检验预训练和联合预测的作用&lt;br&gt;结果：SIMPLER 已见任务总体平均 63.0%，新物体 65.2%，跨 Google/WidowX 技能 48.6%，均为表内对应设置&lt;br&gt;Realman 真机已见任务平均 64.6%，12 种新物体平均 50.6% 对 CogACT 的 26.9%；不是零样本换硬件&lt;br&gt;真机 / 关键补充：Realman 执行从 WidowX 学来的六项技能平均 58.0%，CogACT 为 35.1%，但物体仍属 Realman 训练所见&lt;br&gt;SIMPLER 新物体的人工评估中视觉想象成功率 84.0%，实际执行 65.2%；附录报告 H100 推理约 1.1 秒、有效控制约 3 Hz" vertex="1">
          <mxGeometry height="919" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_4_branch_2" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1021.5" as="sourcePoint"/><mxPoint x="2632" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_5_field_1" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可用于双臂动作前预期与动作后验证&lt;br&gt;&lt;br&gt;主要局限：视频看起来合理不一定代表接触力与夹爪动作正确&lt;br&gt;&lt;br&gt;局限与启发：主要局限：视频看起来合理不一定代表接触力与夹爪动作正确" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_5_branch_1" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_60_5_field_2" parent="paper_60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：CogVideoX-5B 的扩散采样造成真机推理约 1.1 秒，控制频率约 3 Hz&lt;br&gt;作者建议更小的机器人视频生成器、少步去噪或蒸馏；高速接触操作尚缺实时性验证&lt;br&gt;我的理解 / 不足：视觉想象成功率高于动作真实成功率，说明合理视频仍可能因感知、动力学或执行误差而失败&lt;br&gt;图 3 的相似度分析是离线相关性，论文没有把相似度阈值接入在线纠错或安全停机&lt;br&gt;未来展望：在线比较想象与新观察的关键点运动，测试能否及早识别偏差，再决定缩短动作段或重规划&lt;br&gt;还应分别测视觉模型误差和夹爪接触误差；这些是后续研究设想，原文未给出恢复成功率&lt;br&gt;对我们项目的启发：双臂可先评估预测画面与实际接触后画面的偏差是否能提示任务失败&lt;br&gt;若用于 DH116，要重做七维夹爪动作到多指关节的表示与触觉校验，并量化 3 Hz 控制是否足够精细操作" vertex="1">
          <mxGeometry height="779" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_60_5_branch_2" edge="1" parent="paper_60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1056.5" as="sourcePoint"/><mxPoint x="3322" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
