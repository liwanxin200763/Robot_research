          </mxCell>
        </UserObject><mxCell id="paper_116_1_field_1" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：CoT-VLA: Visual Chain-of-Thought Reasoning for Vision-Language-Action Models。第一作者Qingqing Zhao，作者与机构见元数据；首页机构为NVIDIA、Stanford University、MIT。本地12页PDF是CVF开放获取的CVPR接受版，标题与canonical卡匹配；最后若干导师作者顺序以该会议PDF为准，官方arXiv页面的末位排序略有不同。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_1_branch_1" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="372.0" as="sourcePoint"/><mxPoint x="562" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_1_field_2" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;年份 / Venue与首次公开&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：CVPR 2025。首次公开：官方https://arxiv.org/abs/2503.22020载明v1为2025年3月27日，页面仅列该版本，没有另一个更新日期，不能把会议出版月份补作更新。项目视频见https://cot-vla.github.io/。研究定位为能同时理解、生成图像与动作token的7B VLA，关键中间表示是未来子目标图像。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_1_branch_2" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="846.5" as="sourcePoint"/><mxPoint x="562" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_1_field_3" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、具体问题与目标能力&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前观察直接映射动作的VLA缺少显式中间状态，遇到较长任务时难检查模型计划，也难利用没有动作标签的视频。本文希望先生成可视化未来子目标，再将它与当前图像共同用于短动作序列预测，在统一7B模型内连接视觉推理和执行，并检验这种中间表示能否改善单臂仿真与真实机器人泛化。canonical卡引用量未核验统计日期及实时数量。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_1_branch_3" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1321.0" as="sourcePoint"/><mxPoint x="562" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_2_field_1" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与前人机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;直接VLA把当前图像和指令映射成动作，缺少可观察的中间目标；语言推理、关键点或边界框可以增加中间步骤，但通常需要额外标注流水线。目标条件模仿学习则让策略接收希望到达的状态，SUSIE等先生成未来图像再用另一策略控制。CoT-VLA把这两件事整合进同一生成式多模态模型，用示范视频本来就存在的未来帧做视觉思维链监督。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_2_branch_1" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_2_field_2" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉CoT在本文不是多轮自然语言解释，而是先生成若干步后的子目标图像，再预测实现它的短动作序列。无动作视频只有描述和帧序列，可以训练“现在→未来”视觉变化，却不能直接训练机器人控制量。Action chunking一次预测多步减少调用次数；混合注意力让视觉/文字采用因果生成、动作块内部使用全注意力，两者分别服务自回归图像合成和各动作维度/时间步的一致性。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_2_branch_2" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_3_field_1" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入与视觉目标生成&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入为任务指令l及当前256×256 RGB图像st。模型先采样n帧之后的图像ŝt+n，表达预计中间状态，再以l、st、ŝt+n为条件产生动作块。训练时机器人数据含语言、观察、动作，无动作视频含语言、观察；未来跨度n从各数据集指定上下界均匀采样，而非所有数据用统一物理时间。图像目标把位置、物体及接触状态保留在像素空间，便于阅读推理结果，但图像可解释不等于物理正确。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_3_branch_1" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_3_field_2" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;VILA-U与视觉token&lt;/b&gt;&lt;br&gt;&lt;br&gt;基座为7B VILA-U，它具备统一的图像/视频理解与生成能力。固定视觉塔将图像编码成离散视觉特征，残差量化深度为4，对应16×16空间位置；投影器把特征送给LLM，depth transformer在各位置逐层预测残差token。目标图像按因果注意力生成：LLM给出空间位置的代码嵌入，depth transformer再恢复该位置的多层量化码。因此论文说先生成256个图像位置，不应把16×16×4简单误写成1024个独立外层时序生成步骤。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_3_branch_2" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_3_field_3" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;动作表示与混合注意力&lt;/b&gt;&lt;br&gt;&lt;br&gt;每步动作7维，每维在训练分布第1–99百分位范围内均匀量化为256档，复用文本词表中256个低频token。使用[x]、[θ]、[g]等查询token，并以全注意力使动作token互相通信，预测长度10的动作块；它不是扩散或流匹配动作头。相对于普通单动作VLA，动作块减少反复生成视觉目标的开销，全注意力改善动作间关系；代价是执行块内部没有逐步视觉纠正。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_3_branch_3" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1391.0" as="sourcePoint"/><mxPoint x="1942" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_3_field_4" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练损失与阶段&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉损失是所有目标位置及残差深度token的交叉熵；动作损失是条件动作预测交叉熵，总损失为两者相加。无动作视频只贡献视觉损失。预训练将筛选的Open X-Embodiment单臂第三人称数据与EPIC-KITCHENS、Something-Something V2混合，更新LLM、投影器、depth transformer，视觉塔冻结。下游再用目标设备示范适配同一组模块。这样无动作人类视频可以改善未来图像生成，而机器人示范负责把目标接到本体动作空间。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_3_branch_4" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1900.5" as="sourcePoint"/><mxPoint x="1942" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_3_field_5" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;执行闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;算法1循环为：获取观察→生成未来目标→生成短动作块→依次执行该块→重新取真实观察。新一轮视觉目标总是根据最新观察产生，而不是执行整段开环视频。论文未引入单独的视觉验证器、失败回报优化或在线参数更新；反馈作用于下一次输入和子目标生成。Bridge还在预训练之后单独微调直到训练动作预测准确率95%，这一训练门槛不能误写成95%真机任务成功率。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_3_branch_5" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2410.0" as="sourcePoint"/><mxPoint x="1942" y="2410.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_4_field_1" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真设置与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO Spatial、Object、Goal、Long四套各10任务，每任务50条人类遥操作示范。预处理去暂停、统一256×256并旋转180°；每套500个episode、3随机种子，报告均值和标准误。表1平均81.13±0.6%，对比OpenVLA微调76.5±0.6%、Octo75.1±0.6%、Diffusion Policy72.4±0.7%。Long为69.0±0.8%，OpenVLA53.7±1.3%；Object为91.6±0.5%，略低于Diffusion Policy92.5±0.7%，并非所有套件都第一。摘要约6%优势是相对量级，平均绝对差为4.63个百分点。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_4_branch_1" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_4_field_2" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机硬件与数据条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bridge使用6DoF WidowX，训练有约4.5万条语言标注示范；Franka-Tabletop用7DoF Franka Panda，属于预训练未见设备，下游6任务每项10–150条示范，并分任务训练模型。六项包含单指令和多指令场景。真实机器人证据是单臂，未测试双臂；本次所读主论文未统一报告控制频率、触觉或点云输入，也没有真机在线强化学习。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_4_branch_2" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="916.5" as="sourcePoint"/><mxPoint x="2632" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_4_field_3" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Bridge结果及对比边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;四类Bridge测试每类10次，并采用部分得分。CoT-VLA视觉、位置运动、语义、语言四类为65%、60%、50%、70%；OpenVLA为75%、45%、40%、75%。因此它在运动/语义提高，在视觉与语言类略降，作者观察后者与动作块中抓取反馈不足有关。Franka图4/正文平均为78.8%，去预训练版本53.7%，相对提高46.7%，绝对提高25.1个百分点。不能把跨设定的相对提升17%误写为所有真机任务统一增加17个百分点。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_4_branch_3" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1408.5" as="sourcePoint"/><mxPoint x="2632" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_4_field_4" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与视觉瓶颈诊断&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融依次加入动作块、全注意力、视觉CoT，两个LIBERO套件表现逐步提高，说明联合设计有贡献，不能只把完整模型与最弱基线的总差归给CoT。另在两项新组合任务各做5次试验，用真实目标图像替换生成目标后，成功率由20%/0%提高到60%/40%，每项增加40个百分点。这是小样本机制诊断，表明视觉目标质量限制控制，不是大规模OOD泛化结论。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_4_branch_4" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1918.0" as="sourcePoint"/><mxPoint x="2632" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_4_field_5" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;推理成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确先生成256个图像token位置，动作块长10时平均比直接动作生成慢约7倍；动作块和并行解码只能部分抵消开销。主论文未给绝对毫秒延迟、完整GPU配置与训练总GPU时，因此此处不把canonical卡引用的补充材料数字冒充本地PDF已核验结果。生成图像质量还低于强扩散图像模型，视觉CoT虽能解释意图，错误目标也会把低层控制引向错误位置。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2178" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_4_branch_5" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2410.0" as="sourcePoint"/><mxPoint x="2632" y="2410.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_5_field_1" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;自回归图像生成是主要计算瓶颈；当前目标图像质量与全新任务泛化有限。动作块内部缺少高频反馈，块边界可能不连续，易造成精细抓取失败。作者提出快图像生成、快LLM推理、时序平滑和按步预测等后续方向，并未报告这些改进已经实现。无动作视频增广不能自动保证人类视频动作因果关系与机器人本体兼容。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_5_branch_1" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_116_5_field_2" parent="paper_116" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：成功依赖“目标可生成”和“目标可达”两个条件，仅改进图像清晰度未必提升真实控制；子目标可能看似合理却违反遮挡、抓取或运动约束。研究启发：可分别测视觉目标对象/空间正确率、给定真实目标的控制上限、端到端成功及决策耗时；增加动作块长度与反馈频率的联合曲线。若迁移双臂，应检验同一目标图像能否表达双臂接触和协调信息，不能从单臂结果直接声称有效。这些为后续建议，未在本机测试。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_116_5_branch_2" edge="1" parent="paper_116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
