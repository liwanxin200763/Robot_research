        <mxCell id="paper_37_1_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="核心研究问题：只在实验室同一张桌子采数据，模型可能记住背景而不是任务。怎样在大量真实房间持续采集可校准、可复用的机器人操作数据？" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_1_branch_4" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="940" as="sourcePoint"/>
            <mxPoint x="367" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_1_field_4" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：多地点采集既要搬动硬件，又要统一相机、动作、任务说明和质量检查。少量固定任务的数据，难以支持换背景、换布局后仍稳定行动" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_drop" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="956" y="14" as="sourcePoint"/>
            <mxPoint x="956" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_header" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="B. 相关工作" vertex="1">
          <mxGeometry height="58" width="390" x="761" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_field_rail" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="88" as="sourcePoint"/>
            <mxPoint x="771" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_branch_1" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="220" as="sourcePoint"/>
            <mxPoint x="783" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_1" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 1：单实验室数据可以训练固定技能，但物体和环境变化少；跨机构的数据集合又常有相机与动作格式不一致的问题，需要统一处理" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_branch_2" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="460" as="sourcePoint"/>
            <mxPoint x="783" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 2：Co-training（联合训练：把大数据集与目标任务数据一起训练）利用通用经验；Fine-tuning（微调：用目标任务数据继续训练已有模型）适配新现场" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_branch_3" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="700" as="sourcePoint"/>
            <mxPoint x="783" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_3" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="代表工作：Open X-Embodiment（机器人本体，机械结构、传感器和动作空间的组合） 汇集多种机器人数据；DROID 以统一 Franka 采集平台扩展场景多样性。Embodiment（本体）指机器人的结构、传感器和动作接口" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_2_branch_4" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="940" as="sourcePoint"/>
            <mxPoint x="783" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_37_2_field_4" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="与已有方法的区别：重点把一个平台搬进很多真实环境，保留三路同步图像、深度、标定和任务文字。它增加“在哪里做”的多样性，并不覆盖所有机械手本体" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_37_3_drop" edge="1" parent="paper_37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1372" y="14" as="sourcePoint"/>
            <mxPoint x="1372" y="30" as="targetPoint"/>
          </mxGeometry>
