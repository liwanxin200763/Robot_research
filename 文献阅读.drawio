          </mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_2" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 2：平移转为方向和距离，旋转与夹爪分别编码，按统计分布分配动作网格。单步7维控制变为3类空间动作符号，再还原连续动作" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_3" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="700" as="sourcePoint"/>
            <mxPoint x="1199" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_3" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 3：用约110万条示范预训练；目标机器人微调时重新拟合动作分布并插值初始化嵌入。插值是在原动作表示间取邻近组合，不是无需目标数据" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_3_branch_4" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="940" as="sourcePoint"/>
            <mxPoint x="1199" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_53_3_field_4" parent="paper_53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="方法流程：图像 → 估计深度+三维位置编码 → 结合语言 → 预测自适应网格动作符号 → 还原连续动作段 → 执行并重观察；换平台用新示范适配网格" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_53_4_drop" edge="1" parent="paper_53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
