        <mxCell id="paper_37_1_field_2" parent="paper_37" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：真实机器人数据集与泛化 Generalization（在没见过的物体、场景上仍能做任务）。它研究数据的覆盖面和采集规范，而非提出新的记忆或恢复模块" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="350" as="geometry"/>
