            <mxPoint x="1603" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_branch_1" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="220" as="sourcePoint"/>
            <mxPoint x="1615" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_1" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="实验：在 Simpler 仿真、多种视觉配置与8项真机测试中验证。比较静态外观变化、动态操作及新任务，成功率按规定任务完成判断" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_2" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="460" as="sourcePoint"/>
            <mxPoint x="1615" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对照：比较不带轨迹的 OpenVLA、不同轨迹数量和历史长度，并检查轨迹丢弃训练。统一基线下检验“时间提示”是否有益" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_3" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="700" as="sourcePoint"/>
            <mxPoint x="1615" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_3" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：Google 机器人仿真开/关抽屉任务：41.1%→62.3%；拿可乐42.5%→54.6%。这些是对应任务完成率，不能推广为所有场景统一提升" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_4_branch_4" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="940" as="sourcePoint"/>
            <mxPoint x="1615" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_38_4_field_4" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：真机推动布料为10/10，对照3/10；电池放置9/10，对照4/10。样本较小，说明这组测试有改善，不保证动态目标一定可抓住" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_38_5_drop" edge="1" parent="paper_38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
