        <mxCell id="paper_119_title" parent="paper_119" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=16;editable=1;movable=1;resizable=1;shadow=0;" value="#119 SimpleVLA-RL" vertex="1">
