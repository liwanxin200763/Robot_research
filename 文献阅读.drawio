        <mxCell id="paper_110_rise" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_header_rail" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="3625" y="14" as="targetPoint"/></mxGeometry>
