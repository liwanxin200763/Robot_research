        </UserObject><UserObject id="paper_114_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-112" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_114_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-127" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_114_1_field_1" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待核验；来源为 Google Scholar，未经人工查看不填写数字（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量&lt;br&gt;数据链条位置：单视频到仿真示范再到真实机器人" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_1_branch_1" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_1_field_2" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;GitHub / 开源程度：见本卡“来源与核验边界”；未核实不视为代码已完整开放&lt;br&gt;版本查询与全文核验日期：2026-10-15&lt;br&gt;&lt;br&gt;研究方向与快速摘要：本篇尝试从一段人类示范建立仿真场景、修正动作、训练策略，再部署真实机械臂和灵巧手，主线是完整 Sim2Real（先在仿真生成／学习，再用真机检验）。它把视觉几何误差交给模仿学习、局部接触动力学误差交给手指残差强化学习处理（§3–4）" vertex="1">
          <mxGeometry height="744" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_1_branch_2" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_1_field_3" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;“单个视频”实际指 RGB-D 人类视频，还需要操作前的 RGB-D 参考场景、相机内参和相机／桌面／机器人外参。不是纯 RGB 网络视频，也不是省去机器人安装与标定。论文实验不需要真人遥操作的目标机器人示范（§3）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_1_branch_3" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1524.0" as="sourcePoint"/><mxPoint x="562" y="1524.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_2_field_1" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作：直接用人手轨迹作参考的 RL 可能被重建噪声带偏；只看物体任务目标的 RL 又在高维手动作中探索困难。本文折中：保留人手运动趋势，只在接触、交互、脱离等关键帧用物体几何重新求机器人配置，再插值成轨迹（§2、§4.2）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_2_branch_1" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_2_field_2" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;IL：模仿学习，从示范学习动作&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_2_branch_2" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="986.5" as="sourcePoint"/><mxPoint x="1252" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_2_field_3" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：数字孪生是物体和场景的可运行仿真副本。RoboTwin 2.0以任务程序生成专家数据；本文则从特定真实视频构建任务副本，不能把二者的数据来源和训练成本等同&lt;br&gt;&lt;br&gt;相关工作：纯 IL（模仿学习，用示范目标监督动作）通常要为大量随机场景生成成功轨迹，纯 RL（通过交互奖励学习）同时承担几何和物理变化时可能输出大幅不平滑动作。本文分配两者不同职责；FoundationPose 在真机表 2 中是感知对照，不是完整学习策略的同名替代品" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_2_branch_3" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1513.5" as="sourcePoint"/><mxPoint x="1252" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_3_field_1" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 重建可训练场景并提取两类先验&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 重建可训练场景并提取两类先验：Gemini 等模型识别任务和操作物，SAM3 分割、SAM3D 建网格，参考深度与标定把各物体放进桌面坐标并生成 URDF 资产；输出不仅是单个物体网格，还含操作物、目标物、语义和任务类型（§4.1、附录 A.1）&lt;br&gt;&lt;br&gt;1. 重建可训练场景并提取两类先验：HaMeR 恢复人手关键点，Mink 重定向为目标机器人关节；CoTracker 追踪物体二维点，再用深度抬升到三维。Object Flow（物体流）是物体表面点随时间的运动，可以表达“物体要怎样被移动”，不需要照搬每个手关节" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_3_branch_1" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="442.0" as="sourcePoint"/><mxPoint x="1942" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_3_field_2" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 物体关键帧纠正人手动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;从物体开始持续移动、物体与目标的相对运动变化、物体重新接近桌面，分别检测接触、交互、脱离帧。它们是启发式事件检测，非自动理解任意长程任务的通用规划器（§4.2）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_3_branch_2" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="962.0" as="sourcePoint"/><mxPoint x="1942" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_3_field_3" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 物体关键帧纠正人手动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;抓取接触帧用 Lightning Grasp 生成候选，再仿真筛选成功且物体追踪误差最小的抓法；推／拉任务则按物体流方向选表面接触点并调整指尖朝向。交互和放下帧用三维点对应求物体刚性变换，保留修正后的手物关系，构成目标手位姿。逆运动学求关节锚点，再结合原动作插值，避免每帧重度优化（图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_3_branch_3" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1394.5" as="sourcePoint"/><mxPoint x="1942" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_3_field_4" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 解耦感知适配与接触调整&lt;/b&gt;&lt;br&gt;&lt;br&gt;模仿学习支路：以带掩膜的 PointNet 风格网络读物体点云，预测相对物体中心的位置残差和旋转。仿真采物体局部位置／朝向变化，点坐标扰动及随机丢点，让网络学习从噪声和不完整点云恢复关键帧手位姿。部署时进入工作区前读取初始点云，仅查询一次这些位姿，避免把它说成持续逐帧视觉重规划（§4.3.1）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1637" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_3_branch_4" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1851.5" as="sourcePoint"/><mxPoint x="1942" y="1851.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_3_field_5" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 解耦感知适配与接触调整&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 解耦感知适配与接触调整：手指残差 RL 支路：PPO 读当前／下一参考关节和物体流的中心／运动，逐步输出手指关节修正，叠加到基础轨迹；随机化质量、摩擦、尺度、控制增益和观测／动作误差。它处理局部接触差异，不让大范围机械臂运动也由高维 RL 任意改变（§4.3.1）&lt;br&gt;&lt;br&gt;4. 空间泛化与控制输出：较大初始位置变化时，可选 CuRobo 依据数字孪生和优化轨迹生成避碰路线。局部策略适配、静态场景避碰规划和执行后失败恢复是三件事；本文未给掉落后重新抓取、任务回退再完成的通用恢复系统" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="2094" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_3_branch_5" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2378.5" as="sourcePoint"/><mxPoint x="1942" y="2378.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_3_field_6" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 空间泛化与控制输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGB-D 视频＋参考场景＋标定 → 数字孪生及人手／物体流 → 物体关键帧筛选和机器人姿态优化 → 插值基准轨迹 → 仿真 IL 点云适配＋PPO 手指残差 → 真机初始点云校准关键帧 → 逐步真实物体反馈和残差 → 机械臂／手关节控制" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2691" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_3_branch_6" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2888.0" as="sourcePoint"/><mxPoint x="1942" y="2888.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_4_field_1" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;平台与仿真对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;固定 RealSense D455、7 自由度 Kinova Gen 机械臂、16 自由度 LEAP Hand，仿真 Isaac Gym；七任务是苹果、桃子准备、调味、玩具整理、纸巾盒分享、书本传递、托盘取回。纸巾盒和书本名字不应被误写为双机械臂部署，正文硬件为单臂单手（§5.1、图 3）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_4_branch_1" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_4_field_2" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;平台与仿真对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 1 比较参考残差 RL、DeepMimic、预接触初始化、优化初始化、只看物体目标等路线，各 RL 条件三个种子；每任务十次，跨七任务统计。本文仿真成功率均值 91.4%，安全率 100%，机械臂 RMS jerk 为 3.7；安全与 jerk 的论文定义不是机器人系统安全认证，±22.7 是任务均值间标准差而非单一总体置信区间（§5.2）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_4_branch_2" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_4_field_3" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机迁移证据 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机迁移证据 / 表中逐项记录：方法：FoundationPose；苹果：0/10；桃子：0/10；调味：1/10；玩具：0/10；纸巾盒：0/10；书本：0/10；托盘：10/10；等权平均：15.7%&lt;br&gt;&lt;br&gt;真机迁移证据 / 表中逐项记录：方法：本文；苹果：10/10；桃子：9/10；调味：10/10；玩具：8/10；纸巾盒：10/10；书本：10/10；托盘：10/10；等权平均：95.7%&lt;br&gt;&lt;br&gt;真机迁移证据：表 2 在演示初始位姿附近引入变化，每任务十次真机试验，按任务终态判断；两组使用相同训练好的手指残差策略，因此主要检验关键帧感知／适配方法。增加 80 个百分点不代表从不使用学习到完整学习的所有模块综合增益，更不表示任意新物体都有 95.7%" vertex="1">
          <mxGeometry height="709" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_4_branch_3" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1373.5" as="sourcePoint"/><mxPoint x="2632" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_4_field_4" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融与成本：附录表 12 的桃子／玩具／纸巾盒：仅位姿蒸馏为 0/5、0/5、5/5；仅手指残差为 2/5、2/5、5/5；两者为 9/10、8/10、10/10。联合组复用主实验结果、试验分母不同，应分别写计数而非声称完全相同样本的严密配对消融；纸巾盒单模块也成功，说明必要性依任务而变&lt;br&gt;&lt;br&gt;消融与成本：表 13 给出 RL 在 A40 上的用时：玩具残差训练约 269 分钟，整管线约 6 小时 24 分；纸巾盒约 20 分钟。不同任务复杂度与接触难度会显著改变预算，不能用最快任务估计全部复现成本" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1756" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_4_branch_4" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2040.5" as="sourcePoint"/><mxPoint x="2632" y="2040.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_5_field_1" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确指出：只在稀疏关键帧纠正，手内旋转等连续接触任务可能不足；关键帧启发式可扩展性有限；重建只支持非关节物体。RGB-only、自动标定和触觉输入被列为未来方向，不能作为本版已具备能力（§6）&lt;br&gt;&lt;br&gt;不足与未来：我的理解：点云蒸馏主要对初始几何，逐步残差主要对手指，未形成完整机械臂视觉反应和长期记忆系统；七任务小样本成功率需要更多随机场景和安全停止记录。真实试验的有效性不等于跨 DH116 的直接可用性" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_5_branch_1" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_5_field_2" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116 与 D435i：最适合借鉴的是“初始点云修正手位姿＋限制幅度的手指残差”这两个独立模块。D435i 可作 RGB-D 数据源，但需检查深度精度、同步与外参；替换 LEAP 为 DH116 时要重新制作碰撞／关节／耦合模型、控制频率和驱动接口。先验证可达和离线抓姿，再决定 RL 预算" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_5_branch_2" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_114_5_field_3" parent="paper_114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;可复用与成本：初始点云位姿回归可用有限仿真数据做小实验；全栈数字孪生、姿态优化和接触 RL 需要复杂仿真和 GPU。作者公开仓库能读到策略和蒸馏相关目录，未安装验证整套依赖和训练复现，故记录为“实现已公开，完整端到端复现待验证”" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_114_5_branch_3" edge="1" parent="paper_114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1356.0" as="sourcePoint"/><mxPoint x="3322" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
