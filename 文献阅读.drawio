        </mxCell>
        <mxCell id="paper_39_authors" parent="paper_39" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者：Xiaofan Wang; Xingyu Gao; Jianlong Fu; Zuolei Li; Dean Fortier; Galen Mullins; Andrey Kolobov; Baining Guo" vertex="1">
