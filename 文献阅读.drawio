          </mxCell>
        </UserObject><UserObject id="paper_56_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-55" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_56_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-107" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
        </mxCell>
        </UserObject><mxCell id="paper_56_1_field_1" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / RSS&lt;br&gt;引用量：30（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_1_branch_1" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_1_field_2" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_1_branch_2" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_1_field_3" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Dataset / Benchmark / Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论真实机器人数据难以低成本扩展，限制通用家庭操作策略训练。&lt;br&gt;核心思路是RoboCasa 建立以厨房为中心的大规模仿真框架，结合生成式资产、语言模型辅助任务设计、人类示范和自动轨迹生成。&lt;br&gt;与当前项目的联系：项目联系：家庭操作仿真可借鉴，但与本项目场景、双臂配置和真实部署有差异" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_1_branch_3" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1223.0" as="sourcePoint"/><mxPoint x="562" y="1223.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_1_field_4" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：真实机器人数据难以低成本扩展，限制通用家庭操作策略训练&lt;br&gt;&lt;br&gt;为什么重要：可用于研究仿真数据扩增及与真实机器人数据联合训练" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1518" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_1_branch_4" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1715.0" as="sourcePoint"/><mxPoint x="562" y="1715.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_1_field_5" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：机器人训练数据与基准&lt;br&gt;RoboCasa 是基于 RoboSuite/MuJoCo 的厨房仿真、任务和示范集合，不是一种新的 VLA 动作解码器；Sim2Real 指仿真数据与真实机器人任务间的迁移，需要单独评测&lt;br&gt;核心研究问题：真实家庭操作数据昂贵，单一房间、少数物体和少量示范难训练通用策略&lt;br&gt;作者想知道能否在有物理交互的仿真里规模化生成厨房、任务和成功轨迹，并证明这些数据对策略训练有价值&lt;br&gt;之前方法的问题：一些模拟器有逼真画面却缺可交互物理对象，另一些有任务却缺房间尺度多样性和大量训练轨迹&lt;br&gt;只靠人遥操作采集更多样厨房示范仍耗时，合成轨迹若质量差又可能教会机器人碰撞或抖动" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1940" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_1_branch_5" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2259.5" as="sourcePoint"/><mxPoint x="562" y="2259.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_2_field_1" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;之前方法的问题：场景、任务和示范的规模不足；仅靠真机采集难以覆盖家庭环境多样性" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_2_branch_1" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_2_field_2" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_2_branch_2" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_2_field_3" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：RoboSuite 提供 MuJoCo 物理、机器人控制器与模块化场景，是 RoboCasa 的直接技术底座&lt;br&gt;RoboCasa 在其上扩展房间尺度厨房、移动操作平台、家电交互和多种视觉风格，而不是从零重写物理引擎&lt;br&gt;相关方向 2：MimicGen 从少量真人示范切出物体中心操作段，按新物体位置变换并拼接轨迹&lt;br&gt;RoboCasa 将它用于原子任务的自动扩增，并只保留执行成功的轨迹；这一机制需要已知子任务顺序和仿真状态&lt;br&gt;代表工作：AI2-THOR、Habitat、LIBERO 等在论文表 I 中作为模拟器比较对象，各自在场景、物理、任务或数据规模上有不同侧重&lt;br&gt;它们不是 RoboCasa 直接复用的全部模块，本文的实验核心是自身数据规模与迁移效用&lt;br&gt;与已有方法的区别：把可交互厨房、生成式纹理/物体、语言模型辅助任务设计和机器生成示范放进同一框架&lt;br&gt;语言模型给出活动与任务建议后仍需人编写和检查实现，不能把任务生成理解为完全自动写出可靠机器人程序" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_2_branch_3" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1496.0" as="sourcePoint"/><mxPoint x="1252" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_3_field_1" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa 建立以厨房为中心的大规模仿真框架，结合生成式资产、语言模型辅助任务设计、人类示范和自动轨迹生成" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_3_branch_1" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_3_field_2" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：有限场景会让策略记住固定背景，作者组合 10 种厨房平面和 12 种风格得到 120 个场景&lt;br&gt;再加入 2500 多个物体与可开合家电，利用生成式纹理和物体资产扩展视觉变化，让训练与测试能覆盖更多布置&lt;br&gt;贡献 2：仅有场景还无法系统比较学习方法，作者设计 25 个抓放、开门等原子任务，并借语言模型建议形成 75 个多技能复合任务&lt;br&gt;每个复合任务仍由人实现和审核，因而可测长程能力，同时保留实际任务判据&lt;br&gt;贡献 3：每个原子任务先采 50 条人遥操作示范，再用 MimicGen 把物体中心轨迹适配到新场景、并行验证&lt;br&gt;扩成 10 万条以上合成轨迹，使模仿学习能比较 100、300、3000 条每任务等数据预算及其效果&lt;br&gt;方法流程：设计厨房和可交互资产 → 人工/语言模型提出任务并实现判据 → 遥操作采种子轨迹&lt;br&gt;按物体位姿变换并拼接动作段 → 仿真执行与拒绝失败轨迹 → 训练行为克隆策略 → 在新场景与少量真机任务评测" vertex="1">
          <mxGeometry height="814" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_3_branch_2" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="955.0" as="sourcePoint"/><mxPoint x="1942" y="955.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_3_field_3" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1390" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_3_branch_3" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1604.5" as="sourcePoint"/><mxPoint x="1942" y="1604.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_4_field_1" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：RSS 2024 原版 RoboCasa：100 项任务、超过 150 个物体类别及大量 3D 资产；不要与后续 RoboCasa365 的规模混同&lt;br&gt;&lt;br&gt;主要结果：RSS 官方摘要报告，合成数据用于大规模模仿学习呈现规模效应；本轮不转述未经表格核验的成功率&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：RSS 2024 原版 RoboCasa：100 项任务、超过 150 个物体类别及大量 3D 资产；不要与后续 RoboCasa365 的规模混同" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_4_branch_1" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_4_field_2" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：RSS 官方摘要报告，合成数据用于大规模模仿学习呈现规模效应；本轮不转述未经表格核验的成功率" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_4_branch_2" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="927.0" as="sourcePoint"/><mxPoint x="2632" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_4_field_3" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：仿真主试验用移动底座上的 Franka Panda，评测 24 个可生成轨迹的原子任务，测试未见物体实例与部分未见厨房风格&lt;br&gt;另外测试 5 个复合任务；真机在厨房用 Franka 完成台面到水槽、反向及放入柜子三类抓放&lt;br&gt;对照：原子任务比较每任务 50 条人示范与 100、300、3000 条合成示范，均用相同多任务行为克隆模型&lt;br&gt;真机每任务有 50 条真实示范，比较只用真实数据和真实＋RoboCasa 仿真数据共同训练，指标为整任务成功率&lt;br&gt;结果：24 个原子任务中，人示范训练总体成功率 28.8%，完整合成数据为 47.6%，增加合成轨迹时呈上升趋势&lt;br&gt;这说明在相应仿真分布中数据量有益，不代表合成数据单独已实现真机零样本迁移&lt;br&gt;真机 / 关键补充：三任务已见物体平均成功率从真实数据单训 13.6% 到真仿混训 24.4%；未见物体从 2.6% 到 9.3%&lt;br&gt;五个复合任务微调后最高仅 12%，作者指出精细操作和阶段切换仍难，不能只报较高的原子任务结果" vertex="1">
          <mxGeometry height="849" width="628" x="2632" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_4_branch_3" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1569.5" as="sourcePoint"/><mxPoint x="2632" y="1569.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_5_field_1" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：家庭操作仿真可借鉴，但与本项目场景、双臂配置和真实部署有差异&lt;br&gt;&lt;br&gt;主要局限：摘要不能保证仿真训练所得提升直接迁移至本项目真机&lt;br&gt;&lt;br&gt;局限与启发：主要局限：摘要不能保证仿真训练所得提升直接迁移至本项目真机" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_5_branch_1" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_56_5_field_2" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：合成成功轨迹仍可能有抖动和碰撞；复合任务成功率很低，语言模型建议的任务也仍靠人实现&lt;br&gt;原版数据缺少高精度灵巧操作、可变形物体与双臂技能，范围主要是厨房&lt;br&gt;我的理解 / 不足：真机试验使用每任务 50 条真实示范和仿真数据共同训练，因此不能称零样本 Sim2Real&lt;br&gt;仿真与真机控制频率、相机和底座位置不同；DH116 接触物理和手指结构更复杂，迁移效果需重新测&lt;br&gt;未来展望：自动筛除抖动、碰撞等低质轨迹，扩展厨房外任务并降低复合任务阶段切换错误&lt;br&gt;可把相机、材质、桌高和接触摩擦分开扰动，测哪类仿真差异最影响真实抓取与放置&lt;br&gt;对我们项目的启发：可借鉴少量高质量示范 → 仿真扩增 → 同数据预算对照真机成功率的实验流程&lt;br&gt;若用于机械臂与 DH116，要重建手指、接触和任务判据；原版 RoboCasa 的单臂厨房结果不能直接当双臂灵巧手证据" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_5_branch_2" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1074.0" as="sourcePoint"/><mxPoint x="3322" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
