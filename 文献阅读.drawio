          </mxCell>
        </UserObject><mxCell id="paper_03_1_field_1" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本&lt;br&gt;引用量：11（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_1_branch_1" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_1_field_2" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_1_branch_2" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_1_field_3" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;预训练 VLM 具备视觉—语言理解能力，但机器人需要连续、精确的低层动作。分层方法把 VLM 的文字/代码计划交给独立控制器，接口不可微且增加时延；端到端 VLA 往往仅将 VLM 当特征编码器，直接把表征送入动作头。DIAL 把“预测希望场景如何变化”和“执行到该状态”明确分工。（论文第 1 节、图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_1_branch_3" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1170.5" as="sourcePoint"/><mxPoint x="562" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_1_field_4" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文要解决的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;如何让端到端 VLA 真正使用 VLM 的高层决策能力，同时避免低层动作监督过早干扰其语义表征。论文设计一个可微的潜在意图瓶颈，使动作必须通过预测未来视觉状态来生成，而不是绕过意图直接学习视觉—动作捷径。（第 1、3 节）" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_1_branch_4" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1610.0" as="sourcePoint"/><mxPoint x="562" y="1610.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_1_field_5" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;直接动作解码容易使 VLM 退化为普通多模态编码器，训练不稳且可能损伤预训练语义知识；仅把未来预测当辅助损失或把未来 token 拼接给动作头，也不能强制动作依赖预测的意图。独立规划器则阻断来自动作效果的端到端反馈。论文通过对照 GR00T、FLARE 风格和 SEER 风格变体检验了这些差异。（图 2、图 8；第 5.2 节）" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="1835" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_1_branch_5" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2049.5" as="sourcePoint"/><mxPoint x="562" y="2049.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_1_field_6" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：先预测想让场景变成什么样，再决定机器人动作；把任务意图连到实际控制&lt;br&gt;核心问题：高层说“把杯子放好”，低层动作怎样真正朝这个结果移动，而不只照当前画面动作？&lt;br&gt;之前的问题：直接出动作可能忽略目标；把规划和控制分得太开，又不容易一起训练" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="2292" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_1_branch_6" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2506.5" as="sourcePoint"/><mxPoint x="562" y="2506.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_2_field_1" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_2_branch_1" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_2_field_2" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;flow matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;World Model：世界模型，预测动作之后的画面或状态&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;OOD：训练分布之外，例如未见物体或不同背景" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_2_branch_2" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="797.5" as="sourcePoint"/><mxPoint x="1252" y="797.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_2_field_3" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与已有工作的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenVLA代表视觉语言特征到动作的通用策略路线；DIAL 把预测未来特征设为动作必须经过的意图接口。3D-VLA与VideoVLA同样将预测/生成引入操作，但 DIAL 不合成未来 RGB 或三维场景，而在原生 ViT 潜空间预测子目标。ACE-Ego-0主要解决人类视频转伪动作及人机数据对齐；DIAL 的主创新是意图—动作瓶颈和稳定的两阶段训练，EgoDex 人类示范是其中一类训练资源。以上是方法定位比较，非同一实验设置下的性能排名。（第 1–5 节）" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1075" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_2_branch_3" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1324.5" as="sourcePoint"/><mxPoint x="1252" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_2_field_4" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：分层方法先定目标再控制手臂，思路清楚，但两部分可能难一起调整&lt;br&gt;相关方向 2：端到端方法直接出动作；预测未来画面则给动作一个可检查的目标&lt;br&gt;代表工作：GR00T、FLARE、SEER；用作机器人动作或未来场景预测的比较对象&lt;br&gt;区别：先在视觉特征里预测目标状态，再让动作生成必须参考这个目标" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1602" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_2_branch_4" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1851.5" as="sourcePoint"/><mxPoint x="1252" y="1851.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_1" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入当前视觉、语言和机器人本体状态；System-2 用 VLM 在自身 ViT 特征空间预测未来观测，得到表示目标场景变化的 latent intent；System-1 比较当前与预测未来的潜在视觉特征，并结合本体状态，通过 flow-matching 动作专家生成动作块。潜在意图是两系统之间的结构性通道：它表达“想达到什么”，低层策略负责“怎样执行”。预测特征而非整张未来 RGB 图像，避免像素级重建的高计算负担与无关外观细节。（第 3.1–3.3 节；图 3）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_1" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_2" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法与系统结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;System-2 以 Qwen2.5-VL-3B 为 VLM 主干，在语言序列加入可学习 query，经 LLM 和 MLP 输出与未来观测 ViT patch 对齐的潜在特征，用均方误差训练 visual foresight。System-1 使用共享且冻结的 ViT 读取当前图像，以 4 层 self-attention 融合当前特征与预测意图，再由 16 层 DiT 经 cross-attention 条件化动作 token；本体状态经 MLP 输入 DiT。两系统共享原生 ViT 特征空间，避免另一个编码器带来的潜空间错位。（第 3.2–3.3 节；图 3）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_2" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="934.0" as="sourcePoint"/><mxPoint x="1942" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_3" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;模型输入是语言指令、当前视觉观测和机器人本体状态。RoboCasa 及真机实验将视觉缩放到 224×224；潜在预测使用 64 个 query。真机实验平台是 IRON-R01-1.11 人形机器人；PDF 未明确报告具体摄像头数量/安装位置、触觉输入或控制频率，因此不推断这些硬件细节。（第 3.1、4.1 节）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_3" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1443.5" as="sourcePoint"/><mxPoint x="1942" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_4" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输出 / 动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;输出长度为 H 的连续动作块，由 System-1 的 DiT 通过 flow matching 生成。RoboCasa 的状态/动作向量为 47 维：29 个关节自由度（双臂 14、手 12、腰 3）加双腕末端位姿 18 维（每腕 3D 位置＋6D 旋转）；实际命令发送到 29 维关节空间。真机加入头部 3 自由度，状态/动作为 50 维。RoboCasa、真机取放/倾倒任务动作块 H=16，真机多阶段协调任务 H=50。论文没有明示真机控制频率、夹爪型号；此处的 12 维手部关节不是普通二指夹爪。（第 3.3、4.1 节）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_4" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1953.0" as="sourcePoint"/><mxPoint x="1942" y="1953.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_5" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;官方代码 README 说明 RoboCasa 原始数据主要有关节角；作者通过仿真重放提取双腕末端 3D 位置与 6D 旋转，并补入 LeRobot 数据。论文把 EgoDex 的人类手腕末端位姿取为跨身体的共享部分，填充其余维度；在人类序列中以 t+1 状态作为 t 的监督动作。训练利用未来观测作为 System-2 的预测目标和预热期 System-1 的真实未来指导。它主要通过异构示范扩大交互覆盖，不等同于 ACE-Ego-0 的大规模第一视角视频几何重建与伪动作过滤流水线。（第 4.1.1 节；官方数据准备说明）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2248" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_5" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2515.0" as="sourcePoint"/><mxPoint x="1942" y="2515.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_6" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;阶段一：解耦预热。System-2 单独预测未来 ViT 特征，System-1 在真实未来特征（golden bridge）指导下学习动作，避免一开始把不准的预测意图和动作梯度耦在一起。阶段二：端到端优化。System-1 改用 System-2 的预测意图；flow-matching 动作损失经意图回传到可训练的 VLM 模块，并继续用未来特征预测损失约束该意图。ViT 和文本 embedding 冻结，其余 VLM 模块与 System-1 可训练；作者把训练稳定性归因于预热加共享特征空间，而不是声称动作梯度完全不影响 VLM。全数据仿真训练 160,000 步，少样本 40,000 步；真机预训练 160,000 步、任务微调 2,000 步。官方代码提供两阶段入口和仿真训练/评测脚本。（第 3.4、4.1 节；图 3）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="2810" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_6" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3129.5" as="sourcePoint"/><mxPoint x="1942" y="3129.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_3_field_7" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：System-2 看画面和指令，预测下一阶段希望达到的场景表示，作为中间目标&lt;br&gt;贡献 2：System-1 比较现在与目标有何差别，再推断手臂需要怎样移动&lt;br&gt;贡献 3：先分别训练两部分，再一起调整，让目标预测和动作生成更容易配合&lt;br&gt;流程：当前画面与指令→预测下一阶段结果→比较现在与目标→输出一小段机器人动作" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="3477" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_3_branch_7" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3726.5" as="sourcePoint"/><mxPoint x="1942" y="3726.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_4_field_1" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa GR1 Tabletop 有 24 个仿真任务，机器人轨迹全数据为每任务 1,000 条、共 24,000 条；少样本设置每任务 100 条、共 2,400 条。人类数据来自 EgoDex：仿真跨执行体实验采用 basic_pick_place 的 27,419 条，真机跨执行体预训练还使用 pour 的 3,205 条。真机预训练混合约 32,000 条工厂采集机器人轨迹与约 30,000 条 EgoDex 人类轨迹；每项真机任务再采集 120 条实验室机器人轨迹。交接上架和清扫倒垃圾没有匹配的人类示范，仅使用机器人原生序列。人类数据并非全部任务的控制监督，也不能写成所有真机任务都有跨执行体预训练。（第 4.1.1–4.1.2 节；图 5）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_4_branch_1" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_4_field_2" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa GR1 Tabletop 测人形 GR1 的语言条件桌面操作：18 个取放、6 个关节物体任务，按每任务 50 次测试的成功率平均。全数据比较每任务 1,000 条示范，少样本每任务 100 条；基线包括 Diffusion Policy、UWM、FLARE、GR00T-N1.6，以及使用 Qwen3-VL 的 GR00T/π/FAST/OFT 变体。消融在 Qwen2.5-VL-3B 相同骨干的少样本设置下比较世界建模、意图接口与特征空间。额外 OOD 测试包含新外观 18 任务、新容器组合 14 任务、新物体类型 32 任务。Benchmark 是 RoboCasa，DIAL 是模型，FLARE 等是 baseline；“当时最优”仅限论文报告的这一设置。（第 4.1、4.2、5.1–5.3 节；图 7–9）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_4_branch_2" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1074.0" as="sourcePoint"/><mxPoint x="2632" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_4_field_3" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;IRON-R01-1.11 人形机器人上有四类任务：取放、双手倾倒、双臂交接并上架、双工具清扫再倒入垃圾桶。前两类使用人类＋机器人示范预训练，后两类仅使用机器人序列；每任务采集 120 条机器人训练轨迹。评估区分分布内以及组合新布局、干扰物、新物体实例、新货架、新桌布等零样本变化；多阶段任务同时报告完整任务成功率与已完成子阶段的进度。论文未明确给出真机评测每设置的试验次数、摄像头物理配置、末端手/夹爪型号及控制频率，本卡不补猜。（第 4.1.2、5.4 节；图 5、6、10–12）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_4_branch_3" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1671.0" as="sourcePoint"/><mxPoint x="2632" y="1671.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_4_field_4" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa 全数据平均成功率 70.2%，对照最强列出基线 FLARE 55.0%；少样本仅用每任务 100 条示范时 DIAL 为 58.3%，高于 FLARE 使用每任务 1,000 条时的 55.0%。这是示范数为 1/10 的跨设置比较，并非声称所有方法训练计算量也减少 10 倍。人类数据使仿真 OOD 平均成功率 46.2%→51.2%，但关节任务因示范类别不匹配从 65.3% 降至 62.0%。真机取放＋倾倒分布内平均 77.5%、OOD 平均 58.3%；移除人类数据后真机 OOD 为 26.7%。这些数值分别见图 7–11，不能跨场景合并成单一 SOTA 指标。（第 5.1、5.3、5.4 节）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1966" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_4_branch_4" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2250.5" as="sourcePoint"/><mxPoint x="2632" y="2250.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_4_field_5" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa 少样本设置中，普通 GR00T-Qwen2.5 微调 30.6%，未来特征作为辅助损失的 FLARE 风格 51.9%，未来 token 松耦合拼接的 SEER 风格 49.6%，DIAL 结构瓶颈 58.3%；换成 DINO-v2 特征降至 47.2%，支持共享原生特征空间的重要性。真机移除解耦预热后，取放＋倾倒分布内平均 77.5%→57.5%，OOD 58.3%→30.0%。这些是模型/训练对照，不是独立新 Benchmark。（第 5.2、5.4 节；图 8、10、11）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="2563" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_4_branch_5" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2812.5" as="sourcePoint"/><mxPoint x="2632" y="2812.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_4_field_6" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文记录基线在多阶段清扫任务中会反复扫动而未及时转入“倒入垃圾桶”阶段，属于阶段切换失败；图 12 显示该类任务成功率明显低于已完成子任务的进度。人类 basic_pick_place 数据对关节任务没有增益，反映任务覆盖不匹配。论文未给出 DIAL 自身逐次抓取失败、潜在未来幻觉或长程误差累积的分类频次，不能把这些当成已观测结论。（第 5.3–5.4 节；图 9、12）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="3090" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_4_branch_6" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="3322.0" as="sourcePoint"/><mxPoint x="2632" y="3322.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_5_field_1" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者在结论提出的未完成方向：System-1 目前较小；ViT 保持冻结；潜在 token 可进一步压缩；尚未用大规模无动作标签野外人类视频训练 System-2；世界建模预训练还未成为 VLM 原生目标。文献库分析：现有真机验证限一款人形平台、四类任务，未证明普通夹爪或跨机器人部署；真机相机、频率及逐设置试验次数的公开信息不足，复现实验条件还需进一步核查。后两点是基于论文报告范围的判断，不是作者声称已验证的限制。（第 6 节；第 4.1.2 节）" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_5_branch_1" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_5_field_2" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对当前研究方向的价值&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究地图位置：VLA → World Model / Predictive Representation → Intent-Action Decoupling → End-to-End VLA；对应流程为“观测与语言 → VLM 推理 → 潜在未来/意图 → 低层动作”。对双臂与长程任务，可比较显式子目标瓶颈是否改善交接和工具使用的阶段切换。对 NERO＋普通夹爪，先验证相机、本体状态与动作空间的接口，不能直接照搬本文含 12 维手部关节的人形控制。潜在研究启发：未来预测与真实后继观测之间的偏差可能作为 Failure Detection、Recovery、Replanning 的触发信号；DIAL 论文没有实现或评估这种闭环恢复机制。灵巧操作迁移也尚未单独验证。（第 3、4、6 节）" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_5_branch_2" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1004.0" as="sourcePoint"/><mxPoint x="3322" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_03_5_field_3" parent="paper_03" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出 System-1 仍较小，视觉编码器未一起训练，可能限制整体能力&lt;br&gt;我的理解 / 不足：预测目标有助于动作朝任务前进，但论文未单独测试失败识别和恢复&lt;br&gt;未来展望：扩大动作模型，调整视觉部分，并尝试利用没有机器人动作标注的人类视频&lt;br&gt;对我们项目的启发：把“本来应出现的画面”和执行后的画面比较，可探索是否触发异常检测" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_03_5_branch_3" edge="1" parent="paper_03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1583.5" as="sourcePoint"/><mxPoint x="3322" y="1583.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
