          </mxCell>
        </UserObject><UserObject id="paper_131_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_131_1_field_1" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;文献身份与完整性&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整名称为Efficient Sim-to-Real Transfer of World-Action Models from Synthetic Priors。官方arXiv https://arxiv.org/abs/2606.31101 记录首次提交2026年6月30日，当前页面仅列v1；未发现后续版本记录。Comments明确接受于CVPR&amp;#x27;26 Embodied AI Workshop，且声明只代表将来完整工作的一部分早期结果。本地PDF三页含摘要、方法实验、结论与参考文献，题名作者一致，是这篇短文的完整文件，不能称CVPR主会长论文或假定附录丢失。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_1_branch_1" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_1_field_2" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Zixing Wang, Kausik Sivakumar, Jinghuan Shang, Yafei Hu, Zhaoming Xie, Ran Gong, Xiaohan Zhang, Karl Schmeckpeper；Purdue University、Robotics and AI Institute。代码/项目核验：未核验到本论文专属官方代码；Cosmos Policy及AnyTask为所依赖工作。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_1_branch_2" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="916.5" as="sourcePoint"/><mxPoint x="562" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_1_field_3" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者、引用与问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;八位作者机构为Purdue University和Robotics and AI Institute，Ran Gong、Xiaohan Zhang、Karl Schmeckpeper标为同等指导。引用次数本次未核验，arXiv DOI只标识预印本。研究背景是机器人真实遥操作示范昂贵，而纯仿真视觉与物理条件存在域差异；作者问一个很窄的实证问题：在视频预训练基础上仅用自动合成示范训练的世界—动作模型，是否能够未经真实数据微调，直接在真机完成部分操作。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_1_branch_3" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1408.5" as="sourcePoint"/><mxPoint x="562" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_2_field_1" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;世界—动作模型与对照的差别&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界—动作模型同时生成未来视觉观测与机器人动作：它既预测下一步怎么动，也预测动后会看到什么。本文沿用Cosmos Policy，而不是提出新的网络结构。Cosmos Policy将预训练Cosmos-Predict2视频扩散模型后训练成机器人策略，把动作、未来观测、价值估计编码为统一扩散过程中的潜在帧。潜在帧是神经网络内部的数据表示，不要求动作本身具有图片含义。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_2_branch_1" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_2_field_2" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;合成先验与域随机化&lt;/b&gt;&lt;br&gt;&lt;br&gt;“先验”在本研究主要指AnyTask自动产生的专家示范及预训练视频知识，不能误读为已提供完整的接触动力学模型。域随机化是在仿真训练时持续改变外观、相机、光照、物体位置，让真实条件更可能落进训练覆盖范围。DP对照只预测动作，且用真实示范训练；两组数据来源、数量、预训练不同，所以对照只能给出实际收集真实数据的参照，无法隔离联合视频预测的因果贡献。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_2_branch_2" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_3_field_1" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：构造随机化仿真输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者在GPU加速仿真里构建四项操作场景。随机化维度明确列为：物体表面、桌面和背景的程序纹理/照片纹理；腕部和第三人称相机平移旋转；灯光数量、位置、强度、色温；可达工作区内均匀采样物体初始位置。这使训练同一动作时能看到许多外观和视点。短文没有给各维上下限、相机内参范围、摩擦质量扰动方案或资产清单，不能把“广泛随机化”扩写成已随机所有动力学。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_3_branch_1" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_3_field_2" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：自动生成专家示范&lt;/b&gt;&lt;br&gt;&lt;br&gt;AnyTask通过基础模型引导的ViPR运动规划管线，为举香蕉、举砖块、开抽屉、把草莓放进碗中各生成约800条示范，总计约3200条。示范由RGB观测与末端动作轨迹配对，无人工遥操作。这样把原本要在真实环境逐条教的动作，转成可自动采样的合成监督。本文未给出生成失败率、过滤阈值、生成时长和各阶段具体控制器细节，复现需要另查所依赖的AnyTask，不能把那篇工作的全部细节视为本短文已验证。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_3_branch_2" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_3_field_3" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：联合后训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;用上述合成数据对Cosmos Policy进行32个epoch训练，模型继承视频生成主干，把动作、未来视觉与价值表示放入统一去噪过程。训练目标让模型关联当前画面、预期后果和控制，而不只拟合一个孤立动作向量。作者在真实执行画面旁展示预测的未来画面，尝试检查这种关联是否跨域保留。论文没有给本研究完整损失权重、动作归一化、动作块时域、分辨率、推理去噪步数或在线规划细节，故只可按公开的高层接口理解。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_3_branch_3" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_3_field_4" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：零样本真实部署&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练后直接部署到Franka Research 3，使用腕部与第三人称RGB相机实时输入，没有收集真实示范，也没有真实数据微调。“零样本”限定于这次任务策略的真实示范使用，不意味着基础视频模型从未看过真实图像，也不意味着没有相机安装配置。机器人按策略动作执行；文章没有说明额外触觉/力反馈输入，不能声称具备多指触觉闭环。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_3_branch_4" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1900.5" as="sourcePoint"/><mxPoint x="1942" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_3_field_5" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;机制归因的证据边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者推测迁移来自视频预训练、广泛域随机化与联合动作—视频目标的组合，但明确把受控消融留给后续工作。未来画面与实拍对齐仅说明定性上能保留物体位置、机器人姿态及任务阶段；它未提供像素预测误差或物理一致性指标，也没有证明画面预测被作为在线纠错信号。因此应区分“模型能联合预测”和“本文证明预测改善控制”两个命题。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2143" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_3_branch_5" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2375.0" as="sourcePoint"/><mxPoint x="1942" y="2375.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_4_field_1" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;任务、硬件、成本与样本数&lt;/b&gt;&lt;br&gt;&lt;br&gt;四项真机任务分别测试10次，总计40个rollout；训练每任务约800条纯仿真示范。32个epoch使用40张H100约72小时，若简单按GPU数量乘墙钟约为2880 GPU小时，该值是笔记算术换算，不是论文独立报告的能耗或金钱费用。论文没有报告示范生成耗时、推理延迟、控制频率、重复训练种子、置信区间和每次最大执行时长。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_4_branch_1" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_4_field_2" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;可核验的主结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;表1：本文纯合成模型举香蕉5/10、举砖块5/10、开抽屉2/10、草莓入碗2/10，合计14/40，平均35%。使用每任务10条真实示范训练的Diffusion Policy依次0/10、0/10、2/10、0/10，合计2/40，平均5%；每任务50条真实示范DP依次4/10、3/10、3/10、0/10，合计10/40，平均25%。35%比25%高10个百分点，但不能称同数据同模型条件下优于DP，也不能据此断言真实数据无价值。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_4_branch_2" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="829.0" as="sourcePoint"/><mxPoint x="2632" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_4_field_3" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;定性泛化、消融与失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;图2在草莓入碗的接近、抓取、抬升阶段并列模型预测和同步真实RGB，属于定性检验。图3显示训练任务外瓶子的一次接近、抓住并抬升，但未报告测试分母或成功率，不能写作新物体100%。没有去掉域随机化、视频预训练、AnyTask或联合预测的消融；没有多任务规模曲线。总体26/40次未成功，失败模式没有按感知、抓取、接触、规划逐项统计，不能为其补上自洽但无证据的原因。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_4_branch_3" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_5_field_1" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确限制&lt;/b&gt;&lt;br&gt;&lt;br&gt;首页和官方页面明确这是早期结果，完整研究待发布；作者特别说明DP不是架构匹配的受控实验，也不声称证明联合视频动作预测对迁移必要；各组成因素的受控归因留待未来。所谓首次成功是作者在其知识范围内的表述，应保留限定。本文核心贡献是给出非零真机迁移可行性，任务成功率35%本身仍不足以支持稳定部署。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_5_branch_1" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="354.5" as="sourcePoint"/><mxPoint x="3322" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_5_field_2" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;笔记分析：DH116与Sim2Real&lt;/b&gt;&lt;br&gt;&lt;br&gt;Franka末端操作与DH116多指手的接触面、自由度、关节耦合和滑移风险不同，末端轨迹示范无法直接转成可靠手内操作。可借鉴的是完整保存“合成多少、真实多少、每任务成功几次”的评测口径，先用单个抓取或放置任务验证视觉随机化覆盖，再考虑多指关节动作与接触信号。建议把真实相机标定、物体几何及力学偏差单独记录，避免把所有迁移困难都归因于画面外观。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_5_branch_2" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="829.0" as="sourcePoint"/><mxPoint x="3322" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_131_5_field_3" parent="paper_131" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;笔记分析：下一步应验证什么&lt;/b&gt;&lt;br&gt;&lt;br&gt;若希望判断联合视频生成是否值得计算成本，应在相同合成示范和预训练预算下比较动作策略、联合世界—动作策略，并分别移除随机化；增加真实测试次数与训练种子，统计抓取失败和后续操作失败。对DH116而言，可优先验证相机遮挡与手指接触可观测性，再决定是否需要价值预测或视频规划。这些是建议，不是本论文已完成的结果，也不表示本项目已经实现任何迁移。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_131_5_branch_3" edge="1" parent="paper_131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1321.0" as="sourcePoint"/><mxPoint x="3322" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-page-04" name="04 执行误差与失败恢复">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="3440" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
