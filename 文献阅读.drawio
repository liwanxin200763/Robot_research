        </mxCell>
        <mxCell id="paper_130_pdf" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;02_机器人操作\&lt;br&gt;VidMan.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_130_code" parent="paper_130" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;02_机器人操作\&lt;br&gt;VidMan - Exploiting Implicit Dynamic&lt;br&gt;s from Video Diffusion Model for Effe&lt;br&gt;ctive Robot Manipulation.md&lt;br&gt;&lt;br&gt;开源信息：PDF声明代码与模型将公开，本次未核验&lt;br&gt;到可确认完整发布的专属仓库" vertex="1">
          <mxGeometry height="604" width="480" y="1463" as="geometry" x="0"/>
