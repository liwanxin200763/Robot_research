        <mxCell id="paper_11_authors" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Chenghao Liu、Jiachen Zhang、Chengxuan Li、Zhimu Zhou、Shixin Wu、Songfang Huang、Huiling Duan" vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_11_pdf" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;01_VLA\&lt;br&gt;TTF-VLA.pdf" vertex="1">
          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_11_code" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;01_VLA\&lt;br&gt;TTF-VLA - Temporal Token Fusion via&lt;br&gt; Pixel-Attention Integration for Vision&lt;br&gt;-Language-Action Models.md&lt;br&gt;&lt;br&gt;开源信息：官方 GitHub" vertex="1">
          <mxGeometry height="534" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_11_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_11_bottomnav_1" label="返回分类" link="data:page/id,literature-page-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_11_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_11_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-12" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_11_1_field_1" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / AAAI 2026（正式论文）&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_1_branch_1" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_1_field_2" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：连续操作视频的相邻画面有大量静态区域，逐帧重算视觉特征浪费算力；但盲目缓存可能漏掉对任务关键的变化。（论文第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：在不重新训练 OpenVLA 等底座的条件下，利用相邻帧冗余加速或改进 VLA 推理，同时避免动态目标信息被错误复用。（第 1、3 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_1_branch_2" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_1_field_3" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;仅按像素差决定复用会忽视语义重要性；仅看语义注意力又可能漏掉实际发生变化的区域。直接多帧输入也增加令牌开销。（第 2–3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_1_branch_3" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1440.0" as="sourcePoint"/><mxPoint x="562" y="1440.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_1_field_4" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：VLA（视觉—语言—动作模型，把图像和指令变成机器人动作），时间信息融合，多帧视觉，推理阶段增强&lt;br&gt;核心研究问题：现有 VLA 常独立处理当前帧，如何在不重新训练模型的情况下利用历史视觉信息，提高动作预测的稳定性和抗视觉噪声能力，利用历史帧，但又不要重新训练整个 VLA，也不要把所有历史都重新计算一遍，不要一帧只管一帧&lt;br&gt;之前方法的问题：单帧 VLA 会丢失连续操作中的时间信息，直接输入大量历史帧又增加计算量，而且并非所有历史区域都值得重复处理" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1658" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_1_branch_4" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1960.0" as="sourcePoint"/><mxPoint x="562" y="1960.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_2_field_1" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：与 VLA-Cache 相比，它额外使用像素变化和语义注意力做当前／历史令牌融合；与长期 Memory VLA 不同，处理的是局部时序冗余。（第 2–4 节）" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_2_branch_1" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_2_field_2" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_2_branch_2" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_2_field_3" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：不能好几张图片全部输入进去，一张图在 VLM（视觉语言模型，联合理解图像与文字） 里面会变成很多视觉 token（模型处理文字或图像时使用的小信息单元）。但是实际上只有很少的东西改变了，单帧 VLA，根据当前视觉和指令独立生成动作&lt;br&gt;相关方向 2：多帧与历史视觉方法，通过过去观测增强当前动作预测&lt;br&gt;代表工作：OpenVLA，VLA-Cache&lt;br&gt;与已有方法的区别：不是把完整历史帧全部重复输入，也不重新训练基础 VLA，而是在推理阶段筛选真正有价值的历史视觉 token，再与当前视觉表示融合" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_2_branch_3" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1412.0" as="sourcePoint"/><mxPoint x="1252" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_3_field_1" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：融合灰度像素变化和任务相关注意力：只要任一路提示 patch 应更新，就采用当前帧；否则复用上一帧令牌。周期性 keyframe 抑制累计误差。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：TTF-VLA 是现有 VLA 的训练免除式推理插件。对前后两帧视觉 patch 构造像素变化和注意力掩码，用 OR 规则形成融合令牌，再交给原动作模型；按固定间隔强制刷新关键帧，典型 K=3。（第 3 节）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_3_branch_1" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="389.5" as="sourcePoint"/><mxPoint x="1942" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_3_field_2" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：当前与上一时刻 RGB 图像、任务语言和模型内部视觉注意力；不建立跨整段任务的长期语义记忆。论文没有把 Proprioception 作为插件新输入。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：TTF-VLA 不另定义动作空间，仍由所接入 OpenVLA／VLA-Cache 预测原有动作，主要实验为 7-DoF 操作。（第 3–4 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：图像灰度差分与注意力 patch 筛选用于在线令牌融合；训练数据增强：不适用，方法无需再训练。（第 3 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_3_branch_2" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="969.0" as="sourcePoint"/><mxPoint x="1942" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_3_field_3" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;推理时接入，不微调底座或新增训练阶段；这是与 ContextVLA、HAMLET 的关键差别。（第 3–4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_3_branch_3" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1489.0" as="sourcePoint"/><mxPoint x="1942" y="1489.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_3_field_4" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：提出训练免费的 Temporal Token Fusion，在不重新训练基础 VLA 的情况下引入历史视觉信息&lt;br&gt;贡献 2：结合灰度像素变化和注意力语义相关性，只保留真正有价值的历史视觉 token，比如灯光变化会导致整个像素变化，但是实际上并没有那么多变化&lt;br&gt;贡献 3：通过选择性融合和关键帧锚定减少无效计算与历史误差累积，并可适配不同 VLA&lt;br&gt;方法流程：当前帧与历史视觉 token → 像素变化检测 → 语义相关性判断 → 筛选有效历史信息 → 时间 token 融合 → VLA 生成动作" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1707" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_3_branch_4" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1991.5" as="sourcePoint"/><mxPoint x="1942" y="1991.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_4_field_1" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：使用底座既有训练权重，评估 LIBERO、SimplerEnv 和真机操作；插件本身不采集新训练数据。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：LIBERO 每套 200 个 episode，SimplerEnv 和 3 项真机任务；主要对比 OpenVLA、VLA-Cache 及组件消融。（第 4 节，表 1–4）&lt;br&gt;&lt;br&gt;真机实验：3 项任务各 20 次，包含物体操作与抽屉任务；整体均值从 38.3% 到 41.7%，抽屉任务仍为 45%。（第 4 节，表 4）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_4_branch_1" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_4_field_2" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：LIBERO 中 OpenVLA 均值 68.4%→72.4%，Long 为 48.0%→53.5%；VLA-Cache 均值 71.3%→74.0%（表 1）。SimplerEnv 33.2%→34.9%（表 2）；真机 38.3%→41.7%（表 4）&lt;br&gt;&lt;br&gt;消融实验：LIBERO 中仅像素变化 70.4%，仅注意力 71.3%，二者融合 72.4%（表 3）。关键帧间隔过长（如 K&amp;gt;30）会累积误差。（第 4 节）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_4_branch_2" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1021.5" as="sourcePoint"/><mxPoint x="2632" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_4_field_3" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文未单列系统性失败案例；真机抽屉任务没有提升，关键帧过疏带来性能下降。不能将此法称为失败检测或动作重规划。（第 4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_4_branch_3" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1489.0" as="sourcePoint"/><mxPoint x="2632" y="1489.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_4_field_4" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集 / 基准测试：LIBERO，SimplerEnv，真实机器人任务&lt;br&gt;基线方法：OpenVLA，VLA-Cache 等现有单帧或缓存式 VLA&lt;br&gt;主要结果：LIBERO 平均成功率由 68.4% 提升到 72.4%，SimplerEnv 相对提升约 4.8%，真机任务相对提升约 8.7%&lt;br&gt;这里的成功率要按上面列出的测试任务和次数理解&lt;br&gt;真实机器人实验：有，真实机器人实验同样观察到历史视觉融合带来的性能提升" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1707" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_4_branch_4" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1991.5" as="sourcePoint"/><mxPoint x="2632" y="1991.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_5_field_1" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：方法只利用相邻帧复用，缺少长期任务状态与显式执行误差建模；对底座能力仍有依赖。正式论文没有独立作者局限性章节；以上是依据方法与实验的文献库分析。（第 3–4 节）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可作为部署时低开销的视觉历史利用模块；研究执行误差时仍需独立检测器及恢复策略，论文没有验证这些功能。（第 3–4 节）" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_5_branch_1" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_11_5_field_2" parent="paper_11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：方法主要利用短期视觉历史，重点仍是推理阶段时间融合，没有建立长时间尺度的任务语义记忆&lt;br&gt;我的理解 / 不足：能够缓解遮挡和瞬时视觉噪声，但不知道哪些子任务已经完成，也不能解释动作为什么失败&lt;br&gt;未来展望：进一步研究更长时间范围的历史筛选，更高效的特征复用，以及短期视觉历史与长期语义记忆结合&lt;br&gt;对我们项目的启发：可以先用最近若干帧建立低成本时间上下文，比较成功和失败执行前后的视觉变化，用作执行错误检测的基础输入" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_11_5_branch_2" edge="1" parent="paper_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="934.0" as="sourcePoint"/><mxPoint x="3322" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
