            <mxGeometry x="3180" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="detail_50_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#50 Bidirectional Decoding">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_50_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="06 动作建模与控制  ·  本类第 5 / 19 篇  ·  问题：长动作段平滑，却来不及响应物体移动；每步重新预测反应快，却可能一会儿左绕一会儿右绕。能否在两者之间保留一致且可及时修正的动作？&lt;br&gt;方法流程：新观察 → 采样多个动作段 → 对照旧段检查连贯性 → 强/弱参考比较未来质量 → 选候选并执行短动作 → 再观察 → 滚动更新计划">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="paper_50" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="2600" width="4000" x="140" y="450" as="geometry"/>
        </mxCell>
        <mxCell id="paper_50_title" parent="paper_50" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=16;editable=1;movable=1;resizable=1;shadow=0;" value="#50 Bidirectional Decoding" vertex="1">
          <mxGeometry height="140" width="480" y="30" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_50_title_branch" edge="1" parent="paper_50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
