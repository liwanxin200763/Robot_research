        <mxCell id="paper_56_fulltitle" parent="paper_56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;RoboCasa: Large-Scale Simulation of Household Tasks for Generalist Robots" vertex="1">
