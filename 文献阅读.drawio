          <mxGeometry height="78" width="650" x="3300" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_56_5_field_rail" edge="1" parent="paper_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
