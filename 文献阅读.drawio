          </mxCell>
        </UserObject><UserObject id="paper_51_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-68" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_51_1_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / CVPR&lt;br&gt;引用量：37（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_1" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_1_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_1_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Dexterous Manipulation 方向，主要讨论接触密集的灵巧操作需要根据目标与环境变化调整动作。&lt;br&gt;核心思路是DexHandDiff 用交互感知的扩散式规划生成可适应目标变化的灵巧手动作。&lt;br&gt;与当前项目的联系：项目联系：可借鉴动作生成机制，但灵巧手与普通夹爪不同" vertex="1">
          <mxGeometry height="429" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1170.5" as="sourcePoint"/><mxPoint x="562" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_1_field_4" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：接触密集的灵巧操作需要根据目标与环境变化调整动作&lt;br&gt;&lt;br&gt;为什么重要：展示生成式策略如何表达多种接触动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_4" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1603.0" as="sourcePoint"/><mxPoint x="562" y="1603.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_1_field_5" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：灵巧手状态—动作联合扩散规划。扩散模型从噪声逐步生成轨迹；状态是手与物体目前情况，动作是机器人可执行的控制量&lt;br&gt;核心研究问题：训练示范只开门到90度，测试要开30度并停住。能否在不重新采所有目标数据的情况下修改目标，同时保证手真的推动物体而非物体凭空动？&lt;br&gt;之前方法的问题：只生成动作不易直接指定新物体目标；只生成物体状态却可能出现“幽灵状态”：笔自己转了、门自己开了，手并没有产生相应接触" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1821" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_5" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2088.0" as="sourcePoint"/><mxPoint x="562" y="2088.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：固定轨迹或单一接触模式难适应复杂手—物交互" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_branch_1" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="822.0" as="sourcePoint"/><mxPoint x="1252" y="822.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_2_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：Diffusion Policy（扩散策略）直接生成动作，通常受训练目标范围限制；状态扩散便于改目标，但会忽视物体必须通过接触才改变&lt;br&gt;相关方向 2：引导式生成用可微目标函数推动采样满足要求；目标函数需同时考虑物体、手和动力学，否则可能只优化物体终点而忽略动作可执行性&lt;br&gt;代表工作：Diffuser 与条件扩散基线分别体现状态/动作规划取舍。#48 ManipTrans 用残差修正接触；DexHandDiff 在规划生成阶段约束接触与动作一致&lt;br&gt;与已有方法的区别：联合预测状态和动作，再用交互引导连接二者。Zero-shot（零样本）在此主要指未训练过的目标设定，不代表任意新物体、新手型都无需数据" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_2_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1359.5" as="sourcePoint"/><mxPoint x="1252" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_3_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：DexHandDiff 用交互感知的扩散式规划生成可适应目标变化的灵巧手动作&lt;br&gt;&lt;br&gt;避免物体自己移动的虚假计划：DexHandDiff 不只生成手的动作，还联合建模状态与动作。若计划里物体变化却没有手接触，那在图像或状态序列上可能像完成任务，物理上却不可执行；交互感知引导因此先对齐接触，再处理接触后的手物共同运动&lt;br&gt;&lt;br&gt;双阶段引导怎样影响动作：接触前重点让手到达合适位置，接触后再让物体朝任务目标变化，同时让手的运动与物体保持耦合。把目标引导与接触引导分开，可减少为了满足终点而跳过接触过程的计划。输出的扩散轨迹仍需机器人控制器执行，模型规划看似连贯并不替代真实接触和碰撞验证" vertex="1">
          <mxGeometry height="744" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_3_branch_1" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="512.0" as="sourcePoint"/><mxPoint x="1942" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_3_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：把手与物体状态、手动作放进同一条扩散轨迹。模型同时学习动作之后状态如何变，减少单独预测物体状态而失去机器人控制关联的问题&lt;br&gt;贡献 2：接触前先引导指尖靠近合适接触点，接触后再推动物体达到目标。把“先碰到再改变”分两阶段，抑制物体无接触移动的幽灵状态&lt;br&gt;贡献 3：结合目标、动力学与物理约束的梯度引导；可手写，也测试语言模型生成引导函数。语言模型写出函数仍需物理与执行验证&lt;br&gt;方法流程：手/物体当前状态+新目标 → 联合生成状态与动作 → 接触前对齐 → 接触后目标控制 → 动力学约束纠偏 → 执行短轨迹 → 重新规划" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_3_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1231.5" as="sourcePoint"/><mxPoint x="1942" y="1231.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_3_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1579" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_3_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1793.5" as="sourcePoint"/><mxPoint x="1942" y="1793.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_4_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：官方摘要报告目标自适应任务平均成功率 70.7%&lt;br&gt;&lt;br&gt;实验与结果：主要结果：官方摘要报告目标自适应任务平均成功率 70.7%" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_4_branch_1" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_4_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：Adroit 等仿真门、笔、锤、搬移与方块任务，测试原目标与改变后的目标；主要使用可获取的手和物体状态，没有本地可核对的真机任务成功率&lt;br&gt;对照：与 Diffuser、条件扩散比较；去掉联合状态动作或接触引导消融，还比较手写与语言生成引导，定位消除幽灵状态的来源&lt;br&gt;结果：只在开90度数据训练，测试开30度：DexHandDiff70%，条件扩散16.7%。表示完成指定新角度并满足任务判据，而非仅门角度预测准确&lt;br&gt;真机 / 关键补充：多任务表平均70.7%，条件扩散58%；论文表格已给平均，此卡没有自行汇总。作者建议未来接入视觉估计物体状态和真实手部传感" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_4_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_4_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_4_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_5_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：可借鉴动作生成机制，但灵巧手与普通夹爪不同&lt;br&gt;&lt;br&gt;主要局限：需检查真机接触、动作延迟和跨硬件泛化&lt;br&gt;&lt;br&gt;局限与启发：主要局限：需检查真机接触、动作延迟和跨硬件泛化" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_5_branch_1" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_5_field_2" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：结论提出未来用真实手部状态和视觉物体位姿部署；当前依赖较准确状态与目标函数，真机感知与接触误差没有同等完整验证&lt;br&gt;我的理解 / 不足：我的判断：遮挡下物体位姿估计错误，梯度会把动作引向错误目标；DH116 接触约束也不同，仿真引导需要重建&lt;br&gt;未来展望：加触觉与状态置信度，控制错误引导强度；测试摩擦变化、滑落和接触点切换，使新目标适应与失败恢复连接起来&lt;br&gt;对我们项目的启发：可作 DH116 接触规划基线。先建手—物体状态和动力学接口，再定义抓牢/旋转目标；不能把 Adroit 手的控制量直接迁移" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_5_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_51_5_field_3" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_5_branch_3" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1496.0" as="sourcePoint"/><mxPoint x="3322" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
