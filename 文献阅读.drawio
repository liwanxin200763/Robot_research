        <mxCell id="paper_19_fulltitle" parent="paper_19" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;DataMIL: Selecting Data for Robot Imitation Learning with Datamodels" vertex="1">
