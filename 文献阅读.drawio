        </UserObject><UserObject id="paper_107_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-56" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_107_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-108" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3686" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_107_1_field_1" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待核验；来源为 Google Scholar，未经人工查看不填写数字（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量&lt;br&gt;数据链条位置：第三人称视频转为双臂灵巧示范" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_1_branch_1" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_1_field_2" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;项目主页：待核验（未从当前官方摘要页获得可确认入口）&lt;br&gt;GitHub / 开源程度：见本卡“来源与核验边界”；未核实不视为代码已完整开放&lt;br&gt;版本查询与全文核验日期：2026-10-15" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_1_branch_2" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="864.0" as="sourcePoint"/><mxPoint x="562" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_1_field_3" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：DemoBot 从一段第三人称 RGB-D 示范提取双手及物体动作，再在仿真中学习局部修正，重点是双臂长程装配的阶段对齐和探索效率。人的轨迹是“有用但不完全正确的先验”，而非必须每个时间点照抄的控制目标（§1、§3）&lt;br&gt;&lt;br&gt;研究方向与快速摘要：视觉没有直接告诉机器人真实接触力，人的手与 Allegro／xHand 形态也不同；因此仅做三维重建和逆运动学，仍可能抓不住或插不准。Residual RL（残差强化学习）在示范关节目标上增加学习到的小修正，使机器人在物理交互中完成任务" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_1_branch_3" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1496.0" as="sourcePoint"/><mxPoint x="562" y="1496.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_1_field_4" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实际输入的限定&lt;/b&gt;&lt;br&gt;&lt;br&gt;实际输入的限定：使用已标定 RealSense D455，预先已有的 3D 打印物体模型，人工选抓取／抬起／插入等关键帧，针对装配任务人工设计位姿优化目标。论文中的“unannotated”不表示整个管线完全没有人工标注，正文明确要求关键帧（§3.1、§4.2、§6）&lt;br&gt;&lt;br&gt;实际输入的限定：PDF 首页署名 ByteDance Seed，完整作者贡献在第 16 页，与 arXiv 作者列表一致；PDF 草稿日期 2025-12-12，arXiv 首发为 2026-01-04，本卡年份按公开 arXiv 记录为 2026，不据草稿日期另建一篇" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_1_branch_4" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2110.5" as="sourcePoint"/><mxPoint x="562" y="2110.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_2_field_1" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作：DexCap通过动捕取得更清晰的人手数据；YOTO是少量双臂示范相关路线；ManipTrans提供示范引导策略思路。这些工作在表 1 和相关研究中用于定位，不能直接写成表 4 中同硬件同数据的基线" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_2_branch_1" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_2_field_2" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_2_branch_2" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="934.0" as="sourcePoint"/><mxPoint x="1252" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_2_field_3" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：整段时钟同步的示范 RL 会遇到机器人与人的操作速度不同：机器人还没抓稳，参考已进入插入阶段，奖励和基础动作都会误导探索。本文把参考切成有物体子目标的阶段，并用训练重置给后期阶段更多练习机会（§2.2、§3.2）&lt;br&gt;&lt;br&gt;相关工作：DexImit 偏向生成可用双手机器人数据；本文重点是“一段有深度和已知模型的示范 → 任务专用残差 RL”，通过阶段课程学会高精度装配，而非大规模网络视频预训练通用 VLA" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_2_branch_3" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1443.5" as="sourcePoint"/><mxPoint x="1252" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_3_field_1" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 先生成完整臂手动作先验&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 先生成完整臂手动作先验：WiLoR 恢复两只人手的 MANO 参数；把网格按实测相机内参投影到图像，优化与二维关键点的误差，纠正估计相机与真实相机不一致的影响。物体分割加 FoundationPose 和已有三维模型提供位姿；装配时按孔轴与插销轴共线、端点相对位置优化物体姿态（§3.1、§4.2）&lt;br&gt;&lt;br&gt;1. 先生成完整臂手动作先验：随后优化目标手的基座和关节，让正向运动学关节点尽量匹配 MANO 三维结构；再在 Isaac Lab 求机械臂逆运动学，得到完整左右臂＋手轨迹。人工关键帧把轨迹切成片段，每段有对应物体状态子目标（算法 1）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_3_branch_1" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_3_field_2" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 分段残差减轻时间错位&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 分段残差减轻时间错位：状态包含关节位置／速度、物体和任务信息，加入当前阶段 ID；基础动作来自当前阶段的参考，不再拿其他阶段参考控制机器人。最终关节位置目标 a = a_demo + Δa，残差限在 ±0.25 rad，初始输出层为零，使训练从小修正开始（§3.2）&lt;br&gt;&lt;br&gt;2. 分段残差减轻时间错位：段内仍利用参考运动，但段目标提供任务进展标准；这不是任意速度下完美对齐的保证。作者曲线显示去掉阶段划分会严重影响长程学习，因此段划分是任务工程的重要前提" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_3_branch_2" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1091.5" as="sourcePoint"/><mxPoint x="1942" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_3_field_3" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. Success-Gated Reset 让后期阶段可练习&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. Success-Gated Reset 让后期阶段可练习：成功门控重置指失败后部分环境回到上一阶段已经成功的终态，避免每次都从头抓取、很少到达后期插入；其余环境仍回初始状态，防止忘掉前面技能。实验 p_init 为 0.90–0.95，也就是多数重置仍从头开始，小比例有针对性练后期（§3.2、§4.2）&lt;br&gt;&lt;br&gt;3. Success-Gated Reset 让后期阶段可练习：这是仿真训练的状态采样机制，不是现实机器人失败后能瞬移回历史状态的恢复算法。真实失败恢复需要另外判断状态并规划可执行补救动作，不能直接把仿真 reset 部署到机器人" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_3_branch_3" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1706.0" as="sourcePoint"/><mxPoint x="1942" y="1706.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_3_field_4" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 事件奖励和动力学随机化&lt;/b&gt;&lt;br&gt;&lt;br&gt;4. 事件奖励和动力学随机化：接近、抓取、到达目标分别启用距离奖励与稀疏完成奖励，同步任务另加左右臂同步达标奖励；阈值随训练变严，接近阶段先固定手张开，再学习手指控制。课程学习是逐步调整学习难度，不表示任务顺序由大模型自动生成（表 2）&lt;br&gt;&lt;br&gt;4. 事件奖励和动力学随机化：迁移训练的执行器模型加入 PD 增益变化、位置偏差、速度依赖的力矩饱和和强度变化，模仿真实电机的不理想行为。它与只随机物体质量／摩擦不同，对 DH116 应用前需要实际系统辨识，不能套用原手参数（§4.2）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="2036" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_3_branch_4" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2338.0" as="sourcePoint"/><mxPoint x="1942" y="2338.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_3_field_5" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 事件奖励和动力学随机化&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGB-D＋相机标定＋已知物体模型＋人工关键帧 → 双手／物体估计及任务位姿修正 → 目标手重定向＋机械臂 IK → 分段参考和子目标 → 仿真 PPO 残差／成功门控重置／事件课程 → 随机执行器训练 → 关节目标策略 → 真机状态反馈执行" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2668" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_3_branch_5" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2865.0" as="sourcePoint"/><mxPoint x="1942" y="2865.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_4_field_1" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;双臂仿真&lt;/b&gt;&lt;br&gt;&lt;br&gt;Isaac Lab 中双 Franka Panda＋Allegro 手。同步装配为 5 子目标，双手持底座和销在空中配合；异步装配为 11 子目标，一臂先摆底座再由另一臂插入。初始物体平移在 ±10 cm、旋转在 ±0.1 rad 内随机；不同种子重复 5 次（§4.1、§4.3）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_4_branch_1" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_4_field_2" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;双臂仿真&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂仿真：表 4 中完整方法达到 5/5 和 11/11 子目标，单独动作先验为 0/5 和 0/11，从头 RL 为 0/5 和 1/11。分母是子目标数，不是试验次数，不能把这些数写成“100% 任务成功率”。图 7 是训练步数与达成子目标曲线，阴影为重复种子标准差&lt;br&gt;&lt;br&gt;消融解释：去掉运动先验或分段会失败；不限幅残差容易远离稳定参考；去掉预抓取课程对需要两手同时稳定抓取的同步任务尤其不利；去掉重置机制，异步任务后期学得慢，同步任务难练到最终阶段。这些是作者曲线与讨论的结论，没有同一完整任务成功率表，不补造百分比（§4.3）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_4_branch_2" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_4_field_3" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机证据及限制&lt;/b&gt;&lt;br&gt;&lt;br&gt;真实平台是 单 UR3e＋xHand，受硬件限制把任务改为单步抓销插入和多步先摆底座再插入，不能写成已完成双臂 Allegro 真机迁移。论文报告单步 18/20 = 90%，多步 12 次成功、60%（对应 20 次），初始物体状态有变化，真机目标为完成装配（§4.4、图 8）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_4_branch_3" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_4_field_4" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机证据及限制&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机证据及限制：主要失败来自手遮挡后的物体姿态漂移，多步摆错底座会把误差传到后续插入。真实迁移是任务专用策略与改造后的硬件概念验证，不是对未知机器人同一权重零样本迁移&lt;br&gt;&lt;br&gt;真机证据及限制：正文称 15 秒视频约 4 分钟单 GPU 处理，这是数据处理速度，不是完整 RL 训练时长；GPU 型号和全任务训练预算未明确核实，不能据此说四分钟学会整套双臂策略" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_4_branch_4" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1918.0" as="sourcePoint"/><mxPoint x="2632" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_5_field_1" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确承认：人工关键帧、深度相机、已有 3D 打印模型、任务特定物体优化是当前简化；六维物体姿态主要支持刚体。RGB-only、生成物体资产和自动选阶段为未来方向（§5–6）&lt;br&gt;&lt;br&gt;不足与未来：我的理解：残差范围对具体耦合手和机械臂都有影响；装配的任务奖励与关键帧不易直接泛化到擦拭或软物体。真实单臂证明可迁移，但不能代替双臂冲突、协调延迟和共享视觉状态的测试&lt;br&gt;&lt;br&gt;不足与未来：DH116 / D435i 参考路线：可用 D435i 录制已知刚体抓放，先人工设少量关键帧；替换为 DH116 仿真模型、指令与耦合限制，验证臂手可达，再借鉴阶段目标和小幅残差。若未来做双臂，须分别核对左右手坐标及同步终态，成功门控重置只用于仿真采样" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_5_branch_1" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="512.0" as="sourcePoint"/><mxPoint x="3322" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_5_field_2" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;成本与未来工作：视频采集硬件相对接近本项目，但高维 RL、Isaac Lab、物体模型和执行器识别增加复现成本；官方代码未确认，完整复现不能保证低门槛。更值得低成本先做的是分段轨迹重放和物体跟踪误差审计，再决定是否投入双臂 RL" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_107_5_branch_2" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
