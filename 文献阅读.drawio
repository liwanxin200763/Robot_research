        </UserObject><mxCell id="paper_100_1_field_1" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / ICRA&lt;br&gt;引用量：1593（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作&lt;br&gt;数据链条位置：跨机器人示范数据统一与共享训练" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_1_branch_1" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_1_field_2" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;为什么把不同实验室的数据放在一起：单个实验室难以采全所有物体、任务和场景，但不同机器人相机、控制量和数据格式不相同。Open X-Embodiment 整合超过百万条跨机器人示范，并通过 RT-X 模型测试共享训练是否带来迁移。重点不只是下载量，而是不同本体的数据是否提供可复用操作知识" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_1_branch_2" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_2_field_1" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;数据联盟与通用策略各负责什么：此前 RT-1、RT-2 等显示大规模行为学习可行，但集中于特定机器人；OXE 把多个机构的数据整理到共同接口。RT-1-X 与 RT-2-X 是检验这批数据的模型实例，数据集、训练混合与模型开放程度必须分开理解；使用 OXE 不等于每个子集都具有相同传感器和许可证" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_2_branch_1" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_2_field_2" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;跨本体共享既可能带来正迁移，也可能发生负迁移：另一台机器人数据多但控制习惯不同，可能让小数据本体的动作更难学习。OXE 的价值在于提供真实多样来源，让这种问题可以实验，而不是假设混得越多越好。共享格式解决工程入口，共享知识仍需模型与数据配方检验" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_2_branch_2" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1004.0" as="sourcePoint"/><mxPoint x="1252" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_3_field_1" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;统一格式但保留控制语义差异&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一格式但保留控制语义差异：使用 RLDS 表示带时间顺序的轨迹，存观察、动作、语言等字段；对部分图像与动作通道做标准化，让模型可以共同读取。原文明确没有把所有数据集的相机视角和末端坐标完全对齐，同一数值也可能代表不同本体的绝对位置、增量或速度，因此加载前必须检查语义，不能把统一数组形状当成统一物理动作&lt;br&gt;&lt;br&gt;从数据混合到 RT-X：实验训练混合使用九类操作本体的数据，让相同网络结构的 RT-1 与 RT-1-X 比较单本体和共同训练，再用较大容量 RT-2-X 检查新物体及跨数据来源技能。模型从图像与指令预测离散动作表示，落到具体机器人仍由对应动作解码与控制接口执行；训练配比会影响哪些小数据任务获得帮助" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_3_branch_1" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="477.0" as="sourcePoint"/><mxPoint x="1942" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_3_field_2" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：统一时还要保留每条轨迹的终止、成功与指令边界；否则把两段任务直接拼成一个序列，会让模型把复位当成下一步正确动作。对于缺少语言的子集，如何提供任务条件也影响可用性。原文的跨机器人训练采用指定数据混合，并非随意把全库所有通道连接后即可复现论文结果&lt;br&gt;&lt;br&gt;把方法按信息流读清楚：先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="674" width="628" x="1942" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_3_branch_2" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1179.0" as="sourcePoint"/><mxPoint x="1942" y="1179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_4_field_1" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;范围、平台和对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;卡片记录正式发表 ICRA 2024，本地所读 PDF 为后续 arXiv 修订版。论文覆盖 22 种机器人、约 500 种技能与 16 万项任务；实际各项 RT-X 实验使用的混合是其子集，不能把全库规模直接当单模型实际训练量。评测包含 WidowX、Google Robot 等多个真实平台" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_4_branch_1" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_4_field_2" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要数字怎样读&lt;/b&gt;&lt;br&gt;&lt;br&gt;图 4 报告 RT-1-X 平均成功率相对原方法约高 50%，这是相对增幅，不能写成统一增加 50 个百分点。表 II 同为 55B 时，跨数据技能评估 RT-2-X 为 75.8%，RT-2 为 27.3%，但另一泛化评估为 61% 对 62%，说明共享数据并非所有指标均更好；去掉 Bridge 后技能结果降至 42.8%，提示特定来源确实贡献了迁移" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_4_branch_2" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="776.5" as="sourcePoint"/><mxPoint x="2632" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_4_field_3" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把关键设计与实验读透&lt;/b&gt;&lt;br&gt;&lt;br&gt;把关键设计与实验读透：图 4 与表 II 问的是不同问题：小数据机器人能否从别处借经验，和大型模型能否在已见平台执行来自别处的技能。后一种结果中去掉 Bridge 的消融，比跨论文对比更能说明数据来源的作用；相同模型容量下再比较数据混合，才避免把大网络收益误算成数据收益&lt;br&gt;&lt;br&gt;这些结果的正确读法：把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_4_branch_3" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1356.0" as="sourcePoint"/><mxPoint x="2632" y="1356.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_5_field_1" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自建数据集最直接的启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;对自建数据集最直接的启发：共享训练仍受控制接口、视角、任务组成和数据不均衡影响；多指手和双臂的高维接触并未被统一七维夹爪动作自动解决。可以借鉴轨迹组织、来源标签和逐数据集转换器，先为 DH116 明确主动轴、耦合轴和动作单位，再研究哪些公开数据能共享感知表示，哪些只能用作预训练&lt;br&gt;&lt;br&gt;把关键设计与实验读透：自建文献库之外的数据工程可先仿照每个数据集一个转换器，输出统一字段并附坐标、单位和来源说明。对双臂灵巧手，建议保留左右腕、主动轴目标、实际状态和耦合映射，而非过早压成低维夹爪动作。只有明确信息丢失了什么，才能判断公开数据适合感知预训练还是直接动作训练" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_5_branch_1" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="477.0" as="sourcePoint"/><mxPoint x="3322" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_100_5_field_2" parent="paper_100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_100_5_branch_2" edge="1" parent="paper_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1039.0" as="sourcePoint"/><mxPoint x="3322" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
