        <mxCell id="paper_40_4_field_1" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="实验：用 DROID 等数据预训练，在 LIBERO 操作与 MV-Bench 多视角任务测试，并做 Franka 真机四类任务。指标包括任务完成率和跨视角表现" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_2" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="460" as="sourcePoint"/>
            <mxPoint x="1615" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对照：与 OpenVLA 等模型比较，并去掉历史、替换采样方法或时间编码做消融。整体模型大小和训练方案可能也不同，应以消融定位具体模块作用" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_3" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="700" as="sourcePoint"/>
            <mxPoint x="1615" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_3" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：论文报告 LIBERO 平均较 OpenVLA 提高12.1个百分点，长任务提高25.4个百分点。这是该设置下完整任务成功率差值，不等于所有动态环境同样改善" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_4_branch_4" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="940" as="sourcePoint"/>
            <mxPoint x="1615" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_40_4_field_4" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：Franka 真机报告平均85.63%，OpenVLA27.70%；模型和训练不完全相同，不能全部归因于记忆。历史采样与时间编码消融更适合分析因果贡献" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_40_5_drop" edge="1" parent="paper_40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
