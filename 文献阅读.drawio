        </UserObject><UserObject id="paper_22_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-28" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_22_1_field_1" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / CoRL 2026&lt;br&gt;引用量：6（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_1_branch_1" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_1_field_2" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作&lt;br&gt;&lt;br&gt;研究背景：机器人腕部视角随动作快速变化，单帧或短窗世界模型容易丢失遮挡前看到的物体和接触状态。（第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：用持久的时空记忆支持动作条件下多视角未来图像预测，并改进基于预测轨迹的策略选择。（第 1 节）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_1_branch_2" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="867.5" as="sourcePoint"/><mxPoint x="562" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_1_field_3" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;之前方法存在的问题：固定时间窗忽略几何相关却较早的观测；单纯按时间抽帧会取回视角无关或重复内容。（第 2–3 节）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：三维记忆帮助世界模型预测动作后的画面。世界模型就是“给定动作，估计场景接下来怎样变”&lt;br&gt;核心问题：手挡住物体、手腕相机换角度时，模型还能否记住物体并预测下一帧？&lt;br&gt;之前的问题：只看近期画面容易忘记被遮住的物体；连续预测又可能把早先的错误越滚越大" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_1_branch_3" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1517.0" as="sourcePoint"/><mxPoint x="562" y="1517.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_2_field_1" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读&lt;br&gt;&lt;br&gt;与已有工作的关系：与 DynaMem 的在线语义地图不同，这里以候选动作和未来腕部视角组织记忆，服务于前瞻预测" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_2_branch_1" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="407.0" as="sourcePoint"/><mxPoint x="1252" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_2_field_2" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_2_branch_2" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="892.0" as="sourcePoint"/><mxPoint x="1252" y="892.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_2_field_3" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：动作条件世界模型给定一个候选动作，预测做完后相机可能看到什么&lt;br&gt;相关方向 2：持久三维记忆把不同视角看到的物体联系起来，暂时看不见也不必完全忘掉&lt;br&gt;代表对照：Ctrl-World；也比较记忆怎样检索、给模型几个视角会怎样影响预测&lt;br&gt;区别：先估动作后腕部相机将看向哪里，再从三维记忆找最相关的旧画面给预测模型" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_2_branch_3" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1359.5" as="sourcePoint"/><mxPoint x="1252" y="1359.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_3_field_1" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：构建腕部中心的四维 surfel 记忆 W-VMem，用候选动作的正向运动学预测未来腕部位姿，再检索空间、时间和任务上相关的历史视图。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：记忆元素保存三维位置、法向、半径、时间和被操作物标志；几何检索、近期权重及非极大值抑制选择历史观测，世界模型生成第三视角和腕部未来图像，预测视图还能回写。这里的“动态”主要是机器人动作引起的接触、遮挡与视角变化；论文未证明外部异步移动目标的处理。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_3_branch_1" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_3_field_2" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：历史图像、机器人动作及候选未来动作、相机/腕部位姿和四维记忆；不是语言事件或双臂共享记忆。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：输出动作条件下的未来视觉观测，供候选轨迹评估与策略训练；本体不是直接输出控制动作的 VLA，也没有等待、回滚与显式风险门控。（第 3–4 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：把腕部历史观测转为时空 surfel 并按预测腕部视角检索；生成的未来视图可回写记忆。论文未报告独立的数据增强效果。（第 3 节）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_3_branch_2" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1039.0" as="sourcePoint"/><mxPoint x="1942" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_3_field_3" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;在 Ctrl-World 基础上调整时间注意力并使用记忆条件训练；论文报告使用 8 张 H100。下游将世界模型产生的轨迹用于策略数据选择。（第 4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_3_branch_3" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1559.0" as="sourcePoint"/><mxPoint x="1942" y="1559.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_3_field_4" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：记忆保存小块三维表面的位置、朝向、大小、时间，以及是否属于正在操作的物体&lt;br&gt;贡献 2：用候选动作算未来相机视角，优先找位置相关、较新且与目标物体有关的历史画面&lt;br&gt;贡献 3：模型利用多视角历史预测未来画面；预测图也写回记忆，供下一步继续预测&lt;br&gt;流程：多相机画面→三维记忆→按候选动作找相关历史→预测未来画面→更新记忆" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_3_branch_4" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2026.5" as="sourcePoint"/><mxPoint x="1942" y="2026.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_4_field_1" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：基于 DROID 操作数据，论文报告总量 95,599 条轨迹，并抽取约 11,000 条进行模型适配；还评估真实 Franka 单臂操作。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：34 条约 20 秒轨迹的视频回放、多视角预测、策略评价相关性，以及 Franka 单臂长程任务；对照 Ctrl-World、短期和稀疏抽帧记忆。（第 4 节）&lt;br&gt;&lt;br&gt;真机实验：Franka 单臂任务中用世界模型筛选每任务约 200 条生成轨迹中的 20–30 条成功样本后训练 π0.5；并非双臂或异步变化环境实验。（第 4 节）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_4_branch_1" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="459.5" as="sourcePoint"/><mxPoint x="2632" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_4_field_2" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：第三视角 PSNR 25.30 对 Ctrl-World 23.17，腕部视角 19.21 对 17.34；策略结果相关系数 0.97 对 0.85；所述长程任务成功率 58%→72%。（第 4 节、结果表）&lt;br&gt;&lt;br&gt;消融实验：W-VMem 优于短期记忆与固定步长历史抽样；不同检索和记忆配置说明几何相关历史比纯时间最近更有用。（第 4 节、消融表）&lt;br&gt;&lt;br&gt;Failure Case：论文展示无有效对向接触时生成模型仍“幻想”成功抓取；初始腕部图像被遮挡也会误导预测。（第 4 节、失败示例）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_4_branch_2" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1126.5" as="sourcePoint"/><mxPoint x="2632" y="1126.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_4_field_3" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：用 DROID 数据评估不同视角画面预测和策略评估，也在单臂 Franka 上测试&lt;br&gt;对照：与 Ctrl-World 比较；PSNR 衡量预测图与真图相似度，还看动作排序及长任务成功率&lt;br&gt;结果：预测画面 PSNR 越高越接近实拍：第三视角 23.17→25.30，腕部视角 17.34→19.21&lt;br&gt;真机：策略排序相关性 0.85→0.97；长任务成功率 58%→72%。两者衡量候选评估和任务完成" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1474" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_4_branch_3" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1723.5" as="sourcePoint"/><mxPoint x="2632" y="1723.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_5_field_1" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：环境动态类型：弱动态；机器人操作引起物体状态、遮挡和腕部视角变化，未证明外部异步移动目标&lt;br&gt;&lt;br&gt;主要局限：作者指出物理接触约束仍不足。按本库分析，记忆有时间维度却未显式估计物体波动率、旧记忆置信度或独立运动目标；预测图像也不能单独完成失败诊断和恢复&lt;br&gt;&lt;br&gt;对当前研究方向的价值：适合作为双臂 VLA 行动前世界模型与多视角记忆的候选模块；要用于执行误差研究，还需另加动作实际结果验证和风险门控。论文未涉及双臂或 DH116" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_5_branch_1" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="459.5" as="sourcePoint"/><mxPoint x="3322" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_5_field_2" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者主要测试机器人动作造成的场景与视角变化，例如手遮挡物体&lt;br&gt;我的理解 / 不足（据实验推断）：未测独立高速移动目标；预测图回写若错，可能继续污染记忆&lt;br&gt;未来展望：新实拍画面若与预测不同，应降低旧预测可信度，再更新场景或重新选动作&lt;br&gt;对我们项目的启发：把 DynaMem 的真实深度校验接在预测回写处，测错误记忆会不会减轻" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_5_branch_2" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1056.5" as="sourcePoint"/><mxPoint x="3322" y="1056.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_22_5_field_3" parent="paper_22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_22_5_branch_3" edge="1" parent="paper_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1531.0" as="sourcePoint"/><mxPoint x="3322" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
