        </UserObject><UserObject id="paper_69_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-70" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_69_1_field_1" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICLR&lt;br&gt;引用量：37（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_1_branch_1" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_1_field_2" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_1_branch_2" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_1_field_3" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Imitation Learning / Diffusion / Flow Matching / Robot Manipulation 方向，主要讨论机器人模仿学习通常需要大量专家示范。&lt;br&gt;核心思路是ET-SEED 研究带空间结构的扩散式操作策略；具体模块与输入输出需核验官方正文，不能只凭项目页推断。&lt;br&gt;与当前项目的联系：项目联系：与低示范双臂操作相关，但证据细节仍待查" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_1_branch_3" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_1_field_4" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;机器人模仿学习通常需要大量专家示范" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_1_branch_4" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1673.0" as="sourcePoint"/><mxPoint x="562" y="1673.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_1_field_5" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：三维空间泛化与模仿学习&lt;br&gt;SE(3) 指物体在三维空间中的旋转和平移；等变表示指物体换位姿后，机器人预测的轨迹也按同样变换，而不必重新学每个摆放角度；本文关注整段末端轨迹&lt;br&gt;核心问题：示范只覆盖少数物体位置，普通模仿策略在物体旋转或平移后容易输出原来的抓取路线&lt;br&gt;作者问能否从少量示范学到整段随物体位姿移动的操作轨迹，同时减少每步都使用复杂等变网络的训练成本&lt;br&gt;之前方法的问题：DP3 可生成轨迹却缺严格三维等变性；只做数据增强难覆盖连续的旋转与平移&lt;br&gt;EquiBot 等方法要求每一步扩散转移都等变，网络更难训练；在欧氏向量里扩散旋转也不完全贴合刚体位姿结构" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1891" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_1_branch_5" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2210.5" as="sourcePoint"/><mxPoint x="562" y="2210.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_2_field_1" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;之前方法的问题：如果没有适合的空间表示，少量示范难以支持稳定动作生成" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_2_branch_1" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_2_field_2" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Flow Matching：流匹配，学习把简单噪声连续变成目标动作的变化方向&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;DP3：用三维点云观察生成动作的扩散策略" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_2_branch_2" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="899.0" as="sourcePoint"/><mxPoint x="1252" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_2_field_3" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：抓取位姿等变方法能让单个目标姿态随物体变化，但复杂操作还需要连续多个末端姿态&lt;br&gt;ET-SEED 把等变性放到整段轨迹上，覆盖开门、书写和布料操作，仍须用真实控制器执行这些末端目标&lt;br&gt;相关方向 2：Diffusion Policy 和 DP3 从噪声逐步恢复动作；EquiBot 在每步去噪都保持几何等变，以获得新位置泛化&lt;br&gt;本文证明在其设定的初始分布与转移条件下，前几步不变、最后一步等变也能使最终轨迹等变&lt;br&gt;代表工作：DP3 是无显式等变的三维轨迹基线，DP3+Aug 加训练时位姿扰动，EquiBot 是全程等变扩散基线&lt;br&gt;三者用于检验仅靠数据增强和每步等变的差异；SE(3) Transformer 则是本文构造不变与等变网络的技术基础&lt;br&gt;与已有方法的区别：作者把轨迹中每个末端姿态与噪声定义在刚体变换空间，并设计只在最后一步使用等变去噪&lt;br&gt;这样既给出整个输出随输入刚体变换的理论条件，也减轻全部去噪步骤采用等变网络的计算与学习难度" vertex="1">
          <mxGeometry height="814" width="628" x="1252" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_2_branch_3" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1601.0" as="sourcePoint"/><mxPoint x="1252" y="1601.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_3_field_1" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;ET-SEED 研究带空间结构的扩散式操作策略；具体模块与输入输出需核验官方正文，不能只凭项目页推断" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_3_branch_1" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="330.0" as="sourcePoint"/><mxPoint x="1942" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_3_field_2" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：过去常假设每个去噪步骤都必须等变；作者推导一类更宽松的马尔可夫转移条件&lt;br&gt;在满足初始噪声分布和转移约束时，先做 K−1 次对输入刚体变换不变的去噪，再做一次等变去噪，最终轨迹仍能等变&lt;br&gt;贡献 2：末端平移与旋转属于刚体位姿，简单拼成欧氏向量可能破坏旋转几何；作者在 SE(3) 上给示范轨迹逐步加噪&lt;br&gt;逆过程用不变及等变的 SE(3) Transformer 预测相对变换，输出未来每步六维末端姿态&lt;br&gt;贡献 3：只生成单个抓取姿态不足以完成开门和书写；模型一次生成整段末端轨迹，并让点云与轨迹经过相应几何变换时保持对应关系&lt;br&gt;作者用新位姿任务和去模块消融检验这种设计，而非把理论等变直接当作真机成功率保证&lt;br&gt;方法流程：多相机彩色点云中的目标物体 → 与随机 SE(3) 末端轨迹一起输入去噪网络&lt;br&gt;前 K−1 轮用不变骨干预测并去掉位姿噪声，末轮用等变骨干输出动作段 → 逆运动学与控制器把末端目标转成机器人关节执行" vertex="1">
          <mxGeometry height="919" width="628" x="1942" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_3_branch_2" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1007.5" as="sourcePoint"/><mxPoint x="1942" y="1007.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_3_field_3" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;把方法按信息流读清楚&lt;/b&gt;&lt;br&gt;&lt;br&gt;先区分模型实际接收的观察、训练时额外可得的监督，以及机器人最终执行的动作。前面方法框中的每个模块分别处理其中一环：感知决定看到了什么，表示或规划决定保留什么，动作头或控制器决定发出什么；这些接口要按本文的机器人和数据重新核验，不能仅凭名称相似就直接互换" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1495" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_3_branch_3" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1709.5" as="sourcePoint"/><mxPoint x="1942" y="1709.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_4_field_1" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要结果：当前摘要来源没有足以安全复述的统一量化结果&lt;br&gt;&lt;br&gt;实验与结果：主要结果：当前摘要来源没有足以安全复述的统一量化结果" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_4_branch_1" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_4_field_2" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：六项仿真任务包括开瓶盖、开门、旋转三角形、书写、叠布和抖布，用每任务 25 或 50 条示范&lt;br&gt;先在训练位姿测，再把目标物体随机旋转和平移到新位姿测；每设置 20 次执行，跨五个随机种子统计成功率和轨迹误差&lt;br&gt;对照：DP3、带 SE(3) 数据增强的 DP3 和 EquiBot；成功率衡量任务完成，SE(3) 测地距离衡量预测末端轨迹与示范轨迹的姿态差&lt;br&gt;另在开门新位姿设置去掉骨干的等变结构或等变扩散过程，定位两部分的作用&lt;br&gt;结果：50 条示范的新位姿开瓶盖成功率 ET-SEED 为 82±2.74%，EquiBot 为 77±7.58%、DP3 为 14±6.5%&lt;br&gt;开门新位姿为 76±2.24%，但 EquiBot 为 77±7.58%，说明并非所有单项都领先；开门消融完整模型 76%，去等变扩散为 57%，再去空间结构为 24%&lt;br&gt;真机 / 补充：Franka 与多相机点云测试开瓶盖、开门、书写、叠布，每任务 20 条遥操作示范，在 10 个未见位姿各试一次&lt;br&gt;ET-SEED 成功率依次 8/10、6/10、4/10、6/10；EquiBot 为 6/10、5/10、0/10、3/10，十次样本不足以精确估计罕见失败" vertex="1">
          <mxGeometry height="954" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_4_branch_2" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1039.0" as="sourcePoint"/><mxPoint x="2632" y="1039.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_5_field_1" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：与低示范双臂操作相关，但证据细节仍待查&lt;br&gt;&lt;br&gt;主要局限：原卡方法字段混入项目网址，需优先重新阅读正式方法章节&lt;br&gt;&lt;br&gt;局限与启发：主要局限：原卡方法字段混入项目网址，需优先重新阅读正式方法章节" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_5_branch_1" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_69_5_field_2" parent="paper_69" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：等变性针对分割后的目标物体点云，运行前仍须把物体从场景中分出来&lt;br&gt;动作只有末端六维位姿，假定逆运动学和控制器可到达目标；高维手指动作不在该表示内，无法直接处理灵巧手操作&lt;br&gt;我的理解 / 不足：理论保证针对定义好的刚体变换和模型转移，不等于遮挡、变形或接触物理也等变&lt;br&gt;真机每任务只有十次测试且依赖多相机融合；若 DH116 的指尖接触或布料状态变化主导结果，末端轨迹泛化未必足够&lt;br&gt;未来展望：可同时量化物体分割误差、预测轨迹误差、逆运动学不可达率和实际接触失败，分清几何泛化与执行误差&lt;br&gt;将等变结构扩展到手指关节、接触状态或双臂相对位姿需要新的动作表示与实测验证&lt;br&gt;对我们项目的启发：机械臂可借鉴物体旋转或平移时轨迹同变的测试设计，先用少量示范比较新位姿成功率&lt;br&gt;接入 DH116 时需另建手指与接触动作，并检验双臂相对几何；本文不能直接证明灵巧手 Sim2Real 或失败恢复" vertex="1">
          <mxGeometry height="884" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_69_5_branch_2" edge="1" parent="paper_69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
