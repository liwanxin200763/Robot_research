          </mxCell>
        </UserObject><UserObject id="paper_128_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-129" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_128_1_field_1" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与证据范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;TASTE-Rob: Advancing Video Generation of Task-Oriented Hand-Object Interaction for Generalizable Robotic Manipulation，canonical与本地CVPR开放版题名一致。官方arXiv https://arxiv.org/abs/2503.11423 记录首次2025年3月14日、v2为6月6日；正式CVPR 2025。本地11页含正文及参考文献，正文提及Appendix 8–12，但这些补充节不在当前文件中，因此详细指标定义和精修步数附录不能假装已经读取。旧卡引用数50本次未核验。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_1_branch_1" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="389.5" as="sourcePoint"/><mxPoint x="562" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_1_field_2" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者机构与代码入口&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hongxiang Zhao、Xingchen Liu、Mutian Xu、Yiming Hao、Weikai Chen、Xiaoguang Han；香港中文大学（深圳）SSE、FNii；Weikai Chen按作者个人研究声明。代码/项目核验：项目 https://taste-rob.github.io；PDF声明数据与代码将公开，当前完整代码状态未核验。未把项目主页或依赖工具的存在等同于本论文完整复现已通过。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_1_branch_2" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="899.0" as="sourcePoint"/><mxPoint x="562" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_1_field_3" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;问题背景&lt;/b&gt;&lt;br&gt;&lt;br&gt;从生成的人手操作视频迁移机器人动作，既需正确理解对象与目标，又需手抓姿势稳定。一般人类视频数据相机不断移动，剪出的片段也可能混入多个动作、与文字不精确对应，导致生成示范不可靠。本文同时改进数据采集和生成过程：用固定视角、单完整动作的指令视频训练，再修复抓握姿态。核心贡献是示范视频质量与下游仿真操作效果，不是直接输出机器人关节的通用VLA。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_1_branch_3" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1391.0" as="sourcePoint"/><mxPoint x="562" y="1391.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_2_field_1" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人与本文的输入输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;常规图生视频模型输入场景图及文字，输出看似自然的视频，但会在搬运过程中改变手指抓法。只从机器人视频学习又受数据规模限制。TASTE-Rob利用人类视频规模优势，将任务语义与二维手姿运动分开处理：视频生成器决定对象及大体路线，运动扩散模型修正手部序列，最后视频生成器按修正姿态重绘。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_2_branch_1" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="354.5" as="sourcePoint"/><mxPoint x="1252" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_2_field_2" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;通俗术语&lt;/b&gt;&lt;br&gt;&lt;br&gt;HOI为手—物交互；第一人称在本文主要指与头戴相似的相机视角，采集时仍保持每段机位不变。VDM生成整段像素视频，MDM在关键点坐标序列上生成或修正运动，二者并不等价。姿态一致性要求握住同物体时手型不要不合理突变，但二维关键点稳定不保证摩擦、接触力和机器人可达性都正确。" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_2_branch_2" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="811.5" as="sourcePoint"/><mxPoint x="1252" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_3_field_1" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤一：面向任务的数据采集&lt;/b&gt;&lt;br&gt;&lt;br&gt;使用广角1080p相机，在厨房、卧室、餐桌、办公桌等场景逐条记录指定交互，每段少于8秒，只含一个完整动作；人按开始、执行、结束的流程录制，使语言与动作边界一致。指令加入物体颜色、位置等描述，以减少多个相似物体的歧义。共有100856条：单手75389、双手25467。数据覆盖抓取、放置、推、倒等动作，但这是人的双手视频，不等于机器人双臂执行已得到验证。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_3_branch_1" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_3_field_2" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤二：粗动作规划视频&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stage I基于DynamiCrafter图生视频扩散模型，以初始场景图、文字、帧率条件产生粗视频。只微调图像上下文投影器和U-Net空间层，以保留预训练的时间生成能力。该阶段通常能选对目标和搬运方向，却可能在握持中忽然从包握变捏取。故粗视频被当作可修正的空间计划，而非可直接信任的精细物理动作。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_3_branch_2" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_3_field_3" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤三：提取与修正手部轨迹&lt;/b&gt;&lt;br&gt;&lt;br&gt;用MediaPipe从粗视频抽取归一化二维手关键点序列。Image-to-Hand-Params MDM在原文字条件之外加入CLIP场景图特征，学习任务和环境条件下的手部运动。直接从高斯噪声生成全新姿态虽可能自然，却容易偏离当前物体位置；因此从已有粗轨迹出发进行有限步去噪，既保留空间落点，也修正不稳定抓型。作者选择10步精修，体现空间一致与姿态自然之间的折中。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_3_branch_3" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_3_field_4" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤四：姿态条件重生成&lt;/b&gt;&lt;br&gt;&lt;br&gt;将修正后的关键点可视化为逐帧手姿图，用帧独立的姿态编码器产生条件特征，按类似ControlNet的方式注入冻结的视频生成器中间层。此阶段只训练姿态适配器，让最终视频遵循修正手姿，同时保留初始场景和任务条件。输出是精细HOI示范视频，不是手指关节角或力矩；若误把像素输出直接解释成机器人动作，会漏掉跨形态控制这一层。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_3_branch_4" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1813.0" as="sourcePoint"/><mxPoint x="1942" y="1813.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_3_field_5" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;步骤五：连接机器人策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;最终视频交给既有Im2Flow2Act策略框架，借物体运动流等跨域接口将人手示范用于机器人控制。本文不重新提出完整的底层控制器，而是固定这条下游管线，用粗、精视频对照判断姿态修复是否提高执行效果。方法依据是更一致的视觉运动给下游更清楚的目标轨迹；仍需下游策略负责具身映射和闭环执行，不能声称模型已解决任意人手到多指手重定向。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_3_branch_5" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2305.0" as="sourcePoint"/><mxPoint x="1942" y="2305.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_3_field_6" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;为什么保留粗轨迹再修复&lt;/b&gt;&lt;br&gt;&lt;br&gt;视频生成器对初始场景中哪个对象、朝哪边动具有较好的空间约束；运动模型更擅长让手姿自然，但从噪声独立生成容易漂移。有限步修复等于在已有答案附近做调整，使两类先验互补，而非让第二模型从头重做整个任务。第三阶段又把关键点条件注入像素生成，避免只输出一组看似正确却与实际视频不同步的关键点。" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2565" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_3_branch_6" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2779.5" as="sourcePoint"/><mxPoint x="1942" y="2779.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_4_field_1" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练与评测条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;每动作类别抽2%为TASTE-Rob-Test；另从Im2Flow2Act的MuJoCo仿真平台随机选50项操作任务。Stage I训练30K步、批量16、学习率5e-5；Stage II训练100K步、批量64、学习率1e-4；Stage III训练30K步、批量32、学习率5e-5；推理视频用50步去噪、手姿精修10步。当前PDF未报告训练GPU总时、模型推理秒数或真实机器人成功率。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_4_branch_1" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_4_field_2" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;视频质量与数据消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;TASTE-Rob-Test上完整方法KVD0.03、FVD9.43、PIC0.90；DynamiCrafter为0.21/62.36/0.79，CogVideoX为0.16/48.72/0.85。这是生成质量和输入一致性指标，不能当操作成功率。以相同DynamiCrafter训练流程比较数据：Ego4D-Gen用83647条HOI视频，FVD52.17；粗TASTE-Rob为10.85，支持专门采集协议的价值，但训练数据规模也不同，不能只归因于固定机位。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_4_branch_2" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="829.0" as="sourcePoint"/><mxPoint x="2632" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_4_field_3" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;姿态精修与下游结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;表5粗到精：FVD10.85→9.43、抓姿方差GPV0.28→0.24、抓型分类错误GTCE67.8%→9.7%；HMDA表格为越低越好、26.4°→11.3°，尽管正文称Accuracy，实际表中呈现角度误差口径，已渲染核对。MuJoCo下游成功率84%→96%，正文说明选取50项随机任务，但未报告每项重复次数及总rollout分母，不能直接换算为42/50或48/50；种子和置信区间也未报告，不扩写为大量真机抓取统计。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_4_branch_3" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_4_field_4" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对照完整性与失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;一般图生视频模型输出质量太低，作者没有继续对它们做手姿/机器人操作比较；因此96%主要是本方法有无精修的下游消融，而非与所有机器人策略公平全面竞赛。精修0步保留抓型突变，50步从噪声重建会损失空间定位；中间步数可折中，当前文件未包含完整附录数值曲线。旋转和打开物体等显著形变仍使视频质量下降。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_4_branch_4" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1795.5" as="sourcePoint"/><mxPoint x="2632" y="1795.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_4_field_5" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;指标可解释性&lt;/b&gt;&lt;br&gt;&lt;br&gt;FVD/KVD描述生成视频分布与真实视频特征分布的差距，PIC关注是否保留输入场景。GPV、抓型分类错误和方向角从手姿层面评估一致性，各自会受关键点提取质量影响。指标改善为生成示范更可用提供证据，但没有测量接触力、穿透深度或机器人关节约束，不能把它们统一改名为物理准确率。" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2038" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_4_branch_5" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2252.5" as="sourcePoint"/><mxPoint x="2632" y="2252.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_5_field_1" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者明确局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者承认物体发生较大旋转、打开等变化时生成质量退化。数据采集者全部右利手，手掌朝向分布也不均；该事实说明动作覆盖有偏，并不直接给出机器人左手失败率。当前PDF没有真实机器人和精细接触力验证，补充材料缺失使指标详细定义与更多训练条件尚待核验。" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_5_branch_1" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_5_field_2" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;DH116与视觉的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;对DH116可把高质量HOI视频作为运动与语义先验，但需三维手姿重建、关节可达映射及真实接触约束，二维关键点修复不足以推出稳定抓握。建议优先检查物体是否始终被正确跟踪、手物相对运动是否连续，以及在相同视觉轨迹下触觉能否分辨滑移。若做人手到DH116数据转换，应明确保留哪些关节/指尖约束和哪些动作为不可达。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_5_branch_2" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="776.5" as="sourcePoint"/><mxPoint x="3322" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_128_5_field_3" parent="paper_128" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Sim2Real与评测分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;可沿用“原始生成—姿态修复—机器人执行”分层消融，分别量化视频自然、目标位置、接触可行性与真实成功率，避免用低FVD替代物理验证。应补齐不同左右手、遮挡和对象开合的失败样本，再在相同任务与分母下测试真实执行。本文展示的96%只属于其MuJoCo设置，不应迁移成DH116、双臂真机或新任务的预计成绩。" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_128_5_branch_3" edge="1" parent="paper_128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1233.5" as="sourcePoint"/><mxPoint x="3322" y="1233.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
