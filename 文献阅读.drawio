        </UserObject><UserObject id="paper_89_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-90" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_89_1_field_1" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICRA 2026&lt;br&gt;引用量：待 Google Scholar 人工核验（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_1_branch_1" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_1_field_2" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;Venue：ICRA 2026&lt;br&gt;代码状态：公开 robomimic 筛选源码；未安装运行，真机全栈待核验&lt;br&gt;查询与核验日期：2026-10-15&lt;br&gt;关联：机器人数据采集与数据质量 · 机器人遥操作与动作重定向" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_1_branch_2" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_1_field_3" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;基本信息与研究问题：研究方向：示范质量、目标任务数据选择、模仿学习。Behavior Cloning（行为克隆）是把机器人在某个观察下执行的动作作为监督标签；标签中混入抓空、犹豫或错误策略，模型也可能学会这些行为&lt;br&gt;&lt;br&gt;基本信息与研究问题：本篇不设计新遥操作器，而是研究已有示范应该保留哪些。作者把质量定义为“加入这条数据是否有助于降低目标验证示范的学习损失”，让质量随目标任务和当前策略改变，而不只看轨迹是否短、画面是否漂亮（第 1–3 页）" vertex="1">
          <mxGeometry height="569" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_1_branch_3" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1534.5" as="sourcePoint"/><mxPoint x="562" y="1534.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_1_field_4" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;快速摘要：混合示范＋少量理想验证轨迹 → 训练基础策略 → 比较样本梯度 → 按整条轨迹聚合 → 重新训练。关键收益是真机香蕉抓取成功率由最强对照的 56.7% 提高到 86.7%；这不是通用质量保证，也不是直接测量真实成功率的打分器（图 2）" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1847" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_1_branch_4" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2044.0" as="sourcePoint"/><mxPoint x="562" y="2044.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_1_field_5" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：用影响函数近似挑选对目标训练真正有用的轨迹&lt;br&gt;Quality over Quantity 根据训练样本与理想验证示范的梯度关系挑整条轨迹&lt;br&gt;为什么重要 / 旧方法的不足：关键收益是真机香蕉抓取成功率由最强对照的 56.7% 提高到 86.7%；这不是通用质量保证，也不是直接测量真实成功率的打分器" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="2269" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_1_branch_5" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2501.0" as="sourcePoint"/><mxPoint x="562" y="2501.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_2_field_1" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：Behavior Retrieval 把状态与动作压缩成特征，再找接近专家的数据；Flow Retrieval 使用图像运动估计得到的光流，比较运动相似性。两者容易把“看起来像”当成“训练后有帮助”，在不同物体或视角下可能检索错" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_2_branch_1" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_2_field_2" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;Behavior Cloning：行为克隆，学习示范中观察到动作的对应关系&lt;br&gt;LoRA：只训练少量附加参数来适配大模型的方法" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_2_branch_2" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_2_field_3" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;DemInf 用状态多样性和动作可预测性衡量数据；DataMIL 及 CUPID 用影响函数近似估计提高某条数据训练权重后，验证误差或闭环回报怎样变化。QoQ 属于后者，但改为对每个训练样本取最相关验证样本的最大梯度相似度，再选择整条轨迹。论文讨论这些方法，不意味着所有方法都进入同一真机对照表（§II、IV）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_2_branch_3" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1408.5" as="sourcePoint"/><mxPoint x="1252" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_2_field_4" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;梯度：模型要减少某个训练错误时，内部参数应朝哪个方向改变&lt;br&gt;Behavior Retrieval 把状态与动作压缩成特征，再找接近专家的数据" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_2_branch_4" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1841.0" as="sourcePoint"/><mxPoint x="1252" y="1841.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_3_field_1" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 把“有价值”联系到学习目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 把“有价值”联系到学习目标：输入训练轨迹中的状态—动作对，以及少量成功验证示范。先用全部训练集学一个基础策略，再分别计算训练样本与验证样本使模型参数改变的方向，即梯度。如果两个方向一致，学习训练样本更可能同时改善验证行为（图 1）&lt;br&gt;&lt;br&gt;1. 把“有价值”联系到学习目标：严格影响函数包含表示损失曲率的 Hessian 逆矩阵。作者为降低成本，使用忽略该项的归一化梯度内积近似；高分是估计的有益方向，不是对删除数据后性能的精确因果测量（式 3–6）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_3_branch_1" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_3_field_2" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 为什么取最大值而不平均&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 为什么取最大值而不平均：一次抓取的接近、捏合、移动属于不同阶段。如果把全部验证梯度平均，互不相关的行为可能抵消。QoQ 对一个训练样本寻找最相符的验证样本，取最大内积，再对该训练轨迹所有时间步求均值。最后按轨迹分数选前 N 条，保留完整动作链&lt;br&gt;&lt;br&gt;2. 为什么取最大值而不平均：只挑高分帧容易留下大量抓住物体的瞬间，却丢掉到达物体或移走物体的过程。整轨迹筛选减轻这种阶段偏置，但也会把一条轨迹中的坏片段一起留下（§IV-B）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_3_branch_2" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1021.5" as="sourcePoint"/><mxPoint x="1942" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_3_field_3" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 算力与重新训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 算力与重新训练：作者只计算部分网络层的梯度，用 OPORP 随机投影压缩向量，尽量保留内积关系。仿真对 Transformer 模块计算，真机对 GR00T N1 动作头计算；后者使用流匹配损失梯度，而非声称能直接获得精确动作概率&lt;br&gt;&lt;br&gt;3. 算力与重新训练：流程：同步观察／动作轨迹 → 划出验证集 → 基础模型训练 → 梯度评分与整轨迹选择 → 微调或重训 → 独立部署评估。输出是数据子集和训练后的策略，不直接输出遥操作控制命令。筛选预算通常对应成功轨迹数；未知时作者取一半，并建议比较多个预算（第 4 页）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_3_branch_3" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1653.5" as="sourcePoint"/><mxPoint x="1942" y="1653.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_3_field_4" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 失败数据怎样利用&lt;/b&gt;&lt;br&gt;&lt;br&gt;没有额外专家验证集时，先运行策略，分别保留成功和失败 rollout。对成功参考的支持应加分，对失败参考的支持减分，并按验证样本量加权。失败轨迹因此既可作为被剔除的监督，也可提供负向判断依据；这不等于把失败动作原样当正确标签训练（§V-D）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2001" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_3_branch_4" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2198.0" as="sourcePoint"/><mxPoint x="1942" y="2198.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_4_field_1" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真使用 Robomimic 的易拉罐放置任务；真机是 Franka Research 3，包含香蕉抓取、多物体抓放与开柜。仿真训练 1000 epoch；真机 GR00T N1 用 LoRA 训练 2 万步，DROID 异质数据实验为 5 万步且不用 LoRA。相机型号、采集频率、端到端控制延迟和完整 GPU 预算在本文中未报告" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_4_branch_1" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_4_field_2" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;筛选指标与策略指标分开&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真候选为 100 成功＋100 失败，验证集 10 条成功；香蕉候选为 60 成功＋40 失败，另用 10 条成功验证。表 I 的筛选准确率按所选数据中来自成功轨迹的状态—动作对比例计算，QoQ 为 99.4%／83.6%，不是机器人部署成功率。文字有按轨迹描述的简写，回查以表注分母为准" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_4_branch_2" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="794.0" as="sourcePoint"/><mxPoint x="2632" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_4_field_3" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;筛选指标与策略指标分开&lt;/b&gt;&lt;br&gt;&lt;br&gt;图 2 中下游仿真成功率为 99.2%，最强对照 Flow Retrieval 为 76.0%，差 23.2 个百分点；真机香蕉为 86.7%，Behavior Retrieval 为 56.7%，差 30.0 个百分点。图注报告仿真 5 次、真机 3 次独立运行的均值和标准差，单次评估 rollout 数未明确报告，不能从百分比反推" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_4_branch_3" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1216.0" as="sourcePoint"/><mxPoint x="2632" y="1216.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_4_field_4" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;筛选指标与策略指标分开&lt;/b&gt;&lt;br&gt;&lt;br&gt;筛选指标与策略指标分开：多物体实验用四种物体各 20 条、合计 80 条成功示范，选择一半辅助香蕉目标任务，成功率 93.3%，全部数据为 56.7%。这些源数据原本都成功，说明目标相关性和组合也影响价值，不能简化成只删失败数据&lt;br&gt;&lt;br&gt;筛选指标与策略指标分开：DROID 的 200 条笔／铅笔轨迹中有 133 成功、67 失败，另有 20 条成功验证。图 4 的 78.2% 是筛选准确率，没有在这里报告新策略真机成功率。开柜借助策略反馈筛选，成功率 25.0%→43.3%（图 5）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="1441" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_4_branch_4" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1743.0" as="sourcePoint"/><mxPoint x="2632" y="1743.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_4_field_5" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;筛选指标与策略指标分开&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融中去掉最大影响评分或整轨迹选择，香蕉策略成功率分别降至 30.0%／26.7%，完整方法为 86.7%；预算改变也会改变结果，不能认为越少越好（图 6、表 III）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_4_branch_5" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2263.0" as="sourcePoint"/><mxPoint x="2632" y="2263.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_5_field_1" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者明确指出：整轨迹选择不能保留好片段而去掉坏片段；影响估计仍近似且昂贵；训练和验证默认同一本体，跨机器人还需扩展（第 7 页）&lt;br&gt;&lt;br&gt;不足与未来：本库分析：验证集决定了“好”的含义，偏向单一抓法可能排除有效少数策略。本文对照的验证处理也不完全一致：仿真 QoQ 去掉无区分力的接近阶段，而检索对照保留该阶段（第 4 页脚注），评价时应记住这一条件&lt;br&gt;&lt;br&gt;不足与未来：对 DH116，可先用既有仿真或离线日志训练小型行为克隆模型，比较随机选择、动作平滑阈值和梯度评分，按物体与采集批次隔离测试集。D435i 的图像不能替代关节、实际动作和时间戳；当前多轴联动未验收，不直接收集整手真机示范" vertex="1">
          <mxGeometry height="744" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_5_branch_1" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="512.0" as="sourcePoint"/><mxPoint x="3322" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_89_5_field_2" parent="paper_89" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;未来可研究接触阶段的片段选择，并给罕见但成功的纠正轨迹保留配额。需要先评估训练耗时、数据覆盖和闭环成功率，不能仅凭验证损失下降宣布抓取更可靠。官方代码已开放 robomimic 筛选流程，真机全栈与环境配置的可复现程度仍需单独验收" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_89_5_branch_2" edge="1" parent="paper_89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1109.0" as="sourcePoint"/><mxPoint x="3322" y="1109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
