        <mxCell id="paper_36_5_field_2" parent="paper_36" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：作者指出新增资产与操作需要标注，仿真对流体、柔性物体有限；含糊或动态变化目标也可能超出底层规划器能力" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_36_5_branch_3" edge="1" parent="paper_36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
