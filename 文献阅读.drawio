            <mxGeometry x="2160" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_88_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-89" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3086" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_88_1_field_1" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / Robotics: Science and Systems (RSS) 2025&lt;br&gt;引用量：待 Google Scholar 人工核验，不填写估计数量（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_1_branch_1" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_1_field_2" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_1_branch_2" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="752.0" as="sourcePoint"/><mxPoint x="562" y="752.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_1_field_3" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;DemInf（Demonstration Information Estimation）研究已经采来的示范如何按可学习性筛选。只看轨迹成功、长度或视觉多样性，会漏掉“同样观察下动作是否能预测”；只挑容易预测动作又可能全剩停顿。作者用状态与动作的 mutual information（互信息）兼顾动作多样性与条件可预测性，再通过低维表示和近邻估计，给完整轨迹排序。输入状态/图像与动作块，输出相对分数和筛选子集，之后单独训练 BC、ACT 或 Diffusion Policy（§III–V）" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_1_branch_3" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1219.5" as="sourcePoint"/><mxPoint x="562" y="1219.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_1_field_4" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;它在 robomimic 仿真、Franka、ALOHA 数据上多次提升人工质量分组和策略表现，但不是一套不依赖任务、动作表示和训练器的普适数据价值真值。关键前提是任务相关且成功的示范，长停顿要先处理；真机 PenInCup 上全数据略优于筛选，不能把摘要的5–10%写成所有场景保证" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1497" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_1_branch_4" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1694.0" as="sourcePoint"/><mxPoint x="562" y="1694.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_1_field_5" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：用观察和动作的统计关系筛选示范&lt;br&gt;DemInf 给轨迹估计相对信息分数，希望留下多样又能从观察推断动作的数据" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1919" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_1_branch_5" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2109.0" as="sourcePoint"/><mxPoint x="562" y="2109.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_2_field_1" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_2_branch_1" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_2_field_2" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_2_branch_2" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_2_field_3" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;视觉/语言筛选常用去重、聚类和预训练模型，可帮助覆盖却不看机器人动作标签。ReMix 调整数据群组权重，粒度太粗；相似性检索挑近目标样本，不必然判断单条示范好坏；需要人工质量标签的模型也无法直接无监督用于新数据。DemInf 直接度量状态—动作关系，无需人工标签训练评分器，人工标签仅用于评测（§II）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_2_branch_3" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1170.5" as="sourcePoint"/><mxPoint x="1252" y="1170.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_2_field_4" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;InfoNCE、MINE 是可学习互信息估计器，但同分布数据有限时方差大。KSG 近邻估计常用于低维统计，直接处理图像会受维数灾难影响。本文先用两个 VAE 压缩，再做非参数近邻，结合了适合小数据的距离统计与图像表示，而不是把 CLIP 相似度当机器人质量（§IV–V）" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_2_branch_4" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1610.0" as="sourcePoint"/><mxPoint x="1252" y="1610.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_2_field_5" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;互信息：衡量观察能提供多少关于动作的信息&lt;br&gt;视觉/语言筛选常用去重、聚类和预训练模型，可帮助覆盖却不看机器人动作标签；ReMix 调整数据群组权重，粒度太粗&lt;br&gt;InfoNCE、MINE 是从数据训练评分器来估计互信息的方法，小数据时分数可能波动较大。KSG 则根据附近样本的数量估计统计关系，但直接在高维图像上寻找近邻也不可靠" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="1835" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_2_branch_5" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2084.5" as="sourcePoint"/><mxPoint x="1252" y="2084.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_3_field_1" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 质量目标与隐含条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;互信息分解为 I(S;A)=H(A)−H(A|S)。第二项低意味着给定观察时动作更确定，减轻模式混合和操作员使用策略看不见信息的问题；第一项高避免只保留恒定不动的动作。但这依赖被观察状态是否包含必要任务信息。多种正确解法可能提高条件熵，低分不必然表示示范失败，策略容量也会改变多峰数据的可学性（§IV）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_3_branch_1" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_3_field_2" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 质量目标与隐含条件&lt;/b&gt;&lt;br&gt;&lt;br&gt;动作表示也会改变估计：相对末端位移、绝对关节目标和动作块不是同一个随机变量；相对动作在静止时集中、绝对动作可能直接编码当前状态。须固定单位、坐标、频率、夹爪语义和本体后再比较分数。本文未证明这些表征下排名不变，也没有把不同机器人分数校准为通用量尺，这是本卡对方法的使用边界" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_3_branch_2" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="811.5" as="sourcePoint"/><mxPoint x="1942" y="811.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_3_field_3" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. VAE 建立状态与动作表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;分别训练状态编码器和动作块编码器，使用尽可能小而能保留信息的潜变量。VAE 的各向同性高斯先验使欧氏距离更有意义；图像实验用 ResNet-18＋SpatialSoftmax，多个视角特征与状态拼接，不直接在原始像素做近邻。Franka 动作块四步，RoboCrowd 十步；图像分别缩至128×128，robomimic84×84。训练表征 Adam学习率10⁻⁴、batch256，状态五万步、图像十万步，三种子；使用 TPU Research Cloud，未报告可直接换算的统一消费级 GPU 总耗时（§VI-A）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_3_branch_3" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_3_field_4" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. KSG、轨迹平均与筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;在状态和动作联合潜空间找第 k 个近邻，用两子空间距离的最大值作联合度量；再分别数同半径内状态、动作邻居，通过 digamma 项估计每个样本对数据集互信息的相对贡献。常数项不影响同一数据集排序，但分数不是绝对“质量概率”。为减计算，随机打乱以1024样本批计算，遍历四次并对多个 k 平均（§V-B、附录 B/C）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_3_branch_4" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1830.5" as="sourcePoint"/><mxPoint x="1942" y="1830.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_3_field_5" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. KSG、轨迹平均与筛选&lt;/b&gt;&lt;br&gt;&lt;br&gt;先把逐样本分数截在1%–99%分位，抑制异常值，再在每条轨迹内取时间平均。已有成功示范/停顿处理 → 状态与动作 VAE → 随机批 KSG → 每帧贡献 → 轨迹平均 → 阈值筛选 → 下游策略训练与测试。 不能直接删低分帧：抓取时机本来比自由移动难预测，逐帧过滤可能删掉任务关键接触，轨迹平均正是为避免这点（图1–2、§V-C）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2073" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_3_branch_5" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2287.5" as="sourcePoint"/><mxPoint x="1942" y="2287.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_4_field_1" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、指标与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;robomimic MH 的 Lift、Can、Square 每任务三百条，better/okay/worse 各一百，质量为1/2/3；这是操作者组标签，不是逐帧专家真值。Franka 的 PenInCup六十条、DishRack八十条，半数由人故意加入掉物、绕行或抖动，质量0/1；用外部与腕相机。RoboCrowd 为 ALOHA 双臂真实新手众包，HiChew、TootsieRoll各四十条、HersheyKiss一百条，并比较含/不含无关play的版本，质量0–3（§VI-A、图3）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_4_branch_1" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_4_field_2" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、指标与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;图4–7横轴是移除轨迹数，纵轴是剩余数据人工平均质量。曲线好说明筛选更接近该标签，不能当策略成功率；图最右只剩约10%数据，也不代表建议如此激进删除。与 VIP、Compatibility、Uncertainty、InfoNCE、MINE 比较时，DemInf 在图像、小样本更稳定；不确定性适于主动补采，不一定适于离线保留高质量样本" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_4_branch_2" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="881.5" as="sourcePoint"/><mxPoint x="2632" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_4_field_3" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、指标与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;下游 robomimic 图像 BC 训练十万步，每个三种子各两百 rollout，共六百次；Can/Square比较不同删除量，Square MH1000再加七百条 Diffusion Policy 成功rollout。DemInf多种设置超过全数据，说明策略收益，但结果依赖过滤量与数据组成（图8）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_4_branch_3" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1321.0" as="sourcePoint"/><mxPoint x="2632" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_4_field_4" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、指标与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机删除50%，同时与全数据和随机保留50%比较；RoboCrowd训练ACT、每配置十次，以抓起、交还、开包装计1/2/3分；Franka训练Diffusion Policy、十五次二元成功。因此图9左侧不是成功率，右侧才是。DemInf优于随机子集，但 PenInCup 全数据稍好，且 VIP 在故意构造的低质 Franka 数据上也很强（图9及正文）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="1546" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_4_branch_4" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1760.5" as="sourcePoint"/><mxPoint x="2632" y="1760.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_4_field_5" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验、指标与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融显示一定范围 k 与潜变量维度、VAE β 较稳，KSG 比简单分开估熵或 BiKSG 更好。没有证明任何近邻统计都会奏效，也没有证明人工质量相关就必然带来同幅策略提升（图10–11、附录 A）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_4_branch_5" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2193.0" as="sourcePoint"/><mxPoint x="2632" y="2193.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_5_field_1" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确局限：时间动力学关联未充分建模；可预测停顿可能得高分；先打分再删是贪心，删除后分布和互信息会变；假定示范成功；多任务可能只保留容易任务，需分离任务条件（§VII-A/B）。因此它不能替代成功检测、任务标注或传感器完整性检查" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_5_branch_1" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="337.0" as="sourcePoint"/><mxPoint x="3322" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_5_field_2" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的推论：VAE 忽略细微接触会让近邻失真，多峰正确解法也可能被当噪声，分数对绝对/相对动作、采样率敏感。对 D435i＋DH116，先离线核对图像/状态/动作时间戳、停顿、丢帧、单位、三指耦合与成功标签，再在同任务同动作表示内试评分，并保留随机子集与全量对照。DH116六主动轴/十一总自由度不能按夹爪空间直接混入，左手仿真资产也不能代替右手标定" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_5_branch_2" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="794.0" as="sourcePoint"/><mxPoint x="3322" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_88_5_field_3" parent="paper_88" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足、当前平台复用与未来：当前整手/多轴仍锁定、根因未知，近期只做日志、运动学与仿真数据审计，不因高分就允许执行。评分不要求先买新手套或机械臂；后续扩大双臂数据才涉及额外硬件和标定。图像VAE与策略训练需要 GPU/云计算预算，可先用低维状态小集验证排名稳定性，再投入视觉训练与人工质量审核&lt;br&gt;&lt;br&gt;阅读要点与补充说明：作者明确局限：时间动力学关联未充分建模；可预测停顿可能得高分；先打分再删是贪心，删除后分布和互信息会变；假定示范成功；多任务可能只保留容易任务，需分离任务条件；因此它不能替代成功检测、任务标注或传感器完整性检查" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1054" as="geometry"/>
        </mxCell>
        <mxCell id="paper_88_5_branch_3" edge="1" parent="paper_88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1373.5" as="sourcePoint"/><mxPoint x="3322" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
