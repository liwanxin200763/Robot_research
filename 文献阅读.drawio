        <mxCell id="paper_54_1_field_2" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：Sim2Real（仿真到真实迁移）与 VLA（视觉—语言—动作模型：用图像与指令生成动作）。Zero-shot（零样本）在这里指目标控制训练用合成示范，部署前不使用目标任务真机动作数据微调，不代表没有基础模型和场景信息" vertex="1">
