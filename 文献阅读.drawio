          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_1_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：灵巧操作的数据采集与模仿学习（从人的示范学习怎样行动）。策略 Policy 是根据观察输出动作的规则或模型。这里先解决数据来源，再学习控制" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_1_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="700" as="sourcePoint"/>
            <mxPoint x="367" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_1_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="核心研究问题：人直接捏、拿、转动物体很快，机器人遥操作却慢。怎样同时记录手指、手腕和物体，再把这些人手动作变成机器人手的训练示范？" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_1_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="940" as="sourcePoint"/>
            <mxPoint x="367" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_1_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="之前方法的问题：只用相机追踪手会被物体遮挡；固定动捕设备不便搬动。人手与机械手的尺寸、关节也不同，直接复制人的关节角可能碰不到物体" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_drop" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="956" y="14" as="sourcePoint"/>
            <mxPoint x="956" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_header" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="B. 相关工作" vertex="1">
          <mxGeometry height="58" width="390" x="761" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_field_rail" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="88" as="sourcePoint"/>
            <mxPoint x="771" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="220" as="sourcePoint"/>
            <mxPoint x="783" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 1：遥操作让人控制机器人采示范，但受机器人速度限制。可穿戴动捕直接记录自然手部运动，仍需解决腕部漂移和环境信息缺失" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="460" as="sourcePoint"/>
            <mxPoint x="783" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="相关方向 2：行为克隆 Behavior Cloning（行为克隆，用示范的观察—动作配对模仿专家） 用示范中的“观察—动作”训练模型。人手数据要先重定向：把人的运动转换为目标机械手可执行的运动" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="700" as="sourcePoint"/>
            <mxPoint x="783" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="代表工作：UMI 用手持设备采操作；Diffusion Policy（扩散策略：反复去噪，生成连续动作）可学习多种动作。DexCap 把输入扩展到多指人手和三维场景" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_2_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="771" y="940" as="sourcePoint"/>
            <mxPoint x="783" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_2_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="与已有方法的区别：#25 DexUMI 更强调与机器人手一致的可穿戴接口。DexCap 用电磁手套记录手指，再配合腕部定位和三维相机；两者采集硬件和迁移途径不同" vertex="1">
          <mxGeometry height="220" width="368" x="783" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_drop" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1372" y="14" as="sourcePoint"/>
            <mxPoint x="1372" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_header" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="C. 核心贡献与方法" vertex="1">
          <mxGeometry height="58" width="390" x="1177" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_field_rail" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="88" as="sourcePoint"/>
            <mxPoint x="1187" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="220" as="sourcePoint"/>
            <mxPoint x="1199" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 1：把电磁手套、腕部定位相机和胸前深度相机组合成便携系统。手套测手指，腕部相机做同步定位与建图，深度相机记录物体，让遮挡下的手运动仍可追踪" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="460" as="sourcePoint"/>
            <mxPoint x="1199" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 2：用逆运动学（由指尖目标位置反求机械手关节角）将人手示范映射到 LEAP 手；把三维点云（空间中的采样点）与动作配对，训练 DexIL 扩散策略" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="700" as="sourcePoint"/>
            <mxPoint x="1199" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 3：允许人接管失败执行，补入纠正示范再训练。它补的是策略没见过的异常状态；这属于人在环的数据改进，并非机器人自动诊断和恢复" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_3_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1187" y="940" as="sourcePoint"/>
            <mxPoint x="1199" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_3_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="方法流程：人自然操作 → 同步记录手指/手腕/三维场景 → 映射为机械手动作 → 训练策略 → 真机执行 → 必要时人纠正 → 加入新示范继续训练" vertex="1">
          <mxGeometry height="220" width="368" x="1199" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_drop" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1788" y="14" as="sourcePoint"/>
            <mxPoint x="1788" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_header" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="D. 实验与结果" vertex="1">
          <mxGeometry height="58" width="390" x="1593" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_field_rail" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="88" as="sourcePoint"/>
            <mxPoint x="1603" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_branch_1" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="220" as="sourcePoint"/>
            <mxPoint x="1615" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_1" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="实验：六类真机灵巧任务，包括擦海绵、移球、递盘子以及更复杂的包装、剪切和泡茶。单项按最终任务是否完成计成功；基础比较每项20次" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="460" as="sourcePoint"/>
            <mxPoint x="1615" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对照：比较图像扩散策略、点云扩散策略及 DexIL，检查三维观察与人手重定向的作用。还比较加入纠正数据前后，不把采集速度和成功率混为一谈" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="700" as="sourcePoint"/>
            <mxPoint x="1615" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="结果：前三项完整成功率：擦海绵85%、移球60%、递盘子70%；论文报告平均72%，点云基线63%。说明这组条件下可用人手数据训练机械手操作" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_4_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1603" y="940" as="sourcePoint"/>
            <mxPoint x="1615" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_4_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="真机 / 关键补充：包装在加入30条纠正示范后完整成功率47%→57%；剪切仍约20%。采集效率约为遥操作3倍，表示示范收集速度，而非成功率提高3倍" vertex="1">
          <mxGeometry height="220" width="368" x="1615" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_drop" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2204" y="14" as="sourcePoint"/>
            <mxPoint x="2204" y="30" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_header" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2F1FA;strokeColor=#6F9DB8;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#294B61;align=center;verticalAlign=middle;spacing=10;editable=1;movable=1;resizable=1;shadow=0;" value="E. 不足与未来" vertex="1">
          <mxGeometry height="58" width="390" x="2009" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_field_rail" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="88" as="sourcePoint"/>
            <mxPoint x="2019" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_branch_2" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="220" as="sourcePoint"/>
            <mxPoint x="2031" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_2" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：论文讨论胸前视野可能丢失盒盖、指尖动作误差及缺少接触力信息。复杂精细任务仍明显失败，几何运动示范不能完整描述接触受力" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_3" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="460" as="sourcePoint"/>
            <mxPoint x="2031" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_3" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="我的理解 / 不足：我的判断：人的手能稳定夹住物体，不代表重定向后的机械手也能夹稳。只匹配指尖位置，可能漏掉摩擦、力和手指接触顺序" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_4" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="700" as="sourcePoint"/>
            <mxPoint x="2031" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_4" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="未来展望：可加触觉、接触检查与自动纠正示范筛选；分别评估“映射能执行”和“策略学会了”两个环节，定位失败来自数据还是学习" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_5_branch_5" edge="1" parent="paper_35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="940" as="sourcePoint"/>
            <mxPoint x="2031" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_35_5_field_5" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对我们项目的启发：可作为 DH116 数据采集方案参考。先测量手指结构、行程和指尖坐标，重做关节映射；论文 LEAP 手动作不能直接发给 DH116" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_fulltitle" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：DexCap: Scalable and Portable Mocap Data Collection System for Dexterous Manipulation" vertex="1">
          <mxGeometry height="180" width="285" y="162" as="geometry"/>
        </mxCell>
        <mxCell id="paper_35_authors" parent="paper_35" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者：Chen Wang; Haochen Shi; Weizhuo Wang; Ruohan Zhang; Li Fei-Fei; C. Karen Liu" vertex="1">
