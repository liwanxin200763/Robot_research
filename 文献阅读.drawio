            <mxGeometry x="2160" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_84_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-85" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_84_1_field_1" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2023 / CoRL 2023&lt;br&gt;引用量：待 Google Scholar 人工核验，不填写估计数量（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_1_branch_1" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_1_field_2" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_1_branch_2" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_1_field_3" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;BridgeData V2 研究如何采集能让其他实验室真正使用的机器人数据。单场景、单任务示范常使策略记住布景；想复用数据就要把任务、物体、相机和环境变化一起纳入采集。本文在低成本 WidowX 250 上构建含语言描述、目标图像、多环境的数据，并用六种离线学习方法验证。输入为 RGB 与目标图像或语言，输出末端相对位姿和夹爪动作；主要结论是指定策略能跨物体、环境及机构泛化，且数据规模、技能多样性、模型容量都重要（§1、§3–5）" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_1_branch_3" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1205.5" as="sourcePoint"/><mxPoint x="562" y="1205.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_1_field_4" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：总量 60,096 条是 50,365 条人类遥操作加 9,731 条脚本轨迹，不能全部写成专家示范。二十四环境、十三技能、一百多物体说明覆盖，但不自动等于任意灵巧操作数据质量。其对本项目的直接启发是低成本采集协议与数据组织，而非可下载即可控制 DH116 的通用动作模型&lt;br&gt;&lt;br&gt;阅读要点与补充说明：研究方向：建设多环境多任务机器人示范数据集&lt;br&gt;BridgeData V2 收集人类遥操作与脚本轨迹，并检验任务和场景多样性对训练的作用" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1483" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_1_branch_4" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1785.0" as="sourcePoint"/><mxPoint x="562" y="1785.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_2_field_1" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_2_branch_1" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_2_field_2" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_2_branch_2" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="738.0" as="sourcePoint"/><mxPoint x="1252" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_2_field_3" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;原 Bridge Data 强调跨域数据复用，但规模、技能和任务条件较窄；RT-1、BC-Z 显示多任务大数据潜力，却有专有机器人或单一环境限制。RoboNet 等脚本数据规模大，但动作与任务分布不同；RH20T 多平台、多传感器带来另一路径。本文选择公开、可购硬件，并把同一场景内多种可行任务同时采集，避免初始画面直接泄露要做的任务，让语言或目标条件成为必要信息（§2–3）" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_2_branch_3" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1188.0" as="sourcePoint"/><mxPoint x="1252" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_2_field_4" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与先前不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作与先前不足：技能与任务不能混算：pick-and-place 是技能，同一动作换物体或目的位置可构成不同语言任务；开关同一抽屉可归为一个技能。表 1 的跨数据集技能数使用作者重定义，不能拿来直接排名“谁更通用”。它也没有做多机器人联合采集，跨机构实验仍使用同类 WidowX&lt;br&gt;&lt;br&gt;阅读要点与补充说明：数据覆盖：训练记录包含多少不同物体、任务、视角和环境&lt;br&gt;原 Bridge Data 强调跨域数据复用，但规模、技能和任务条件较窄；RT-1、BC-Z 显示多任务大数据潜力，却有专有机器人或单一环境限制" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_2_branch_4" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1767.5" as="sourcePoint"/><mxPoint x="1252" y="1767.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_3_field_1" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 低成本系统与采集过程&lt;/b&gt;&lt;br&gt;&lt;br&gt;系统是六自由度 WidowX 250 机械臂与夹爪、固定肩后 D435 RGBD、两个随机摆位 Logitech C920 RGB、腕部 Raspberry Pi 相机，Meta Quest 2 控制器遥操作。论文当时整套约四千美元，不能当作当前报价。存图 640×480，控制 5 Hz；作者没有报告端到端延迟、独立相机硬件帧率或通用时钟同步误差，不能由 5 Hz推算这些值（§3.1、图 2、附录 C）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_3_branch_1" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_3_field_2" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 低成本系统与采集过程&lt;/b&gt;&lt;br&gt;&lt;br&gt;操作者在布置好的厨房或桌面做各种可行任务，不要求每段后复位物体和机械臂，也不要求采集时填任务名。每五十条改变随机相机位置、更换物体，并调整工作区相对机器人位置。事后众包观看轨迹，描述机器人正在做的任务，尤其移动物体的最终位置。这样减少现场标注成本，但语言正确性仍需单独审核（§3.2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_3_branch_2" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="846.5" as="sourcePoint"/><mxPoint x="1942" y="846.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_3_field_3" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 保留数据来源和传感器可用性&lt;/b&gt;&lt;br&gt;&lt;br&gt;随机脚本 pick-and-place 经常失败，作者仍保留以支持可能受益于次优数据的离线 RL；使用者可排除脚本子集。任务失败并不自动意味着一帧无信息，也不能未经验证把所有失败直接用于 BC。传感器逐步加入，很多早期数据只有固定相机，极少同时具四视角，深度也非全量；加载器应记录每条轨迹实际模态，不能把“系统有四相机”写成“全部样本都有四视角”（附录 A、图 6）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_3_branch_3" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_3_field_4" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 保留数据来源和传感器可用性&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据组织提供原始图像与状态文件，官方代码另支持 NumPy、TFRecord 或 RLDS/TFDS 转换。该项是当前仓库发布状态，非原论文提出的新质量清洗算法。原文没有通用异常轨迹评分、去重或自动动作修复流程，因此不能把可用格式等同于数据已清洁无误" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1581" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_3_branch_4" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1778.0" as="sourcePoint"/><mxPoint x="1942" y="1778.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_3_field_5" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 统一动作接口与不同训练方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;多环境遥操作/随机脚本 → 来源分开保存 → 事后语言标注 → 视觉与目标条件 → 离线训练 → 新物体/新环境/异机构评测。 动作七维，包括六维 Cartesian 相对位姿与离散夹爪开闭；不是 WidowX 的六个关节角，也不是多指手动作。主实验只用固定肩后 RGB，大部分方法 128×128，RT-1 为 320×256，深度和腕相机没有用于全部基线（§4）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="2003" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_3_branch_5" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2235.0" as="sourcePoint"/><mxPoint x="1942" y="2235.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_3_field_6" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 统一动作接口与不同训练方法&lt;/b&gt;&lt;br&gt;&lt;br&gt;GCBC 为 ResNet-34 加全连接动作头；D-GCBC 用条件扩散表达多峰动作；ACT 预测动作块；CRL 用目标条件价值学习；LCBC 以 MUSE 和 FiLM 融合语言；RT-1 用视觉与语言 token 预测离散动作。目标图像在训练时从同条轨迹未来时刻采样；图像增强含随机裁剪、缩放、颜色扰动。ACT 动作块减至五步匹配 5 Hz，单张 2080Ti 训练三天是这项配置的预算，不是所有六法的统一费用（附录 B）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2495" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_3_branch_6" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2744.5" as="sourcePoint"/><mxPoint x="1942" y="2744.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_4_field_1" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果：共八项 seen、六项 unseen 任务；每方法每任务十次，改变物体位置、干扰物与光照。目标图像法与语言法条件不同、RT-1 分辨率和历史也不同，因此表格不是纯架构公平消融（表 2–3）：&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：方法：GCBC；seen 平均：49%；unseen 平均：60%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：方法：D-GCBC；seen 平均：49%；unseen 平均：55%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：方法：ACT；seen 平均：41%；unseen 平均：28%" vertex="1">
          <mxGeometry height="674" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_4_branch_1" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="477.0" as="sourcePoint"/><mxPoint x="2632" y="477.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_4_field_2" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：方法：CRL；seen 平均：42%；unseen 平均：52%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：方法：LCBC；seen 平均：23%；unseen 平均：8%&lt;br&gt;&lt;br&gt;实验与结果 / 表中逐项记录：方法：RT-1；seen 平均：49%；unseen 平均：50%&lt;br&gt;&lt;br&gt;实验与结果：unseen 平均有时更高是任务集合不同，不说明遇见新物体更容易。RT-1 打开抽屉 10/10，却在部分物体任务 0/10；平均值隐藏较大差别。语言法对未见物体名 grounding 较弱，D-GCBC 的多峰切换会出现抖动，强表达模型也会忠实学到数据停顿（§5.1）" vertex="1">
          <mxGeometry height="709" width="628" x="2632" y="842" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_4_branch_2" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1196.5" as="sourcePoint"/><mxPoint x="2632" y="1196.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_4_field_3" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;跨机构三任务、仍每项十次，RT-1 平均从 0.47到0.40，GCBC 从0.30到0.13；没有 Lab 2 新数据微调。结论是有限零样本跨布景复用，不是任意机器人零样本迁移（表 4）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1579" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_4_branch_3" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1769.0" as="sourcePoint"/><mxPoint x="2632" y="1769.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_4_field_4" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验与结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;更有因果解释力的是近等数据量技能对照：三技能约 28k 与十三技能约 27k，在一个未见 pick-and-place 任务成功率由30%到65%，每策略二十次。它支持相关技能多样性有帮助，但样本小、单任务诊断，不是“多加任何技能都提高35个百分点”的定律。附录表 6 的 V1+PTR 到 V2 同时变规模与多样性，也不能拆成单一因素（图 5、附录 D）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1987" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_4_branch_4" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2219.0" as="sourcePoint"/><mxPoint x="2632" y="2219.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_5_field_1" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：任务多为低精度，不涵盖复杂力控、高动态、重物或低容差插装；数据来自单机构；单一可购机器人仍不保证其他实验室愿意采用，未来需多本体数据（§6）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_5_branch_1" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_5_field_2" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的推论：不要求每段复位会带来连续场景相关性，划分验证集应按场景/采集批次隔离；全部传感器缺失情况和语言核验也应单独记账。对 D435i 可先借用固定视角、每批次变化和分层标签，原文 D435 与本机 D435i 不能省略标定差异。DH116 六主动轴/十一总自由度和夹爪动作不兼容，先离线定义三指状态、耦合、时间戳与任务结果字段，不把七维控制直接套手" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_5_branch_2" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="780.0" as="sourcePoint"/><mxPoint x="3322" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_84_5_field_3" parent="paper_84" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、当前平台复用与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前整手/多轴仍锁定、根因未知，只能先进行日志、运动学与仿真核验。现有机械臂、腕相机、多视角和双臂需另行设备与标定，不能从本卡推断已完成验收。近期可低成本做同场景多任务与摄像机变化的采集协议演练；真正训练大范围视觉策略需 GPU、人工标注与数据存储预算。要先验证数据错误率和观测可预测性，再据本机闭环表现决定扩采" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_84_5_branch_3" edge="1" parent="paper_84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1272.0" as="sourcePoint"/><mxPoint x="3322" y="1272.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
