        </UserObject><UserObject id="paper_121_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-64" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_121_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-122" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_121_1_field_1" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与时间&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题：MobiAgent: Dual-Loop Recursive Policy Self-Improvement for Long-Horizon Mobile Manipulation。Liu、Zhang、Lin共同贡献，Lin为项目负责人，Zhongrui Wang和Xiaojuan Qi通讯；机构为香港大学、Astribot、南方科技大学。年份 / Venue：CoRL 2026，本地34页PDF有会议标识。官方https://arxiv.org/abs/2610.03476确认首次公开2026年10月2日，仅列v1；未另造更新日期。标题与canonical卡匹配，引用量未核验。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_1_branch_1" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="389.5" as="sourcePoint"/><mxPoint x="562" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_1_field_2" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景、具体问题与目标能力&lt;/b&gt;&lt;br&gt;&lt;br&gt;移动操作要交替导航、抓取、携物与精确放置，长程错误会累积，单一动作头还可能在底盘移动与手臂控制间容量干扰。已有层级系统常把每个整子任务映射到独立策略，失败后难重新组合，部署经验也少回流训练。本文目标同时包含执行中的空间感知恢复与部署后的策略改善：内循环根据观察与失败重规划原子技能，外循环自动整理真实执行片段，再离线训练技能策略。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_1_branch_2" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="899.0" as="sourcePoint"/><mxPoint x="562" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_2_field_1" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;前人机制与模块边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;单体π0/π0.5把语言视觉直接映射成连续动作块，短任务强，但没有独立的语义任务记忆。层级plan-execute-verify用高层模型调用技能并检查结果，若技能是整任务专用，就难在失败后插入接近、重新抓取等细步骤。本文将pick、place、move_to等动作语义作为可复用原子技能，不同对象和房间共享同一种动作专家；共享不代表把所有控制模式塞入同一个输出头。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_2_branch_1" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_2_field_2" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;双循环和学习机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;内循环为部署时Planner→Executor→Critic的状态闭环，改变下一子任务与动作条件；外循环在episode结束后整理数据、做行为克隆更新权重。它不是仅靠语言反思提升，也不是GRPO按0/1回报直接做策略梯度。启动时仍需领域数据：仿真合成/遥操作示范，真机有人类遥操作。所谓无需人工标注指自动切片和赋标签，不是从零无人采集或不依赖任何人工初始化。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_2_branch_2" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_3_field_1" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;内循环：规划输入输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;Planner接收总目标、当前多相机观察、episode记忆H和技能目录S，输出下一条简短自然语言子任务ℓk及skill hint sk。记忆包含已执行子任务、检查结论和空间偏差线索；计划按滚动时域重算，在前技能完成或失败时触发。提示可输出剩余plan sketch，但当前执行只激活下一项。目录是开放词汇接口，执行器仍需已有对应技能专家，并非高层随便写新动词就能立即获得控制能力。" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_3_branch_1" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="372.0" as="sourcePoint"/><mxPoint x="1942" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_3_field_2" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;内循环：共享主干与动作专家&lt;/b&gt;&lt;br&gt;&lt;br&gt;Executor基于π0.5。共享PaliGemma/Gemma-2B视觉语言主干处理指令和当前观察，每个canonical skill有独立Gemma约300M的流匹配动作专家。skill hint路由到相应头，输出短动作块；相同pick技能跨任务重用，移动与手臂动作又可分头专门化。BEHAVIOR仿真6技能为move_to、pick_up、place_in、place_on、open、close；S1真机5技能以pour替代开关门。专家均从公开π0.5检查点初始化后在切分数据上训练。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_3_branch_2" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="881.5" as="sourcePoint"/><mxPoint x="1942" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_3_field_3" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;内循环：视觉反馈与确定性调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;每执行C个动作块，Critic读取当前子任务及三帧间隔观察窗口，输出complete/incomplete/error、next/retry/replan以及可观察证据。合法组合受schema限制：complete必须next，error必须replan；格式违规按error处理。调度器在未完成且未超重试计数时继续当前技能；完成或需要重规划则暂停低层交回Planner，所有线索写入H。超过重试上限也触发全局重规划。全局恢复能加入先靠近掉落物再抓取等新步骤，区别于原地重复同一技能。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_3_branch_3" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1408.5" as="sourcePoint"/><mxPoint x="1942" y="1408.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_3_field_4" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;外循环：切片、验证、聚类&lt;/b&gt;&lt;br&gt;&lt;br&gt;Data Curator先以视频VLM找阶段边界并描述片段，先区分纯移动再识别操作类型；另一VLM核查时序连续、技能相邻关系和目标指令一致性，错误片段返回修边界或指令。启动数据经LLM语义聚类，按动作意图而非对象/房间命名，做覆盖检查并统一动词。部署新片段不再重聚类，而直接分配到已有技能目录。表S1多数提示模块为GPT-5.4，视频切分为Gemini-3.1-Pro；这只是论文实验所用配置，不外推为当前产品规格。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_3_branch_4" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1935.5" as="sourcePoint"/><mxPoint x="1942" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_3_field_5" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;外循环：真实权重更新与边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;Skill Trainer在启动时按技能数据做行为克隆，建立共享主干加专用专家；之后用经验证的部署轨迹离线继续微调已有策略，不扩展模型库存。主文摘要“发现技能”与广义持续演化，应放在这一启动建库和后续固定目录细化的实现边界内理解。成功rollout回收改善数据分布，但不是把所有失败片段直接当成功训练。真机冻结视觉主干，4张A100、batch240、2万步、学习率5e-5；BEHAVIOR为8张A100、batch480、5万步、1e-4。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_3_branch_5" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2462.5" as="sourcePoint"/><mxPoint x="1942" y="2462.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_4_field_1" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真任务、成功率与轮次&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboCasa365 Composite-Seen有16个家庭任务、每项2–15子任务，Franka加Omron底盘，目标场景各5次。π0.5基线7.50%，MobiAgent R1为18.75%、R3最高27.50%，R4–R6为25.00/27.50/26.25%；不能只写单调上升，后期已经饱和波动。BEHAVIOR-1K用OmniGibson/Galaxea R1 Pro，选四任务，每任务10次固定重置、BDDL终态判定；224×224 RGB、32维动作。π0.5-TA平均42.5%，本文65.0%，绝对增加22.5个百分点。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_4_branch_1" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="389.5" as="sourcePoint"/><mxPoint x="2632" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_4_field_2" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机平台、采集与改善&lt;/b&gt;&lt;br&gt;&lt;br&gt;Astribot S1有移动底盘、4DoF躯干、双7DoF臂及头部，含头、胸和双腕相机；相机30Hz，动作由机载全身控制器以20Hz跟踪，不混淆两者。每任务100条VR遥操作示范，4项为纸/垃圾、瓶、罐投放及向杯中倒蓝色颗粒；每任务每方法10次。单体π0.5平均10%，MobiAgent初始32.5%，后续每轮每任务约20条自动整理部署轨迹，R2为40%、R3为57.5%。这区分了层级建模收益10→32.5和外循环收益32.5→57.5。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_4_branch_2" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="916.5" as="sourcePoint"/><mxPoint x="2632" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_4_field_3" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融与恢复证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;BEHAVIOR四任务完整65%；固定任务专属子任务、无动态规划版本20%；单共享动作头42.5%；无Critic10%；有验证但忽略replan只局部重试40%。最后一项最直接支持全局重规划价值。成功episode中39%至少重规划一次，平均0.95次，上限3次；它是成功轨迹条件统计，不是所有失败都有39%恢复率。案例包括罐掉在垃圾桶外后重新靠近、抓取、放置，或修正底盘姿态再抓取。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_4_branch_3" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1426.0" as="sourcePoint"/><mxPoint x="2632" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_4_field_4" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;运行与数据整理成本&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录同800片段、同遥操作原始数据，人工按2倍速回放估约28.9小时，自动API整理约0.82小时、35倍加速，排除模型训练和示范采集；不能称总训练成本减少35倍。成功rollout端到端时间：push-radio 179秒对基线60秒，dispose-trash715对249，stack-storage1454对525，fetch-beer1556对538；本文API时间分别98/381/747/792秒，是主要瓶颈。表中动作时间不含渲染，失败episode未纳入这些均值。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_4_branch_4" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1935.5" as="sourcePoint"/><mxPoint x="2632" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_4_field_5" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;细粒度瓶颈与额外本体&lt;/b&gt;&lt;br&gt;&lt;br&gt;条件于执行已到达的技能实例，真机pick70%、place_in94.73%、pour50%，不等于独立随机起点技能测试；move_to100%同样有筛选条件。附录还报告Unitree R1D家务任务R1成功20%对π0.5的0%，是额外有限本体证据，不能据此声称任意本体迁移。论文未给全部轮次API费用、总GPU小时或无人工干预的长期小时级稳定性；安全干预有日志但此处没有足够统一量化支撑。" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="2213" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_4_branch_5" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2445.0" as="sourcePoint"/><mxPoint x="2632" y="2445.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_5_field_1" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限与失败机制&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者明确技能扩展可能干扰旧行为，建议LoRA/持续学习；内循环有姿态来回修正、放置恢复不准、遮挡下critic漂移。附录分四类：Critic提前判完成；双臂缺少显式伙伴状态约束导致不同步；技能达成局部目标却以不合适姿态结束，使下一技能分布外；透明物体与空间计量不准。倒颗粒和双臂取瓶的失败说明高层重规划无法自动补足低层感知与接触控制能力。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_5_branch_1" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="372.0" as="sourcePoint"/><mxPoint x="3322" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_121_5_field_2" parent="paper_121" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分析推断 / 研究启发&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析推断：固定目录回收成功片段可能强化已会技能，罕见失败或真正新技能仍缺可学习数据；VLM既生成又验证标签也可能共享偏差。研究启发：区分未完成、暂时遮挡与不可恢复错误，记录Critic校准与误报；把下一技能的可达前置条件加入结束检查，测试过渡重置/重定向动作。评价外循环应同时画旧技能保持、新技能新增、采样成本和失败分布，避免只看最高轮次。建议尚未在本机运行。" vertex="1">
          <mxGeometry height="464" width="628" x="3322" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_121_5_branch_2" edge="1" parent="paper_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="864.0" as="sourcePoint"/><mxPoint x="3322" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
