            <mxGeometry x="3180" y="3186" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_75_1_field_1" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2024 / IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS) 2024&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_1_branch_1" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_1_field_2" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：GELLO研究如何以不到300美元的单个主端设备，降低高质量机械臂示范的采集门槛。它不是从摄像头猜手势，而是把目标机器人缩小成可手动拖动的同构机械模型，读取每个关节角直接发给从臂。主要证据是新手用户对比实验和跨三种机械臂的能力展示，不是训练了一个跨平台通用策略（§I、IV）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_1_branch_2" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="881.5" as="sourcePoint"/><mxPoint x="562" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_1_field_3" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：用与目标臂相似的小型主手采集遥操作示范&lt;br&gt;GELLO 把人拖动模型臂的关节角直接映到目标臂，降低示范采集的上手难度" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_1_branch_3" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1419.0" as="sourcePoint"/><mxPoint x="562" y="1419.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_2_field_1" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强&lt;br&gt;&lt;br&gt;相关工作：3D鼠标和VR把人类动作转换成末端空间命令，设备通用，但用户通常看不见机械臂内部关节约束；末端可达不等于中间连杆不会自碰。ALOHA以实际主臂复制从臂关节，保留此几何关系，却需要再买完整机械臂。GELLO留下编码器、连杆与阻尼，删去主端的大负载执行能力，因而降低成本（§II）" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_2_branch_1" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="459.5" as="sourcePoint"/><mxPoint x="1252" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_2_field_2" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_2_branch_2" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="997.0" as="sourcePoint"/><mxPoint x="1252" y="997.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_2_field_3" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：双向触觉系统能把从端接触信息传回主端，但需要更强执行器、力传感和稳定控制；GELLO选择单向命令。它的关节阻力和橡皮筋恢复力让人感到主端构型，不能称为真实接触力反馈。其贡献是开放、易复制的工程框架和受控用户研究，同构遥操作思想本身并非新提出（p2）&lt;br&gt;&lt;br&gt;阅读要点与补充说明：遥操作：人实时控制机器人，并据执行结果继续调整动作&lt;br&gt;3D鼠标和VR把人类动作转换成末端空间命令，设备通用，但用户通常看不见机械臂内部关节约束；末端可达不等于中间连杆不会自碰" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_2_branch_3" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1534.5" as="sourcePoint"/><mxPoint x="1252" y="1534.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_3_field_1" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 运动学复制，关节直通&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 运动学复制，关节直通：先取得目标臂的Denavit–Hartenberg参数，保持关节轴与拓扑，用比例α缩短连杆；实验α=0.5。主端每个关节与从端一一对应，读取主端角度后发为从端关节命令，不求末端IK。对七自由度Panda和xArm，用户能直接安排冗余关节，而不只移动夹爪位置（p3–4，图1、4）&lt;br&gt;&lt;br&gt;1. 运动学复制，关节直通：“同构”指每款臂配自己的几何模型，不是一台固定GELLO无需改装便能控制任何机器人。UR5、Franka Panda和uFactory xArm7是论文提供的三种实例；换一种臂需要重新设计连杆、配置关节映射与软件适配层" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_3_branch_1" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="459.5" as="sourcePoint"/><mxPoint x="1942" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_3_field_2" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 用编码器和被动结构降低负担&lt;/b&gt;&lt;br&gt;&lt;br&gt;DYNAMIXEL XL330系列有12-bit编码器，机械角分辨率约0.088°；作者选择XL330-M288-T，利用减速与反拖阻力给运动阻尼。12-bit是编码器读数能力，不是从臂末端实际精度。3D打印件把舵机连接成模型，现成舵机同时解决轴承、封装和通信问题（§III）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_3_branch_2" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1004.0" as="sourcePoint"/><mxPoint x="1942" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_3_field_3" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 用编码器和被动结构降低负担&lt;/b&gt;&lt;br&gt;&lt;br&gt;主端若完全被动，肘部易因重力下垂，造成不利构型甚至碰桌。作者给主要承重的关节加弹簧或橡皮筋，在UR结构为第二、三关节，形成Joint Regularization（关节恢复约束）。图3测得无恢复结构时抵抗重力需约1.9 N；加入后不同高度的力随构型改变。它不是软件把所有抖动滤掉，也不保证无碰撞（图2–3）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_3_branch_3" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1443.5" as="sourcePoint"/><mxPoint x="1942" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_3_field_4" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 标定、通信与记录边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;信号链为“人拖动模型→主端编码器角→零位／方向对应→目标臂API→从臂”。论文用DYNAMIXEL Python API读取，通过ZMQ进程通信，分别调用各臂接口。官方软件文档提供同一已知构型下的零位偏置和关节符号配置；复现应记录这些量、时间戳、主端目标及从端实际状态，避免把装配差异当作示范动作（p4；仓库Configuration）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1686" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_3_branch_4" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1900.5" as="sourcePoint"/><mxPoint x="1942" y="1900.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_3_field_5" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 标定、通信与记录边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;论文主实验没有给统一端到端延迟分布、控制／相机／存储频率，也没有定义所有机器人共用的视觉录制布局、训练格式或策略损失。这些应列为平台适配事项，不能从当前仓库默认参数反推2024论文实验已经如此运行。控制器BOM少于300美元是单台主端，不含从臂、夹爪、计算机、相机和场景支架，双主端约为两份设备" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="2143" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_3_branch_5" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2357.5" as="sourcePoint"/><mxPoint x="1942" y="2357.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_4_field_1" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;用户研究协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;12名没有专业遥操作训练的大学志愿者，用双UR5分别体验GELLO、Meta Quest2控制器和两只SpaceMouse，完成挂帽子、开盒取眼罩、双臂交香蕉、折毛巾和插USB五项任务。先6分钟通用说明，再给每设备5分钟练习；六种设备顺序各出现两次，降低先后学习影响（p4–5，§IV-A）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_4_branch_1" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_4_field_2" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;用户研究协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户研究协议：挂帽限时45秒，其余90秒；发生自碰、环境碰撞等不可恢复失败就终止。研究同时记录成功率、失败类别、成功试次的完成时间。每设备共60个任务试次，不能把每任务仅12人的比例当成大规模数据集基准&lt;br&gt;&lt;br&gt;用户研究协议 / 表中逐项记录：设备：GELLO；Hat：0.92；Mask：0.92；Banana：1.00；Towel：0.92；USB：0.83；表中平均：0.92&lt;br&gt;&lt;br&gt;用户研究协议 / 表中逐项记录：设备：3D Mice；Hat：0.75；Mask：0.58；Banana：0.67；Towel：0.58；USB：0.58；表中平均：0.63" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_4_branch_2" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="916.5" as="sourcePoint"/><mxPoint x="2632" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_4_field_3" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;用户研究协议 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户研究协议 / 表中逐项记录：设备：VR；Hat：0.92；Mask：0.83；Banana：0.75；Towel：0.58；USB：0.50；表中平均：0.72&lt;br&gt;&lt;br&gt;用户研究协议：GELLO平均约92%，VR72%、3D鼠标63%，差值为20和29个百分点；表中数值经过四舍五入，不应据此反推更多有效位数（p5，表II）&lt;br&gt;&lt;br&gt;失败与效率应一起读：表III按五任务聚合，GELLO超时1、自碰1、环境碰撞3；3D鼠标分别9、6、6，另2次其他失败；VR分别5、5、6，另1次其他失败。GELLO也发生碰撞，因此“能感知同构约束”不是安全认证。图6的用时只统计成功试次，不能忽略失败后直接声称单位小时产量已被严格测量（p6）" vertex="1">
          <mxGeometry height="709" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_4_branch_3" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1618.5" as="sourcePoint"/><mxPoint x="2632" y="1618.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_4_field_4" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败与效率应一起读&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者展示三种臂、双臂及接触任务，如取放、倒水、制作食物等，支持设备兼容性的存在性证据。没有对每项展示提供同等次数的成功率，也没有用同一策略在不同机械臂上测试。论文并未开展“GELLO数据训练策略优于VR数据”的受控下游学习实验，这一点决定结论只能到采集接口层面" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="2001" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_4_branch_4" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2215.5" as="sourcePoint"/><mxPoint x="2632" y="2215.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_5_field_1" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出：主端电机扭矩有限，没有从端力反馈，接触密集任务仍受限；用户实验只有短时训练的新手，熟练操作员可能改变对比，应进一步研究长期学习曲线（§V）" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_5_branch_1" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="330.0" as="sourcePoint"/><mxPoint x="3322" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_5_field_2" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;我的理解：拓扑绑定和比例放大让“通用框架”不等于“通用一台硬件”，手持末端小误差仍可能变成大臂位移。当前DH116的6主动轴与11总自由度是手内耦合，不能把机械臂同构复制直接套成五指等角复制。先离线做拇指／食指／中指的耦合约束、零位与指尖可达性，再验证日志与映射；多轴控制尚未验收" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_5_branch_2" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="762.5" as="sourcePoint"/><mxPoint x="3322" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_75_5_field_3" parent="paper_75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：D435i可作为采集时外部观测，GELLO并不依赖其深度估计人体腕位姿；若以后接机械臂或双臂，还需各自同构主端与碰撞限制。最小复用是编码器式输入抽象、目标／实测双记录与标定配置；全硬件预算还需从臂和夹爪，不能仅按300美元估算整套实验&lt;br&gt;&lt;br&gt;对自己的实验怎样落地：可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_75_5_branch_3" edge="1" parent="paper_75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1324.5" as="sourcePoint"/><mxPoint x="3322" y="1324.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
