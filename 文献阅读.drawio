        <mxCell id="paper_107_5_field_rail" edge="1" parent="paper_107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="108" as="sourcePoint"/><mxPoint x="3310" y="1306" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_107_fulltitle" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：&lt;br&gt;DemoBot: Efficient Learning of Bimanual Manipulation with Dexterous Hands From Third-Person Human Videos" vertex="1">
          <mxGeometry height="380" width="480" y="190" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_107_authors" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="作者：&lt;br&gt;Xu, Yucheng、Mao, Xiaofeng、Miller, Elle、Yi, Xinyu、Li, Yang、Li, Zhibin、Fisher, Robert B." vertex="1">
          <mxGeometry height="380" width="480" y="598" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_107_pdf" parent="paper_107" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地 PDF：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;01 论文文库\&lt;br&gt;PDFs\&lt;br&gt;03_双臂协作\&lt;br&gt;DemoBot.pdf" vertex="1">
