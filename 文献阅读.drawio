        <mxCell id="paper_112_3_field_rail" edge="1" parent="paper_112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
