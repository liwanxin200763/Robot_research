        <mxCell id="paper_54_3_field_1" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="贡献 1：从任务、历史观察和目标物体信息预测可供性链，过滤无关背景。链中的每个目标表示当前步骤要实现的关键交互位置与动作关系" vertex="1">
