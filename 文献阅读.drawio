        <mxCell id="paper_48_5_branch_2" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="220" as="sourcePoint"/>
            <mxPoint x="2031" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_2" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：论文讨论输入人手轨迹噪声、物体建模和实际硬件限制；物体关节或形状估计错误时，物理优化的目标也可能不正确" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_5_branch_3" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="460" as="sourcePoint"/>
            <mxPoint x="2031" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_3" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="我的理解 / 不足：我的判断：仿真中的接触参数与 DH116 真机摩擦不同，即使动作能跟随，物体仍会滑；需要将真实接触反馈加入修正" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="350" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_5_branch_4" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="700" as="sourcePoint"/>
            <mxPoint x="2031" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_4" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="未来展望：用真机触觉和物体状态校准残差，生成失败后重新握紧或换接触点的示范，把迁移从正常动作延伸到异常恢复" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="590" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_5_branch_5" edge="1" parent="paper_48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2019" y="940" as="sourcePoint"/>
            <mxPoint x="2031" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="paper_48_5_field_5" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="对我们项目的启发：适合 DH116 的双手示范迁移参考。先训练适合自身关节结构的跟随器，再单独学习接触残差；不能直接复制其他手型的关节动作" vertex="1">
          <mxGeometry height="220" width="368" x="2031" y="830" as="geometry"/>
        </mxCell>
        <mxCell id="paper_48_fulltitle" parent="paper_48" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#24435A;align=left;verticalAlign=middle;spacing=8;editable=1;movable=1;resizable=1;shadow=0;" value="完整标题：MANIPTRANS: Efficient Dexterous Bimanual Manipulation Transfer via Residual Learning" vertex="1">
