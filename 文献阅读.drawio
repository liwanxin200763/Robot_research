        </UserObject><mxCell id="detail_67_heading" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#24435A;align=left;verticalAlign=middle;spacingLeft=26;" value="#67 SafeBimanual">
          <mxGeometry x="120" y="138" width="4060" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="detail_67_summary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=18;" value="05 双臂与 Multi-Agent 协作  ·  本类第 8 / 16 篇  ·  对预训练双臂策略做测试时轨迹修正；RoboTwin 八任务平均成功率约提升 13.7 个百分点，Galaxea R1 四项真机任务提升 32.5 个百分点，但不保证绝对安全">
          <mxGeometry x="120" y="256" width="4060" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67" parent="1" style="group;container=1;collapsible=0;recursiveResize=0;resizable=1;rotatable=0;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="2700" width="4000" x="140" y="450" as="geometry"/>
        </mxCell>
        <mxCell id="paper_67_title" parent="paper_67" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#C9E4F5;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=16;editable=1;movable=1;resizable=1;shadow=0;" value="#67 SafeBimanual" vertex="1">
          <mxGeometry height="140" width="480" y="30" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_67_title_branch" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="100" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_67_rise" edge="1" parent="paper_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="14" as="sourcePoint"/><mxPoint x="510" y="100" as="targetPoint"/></mxGeometry>
