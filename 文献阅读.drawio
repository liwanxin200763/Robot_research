            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_12_bottomnav_1" label="返回分类" link="data:page/id,literature-page-02" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_12_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-11" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_12_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-13" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_12_1_field_1" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / arXiv 预印本；正式录用信息未核验&lt;br&gt;引用量：37（沿用本地记录，未重新查询）&lt;br&gt;研究方向：02 记忆与时间建模" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_1_branch_1" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_1_field_2" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：当前画面可能无法区分已经完成与尚未完成的步骤，机器人需要把过去的重要事件带到现在。保存全部历史代价很高，保存太少又可能漏掉关键动作，因此记忆方法同时面对信息选择、时间顺序和计算开销的问题&lt;br&gt;&lt;br&gt;研究背景：当前帧可能无法表明物体是否已移动或目标是否曾被遮挡；多帧有帮助，但把全部图像 token 送入 VLM 会显著增加训练和推理成本。（论文第 1 节）&lt;br&gt;&lt;br&gt;论文要解决的问题：让已有 VLA 有效接收固定窗口的历史视觉上下文，同时维持接近单帧模型的计算量和推理延迟。（第 1、3 节）" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_1_branch_2" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_1_field_3" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;直接拼接 8 帧令牌开销高；只看当前帧会丢失长程任务阶段信息；过度池化历史又可能损失可操作细节。（第 2–3 节）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_1_branch_3" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1440.0" as="sourcePoint"/><mxPoint x="562" y="1440.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_1_field_4" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：VLA（视觉—语言—动作模型，把图像和指令变成机器人动作），多帧上下文，部分可观测任务，高效时间建模&lt;br&gt;核心研究问题：如何让 VLA 利用多帧历史解决部分可观测任务，同时避免视频输入造成巨大的训练和推理计算开销&lt;br&gt;之前方法的问题：单帧观测无法确定任务历史状态，直接输入完整多帧又显著增加 token（模型处理文字或图像时使用的小信息单元） 数量，训练速度和实时推理效率受到影响" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1658" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_1_branch_4" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1925.0" as="sourcePoint"/><mxPoint x="562" y="1925.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_2_field_1" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：历史窗口直接给模型最近几帧，记忆模块则把更久以前的信息压缩、检索或更新。二者都能提供过去线索，但是否帮助任务，要看同一当前画面下过去事件不同的测试；仅增加参数也可能改变表现，需注意对照&lt;br&gt;&lt;br&gt;与已有工作的关系：比直接多帧输入更省算力；与 HAMLET 的 moment token 外部记忆相比，ContextVLA 在 VLM 中间层压缩历史；与 MEM 的长短期双层记忆不同，它重点是摊销式视觉窗口。（第 2–3 节；跨论文比较）" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_2_branch_1" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_2_field_2" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_2_branch_2" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="927.0" as="sourcePoint"/><mxPoint x="1252" y="927.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_2_field_3" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：传统多帧行为克隆，通过过去观测解决部分可观测问题&lt;br&gt;相关方向 2：基于预训练 VLM（视觉语言模型，联合理解图像与文字） 的 VLA，例如 π0，π0-FAST，GR00T N1.5&lt;br&gt;代表工作：π0，π0-FAST，GR00T N1.5&lt;br&gt;与已有方法的区别：不让整个 VLM 在后续所有层持续处理全部历史 token，而是在中间层把历史压缩成一个 context token，保留当前帧细节同时降低多帧计算成本" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1145" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_2_branch_3" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1412.0" as="sourcePoint"/><mxPoint x="1252" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_3_field_1" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：把历史帧在 VLM 中间层汇聚为紧凑的 context token，保留当前帧的完整视觉令牌，借助因果注意力和 KV cache 复用过去计算。（第 3 节）&lt;br&gt;&lt;br&gt;方法与系统结构：8 帧图像进入视觉编码器和 VLM；论文默认在第 2 个 VLM block 后对每帧历史 token 平均池化，形成历史 context token，并保留当前帧高分辨率 token。因果掩码允许过去表征预计算，动作头仍由原底座承担。（第 3 节、图 2）" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_3_branch_1" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="407.0" as="sourcePoint"/><mxPoint x="1942" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_3_field_2" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：任务语言及当前／历史多帧视觉观测；具体底座可有自己的机器人状态接口，本文的核心增量是视觉历史压缩，不应称其为通用 Proprioception 记忆法。（第 3 节）&lt;br&gt;&lt;br&gt;输出 / 动作表示：兼容 π0、π0-FAST 与 GR00T 等底座；动作生成沿用底座的自回归或 flow-matching 头，并非新的统一动作表示。（第 3–4 节）&lt;br&gt;&lt;br&gt;数据处理与数据增强：关键处理为历史视觉令牌池化、因果注意力和缓存；额外数据增强并非论文主要贡献，未单独报告统一方案。（第 3–4 节）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_3_branch_2" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1021.5" as="sourcePoint"/><mxPoint x="1942" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_3_field_3" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;在既有 VLA 上微调多帧上下文，仿真设置报告 60k 更新、batch 32。需要模型适配和训练，不是 TTF-VLA 式免训练推理插件。（第 4 节）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_3_branch_3" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1559.0" as="sourcePoint"/><mxPoint x="1942" y="1559.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_3_field_4" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：提出高效多帧 VLA 框架，让现有 VLM backbone 能真正利用连续历史观测&lt;br&gt;贡献 2：在 VLM 中间层把所有历史帧隐藏特征压缩成一个 context token，即在上几层中取几层压缩，同时完整保留当前观测表示&lt;br&gt;贡献 3：结合历史压缩与 KV cache 降低训练和推理成本，并支持自回归或扩散式动作生成&lt;br&gt;方法流程：多帧历史与当前图像 → VLM 前层提取特征 → 中间层压缩历史为单个 context token → 保留当前帧表示 → 动作解码器生成动作" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_3_branch_4" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2061.5" as="sourcePoint"/><mxPoint x="1942" y="2061.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_4_field_1" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据来源与采集方式：仿真使用 LIBERO、SimplerEnv-WidowX（Bridge v2）与 RoboCasa；真机三类任务各收集 50 条演示。（第 4 节）&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：LIBERO 40 项任务、SimplerEnv-WidowX、RoboCasa 24 项任务和三类真机任务；比较单帧、直接多帧和压缩多帧方案。（第 4 节，表 1–4）&lt;br&gt;&lt;br&gt;真机实验：覆盖 Clench/Unclench、PnP Twice、CoverNStack 等需要历史信息的任务，每项 20 次测试；报告在 CoverNStack 上 π0 完整 8 帧和单帧均为 45%，ContextVLA 为 60%。（第 4 节）" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_4_branch_1" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="459.5" as="sourcePoint"/><mxPoint x="2632" y="459.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_4_field_2" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;LIBERO 中 π0 94.6%→96.5%，π0-FAST 93.4%→95.8%，GR00T 95.9%→97.0%；SimplerEnv 中 π0 41.8%→56.2%，π0-FAST 59.0%→70.7%；RoboCasa π0 57.0%→58.7%（第 4 节，主结果表）。8 帧训练比直接完整多帧快 5.5 倍，推理延迟 227.2 ms→96.3 ms（压缩加缓存）。（效率表）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="807" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_4_branch_2" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1021.5" as="sourcePoint"/><mxPoint x="2632" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_4_field_3" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;消融实验&lt;/b&gt;&lt;br&gt;&lt;br&gt;消融实验：SimplerEnv 中压缩 context token 的相关消融从 49.0% 提升到 56.2%；第 2 个 VLM block 是论文测试中的最佳压缩位置。缓存进一步降低延迟。（第 4 节）&lt;br&gt;&lt;br&gt;Failure Case：论文未单列系统失败案例；部分底座在个别 SimplerEnv 任务并非全面提高。实验不等于证明模型可检测执行错误后自主恢复。（第 4 节）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_4_branch_3" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1513.5" as="sourcePoint"/><mxPoint x="2632" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_5_field_1" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：主要建模固定长度视觉窗口，未给出分钟级语义记忆或显式失败原因表示；额外微调成本仍在。论文未在结论中给出独立作者局限章节，以上为文献库分析。（第 3–5 节）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：给执行阶段视觉历史接入现有 VLA 提供效率基线，但若目标是错误诊断与恢复，还需要监督信号或反馈闭环。（第 4 节；文献库分析）" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_5_branch_1" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_12_5_field_2" parent="paper_12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：例如历史中发生：抓取失败↓调整↓再次抓取↓物体滑落这些事件全部压在一个表示里，模型能利用多少取决于训练是否真的学出来重点是多帧上下文的高效利用，没有建立持续数分钟的长期语义记忆&lt;br&gt;我的理解 / 不足：单个 context token 非常高效，但强压缩可能损失历史中的关键事件和细粒度失败信息&lt;br&gt;未来展望：研究自适应历史长度，多尺度历史表示，以及短期视觉上下文与长期事件记忆结合&lt;br&gt;对我们项目的启发：失败检测不一定需要保存完整视频，可以先把最近执行过程压缩成上下文表示，再结合当前视觉和机器人状态判断是否发生执行异常" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_12_5_branch_2" edge="1" parent="paper_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="969.0" as="sourcePoint"/><mxPoint x="3322" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
