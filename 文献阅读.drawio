          <mxGeometry height="429" width="480" y="1006" as="geometry" x="0"/>
        </mxCell>
        <mxCell id="paper_17_code" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;08_数据与遥操作\&lt;br&gt;RDGen - Demonstration Generation f&lt;br&gt;or High-Quality Robot Learning via R&lt;br&gt;einforcement Learning.md&lt;br&gt;&lt;br&gt;开源信息：本地 PDF：查看 PDF" vertex="1">
          <mxGeometry height="534" width="480" y="1463" as="geometry" x="0"/>
        </mxCell>
        <UserObject id="paper_17_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_17_bottomnav_1" label="返回分类" link="data:page/id,literature-page-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_17_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-16" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_17_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-18" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3286" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_17_1_field_1" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本（尚未核验到正式会议或期刊）&lt;br&gt;引用量：引用量来源：Google Scholar（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_1_branch_1" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_1_field_2" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;研究背景：VLA 训练依赖高质量、可执行机器人轨迹；遥操作扩张昂贵且动作标签可能不平滑。论文尝试把 RL 策略当成数据生成器。（全文 §1–2）&lt;br&gt;&lt;br&gt;论文要解决的问题：能否在仿真训练低层 RL 技能、迁移真机并批量收集成功轨迹，让下游模仿策略比使用少量遥操作示范学得更好。（§1、§3）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_1_branch_2" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="881.5" as="sourcePoint"/><mxPoint x="562" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_1_field_3" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;之前方法存在的问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;纯遥操作成本高且轨迹有抖动；单纯将 RL 当最终控制器不能直接扩大 VLA 的监督数据；Sim2Real 还存在感知和接触差异。（§1–2）" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_1_branch_3" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1419.0" as="sourcePoint"/><mxPoint x="562" y="1419.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_1_field_4" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：先在仿真用强化学习（靠反复尝试和奖励改进动作）练技能，再把成功过程交给看图读指令并出动作的 VLA（视觉—语言—动作模型，把图像和指令变成机器人动作） 学&lt;br&gt;核心问题：能否不用反复请人遥控，就生成平滑、真机也能执行的抓放示范，帮助 π0 学动作？&lt;br&gt;之前的问题：人工遥控采数据慢且动作可能抖；只把强化学习当最终控制器，也没有扩充 π0 的示范库" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1637" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_1_branch_4" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1886.5" as="sourcePoint"/><mxPoint x="562" y="1886.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_2_field_1" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;与已有工作的关系：与以 RL 策略直接部署的工作不同，RDGen 将成功 RL 执行转为下游 VLA 训练数据；与纯遥操作比较的是生成轨迹的平滑性和监督效益，而非新 VLA 架构。（§2–4）" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_2_branch_1" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_2_field_2" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;IL：模仿学习，从示范学习动作&lt;br&gt;SAC：一种通过奖励学习连续动作的强化学习算法&lt;br&gt;IK：逆运动学，根据目标位置和朝向反求关节角" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_2_branch_2" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="986.5" as="sourcePoint"/><mxPoint x="1252" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_2_field_3" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：人遥控机器人录示范，模型照着学；真实数据可靠，但大量收集很费时间&lt;br&gt;相关方向 2：仿真强化学习让机器人反复试，按成功和动作质量给奖励，再迁移到真机&lt;br&gt;代表工作：SAC（软演员评论家，一种用奖励训练策略的强化学习算法） 是训练技能的强化学习算法；Grounding DINO 定位物体；π0 是下游动作模型&lt;br&gt;区别：强化学习不是最终产品策略，而是先产出示范；再看这些示范是否帮 π0 学得更好" vertex="1">
          <mxGeometry height="534" width="628" x="1252" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_2_branch_3" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1531.0" as="sourcePoint"/><mxPoint x="1252" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_3_field_1" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：VLM 解析语言任务并核验进度，Grounding DINO 与 RGB-D 把物体定位到三维，SAC 技能执行抓取/放置，保留成功且平滑的 rollout 作为 π0 训练示范。（§3，图 1–2）&lt;br&gt;&lt;br&gt;方法与系统结构：Planner 输出技能及物体/目标查询；Verifier 根据观测更新结构化任务进度记忆；检测框提升到三维目标，仿真训练的 SAC 低层策略在真机执行。RL 奖励含接近目标、接触/完成和偏离直线路径惩罚，失败、桌面碰撞、IK 错误会提前终止重置。（§3.2–3.5）" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_3_branch_1" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_3_field_2" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;输入信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入信息：语言指令、RGB-D 图像、对象查询、目标三维坐标、末端位姿与任务进度；低层 RL 观测是目标位置、末端位置及正负四元数构成的 14 维向量。（§3.2–3.5）&lt;br&gt;&lt;br&gt;输出 / 动作表示：高层输出原子技能及对象/目标描述；低层输出末端笛卡尔位置与姿态增量，经 IK 转为机器人运动；收集的数据是观测、状态/目标、指令与动作序列，不是模型直接生成语言化动作 token。（§3.1、§3.4）" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_3_branch_2" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="986.5" as="sourcePoint"/><mxPoint x="1942" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_3_field_3" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据处理与数据增强&lt;/b&gt;&lt;br&gt;&lt;br&gt;只收成功、物理可执行的轨迹；路径偏差奖励鼓励平滑，模拟训练加入末端位置 5 mm 和四元数扰动，正负四元数排序应对姿态表示跳变。文中说可变化光照、物体姿态、相机和场景，但未以量化实验报告 state coverage、action diversity 或 task diversity；数据质量实测指标为成功率、mean jerk 与下游 π0 成功率。（§3.4–3.6、§4）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_3_branch_3" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1478.5" as="sourcePoint"/><mxPoint x="1942" y="1478.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_3_field_4" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;Isaac Sim 中以 SAC 训练低层抓取/放置技能；成功 rollout 用于训练下游 π0 策略。附录 A 表 2 报 RL 学习率 1e-4、batch 256、gradient steps 16、temperature 0.2；π0 使用其原配置。文中没有按数据边际效用给轨迹加权。（§3.4、§4、附录 A）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1721" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_3_branch_4" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1918.0" as="sourcePoint"/><mxPoint x="1942" y="1918.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_3_field_5" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：先由视觉语言模型分解指令，用深度相机定位物体；再用 SAC 训练抓、放低层动作&lt;br&gt;贡献 2：奖励既看是否完成任务，也看目标距离、路径偏差；碰撞、逆运动学失败和绕远路会扣分&lt;br&gt;贡献 3：只保存成功且机器能执行的尝试过程；把这些轨迹用作 π0 的训练数据&lt;br&gt;流程：读指令→找目标→在仿真反复练抓放→筛成功且平滑的动作过程→用它们训练 π0" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="2143" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_3_branch_5" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2392.5" as="sourcePoint"/><mxPoint x="1942" y="2392.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_4_field_1" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据来源与采集方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;Isaac Sim 中以随机初始目标和重置收集成功 RL rollout，再在 Marvin M6CCS 臂、Ruiyan RY-H2 灵巧手及 Gemini 435Le 相机上执行。比较实验各取 20 条遥操作或 RDGen 轨迹；论文没有给出总生成数据集规模、每轨迹人力/算力成本。（§3.6、§4、附录 A）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_4_branch_1" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="337.0" as="sourcePoint"/><mxPoint x="2632" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_4_field_2" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Benchmark 与实验设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;Benchmark 与实验设置：真实桌面抓取灰色方块或饮料罐并放入纸盒，以 20 条轨迹估计 mean jerk，以不同初始位置的 10 次测试测量下游 π0 成功率；基线为相同数量的人工遥操作轨迹。（§4，表 1）&lt;br&gt;&lt;br&gt;真机实验：灰色方块到纸盒的 RL 执行 20/20 次首次成功；真机采集轨迹和下游 π0 测试均已报告，但只覆盖很少任务与试验次数，不能推断开放场景可靠性。（§4.1–4.2、图 3、表 1；附录 A）" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_4_branch_2" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="829.0" as="sourcePoint"/><mxPoint x="2632" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_4_field_3" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要实验结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要实验结果：方块任务 mean jerk：遥操作 2.68±0.41，RDGen 0.47±0.02 m/s³；π0 成功率 60%→80%。饮料罐任务：5.59±2.44→0.57±0.06 m/s³，π0 成功率 70%→100%；成功率每组只测 10 次，均见表 1。（§4.2）&lt;br&gt;&lt;br&gt;消融实验：论文报告遥操作与 RDGen 的数据源对照，但未报告逐一去除 VLM、Grounding DINO、RL 奖励项、平滑约束或仿真扰动的完整消融。（§4）" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_4_branch_3" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1373.5" as="sourcePoint"/><mxPoint x="2632" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_4_field_4" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;Failure Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练中把桌面碰撞、目标异常移动、IK 反复失败等设为终止条件；正文没有给出真机逐类失败数量或失败恢复的系统统计。不能把 Planner/Verifier 机制直接解释成已验证的真机长时恢复能力。（§3.4、§4）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_4_branch_4" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1841.0" as="sourcePoint"/><mxPoint x="2632" y="1841.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_5_field_1" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主要局限&lt;/b&gt;&lt;br&gt;&lt;br&gt;主要局限：作者指出当前偏向粗粒度抓放，细致折叠、拧螺钉等需要毫米级精度和精心设计的奖励。库内分析：任务数与评测次数少，缺少覆盖率、轨迹多样性、采集成本及复杂长程任务验证。（§5）&lt;br&gt;&lt;br&gt;对当前研究方向的价值：可借鉴“先用 RL 生成可执行示范，再用 IL/VLA 吸收”的数据闭环；若用于失败恢复，仍需检验失败轨迹是否能提供纠错信号，而本文主要筛掉失败轨迹。（§3–5）" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_5_branch_1" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_5_field_2" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出精细折叠等毫米级任务仍难；接触很细时需更精确的动作和奖励设计&lt;br&gt;我的理解 / 不足：只测少量抓放任务，π0 成功率每组仅 10 次；还不清楚生成数据是否足够多样&lt;br&gt;未来展望：测试更复杂接触任务，也量化生成轨迹覆盖多少情况；失败轨迹能否帮助恢复尚未验证&lt;br&gt;对我们项目的启发：可先生成 DH116 的平滑抓放示范；失败过程另存，连同失败前状态研究补救" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_5_branch_2" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_17_5_field_3" parent="paper_17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对自己的实验怎样落地&lt;/b&gt;&lt;br&gt;&lt;br&gt;可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="394" width="628" x="3322" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_17_5_branch_3" edge="1" parent="paper_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1426.0" as="sourcePoint"/><mxPoint x="3322" y="1426.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
