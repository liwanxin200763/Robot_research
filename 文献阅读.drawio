        <mxCell id="paper_41_5_field_2" parent="paper_41" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="作者指出的不足：作者指出执行误差会破坏预测，错误预测又可能误导动作，形成连锁问题；可用视频训练的规模仍有限，泛化需继续验证" vertex="1">
