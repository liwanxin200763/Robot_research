        <mxCell id="paper_139_code" parent="paper_139" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A7C5D6;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24435A;align=left;verticalAlign=top;spacing=22;editable=1;movable=1;resizable=1;shadow=0;" value="本地论文卡：&lt;br&gt;D:\&lt;br&gt;Robot\&lt;br&gt;_Research\&lt;br&gt;03 论文卡片\&lt;br&gt;03_双臂协作\&lt;br&gt;You Only Teach Once - Learn One-Sh&lt;br&gt;ot Bimanual Robotic Manipulation fr&lt;br&gt;om Video Demonstrations.md&lt;br&gt;&lt;br&gt;开源信息：项目主页https://hnuzhy.github.io/proj&lt;br&gt;ects/YOTO；未独立验证代码可下载性" vertex="1">
