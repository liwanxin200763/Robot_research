        <UserObject id="paper_54_bottomnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_54_bottomnav_1" label="返回分类" link="data:page/id,literature-page-07" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_54_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-53" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_54_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-71" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_54_1_field_1" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / ICLR&lt;br&gt;引用量：12（沿用本地记录，未重新查询）&lt;br&gt;研究方向：07 VLA 基础与泛化" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_1_branch_1" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_1_field_2" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配&lt;br&gt;&lt;br&gt;论文定位：这篇论文属于 VLA 方向，主要讨论纯合成数据训练的 VLA 在真实场景中容易受到外观和动力学差异影响。&lt;br&gt;核心思路是Sim2Real-VLA 只用合成数据训练通用控制模型，并研究仿真技能迁移到真实操作。&lt;br&gt;与当前项目的联系：项目联系：直接关联双臂普通夹爪、VLA 或真机操作" vertex="1">
          <mxGeometry height="674" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_1_branch_2" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="885.0" as="sourcePoint"/><mxPoint x="562" y="885.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_1_field_3" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：纯合成数据训练的 VLA 在真实场景中容易受到外观和动力学差异影响&lt;br&gt;&lt;br&gt;为什么重要：直接对应双臂 Sim2Real 与合成/真实数据配比问题" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1250" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_1_branch_3" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1447.0" as="sourcePoint"/><mxPoint x="562" y="1447.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_1_field_4" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：Sim2Real（仿真到真实迁移）与 VLA（视觉—语言—动作模型：用图像与指令生成动作）。Zero-shot（零样本）在这里指目标控制训练用合成示范，部署前不使用目标任务真机动作数据微调，不代表没有基础模型和场景信息&lt;br&gt;核心研究问题：仿真画面与真实背景、物体材质不同，直接学动作容易失效。能否以物体关键交互为中间目标，让模型关注任务必要运动而不是环境外观？&lt;br&gt;之前方法的问题：只提高仿真画面逼真度成本高；端到端策略容易依赖背景。长任务若不检查前一步完成，后续动作会在错误现场继续执行" vertex="1">
          <mxGeometry height="604" width="628" x="562" y="1672" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_1_branch_4" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1974.0" as="sourcePoint"/><mxPoint x="562" y="1974.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_2_field_1" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：VLM 主要理解图像和文字，VLA 进一步学习输出动作；预训练、目标任务微调和部署时调整是不同阶段。比较通用模型时应保留训练数据预算、目标机器人示范数和测试变化条件，避免只按模型大小判断泛化&lt;br&gt;&lt;br&gt;之前方法的问题：仿真里学到的操作技能并不自动具备真机零样本泛化" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_2_branch_1" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="389.5" as="sourcePoint"/><mxPoint x="1252" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_2_field_2" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Domain Randomization：域随机化，训练时主动改变场景和物理条件以增加覆盖&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLM：联合理解图像和文字的模型&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_2_branch_2" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="881.5" as="sourcePoint"/><mxPoint x="1252" y="881.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_2_field_3" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：Domain Randomization（域随机化）改变仿真背景、材质和布局，减少对单一外观依赖；仍要解决控制真正需要哪些物体信息&lt;br&gt;相关方向 2：Affordance（可供性）是物体允许如何交互，例如杯柄可抓、瓶可倾倒。本篇把它落实为一串与操作相关的几何关键点/末端目标&lt;br&gt;代表工作：与 ACT、扩散策略、RDT、π0、GR00T 等仿真训练基线比较。#36 HumanoidGen 主要生成约束与数据；本篇还设计规划、执行和完成验证&lt;br&gt;与已有方法的区别：上层预测可供性链，下层执行对应动作；双臂执行模块参数分开但联合训练。它有双臂结构，却没有语言模型多代理辩论机制" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_2_branch_3" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1443.5" as="sourcePoint"/><mxPoint x="1252" y="1443.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_3_field_1" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：Sim2Real-VLA 只用合成数据训练通用控制模型，并研究仿真技能迁移到真实操作&lt;br&gt;&lt;br&gt;输入：官方摘要给出任务/数据类型；具体模型张量与接口需核对方法章节&lt;br&gt;&lt;br&gt;输出与动作：官方摘要未明确列出完整控制接口；需核对论文方法或代码&lt;br&gt;&lt;br&gt;方法概览：任务输入 → Sim2Real-VLA 只用合成数据训练通用控制模型，并研究仿真技能迁移到真实操作 → 官方摘要未明确列出完整控制接口；需核对论文方法或代码&lt;br&gt;&lt;br&gt;把语义规划与连续执行分开：Sim2Real-VLA 先由高层规划器推断一串可执行关系，说明与哪些对象以什么次序交互；低层执行器在 token 化动作空间中落实动作并验证进展。高层减少与操作无关的视觉细节，低层处理运动关键变化，目的是降低仿真图像与真实外观差异对控制的影响" vertex="1">
          <mxGeometry height="849" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_3_branch_1" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="564.5" as="sourcePoint"/><mxPoint x="1942" y="564.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_3_field_2" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;合成技能如何接到真实部署&lt;/b&gt;&lt;br&gt;&lt;br&gt;自动数据生成提供技能训练轨迹，模型仅使用合成数据训练，再在真实双臂、灵巧和长时任务中评估迁移。零样本指该评测没有目标真机任务微调，不代表不需要目标硬件模型、感知接口和动作解码。若迁到 DH116，要另核主动轴和接触约束，不能把仿真训练成功当成本机执行验收" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="1017" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_3_branch_2" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1214.0" as="sourcePoint"/><mxPoint x="1942" y="1214.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_3_field_3" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：从任务、历史观察和目标物体信息预测可供性链，过滤无关背景。链中的每个目标表示当前步骤要实现的关键交互位置与动作关系&lt;br&gt;贡献 2：低层执行器跟踪目标，左右臂各用相关观察与目标；动作经频域压缩再编码为符号。完成验证器判断当前目标是否达到，没达到则继续当前步骤&lt;br&gt;贡献 3：自动扩展仿真场景与技能轨迹，配合域随机化训练。论文训练用合成控制数据，但真实场景投影等先验仍可能参与环境构建，不能称完全无真实信息&lt;br&gt;方法流程：任务+物体观察 → 规划可供性目标链 → 低层左右臂分别执行 → 检查当前目标完成 → 未完成继续/调整 → 完成后切下一目标 → 真机反馈循环" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_3_branch_3" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1758.5" as="sourcePoint"/><mxPoint x="1942" y="1758.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_4_field_1" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：合成操作轨迹与真实机器人评测；具体任务见项目页&lt;br&gt;&lt;br&gt;主要结果：作者项目页报告多种真实操作任务的零样本迁移；完整数值和硬件条件仍需正文核验&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：合成操作轨迹与真实机器人评测；具体任务见项目页&lt;br&gt;&lt;br&gt;实验与结果：主要结果：作者项目页报告多种真实操作任务的零样本迁移；完整数值和硬件条件仍需正文核验" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_4_branch_1" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="442.0" as="sourcePoint"/><mxPoint x="2632" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_4_field_2" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：测试灵巧、双臂及长任务，在仿真与真机分别报告；真实倒水、交接、篮子放置、开锅放物等，每任务20次，不自行汇总统一成功率&lt;br&gt;对照：与同样仿真训练的多种动作策略比较，并考察背景、位置、物体和桌面变化。这里的泛化范围是论文指定任务与扰动，不是任意新技能&lt;br&gt;结果：真机单臂倒水17/20，π0基线6/20；双臂倒水16/20，基线5/20。表示完整完成相应任务的次数，支持该设置下合成技能迁移&lt;br&gt;真机 / 关键补充：更长的交接8/20、篮子放置9/20、开锅放物7/20，明显低于简单倒水。背景等变化再测20次；不能只引用较高任务数字称真机普遍稳定" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_4_branch_2" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1091.5" as="sourcePoint"/><mxPoint x="2632" y="1091.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_4_field_3" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1439" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_4_branch_3" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1636.0" as="sourcePoint"/><mxPoint x="2632" y="1636.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_5_field_1" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：直接关联双臂普通夹爪、VLA 或真机操作&lt;br&gt;&lt;br&gt;主要局限：本段基于官方摘要；未覆盖全文失败案例、完整 Baseline 与方法消融&lt;br&gt;&lt;br&gt;局限与启发：主要局限：本段基于官方摘要；未覆盖全文失败案例、完整 Baseline 与方法消融" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_5_branch_1" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_54_5_field_2" parent="paper_54" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：结论将多代理、更开放交互环境和强化学习持续改进列为未来方向；长任务表中仍有大量失败，完成验证并未消除所有累计误差&lt;br&gt;我的理解 / 不足：我的判断：可供性位置不等于接触力，物体遮挡和状态估计错可能让验证器误判。零真机动作微调的范围需要严格说明&lt;br&gt;未来展望：把触觉完成判据和显式恢复接入子目标循环；测试仿真摩擦/重量差与真实滑落，区分感知、物理和规划失效&lt;br&gt;对我们项目的启发：可作为 DH116 的 Sim2Real 方案参考：仿真生成手物交互、可供性子目标、执行后检查。需重建手指动力学和动作接口，并验证真机接触差异" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_54_5_branch_2" edge="1" parent="paper_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
