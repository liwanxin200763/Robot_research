            <mxGeometry x="1140" y="3986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_113_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-70" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="3986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_113_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-119" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_113_1_field_1" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待核验；来源为 Google Scholar，未经人工查看不填写数字（沿用本地记录，未重新查询）&lt;br&gt;研究方向：06 动作建模与控制&lt;br&gt;数据链条位置：跨本体意图模型与物理控制器连接" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_1_branch_1" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_1_field_2" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人策略最终要输出连续动作，既要完成任务，也要及时响应观察。动作表示、预测时长和底层执行接口会改变结果；一次输出长动作段更省推理，但若场景变了又不更新，也可能把偏差持续执行下去&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;GitHub / 开源程度：见本卡“来源与核验边界”；未核实不视为代码已完整开放&lt;br&gt;版本查询与全文核验日期：2026-10-15&lt;br&gt;&lt;br&gt;研究方向与快速摘要：本篇的核心是把“想让物体怎样变化”与“这台机器人怎样驱动关节”分开学习。人类视频负责学习任务意图，仿真负责学习适合目标机器人的控制；部署时反复读取真实场景，更新短时意图，避免一直执行最开始生成、后来已经失效的计划（§1、§3）" vertex="1">
          <mxGeometry height="744" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_1_branch_2" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_1_field_3" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;Object Flow（物体流）描述物体表面查询点未来的位置，不是物体类别标签；Embodiment-agnostic（不依赖某种机器人结构）在这里指高层意图接口不包含特定手的关节。低层控制仍按本体训练，不能写成一个网络直接控制所有手" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_1_branch_3" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1531.0" as="sourcePoint"/><mxPoint x="562" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_2_field_1" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：扩散与流匹配从简单噪声逐步生成动作，回归直接预测动作值，规划方法还显式检查约束。这些方法的比较要同时看输入、控制频率、动作块长度和计算时间；较短模型推理时间不必然等于完整系统低延迟&lt;br&gt;&lt;br&gt;相关工作：从视频提取完整手物轨迹的路线，如 DexImit、DexMan，保留示范动作细节，但会承担重建噪声和人手机器手差异。LUCID 只监督短时物体流与粗略掌姿，控制器自己在仿真学习怎样接触和移动，目标是跨场景重新预测任务进展，而非逐帧复刻整段动作（§2）" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_2_branch_1" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_2_field_2" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transformer：利用注意力关联图像、文字或时间信息的网络&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;PPO：一种通过多次交互奖励稳定更新策略的强化学习算法" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_2_branch_2" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="969.0" as="sourcePoint"/><mxPoint x="1252" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_2_field_3" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关工作：视频生成规划器可以从初始画面想象完整计划，但如果一次抓取失误或物体移动，旧计划不再对应真实状态。本文对照用 Veo 3.1 初始生成视频提取一次参考，与 LUCID 共享低层控制器，区别在高层参考来源与更新方式；不是比较两个完全独立硬件系统&lt;br&gt;&lt;br&gt;相关工作：Video2Sim2Real用特定视频关键帧及点云蒸馏；LUCID 从更多视频学可重查询意图，用一次训练的任务无关控制器执行。两者都用仿真，但数据规模、可重用范围和感知接口不同" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_2_branch_3" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1513.5" as="sourcePoint"/><mxPoint x="1252" y="1513.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_3_field_1" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 从视频学习物体流和掌姿&lt;/b&gt;&lt;br&gt;&lt;br&gt;对互联网任务每类筛选约 2 万视频片段，少数任务另采约 100 段手机示范。ViPE 恢复相机、深度；SAM 3.1 分物体和人；DenseTrack3Dv2 跟踪物体点并用深度转成三维；WiLoR 恢复人手 MANO，再按深度刚性对齐得到掌姿。不需要动作标签不等于不做三维处理（§3.1）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_3_branch_1" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="337.0" as="sourcePoint"/><mxPoint x="1942" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_3_field_2" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 从视频学习物体流和掌姿&lt;/b&gt;&lt;br&gt;&lt;br&gt;意图模型改造 CoTracker3 点 token Transformer：冻结 DINOv3 图像特征，用残差 adapter 融合深度；由最近观察预测未来，而不是跟踪已经看到的全部帧；在物体点 token 旁加入掌姿 token。以未来点位置、掌位置和旋转误差监督，并大量扰动人手像素，减少部署时换成机器人手的外观影响（图 2）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_3_branch_2" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="776.5" as="sourcePoint"/><mxPoint x="1942" y="776.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_3_field_3" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 从视频学习物体流和掌姿&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 从视频学习物体流和掌姿：输入是近期 RGB-D 观察、当前物体查询点和掌姿，输出约 1 秒短时参考；不输出特定 DH116 手指角度。意图包含掌姿，是因为仅要求物体去某处没有说明手该从哪里接触&lt;br&gt;&lt;br&gt;2. 按本体训练可追参考的控制器：在 Isaac Lab 程序化生成几何物体和接近、手中移动、到达目标、脱离四段参考，不依赖每个任务的视频轨迹作为 RL 训练集。随机化形状、尺寸、质量、摩擦和动作目标，用任务无关奖励跟踪物体、掌姿和接触，同时惩罚过大动作及不安全关节配置（§3.2）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_3_branch_3" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1321.0" as="sourcePoint"/><mxPoint x="1942" y="1321.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_3_field_4" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 按本体训练可追参考的控制器&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 按本体训练可追参考的控制器：教师用仿真完整物体表面、真实状态与关节速度；学生只用外部相机可见点、腕部深度和自身关节信息。特权状态指真机拿不到但仿真可直接读出的信息；蒸馏让学生模仿教师，再结合自身 PPO 交互优化，不是把真机不可用的物体全表面状态偷偷作为部署输入（图 3）&lt;br&gt;&lt;br&gt;2. 按本体训练可追参考的控制器：控制输出包含机械臂关节增量、eigen-grasp（协同抓取基）的系数和逐手关节残差：先沿常见协同抓法探索，再补细节。关节目标积累到上一目标，平滑并限幅后送 PD 控制器。协同基需针对目标手重新适配，不能直接转成 DH116 通道" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_3_branch_4" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1970.5" as="sourcePoint"/><mxPoint x="1942" y="1970.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_3_field_5" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 慢意图、快反馈形成闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 慢意图、快反馈形成闭环：部署用固定外部 RGB-D 和腕部深度相机，意图模型每秒刷新一次；物体点跟踪约 30 Hz，控制器 50 Hz。每轮重新分割、采点、预测未来参考，转换到机器人基座坐标；两轮之间按实时点追踪和腕部深度执行，并向前推进参考窗口（§3.3、附录 B.8）&lt;br&gt;&lt;br&gt;3. 慢意图、快反馈形成闭环：闭环意味着执行后观察真实结果再调整下一段，能够对抓空或物体变化重新给方向；但物体滑落桌外等不可恢复状态仍失败。论文没有通用故障诊断、恢复动作库和回退验证流程，不能以“闭环”替代完整 Failure Recovery 的实证" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="2318" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_3_branch_5" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2620.0" as="sourcePoint"/><mxPoint x="1942" y="2620.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_3_field_6" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 慢意图、快反馈形成闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整流程：非结构化视频 → 相机／深度／物体点与人掌姿监督 → 意图模型；程序化仿真 → 本体教师 RL → 感知学生蒸馏＋RL；真机 RGB-D 历史 → 新物体流与掌姿 → 本体学生控制器 → 平滑关节目标 → 最新观察再查询" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="2950" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_3_branch_6" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="3140.0" as="sourcePoint"/><mxPoint x="1942" y="3140.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_4_field_1" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机任务、平台和对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;UR5e + LEAP Hand，另有平行夹爪本体。网络视频监督搅拌、擦拭、放入容器三任务，每任务 3 个未见场景、每场景 10 次，共各 30 次；变化同时涉及物体、桌面和相机。搅拌按完成三圈、擦拭按清除表面、收纳按放入目标容器判任务结果，任务终止条件不可跨技能简单统一（§4.1、附录）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_4_branch_1" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_4_field_2" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机任务、平台和对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;真机任务、平台和对照：闭环平均成功率作者汇总为 73%，一次生成计划的开环对照为 28%，差 45 个百分点。两者低层控制相同，此结果支持新参考对执行偏离的作用，但高层模型及训练来源也不同，不能宣称严格只关闭一个开关的完美单因素实验&lt;br&gt;&lt;br&gt;跨本体与数据规模：Push-T 和穿线各用约一小时手机视频训练意图；每本体每任务 15 次，两任务合计两种控制器都为 19/30 = 63.3%。共享同一高层意图模型，夹爪和灵巧手各有自己的仿真训练控制器；这是高层接口迁移证据，不是手指策略权重零样本迁移（§4.3、图 5B）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_4_branch_2" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="899.0" as="sourcePoint"/><mxPoint x="2632" y="899.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_4_field_3" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;跨本体与数据规模&lt;/b&gt;&lt;br&gt;&lt;br&gt;跨本体与数据规模：收纳训练片段从 1k、2k、5k、10k 扩到 20k，每点 30 次真机实验，保留 1000 段作意图验证集。损失下降与任务表现提高在该范围内同时出现；图示趋势不能外推成任意视频规模的性能保证（§4.2、图 6）&lt;br&gt;&lt;br&gt;控制消融与算力：三种种子的仿真对照包括点 token 编码换普通 MLP、去掉协同抓取基、学生混合目标换 DAgger-BC、去掉腕部深度。图 7 指标是训练 episode reward，不是新的真机任务成功率；腕部深度和结构化动作探索提供接触几何与训练效率（§4.4）" vertex="1">
          <mxGeometry height="604" width="628" x="2632" y="1229" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_4_branch_3" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_4_field_4" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;控制消融与算力&lt;/b&gt;&lt;br&gt;&lt;br&gt;意图提取与训练用 A100 节点；教师、学生训练及整套部署分别在单 RTX 5090 上运行。腕部深度还使用 Fast-FoundationStereo 处理红外双目，因为传感器原生近距深度不够稳定；不能把“使用深度相机”理解为普通 D435i 原生深度已足以复现（附录 A.2、B.5/B.8）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1861" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_4_branch_4" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2058.0" as="sourcePoint"/><mxPoint x="2632" y="2058.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_5_field_1" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者指出：多个分割、深度、追踪和手模型组成的模块链容易传递错误；任务没有可验证终态时会循环，搅拌需外部停止；任务语料仍人工筛选；物体流＋掌姿丢失精细手指配置和接触信息（§5）&lt;br&gt;&lt;br&gt;不足与未来：我的理解：换 DH116 后意图接口可复用，控制器、抓取基和系统辨识仍要做；遮挡下深度与点跟踪迟滞可能使意图过时。既有真实五任务证据也不足以保证精密插装、双臂配合或任意材料都可靠" vertex="1">
          <mxGeometry height="534" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_5_branch_1" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="407.0" as="sourcePoint"/><mxPoint x="3322" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_5_field_2" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;项目启发：相比继续逐帧复制人手，值得研究“物体期望运动＋少量功能接触点”的高层接口，让 DH116 用自身运动学实现；可先以 D435i 记录刚体点轨迹，人工设目标，训练小任务控制器验证接口，再考虑大规模视频意图模型。完整系统需要强 GPU、第二路腕部深度和仿真，不能称无额外硬件的低成本完整复现" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_5_branch_2" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="916.5" as="sourcePoint"/><mxPoint x="3322" y="916.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_113_5_field_3" parent="paper_113" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;未来研究设计：把接触部位／触觉加入意图，明确失败状态、停止条件和可恢复域；评测目标变化时重新预测与固定轨迹的差异。以上为本库建议，不是作者已完成的 DH116 或双臂实验" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="1159" as="geometry"/>
        </mxCell>
        <mxCell id="paper_113_5_branch_3" edge="1" parent="paper_113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1349.0" as="sourcePoint"/><mxPoint x="3322" y="1349.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
