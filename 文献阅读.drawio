          </mxCell>
        </UserObject><UserObject id="paper_143_bottomnav_2" label="上一篇" link="data:page/id,literature-paper-142" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_143_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-04" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_143_1_field_1" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题 Dynamic Test-Time Compute Scaling in Control Policy: Difficulty-Aware Stochastic Interpolant Policy，简称DA-SIP，即按难度调节随机插值策略的测试时计算。首页明确NeurIPS2025，作者和机构按首页记录，本地22页含实现、配置对照、分类标注、鲁棒性及真实数据验证附录。首个预印本、更新日期和实时引用数未核验，旧卡引用6不代表当前状态。该文研究的是生成动作时如何选择计算预算，而不是增加语言模型推理字数或自动构建任务计划。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_1_branch_1" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_1_field_2" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;具体问题与阅读结论&lt;/b&gt;&lt;br&gt;&lt;br&gt;固定多步生成器每个控制周期都投入相同算力，远离物体的粗移动也用高预算，可能浪费；精密接触时预算太低又会失败。DA-SIP用图像状态分类器识别执行阶段，动态选择积分步数、求解器和确定性或随机积分。主要结论来自仿真：可以节约总计算时间，成功率大致接近固定最大预算。但论文内部对类别、模型和部分数值口径有冲突，不能当作所有细节一致、可直接照配的成熟部署方案。" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_1_branch_2" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="934.0" as="sourcePoint"/><mxPoint x="562" y="934.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_2_field_1" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;已有生成控制器与自适应计算&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy逐步去噪生成动作块；流匹配策略积分学习的向量场，将噪声变为动作。常见方案选定固定步数与求解器后持续使用。蒸馏通过额外训练把多步知识变成少步，但会增加训练或教师成本。AdaFlow根据动作分布方差判断状态复杂性，主要反映多模态程度；本文认为远近、抓取、连续推动和精确对准等任务阶段也影响计算需求。它选择更丰富的三元配置，不仅改变步数。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_2_branch_1" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_2_field_2" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;随机插值、ODE、SDE和求解器&lt;/b&gt;&lt;br&gt;&lt;br&gt;随机插值是用已知权重把专家动作和高斯噪声混合成一系列中间分布，再学习分布之间的速度或概率密度梯度。ODE是确定性微分方程，给定起点和模型后轨迹固定；SDE额外加入随机扰动，可改变采样探索特性。Euler、Heun、RK4是不同数值积分方法，通常一次积分步需要不同次数网络求值。因此20步RK4和20步Euler计算成本不一样，不能只比较表面步数；分类器自身的耗时也必须加进总延迟。" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_2_branch_2" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="864.0" as="sourcePoint"/><mxPoint x="1252" y="864.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_3_field_1" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;SIP训练：统一可切换的生成表示&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练以观察o为条件，从专家动作x与噪声ε构造插值It=αt·x+σt·ε。网络可学习该插值的条件速度，或学习score即对数密度关于状态的梯度，也可学习噪声；正文实验主要用速度预测以统一比较。速度损失是网络预测与插值真实时间导数的均方误差，score可经已知插值系数换算。推理使用反向ODE或带可调扩散系数的SDE，从噪声生成动作。Linear、VP和GVP代表不同插值权重路径，同一已训练配置可调整积分方案，但不能随意改变训练定义而声称完全等价。正文插值端点文字与后续α/σ公式方向并不一致，复现前应统一约定。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_3_branch_1" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_3_field_2" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;难度标签从哪里来&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者让8位标注者对约2万张机器人状态图像标注，多数投票得到标签。实际实验使用6类：初始远离目标I、接近N、抓持搬运G、需要随机尝试的精确对准S、连续推动C、终止E。每任务约300张可作为分类器训练基准，论文称约15分钟人工标注。难度标签并不是直接测得的失败概率，而是人的阶段语义，再经验证集映射为计算配置；不同环境的同一语义是否需要相同步数，仍依赖实测。接近距离在正文与附录写约10厘米，表3写30厘米，需作为实现疑点保留。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_3_branch_2" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1004.0" as="sourcePoint"/><mxPoint x="1942" y="1004.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_3_field_3" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;分类器和计算分配的具体运行&lt;/b&gt;&lt;br&gt;&lt;br&gt;每个控制周期读取当前视觉，分类器输出阶段标签，再查固定映射表选择预算。表3实际使用I/E为1步Euler-ODE，N为5步Euler-ODE，G为10步Euler-ODE，S为50步Euler-SDE，C为100步Heun-SDE。这套表与早先方法段的3级5/10/20步及RK4配置不同，不能混成同一实现。作者比较轻量CNN、给每类1–3图提示的VLM，以及微调VLM。CNN一次约20毫秒，少样本VLM约0.5–1秒，微调VLM约0.3–0.4秒；后两者额外开销可能抵消减少积分步带来的收益。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1299" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_3_branch_3" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1566.0" as="sourcePoint"/><mxPoint x="1942" y="1566.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_3_field_4" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;模型与标注的不一致如何处理&lt;/b&gt;&lt;br&gt;&lt;br&gt;正文说CNN为ResNet18并输入RGB-D，附录表7却是32×32 RGB、三卷积块加全连接、6类输出。因此只能确认存在轻量视觉分类器路线，不能同时把这两种结构当作唯一最终模型。分类器训练用分类交叉熵、类别反频率权重与数据增强，缓解少见精密接触阶段被忽略。SIP则是独立动作网络，附录训练AdamW、学习率1e-4、批量256、5000轮、MSE及EMA。分类错误不会被动作生成损失自动纠正，困难状态误判为简单时，仍可能少算并产生不可靠动作。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1861" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_3_branch_4" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2128.0" as="sourcePoint"/><mxPoint x="1942" y="2128.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_4_field_1" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;仿真任务与配置搜索&lt;/b&gt;&lt;br&gt;&lt;br&gt;配置分析包含RoboMimic的Can、Lift、Square、ToolHang、Transport，另有PushT、BlockPush和MultimodalAnt等；Kitchen在环境介绍出现，但主结果未列对应数值。每配置3训练种子、每训练种子3推理种子，共9组，末10个检查点平均、各50回合，训练设备L40S。不同任务最优配置不同：Lift/Can可1步达到100%，PushT的100步Heun-SDE约92.6%，BlockPush约22.7%–22.8%；ToolHang50步Euler-ODE38.1%，增加到100步反而35.1%，说明更多计算并不保证更好。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_4_branch_1" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="407.0" as="sourcePoint"/><mxPoint x="2632" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_4_field_2" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;动态计算主表：必须连同成功率看&lt;/b&gt;&lt;br&gt;&lt;br&gt;表4与表5在6个仿真任务对比固定最大预算和动态分配。CNN在ToolHang总计算342.13秒降为106.37秒约3.22倍，成功25%变27%；Square146.68秒降56.20秒约2.61倍，90%变92%；Transport342.54秒降77.36秒约4.43倍，但80%降77%，损失3个百分点。PushT121.89秒降45.35秒约2.69倍，86%变87%；Lift263.28秒降64.31秒约4.09倍，保持100%；Can214.81秒降74.32秒约2.89倍，保持99%。这是计算时间比值，不等于机械臂物理任务执行时间缩短同样倍数。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_4_branch_2" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="969.0" as="sourcePoint"/><mxPoint x="2632" y="969.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_4_field_3" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;VLM开销、分类准确率和数值冲突&lt;/b&gt;&lt;br&gt;&lt;br&gt;少样本VLM在Transport成功率从最大预算80%降到62%，损失18个百分点，不能写所有方法无损。正文表2称CNN在ToolHang81.3%、Transport91.5%分类准确率，附录表16在300图条件却分别19%和36%，表19干净图又为20.52%和34.66%；实验划分或模型差异未解释，须保留严重一致性问题。ToolHang逐周期计时中CNN分类0.023秒、SIP0.301秒、仿真执行0.977秒、数据处理0.057秒，总1.357秒；微调VLM总1.535秒，说明只比生成器时间不足以判断系统效率。" vertex="1">
          <mxGeometry height="534" width="628" x="2632" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_4_branch_3" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1531.0" as="sourcePoint"/><mxPoint x="2632" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_4_field_4" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真实数据验证不是真机执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;附录真实PushT只把公开人类机器人示范用于训练SIP与Diffusion Policy，报告训练过程动作MSE。第4614步SIP动作MSE0.00294、DP0.00467，说明在该数据和训练条件下监督拟合误差较小，但不代表闭环成功率更高。作者明确因时间限制没有实际机器人轨迹rollout，本文没有真实任务完成率、DH116或D435i实验，也不能把仿真2.6–4.4倍计算节约称作真机速度实测。表中的训练损失由不同模型目标构成，不宜跨模型直接比较其绝对大小。" vertex="1">
          <mxGeometry height="499" width="628" x="2632" y="1826" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_4_branch_4" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2075.5" as="sourcePoint"/><mxPoint x="2632" y="2075.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_5_field_1" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者局限与文内疑点&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者将大规模机器人基础模型接入与接触任务安全监测列为未来方向，并承认主评估在仿真，真实部署尚待验证。除这一明确范围，读文需要注意：三类和六类预算不一致，CNN架构和输入模态不一致，分类准确率跨表严重冲突，VLM微调正文8轮与附录12轮不同，接近距离10/30厘米不同。这些疑点不否定按难度分配算力的想法，但降低了复现与定量结论的可追溯性，应先核验代码和实验设置再用于部署决策。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_5_branch_1" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_143_5_field_2" parent="paper_143" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;面向DH116双臂项目的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;可把DH116任务拆成远距离接近、预抓、双臂交接、稳定持物与精密接触，先离线测每阶段不同预算的成功率和延迟，再制定保守映射。D435i可提供深度距离，但原作输入存在RGB-D/RGB冲突，不能直接套其阈值和结构。人手视频适合辅助标注阶段，仍需机器人动作和真实执行数据验证预算。双臂交接时宜用两臂共同的困难等级或更保守一侧作为预算，避免异步算力造成动作时序漂移；这是新增建议。难度低不代表风险低，滑落、遮挡或接触异常时应升级预算或停机重估，失败恢复优先依赖实际观测，而不是让分类标签替代安全监测。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_143_5_branch_2" edge="1" parent="paper_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
