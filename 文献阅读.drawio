            <mxGeometry x="2160" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_79_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-80" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_79_1_field_1" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2023 / Robotics: Science and Systems (RSS) 2023&lt;br&gt;引用量：本地卡未记录，未重新查询（沿用本地记录，未重新查询）&lt;br&gt;研究方向：08 数据与遥操作" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_1_branch_1" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_1_field_2" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：采集到的示范既记录人想让机器人做什么，也记录相机、控制器、延迟和操作者习惯。后续训练只能使用保存下来的信息，因此数据链条要把输入、发出的命令、实际到达状态及任务结果分开保存，不能用成功条数概括质量&lt;br&gt;&lt;br&gt;基本信息与研究问题：作者与正式标题已对照 PDF 首页，正式会议为 RSS 2023；本地采用 2024-05-16 更新的 arXiv v3，首次提交为 2023-07-10，共 15 页，含附录" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_1_branch_2" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="829.0" as="sourcePoint"/><mxPoint x="562" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_1_field_3" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题是让一种视觉遥操作软件适配不同机械臂、灵巧手、相机和仿真器，降低逐平台重做接口的成本。输入为操作者的 RGB 或 RGB-D 图像，输出为手关节目标和臂轨迹；核心是模块化感知、带约束的优化重定向、CuRobo 运动生成及浏览器反馈。真机 XArm6＋Allegro 十任务与 SAPIEN 六配置证明接口通用化仍可采到有效示范，但不是“任意 URDF 插入即可安全实机运行”的验证（§III–VII）" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="1124" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_1_branch_3" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1373.5" as="sourcePoint"/><mxPoint x="562" y="1373.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_1_field_4" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：用视觉关键点控制臂手并采集可用示范&lt;br&gt;AnyTeleop 把摄像头手部追踪、受约束手形映射和机械臂规划连接起来" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1651" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_1_branch_4" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1841.0" as="sourcePoint"/><mxPoint x="562" y="1841.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_2_field_1" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;遥操作由人实时控制机器人，示范是留下的图像、动作、状态和结果；动作重定向把人的运动映到目标机器人。采集接口改善与训练策略改善应分别测试：人更容易完成任务，不自动等于同样数据训练出的策略更强" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_2_branch_1" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_2_field_2" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexPilot 用多深度相机、特定场景训练的手跟踪器和 RMP 臂控制获得精细操作，迁移时感知及集成成本较高；Holo-Dex 与 DIME 分别通过 VR 或单 RGB 降低采集成本，主要控制手。AnyTeleop 把手形到关节的映射改为运动学优化，使新本体无需重新训练映射网络，但仍须指定人—机关键点对应" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_2_branch_2" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="762.5" as="sourcePoint"/><mxPoint x="1252" y="762.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_2_field_3" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作与定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;DAPG 把示范梯度加入强化学习，因此下游实验既测采集数据也受奖励函数和在线仿真训练影响，不能把这些成功率理解为单纯行为克隆或真机自主部署成绩（§II、VII-A）" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1005" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_2_branch_3" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1195.0" as="sourcePoint"/><mxPoint x="1252" y="1195.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_2_field_4" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;运动学：根据关节角计算指尖位置；重定向用它求可行的机器人手形&lt;br&gt;DexPilot 用多深度相机、特定场景训练的手跟踪器和 RMP 臂控制获得精细操作，迁移时感知及集成成本较高&lt;br&gt;DAPG 是把人类示范作为强化学习的起点，再在仿真中按任务奖励继续试动作。它的下游成绩同时受示范质量和仿真训练影响，不能只归功于采集器" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="1413" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_2_branch_4" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1645.0" as="sourcePoint"/><mxPoint x="1252" y="1645.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_3_field_1" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 摄像头到人手几何&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 摄像头到人手几何：MediaPipe 提取腕局部 21 个三维关键点及二维投影；RGB-D 利用对齐深度、内参与关键点求全局腕位姿，纯 RGB 另估弱透视尺度，位置误差较大。系统支持单相机与多相机，并不需要用户预先手工标定全部外参&lt;br&gt;&lt;br&gt;1. 摄像头到人手几何：多相机仍有自动初始化：操作者张开手保持前 50 帧，估相机之间的相对旋转及平均手形参数。运行时选择手形估计偏离参考较小的视角，并将相对运动转入共同坐标；这不是简单平均所有深度点，也不意味着无需任何初始化（§IV-A/B，PDF pp.4–5）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_3_branch_1" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="442.0" as="sourcePoint"/><mxPoint x="1942" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_3_field_2" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 手指控制手，手腕控制臂&lt;/b&gt;&lt;br&gt;&lt;br&gt;重定向最小化缩放后人手关键点向量与机器人正向运动学向量之差，加入相邻帧关节变化惩罚抑制抖动，并显式约束关节上下界。非同构手如 Dclaw 需要人工选向量对应，不能直接复制人手关节角（式1）" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_3_branch_2" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="962.0" as="sourcePoint"/><mxPoint x="1942" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_3_field_3" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 手指控制手，手腕控制臂&lt;/b&gt;&lt;br&gt;&lt;br&gt;臂模块将腕笛卡尔目标交给 GPU 加速 CuRobo，在关节限制和碰撞约束下生成轨迹，后接阻抗控制。感知与重定向设计为 25 Hz，运动生成期望 120 Hz；作者明确同一机器并行运行全部模块难以达到最好吞吐量，可把控制分到另一机器。约束依赖正确运动学与场景模型，并不保证未知障碍或感知失效时仍安全（§IV-D、VI-A）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_3_branch_3" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1394.5" as="sourcePoint"/><mxPoint x="1942" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_3_field_4" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. 反馈、记录及学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. 反馈、记录及学习：相机驱动→感知/融合→手重定向及臂规划→网络客户端→真机或仿真；Meshcat/Three.js 浏览器呈现同步状态，操作者根据观察修正运动。双操作者协作由中央仿真与可视化服务器共享场景，不等于已做双真机全栈验证（图3、5、6）&lt;br&gt;&lt;br&gt;3. 反馈、记录及学习：SAPIEN 每任务采 50 条臂手示范，并转换为浮动手版本；比较同一 DAPG 算法使用不同采集数据。仿真状态可保存后离线高质量渲染。完整原始日志字段、统一示范存储频率及网络往返延迟未报告，不把 25/120 Hz 当作保存速率" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="1637" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_3_branch_4" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1939.0" as="sourcePoint"/><mxPoint x="1942" y="1939.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_4_field_1" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机遥操作与下游学习分开看&lt;/b&gt;&lt;br&gt;&lt;br&gt;XArm6＋Allegro、单 Intel RealSense，每任务十次；Telekinesis 对照直接引用原文，物体仅“相同或相似”，不是同实验室盲测。AnyTeleop 十任务八项更高、两项持平：双杯堆叠 7/10 对 3/10，杯堆叠 9/10 对 6/10，方盒旋转均 6/10。这些是人类在线遥操作成绩（表IV，PDF p.7）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_4_branch_1" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="354.5" as="sourcePoint"/><mxPoint x="2632" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_4_field_2" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;真机遥操作与下游学习分开看&lt;/b&gt;&lt;br&gt;&lt;br&gt;SAPIEN 三任务×浮动手/臂手，各方法三种子、每策略100次。臂手 Open Door 为 79.7±15.5%，基线51.3±30.7%；臂手 Relocate 70.0±9.8% 对40.3±36.7%。浮动手 Flip Mug 反而47.3±28.3%低于51.3±34.7%，不能说所有配置获益（表III，p.7）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_4_branch_2" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="794.0" as="sourcePoint"/><mxPoint x="2632" y="794.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_4_field_3" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;资源与相机消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;资源与相机消融：桌面 RTX3090 的 RGB 手姿26±5 ms、重定向9±7 ms、运动8±3 ms；笔记本 RTX2070 分别34±5、10±9、11±5 ms，模块耗时不能相加后宣称完整控制延迟（表II，p.6）&lt;br&gt;&lt;br&gt;资源与相机消融：模拟钢琴任务每配置十次，单RGB/单RGB-D/双RGB-D 完成时间109/87/74 s，错误按键率28.1/21.8/12.5%。增加视角能减遮挡，但结果只覆盖该任务与操作者（附录表V，p.13）；图7给出手垂直相机平面时的跟踪失败（p.14）" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1019" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_4_branch_3" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1303.5" as="sourcePoint"/><mxPoint x="2632" y="1303.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_4_field_4" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;示范质量为什么影响下游结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;示范质量为什么影响下游结果：作者把优势归于轨迹更平滑、直接在臂手系统采集并避免自碰撞。基线先采浮动手再转换为带臂轨迹，可能引入碰撞；本文反向将臂手示范转换为浮动手，两个方向的转换难度并不相同。特别是翻杯，真实可达机械臂限制了示范方式，说明“同条任务描述”不保证采集难度相同（§VII-A，PDF p.8）&lt;br&gt;&lt;br&gt;示范质量为什么影响下游结果：数据质量应同时看执行可行性、轨迹连贯性与成功覆盖，而不只看示范条数。论文没有把平滑项与碰撞规划分别去掉的完整因果消融，因此不能把下游增益全部归给某一模块；本项目可在离线相同输入序列上分别检查这两类指标" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="1616" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_4_branch_4" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1935.5" as="sourcePoint"/><mxPoint x="2632" y="1935.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_5_field_1" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目关系与下一步&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足、项目关系与下一步：作者证据边界：纯 RGB 腕位置较差，多视角有成本；全模块同机达不到最佳吞吐；示范难度会影响浮动手与臂手的比较。系统没有训练通用失败恢复策略，人的闭环纠正也不等于自主故障恢复&lt;br&gt;&lt;br&gt;不足、项目关系与下一步：我的分析：适合复用的是接口拆分、关节受限向量重定向、命名关节映射和原始/目标/实际状态分开记录。D435i 可承担 RGB-D 输入，DH116 右手需按六主动轴、十一总自由度及耦合建模，不能套用 Allegro 的十六轴或左手仿真标定" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_5_branch_1" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="424.5" as="sourcePoint"/><mxPoint x="3322" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_79_5_field_2" parent="paper_79" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足、项目关系与下一步&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足、项目关系与下一步：最低验证：当前整手/多轴运动仍锁定、故障根因未知，先录离线张手与拇指—食指—中指姿态，在右手模型检查指尖误差、关节饱和、抖动和失踪帧日志，不发真机运动。完整复现还需机械臂、正确碰撞模型、控制驱动及 NVIDIA GPU；双臂可先复用中央仿真架构，尚不构成双臂实机方案&lt;br&gt;&lt;br&gt;对自己的实验怎样落地：可以从本页输入、动作与实验协议中选最小可复现部分，先检查离线记录和运动学，再在相同数据量下比较有无该模块的闭环结果。若转到 DH116，需要按主动轴及耦合关系定义动作，补齐原任务使用而本机缺少的观察；这些属于研究建议，不是本文已完成的本机验证" vertex="1">
          <mxGeometry height="674" width="628" x="3322" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_79_5_branch_2" edge="1" parent="paper_79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1074.0" as="sourcePoint"/><mxPoint x="3322" y="1074.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
