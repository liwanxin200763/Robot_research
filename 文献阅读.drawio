            <mxGeometry x="2160" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_136_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-16" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_136_1_field_1" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息与版本&lt;/b&gt;&lt;br&gt;&lt;br&gt;完整标题 Learning Object-Centric Motion Priors from Human for Robotic Dexterous Manipulation，可译为从人类学习以物体为中心的运动先验以支持机器人灵巧操作。本地9页PDF首页明确AAAI-26和2026版权；首次预印本日期、后续修订日期及具体出版月尚未核验，不把会议年当作首次公开时间。作者为Zhengdong Hong和Guofeng Zhang，机构为浙江大学CAD&amp;amp;CG国家重点实验室。旧卡引用量0没有检索日期，本次不将它当作当前引用状态。" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_1_branch_1" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="407.0" as="sourcePoint"/><mxPoint x="562" y="407.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_1_field_2" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;问题与本文的关键主张&lt;/b&gt;&lt;br&gt;&lt;br&gt;多指手的动作维数高，靠强化学习自行探索往往需要大量试错和手工奖励；直接模仿人手轨迹又会受手型差异与接触动力学限制。本文提出学习人类不仅怎么动手，也怎样让物体未来状态变化。用人手与物体联合运动预测提供参考，再把预测的物体状态变成强化学习奖励，使抓取、铰接物体开合和绕障抓取共享训练结构。它使用的是带三维标注的人物交互数据，不是从任意互联网RGB视频直接获得可执行动作。" vertex="1">
          <mxGeometry height="499" width="628" x="562" y="702" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_1_branch_2" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="951.5" as="sourcePoint"/><mxPoint x="562" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_2_field_1" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;已有路线的输入输出与不足&lt;/b&gt;&lt;br&gt;&lt;br&gt;AnyTeleop式重定向输入人手关节点，以逆运动学或数值优化输出机器人关节角，能解决形态映射，却不能保证动态接触可行。ViviDex、AdaDexGrasp等使用人类轨迹和仿真增强训练技能，在新物体配置下仍可能依赖已有参考。Obj-Dex从给定物体目标轨迹预测手运动，输入中的目标轨迹本身需要额外定义。只用视觉表示的R3M、VIP类方法从二维人类视频学习特征，而高维灵巧操作往往还需要三维手部与六自由度物体信息。本文让初始手物状态和物体形状直接驱动未来预测，减少手工指定整条目标运动的负担。" vertex="1">
          <mxGeometry height="569" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_2_branch_1" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="424.5" as="sourcePoint"/><mxPoint x="1252" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_2_field_2" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语与范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;HOI即人和物体交互；运动先验是从人类数据学到的合理状态变化规律；物体中心坐标系以初始物体几何中心为原点，使相同操作不必固定在一个世界坐标位置。自回归预测指每次预测下一状态，再把预测结果作为后续输入，逐步得到长序列。零样本仿真到真实表示策略不使用真实机器人示范再训练，并不表示没有硬件标定、系统辨识或为不同手型重新训练仿真策略。本文跨手型实验恰恰会重新重定向和做强化学习。" vertex="1">
          <mxGeometry height="499" width="628" x="1252" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_2_branch_2" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="986.5" as="sourcePoint"/><mxPoint x="1252" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_3_field_1" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;学习联合手物预测器&lt;/b&gt;&lt;br&gt;&lt;br&gt;训练数据来自DexYCB与ARCTIC，每个时间戳有MANO人手状态及物体六自由度位姿。MANO是参数化人手模型，描述手形和姿态；物体旋转用四元数表示。铰接物体如盒子或笔记本记录上部相对底座的位姿。每个网格经最远点采样得到100个点，这种采样逐次选离已选集合最远的点，使形状覆盖更均匀；PointNet把这些三维点变成形状特征。形状特征与历史手物状态输入6层GPT-2 Transformer，使用n=10的历史跨度预测下一时刻，再递归生成整段参考。ARCTIC的双手直接输入；DexYCB缺失的一侧以零填充，让一个统一模型容纳两种数据。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_3_branch_1" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="424.5" as="sourcePoint"/><mxPoint x="1942" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_3_field_2" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;预测损失为何同时约束手和物&lt;/b&gt;&lt;br&gt;&lt;br&gt;监督损失对每个时刻累加手状态与物体状态的平方误差，权重分别α=1、β=2。物体状态在输入中占的维数比手少，较大的物体权重防止网络只拟合高维手姿而忽略真正任务结果。联合预测让手和物变化相互关联，物体轨迹用于表达任务要达到什么，手轨迹用于提供接触动作的初始结构。这里的损失是状态预测误差；后续PPO的奖励属于另一个训练阶段，不能混成一个端到端损失。自回归展开也可能累积误差，因此预测结果仍需经过物理学习修正。" vertex="1">
          <mxGeometry height="499" width="628" x="1942" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_3_branch_2" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="986.5" as="sourcePoint"/><mxPoint x="1942" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_3_field_3" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;机器人初态与人类表示的双向接口&lt;/b&gt;&lt;br&gt;&lt;br&gt;部署时先从机器人本体关节状态和正运动学得到机器人关节点三维位置，再修改FrankMocap的拟合目标，把MANO对应关节直接与这些三维点对齐，替代从二维图像反投影拟合。手形参数可适应不同长度，得到预测器能读的类人手初态。物体网格配合FoundationPose做模型跟踪得到物体位姿。预测的人手运动再经AnyTeleop式优化变成机器人关节序列：最小化五指指尖位置误差并惩罚相邻帧关节变化，同时满足关节上下限。该接口共享人类运动先验，但仍依赖目标手的运动学和关节对应。原文重定向β系数处有缺项，不能据此杜撰复现值。" vertex="1">
          <mxGeometry height="569" width="628" x="1942" y="1264" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_3_branch_3" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1548.5" as="sourcePoint"/><mxPoint x="1942" y="1548.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_3_field_4" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;轨迹引导强化学习：状态、动作和奖励&lt;/b&gt;&lt;br&gt;&lt;br&gt;PPO策略的状态包含机器人关节位置和物体六维位姿；动作输出末端增量位姿与手关节增量。末端目标通过Pinocchio逆运动学转成机械臂关节位置。奖励分四部分：机器人跟随奖励约束参考手关节及末端位置、方向；物体跟随奖励用指数形式鼓励当前平移与预测平移接近、当前四元数与预测旋转接近；接触奖励在拇指与至少另一个手指同时接触时给出；任务成功另给终端鼓励。跟随手只是在告诉机器人怎么尝试，跟随物才告诉它物体有没有朝任务目标变化，避免机器人空摆动作。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="1861" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_3_branch_4" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2128.0" as="sourcePoint"/><mxPoint x="1942" y="2128.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_3_field_5" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;绕障与仿真到真实的具体处理&lt;/b&gt;&lt;br&gt;&lt;br&gt;绕障任务另外对机械臂或手与障碍相碰给较大惩罚，并用cuRobo过滤参考轨迹中手网格撞障碍的帧，在这些帧关闭跟随奖励，以免策略同时被要求模仿碰撞和避免碰撞。训练初始物体在xy方向±5厘米、z轴旋转±30度随机化。迁移前让仿真和真机在同一时间区间做相同移动，调PID及电机力限以减小运动差异；另外随机化摩擦、物体尺寸与重量，并给观测加噪。换手时要重新调整控制参数，再训练对应策略。这些步骤解释了零样本真机迁移的条件，也说明跨形态兼容不是一个权重包直接插上任意手即可运行。" vertex="1">
          <mxGeometry height="534" width="628" x="1942" y="2423" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_3_branch_5" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2690.0" as="sourcePoint"/><mxPoint x="1942" y="2690.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_4_field_1" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;训练、机器人与传感器&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真使用SAPIEN3和Gymnasium，在单张24GB RTX4090与i7-14700K上并行1024个环境，作者报告约每秒10000步、策略训练100万步至收敛；PPO学习率3e-4、折扣0.95、GAE参数0.9。真机为两台xArm-7，可搭PSYONIC Ability、ROBOTERA XHand1或Inspire手。物体姿态由RealSense D435i的RGB-D数据和FoundationPose跟踪得到，相机用EasyHec++标定。这是与当前D435i直接相关的传感器证据，但并没有在DH116上实验。仿真各设置5个随机种子，收敛后每次100次评估；真机实验重复20次。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_4_branch_1" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_4_field_2" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;抓取与铰接任务结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;抓取成功定义为把目标物体抬高超过10厘米，评估包含DexYCB物体、非DexYCB的YCB物体以及新初始姿态。本文仿真三组成功率为90%、86%、75%，表中平均84%；真机为85%、80%、65%，平均77%。真机对照ViviDex、AdaDexGrasp、ManipTrans、HOP平均分别33%、55%、32%、48%；与最好的55%相比提高22个百分点。铰接操作成功要求绕轴转动超过30度，使用ARCTIC三类物体及生活中真实笔记本、大盒子、玩具咖啡机。本文仿真平均66%，真机平均53%，真机已见物70%、生活物35%，说明跨对象仍有明显下降。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_4_branch_2" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1021.5" as="sourcePoint"/><mxPoint x="2632" y="1021.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_4_field_3" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;绕障、跨手型与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;绕障任务要求抓取全过程机械臂和手都不碰障碍，障碍来自5个DexYCB物体及5个3D打印物体，模型已知但类别和位置可变。本文仿真两组57%、74%、平均66%，真机55%、70%、平均63%；真机用xArm内置碰撞检测判定。表7的PPO w/o following一行给50%和55%，却把平均列印成61%，算术不一致，本笔记保留这项疑点，不用它计算提升。跨手型图4展示三种手都可运行，但必须重做重定向和RL。消融用5个DexYCB物体、各5个种子：去除物体跟随项后样本效率明显下降；去除接触项训练不稳定，正文未给精确终值，不补造百分数。" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="1334" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_4_branch_3" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1618.5" as="sourcePoint"/><mxPoint x="2632" y="1618.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_5_field_1" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;作者结论与可核验边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者结论强调联合预测与物体跟随奖励能在多任务、新物体和多手型上发挥作用；正文没有独立的详细局限章节。可核验边界是数据有高质量三维HOI标注、物体网格已知、部署需要位姿跟踪、每个目标手仍需物理参数调整和RL。它验证了三类具体技能，不能据此声称任意开放世界任务或任意手都零成本泛化。不同任务仍有成功判据和障碍惩罚，因此更准确的说法是减少任务特定的密集奖励工程，而非完全不需要任务设计。" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_5_branch_1" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_136_5_field_2" parent="paper_136" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;对DH116、D435i和视觉闭环的分析建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;本项目可直接参考D435i—FoundationPose—物体状态奖励的接口，把人手示范表达成物体应如何移动，再用目标机器人可行的夹持方式实现。若DH116采用较少自由度夹爪，手姿跟随权重应降低，接触奖励改成双侧夹持、闭合量及持物稳定约束；原文MANO五指接口不能原样搬用。建议先对已知刚体网格和缓慢抓取验证位姿闭环，再测试遮挡、深度孔洞和目标滑移下的观测可靠性。失败检测应比较预测物体状态与实际物体状态，区分未抓住、抓住后滑落和位姿跟踪丢失；必要时重估初态并重新生成参考。这些恢复机制是扩展建议，论文没有给出其成功率。" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_136_5_branch_2" edge="1" parent="paper_136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-page-02" name="02 记忆与时间建模">
