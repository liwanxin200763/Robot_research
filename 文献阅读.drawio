        <mxCell id="paper_38_1_field_2" parent="paper_38" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：历史视觉与 VLA（视觉—语言—动作模型：看画面、读指令、输出机器人动作）。用运动轨迹提示当前变化，帮助模型判断物体如何移动" vertex="1">
