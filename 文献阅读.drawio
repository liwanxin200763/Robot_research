          </mxCell>
        </UserObject><UserObject id="paper_47_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-48" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="2986" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_47_1_field_1" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2025 / ICCV&lt;br&gt;引用量：34（沿用本地记录，未重新查询）&lt;br&gt;研究方向：05 双臂与 Multi-Agent 协作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_1_branch_1" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="330.0" as="sourcePoint"/><mxPoint x="562" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_1_field_2" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;双臂任务不能只把两条单臂轨迹并排，因为一只手可能要稳定物体、另一只手操作，还要在同一空间内避开彼此。数据与策略都应保留左右角色、动作先后和共同目标，否则两边单独正确也可能组合失败" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_1_branch_2" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="738.0" as="sourcePoint"/><mxPoint x="562" y="738.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_1_field_3" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;论文定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;这篇论文属于 Bimanual Manipulation; Imitation Learning 方向，主要讨论语言条件双臂操作的示范成本高，动作空间也更复杂。&lt;br&gt;核心思路是用技能管理器安排双臂子技能，并以体素/视觉对齐模块协调两臂输入，使预训练单臂策略可复用。&lt;br&gt;与当前项目的联系：项目联系：直接针对从单臂到普通夹爪双臂任务的迁移" vertex="1">
          <mxGeometry height="464" width="628" x="562" y="956" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_1_branch_3" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1188.0" as="sourcePoint"/><mxPoint x="562" y="1188.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_1_field_4" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究问题：语言条件双臂操作的示范成本高，动作空间也更复杂&lt;br&gt;&lt;br&gt;为什么重要：提供节约双臂数据成本的一条可测试路线" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="1448" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_1_branch_4" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1638.0" as="sourcePoint"/><mxPoint x="562" y="1638.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_1_field_5" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：单臂策略迁移到双臂协作。Unimanual 是单手/单臂；Bimanual 是双手/双臂。它是学习式协调网络，论文没有把左右臂做成语言模型多代理辩论&lt;br&gt;核心研究问题：单臂操作数据比双臂多。能否复用已学会的抓、放等单臂技能，让左右臂各选合适技能并在同一场景协调完成任务？&lt;br&gt;之前方法的问题：直接复制单臂策略，两臂可能看错对方物体或争做同一动作；为所有双臂组合从头采数据，又难扩展到更多任务" vertex="1">
          <mxGeometry height="534" width="628" x="562" y="1856" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_1_branch_5" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="2123.0" as="sourcePoint"/><mxPoint x="562" y="2123.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_2_field_1" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：双臂方法可能采用共同策略、左右专家、领从分工或显式调度。它们共享目标但交换的信息不同；只测两只手分别取物不能完整验证紧密协作，应看是否有交接、共同搬运、稳定—操作或接触约束任务&lt;br&gt;&lt;br&gt;之前方法的问题：从单臂策略直接迁移到双臂时，两臂观测和动作不一定对齐" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_2_branch_1" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="372.0" as="sourcePoint"/><mxPoint x="1252" y="372.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_2_field_2" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：单臂通用策略学习多种原子技能；双臂还需分配角色、协调时机和适配视觉，技能数量足够不等于协作机制足够&lt;br&gt;相关方向 2：视觉对齐使单臂与双臂输入特征更接近，减少另一只手和其物体造成的干扰。对齐帮助迁移，但不能自动保证双臂无碰撞&lt;br&gt;代表工作：PerAct2 等直接学习双臂动作；#32 TwinVLA/#33 TAO-DA 组织双臂模型。#24 BiCICLe 另有多代理显式协商，与本篇机制不同&lt;br&gt;与已有方法的区别：用技能管理器组合预训练单臂能力，并学习左右臂视觉软掩码。完整协作靠训练出的模块，不是调用两个单臂模型后自然形成合作" vertex="1">
          <mxGeometry height="639" width="628" x="1252" y="632" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_2_branch_2" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="951.5" as="sourcePoint"/><mxPoint x="1252" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_3_field_1" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;核心思路&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心思路：用技能管理器安排双臂子技能，并以体素/视觉对齐模块协调两臂输入，使预训练单臂策略可复用&lt;br&gt;&lt;br&gt;单臂技能怎样组成双臂行为：AnyBimanual 的 skill manager 从预训练单臂策略中提取技能表示，按双臂任务动态组合，并加入任务相关补偿，让两臂不必从头学习所有局部操作。技能管理处理做什么和如何组合，原有单臂策略继续提供可复用动作知识；它不是把同一个单臂指令原样发给左右两边&lt;br&gt;&lt;br&gt;为什么还要视觉对齐：双臂场景多出另一只手和不同观察分布，原单臂骨干可能把这些变化当陌生环境。visual aligner 为视觉特征生成软掩码，让每只手使用的特征更接近单臂预训练时的输入，再用少量双臂示范适配协调。掩码是特征权重，不代表另一只手在物理空间消失，因此避碰与任务分工仍需评测" vertex="1">
          <mxGeometry height="779" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_3_branch_1" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="529.5" as="sourcePoint"/><mxPoint x="1942" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_3_field_2" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：技能管理器根据场景和指令生成左右臂的技能权重与补偿信息。输入当前任务，输出各臂应使用哪些单臂能力，减少从零学习所有组合&lt;br&gt;贡献 2：视觉对齐器给左右臂构造软掩码：每处图像特征被分配不同权重，让每臂突出与自己有关的信息，同时降低双臂场景与单臂训练差异&lt;br&gt;贡献 3：两臂复用预训练策略，再联合学习协调模块。既共享技能又保留分工，适用于有少量双臂示范的迁移，而非完全无需双臂数据&lt;br&gt;方法流程：双臂画面+指令 → 技能管理器分配左右技能 → 视觉对齐器提取各臂信息 → 预训练单臂策略分别出动作 → 协调执行 → 重新观察" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_3_branch_2" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1266.5" as="sourcePoint"/><mxPoint x="1942" y="1266.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_4_field_1" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据集与评测基准&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据集与评测基准：12 项仿真任务和 9 项真机任务&lt;br&gt;&lt;br&gt;实验与结果：数据集与评测基准：12 项仿真任务和 9 项真机任务" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_4_branch_1" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="330.0" as="sourcePoint"/><mxPoint x="2632" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_4_field_2" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;实验：RLBench2 仿真12项双臂任务，20/100条示范设置；真机双 UR5e 做9项任务，每任务约30条示范，涉及共同搬运、交接等&lt;br&gt;对照：比较 PerAct2 等双臂方法，消融技能管理器和视觉对齐器。少样本设置用来检查复用单臂知识是否减少双臂数据需求&lt;br&gt;结果：仿真平均成功率32%，消融表的基线为14.67%，增加17.33个百分点；加入技能管理和视觉对齐逐步改进。该表数值是指定任务集结果，不代表任意双臂任务&lt;br&gt;真机 / 关键补充：真机9项任务共65次，整体84.62%成功。使用夹爪且每任务已有30条双臂训练示范，并人工抽关键帧；不能称为灵巧手直接零样本迁移" vertex="1">
          <mxGeometry height="639" width="628" x="2632" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_4_branch_2" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="867.5" as="sourcePoint"/><mxPoint x="2632" y="867.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_4_field_3" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;这些结果的正确读法&lt;/b&gt;&lt;br&gt;&lt;br&gt;把数据规模、离线评分和闭环任务成功分开看，先确认数字的分母是帧、轨迹、子阶段还是完整回合，再看是否使用同样训练数据与测试初态。模型消融只说明移除某模块后结果怎样变化，不能据此推断未测试的新机器人或新任务也有相同收益；本地证据未列出的指标不补猜数字" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1215" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_4_branch_3" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1412.0" as="sourcePoint"/><mxPoint x="2632" y="1412.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_5_field_1" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;与当前项目的关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;与当前项目的关系：项目联系：直接针对从单臂到普通夹爪双臂任务的迁移&lt;br&gt;&lt;br&gt;主要局限：仍依赖少量双臂示范，且假设单臂预训练表示可以复用&lt;br&gt;&lt;br&gt;局限与启发：主要局限：仍依赖少量双臂示范，且假设单臂预训练表示可以复用" vertex="1">
          <mxGeometry height="499" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_5_branch_1" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="389.5" as="sourcePoint"/><mxPoint x="3322" y="389.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_47_5_field_2" parent="paper_47" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的不足：正文指向补充材料讨论局限；本地版本未提供完整独立局限段。已知测试以既定任务、双臂数据与夹爪平台为主，不能证明任意任务都能拆成单臂技能&lt;br&gt;我的理解 / 不足：我的判断：共同施力、连续接触和两手内部协调不一定能靠技能加权表达；只看视觉也难判断哪只手已经可靠抓住&lt;br&gt;未来展望：加入触觉、交接完成判据和两臂碰撞约束；对“左手必须等右手抓牢”的条件单独测试，让协作是否真实发生可测量&lt;br&gt;对我们项目的启发：可借鉴技能管理器，为 DH116 双手复用单手抓取、扶稳、转动技能；新增手指动作、接触状态和同步约束，不能沿用夹爪动作空间" vertex="1">
          <mxGeometry height="639" width="628" x="3322" y="667" as="geometry"/>
        </mxCell>
        <mxCell id="paper_47_5_branch_2" edge="1" parent="paper_47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="986.5" as="sourcePoint"/><mxPoint x="3322" y="986.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
