        <mxCell id="paper_51_1_field_1" parent="paper_51" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="年份 / Venue：2025 / CVPR 2025&lt;br&gt;引用量：37（本地卡记录，未重新查询）" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="110" as="geometry"/>
        </mxCell>
        <mxCell id="paper_51_1_branch_2" edge="1" parent="paper_51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="460" as="sourcePoint"/>
