            <mxGeometry x="2160" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_59_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-60" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3386" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_59_1_field_1" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv 预印本；未核验到正式会议或期刊&lt;br&gt;引用量：引用量来源：Google Scholar（待人工核验）（沿用本地记录，未重新查询）&lt;br&gt;研究方向：03 动态环境与世界模型" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_1_branch_1" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_1_field_2" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;动态场景中，物体会移动或被遮挡，机器人自己动作也会改变世界。系统既要知道当前发生了什么，又要判断过去状态是否已经过期；若预测未来，还需检查预测是否真正对应机器人发出的动作" vertex="1">
          <mxGeometry height="380" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_1_branch_2" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="752.0" as="sourcePoint"/><mxPoint x="562" y="752.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_1_field_3" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向：Sim2Real 指在仿真训练后直接部署真机；本文的零样本设置不使用真实示范微调&lt;br&gt;作者用相同任务与评测协议，比较仿真环境的视觉、空间、物理变化如何影响真实成功率&lt;br&gt;核心研究问题：仿真可廉价产生示范，但相机视角、桌高、背景和接触动力学与实物不同，策略可能在真机失败&lt;br&gt;作者想区分哪些仿真训练改动真正帮助 VLA 迁移，而非只看仿真成绩&lt;br&gt;之前方法的问题：域随机化、写实渲染和强化学习各有研究，但常换用不同策略、任务或测试条件&lt;br&gt;难判断收益来自哪种变化；仿真 OOD 成绩也未必可靠代表真机表现" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="970" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_1_branch_3" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1289.5" as="sourcePoint"/><mxPoint x="562" y="1289.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_2_field_1" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界模型预测后续画面或状态，动态记忆维护已经观察到的事实，两者作用不同。预测图像逼真不保证动作正确；动态任务成功也不等于模型已经理解所有变化，所以本文的观察、预测与执行指标要分别阅读" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_2_branch_1" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="330.0" as="sourcePoint"/><mxPoint x="1252" y="330.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_2_field_2" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Domain Randomization：域随机化，训练时主动改变场景和物理条件以增加覆盖&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人&lt;br&gt;VLA：把图像和语言指令转成机器人动作的模型&lt;br&gt;RL：强化学习，通过试动作和任务奖励改进策略&lt;br&gt;OOD：训练分布之外，例如未见物体或不同背景" vertex="1">
          <mxGeometry height="464" width="628" x="1252" y="548" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_2_branch_2" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="780.0" as="sourcePoint"/><mxPoint x="1252" y="780.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_2_field_3" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;从仿真轨迹训练 VLA 可减少昂贵的真机示范，但相机视角、物体位置、光照和接触动力学的差异会让仿真成功率高估真机表现。已有方法常分别使用域随机化、逼真渲染或强化学习；这篇论文的不同之处是用同一组五任务与真机变化协议逐项比较这些因素，而非提出一个新的通用 VLA 架构。（全文 §1–2）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1040" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_2_branch_3" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1254.5" as="sourcePoint"/><mxPoint x="1252" y="1254.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_2_field_4" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究问题与相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reality Gap（仿真与现实的差距）指模拟的视觉、几何和接触规律与实际机器人不一致。Domain Randomization（域随机化）是在生成训练数据时改变这些条件，让策略学会覆盖更多可能的真实场景；它不保证每一种随机变化都有相同价值" vertex="1">
          <mxGeometry height="394" width="628" x="1252" y="1497" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_2_branch_4" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1694.0" as="sourcePoint"/><mxPoint x="1252" y="1694.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_2_field_5" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;相关方向 1：域随机化在训练时改背景、光照或几何参数，让策略见过更宽的环境分布&lt;br&gt;本文把背景、灯光、干扰物、相机位姿和桌高分开评测，再组合它们，辨认空间因素与外观因素的实际贡献&lt;br&gt;相关方向 2：提高渲染和接触物理的逼真度可缩小仿真与现实的差距；强化学习则用仿真 rollout 的任务回报修正策略&lt;br&gt;两者成本与作用机制不同，本文分别测试低中高视觉质量、失真物理参数及 RL 微调&lt;br&gt;代表工作：RoboTwin 2.0 提供双臂仿真任务，OpenVLA-OFT 是主要策略骨干；SimpleVLA-RL 的 GRPO 路线用于 RL 对照&lt;br&gt;这些不是本文新提出的基准或优化算法，其贡献在统一真机协议下拆解迁移因素&lt;br&gt;与已有方法的区别：同一批五项任务在仿真 OOD 和真机的背景、光照、物体、干扰物及位置变化中测试&lt;br&gt;还区分每回合与每帧随机化；因此能看到某项技术在具体分布偏移下有效或无效，而非只报单个平均值" vertex="1">
          <mxGeometry height="849" width="628" x="1252" y="1919" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_2_branch_5" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="2343.5" as="sourcePoint"/><mxPoint x="1252" y="2343.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_3_field_1" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;RoboTwin 2.0 仿真构造五项操作任务 → 每项、每种训练条件采集 100 条仿真示范 → 对 OpenVLA-OFT 做监督微调 → 逐项改变背景、杂物、相机位姿、照明、桌面高度，以及渲染和物理精度 → 可选地用仿真 rollout 做 GRPO 风格强化学习微调 → 不用目标真机示范直接部署 → 对仿真分布外和真机多种条件计算任务成功率。（§3–4）" vertex="1">
          <mxGeometry height="429" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_3_branch_1" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="354.5" as="sourcePoint"/><mxPoint x="1942" y="354.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_3_field_2" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;方法流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;策略输入为单路 RealSense D435 RGB 画面与语言指令，输出连续关节目标及夹爪状态的短动作段。监督基线最小化动作 L1 误差；强化学习实验改为离散动作 token 头，因此 RL 与 SFT 数字也伴随动作头变化，不能完全解释为“只增加 RL”造成的收益。域随机化区分背景、桌面杂物、相机位置、光照、桌高，还比较每回合固定与每帧重新采样。（§3.1–3.2、§4.4）" vertex="1">
          <mxGeometry height="464" width="628" x="1942" y="597" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_3_branch_2" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="829.0" as="sourcePoint"/><mxPoint x="1942" y="829.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_3_field_3" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;贡献 1：为免把不同扰动混成一个原因，作者每项任务、每种训练设置采 100 条仿真示范，并分别改变背景、光照、干扰物、相机位置和桌高&lt;br&gt;以 OpenVLA-OFT 的连续动作监督训练，再做单因素及组合测试，定位最有用的随机化来源&lt;br&gt;贡献 2：每回合固定背景仍可让模型记住场景，作者比较回合级与逐帧级扰动，逐帧只改变背景、灯光及相机位姿&lt;br&gt;桌高和干扰物维持回合级以免破坏任务可行性；另调光追与重力、摩擦、恢复系数，检验视觉及物理逼真度&lt;br&gt;贡献 3：仅模仿成功轨迹可能无法适应偏移，作者从同一仿真 SFT 起点，用成功回报的 GRPO 微调，并比较干净与随机化 rollout&lt;br&gt;RL 实验改用离散动作 token 头，因此它与连续头的域随机化主实验不能视作只差 RL 的消融&lt;br&gt;方法流程：RoboTwin 2.0 五任务生成示范 → 设定单因素或组合的仿真变化 → OpenVLA-OFT 按图像、指令预测关节目标动作段&lt;br&gt;可选在仿真用 GRPO 更新 → 不用真机示范，直接到实体平台执行 → 按预设偏移统计整任务成功率" vertex="1">
          <mxGeometry height="884" width="628" x="1942" y="1089" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_3_branch_3" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1531.0" as="sourcePoint"/><mxPoint x="1942" y="1531.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_4_field_1" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据、Baseline 与真机设置&lt;/b&gt;&lt;br&gt;&lt;br&gt;仿真：RoboTwin 2.0；任务为按铃、放空杯、敲积木、叠碗、取双瓶。论文 §4.1 写仿真 Cobot Magic 本体，真机段写 Piper 机器人；两者对应关系和硬件细节应以公开平台资料进一步核对，不能默认完全同构。&lt;br&gt;真机：Piper 平台、单台 RealSense D435（640×480）；测背景、灯光、杂物、物体实例与位置变化。作者称累计超过 10,000 次真实试验，但各结果仍应按任务与条件分别看，不能把试验总数当成单一任务样本数。（§4.1、图 2）&lt;br&gt;Baseline：干净仿真数据监督微调；单因素与多因素随机化；每回合与每帧随机化；低、中、高画面逼真度与极端物理参数；SFT、SFT+RL、SFT+RL+DR。（表 1–3、附录表 5–8）&lt;br&gt;零样本含义：没有使用目标真机示范训练策略。实验仍需真机相机布置与机器人控制接口，不能理解成完全无需部署适配。（§3.2、§4.1）" vertex="1">
          <mxGeometry height="779" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_4_branch_1" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="529.5" as="sourcePoint"/><mxPoint x="2632" y="529.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_4_field_2" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 1 中，按铃真机成功率从干净训练的 2.7% 提升至“全部随机因素”的 49.7%；放空杯从 5.4%→41.0%，叠碗从 26.2%→63.1%。单因素里桌高和相机位姿通常比仅改背景、照明或杂物收益大；外观变化与空间变化叠加仍有帮助。敲积木即使全因素也仅 11.5%，双瓶 23.8%，说明“全部随机化”并未解决所有任务。（表 1）" vertex="1">
          <mxGeometry height="429" width="628" x="2632" y="947" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_4_branch_2" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1161.5" as="sourcePoint"/><mxPoint x="2632" y="1161.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_4_field_3" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 2 中，把相机位姿从每回合随机改成每帧随机，按铃真机成功率 23.5%→31.9%、放空杯 17.5%→25.6%；背景每帧随机在放空杯上 10.2%→23.1%。这里是百分点差异，不能写成相对增长百分比。图 3 和附录表 7 显示画面从低逼真度升到中、高档一般有益，但高于中档的边际收益有限；把重力、摩擦和恢复系数改到极端值也会损伤迁移，物理真实性比较只覆盖这些设定。（§4.2–4.3）" vertex="1">
          <mxGeometry height="464" width="628" x="2632" y="1404" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_4_branch_3" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1636.0" as="sourcePoint"/><mxPoint x="2632" y="1636.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_4_field_4" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;实验结果与消融&lt;/b&gt;&lt;br&gt;&lt;br&gt;表 3 的五任务平均真机成功率：SFT 5.6%，SFT+RL 33.4%，SFT+RL+DR 42.8%；同时评估仿真 OOD。RL 比较用共同 SFT 初始化，但该组采用不同于前面连续回归实验的离散动作头，应分组解释。（§4.4、表 3）" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1896" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_4_branch_4" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2086.0" as="sourcePoint"/><mxPoint x="2632" y="2086.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_5_field_1" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;失败、局限与后续&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者结果直接显示：接触或双物体任务仍显著困难；仿真 OOD 成绩不应替代真机成绩。（表 1、3）&lt;br&gt;库内分析：主要研究同一 OpenVLA-OFT 系列和五任务，不能直接外推至所有 VLA、本体或高自由度手指控制。物理对照采用故意极端参数，并非完整 System Identification（系统辨识：由真机轨迹估计实际动力学参数）。&lt;br&gt;对机械臂 + DH116：优先复用“相机位姿/桌高单因素→组合因素→真实扰动矩阵”的设计；记录抓取、接触、整任务三个不同终点；再另做指尖摩擦、关节回差、力反馈的迁移测试。论文没有验证 DH116 灵巧手，不可把其夹爪结论当成手指关节结论" vertex="1">
          <mxGeometry height="604" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_5_branch_1" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="442.0" as="sourcePoint"/><mxPoint x="3322" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_59_5_field_2" parent="paper_59" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;阅读要点与补充说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;作者指出的边界：论文结论来自同一 OpenVLA-OFT 系列、五项桌面双臂任务与预设偏移&lt;br&gt;高视觉质量的收益趋于饱和，随机化加 RL 后锤块与取瓶仍很难；这些结果不能外推到所有硬件和接触形式&lt;br&gt;我的理解 / 不足：正文一处称仿真使用 Cobot Magic，真机段落称 Piper，硬件对应关系需按公开平台说明再核查&lt;br&gt;极端物理参数只检验一组失真设置，没有完成真实摩擦、关节回差或触觉动力学的系统辨识&lt;br&gt;未来展望：对视角、桌高、物体位置与接触参数分别测真实偏差，并把整任务失败拆成看错目标、到位误差和接触滑脱&lt;br&gt;比较物理参数校准与扩大随机化范围的收益；这是建议的后续实验，并非作者已验证的结论&lt;br&gt;对我们项目的启发：可先用机械臂和双臂任务复现相机位姿、桌高及逐帧背景对照，再在真机逐项记录成功率&lt;br&gt;若引入 DH116，需额外随机化手指摩擦、关节回差和触觉噪声；本文的夹爪结果不能直接证明灵巧手迁移" vertex="1">
          <mxGeometry height="814" width="628" x="3322" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_59_5_branch_2" edge="1" parent="paper_59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1179.0" as="sourcePoint"/><mxPoint x="3322" y="1179.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
