        </mxCell>
        <mxCell id="category_07_intro" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8FCFF;strokeColor=#BDD3E1;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#24435A;align=left;verticalAlign=top;spacing=24;" value="这个方向在研究什么：VLA 基础与泛化&lt;br&gt;通用机器人模型希望复用大规模图像、文字和动作数据，但学会物体名称并不等于知道如何稳定接触。迁到新场景或机器人时，感知、动作表示和控制接口都可能变化，必须区分预训练知识与目标任务适配&lt;br&gt;&lt;br&gt;知识链条：多来源预训练 → 任务与空间理解 → 动作生成 → 目标本体适配 → 泛化评测&lt;br&gt;共 13 篇 · 点击下方卡片进入独立论文页，再按本类编号顺序浏览">
          <mxGeometry x="100" y="280" width="2000" height="330" as="geometry"/>
        </mxCell>
        <UserObject id="category_07_paper_20" label="#20 π0.5&lt;br&gt;要解决：把来源不同的机器人动作和图文资料一起学习后，模型能否在没练过的房间清理物品？&lt;br&gt;年份 / Venue：2025，arXiv 技术报告&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-20" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
            <mxGeometry x="100" y="660" width="980" height="280" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="category_07_paper_52" label="#52 OpenVLA&lt;br&gt;要解决：如何用已有视觉语言理解和大量机器人示范，得到可以复现、可以换任务微调的通用机器人控制模型，而非只能调用闭源接口？&lt;br&gt;年份 / Venue：2024 / CoRL 2024&lt;br&gt;点击阅读 →" link="data:page/id,literature-paper-52" tooltip="点击进入页面">
          <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EEF7FC;strokeColor=#6F9DB8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#24435A;align=left;verticalAlign=middle;spacing=24;shadow=0;">
