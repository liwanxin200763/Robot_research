        <mxCell id="paper_40_1_field_2" parent="paper_40" style="rounded=1;whiteSpace=wrap;html=1;arcSize=11;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#334E60;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;spacingBottom=8;editable=1;movable=1;resizable=1;shadow=0;" value="研究方向：三维空间加时间的 VLA（视觉—语言—动作模型：用图像与指令生成动作） 预训练。Pretraining（预训练）是在大规模数据上先学通用能力；4D 在此指三维空间和时间，不是四维物理空间" vertex="1">
          <mxGeometry height="220" width="368" x="367" y="350" as="geometry"/>
