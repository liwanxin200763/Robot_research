            <mxGeometry x="2160" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_110_bottomnav_3" label="下一篇" link="data:page/id,literature-paper-111" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="3180" y="3586" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><mxCell id="paper_110_1_field_1" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;基本信息&lt;/b&gt;&lt;br&gt;&lt;br&gt;年份 / Venue：2026 / arXiv preprint&lt;br&gt;引用量：待核验；来源为 Google Scholar，未经人工查看不填写数字（沿用本地记录，未重新查询）&lt;br&gt;研究方向：01 数据生成与数据质量&lt;br&gt;数据链条位置：从腕部视角人类示范学习机器人技能" vertex="1">
          <mxGeometry height="394" width="628" x="562" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_1_branch_1" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="337.0" as="sourcePoint"/><mxPoint x="562" y="337.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_1_field_2" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;背景：为什么值得研究&lt;/b&gt;&lt;br&gt;&lt;br&gt;背景：为什么值得研究：机器人示范是一段带时间顺序的观察、状态和动作，不是一张最终成功图片。生成新示范时，必须同时保留物体关系、可达动作和任务顺序；图像看起来合理而接触不可行，仍不能作为正确动作监督&lt;br&gt;&lt;br&gt;基本信息与研究问题：年份：2026&lt;br&gt;GitHub / 开源程度：见本卡“来源与核验边界”；未核实不视为代码已完整开放&lt;br&gt;版本查询与全文核验日期：2026-10-15&lt;br&gt;&lt;br&gt;研究方向与快速摘要：本篇关心“采一份人类示范，能否给不同灵巧手重复使用”，而不是用同一个策略不经校准直接控制所有机器人。Embodiment Gap（本体差异）包含手指结构、关节自由度、视觉外观与指令空间的不一致；动作重定向用目标手的运动学和限制把人手几何关系转换为可执行命令（§I–III）" vertex="1">
          <mxGeometry height="779" width="628" x="562" y="562" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_1_branch_2" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="951.5" as="sourcePoint"/><mxPoint x="562" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_1_field_3" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;研究方向与快速摘要&lt;/b&gt;&lt;br&gt;&lt;br&gt;研究方向与快速摘要：腕部相机更靠近局部抓取区，也更接近机器人手眼相机的观察方式。作者把人手图像和机器人手图像中的 21 个结构点保持相同语义，再分别给 Linker O6 和 Wuji 构造动作监督，训练独立策略。共享的是源数据与结构语义，动作、归一化和权重并不共享&lt;br&gt;&lt;br&gt;输入、问题与前提：数据采集是腕部鱼眼 RGB 相机，加 PICO 4 Ultra 的手及腕部跟踪，并结合腕部图像手模型。不能写成任意现成单目视频或无需设备的纯视频方法。两款目标手都要手眼标定、运动学模型及相机投影，才可以让人类与机器人结构点在观察中具有对应含义（§III-A–C，图 2）" vertex="1">
          <mxGeometry height="639" width="628" x="562" y="1369" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_1_branch_3" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="1688.5" as="sourcePoint"/><mxPoint x="562" y="1688.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_2_field_1" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;先理解这条研究路线&lt;/b&gt;&lt;br&gt;&lt;br&gt;先理解这条研究路线：行为克隆用示范里的观察和动作配对训练；数据扩增增加新场景或新初始条件；物理验证检查轨迹能否让物体真正按要求运动。这三步各解决不同问题，应看本文在哪一步改变了数据，以及下游策略是否真的受益&lt;br&gt;&lt;br&gt;相关工作：UMI 使用类似机器人夹爪的手持工具，使数据采集与部署的视觉和动作接口更接近；DexUMI进一步用可穿戴接口和外观适配减少手形差异。Human2Dex 保留自然裸手操作，但把针对每种手的适配放到采集后进行，仍需 PICO 等跟踪设备（§II-A）" vertex="1">
          <mxGeometry height="604" width="628" x="1252" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_2_branch_1" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="442.0" as="sourcePoint"/><mxPoint x="1252" y="442.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_2_field_2" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;术语先用人话说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diffusion Policy：扩散策略，从随机动作逐步去噪，生成与观察相符的动作序列&lt;br&gt;Sim2Real：仿真到真实，把模拟中学到的经验用于真实机器人" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="772" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_2_branch_2" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="962.0" as="sourcePoint"/><mxPoint x="1252" y="962.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_2_field_3" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;DexPilot、手网格估计器及机器人正向运动学为动作转换提供基础。人类和机器人关节角度通常没有一一对应，因此比较的是指尖向量、指间距离和方向，而非直接复制角度。Diffusion Policy（扩散策略）从噪声逐步去噪产生未来动作序列，本文用它学习转换后的每个手—任务训练集（§III-C/E）" vertex="1">
          <mxGeometry height="429" width="628" x="1252" y="1180" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_2_branch_3" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1394.5" as="sourcePoint"/><mxPoint x="1252" y="1394.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_2_field_4" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;相关工作&lt;/b&gt;&lt;br&gt;&lt;br&gt;本文 GPIR 是低维图像平面的抓取关系提示，不是完整三维物体重建、力传感模型或通用接触模型。它与 Hand2Robot 使用物体几何和接触优化修正手轨迹的路线不同，二者可比较但不能互相替代" vertex="1">
          <mxGeometry height="380" width="628" x="1252" y="1637" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_2_branch_4" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1827.0" as="sourcePoint"/><mxPoint x="1252" y="1827.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_3_field_1" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;1. 外观与结构对齐&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 外观与结构对齐：只把人类 RGB 图像给机器人策略，会同时遇到不同手外观和骨架。作者只在手掩膜区域随机化外观，保留物体和背景；在同一图像坐标中渲染 21 点、固定拓扑及颜色，使拇指、食指等身份一致（式 3–5）&lt;br&gt;&lt;br&gt;1. 外观与结构对齐：部署时由机器人关节状态和正向运动学算出对应结构点，经当前末端姿态与固定手眼变换投影到相机。裁剪、缩放及扰动必须同时作用于 RGB、掩膜和关键点，否则点和图像会失配&lt;br&gt;&lt;br&gt;2. 融合跟踪后逐手优化动作：PICO 与腕部 RGB 模型的三维点先转换到共同腕部 MANO 坐标，用置信度加权，无效点权重为零；再用自适应 Kalman 滤波抑制抖动和短时跟踪缺失。滤波能减轻噪声，不能补出长期遮挡下不存在的真值（式 6）" vertex="1">
          <mxGeometry height="744" width="628" x="1942" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_3_branch_1" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="512.0" as="sourcePoint"/><mxPoint x="1942" y="512.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_3_field_2" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;2. 融合跟踪后逐手优化动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. 融合跟踪后逐手优化动作：O6 用腕到指尖及指尖两两关系共 15 个向量，求六个主动关节，其他关节遵循机械耦合和 URDF mimic。Wuji 的 20 个主动关节还考虑各指节位置、指尖方向、拇指捏合距离，随抓取状态调整权重，用带关节限制的 SLSQP 优化（式 7）&lt;br&gt;&lt;br&gt;2. 融合跟踪后逐手优化动作：腕运动经标定变换构成相对末端平移和六维旋转表示；手形再映到各手原生命令，O6 为六维 0–250 执行器指令，Wuji 为二十维。最终动作维数为 9+d，手指监督是命令增量，不应误写成绝对关节角通用向量（式 8）" vertex="1">
          <mxGeometry height="604" width="628" x="1942" y="912" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_3_branch_2" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1214.0" as="sourcePoint"/><mxPoint x="1942" y="1214.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_3_field_3" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;3. GPIR 表示“物体与抓取位置的关系”&lt;/b&gt;&lt;br&gt;&lt;br&gt;3. GPIR 表示“物体与抓取位置的关系”：Functional Grasp Pocket（功能抓取口袋）在本文是图像中拇指和食指指尖投影的中点。GPIR（抓取口袋交互表示）记录物体中心相对此中点的二维偏移、相对掩膜面积的对数、跟踪置信度和当前值是否从历史保留的标志；缺失时保留最近有效测量并衰减置信度（式 9–11）&lt;br&gt;&lt;br&gt;3. GPIR 表示“物体与抓取位置的关系”：因此它提示物体离捏合区多远、尺寸如何、当前观察是否可靠，不提供完整物体网格、真实接触力或滑移估计。另加仅训练使用的物体位置和面积辅助预测损失，部署时删除辅助头（式 14–15）" vertex="1">
          <mxGeometry height="639" width="628" x="1942" y="1544" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_3_branch_3" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="1863.5" as="sourcePoint"/><mxPoint x="1942" y="1863.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_3_field_4" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 策略训练及执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;腕部 RGB＋PICO → 21 点融合 → 外观及结构对齐／逐手重定向／GPIR 三条支路 → DINOv2 图像特征＋目标手状态＋GPIR → U-Net 扩散策略 → 16 步动作块 → 执行前 8 步 → 重新观察和预测" vertex="1">
          <mxGeometry height="380" width="628" x="1942" y="2211" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_3_branch_4" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2401.0" as="sourcePoint"/><mxPoint x="1942" y="2401.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_3_field_5" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;4. 策略训练及执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;Action Chunk（动作块）指一次生成未来一小段动作。每个手—任务对独立训练，AdamW 学习率 3×10⁻⁴、batch 32，16 步 DDIM 推理，实际 16 Hz 执行。新增 DH116 时需重新做动作转换、归一化和训练；这是可复用示教接口，不是零样本控制迁移（§III-E）" vertex="1">
          <mxGeometry height="394" width="628" x="1942" y="2619" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_3_branch_5" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930" y="2816.0" as="sourcePoint"/><mxPoint x="1942" y="2816.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_4_field_1" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;数据及协议&lt;/b&gt;&lt;br&gt;&lt;br&gt;数据及协议：六项真机任务为海绵放置、牛角面包抓放、杯套杯、瓶子扶正、蛋盒开盖、开抽屉。共享 1899 条基础示范、556624 帧，每段做三种外观变体；同一段的变体放在同一训练／验证划分，防止相同示范跨集合泄漏（§IV-B）&lt;br&gt;&lt;br&gt;数据及协议：每方法—任务—手组合测 20 次，终态条件须维持 2 秒才判成功。O6 具有 11 个机械自由度、6 个主动自由度；Wuji 为 20 个主动自由度。正文没有明确可确认的机械臂型号，因此不凭图中外形补猜" vertex="1">
          <mxGeometry height="569" width="628" x="2632" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_4_branch_1" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="424.5" as="sourcePoint"/><mxPoint x="2632" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_4_field_2" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与消融边界 / 表中逐项记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;主结果与消融边界 / 表中逐项记录：配置：Human-Raw；两款手、六任务合计成功率：63/240 = 26.3%&lt;br&gt;&lt;br&gt;主结果与消融边界 / 表中逐项记录：配置：外观和结构对齐 Human-Visual；两款手、六任务合计成功率：60.0%&lt;br&gt;&lt;br&gt;主结果与消融边界 / 表中逐项记录：配置：再加入融合跟踪 Human-Structured；两款手、六任务合计成功率：67.9%&lt;br&gt;&lt;br&gt;主结果与消融边界 / 表中逐项记录：配置：完整 Human2Dex；两款手、六任务合计成功率：206/240 = 85.8%&lt;br&gt;&lt;br&gt;主结果与消融边界：完整组 O6 为 109/120 = 90.8%，Wuji 为 97/120 = 80.8%。85.8%−26.3% 是 59.5 个百分点，不是相对提升 59.5%；均为这组固定任务的计数，不能推断任意新任务成功率（表 I）" vertex="1">
          <mxGeometry height="814" width="628" x="2632" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_4_branch_2" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1144.0" as="sourcePoint"/><mxPoint x="2632" y="1144.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_4_field_3" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;主结果与消融边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;配置逐级比较同时改动多个模块，尤其最后一步一起加入目标追踪、相对物体输入和辅助监督，不能把全差值单独归给 GPIR。Wuji 蛋盒由 Structured 的 14/20 降到完整组 13/20，开抽屉 16/20→15/20，说明并非每任务获益" vertex="1">
          <mxGeometry height="380" width="628" x="2632" y="1579" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_4_branch_3" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="1769.0" as="sourcePoint"/><mxPoint x="2632" y="1769.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_4_field_4" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;更可解释的对照&lt;/b&gt;&lt;br&gt;&lt;br&gt;O6 杯套杯在其他条件一致时，图像中心参考的 Human-Absolute 为 9/20，口袋参考为 16/20，提高 35 个百分点；牛角面包为 17/20→18/20，仅增加一次成功。单手单任务的头部／腕部相机诊断为 0/20→6/20，不能与完整系统 O6 的 90.8%直接合并比较（图 5–6、§IV-D/E）" vertex="1">
          <mxGeometry height="394" width="628" x="2632" y="1987" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_4_branch_4" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2620" y="2184.0" as="sourcePoint"/><mxPoint x="2632" y="2184.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_5_field_1" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;不足与未来：作者指出：仅两款校准手、六任务、每个手—任务独立策略；整体物体中心对蛋盒边缘和抽屉把手不够准确；没有真机示范训练基线，无法直接给出人类与真机数据的采样效率排名；相机对照仅一手一任务（§V）&lt;br&gt;&lt;br&gt;不足与未来：我的理解：GPIR 依赖指定目标和稳定追踪，暂存旧值时可能落后于动态环境；小样本单次配置的成功率还需重复种子验证。闭环重新观察不等于可恢复掉落或破损的完整 Failure Recovery 系统，本篇未验证 Sim2Real 训练迁移" vertex="1">
          <mxGeometry height="569" width="628" x="3322" y="140" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_5_branch_1" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="424.5" as="sourcePoint"/><mxPoint x="3322" y="424.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_5_field_2" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;DH116 复用：最值得先借鉴的是结构点约定、关节受限重定向和抓取相对坐标；需建立 DH116 的耦合规则及原生命令，验证指尖工作空间，再训练自己的策略。D435i 可用于固定外部观测，但原论文腕部鱼眼视角不能直接拿外部深度相机替换而保持已测结论；PICO 跟踪与腕部装置也是额外成本" vertex="1">
          <mxGeometry height="429" width="628" x="3322" y="737" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_5_branch_2" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="951.5" as="sourcePoint"/><mxPoint x="3322" y="951.5" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="paper_110_5_field_3" parent="paper_110" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FCFF;strokeColor=#A8C8DA;strokeWidth=1.25;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#334E60;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=22;spacingBottom=22;editable=1;movable=1;resizable=1;shadow=0;" value="&lt;b&gt;不足与未来&lt;/b&gt;&lt;br&gt;&lt;br&gt;后续方向：把整物体中心细化为把手／边缘关键点，单独消融跟踪、相对坐标和辅助损失，再测跨任务共享策略与真实执行误差恢复。策略训练 GPU 型号及完整时间预算未明确核实，不据此声称一张消费卡必能复现" vertex="1">
          <mxGeometry height="380" width="628" x="3322" y="1194" as="geometry"/>
        </mxCell>
        <mxCell id="paper_110_5_branch_3" edge="1" parent="paper_110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6F9DB8;strokeWidth=2;startArrow=none;endArrow=none;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3310" y="1384.0" as="sourcePoint"/><mxPoint x="3322" y="1384.0" as="targetPoint"/></mxGeometry>
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram id="literature-paper-111" name="01-15 UniDex">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="3400" background="#F7FBFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="paper_111_topnav_0" label="总览" link="data:page/id,literature-page-00" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="120" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_111_topnav_1" label="返回分类" link="data:page/id,literature-page-01" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
            <mxGeometry x="1140" y="42" width="1000" height="70" as="geometry"/>
          </mxCell>
        </UserObject><UserObject id="paper_111_topnav_2" label="上一篇" link="data:page/id,literature-paper-110" tooltip="点击进入页面"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DDEEF8;strokeColor=#5E91AF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;fontColor=#24435A;align=center;verticalAlign=middle;spacing=8;shadow=0;">
